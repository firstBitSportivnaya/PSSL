@startuml async_subsystem

title ER-Diagram Async subsystem

entity "Справочник: Интеграционные потоки" as eFlows {
    *УникальныйИдентификатор : uuid <<generated>>
}

entity "Справочник: Интегрируемые системы" as eSystems {
    *УникальныйИдентификатор : uuid <<generated>>
}

entity "Регистр сведений: Незагруженные сообщения обмена" as eNotLoaded {
    ИнтеграционныйПоток : uuid <<FK>>
    ДатаЗагрузки : дата и время
    ИдентификаторСообщения : строка (36)
    --
    ОписаниеОшибки : строка (300)
    СодержимоеСообщения : хранилище значений
}

entity "Регистр сведений: Задержка получения сообщений обмена" as eDelay {
    ИнтегрируемаяСистема : uuid <<FK>>
    НомерПопыткиЗагрузки : число (3, 0)
    --
    ВремяЗадержки : число (7, 0)
}

entity "Регистр сведений: Ограничения транспорта сообщений обмена" as eLimits {
    ИнтеграционныйПоток : uuid <<FK>>
    --
    ТранспортЗапрещен : булево
    КонтролироватьДоставку : булево
    ПорядокОтправки : число (2, 0)
    КонтролироватьПолучение : булево
}

entity "Определяемый тип: Объекты интегрируемых систем" as eObjects {
    УникальныйИдентификатор : uuid <<generated>>
}

entity "Определяемый тип: Пользователи" as eUsers {
    УникальныйИдентификатор : uuid <<generated>>
}

entity "Регистр сведений: Отмененные к регистрации объекты" as eCancelled {
    *Период : дата и время
    Объект : uuid <<FK>>
    --
    ПричинаОтмены : строка (300)
    Пользователь : uuid <<FK>>
}

eNotLoaded --> eFlows : ИнтеграционныйПоток
eDelay --> eSystems : ИнтегрируемаяСистема
eLimits --> eFlows : ИнтеграционныйПоток
eCancelled --> eObjects : Объект
eCancelled --> eUsers : Пользователь

@enduml
