#language: ru

@tree

Функционал: подсистема Datareon ESB

Контекст:
	Дано Я запускаю сценарий открытия TestClient или подключаю уже существующий

Сценарий: создание предопределенных интеграционных потоков Datareon ESB
	// Потоки создаются кодом сценария и удаляются в его конце.
	// В заполнение предопределённых конфигурации они не входят. Форма предопределённых не открывается.
* Включение подсистемы Datareon ESB
	И я выполняю код встроенного языка на сервере
		"""bsl
			Если Не Константы.пбп_ИспользоватьУправлениеШинойDatareonESB.Получить() Тогда

				Константы.пбп_ИспользоватьУправлениеШинойDatareonESB.Установить(Истина);

			КонецЕсли;
		"""
	И я закрываю сеанс текущего клиента тестирования
	Дано Я запускаю сценарий открытия TestClient или подключаю уже существующий
* Создание потоков
	И я выполняю код встроенного языка на сервере
		"""bsl
			ИдентификаторПопыток = "МаксимальноеКоличествоПопытокЗагрузкиИзШины";
			ИсточникПопыток = ПланыВидовХарактеристик.пбп_ПредопределенныеЗначения;
			СсылкаПопыток = пбп_ПредопределенныеЗначения.ПредопределенныйЭлемент(
				ИсточникПопыток, ИдентификаторПопыток);
			Если ЗначениеЗаполнено(СсылкаПопыток) Тогда
				ЭлементПопыток = СсылкаПопыток.ПолучитьОбъект();
			Иначе
				ЭлементПопыток = ИсточникПопыток.СоздатьЭлемент();
				ЭлементПопыток.Наименование = "Максимальное количество попыток загрузки из шины";
				ЭлементПопыток.ИдентификаторНастройки = ИдентификаторПопыток;
				ЭлементПопыток.ТипЗначения = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3));
			КонецЕсли;
			ЭлементПопыток.Значение = 10;
			ЭлементПопыток.Записать();

			НоваяНастройка = Справочники.пбп_НастройкиИнтеграции.СоздатьЭлемент();
			НоваяНастройка.Наименование = "Отправка настройки интеграции";
			НоваяНастройка.ИдентификаторНастройки = "ОтправкаНастройкиИнтеграции";
			НоваяНастройка.ИмяОбъекта = "PSSL_Integration_Settings";
			НоваяНастройка.ИнтегрируемаяСистема = пбп_ИнтеграцииСервер.ИнтегрируемаяСистема("СистемаN");
			НоваяНастройка.ТипАвторизации = Перечисления.пбп_ТипыАвторизации.БезАвторизации;
			НоваяНастройка.ТипИнтеграции = Справочники.пбп_ТипыИнтеграций.БрокерDatareon;

			Попытка
				НоваяНастройка.Записать();
			Исключение
				ВызватьИсключение "Настройка интеграции " + НоваяНастройка.ИдентификаторНастройки + " не создана";
			КонецПопытки;

			Исходящий = Перечисления.пбп_НаправленияИнтеграционныхПотоков.Исходящий;
			Входящий = Перечисления.пбп_НаправленияИнтеграционныхПотоков.Входящий;
			Описания = Новый Массив;
			ОписаниеПотока = Новый Структура("Наименование, Идентификатор, Направление");
			ОписаниеПотока.Наименование = "Отправка интеграционного потока";
			ОписаниеПотока.Идентификатор = "ОтправкаИнтеграционногоПотока";
			ОписаниеПотока.Направление = Исходящий;
			Описания.Добавить(ОписаниеПотока);
			ОписаниеПотока = Новый Структура("Наименование, Идентификатор, Направление");
			ОписаниеПотока.Наименование = "Получение интеграционного потока";
			ОписаниеПотока.Идентификатор = "ПолучениеИнтеграционногоПотока";
			ОписаниеПотока.Направление = Входящий;
			Описания.Добавить(ОписаниеПотока);
			ОписаниеПотока = Новый Структура("Наименование, Идентификатор, Направление");
			ОписаниеПотока.Наименование = "Отправка настройки интеграции контроль доставки";
			ОписаниеПотока.Идентификатор = "ОтправкаНастройкиИнтеграцииКонтрольДоставки";
			ОписаниеПотока.Направление = Исходящий;
			Описания.Добавить(ОписаниеПотока);
			ОписаниеПотока = Новый Структура("Наименование, Идентификатор, Направление");
			ОписаниеПотока.Наименование = "Отправка интеграционного потока контроль доставки";
			ОписаниеПотока.Идентификатор = "ОтправкаИнтеграционногоПотокаКонтрольДоставки";
			ОписаниеПотока.Направление = Исходящий;
			Описания.Добавить(ОписаниеПотока);
			ОписаниеПотока = Новый Структура("Наименование, Идентификатор, Направление");
			ОписаниеПотока.Наименование = "Отправка интеграционного потока контроль получения";
			ОписаниеПотока.Идентификатор = "ОтправкаИнтеграционногоПотокаКонтрольПолучения";
			ОписаниеПотока.Направление = Входящий;
			Описания.Добавить(ОписаниеПотока);
			ОписаниеПотока = Новый Структура("Наименование, Идентификатор, Направление");
			ОписаниеПотока.Наименование = "Получение интеграционного потока задержка";
			ОписаниеПотока.Идентификатор = "ПолучениеИнтеграционногоПотокаЗадержка";
			ОписаниеПотока.Направление = Входящий;
			Описания.Добавить(ОписаниеПотока);
			ОписаниеПотока = Новый Структура("Наименование, Идентификатор, Направление");
			ОписаниеПотока.Наименование = "Отправка интеграционного потока запрет";
			ОписаниеПотока.Идентификатор = "ОтправкаИнтеграционногоПотокаЗапрет";
			ОписаниеПотока.Направление = Исходящий;
			Описания.Добавить(ОписаниеПотока);
			ОписаниеПотока = Новый Структура("Наименование, Идентификатор, Направление");
			ОписаниеПотока.Наименование = "Получение интеграционного потока запрет";
			ОписаниеПотока.Идентификатор = "ПолучениеИнтеграционногоПотокаЗапрет";
			ОписаниеПотока.Направление = Входящий;
			Описания.Добавить(ОписаниеПотока);
			Для Каждого ОписаниеПотока Из Описания Цикл

				Поток = Справочники.пбп_ИнтеграционныеПотоки.СоздатьЭлемент();
				Поток.Наименование = ОписаниеПотока.Наименование;
				Поток.ИдентификаторНастройки = ОписаниеПотока.Идентификатор;
				Поток.НаправлениеПотока = ОписаниеПотока.Направление;
				Поток.НастройкаИнтеграции = НоваяНастройка.Ссылка;
				Попытка

					Поток.Записать();

				Исключение

					ВызватьИсключение "Поток " + ОписаниеПотока.Идентификатор + " не создан";

				КонецПопытки;

			КонецЦикла;
		"""
* Настройки обмена через шину
	// Форма обработки. Закладка ограничений транспорта открыта по умолчанию.
	И я закрываю все окна клиентского приложения
	И Я открываю навигационную ссылку "e1cib/app/Обработка.пбп_УправлениеНастройкамиОбменаЧерезШину"
	Тогда открылось окно "Управление настройками обмена через шину"
	И я перехожу к закладке "Ограничения транспорта"
	И в таблице "НастройкиТранспорта" я разворачиваю строку с подчиненными:
		| 'Интегрируемая система' |
		| 'Система N' |
	// Ранее созданные потоки сценария. Нет строки — шаг падает.
	И таблица "НастройкиТранспорта" содержит строки:
		| 'Интеграционный поток' |
		| 'Отправка интеграционного потока' |
		| 'Получение интеграционного потока' |
		| 'Отправка настройки интеграции контроль доставки' |
		| 'Отправка интеграционного потока контроль доставки' |
		| 'Отправка интеграционного потока контроль получения' |
		| 'Получение интеграционного потока задержка' |
		| 'Отправка интеграционного потока запрет' |
		| 'Получение интеграционного потока запрет' |
	И в таблице "НастройкиТранспорта" я перехожу к строке:
		| 'Интеграционный поток' |
		| 'Отправка настройки интеграции контроль доставки' |
	И в таблице "НастройкиТранспорта" я устанавливаю флаг "Контролировать доставку"
	И в таблице "НастройкиТранспорта" я начинаю редактирование строки
	И в таблице "НастройкиТранспорта" в поле "Порядок отправки" я ввожу текст "1"
	И в таблице "НастройкиТранспорта" я завершаю редактирование строки
	И в таблице "НастройкиТранспорта" поле "Контролировать доставку" имеет значение "Да"
	И в таблице "НастройкиТранспорта" поле "Порядок отправки" имеет значение "1"
	И в таблице "НастройкиТранспорта" я перехожу к строке:
		| 'Интеграционный поток' |
		| 'Отправка интеграционного потока контроль доставки' |
	И в таблице "НастройкиТранспорта" я устанавливаю флаг "Контролировать доставку"
	И в таблице "НастройкиТранспорта" я начинаю редактирование строки
	И в таблице "НастройкиТранспорта" в поле "Порядок отправки" я ввожу текст "2"
	И в таблице "НастройкиТранспорта" я завершаю редактирование строки
	И в таблице "НастройкиТранспорта" поле "Контролировать доставку" имеет значение "Да"
	И в таблице "НастройкиТранспорта" поле "Порядок отправки" имеет значение "2"
	И в таблице "НастройкиТранспорта" я перехожу к строке:
		| 'Интеграционный поток' |
		| 'Отправка интеграционного потока контроль получения' |
	И в таблице "НастройкиТранспорта" я устанавливаю флаг "Контролировать получение"
	И в таблице "НастройкиТранспорта" я завершаю редактирование строки
	И в таблице "НастройкиТранспорта" поле "Контролировать получение" имеет значение "Да"
	И в таблице "НастройкиТранспорта" я перехожу к строке:
		| 'Интеграционный поток' |
		| 'Отправка интеграционного потока запрет' |
	И в таблице "НастройкиТранспорта" я устанавливаю флаг "Транспорт запрещен"
	И в таблице "НастройкиТранспорта" я завершаю редактирование строки
	И в таблице "НастройкиТранспорта" поле "Транспорт запрещен" имеет значение "Да"
	И в таблице "НастройкиТранспорта" я перехожу к строке:
		| 'Интеграционный поток' |
		| 'Получение интеграционного потока запрет' |
	И в таблице "НастройкиТранспорта" я устанавливаю флаг "Транспорт запрещен"
	И в таблице "НастройкиТранспорта" я завершаю редактирование строки
	И в таблице "НастройкиТранспорта" поле "Транспорт запрещен" имеет значение "Да"
	И я перехожу к закладке "Задержка получения сообщений"
	И я меняю значение переключателя с именем 'ТипНастройкиЗадержки' на "Конкретную систему"
	// Ссылка с идентификатором СистемаN, представление "Система N".
	И из выпадающего списка с именем 'СистемаНастройкаЗадержки' я выбираю по строке "Система N"
	И я активизирую поле с именем 'СистемаНастройкаЗадержки'
	Тогда элемент формы с именем 'СистемаНастройкаЗадержки' стал равен "Система N"
	Тогда в таблице "НастройкиЗадержки" количество строк "равно" 10
	И для каждой строки таблицы "НастройкиЗадержки" я выполняю
		И в таблице "НастройкиЗадержки" я начинаю редактирование строки
		И в таблице "НастройкиЗадержки" в поле "Время задержки (сек)" я ввожу текст "30"
		И в таблице "НастройкиЗадержки" я завершаю редактирование строки
		И в таблице "НастройкиЗадержки" поле "Время задержки (сек)" имеет значение "30"
	И я нажимаю на кнопку с именем 'СохранитьЗадержкуПолучения'
	И я закрываю все окна клиентского приложения
* Удаление потоков сценария
	И я выполняю код встроенного языка на сервере
		"""bsl
			СистемаЗадержки = пбп_ИнтеграцииСервер.ИнтегрируемаяСистема("СистемаN");
			Если ЗначениеЗаполнено(СистемаЗадержки) Тогда

				НаборЗадержки = РегистрыСведений.пбп_ЗадержкаПолученияСообщенийОбмена.СоздатьНаборЗаписей();
				НаборЗадержки.Отбор.ИнтегрируемаяСистема.Установить(СистемаЗадержки);
				НаборЗадержки.Записать();

			КонецЕсли;

			Идентификаторы = Новый Массив;
			Идентификаторы.Добавить("ОтправкаИнтеграционногоПотока");
			Идентификаторы.Добавить("ПолучениеИнтеграционногоПотока");
			Идентификаторы.Добавить("ОтправкаНастройкиИнтеграцииКонтрольДоставки");
			Идентификаторы.Добавить("ОтправкаИнтеграционногоПотокаКонтрольДоставки");
			Идентификаторы.Добавить("ОтправкаИнтеграционногоПотокаКонтрольПолучения");
			Идентификаторы.Добавить("ПолучениеИнтеграционногоПотокаЗадержка");
			Идентификаторы.Добавить("ОтправкаИнтеграционногоПотокаЗапрет");
			Идентификаторы.Добавить("ПолучениеИнтеграционногоПотокаЗапрет");
			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ
				|	пбп_ИнтеграционныеПотоки.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник.пбп_ИнтеграционныеПотоки КАК пбп_ИнтеграционныеПотоки
				|ГДЕ
				|	пбп_ИнтеграционныеПотоки.ИдентификаторНастройки В (&Идентификаторы)";
			Запрос.УстановитьПараметр("Идентификаторы", Идентификаторы);
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл

				ОбъектПотока = Выборка.Ссылка.ПолучитьОбъект();
				Если ОбъектПотока <> Неопределено Тогда

					НаборОграничений = РегистрыСведений.пбп_ОграниченияТранспортаСообщенийОбмена.СоздатьНаборЗаписей();
					НаборОграничений.Отбор.ИнтеграционныйПоток.Установить(Выборка.Ссылка);
					НаборОграничений.Записать();

					Попытка

						ОбъектПотока.Удалить();

					Исключение

						ВызватьИсключение "Поток " + ОбъектПотока.ИдентификаторНастройки + " не удален";

					КонецПопытки;

				КонецЕсли;

			КонецЦикла;

			НастройкаИнтеграции = Справочники.пбп_НастройкиИнтеграции.НайтиПоРеквизиту("ИдентификаторНастройки", "ОтправкаНастройкиИнтеграции");
			Если ЗначениеЗаполнено(НастройкаИнтеграции) Тогда
				НастройкаИнтеграцииОбъект = НастройкаИнтеграции.ПолучитьОбъект();
				Попытка
					НастройкаИнтеграцииОбъект.Удалить();
				Исключение
					ВызватьИсключение "Настройку интеграции " + НастройкаИнтеграции.ИдентификаторНастройки + " не удалена";
				КонецПопытки;
			КонецЕсли;
		"""
