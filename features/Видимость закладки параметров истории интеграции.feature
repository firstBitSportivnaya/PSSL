#language: ru

@tree

Функционал: видимость закладки параметров истории интеграции

Контекст:
	Дано Я запускаю сценарий открытия TestClient или подключаю уже существующий
	И я закрываю все окна клиентского приложения

Сценарий: ФормаИстории_ЗакладкаПараметровВиднаКогдаТабличнаяЧастьЗаполнена
	И я выполняю код встроенного языка на сервере
		"""bsl
			Маркер = "ИнтеграционныйПотокСистемыN";
			Поток = Справочники.пбп_ИнтеграционныеПотоки.НайтиПоРеквизиту("ИдентификаторНастройки", Маркер);
			СтруктураИстории = пбп_ИнтеграцииСлужебный.ПолучитьСтруктуруЗаписиИстории();
			СтруктураИстории.ИнтеграционныйПоток = Поток;
			СтруктураИстории.ПротоколОбмена = "ВА_ИсторияПараметрыЕсть";
			СтруктураИстории.ОбрабатыватьСообщение = Ложь;
			СтруктураИстории.ГенерироватьПротокол = Ложь;
			СтрокаПараметра = СтруктураИстории.ПараметрыСообщения.Добавить();
			СтрокаПараметра.Имя = "a";
			СтрокаПараметра.Значение = "1";
			СтрокаПараметра.Исходящий = Ложь;
			СсылкаИстории = пбп_ИнтеграцииСлужебный.СоздатьСообщениеИсторииИнтеграции(СтруктураИстории);
			Объект.ЗначениеНаСервере = ПолучитьНавигационнуюСсылку(СсылкаИстории);
		"""
	И Я запоминаю значение выражения 'Ванесса.Объект.ЗначениеНаСервере' в переменную "НавСсылка"
	Дано Я открываю навигационную ссылку "$НавСсылка$"
	Тогда не появилось окно предупреждения системы
	Тогда открылось окно '*Интеграционный поток системы N от*'
	И я перехожу к закладке с именем 'ГруппаПараметрыСообщения'
	И элемент формы с именем 'ПараметрыСообщения' присутствует на форме
	И таблица "ПараметрыСообщения" содержит строки:
		| 'Имя' | 'Значение' |
		| 'a'   | '1'        |
	И я закрываю все окна клиентского приложения
	И я выполняю код встроенного языка на сервере
		"""bsl
			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ
				|	История.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник.пбп_ИсторияИнтеграции КАК История
				|ГДЕ
				|	История.ПротоколОбмена = &ПротоколОбмена";
			Запрос.УстановитьПараметр("ПротоколОбмена", "ВА_ИсторияПараметрыЕсть");
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл

				ОбъектИстории = Выборка.Ссылка.ПолучитьОбъект();
				Если ОбъектИстории <> Неопределено Тогда

					ОбъектИстории.Удалить();

				КонецЕсли;

			КонецЦикла;
		"""

