#language: ru

@tree

Функционал: видимость закладки параметров истории интеграции

Контекст:
	Дано Я запускаю сценарий открытия TestClient или подключаю уже существующий
	И я закрываю все окна клиентского приложения

Сценарий: ФормаИстории_ЗакладкаПараметровВиднаКогдаТабличнаяЧастьЗаполнена
	И я выполняю код встроенного языка на сервере
		"""bsl
			ИдентификаторПотока = "ВА_ИсторияПараметрыЕсть";
			НаименованиеПотока = "ВА_ИсторияПараметрыЕсть";
			ПротоколОбмена = "ВА_ИсторияПараметрыЕсть";
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("ПротоколОбмена", ПротоколОбмена);
			Запрос.Текст =
				"ВЫБРАТЬ
				|	История.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник.пбп_ИсторияИнтеграции КАК История
				|ГДЕ
				|	ВЫРАЗИТЬ(История.ПротоколОбмена КАК СТРОКА(100)) = &ПротоколОбмена";
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл

				ОбъектИстории = Выборка.Ссылка.ПолучитьОбъект();
				Если ОбъектИстории <> Неопределено Тогда

					ОбъектИстории.Удалить();

				КонецЕсли;

			КонецЦикла;
			Запрос.УстановитьПараметр("ИдентификаторНастройки", ИдентификаторПотока);
			Запрос.Текст =
				"ВЫБРАТЬ
				|	Потоки.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник.пбп_ИнтеграционныеПотоки КАК Потоки
				|ГДЕ
				|	Потоки.ИдентификаторНастройки = &ИдентификаторНастройки";
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл

				ОбъектПотока = Выборка.Ссылка.ПолучитьОбъект();
				Если ОбъектПотока <> Неопределено Тогда

					ОбъектПотока.Удалить();

				КонецЕсли;

			КонецЦикла;
			ПотокОбъект = Справочники.пбп_ИнтеграционныеПотоки.СоздатьЭлемент();
			ПотокОбъект.Наименование = НаименованиеПотока;
			ПотокОбъект.НаправлениеПотока = Перечисления.пбп_НаправленияИнтеграционныхПотоков.Входящий;
			ПотокОбъект.ИдентификаторНастройки = ИдентификаторПотока;
			ПотокОбъект.Записать();
			СтруктураИстории = пбп_ИнтеграцииСлужебный.ПолучитьСтруктуруЗаписиИстории();
			СтруктураИстории.ИнтеграционныйПоток = ПотокОбъект.Ссылка;
			СтруктураИстории.ПротоколОбмена = ПротоколОбмена;
			СтруктураИстории.ОбрабатыватьСообщение = Ложь;
			СтруктураИстории.ГенерироватьПротокол = Ложь;
			СтрокаПараметра = СтруктураИстории.ПараметрыСообщения.Добавить();
			СтрокаПараметра.Имя = "a";
			СтрокаПараметра.Значение = "1";
			СтрокаПараметра.Исходящий = Ложь;
			СсылкаИстории = пбп_ИнтеграцииСлужебный.СоздатьСообщениеИсторииИнтеграции(СтруктураИстории);
			Объект.ЗначениеНаСервере = ПолучитьНавигационнуюСсылку(СсылкаИстории);
		"""
	И Я запоминаю значение выражения 'Ванесса.Объект.ЗначениеНаСервере' в переменную "НавСсылка"
	Дано Я открываю навигационную ссылку "$НавСсылка$"
	Тогда не появилось окно предупреждения системы
	Тогда открылось окно '*ВА_ИсторияПараметрыЕсть от*'
	И я перехожу к закладке с именем 'ГруппаПараметрыСообщения'
	И элемент формы с именем 'ПараметрыСообщения' присутствует на форме
	И таблица "ПараметрыСообщения" содержит строки:
		| 'Имя' | 'Значение' |
		| 'a'   | '1'        |
	И я закрываю все окна клиентского приложения
	И я выполняю код встроенного языка на сервере
		"""bsl
			ИдентификаторПотока = "ВА_ИсторияПараметрыЕсть";
			ПротоколОбмена = "ВА_ИсторияПараметрыЕсть";
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("ПротоколОбмена", ПротоколОбмена);
			Запрос.Текст =
				"ВЫБРАТЬ
				|	История.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник.пбп_ИсторияИнтеграции КАК История
				|ГДЕ
				|	ВЫРАЗИТЬ(История.ПротоколОбмена КАК СТРОКА(100)) = &ПротоколОбмена";
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл

				ОбъектИстории = Выборка.Ссылка.ПолучитьОбъект();
				Если ОбъектИстории <> Неопределено Тогда

					ОбъектИстории.Удалить();

				КонецЕсли;

			КонецЦикла;
			Запрос.УстановитьПараметр("ИдентификаторНастройки", ИдентификаторПотока);
			Запрос.Текст =
				"ВЫБРАТЬ
				|	Потоки.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник.пбп_ИнтеграционныеПотоки КАК Потоки
				|ГДЕ
				|	Потоки.ИдентификаторНастройки = &ИдентификаторНастройки";
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл

				ОбъектПотока = Выборка.Ссылка.ПолучитьОбъект();
				Если ОбъектПотока <> Неопределено Тогда

					ОбъектПотока.Удалить();

				КонецЕсли;

			КонецЦикла;
		"""

