#language: ru

@tree

Функционал: рабочий стол виджетов

Контекст:
	Дано Я запускаю сценарий открытия TestClient или подключаю уже существующий
	И я закрываю все окна клиентского приложения

Сценарий: Рабочий стол строит виджеты и выполняет действия по нажатию
* Подготовка данных: два объекта под отбором, показатель, виджеты и рабочие столы
	И я выполняю код встроенного языка на сервере
	"""bsl
		Для Номер = 1 По 2 Цикл
			Имя = "ВА_Стол_Отбор " + Номер;
			Если Не ЗначениеЗаполнено(Справочники.пбп_НастройкиОтбораОбъектов.НайтиПоНаименованию(Имя, Истина)) Тогда
				Объект = Справочники.пбп_НастройкиОтбораОбъектов.СоздатьЭлемент();
				Объект.Наименование = Имя;
				Объект.Записать();
			КонецЕсли;
		КонецЦикла;
		Настройки = Новый НастройкиКомпоновкиДанных;
		ЭлементОтбора = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Наименование");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НачинаетсяС;
		ЭлементОтбора.ПравоеЗначение = "ВА_Стол_Отбор";
		ЭлементОтбора.Использование = Истина;
		Ссылка = Справочники.пбп_НастройкиОтбораОбъектов.НайтиПоНаименованию("ВА_Стол_Настройка", Истина);
		Объект = ?(ЗначениеЗаполнено(Ссылка), Ссылка.ПолучитьОбъект(), Справочники.пбп_НастройкиОтбораОбъектов.СоздатьЭлемент());
		Объект.Наименование = "ВА_Стол_Настройка";
		Объект.ОбъектМетаданных = "Справочник.пбп_НастройкиОтбораОбъектов";
		Объект.Отбор = пбп_Переадресация.ЗначениеВСтрокуXML(Настройки.Отбор);
		Объект.Записать();
		Настройка = Объект.Ссылка;
		Ссылка = Справочники.пбп_ПоказателиВиджетов.НайтиПоНаименованию("ВА_Стол_Показатель", Истина);
		Объект = ?(ЗначениеЗаполнено(Ссылка), Ссылка.ПолучитьОбъект(), Справочники.пбп_ПоказателиВиджетов.СоздатьЭлемент());
		Объект.Наименование = "ВА_Стол_Показатель";
		Объект.ВидИсточника = Перечисления.пбп_ВидыИсточниковПоказателейВиджетов.НастройкаОтбора;
		Объект.НастройкаОтбора = Настройка;
		Объект.Действие = Перечисления.пбп_ДействияВиджетов.ОткрытьСписок;
		Объект.ПараметрДействия = "";
		Объект.ПериодАктуальности = 0;
		Объект.Записать();
		Показатель = Объект.Ссылка;
		Ссылка = Справочники.пбп_Виджеты.НайтиПоНаименованию("ВА_Стол_Показатели", Истина);
		Объект = ?(ЗначениеЗаполнено(Ссылка), Ссылка.ПолучитьОбъект(), Справочники.пбп_Виджеты.СоздатьЭлемент());
		Объект.Наименование = "ВА_Стол_Показатели";
		Объект.Вид = Перечисления.пбп_ВидыВиджетов.Показатели;
		Объект.Цвет = Перечисления.пбп_ЦветаВиджетов.Синий;
		Объект.Размер = Перечисления.пбп_РазмерыВиджетов.Средний;
		Объект.Показатели.Очистить();
		Объект.Показатели.Добавить().Показатель = Показатель;
		Объект.Записать();
		ВиджетПоказателей = Объект.Ссылка;
		Ссылка = Справочники.пбп_Виджеты.НайтиПоНаименованию("ВА_Стол_Команды", Истина);
		Объект = ?(ЗначениеЗаполнено(Ссылка), Ссылка.ПолучитьОбъект(), Справочники.пбп_Виджеты.СоздатьЭлемент());
		Объект.Наименование = "ВА_Стол_Команды";
		Объект.Вид = Перечисления.пбп_ВидыВиджетов.Команда;
		Объект.Цвет = Перечисления.пбп_ЦветаВиджетов.Зеленый;
		Объект.Команды.Очистить();
		Действия = Перечисления.пбп_ДействияВиджетов;
		СтрокаТЧ = Объект.Команды.Добавить();
		СтрокаТЧ.Представление = "ВА создать рабочий стол";
		СтрокаТЧ.Действие = Действия.СоздатьОбъект;
		СтрокаТЧ.ПараметрДействия = "Справочник.пбп_РабочиеСтолы";
		СтрокаТЧ = Объект.Команды.Добавить();
		СтрокаТЧ.Представление = "ВА открыть виджеты";
		СтрокаТЧ.Действие = Действия.ОткрытьФорму;
		СтрокаТЧ.ПараметрДействия = "Справочник.пбп_Виджеты.ФормаСписка";
		СтрокаТЧ = Объект.Команды.Добавить();
		СтрокаТЧ.Представление = "ВА перейти к показателям";
		СтрокаТЧ.Действие = Действия.ПереходПоСсылке;
		СтрокаТЧ.ПараметрДействия = "Справочник.пбп_ПоказателиВиджетов";
		СтрокаТЧ = Объект.Команды.Добавить();
		СтрокаТЧ.Представление = "ВА недоступная команда";
		СтрокаТЧ.Действие = Действия.ОткрытьСписок;
		СтрокаТЧ.ПараметрДействия = "Справочник.ВА_НетТакогоСправочника";
		Объект.Записать();
		ВиджетКоманд = Объект.Ссылка;
		Ссылка = Справочники.пбп_РабочиеСтолы.НайтиПоНаименованию("ВА_Стол_Пустой", Истина);
		Объект = ?(ЗначениеЗаполнено(Ссылка), Ссылка.ПолучитьОбъект(), Справочники.пбп_РабочиеСтолы.СоздатьЭлемент());
		Объект.Наименование = "ВА_Стол_Пустой";
		Объект.Виджеты.Очистить();
		Объект.Записать();
		Ссылка = Справочники.пбп_РабочиеСтолы.НайтиПоНаименованию("ВА_Стол_Виджеты", Истина);
		Объект = ?(ЗначениеЗаполнено(Ссылка), Ссылка.ПолучитьОбъект(), Справочники.пбп_РабочиеСтолы.СоздатьЭлемент());
		Объект.Наименование = "ВА_Стол_Виджеты";
		Объект.Виджеты.Очистить();
		СтрокаТЧ = Объект.Виджеты.Добавить();
		СтрокаТЧ.Виджет = ВиджетПоказателей;
		СтрокаТЧ.Колонка = 1;
		СтрокаТЧ.Порядок = 1;
		СтрокаТЧ = Объект.Виджеты.Добавить();
		СтрокаТЧ.Виджет = ВиджетКоманд;
		СтрокаТЧ.Колонка = 2;
		СтрокаТЧ.Порядок = 1;
		Объект.Записать();
	"""
* Выбор рабочего стола перестраивает виджеты
	Дано Я открываю навигационную ссылку "e1cib/app/ОбщаяФорма.пбп_РабочийСтол"
	Тогда открылось окно 'Рабочий стол'
	И из выпадающего списка с именем 'РабочийСтол' я выбираю по строке "ВА_Стол_Пустой"
	И элемент формы с именем 'пбп_ВиджетЗначение_1_1' отсутствует на форме
	И из выпадающего списка с именем 'РабочийСтол' я выбираю по строке "ВА_Стол_Виджеты"
	И элемент формы с именем 'пбп_ВиджетЗначение_1_1' присутствует на форме
	Тогда элемент формы с именем 'пбп_ВиджетЗначение_1_1' стал равен "2"
	И элемент формы с именем 'пбп_ВиджетКоманда_2_4' отсутствует на форме
* Показатель открывает список с отбором настройки
	И я нажимаю на гиперссылку с именем 'пбп_ВиджетЗначение_1_1'
	Тогда открылось окно 'Настройки отбора объектов'
	И в таблице "Список" количество строк "равно" 2
	И я закрываю окно 'Настройки отбора объектов'
* Команда создает объект
	Тогда открылось окно 'Рабочий стол'
	И я нажимаю на гиперссылку с именем 'пбп_ВиджетКоманда_2_1'
	Тогда открылось окно 'Рабочие столы (создание)'
	И я закрываю окно 'Рабочие столы (создание)'
* Команда открывает форму
	Тогда открылось окно 'Рабочий стол'
	И я нажимаю на гиперссылку с именем 'пбп_ВиджетКоманда_2_2'
	Тогда открылось окно 'Виджеты'
	И я закрываю окно 'Виджеты'
* Команда переходит по ссылке
	Тогда открылось окно 'Рабочий стол'
	И я нажимаю на гиперссылку с именем 'пбп_ВиджетКоманда_2_3'
	Тогда открылось окно 'Показатели виджетов'
	И я закрываю окно 'Показатели виджетов'
