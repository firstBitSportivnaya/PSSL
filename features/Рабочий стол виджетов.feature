#language: ru

@tree

Функционал: рабочий стол виджетов

Контекст:
	Дано Я запускаю сценарий открытия TestClient или подключаю уже существующий
	И я закрываю все окна клиентского приложения

Сценарий: Рабочий стол строит виджеты и выполняет действия по нажатию
* Подготовка данных: два объекта под отбором, показатель, виджеты и рабочие столы
	И я выполняю код встроенного языка на сервере
	"""bsl
		// Исходное значение константы восстанавливается в конце сценария.
		Если ХранилищеОбщихНастроек.Загрузить("ВА_РабочийСтолВиджетов", "ИспользоватьВиджеты") = Неопределено Тогда
			ХранилищеОбщихНастроек.Сохранить("ВА_РабочийСтолВиджетов", "ИспользоватьВиджеты",
				Константы.пбп_ИспользоватьВиджеты.Получить());
		КонецЕсли;
		Константы.пбп_ИспользоватьВиджеты.Установить(Истина);
		ХранилищеОбщихНастроек.Удалить("пбп_Виджеты", "РабочийСтол", ИмяПользователя());
		Для Номер = 1 По 2 Цикл
			Имя = "ВА_Стол_Отбор " + Номер;
			Если Не ЗначениеЗаполнено(Справочники.пбп_НастройкиОтбораОбъектов.НайтиПоНаименованию(Имя, Истина)) Тогда
				ЭлементДанных = Справочники.пбп_НастройкиОтбораОбъектов.СоздатьЭлемент();
				ЭлементДанных.Наименование = Имя;
				ЭлементДанных.Записать();
			КонецЕсли;
		КонецЦикла;
		Настройки = Новый НастройкиКомпоновкиДанных;
		ЭлементОтбора = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Наименование");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НачинаетсяС;
		ЭлементОтбора.ПравоеЗначение = "ВА_Стол_Отбор";
		ЭлементОтбора.Использование = Истина;
		Ссылка = Справочники.пбп_НастройкиОтбораОбъектов.НайтиПоНаименованию("ВА_Стол_Настройка", Истина);
		ЭлементДанных = ?(ЗначениеЗаполнено(Ссылка), Ссылка.ПолучитьОбъект(),
			Справочники.пбп_НастройкиОтбораОбъектов.СоздатьЭлемент());
		ЭлементДанных.Наименование = "ВА_Стол_Настройка";
		ЭлементДанных.ОбъектМетаданных = "Справочник.пбп_НастройкиОтбораОбъектов";
		ЭлементДанных.Отбор = пбп_Переадресация.ЗначениеВСтрокуXML(Настройки.Отбор);
		ЭлементДанных.Записать();
		Настройка = ЭлементДанных.Ссылка;
		Ссылка = Справочники.пбп_ПоказателиВиджетов.НайтиПоНаименованию("ВА_Стол_Показатель", Истина);
		ЭлементДанных = ?(ЗначениеЗаполнено(Ссылка), Ссылка.ПолучитьОбъект(),
			Справочники.пбп_ПоказателиВиджетов.СоздатьЭлемент());
		ЭлементДанных.Наименование = "ВА_Стол_Показатель";
		ЭлементДанных.ВидИсточника = Перечисления.пбп_ВидыИсточниковПоказателейВиджетов.НастройкаОтбора;
		ЭлементДанных.НастройкаОтбора = Настройка;
		ЭлементДанных.Действие = Перечисления.пбп_ДействияВиджетов.ПустаяСсылка();
		ЭлементДанных.ПараметрДействия = "";
		ЭлементДанных.ПериодАктуальности = 0;
		ЭлементДанных.Записать();
		Показатель = ЭлементДанных.Ссылка;
		Ссылка = Справочники.пбп_ПоказателиВиджетов.НайтиПоНаименованию("ВА_Стол_Показатель_Список", Истина);
		ЭлементДанных = ?(ЗначениеЗаполнено(Ссылка), Ссылка.ПолучитьОбъект(),
			Справочники.пбп_ПоказателиВиджетов.СоздатьЭлемент());
		ЭлементДанных.Наименование = "ВА_Стол_Показатель_Список";
		ЭлементДанных.ВидИсточника = Перечисления.пбп_ВидыИсточниковПоказателейВиджетов.НастройкаОтбора;
		ЭлементДанных.НастройкаОтбора = Настройка;
		ЭлементДанных.Действие = Перечисления.пбп_ДействияВиджетов.ОткрытьСписок;
		ЭлементДанных.ПараметрДействия = "";
		ЭлементДанных.ПериодАктуальности = 0;
		ЭлементДанных.Записать();
		ПоказательСписка = ЭлементДанных.Ссылка;
		Ссылка = Справочники.пбп_Виджеты.НайтиПоНаименованию("ВА_Стол_Показатели", Истина);
		ЭлементДанных = ?(ЗначениеЗаполнено(Ссылка), Ссылка.ПолучитьОбъект(), Справочники.пбп_Виджеты.СоздатьЭлемент());
		ЭлементДанных.Наименование = "ВА_Стол_Показатели";
		ЭлементДанных.Вид = Перечисления.пбп_ВидыВиджетов.Показатели;
		ЭлементДанных.Цвет = Перечисления.пбп_ЦветаВиджетов.Синий;
		ЭлементДанных.Размер = Перечисления.пбп_РазмерыВиджетов.Средний;
		ЭлементДанных.Показатели.Очистить();
		ЭлементДанных.Показатели.Добавить().Показатель = Показатель;
		ЭлементДанных.Показатели.Добавить().Показатель = ПоказательСписка;
		ЭлементДанных.Записать();
		ВиджетПоказателей = ЭлементДанных.Ссылка;
		Ссылка = Справочники.пбп_Виджеты.НайтиПоНаименованию("ВА_Стол_Команды", Истина);
		ЭлементДанных = ?(ЗначениеЗаполнено(Ссылка), Ссылка.ПолучитьОбъект(), Справочники.пбп_Виджеты.СоздатьЭлемент());
		ЭлементДанных.Наименование = "ВА_Стол_Команды";
		ЭлементДанных.Вид = Перечисления.пбп_ВидыВиджетов.Команда;
		ЭлементДанных.Цвет = Перечисления.пбп_ЦветаВиджетов.Зеленый;
		ЭлементДанных.Команды.Очистить();
		Действия = Перечисления.пбп_ДействияВиджетов;
		СтрокаТЧ = ЭлементДанных.Команды.Добавить();
		СтрокаТЧ.Представление = "ВА создать рабочий стол";
		СтрокаТЧ.Действие = Действия.СоздатьОбъект;
		СтрокаТЧ.ПараметрДействия = "Справочник.пбп_РабочиеСтолы";
		СтрокаТЧ = ЭлементДанных.Команды.Добавить();
		СтрокаТЧ.Представление = "ВА открыть виджеты";
		СтрокаТЧ.Действие = Действия.ОткрытьФорму;
		СтрокаТЧ.ПараметрДействия = "Справочник.пбп_Виджеты.ФормаСписка";
		СтрокаТЧ = ЭлементДанных.Команды.Добавить();
		СтрокаТЧ.Представление = "ВА перейти к показателям";
		СтрокаТЧ.Действие = Действия.ПереходПоСсылке;
		СтрокаТЧ.ПараметрДействия = "Справочник.пбп_ПоказателиВиджетов";
		СтрокаТЧ = ЭлементДанных.Команды.Добавить();
		СтрокаТЧ.Представление = "ВА недоступная команда";
		СтрокаТЧ.Действие = Действия.ОткрытьСписок;
		СтрокаТЧ.ПараметрДействия = "Справочник.ВА_НетТакогоСправочника";
		ЭлементДанных.Записать();
		ВиджетКоманд = ЭлементДанных.Ссылка;
		Ссылка = Справочники.пбп_РабочиеСтолы.НайтиПоНаименованию("ВА_Стол_Пустой", Истина);
		ЭлементДанных = ?(ЗначениеЗаполнено(Ссылка), Ссылка.ПолучитьОбъект(), Справочники.пбп_РабочиеСтолы.СоздатьЭлемент());
		ЭлементДанных.Наименование = "ВА_Стол_Пустой";
		ЭлементДанных.Виджеты.Очистить();
		ЭлементДанных.Записать();
		Ссылка = Справочники.пбп_РабочиеСтолы.НайтиПоНаименованию("ВА_Стол_Виджеты", Истина);
		ЭлементДанных = ?(ЗначениеЗаполнено(Ссылка), Ссылка.ПолучитьОбъект(), Справочники.пбп_РабочиеСтолы.СоздатьЭлемент());
		ЭлементДанных.Наименование = "ВА_Стол_Виджеты";
		ЭлементДанных.Виджеты.Очистить();
		СтрокаТЧ = ЭлементДанных.Виджеты.Добавить();
		СтрокаТЧ.Виджет = ВиджетПоказателей;
		СтрокаТЧ.Колонка = 1;
		СтрокаТЧ.Порядок = 1;
		СтрокаТЧ = ЭлементДанных.Виджеты.Добавить();
		СтрокаТЧ.Виджет = ВиджетКоманд;
		СтрокаТЧ.Колонка = 2;
		СтрокаТЧ.Порядок = 1;
		ЭлементДанных.Записать();
	"""
	# Функциональная опция кэшируется в сеансе клиента тестирования. Клиент, открытый предыдущими
	# фичами при выключенной опции, завершается принудительно, чтобы сценарий не подключился к нему снова.
	И я закрываю сеанс текущего клиента тестирования
	И я завершаю выполнение процессов клиентов тестирования
	И Я запускаю сценарий открытия TestClient или подключаю уже существующий
* Выбор рабочего стола перестраивает виджеты
	Дано Я открываю навигационную ссылку "e1cib/app/ОбщаяФорма.пбп_РабочийСтол"
	Тогда открылось окно 'Рабочий стол'
	И из выпадающего списка с именем 'РабочийСтол' я выбираю по строке "ВА_Стол_Пустой"
	И элемент формы с именем 'пбп_ВиджетЗначение_1_1' отсутствует на форме
	И из выпадающего списка с именем 'РабочийСтол' я выбираю по строке "ВА_Стол_Виджеты"
	И элемент формы с именем 'пбп_ВиджетЗначение_1_1' присутствует на форме
	Тогда элемент формы с именем 'пбп_ВиджетЗначение_1_1' стал равен "2"
	И элемент формы с именем 'пбп_ВиджетКоманда_2_4' отсутствует на форме
* Показатель настройки отбора без действия открывает список с отбором настройки
	И я нажимаю на гиперссылку с именем 'пбп_ВиджетЗначение_1_1'
	Тогда открылось окно 'Настройки отбора объектов'
	И в таблице "Список" количество строк "равно" 2
	И я закрываю окно 'Настройки отбора объектов'
* Показатель с действием «Открыть список» открывает список с отбором настройки
	Тогда открылось окно 'Рабочий стол'
	И элемент формы с именем 'пбп_ВиджетЗначение_1_2' стал равен "2"
	И я нажимаю на гиперссылку с именем 'пбп_ВиджетЗначение_1_2'
	Тогда открылось окно 'Настройки отбора объектов'
	И в таблице "Список" количество строк "равно" 2
	И я закрываю окно 'Настройки отбора объектов'
* Команда создает объект
	Тогда открылось окно 'Рабочий стол'
	И я нажимаю на гиперссылку с именем 'пбп_ВиджетКоманда_2_1'
	Тогда открылось окно 'Рабочие столы (создание)'
	И я закрываю окно 'Рабочие столы (создание)'
* Команда открывает форму
	Тогда открылось окно 'Рабочий стол'
	И я нажимаю на гиперссылку с именем 'пбп_ВиджетКоманда_2_2'
	Тогда открылось окно 'Виджеты'
	И я закрываю окно 'Виджеты'
* Команда переходит по ссылке
	Тогда открылось окно 'Рабочий стол'
	И я нажимаю на гиперссылку с именем 'пбп_ВиджетКоманда_2_3'
	Тогда открылось окно 'Показатели виджетов'
	И я закрываю окно 'Показатели виджетов'
* Удаление данных сценария и восстановление константы
	И я выполняю код встроенного языка на сервере
	"""bsl
		ИменаСправочников = "пбп_РабочиеСтолы,пбп_Виджеты,пбп_ПоказателиВиджетов,пбп_НастройкиОтбораОбъектов";
		Для Каждого ИмяСправочника Из СтрРазделить(ИменаСправочников, ",") Цикл
			Выборка = Справочники[ИмяСправочника].Выбрать();
			Пока Выборка.Следующий() Цикл
				Если Не СтрНачинаетсяС(Выборка.Наименование, "ВА_Стол_") Тогда
					Продолжить;
				КонецЕсли;
				Если ИмяСправочника = "пбп_ПоказателиВиджетов" Тогда
					НаборЗаписей = РегистрыСведений.пбп_ЗначенияПоказателейВиджетов.СоздатьНаборЗаписей();
					НаборЗаписей.Отбор.Показатель.Установить(Выборка.Ссылка);
					НаборЗаписей.Записать();
				КонецЕсли;
				Выборка.ПолучитьОбъект().Удалить();
			КонецЦикла;
		КонецЦикла;
		ХранилищеОбщихНастроек.Удалить("пбп_Виджеты", "РабочийСтол", ИмяПользователя());
		Исходное = ХранилищеОбщихНастроек.Загрузить("ВА_РабочийСтолВиджетов", "ИспользоватьВиджеты");
		Если Исходное <> Неопределено Тогда
			Константы.пбп_ИспользоватьВиджеты.Установить(Исходное);
		КонецЕсли;
		ХранилищеОбщихНастроек.Удалить("ВА_РабочийСтолВиджетов", "ИспользоватьВиджеты", ИмяПользователя());
	"""
