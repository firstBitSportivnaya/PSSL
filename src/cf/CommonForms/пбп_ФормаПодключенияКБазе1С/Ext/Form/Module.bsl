#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Действие") Тогда
		КлючДействия = Параметры.Действие;
	Иначе
		пбп_Переадресация.СообщитьПользователю(
			НСтр("ru = 'Открытие формы прервано, т.к. передан некорректный параметр формы ""Действие""'"), 
			, , , Отказ);
		Возврат;
	КонецЕсли;
	
	Если КлючДействия = "ОбработкаЗагрузкиИзФайла" Тогда
		Элементы.ДекорацияЗаголовок.Заголовок = НСтр(
		"ru = 'Для создания обработки загрузки из файла необходим доступ к конфигуратору.
		|Укажите параметры подключения к информационной базе, через которую будет выполнено создание обработки.
		|Важно, чтобы конфигуратор базы был не занят.'");
		Элементы.ВыполнитьДействиеПосле.Заголовок = НСтр("ru = 'Выбрать каталог сохранения и создать обработку'");
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	СтруктураНастроек = пбп_Переадресация.ПрочитатьДанныеИзБезопасногоХранилища(
		ПолучитьВладельцаЗначенияБезопасногоХранилища(),
		ПолучитьКлючДанныхБезопасногоХранилища());
	УстановитьПривилегированныйРежим(Ложь);
	
	Если СтруктураНастроек <> Неопределено Тогда
		ВариантПодключенияКБазе = СтруктураНастроек.СервернаяБаза;
		Если СтруктураНастроек.СервернаяБаза Тогда
			КластерСерверов			= СтруктураНастроек.КластерСерверов;
			ИмяИнформационнойБазы	= СтруктураНастроек.ИмяИнформационнойБазы;
		Иначе
			КаталогИнформационнойБазы = СтруктураНастроек.КаталогИнформационнойБазы;
		КонецЕсли;
		
		ИмяПользователя	= СтруктураНастроек.ИмяПользователя;
		Пароль			= СтруктураНастроек.Пароль;
	КонецЕсли;
	
	УстановитьВидимостьЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура ВариантПодключенияКБазеПриИзменении(Элемент)
	
	УстановитьВидимостьЭлементов();
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура КаталогИнформационнойБазыНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Заголовок			= НСтр("ru = 'Выберите каталог информационной базы'");
	Диалог.МножественныйВыбор	= Ложь;
	
	Результат = Ждать Диалог.ВыбратьАсинх();
	
	Если ЗначениеЗаполнено(Результат) Тогда
		ФайлБазы = Новый Файл(Результат[0] + "/1Cv8.1CD");
		ФайлСуществует = Ждать ФайлБазы.СуществуетАсинх();
		Если ФайлСуществует Тогда
			КаталогИнформационнойБазы = Результат[0];
		Иначе
			пбп_ПереадресацияКлиент.СообщитьПользователю(
				НСтр("ru = 'В каталоге отсутствует файл ИБ. Выберите каталог информационной базы 1С'"));
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти // ОбработчикиСобытийФормы

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыполнитьДействиеПосле(Команда)
	
	СохранитьДанныеПриНеобходимости();
	
#Если ВебКлиент Или МобильноеПриложениеКлиент Или МобильныйКлиент Тогда
	ВызватьИсключение НСтр("ru = 'Создание внешней обработки недоступно в веб-клиенте и мобильном приложении'");
#Иначе
	Если КлючДействия = "ОбработкаЗагрузкиИзФайла" Тогда
		УказатьПутьКФайлуИЗакрытьФорму();
	КонецЕсли;
#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФорму(Команда)
	Закрыть();
КонецПроцедуры

&НаСервере
Процедура ПоказатьПарольНаСервере(РежимПароля)
	Если РежимПароля Тогда
		Команды.Найти("ПоказатьПароль").Картинка = БиблиотекаКартинок.ПоказатьПароль;
	Иначе
		Команды.Найти("ПоказатьПароль").Картинка = БиблиотекаКартинок.СкрытьПароль;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПароль(Команда)
	
	РежимПароля = Не Элементы.Пароль.РежимПароля;
	
	Элементы.Пароль.РежимПароля = РежимПароля;
	
	ПоказатьПарольНаСервере(РежимПароля);
	
КонецПроцедуры

#КонецОбласти // ОбработчикиКомандФормы

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьВидимостьЭлементов()
	
	Элементы.КаталогИнформационнойБазы.Видимость = Не ВариантПодключенияКБазе;
	Элементы.КластерСерверов.Видимость = ВариантПодключенияКБазе;
	Элементы.ИмяИнформационнойБазы.Видимость = ВариантПодключенияКБазе;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьДанныеПриНеобходимости()
	
	Если Не ЗапомнитьДанные Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураПодключения = Новый Структура;
	СтруктураПодключения.Вставить("СервернаяБаза", ВариантПодключенияКБазе = 1);
	Если ВариантПодключенияКБазе Тогда
		СтруктураПодключения.Вставить("КластерСерверов"			, КластерСерверов);
		СтруктураПодключения.Вставить("ИмяИнформационнойБазы"	, ИмяИнформационнойБазы);
	Иначе
		СтруктураПодключения.Вставить("КаталогИнформационнойБазы", КаталогИнформационнойБазы);
	КонецЕсли;
	
	СтруктураПодключения.Вставить("ИмяПользователя"	, ИмяПользователя);
	СтруктураПодключения.Вставить("Пароль"			, Пароль);
	
	УстановитьПривилегированныйРежим(Истина);
	пбп_Переадресация.ЗаписатьДанныеВБезопасноеХранилище(
		ПолучитьВладельцаЗначенияБезопасногоХранилища(),
		СтруктураПодключения,
		ПолучитьКлючДанныхБезопасногоХранилища());
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьВладельцаЗначенияБезопасногоХранилища()
	
	Если пбп_ОбщегоНазначенияСервер.СуществуетБиблиотекаСтандартныхПодсистем() Тогда
		Владелец = пбп_Переадресация.АвторизованныйПользователь();
	Иначе
		Владелец = "пбп_ОбщегоНазначения";
	КонецЕсли;
	
	Возврат Владелец;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьКлючДанныхБезопасногоХранилища()
	
	Возврат "ДанныеПодключенияКВнешнейБазе1С";
	
КонецФункции

&НаКлиенте
Асинх Процедура УказатьПутьКФайлуИЗакрытьФорму()
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок			= НСтр("ru = 'Выберите путь сохранения файла обработки'");
	Диалог.МножественныйВыбор	= Ложь;
	Диалог.Фильтр				= "Внешняя обработка 1С (*.epf)|*.epf";
	
	Результат = Ждать Диалог.ВыбратьАсинх();
	
	Если ЗначениеЗаполнено(Результат) Тогда
		ПараметрыСохранения = Новый Структура;
		ПараметрыСохранения.Вставить("ПутьКФайлу"				, Результат[0]);
		ПараметрыСохранения.Вставить("ФайловаяБаза"				, ВариантПодключенияКБазе = 0);
		ПараметрыСохранения.Вставить("КаталогИнформационнойБазы", КаталогИнформационнойБазы);
		ПараметрыСохранения.Вставить("КластерСерверов"			, КластерСерверов);
		ПараметрыСохранения.Вставить("ИмяИнформационнойБазы"	, ИмяИнформационнойБазы);
		ПараметрыСохранения.Вставить("ИмяПользователя"			, ИмяПользователя);
		ПараметрыСохранения.Вставить("Пароль"					, Пароль);
		
		Закрыть(ПараметрыСохранения);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти // СлужебныеПроцедурыИФункции