#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)

	Если ОбменДанными.Загрузка Тогда

		Возврат;

	КонецЕсли;

	// Общий показатель считается с полными правами и виден всем пользователям рабочего стола:
	// включать и выключать признак может только администратор.
	Если ПризнакОбщийИзменяется() И Не пбп_ВиджетыСлужебный.ПравоИзменятьОбщиеПоказатели() Тогда

		ВызватьИсключение НСтр("ru = 'Признак ""Общий для всех пользователей"" может изменять только администратор.'");

	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если Действие = Перечисления.пбп_ДействияВиджетов.ВыполнитьМетод
		И Не пбп_ВиджетыРабочийСтол.МетодДействияРазрешен(ПараметрДействия) Тогда

		пбп_Переадресация.СообщитьПользователю(пбп_ВиджетыРабочийСтол.ТекстМетодНеРазрешен(ПараметрДействия),
			ЭтотОбъект, "ПараметрДействия", , Отказ);

	КонецЕсли;

	Если ВидИсточника = Перечисления.пбп_ВидыИсточниковПоказателейВиджетов.МетодКонфигурации
		И Не пбп_ВиджетыРабочийСтол.МетодДействияРазрешен(ИмяМетода) Тогда

		пбп_Переадресация.СообщитьПользователю(пбп_ВиджетыРабочийСтол.ТекстМетодНеРазрешен(ИмяМетода),
			ЭтотОбъект, "ИмяМетода", , Отказ);

	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПризнакОбщийИзменяется()

	Если ЭтоНовый() Тогда

		Возврат Общий;

	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Показатели.Общий КАК Общий
	|ИЗ
	|	Справочник.пбп_ПоказателиВиджетов КАК Показатели
	|ГДЕ
	|	Показатели.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();

	Возврат Выборка.Следующий() И Выборка.Общий <> Общий;

КонецФункции

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
