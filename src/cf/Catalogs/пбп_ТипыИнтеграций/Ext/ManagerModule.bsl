Функция ТаблицаДополнительныхПараметров()
	
	ОбщийКвалификатор = Новый КвалификаторыСтроки(100, ДопустимаяДлина.Переменная);
	КвалификаторТипа = Новый КвалификаторыСтроки(50, ДопустимаяДлина.Переменная);
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Элемент", Новый ОписаниеТипов("СправочникСсылка.пбп_ТипыИнтеграций"));
	Таблица.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка", , , , ОбщийКвалификатор));
	Таблица.Колонки.Добавить("Синоним", Новый ОписаниеТипов("Строка", , , , ОбщийКвалификатор));
	Таблица.Колонки.Добавить("Тип", Новый ОписаниеТипов("Строка", , , , КвалификаторТипа));
	
	Возврат Таблица;
	
КонецФункции

Функция ОтфильтроватьТаблицу(Знач Таблица)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаПредопределенных.Идентификатор КАК Идентификатор,
	|	ТаблицаПредопределенных.Синоним КАК Синоним,
	|	ТаблицаПредопределенных.Тип КАК Тип,
	|	ТаблицаПредопределенных.Элемент КАК Элемент
	|ПОМЕСТИТЬ ТаблицаПредопределенных
	|ИЗ
	|	&ТаблицаПредопределенных КАК ТаблицаПредопределенных
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаПредопределенных.Идентификатор КАК Идентификатор,
	|	ТаблицаПредопределенных.Синоним КАК Синоним,
	|	ТаблицаПредопределенных.Тип КАК Тип,
	|	ТаблицаПредопределенных.Элемент КАК Элемент
	|ИЗ
	|	ТаблицаПредопределенных КАК ТаблицаПредопределенных
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.пбп_ТипыИнтеграций.ДополнительныеПараметрыНастроекИнтеграций КАК ДополнительныеПараметрыНастроекИнтеграций
	|		ПО ТаблицаПредопределенных.Элемент = ДополнительныеПараметрыНастроекИнтеграций.Ссылка
	|			И ТаблицаПредопределенных.Идентификатор = ДополнительныеПараметрыНастроекИнтеграций.Идентификатор
	|			И ТаблицаПредопределенных.Синоним = ДополнительныеПараметрыНастроекИнтеграций.Синоним
	|			И ТаблицаПредопределенных.Тип = ДополнительныеПараметрыНастроекИнтеграций.Тип
	|ГДЕ
	|	ДополнительныеПараметрыНастроекИнтеграций.Ссылка ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("ТаблицаПредопределенных", Таблица);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

#КонецОбласти

