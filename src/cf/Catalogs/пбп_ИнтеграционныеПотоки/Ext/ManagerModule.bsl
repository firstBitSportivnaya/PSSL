#Область ПрограммныйИнтерфейс

// Получить структуру параметров входа
//
// Параметры:
//  ИнтеграционныйПоток - СправочникСсылка.пбп_ИнтеграционныеПотоки - ссылка на поток, параметры которого получаем.
//  ЗаполнятьПоУмолчанию - Булево - добавлять ли в возвращаемую структуру значения по умолчанию
//    - Ложь - возвращает структуру вида ИмяПараметра<Строка>:ТипЗначения<ПеречислениеСсылка.пбп_ТипыJSON>
//    - Истина - возвращает структуру вида ИмяПараметра<Строка>:ЗначениеПоУмолчанию<Строка>
//
// Возвращаемое значение:
//   - Структура
//
Функция ПолучитьСтруктуруПараметровВхода(ИнтеграционныйПоток, ЗаполнятьПоУмолчанию = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	пбп_ИнтеграционныеПотокиПараметрыВхода.Имя КАК Имя,
	|	пбп_ИнтеграционныеПотокиПараметрыВхода.Тип КАК Тип,
	|	пбп_ИнтеграционныеПотокиПараметрыВхода.ПараметрURL КАК ПараметрURL,
	|	пбп_ИнтеграционныеПотокиПараметрыВхода.ЗначениеПоУмолчанию КАК ЗначениеПоУмолчанию,
	|	пбп_ИнтеграционныеПотокиПараметрыВхода.ПолеОбъекта КАК ПолеОбъекта
	|ИЗ
	|	Справочник.пбп_ИнтеграционныеПотоки.ПараметрыВхода КАК пбп_ИнтеграционныеПотокиПараметрыВхода
	|ГДЕ
	|	пбп_ИнтеграционныеПотокиПараметрыВхода.Ссылка = &ИнтеграционныйПоток";
	
	Запрос.УстановитьПараметр("ИнтеграционныйПоток", ИнтеграционныйПоток);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Результат = Новый Структура;
	
	Пока Выборка.Следующий() Цикл
		Имя = Выборка.Имя; 
		
		Если ЗаполнятьПоУмолчанию Тогда
			Результат.Вставить(Имя, ПривестиЗначениеПоУмолчаниюREST(Выборка.ЗначениеПоУмолчанию, Выборка.Тип));
		Иначе
			Результат.Вставить(Имя, Выборка.Тип);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Формирует строку параметров URL и заголовки HTTP по табличной части «ПараметрыВхода» потока.
//
// Параметры:
//  ИнтеграционныйПоток - СправочникСсылка.пбп_ИнтеграционныеПотоки - интеграционный поток.
//  ВыгружаемыйОбъект - Произвольный - ссылка, структура, объект или строка ТЧ с индексатором [Имя].
//    Неопределено допустимо, если ни у одной строки не заполнено ПолеОбъекта.
//  ПереопределенияЗначений - Структура, Соответствие, Неопределено - ключ — Имя строки ТЧ.
//
// Возвращаемое значение:
//  Структура:
//   * СтрокаПараметровURL - Строка - фрагмент «?name=value&…» или пустая строка.
//   * Заголовки - Соответствие - ключ и значение — строки без URL-кодирования.
//
Функция ПараметрыHTTPЗапроса(ИнтеграционныйПоток, ВыгружаемыйОбъект = Неопределено,
	ПереопределенияЗначений = Неопределено) Экспорт
	
	Переопределения = Новый Соответствие;
	НаличиеПереопределений = Новый Соответствие;
	СкопироватьПереопределенияЗначений(
		ПереопределенияЗначений, Переопределения, НаличиеПереопределений);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	пбп_ИнтеграционныеПотокиПараметрыВхода.Имя КАК Имя,
	|	пбп_ИнтеграционныеПотокиПараметрыВхода.Тип КАК Тип,
	|	пбп_ИнтеграционныеПотокиПараметрыВхода.ПараметрURL КАК ПараметрURL,
	|	пбп_ИнтеграционныеПотокиПараметрыВхода.ЗначениеПоУмолчанию КАК ЗначениеПоУмолчанию,
	|	пбп_ИнтеграционныеПотокиПараметрыВхода.ПолеОбъекта КАК ПолеОбъекта
	|ИЗ
	|	Справочник.пбп_ИнтеграционныеПотоки.ПараметрыВхода КАК пбп_ИнтеграционныеПотокиПараметрыВхода
	|ГДЕ
	|	пбп_ИнтеграционныеПотокиПараметрыВхода.Ссылка = &ИнтеграционныйПоток
	|УПОРЯДОЧИТЬ ПО
	|	пбп_ИнтеграционныеПотокиПараметрыВхода.НомерСтроки";
	
	Запрос.УстановитьПараметр("ИнтеграционныйПоток", ИнтеграционныйПоток);
	
	ТаблицаСтрок = Запрос.Выполнить().Выгрузить();
	
	ИменаПолейОбъекта = Новый Соответствие;
	
	Для Каждого СтрокаПараметра Из ТаблицаСтрок Цикл
		
		Имя = СокрЛП(СтрокаПараметра.Имя);
		
		Если ПустаяСтрока(Имя) Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		ПолеОбъекта = СокрЛП(СтрокаПараметра.ПолеОбъекта);
		
		Если НаличиеПереопределений.Получить(Имя) = Неопределено
			И ЗначениеЗаполнено(ПолеОбъекта)
			И СтрНайти(ПолеОбъекта, ".") = 0 Тогда
			
			ИменаПолейОбъекта.Вставить(ПолеОбъекта, Истина);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЗначенияРеквизитовСсылки = Неопределено;
	
	Если ВыгружаемыйОбъект <> Неопределено
		И пбп_Переадресация.ЭтоСсылка(ТипЗнч(ВыгружаемыйОбъект))
		И ИменаПолейОбъекта.Количество() > 0 Тогда
		
		МассивИмен = Новый Массив;
		
		Для Каждого ЭлементИмени Из ИменаПолейОбъекта Цикл
			
			МассивИмен.Добавить(ЭлементИмени.Ключ);
			
		КонецЦикла;
		
		ЗначенияРеквизитовСсылки = пбп_Переадресация.ЗначенияРеквизитовОбъекта(
			ВыгружаемыйОбъект, МассивИмен);
		
	КонецЕсли;
	
	ПарыПараметровURL = Новый Массив;
	Заголовки = Новый Соответствие;
	
	Для Каждого СтрокаПараметра Из ТаблицаСтрок Цикл
		
		Имя = СокрЛП(СтрокаПараметра.Имя);
		
		Если ПустаяСтрока(Имя) Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		ПолеОбъекта = СокрЛП(СтрокаПараметра.ПолеОбъекта);
		
		Если НаличиеПереопределений.Получить(Имя) <> Неопределено Тогда
			
			ЗначениеИсточника = Переопределения.Получить(Имя);
			
		ИначеЕсли ЗначениеЗаполнено(ПолеОбъекта) Тогда
			
			Если СтрНайти(ПолеОбъекта, ".") > 0 Тогда
				
				ВызватьИсключение НСтр(
					"ru = 'Поле объекта должно быть именем реквизита без точек'");
				
			КонецЕсли;
			
			Если ВыгружаемыйОбъект = Неопределено Тогда
				
				ВызватьИсключение НСтр(
					"ru = 'Не передан выгружаемый объект для чтения поля объекта'");
				
			КонецЕсли;
			
			Если пбп_Переадресация.ЭтоСсылка(ТипЗнч(ВыгружаемыйОбъект)) Тогда
				
				ЗначениеИсточника = ЗначенияРеквизитовСсылки[ПолеОбъекта];
				
			Иначе
				
				ЗначениеИсточника = ВыгружаемыйОбъект[ПолеОбъекта];
				
			КонецЕсли;
			
		Иначе
			
			ЗначениеИсточника = СтрокаПараметра.ЗначениеПоУмолчанию;
			
		КонецЕсли;
		
		ЗначениеСтрокой = СтроковоеЗначениеПараметраHTTP(ЗначениеИсточника, СтрокаПараметра.Тип);
		
		Если СтрокаПараметра.ПараметрURL Тогда
			
			ИмяКодированное = КодироватьСтроку(Имя, СпособКодированияСтроки.КодировкаURL);
			ЗначениеКодированное = КодироватьСтроку(
				ЗначениеСтрокой, СпособКодированияСтроки.КодировкаURL);
			ПарыПараметровURL.Добавить(ИмяКодированное + "=" + ЗначениеКодированное);
			
		Иначе
			
			Заголовки.Вставить(Имя, ЗначениеСтрокой);
			
		КонецЕсли;
		
	КонецЦикла;
	
	СтрокаПараметровURL = "";
	
	Если ПарыПараметровURL.Количество() > 0 Тогда
		
		СтрокаПараметровURL = "?" + СтрСоединить(ПарыПараметровURL, "&");
		
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("СтрокаПараметровURL", СтрокаПараметровURL);
	Результат.Вставить("Заголовки", Заголовки);
	
	Возврат Результат;
	
КонецФункции

// Получает структуру параметров метода интеграции со значениями по умолчанию
//
// Параметры:
//  Значение - СправочникСсылка.пбп_МетодыИнтеграции - ссылка на метод, параметры которого получаем.
//  ТипJSON - ПеречислениеСсылка.пбп_ТипыJSON - добавлять ли в возвращаемую структуру значения по умолчанию
//
// Возвращаемое значение:
//   - Строка - приведенное к JSON поле типа
//
Функция ПривестиЗначениеПоУмолчаниюREST(Значение, ТипJSON) Экспорт
	
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Если ТипJSON = Перечисления.пбп_ТипыJSON.Строка Тогда
			Возврат "";
		ИначеЕсли ТипJSON = Перечисления.пбп_ТипыJSON.Число Тогда
			Возврат 0;
		Иначе
			Возврат "null";
		КонецЕсли;
	КонецЕсли;
	
	Если ТипJSON = Перечисления.пбп_ТипыJSON.Булево Тогда
		ПреобразованноеЗначение = ?(Значение, "true", "false");
	ИначеЕсли ТипJSON = Перечисления.пбп_ТипыJSON.Дата Тогда
		ПреобразованноеЗначение = Формат(Значение, "ДФ=yyyy-MM-dd");
	ИначеЕсли ТипJSON = Перечисления.пбп_ТипыJSON.Число Тогда
		ПреобразованноеЗначение = Формат(Значение, "ЧГ=0");
	ИначеЕсли ТипJSON = Перечисления.пбп_ТипыJSON.Строка Тогда
		ПреобразованноеЗначение = Значение;
	Иначе
		ПреобразованноеЗначение = "";
	КонецЕсли;
	
	Возврат ПреобразованноеЗначение;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СкопироватьПереопределенияЗначений(
	ПереопределенияЗначений, Переопределения, НаличиеПереопределений)
	
	Если ПереопределенияЗначений = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ТипПереопределений = ТипЗнч(ПереопределенияЗначений);
	
	Если ТипПереопределений = Тип("Структура") Тогда
		
		Для Каждого Элемент Из ПереопределенияЗначений Цикл
			
			Переопределения.Вставить(Элемент.Ключ, Элемент.Значение);
			НаличиеПереопределений.Вставить(Элемент.Ключ, Истина);
			
		КонецЦикла;
		
	ИначеЕсли ТипПереопределений = Тип("Соответствие") Тогда
		
		Для Каждого Элемент Из ПереопределенияЗначений Цикл
			
			Переопределения.Вставить(Элемент.Ключ, Элемент.Значение);
			НаличиеПереопределений.Вставить(Элемент.Ключ, Истина);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Функция СтроковоеЗначениеПараметраHTTP(Значение, ТипJSON)
	
	Приведенное = ПривестиЗначениеПоУмолчаниюREST(Значение, ТипJSON);
	ТипПриведенного = ТипЗнч(Приведенное);
	
	Если ТипПриведенного = Тип("Строка") Тогда
		
		Возврат Приведенное;
		
	ИначеЕсли ТипПриведенного = Тип("Число") Тогда
		
		Возврат Формат(Приведенное, "ЧН=0; ЧГ=0");
		
	Иначе
		
		Возврат Строка(Приведенное);
		
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#КонецЕсли