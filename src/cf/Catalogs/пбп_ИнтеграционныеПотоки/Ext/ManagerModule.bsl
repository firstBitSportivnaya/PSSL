#Область ПрограммныйИнтерфейс

// Получить структуру параметров входа
//
// Параметры:
//  ИнтеграционныйПоток - СправочникСсылка.пбп_ИнтеграционныеПотоки - ссылка на поток, параметры которого получаем.
//  ЗаполнятьПоУмолчанию - Булево - добавлять ли в возвращаемую структуру значения по умолчанию
//    - Ложь - возвращает структуру вида ИмяПараметра<Строка>:ТипЗначения<ПеречислениеСсылка.пбп_ТипыJSON>
//    - Истина - возвращает структуру вида ИмяПараметра<Строка>:ЗначениеПоУмолчанию<Строка>
//
// Возвращаемое значение:
//   - Структура
//
Функция ПолучитьСтруктуруПараметровВхода(ИнтеграционныйПоток, ЗаполнятьПоУмолчанию = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	пбп_ИнтеграционныеПотокиПараметрыВхода.Имя КАК Имя,
	|	пбп_ИнтеграционныеПотокиПараметрыВхода.Тип КАК Тип,
	|	пбп_ИнтеграционныеПотокиПараметрыВхода.ПараметрURL КАК ПараметрURL,
	|	пбп_ИнтеграционныеПотокиПараметрыВхода.ЗначениеПоУмолчанию КАК ЗначениеПоУмолчанию,
	|	пбп_ИнтеграционныеПотокиПараметрыВхода.ПолеОбъекта КАК ПолеОбъекта
	|ИЗ
	|	Справочник.пбп_ИнтеграционныеПотоки.ПараметрыВхода КАК пбп_ИнтеграционныеПотокиПараметрыВхода
	|ГДЕ
	|	пбп_ИнтеграционныеПотокиПараметрыВхода.Ссылка = &ИнтеграционныйПоток";
	
	Запрос.УстановитьПараметр("ИнтеграционныйПоток", ИнтеграционныйПоток);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Результат = Новый Структура;
	
	Пока Выборка.Следующий() Цикл
		Имя = Выборка.Имя; 
		
		Если ЗаполнятьПоУмолчанию Тогда
			Результат.Вставить(Имя, ПривестиЗначениеПоУмолчаниюREST(Выборка.ЗначениеПоУмолчанию, Выборка.Тип));
		Иначе
			Результат.Вставить(Имя, Выборка.Тип);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Формирует строку параметров URL по строкам ТЧ «ПараметрыВхода» с признаком ПараметрURL.
//
// Параметры:
//  ИнтеграционныйПоток - СправочникСсылка.пбп_ИнтеграционныеПотоки - интеграционный поток.
//  ВыгружаемыйОбъект - Произвольный - ссылка, структура, объект или строка ТЧ с индексатором [Имя].
//    Неопределено допустимо, если ни у одной строки не заполнено ПолеОбъекта.
//
// Возвращаемое значение:
//  Строка - фрагмент «?name=value&…» или пустая строка.
//
Функция ПараметрыURLЗапроса(ИнтеграционныйПоток, ВыгружаемыйОбъект = Неопределено) Экспорт
	
	СтрокиЗначений = СтрокиЗначенийПараметровHTTPЗапроса(ИнтеграционныйПоток, ВыгружаемыйОбъект);
	ПарыПараметровURL = Новый Массив;
	
	Для Каждого СтрокаЗначения Из СтрокиЗначений Цикл
		
		Если Не СтрокаЗначения.ПараметрURL Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		ИмяКодированное = КодироватьСтроку(
			СтрокаЗначения.Имя, СпособКодированияСтроки.КодировкаURL);
		ЗначениеКодированное = КодироватьСтроку(
			СтрокаЗначения.ЗначениеСтрокой, СпособКодированияСтроки.КодировкаURL);
		ПарыПараметровURL.Добавить(ИмяКодированное + "=" + ЗначениеКодированное);
		
	КонецЦикла;
	
	Если ПарыПараметровURL.Количество() = 0 Тогда
		
		Возврат "";
		
	КонецЕсли;
	
	Возврат "?" + СтрСоединить(ПарыПараметровURL, "&");
	
КонецФункции

// Формирует заголовки HTTP по строкам ТЧ «ПараметрыВхода» без признака ПараметрURL.
//
// Параметры:
//  ИнтеграционныйПоток - СправочникСсылка.пбп_ИнтеграционныеПотоки - интеграционный поток.
//  ВыгружаемыйОбъект - Произвольный - ссылка, структура, объект или строка ТЧ с индексатором [Имя].
//
// Возвращаемое значение:
//  Соответствие - ключ и значение — строки без URL-кодирования; при повторе имени побеждает последняя строка.
//
Функция ЗаголовкиЗапроса(ИнтеграционныйПоток, ВыгружаемыйОбъект = Неопределено) Экспорт
	
	СтрокиЗначений = СтрокиЗначенийПараметровHTTPЗапроса(ИнтеграционныйПоток, ВыгружаемыйОбъект);
	Заголовки = Новый Соответствие;
	
	Для Каждого СтрокаЗначения Из СтрокиЗначений Цикл
		
		Если СтрокаЗначения.ПараметрURL Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		Заголовки.Вставить(СтрокаЗначения.Имя, СтрокаЗначения.ЗначениеСтрокой);
		
	КонецЦикла;
	
	Возврат Заголовки;
	
КонецФункции

// Возвращает строку параметров URL, заголовки и прокси HTTP по табличной части «ПараметрыВхода».
//
// Параметры:
//  ИнтеграционныйПоток - СправочникСсылка.пбп_ИнтеграционныеПотоки - интеграционный поток.
//  ВыгружаемыйОбъект - Произвольный - ссылка, структура, объект или строка ТЧ с индексатором [Имя].
//
// Возвращаемое значение:
//  Структура:
//   * СтрокаПараметровURL - Строка - результат ПараметрыURLЗапроса.
//   * Заголовки - Соответствие - результат ЗаголовкиЗапроса.
//   * Прокси - ИнтернетПрокси, Неопределено - встроенное прокси настройки потока.
//
Функция ПараметрыHTTPЗапроса(ИнтеграционныйПоток, ВыгружаемыйОбъект = Неопределено) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить(
		"СтрокаПараметровURL", ПараметрыURLЗапроса(ИнтеграционныйПоток, ВыгружаемыйОбъект));
	Результат.Вставить(
		"Заголовки", ЗаголовкиЗапроса(ИнтеграционныйПоток, ВыгружаемыйОбъект));
	Результат.Вставить("Прокси", ПроксиHTTPЗапроса(ИнтеграционныйПоток));
	
	Возврат Результат;
	
КонецФункции

// Определяет протокол для настройки встроенного прокси HTTP-запроса по строке подключения.
//
// Параметры:
//  СтрокаПодключения - Строка - адрес сервера из настройки интеграции.
//
// Возвращаемое значение:
//  Строка - "https" или "http".
//
Функция ПротоколПроксиHTTPЗапроса(СтрокаПодключения) Экспорт
	
	СтрокаПодключенияНРег = НРег(СокрЛП(СтрокаПодключения));
	
	Если СтрНачинаетсяС(СтрокаПодключенияНРег, "https://") Тогда
		
		Возврат "https";
		
	КонецЕсли;
	
	Возврат "http";
	
КонецФункции

// Получает структуру параметров метода интеграции со значениями по умолчанию
//
// Параметры:
//  Значение - СправочникСсылка.пбп_МетодыИнтеграции - ссылка на метод, параметры которого получаем.
//  ТипJSON - ПеречислениеСсылка.пбп_ТипыJSON - добавлять ли в возвращаемую структуру значения по умолчанию
//
// Возвращаемое значение:
//   - Строка - приведенное к JSON поле типа
//
Функция ПривестиЗначениеПоУмолчаниюREST(Значение, ТипJSON) Экспорт
	
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Если ТипJSON = Перечисления.пбп_ТипыJSON.Строка Тогда
			Возврат "";
		ИначеЕсли ТипJSON = Перечисления.пбп_ТипыJSON.Число Тогда
			Возврат 0;
		Иначе
			Возврат "null";
		КонецЕсли;
	КонецЕсли;
	
	Если ТипJSON = Перечисления.пбп_ТипыJSON.Булево Тогда
		ПреобразованноеЗначение = ?(Значение, "true", "false");
	ИначеЕсли ТипJSON = Перечисления.пбп_ТипыJSON.Дата Тогда
		ПреобразованноеЗначение = Формат(Значение, "ДФ=yyyy-MM-dd");
	ИначеЕсли ТипJSON = Перечисления.пбп_ТипыJSON.Число Тогда
		ПреобразованноеЗначение = Формат(Значение, "ЧГ=0");
	ИначеЕсли ТипJSON = Перечисления.пбп_ТипыJSON.Строка Тогда
		ПреобразованноеЗначение = Значение;
	Иначе
		ПреобразованноеЗначение = "";
	КонецЕсли;
	
	Возврат ПреобразованноеЗначение;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПроксиHTTPЗапроса(ИнтеграционныйПоток)
	
	Если Не ЗначениеЗаполнено(ИнтеграционныйПоток) Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	РеквизитыПотока = пбп_Переадресация.ЗначенияРеквизитовОбъекта(ИнтеграционныйПоток, "НастройкаИнтеграции");
	НастройкаИнтеграции = РеквизитыПотока.НастройкаИнтеграции;
	
	Если Не ЗначениеЗаполнено(НастройкаИнтеграции) Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	РеквизитыНастройки = пбп_Переадресация.ЗначенияРеквизитовОбъекта(
		НастройкаИнтеграции, "ИспользоватьВстроенноеПрокси, СтрокаПодключения");
	
	Если Не РеквизитыНастройки.ИспользоватьВстроенноеПрокси Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	Возврат пбп_Переадресация.ПолучитьПрокси(ПротоколПроксиHTTPЗапроса(РеквизитыНастройки.СтрокаПодключения));
	
КонецФункции

Функция СтрокиЗначенийПараметровHTTPЗапроса(ИнтеграционныйПоток, ВыгружаемыйОбъект)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	пбп_ИнтеграционныеПотокиПараметрыВхода.Имя КАК Имя,
	|	пбп_ИнтеграционныеПотокиПараметрыВхода.Тип КАК Тип,
	|	пбп_ИнтеграционныеПотокиПараметрыВхода.ПараметрURL КАК ПараметрURL,
	|	пбп_ИнтеграционныеПотокиПараметрыВхода.ЗначениеПоУмолчанию КАК ЗначениеПоУмолчанию,
	|	пбп_ИнтеграционныеПотокиПараметрыВхода.ПолеОбъекта КАК ПолеОбъекта
	|ИЗ
	|	Справочник.пбп_ИнтеграционныеПотоки.ПараметрыВхода КАК пбп_ИнтеграционныеПотокиПараметрыВхода
	|ГДЕ
	|	пбп_ИнтеграционныеПотокиПараметрыВхода.Ссылка = &ИнтеграционныйПоток
	|УПОРЯДОЧИТЬ ПО
	|	пбп_ИнтеграционныеПотокиПараметрыВхода.НомерСтроки";
	
	Запрос.УстановитьПараметр("ИнтеграционныйПоток", ИнтеграционныйПоток);
	
	ТаблицаСтрок = Запрос.Выполнить().Выгрузить();
	ИменаПолейОбъекта = Новый Соответствие;
	
	Для Каждого СтрокаПараметра Из ТаблицаСтрок Цикл
		
		ПолеОбъекта = СокрЛП(СтрокаПараметра.ПолеОбъекта);
		
		Если ЗначениеЗаполнено(ПолеОбъекта)
			И СтрНайти(ПолеОбъекта, ".") = 0 Тогда
			
			ИменаПолейОбъекта.Вставить(ПолеОбъекта, Истина);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЗначенияРеквизитовСсылки = Неопределено;
	
	Если ВыгружаемыйОбъект <> Неопределено
		И пбп_Переадресация.ЭтоСсылка(ТипЗнч(ВыгружаемыйОбъект))
		И ИменаПолейОбъекта.Количество() > 0 Тогда
		
		МассивИмен = Новый Массив;
		
		Для Каждого ЭлементИмени Из ИменаПолейОбъекта Цикл
			
			МассивИмен.Добавить(ЭлементИмени.Ключ);
			
		КонецЦикла;
		
		ЗначенияРеквизитовСсылки = пбп_Переадресация.ЗначенияРеквизитовОбъекта(
			ВыгружаемыйОбъект, МассивИмен);
		
	КонецЕсли;
	
	СтрокиЗначений = Новый Массив;
	
	Для Каждого СтрокаПараметра Из ТаблицаСтрок Цикл
		
		Имя = СокрЛП(СтрокаПараметра.Имя);
		ПолеОбъекта = СокрЛП(СтрокаПараметра.ПолеОбъекта);
		
		Если ЗначениеЗаполнено(ПолеОбъекта) Тогда
			
			Если СтрНайти(ПолеОбъекта, ".") > 0 Тогда
				
				ВызватьИсключение НСтр(
					"ru = 'Поле объекта должно быть именем реквизита без точек'");
				
			КонецЕсли;
			
			Если ВыгружаемыйОбъект = Неопределено Тогда
				
				ВызватьИсключение НСтр(
					"ru = 'Не передан выгружаемый объект для чтения поля объекта'");
				
			КонецЕсли;
			
			Если пбп_Переадресация.ЭтоСсылка(ТипЗнч(ВыгружаемыйОбъект)) Тогда
				
				ЗначениеИсточника = ЗначенияРеквизитовСсылки[ПолеОбъекта];
				
			Иначе
				
				ЗначениеИсточника = ВыгружаемыйОбъект[ПолеОбъекта];
				
			КонецЕсли;
			
		Иначе
			
			ЗначениеИсточника = СтрокаПараметра.ЗначениеПоУмолчанию;
			
		КонецЕсли;
		
		ЗначениеСтрокой = СтроковоеЗначениеПараметраHTTP(ЗначениеИсточника, СтрокаПараметра.Тип);
		
		СтрокаЗначения = Новый Структура(
			"Имя, ЗначениеСтрокой, ПараметрURL", Имя, ЗначениеСтрокой, СтрокаПараметра.ПараметрURL);
		СтрокиЗначений.Добавить(СтрокаЗначения);
		
	КонецЦикла;
	
	Возврат СтрокиЗначений;
	
КонецФункции

Функция СтроковоеЗначениеПараметраHTTP(Значение, ТипJSON)
	
	Если ТипЗнч(Значение) = Тип("Число")
		И (ЗначениеЗаполнено(Значение) Или ТипJSON = Перечисления.пбп_ТипыJSON.Число) Тогда
		
		Возврат XMLСтрока(Значение);
		
	КонецЕсли;
	
	Приведенное = ПривестиЗначениеПоУмолчаниюREST(Значение, ТипJSON);
	
	Если ТипЗнч(Приведенное) = Тип("Строка") Тогда
		
		Возврат Приведенное;
		
	КонецЕсли;
	
	Возврат Строка(Приведенное);
	
КонецФункции

#КонецОбласти

#КонецЕсли