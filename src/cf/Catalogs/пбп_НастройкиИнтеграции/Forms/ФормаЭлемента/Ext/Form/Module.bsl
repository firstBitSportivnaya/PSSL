// Заполняет реквизит формы СписокСообщений сообщениями каналов из таблицы Список.
//
// Параметры:
//  СервисОтбора       - Строка - Имя сервиса интеграции; пустая строка — без отбора по сервису.
//  КаналОтбора        - Строка - Имя канала; пустая строка — без отбора по каналу.
//  ПодменаСообщений   - Соответствие, Неопределено - только для проверки отбора в тестах;
//                       ключ — Сервис + "|" + Канал, значение — массив структур, как у СообщенияКанала;
//                       при вызове с формы не передаётся.
//
&НаСервере
Процедура ОтобратьНаСервере(СервисОтбора = "", КаналОтбора = "", ПодменаСообщений = Неопределено) Экспорт
	
	СписокСообщений.Очистить();
	
	Для Каждого Строка Из Список Цикл
		
		Если ЗначениеЗаполнено(СервисОтбора) И Строка.Сервис <> СервисОтбора Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(КаналОтбора) И Строка.Канал <> КаналОтбора Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПодменаСообщений = Неопределено Тогда
			
			СообщенияКанала = пбп_ИнтеграцииСлужебный.СообщенияКанала(Строка.Сервис, Строка.Канал);
			
		Иначе
			
			КлючКанала = Строка.Сервис + "|" + Строка.Канал;
			СообщенияКанала = ПодменаСообщений.Получить(КлючКанала);
			
			Если СообщенияКанала = Неопределено Тогда
				
				СообщенияКанала = Новый Массив;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Для Каждого ОписаниеСообщения Из СообщенияКанала Цикл
			
			НовоеСообщение = СписокСообщений.Добавить();
			НовоеСообщение.Сервис = ОписаниеСообщения.Сервис;
			НовоеСообщение.Канал = ОписаниеСообщения.Канал;
			НовоеСообщение.Идентификатор = ОписаниеСообщения.Идентификатор;
			НовоеСообщение.ИдентификаторСообщенияЗапроса = ОписаниеСообщения.ИдентификаторСообщенияЗапроса;
			НовоеСообщение.ДатаОтправки = ОписаниеСообщения.ДатаОтправки;
			НовоеСообщение.ДатаУстаревания = ОписаниеСообщения.ДатаУстаревания;
			НовоеСообщение.КодОтправителя = ОписаниеСообщения.КодОтправителя;
			НовоеСообщение.КодПолучателя = ОписаниеСообщения.КодПолучателя;
			НовоеСообщение.РазмерТела = ОписаниеСообщения.РазмерТела;
			
			Для Каждого ОписаниеПараметра Из ОписаниеСообщения.ПараметрыСообщения Цикл
				
				НовыйПараметр = НовоеСообщение.ПараметрыСообщения.Добавить();
				ЗаполнитьЗначенияСвойств(НовыйПараметр, ОписаниеПараметра);
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

