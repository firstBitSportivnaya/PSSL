#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьСвойстваЭлементов();
	
	ВывестиДополнительныеНастройки();
	
	Если ЭтоБрокер1СШина Тогда
		
		ОбновитьСписок();
		
	КонецЕсли;
	
	АвтоОбновлениеСписка = Истина;
	ПериодОбновленияСписка = 30;
	ОжиданиеОбновленияСтатусовКаналовАктивно = Ложь;
	
	// Включаем видимость страницы отборы и отборы в поиске сообщений
	ВключитьОтборы = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПодключитьТаймерОбновленияСтатусовКаналов();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ДанныеКомпоненты = ТекущийОбъект.ВнешняяКомпонента.Получить();
	Если Не ДанныеКомпоненты = Неопределено Тогда
		АдресВнешнейКомпоненты = ПоместитьВоВременноеХранилище(ДанныеКомпоненты, Новый УникальныйИдентификатор);
	КонецЕсли;
	
	ЗаполнитьНастройкиИзБезопасногоХранилища();
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если ВнешняяКомпонентаЗагруженаИзФайла Тогда
		ДвоичныеДанныеКомпоненты = ПолучитьИзВременногоХранилища(АдресВнешнейКомпоненты);
		ТекущийОбъект.ВнешняяКомпонента = Новый ХранилищеЗначения(ДвоичныеДанныеКомпоненты, Новый СжатиеДанных());
	КонецЕсли;
	
	Если Модифицированность И Не ПустаяСтрока(Объект.ИдентификаторНастройки) Тогда
		ТекущийОбъект.ИзмененВручную = Истина;
	КонецЕсли;
	
	СохранитьДополнительныеНастройки(ТекущийОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	СтруктураНастроек = Новый Структура();
	
	Если Не ЭтоТипАвторизацииБезАвторизации(Объект.ТипАвторизации) Тогда
		
		Для Каждого ТекСтрока Из СписокНастроек Цикл
			
			Если Не ЗначениеЗаполнено(ТекСтрока.Значение) Тогда
				Продолжить;
			КонецЕсли;
			
			Настройка = Новый Структура("ИмяНастройки, Значение");
			ЗаполнитьЗначенияСвойств(Настройка, ТекСтрока);
			СтруктураНастроек.Вставить(ТекСтрока.ИмяНастройки, Настройка);
		КонецЦикла;
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ПараметрыАутентификацииОчищены Тогда

		пбп_Переадресация.УдалитьДанныеИзБезопасногоХранилища(ТекущийОбъект.Ссылка);
		ПараметрыАутентификацииОчищены = Ложь;

	Иначе

		пбп_Переадресация.ЗаписатьДанныеВБезопасноеХранилище(ТекущийОбъект.Ссылка, СтруктураНастроек);

	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ТипИнтеграцииПриИзменении(Элемент)
	
	УстановитьСвойстваЭлементов();
	
	Объект.СтрокаПодключения	= "";
	Объект.Порт					= 0;
	Объект.УчетнаяЗапись		= Неопределено;
	Объект.ТипАвторизации		= пбп_ПереадресацияКлиент.ПредопределенныйЭлемент(
		"Перечисление.пбп_ТипыАвторизации.ПустаяСсылка");
	Объект.ИмяОбъекта			= "";
	Объект.ИспользоватьПользовательскиеФункции = Ложь;
	Объект.ИспользоватьВстроенноеПрокси = Ложь;
	
	УстановитьДоступностьКнопкиПараметрыАутентификации(Элементы, Объект.ТипАвторизации);
	ТипАвторизацииДоИзменения = Объект.ТипАвторизации;
	
	ВывестиДополнительныеНастройки();
	
	Если ЭтоБрокер1СШина Тогда
		
		ОбновитьСписок();
		
	Иначе
		
		ОчиститьСпискиКаналовШины();
		
	КонецЕсли;
	
	ПодключитьТаймерОбновленияСтатусовКаналов();
	
КонецПроцедуры

&НаКлиенте
Процедура СтрокаПодключенияНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ЗаголовокДиалога = НСтр("ru = 'Укажите каталог'");
	
	РежимОткрытияДиалога = РежимДиалогаВыбораФайла.ВыборКаталога;
	ДиалогОткрытия = Новый ДиалогВыбораФайла(РежимОткрытияДиалога);
	ДиалогОткрытия.Каталог = Объект.СтрокаПодключения;
	ДиалогОткрытия.Заголовок = ЗаголовокДиалога;
	
	Оповещение = Новый ОписаниеОповещения("ОбработчикВыбораФайловогоКаталогаЗавершениеПослеВыбораВДиалоге", ЭтотОбъект);
	
	ДиалогОткрытия.Показать(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура СтрокаПодключенияМногострочнаяПриИзменении(Элемент)
	
	Если ПроверитьЭтоИнтеграцияСВнешнимИсточникомДанных(Объект.ТипИнтеграции) Тогда
		Объект.ТипСУБД = ПолучитьИмяСУБДВнешнегоИсточникаДанныхПоСтрокеСоединения(Объект.СтрокаПодключения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокНастроекПриИзменении(Элемент)
	
	Модифицированность = Истина;
	ПараметрыАутентификацииОчищены = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ЭтоТехническаяНастройкаПриИзменении(Элемент)
	УстановитьСвойстваЭлементовВЗависимостиОтТипаИнтеграции();
КонецПроцедуры

&НаКлиенте
Процедура ТипАвторизацииПриИзменении(Элемент)
	
	УстановитьДоступностьКнопкиПараметрыАутентификации(Элементы, Объект.ТипАвторизации);

	Если Не ЭтоТипАвторизацииБезАвторизации(Объект.ТипАвторизации) Тогда

		ТипАвторизацииДоИзменения = Объект.ТипАвторизации;
		Возврат;

	КонецЕсли;

	Если ЕстьЗаполненныеПараметрыАутентификации() Тогда

		ТекстВопроса = НСтр("ru = 'Параметры аутентификации будут очищены. Продолжить?'");
		Оповещение = Новый ОписаниеОповещения("ТипАвторизацииПриИзмененииЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);

	Иначе

		ЗавершитьИзменениеТипаАвторизации(Истина);

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПортВИнтеграционномПотокеПриИзменении(Элемент)
	УстановитьСвойстваЭлементов();
КонецПроцедуры

#КонецОбласти // ОбработчикиСобытийФормы

#Область ОбработчикиСписок

&НаКлиенте
Процедура ОбновитьСтатусыКаналов(Команда)
	
	ОбновитьСтатусыКаналовНаСервере();
	ПодключитьТаймерОбновленияСтатусовКаналов();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтатусыКаналовПоТаймеру() Экспорт
	
	ОбновитьСтатусыКаналовНаСервере();
	
	Если ЭтоБрокер1СШина И АвтоОбновлениеСписка Тогда
		
		ПодключитьОбработчикОжидания("ОбновитьСтатусыКаналовПоТаймеру", ПериодОбновленияСписка, Истина);
		УстановитьПризнакОжиданияОбновленияСтатусовКаналовНаСервере(Истина);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодключитьТаймерОбновленияСтатусовКаналов()
	
	ОтключитьОбработчикОжидания("ОбновитьСтатусыКаналовПоТаймеру");
	УстановитьПризнакОжиданияОбновленияСтатусовКаналовНаСервере(Ложь);
	
	Если Не ЭтоБрокер1СШина Или Не АвтоОбновлениеСписка Тогда
		Возврат;
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("ОбновитьСтатусыКаналовПоТаймеру", ПериодОбновленияСписка, Истина);
	УстановитьПризнакОжиданияОбновленияСтатусовКаналовНаСервере(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтобратьСообщения(Команда)
	
	ОтобратьСообщенияПоТекущемуКаналу();
	
КонецПроцедуры

&НаКлиенте
Процедура АвтоОбновлениеСпискаПриИзменении(Элемент)
	
	Если АвтоОбновлениеСписка Тогда
		
		ПодключитьТаймерОбновленияСтатусовКаналов();
		
	Иначе
		
		ОтключитьОбработчикОжидания("ОбновитьСтатусыКаналовПоТаймеру");
		УстановитьПризнакОжиданияОбновленияСтатусовКаналовНаСервере(Ложь);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ОтобратьСообщенияПоТекущемуКаналу();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтобратьСообщенияПоТекущемуКаналу()
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОтобратьНаСервере(ТекущиеДанные.Сервис, ТекущиеДанные.Канал);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыполнитьОбработку(Команда)
	
	ВыполнитьОбработкуНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ОстановитьОбработку(Команда)
	
	ОстановитьОбработкуНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьОбщие(Команда)
	
	ОбщиеЗначения = ПолучитьОбщиеЗначения();
	
	Если СписокНастроек.Количество() Тогда
		ПроизвестиПроверкуСуществованияРеквизитов(ОбщиеЗначения);
	КонецЕсли;
	
	Для Каждого ТекЭлемент Из ОбщиеЗначения Цикл
		
		НоваяСтрока = СписокНастроек.Добавить();
		НоваяСтрока.ИмяНастройки	= ТекЭлемент;
		НоваяСтрока.Значение		= "";
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьЗначения(Команда)
	
	Пометка = НЕ Элементы.СписокНастроекПоказатьЗначения.Пометка;
	Элементы.СписокНастроекПоказатьЗначения.Пометка = Пометка;
	Элементы.СписокНастроекЗначениеПредставление.Видимость = Пометка;
	Элементы.СписокНастроекЗначение.Видимость = НЕ Пометка;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодключитьВнешнююКомпонентуИзФайла(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Или Модифицированность Тогда
		ТекстСообщения = НСтр("ru = 'Для изменения файла внешней компоненты необходимо записать справочник. Записать?'");
		ОписаниеОповещения = Новый ОписаниеОповещения("ПодключитьВнешнююКомпонентуИзФайлаЗавершение", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещения, ТекстСообщения, РежимДиалогаВопрос.ОКОтмена);
	Иначе
		ОткрытьФормуЗагрузкиВнешнейКомпоненты();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСоединениеСБазойДанных(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Или Модифицированность Тогда
		ТекстСообщения = НСтр(
			"ru = 'Для изменения параметров соединения с базой данных необходимо записать справочник. Записать?'");
		ОписаниеОповещения = Новый ОписаниеОповещения("УстановитьСоединениеСБазойДанныхЗавершение", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещения, ТекстСообщения, РежимДиалогаВопрос.ОКОтмена);
	Иначе
		ЗаписатьПараметрыСоединенияСБазойДанныхИУстановитьСоединение();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти // ОбработчикиКомандФормы

#Область ОбработчикиСписокСообщений

&НаКлиенте
Процедура ОчиститьВсеСообщения(Команда)
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Сервис", ТекущиеДанные.Сервис);
	ДополнительныеПараметры.Вставить("Канал", ТекущиеДанные.Канал);
	
	ТекстВопроса = НСтр("ru = 'Удалить все сообщения выбранного канала?'");
	Оповещение = Новый ОписаниеОповещения("ОчиститьВсеСообщенияЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьВсеСообщенияЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	МассивКаналов = Новый Массив;
	МассивКаналов.Добавить(ДополнительныеПараметры.Канал);
	
	ОчиститьВсеСообщенияНаСервере(ДополнительныеПараметры.Сервис, МассивКаналов);
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено
		И ТекущиеДанные.Сервис = ДополнительныеПараметры.Сервис
		И ТекущиеДанные.Канал = ДополнительныеПараметры.Канал Тогда
		
		ДанныеДляЗаполнения = СостояниеКаналаНаСервере(
			ДополнительныеПараметры.Сервис, ДополнительныеПараметры.Канал);
		
		ТекущиеДанные.Состояние = ДанныеДляЗаполнения.Состояние;
		ТекущиеДанные.Количество = ДанныеДляЗаполнения.Количество;
		
	КонецЕсли;
	
	ОтобратьНаСервере(ДополнительныеПараметры.Сервис, ДополнительныеПараметры.Канал);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Обновляет состояние и количество сообщений по строкам таблицы Список.
//
&НаСервере
Процедура ОбновитьСтатусыКаналовНаСервере()
	
	Для Каждого ТекСтрока Из Список Цикл
		
		ДанныеКанала = пбп_ИнтеграцииСлужебный.СостояниеКанала(ТекСтрока.Сервис, ТекСтрока.Канал);
		ТекСтрока.Состояние = ДанныеКанала.Состояние;
		ТекСтрока.Количество = ДанныеКанала.Количество;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСвойстваЭлементов()
	
	Элементы.СтрокаПодключения.КнопкаВыбора = Ложь;
	
	ГруппаСтрокаПорт					= "ГруппаСтрокаПорт";
	СтрокаПодключенияМногострочная		= "СтрокаПодключенияМногострочная";
	УстановитьСоединениеСБазойДанных	= "УстановитьСоединениеСБазойДанных";
	ТипСУБДСтрокой						= "ТипСУБД";
	
	УстанавливаемоеСвойство = "Видимость";
	
	пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ИспользоватьВстроенноеПрокси", УстанавливаемоеСвойство, Ложь);
	пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, СтрокаПодключенияМногострочная, УстанавливаемоеСвойство, Ложь);
	пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, ГруппаСтрокаПорт, УстанавливаемоеСвойство, Истина);
	пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, УстановитьСоединениеСБазойДанных, УстанавливаемоеСвойство, Ложь);
	пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, ТипСУБДСтрокой, УстанавливаемоеСвойство, Ложь);
	
	Если Не ЗначениеЗаполнено(Объект.ТипИнтеграции) Тогда
		Элементы.СтрокаПодключения.Заголовок = НСтр("ru = 'Каталог'");
		
		Элементы.ГруппаНастройкиВыполнения.Видимость = Ложь;
		Элементы.ПланОбмена.Видимость = Ложь;
	Иначе
		УстановитьСвойстваЭлементовВЗависимостиОтТипаИнтеграции();
	КонецЕсли;
	
	УстановитьДоступностьКнопкиПараметрыАутентификации(Элементы, Объект.ТипАвторизации);
	ТипАвторизацииДоИзменения = Объект.ТипАвторизации;
	
	ДоступноПоРолям = пбп_ИнтеграцииСлужебный.ДоступноИзменениеИнтеграционныхПотоков();
	
	Элементы.ГруппаОсновныеНастройки.Видимость = ДоступноПоРолям;
	Элементы.СписокНастроек.Видимость = ДоступноПоРолям;
	Элементы.УстановитьСоединениеСБазойДанных.Видимость =
		Элементы.УстановитьСоединениеСБазойДанных.Видимость И ДоступноПоРолям;

	Элементы.Порт.Видимость = Элементы.Порт.Видимость И Не Объект.ПортВИнтеграционномПотоке;
	
	ЭтоБрокер1СШина = пбп_ИнтеграцииСлужебный.ЭтоБрокер1СШина(Объект.ТипИнтеграции);
	
КонецПроцедуры

&НаКлиенте
// Завершает изменение типа авторизации после ответа пользователя.
Процедура ТипАвторизацииПриИзмененииЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт

	ЗавершитьИзменениеТипаАвторизации(РезультатВопроса = КодВозвратаДиалога.Да);

КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьИзменениеТипаАвторизации(ОчиститьПараметры)

	Если ОчиститьПараметры Тогда

		ОчиститьПараметрыАутентификации();

	Иначе

		Объект.ТипАвторизации = ТипАвторизацииДоИзменения;

	КонецЕсли;

	УстановитьДоступностьКнопкиПараметрыАутентификации(Элементы, Объект.ТипАвторизации);
	ТипАвторизацииДоИзменения = Объект.ТипАвторизации;

КонецПроцедуры

&НаКлиенте
Функция ЕстьЗаполненныеПараметрыАутентификации()
	
	Для Каждого СтрокаНастройки Из СписокНастроек Цикл
		
		Если ЗначениеЗаполнено(СтрокаНастройки.Значение) Тогда
			Возврат Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура ОчиститьПараметрыАутентификации()
	
	СписокНастроек.Очистить();
	Модифицированность = Истина;
	ПараметрыАутентификацииОчищены = Истина;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьКнопкиПараметрыАутентификации(ЭлементыФормы, ТипАвторизации)
	
	ПараметрыДоступны = Не ЭтоТипАвторизацииБезАвторизации(ТипАвторизации);
	ЭлементыФормы.СписокНастроек.Доступность = ПараметрыДоступны;
	ЭлементыФормы.СписокНастроекДобавитьОбщиеНастройки.Доступность = ПараметрыДоступны;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоТипАвторизацииБезАвторизации(ТипАвторизации)

	Возврат ТипАвторизации =
		ПредопределенноеЗначение("Перечисление.пбп_ТипыАвторизации.БезАвторизации");

КонецФункции

&НаСервере
Процедура УстановитьСвойстваЭлементовВЗависимостиОтТипаИнтеграции()
	
	Элементы.ГруппаНастройкиВыполнения.Видимость = Не Объект.ЭтоТехническаяНастройка;
	Элементы.ПланОбмена.Видимость = Объект.ЭтоТехническаяНастройка;
	
	ГруппаОсновныеНастройки				= "ГруппаОсновныеНастройки";
	ГруппаСтрокаПорт					= "ГруппаСтрокаПорт";
	СтрокаПодключения					= "СтрокаПодключения";
	Порт								= "Порт";
	УчетнаяЗапись						= "УчетнаяЗапись";
	ТипАвторизации						= "ТипАвторизации";
	ИмяОбъекта							= "ИмяОбъекта";
	ИспользоватьПользовательскиеФункции	= "ИспользоватьПользовательскиеФункции";
	СписокНастроекСтрока				= "СписокНастроек";
	ПодключитьВнешнююКомпоненту			= "ПодключитьВнешнююКомпоненту";
	СтрокаПодключенияМногострочная		= "СтрокаПодключенияМногострочная";
	УстановитьСоединениеСБазойДанных	= "УстановитьСоединениеСБазойДанных";
	ТипСУБДСтрокой						= "ТипСУБД";
	
	СерверСтрока = НСтр("ru = 'Сервер'");
	
	УстанавливаемоеСвойство = "Видимость";
	
	пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "СтраницаОбщая", УстанавливаемоеСвойство, Ложь);
	пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ГруппаКнопки", УстанавливаемоеСвойство, Ложь);
	пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ЭтоТехническаяНастройка", УстанавливаемоеСвойство, Истина);
	
	пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, ГруппаОсновныеНастройки, УстанавливаемоеСвойство, Истина);
		
	ЭлементНаследования = Справочники.пбп_ТипыИнтеграций
		.ПолучитьПредопределенныйЭлементНаследованияНастроекТипаИнтеграции(Объект.ТипИнтеграции);
	Если ЭлементНаследования = Справочники.пбп_ТипыИнтеграций.Каталог Тогда
		Элементы.СтрокаПодключения.Заголовок = НСтр("ru = 'Каталог'");
		
		Элементы.СтрокаПодключения.КнопкаВыбора = Истина;
		
		УстановитьВидимостьЭлементовДляТипаФайловыеОбмены();
		
		пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, СтрокаПодключения, УстанавливаемоеСвойство, Истина);
		пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, Порт, УстанавливаемоеСвойство, Ложь);
		пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, УчетнаяЗапись, УстанавливаемоеСвойство, Ложь);
		пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, СписокНастроекСтрока, УстанавливаемоеСвойство, Ложь);
	ИначеЕсли ЭлементНаследования = Справочники.пбп_ТипыИнтеграций.FTPРесурсы Тогда
		Элементы.СтрокаПодключения.Заголовок = НСтр("ru = 'Адрес сервера'");
		
		УстановитьВидимостьЭлементовДляТипаФайловыеОбмены();
		
		пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, СтрокаПодключения, УстанавливаемоеСвойство, Истина);
		пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, Порт, УстанавливаемоеСвойство, Истина);
		пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, УчетнаяЗапись, УстанавливаемоеСвойство, Ложь);
		пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, СписокНастроекСтрока, УстанавливаемоеСвойство, Истина);
	ИначеЕсли ЭлементНаследования = Справочники.пбп_ТипыИнтеграций.ПочтовыйКлиент Тогда
		УстановитьВидимостьЭлементовДляТипаФайловыеОбмены();
		
		пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, СтрокаПодключения, УстанавливаемоеСвойство, Ложь);
		пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, Порт, УстанавливаемоеСвойство, Ложь);
		пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, УчетнаяЗапись, УстанавливаемоеСвойство, Истина);
		пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, СписокНастроекСтрока, УстанавливаемоеСвойство, Ложь);
	ИначеЕсли ЭлементНаследования = Справочники.пбп_ТипыИнтеграций.ПрямоеПодключениеКБД Тогда
		Элементы.СтрокаПодключенияМногострочная.Заголовок = НСтр("ru = 'Строка соединения (без данных аутентификации)'");
		Элементы.ИмяОбъекта.Заголовок = НСтр("ru = 'Имя внешнего источника данных'");
		Элементы.ИмяОбъекта.РежимВыбораИзСписка = Истина;
		
		ЗаполнитьСписокВыбораВнешнихИсточниковДанных();
		
		УстановитьВидимостьЭлементовДляComИПрямогоПодключенияКБД();
		
		пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, УстановитьСоединениеСБазойДанных, УстанавливаемоеСвойство, Истина);
		пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, ТипСУБДСтрокой, УстанавливаемоеСвойство, Истина);
	ИначеЕсли ЭлементНаследования = Справочники.пбп_ТипыИнтеграций.COM Тогда
		Элементы.СтрокаПодключенияМногострочная.Заголовок = НСтр("ru = 'Строка подключения'");
		Элементы.ИмяОбъекта.Заголовок = НСтр("ru = 'Имя COM-объекта'");
		Элементы.ИмяОбъекта.РежимВыбораИзСписка = Ложь;
		Элементы.ИмяОбъекта.СписокВыбора.Очистить();
		
		УстановитьВидимостьЭлементовДляComИПрямогоПодключенияКБД();
	ИначеЕсли ЭлементНаследования = Справочники.пбп_ТипыИнтеграций.RESTAPI
		Или ЭлементНаследования = Справочники.пбп_ТипыИнтеграций.SOAP Тогда
		Элементы.СтрокаПодключения.Заголовок = СерверСтрока;
		
		УстановитьВидимостьЭлементовДляОстальныхТипов();
		
		пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, Порт, УстанавливаемоеСвойство, Истина);
		пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, ТипАвторизации, УстанавливаемоеСвойство, Истина);
		пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, ИмяОбъекта, УстанавливаемоеСвойство, Ложь);
		пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, СписокНастроекСтрока, УстанавливаемоеСвойство, Истина);
		пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, ПодключитьВнешнююКомпоненту, УстанавливаемоеСвойство, Ложь);
		пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "ИспользоватьВстроенноеПрокси", УстанавливаемоеСвойство, Истина);
	ИначеЕсли ЭлементНаследования = Справочники.пбп_ТипыИнтеграций.ВнешняяКомпонента Тогда
		Элементы.СтрокаПодключения.Заголовок = НСтр("ru = 'Имя компоненты'");
		
		УстановитьВидимостьЭлементовДляОстальныхТипов();
		
		пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, Порт, УстанавливаемоеСвойство, Ложь);
		пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, ТипАвторизации, УстанавливаемоеСвойство, Ложь);
		пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, ИмяОбъекта, УстанавливаемоеСвойство, Ложь);
		пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, СписокНастроекСтрока, УстанавливаемоеСвойство, Ложь);
		пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, ПодключитьВнешнююКомпоненту, УстанавливаемоеСвойство, Истина);
	ИначеЕсли ЭлементНаследования = Справочники.пбп_ТипыИнтеграций.КоманднаяСтрока Тогда
		Элементы.СтрокаПодключения.Заголовок = НСтр("ru = 'Исполняемый файл'");
		
		УстановитьВидимостьЭлементовДляОстальныхТипов();
		
		пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, Порт, УстанавливаемоеСвойство, Ложь);
		пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, ТипАвторизации, УстанавливаемоеСвойство, Ложь);
		пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, ИмяОбъекта, УстанавливаемоеСвойство, Ложь);
		пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, СписокНастроекСтрока, УстанавливаемоеСвойство, Ложь);
		пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, ПодключитьВнешнююКомпоненту, УстанавливаемоеСвойство, Ложь);
	ИначеЕсли ЭлементНаследования = Справочники.пбп_ТипыИнтеграций.БрокерыСообщений Тогда
		
		Если пбп_ИнтеграцииСлужебный.ЭтоБрокер1СШина(Объект.ТипИнтеграции) Тогда
			
			пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
				Элементы, ГруппаСтрокаПорт, УстанавливаемоеСвойство, Ложь);
			пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
				Элементы, ТипАвторизации, УстанавливаемоеСвойство, Ложь);
			пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
				Элементы, СписокНастроекСтрока, УстанавливаемоеСвойство, Ложь);
			пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
				Элементы, "ЭтоТехническаяНастройка", УстанавливаемоеСвойство, Ложь);
			пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
				Элементы, "ГруппаНастройкиВыполнения", УстанавливаемоеСвойство, Ложь);
			пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
				Элементы, "ПланОбмена", УстанавливаемоеСвойство, Ложь);
			пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
				Элементы, "СтраницаОбщая", УстанавливаемоеСвойство, Истина);
			пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
				Элементы, "ГруппаКнопки", УстанавливаемоеСвойство, Истина);
			
		Иначе
			
			Элементы.СтрокаПодключения.Заголовок = СерверСтрока;
			
			УстановитьВидимостьЭлементовДляОстальныхТипов();
			
			пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
				Элементы, Порт, УстанавливаемоеСвойство, Истина);
			пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
				Элементы, ТипАвторизации, УстанавливаемоеСвойство, Истина);
			пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
				Элементы, ИмяОбъекта, УстанавливаемоеСвойство, Ложь);
			пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
				Элементы, СписокНастроекСтрока, УстанавливаемоеСвойство, Истина);
			пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
				Элементы, ПодключитьВнешнююКомпоненту, УстанавливаемоеСвойство, Ложь);
			
		КонецЕсли;
	Иначе
		пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, СтрокаПодключения, УстанавливаемоеСвойство, Истина);
		пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, ИспользоватьПользовательскиеФункции, УстанавливаемоеСвойство, Истина);
		пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, УчетнаяЗапись, УстанавливаемоеСвойство, Ложь);
		пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, Порт, УстанавливаемоеСвойство, Истина);
		пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, ТипАвторизации, УстанавливаемоеСвойство, Истина);
		пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
