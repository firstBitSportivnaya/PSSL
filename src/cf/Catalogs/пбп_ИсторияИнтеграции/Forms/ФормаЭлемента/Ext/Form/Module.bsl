&НаКлиенте
Процедура ОбработчикВыбораКаталогаСохранениеЗавершениеПослеВыбораВДиалоге(
	Результат, Знач ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПутьКФайлу = Результат[0];
	
	ДвоичныеДанныеФайла = ОбработчикВыбораКаталогаСохранениеЗавершениеПослеВыбораВДиалогаНаСервере();
	ДвоичныеДанныеФайла.Записать(ПутьКФайлу);
	
КонецПроцедуры

&НаСервере
Функция ОбработчикВыбораКаталогаСохранениеЗавершениеПослеВыбораВДиалогаНаСервере()
	
	РеквизитОбъект = РеквизитФормыВЗначение("Объект");
	Возврат РеквизитОбъект.ПолучитьДанныеФайлаСообщения();
	
КонецФункции

&НаСервере
Процедура ЗаполнитьСтраницуОбъектовОбмена()
	
	ДанныеРегистров = Новый ТаблицаЗначений;
	ДанныеРегистров.Колонки.Добавить("ИмяРегистра");
	ДанныеРегистров.Колонки.Добавить("Отбор");
	
	ЗаполнитьФормуОбъектамиСсылочныхТипов(ДанныеРегистров);
	
	Если Не ДанныеРегистров.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	КолонкаИмяРегистра = ДанныеРегистров.Скопировать();
	КолонкаИмяРегистра.Свернуть("ИмяРегистра");
	
	МассивИменРегистров = КолонкаИмяРегистра.ВыгрузитьКолонку("ИмяРегистра");
	
	ДополнитьФормуТаблицамиРегистров(МассивИменРегистров);
	ЗаполнитьФормуЗаписямиРегистров(МассивИменРегистров, ДанныеРегистров);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьФормуОбъектамиСсылочныхТипов(ДанныеРегистров)
	
	РеквизитЗначение = РеквизитФормыВЗначение("Объект");
	Для Каждого Строка Из РеквизитЗначение.ОбъектыИнтеграции Цикл
		Если Строка.ЭтоЗаписьРегистра Тогда
			ЗначениеИзХранилища = Строка.ОтборыРегистра.Получить();
			Если ЗначениеИзХранилища <> Неопределено Тогда
				НовыйОтбор = ДанныеРегистров.Добавить();
				НовыйОтбор.ИмяРегистра	= ЗначениеИзХранилища.ИмяРегистра;
				НовыйОтбор.Отбор		= ЗначениеИзХранилища.Отбор;
			КонецЕсли;
		Иначе
			НоваяСтрока = ОбъектыОбмена.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
			
			НоваяСтрока.ЗагруженныйОбъектТипЗначения = ТипЗнч(Строка.ОбъектИнтеграции);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДополнитьФормуТаблицамиРегистров(МассивИменРегистров)
	
	СтруктураРеквизитов = Новый Структура;
	Для Каждого ИмяРегистра Из МассивИменРегистров Цикл
		
		Если Метаданные.НайтиПоПолномуИмени(ИмяРегистра) = Неопределено Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		ИмяРегистраФорма = СтрЗаменить(ИмяРегистра, ".", "_");
		СтруктураРеквизитов.Вставить(ИмяРегистраФорма, пбп_РаботаСФормами.ОписаниеТипаТаблицаЗначений());
		
	КонецЦикла;
	
	Если Не СтруктураРеквизитов.Количество() Тогда
		
		Возврат;
		
	КонецЕсли;
	
	пбп_РаботаСФормами.СоздатьРеквизиты(ЭтотОбъект, СтруктураРеквизитов);
	
	ГруппаСтраницыПоТипам = Элементы.ГруппаОбъектыПоТипам;
	Для Каждого ИмяРегистра Из МассивИменРегистров Цикл
		
		ИмяРегистраФорма = СтрЗаменить(ИмяРегистра, ".", "_");
		МетаданныеРегистра = Метаданные.НайтиПоПолномуИмени(ИмяРегистра);
		Если МетаданныеРегистра = Неопределено Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		СтруктураРеквизитов = Новый Структура;
		СтруктураКолонок = Новый Структура;
		
		МассивНаименованийГруппПолей = Новый Массив;
		МассивНаименованийГруппПолей.Добавить("СтандартныеРеквизиты");
		МассивНаименованийГруппПолей.Добавить("Измерения");
		МассивНаименованийГруппПолей.Добавить("Ресурсы");
		МассивНаименованийГруппПолей.Добавить("Реквизиты");
		Для Каждого ГруппаПолей Из МассивНаименованийГруппПолей Цикл
			Для Каждого ПолеРегистра Из МетаданныеРегистра[ГруппаПолей] Цикл
				СтруктураРеквизитов.Вставить(ПолеРегистра.Имя, ПолеРегистра.Тип);
				СтруктураКолонок.Вставить(ПолеРегистра.Имя, "");
			КонецЦикла;
		КонецЦикла;
		
		пбп_РаботаСФормами.СоздатьРеквизитыТаблицы(ЭтотОбъект, ИмяРегистраФорма, СтруктураРеквизитов);
		
		ГруппаСтраницаРегистра = пбп_РаботаСФормами.СоздатьСтраница(ЭтотОбъект,
			"Страница_" + ИмяРегистраФорма, ГруппаСтраницыПоТипам, МетаданныеРегистра.Синоним);
		
		СтруктураСвойств = Новый Структура;
		СтруктураСвойств.Вставить("ТолькоПросмотр", Истина);
		СтруктураСвойств.Вставить("ИзменятьСоставСтрок", Ложь);
		СтруктураСвойств.Вставить("ИзменятьПорядокСтрок", Ложь);
		
		пбп_РаботаСФормами.СоздатьТаблицаФормы(ЭтотОбъект,
			"Таблица_" + ИмяРегистраФорма, ГруппаСтраницаРегистра,
			ИмяРегистраФорма, СтруктураКолонок, СтруктураСвойств);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьФормуЗаписямиРегистров(МассивИменРегистров, ДанныеРегистров)
	
	ТекстЗапросаШаблон = "ВЫБРАТЬ
	|	ТаблицаЗначений.*
	|ПОМЕСТИТЬ %1
	|ИЗ
	|	&%1 КАК ТаблицаЗначений
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////";
	
	СтруктураРегистров = Новый Структура;
	МассивТекстовЗапросов = Новый Массив;
	Запрос = Новый Запрос;
	
	НомерПакетаВыборки = 1;
	Для Каждого ИмяРегистра Из МассивИменРегистров Цикл
		
		ИмяРегистраФорма = СтрЗаменить(ИмяРегистра, ".", "_");
		МетаданныеРегистра = Метаданные.НайтиПоПолномуИмени(ИмяРегистра);
		Если МетаданныеРегистра = Неопределено Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		ТаблицаОтборовРегистра = ПолучитьТаблицуОтборовПоРегистру(
			ДанныеРегистров, МетаданныеРегистра, ИмяРегистра);
		Если Не ТаблицаОтборовРегистра.Количество()
			Или Не ТаблицаОтборовРегистра.Колонки.Количество() Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		Запрос.УстановитьПараметр(ИмяРегистраФорма, ТаблицаОтборовРегистра);
		
		МассивВыборки = Новый Массив;
		МассивНомеровЗапроса = Новый Массив;
		ДополнитьТекстЗапросаРегистровОтборами(ТаблицаОтборовРегистра,
			ИмяРегистраФорма, ИмяРегистра, МассивВыборки, МассивНомеровЗапроса, НомерПакетаВыборки);
		Если Не МассивВыборки.Количество() Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		ТекстЗапроса = СтрШаблон(ТекстЗапросаШаблон, ИмяРегистраФорма)
			+ СтрСоединить(МассивВыборки, пбп_Переадресация.РазделительПакетаЗапросов());
		МассивТекстовЗапросов.Добавить(ТекстЗапроса);
		СтруктураРегистров.Вставить(ИмяРегистраФорма, МассивНомеровЗапроса);
		НомерПакетаВыборки = НомерПакетаВыборки + 2;
		
	КонецЦикла;
	
	Если Не МассивТекстовЗапросов.Количество() Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Запрос.Текст = СтрСоединить(МассивТекстовЗапросов, пбп_Переадресация.РазделительПакетаЗапросов());
	РезультатПакета = Запрос.ВыполнитьПакет();
	
	Для Каждого КлючИЗначение Из СтруктураРегистров Цикл
		Для Каждого НомерПакета Из КлючИЗначение.Значение Цикл
			ВыборкаРезультатаЗапроса = РезультатПакета[НомерПакета].Выбрать();
			Пока ВыборкаРезультатаЗапроса.Следующий() Цикл
				ЗаполнитьЗначенияСвойств(ЭтотОбъект[КлючИЗначение.Ключ].Добавить(), ВыборкаРезультатаЗапроса);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьТаблицуОтборовПоРегистру(ДанныеРегистров, МетаданныеРегистра, ИмяРегистра)
	
	ТаблицаОтборовРегистра = Новый ТаблицаЗначений;
	МассивКолонок = Новый Массив;
	
	СтрокиРегистров = ДанныеРегистров.НайтиСтроки(Новый Структура("ИмяРегистра", ИмяРегистра));
	
	Для Каждого СтандартныйРеквизит Из МетаданныеРегистра.СтандартныеРеквизиты Цикл;
		Если СтандартныйРеквизит.Имя = "Период" Или СтандартныйРеквизит.Имя = "Регистратор" Тогда
			ТаблицаОтборовРегистра.Колонки.Добавить(СтандартныйРеквизит.Имя, СтандартныйРеквизит.Тип);
			МассивКолонок.Добавить(СтандартныйРеквизит.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Измерение Из МетаданныеРегистра.Измерения Цикл;
		ТаблицаОтборовРегистра.Колонки.Добавить(Измерение.Имя, Измерение.Тип);
		МассивКолонок.Добавить(Измерение.Имя);
	КонецЦикла;
	
	СтрокаИменКолонок = СтрСоединить(МассивКолонок, ",");
	
	Для Каждого НайденнаяСтрока Из СтрокиРегистров Цикл
		НоваяСтрокаОтбора = ТаблицаОтборовРегистра.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаОтбора, НайденнаяСтрока.Отбор);
	КонецЦикла;
	
	// Выборка будет выполняться только по уникальным отборам в измерениях
	ТаблицаОтборовРегистра.Свернуть(СтрокаИменКолонок);
	
	Возврат ТаблицаОтборовРегистра;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ДополнитьТекстЗапросаРегистровОтборами(ТаблицаОтборовРегистра,
	ИмяРегистраФорма, ИмяРегистра, МассивВыборки, МассивНомеровЗапроса, НомерПакетаВыборки)
	
	ТекстВыборкиШаблон = "
	|ВЫБРАТЬ
	|	ДанныеРегистра.*
	|ИЗ
	|	%1 КАК ВТ
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ %2 КАК ДанныеРегистра
	|		ПО %3";
	
	МассивУсловий = Новый Массив;
	Для Каждого Колонка Из ТаблицаОтборовРегистра.Колонки Цикл
		
		ТипыКолонки = Колонка.ТипЗначения.Типы();
		ТекстШаблонаУсловия = ПолучитьСтрокуСоединенияСРегистром(ТипыКолонки);
		МассивУсловий.Добавить(СтрШаблон(ТекстШаблонаУсловия, Колонка.Имя));
		
	КонецЦикла;
	
	Если Не МассивУсловий.Количество() Тогда
		
		Возврат;
		
	КонецЕсли;
	
	СтрокаУсловий = СтрСоединить(МассивУсловий, "
	|		И ");
	ТекстВыборки = СтрШаблон(ТекстВыборкиШаблон, ИмяРегистраФорма, ИмяРегистра, СтрокаУсловий);
	МассивВыборки.Добавить(ТекстВыборки);
	МассивНомеровЗапроса.Добавить(НомерПакетаВыборки);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСтрокуСоединенияСРегистром(ТипыКолонки)
	
	Если ТипыКолонки.Количество() = 1 Тогда
		
		Если ТипыКолонки[0] = Тип("Число") Тогда
			
			Возврат "(ВТ.%1 = ДанныеРегистра.%1 ИЛИ ВТ.%1 = 0)";
			
		ИначеЕсли ТипыКолонки[0] = Тип("Булево") Тогда
			
			Возврат "(ВТ.%1 = ДанныеРегистра.%1 ИЛИ ВТ.%1 = ЛОЖЬ)";
			
		ИначеЕсли ТипыКолонки[0] = Тип("Строка") Тогда
			
			Кавычка = """";
			Возврат "(ВТ.%1 = ДанныеРегистра.%1 ИЛИ ВТ.%1 = " + Кавычка + Кавычка + ")";
			
		ИначеЕсли ТипыКолонки[0] = Тип("Дата") Тогда
			
			Возврат "(ВТ.%1 = ДанныеРегистра.%1 ИЛИ ВТ.%1 = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))";
			
		ИначеЕсли пбп_Переадресация.ЭтоСсылка(ТипыКолонки[0]) Тогда
			
			ПолноеИмяДанных = Метаданные.НайтиПоТипу(ТипыКолонки[0]).ПолноеИмя();
			Возврат "(ВТ.%1 = ДанныеРегистра.%1 ИЛИ ВТ.%1 = ЗНАЧЕНИЕ("
				+ ПолноеИмяДанных + ".ПустаяСсылка))";
			
		Иначе
			
			Возврат "(ВТ.%1 = ДанныеРегистра.%1 ИЛИ ВТ.%1 = НЕОПРЕДЕЛЕНО)";
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат "(ВТ.%1 = ДанныеРегистра.%1 ИЛИ ВТ.%1 = НЕОПРЕДЕЛЕНО)";
	
КонецФункции

#КонецОбласти // СлужебныеПроцедурыИФункции
