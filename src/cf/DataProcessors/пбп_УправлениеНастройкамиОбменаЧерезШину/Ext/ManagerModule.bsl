// Формирует дерево значений ограничений транспорта сообщений обмена.
//
// Параметры:
//  УникальныйИдентификаторФормы - УникальныйИдентификатор - идентификатор формы для временного хранилища
//
// Возвращаемое значение:
//  Строка - адрес временного хранилища с деревом значений ограничений транспорта
//
Функция ПолучитьДеревоЗначенийОграниченийТранспорта(УникальныйИдентификаторФормы) Экспорт
	
	ДеревоФормы = Новый ДеревоЗначений;
	
	СхемаКомпоновкиДанных = ПолучитьМакет("ОграниченияТранспорта");
	
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	НастройкиКомпоновки = КомпоновщикНастроек.ПолучитьНастройки();
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиКомпоновки, , ,
		Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , , Истина);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(ДеревоФормы);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
	
	Возврат ПоместитьВоВременноеХранилище(ДеревоФормы, УникальныйИдентификаторФормы);
	
КонецФункции

// Записывает задержку получения для всех неудалённых систем или для одной системы.
// Нулевое время задержки удаляет ранее записанную попытку.
//
// Параметры:
//  ТипНастройкиЗадержки - Число - 0 все системы, 1 одна система
//  ИнтегрируемаяСистема - СправочникСсылка.пбп_ИнтегрируемыеСистемы - система при типе 1
//  ТаблицаНастроек - ТаблицаЗначений - колонки НомерПопыткиЗагрузки, ВремяЗадержки
//
Процедура ЗаписатьНастройкиЗадержкиПолучения(ТипНастройкиЗадержки,
	ИнтегрируемаяСистема, ТаблицаНастроек) Экспорт
	
	ТаблицаЗаписи = ТаблицаНастроек.Скопировать();
	ИндексСтроки = ТаблицаЗаписи.Количество() - 1;
	
	Пока ИндексСтроки >= 0 Цикл
		
		Если ТаблицаЗаписи[ИндексСтроки].ВремяЗадержки = 0 Тогда
			ТаблицаЗаписи.Удалить(ИндексСтроки);
		КонецЕсли;
		
		ИндексСтроки = ИндексСтроки - 1;
		
	КонецЦикла;
	
	Если ТипНастройкиЗадержки = ТипНастройкиЗадержкиНаВсеСистемы() Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	пбп_ИнтегрируемыеСистемы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.пбп_ИнтегрируемыеСистемы КАК пбп_ИнтегрируемыеСистемы
		|ГДЕ
		|	НЕ пбп_ИнтегрируемыеСистемы.ПометкаУдаления";
		
		НачатьТранзакцию();
		
		Попытка
			
			Выборка = Запрос.Выполнить().Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				ЗаписатьНаборЗадержкиСистемы(Выборка.Ссылка, ТаблицаЗаписи);
				
			КонецЦикла;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			ВызватьИсключение;
			
		КонецПопытки;
		
	Иначе
		
		ЗаписатьНаборЗадержкиСистемы(ИнтегрируемаяСистема, ТаблицаЗаписи);
		
	КонецЕсли;
	
КонецПроцедуры

Функция ТипНастройкиЗадержкиНаВсеСистемы() Экспорт
	
	Возврат 0;
	
КонецФункции

Функция ТипНастройкиЗадержкиПоСистеме() Экспорт
	
	Возврат 1;
	
КонецФункции

Процедура ЗаписатьНаборЗадержкиСистемы(ИнтегрируемаяСистема, ТаблицаНастроек)
	
	НаборЗаписей = РегистрыСведений.пбп_ЗадержкаПолученияСообщенийОбмена.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ИнтегрируемаяСистема.Установить(ИнтегрируемаяСистема);
	НаборЗаписей.Прочитать();
	НаборЗаписей.Очистить();
	
	Для Каждого СтрокаНастроек Из ТаблицаНастроек Цикл
		
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.ИнтегрируемаяСистема = ИнтегрируемаяСистема;
		НоваяЗапись.НомерПопыткиЗагрузки = СтрокаНастроек.НомерПопыткиЗагрузки;
		НоваяЗапись.ВремяЗадержки = СтрокаНастроек.ВремяЗадержки;
		
	КонецЦикла;
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
