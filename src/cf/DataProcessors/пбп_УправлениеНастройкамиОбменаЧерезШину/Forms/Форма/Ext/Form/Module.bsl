#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьДеревоОграниченийТранспорта();
	ЗаполнитьМаксимальноеКоличествоПопытокЗагрузки();
	ОбновитьНастройкиЗадержки();
	УстановитьСвойстваЭлементовСтраницыЗадержки();
	УстановитьДоступностьИзмененияНастроек();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьИзмененияНастроек()
	
	МожноМенятьТранспорт = ПравоДоступа("Изменение",
		Метаданные.РегистрыСведений.пбп_ОграниченияТранспортаСообщенийОбмена);
	МожноМенятьЗадержку = ПравоДоступа("Изменение",
		Метаданные.РегистрыСведений.пбп_ЗадержкаПолученияСообщенийОбмена);
	
	Элементы.НастройкиТранспорта.ТолькоПросмотр = Не МожноМенятьТранспорт;
	Элементы.ТипНастройкиЗадержки.ТолькоПросмотр = Не МожноМенятьЗадержку;
	Элементы.СистемаНастройкаЗадержки.ТолькоПросмотр = Не МожноМенятьЗадержку;
	Элементы.НастройкиЗадержки.ТолькоПросмотр = Не МожноМенятьЗадержку;
	Элементы.СохранитьЗадержкуПолучения.Доступность = МожноМенятьЗадержку;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиТранспортаПриИзменении(Элемент)
	
	ТекущаяСтрока = Элемент.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекущаяСтрока.ИнтеграционныйПоток) Тогда
		Возврат;
	КонецЕсли;
	
	ИзменитьНастройкиТранспорта(
		ТекущаяСтрока.ИнтеграционныйПоток,
		ТекущаяСтрока.ТранспортЗапрещен,
		ТекущаяСтрока.КонтролироватьДоставку,
		ТекущаяСтрока.ПорядокОтправки,
		ТекущаяСтрока.КонтролироватьПолучение);
	
КонецПроцедуры

&НаКлиенте
Процедура ТипНастройкиЗадержкиПриИзменении(Элемент)
	
	УстановитьСвойстваЭлементовСтраницыЗадержки();
	ОбновитьНастройкиЗадержки();
	
КонецПроцедуры

&НаКлиенте
Процедура СистемаНастройкаЗадержкиПриИзменении(Элемент)
	
	ОбновитьНастройкиЗадержки();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьОграниченияТранспорта(Команда)
	
	ЗаполнитьДеревоОграниченийТранспорта();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЗадержкуПолучения(Команда)
	
	ОбновитьНастройкиЗадержки();
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьЗадержкуПолучения(Команда)
	
	Если ТипНастройкиЗадержки = ТипНастройкиЗадержкиНаВсеСистемы() Тогда
		ТекстВопроса = НСтр("ru = 'Сохранение с указанной настройкой ""На все системы"" переопределит
			| существующие значения времени задержки, указанные в разрезе интегрируемых систем.
			|Продолжить?'");
		
		Оповещение = Новый ОписаниеОповещения("СохранитьЗадержкуПолученияЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена);
	Иначе
		
		Если Не ЗначениеЗаполнено(СистемаНастройкаЗадержки) Тогда
			
			ПоказатьПредупреждение(, НСтр("ru = 'Не выбрана интегрируемая система.'"));
			Возврат;
			
		КонецЕсли;
		
		ЗаписатьНастройкиЗадержкиПолученияВРегистр();
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьДеревоОграниченийТранспорта()
	
	АдресВременногоХранилища = Обработки.пбп_УправлениеНастройкамиОбменаЧерезШину
		.ПолучитьДеревоЗначенийОграниченийТранспорта(УникальныйИдентификатор);
	
	ДанныеДерева = ПолучитьИзВременногоХранилища(АдресВременногоХранилища);
	УдалитьИзВременногоХранилища(АдресВременногоХранилища);
	
	ДеревоФормы = РеквизитФормыВЗначение("НастройкиТранспорта");
	ДеревоФормы.Строки.Очистить();
	СкопироватьСтрокиОграниченийТранспорта(ДанныеДерева.Строки, ДеревоФормы.Строки, ДанныеДерева.Колонки);
	ЗначениеВРеквизитФормы(ДеревоФормы, "НастройкиТранспорта");
	
КонецПроцедуры

&НаСервере
Процедура СкопироватьСтрокиОграниченийТранспорта(СтрокиИсточника, СтрокиПриемника, КолонкиИсточника)
	
	ПустойПоток = Справочники.пбп_ИнтеграционныеПотоки.ПустаяСсылка();
	ПустаяСистема = Справочники.пбп_ИнтегрируемыеСистемы.ПустаяСсылка();
	
	Для Каждого СтрокаИсточника Из СтрокиИсточника Цикл
		
		НоваяСтрока = СтрокиПриемника.Добавить();
		НоваяСтрока.ИнтегрируемаяСистема = ЗначениеКолонкиОграниченийТранспорта(
			СтрокаИсточника, КолонкиИсточника, "ИнтегрируемаяСистема", ПустаяСистема);
		НоваяСтрока.ИнтеграционныйПоток = ЗначениеКолонкиОграниченийТранспорта(
			СтрокаИсточника, КолонкиИсточника, "ИнтеграционныйПоток", ПустойПоток);
		НоваяСтрока.ТранспортЗапрещен = ЗначениеКолонкиОграниченийТранспорта(
			СтрокаИсточника, КолонкиИсточника, "ТранспортЗапрещен", Ложь);
		НоваяСтрока.КонтролироватьДоставку = ЗначениеКолонкиОграниченийТранспорта(
			СтрокаИсточника, КолонкиИсточника, "КонтролироватьДоставку", Ложь);
		НоваяСтрока.ПорядокОтправки = ЗначениеКолонкиОграниченийТранспорта(
			СтрокаИсточника, КолонкиИсточника, "ПорядокОтправки", 0);
		НоваяСтрока.КонтролироватьПолучение = ЗначениеКолонкиОграниченийТранспорта(
			СтрокаИсточника, КолонкиИсточника, "КонтролироватьПолучение", Ложь);
		
		СкопироватьСтрокиОграниченийТранспорта(
			СтрокаИсточника.Строки, НоваяСтрока.Строки, КолонкиИсточника);
		
	КонецЦикла;
	
КонецПроцедуры
&НаСервере
Функция ЗначениеКолонкиОграниченийТранспорта(СтрокаИсточника, КолонкиИсточника, ИмяКолонки, ЗначениеПоУмолчанию)
	
	Если КолонкиИсточника.Найти(ИмяКолонки) = Неопределено Тогда
		
		Возврат ЗначениеПоУмолчанию;
		
	КонецЕсли;
	
	ЗначениеКолонки = СтрокаИсточника[ИмяКолонки];
	
	Если ЗначениеКолонки = Null Тогда
		
		Возврат ЗначениеПоУмолчанию;
		
	КонецЕсли;
	
	Возврат ЗначениеКолонки;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ИзменитьНастройкиТранспорта(Знач ИнтеграционныйПоток,
	Знач ТранспортЗапрещен, Знач КонтролироватьДоставку, Знач ПорядокОтправки, Знач КонтролироватьПолучение)
	
	Если Не ПравоДоступа("Изменение",
		Метаданные.РегистрыСведений.пбп_ОграниченияТранспортаСообщенийОбмена) Тогда
		
		ВызватьИсключение НСтр("ru = 'Недостаточно прав для изменения ограничений транспорта.'");
		
	КонецЕсли;
	
	пбп_ИнтеграцииСервер.СоздатьИзменитьОграниченияТранспортаСообщенийОбмена(
		ИнтеграционныйПоток,
		ТранспортЗапрещен,
		КонтролироватьДоставку,
		ПорядокОтправки,
		КонтролироватьПолучение);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьМаксимальноеКоличествоПопытокЗагрузки()
	
	ЗначениеПопыток = пбп_ОбщегоНазначенияСервер.ПолучитьПредопределенноеЗначение(
		"МаксимальноеКоличествоПопытокЗагрузкиИзШины");
	
	Если ЗначениеЗаполнено(ЗначениеПопыток) Тогда
		МаксимальноеКоличествоПопытокЗагрузки = ЗначениеПопыток;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСвойстваЭлементовСтраницыЗадержки()
	
	пбп_ПереадресацияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "СистемаНастройкаЗадержки", "Видимость",
		ТипНастройкиЗадержки = ТипНастройкиЗадержкиПоСистеме());
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьНастройкиЗадержки()
	
	НастройкиЗадержки.Очистить();
	
	Если ТипНастройкиЗадержки = ТипНастройкиЗадержкиПоСистеме() И Не ЗначениеЗаполнено(СистемаНастройкаЗадержки) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если ТипНастройкиЗадержки = ТипНастройкиЗадержкиНаВсеСистемы() Тогда
		ДанныеРегистра = ПолучитьДанныеБольшегоКоличестваПопыток();
	Иначе
		ДанныеРегистра = ПолучитьДанныеКоличестваПопытокПоИнтегрируемойСистеме(СистемаНастройкаЗадержки);
	КонецЕсли;
	
	Если ДанныеРегистра.Количество() = 0 Тогда
		
		ДанныеРегистра = НастройкиЗадержки.Выгрузить().СкопироватьКолонки();
		
	КонецЕсли;
	
	Для НомерПопытки = 1 По МаксимальноеКоличествоПопытокЗагрузки Цикл
		
		Если ДанныеРегистра.Найти(НомерПопытки, "НомерПопыткиЗагрузки") = Неопределено Тогда
			
			НоваяСтрока = ДанныеРегистра.Добавить();
			НоваяСтрока.НомерПопыткиЗагрузки = НомерПопытки;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ДанныеРегистра.Сортировать("НомерПопыткиЗагрузки");
	НастройкиЗадержки.Загрузить(ДанныеРегистра);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеБольшегоКоличестваПопыток()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	МАКСИМУМ(пбп_ЗадержкаПолученияСообщенийОбмена.НомерПопыткиЗагрузки) КАК НомерПопыткиЗагрузки,
	|	пбп_ЗадержкаПолученияСообщенийОбмена.ИнтегрируемаяСистема КАК ИнтегрируемаяСистема
	|ПОМЕСТИТЬ МаксимальныйНомерПопытки
	|ИЗ
	|	РегистрСведений.пбп_ЗадержкаПолученияСообщенийОбмена КАК пбп_ЗадержкаПолученияСообщенийОбмена
	|
	|СГРУППИРОВАТЬ ПО
	|	пбп_ЗадержкаПолученияСообщенийОбмена.ИнтегрируемаяСистема
	|
	|УПОРЯДОЧИТЬ ПО
	|	МАКСИМУМ(пбп_ЗадержкаПолученияСообщенийОбмена.НомерПопыткиЗагрузки) УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	пбп_ЗадержкаПолученияСообщенийОбмена.НомерПопыткиЗагрузки КАК НомерПопыткиЗагрузки,
	|	пбп_ЗадержкаПолученияСообщенийОбмена.ВремяЗадержки КАК ВремяЗадержки
	|ИЗ
	|	МаксимальныйНомерПопытки КАК МаксимальныйНомерПопытки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.пбп_ЗадержкаПолученияСообщенийОбмена КАК пбп_ЗадержкаПолученияСообщенийОбмена
	|		ПО МаксимальныйНомерПопытки.ИнтегрируемаяСистема = пбп_ЗадержкаПолученияСообщенийОбмена.ИнтегрируемаяСистема
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерПопыткиЗагрузки";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
	
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьДанныеКоличестваПопытокПоИнтегрируемойСистеме(ИнтегрируемаяСистема)
	
	Возврат пбп_ИнтеграцииСервер.ПолучитьЗадержкуПолученияСообщенийОбмена(ИнтегрируемаяСистема);
	
КонецФункции

// Продолжает сохранение задержки после подтверждения режима «На все системы».
//
// Параметры:
//  Результат - КодВозвратаДиалога - ответ пользователя.
//  ДополнительныеПараметры - Произвольный - не используется.
//
&НаКлиенте
Процедура СохранитьЗадержкуПолученияЗавершение(Результат, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если Результат = КодВозвратаДиалога.ОК Тогда
		ЗаписатьНастройкиЗадержкиПолученияВРегистр();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьНастройкиЗадержкиПолученияВРегистр()
	
	Если Не ПравоДоступа("Изменение",
		Метаданные.РегистрыСведений.пбп_ЗадержкаПолученияСообщенийОбмена) Тогда
		
		ВызватьИсключение НСтр("ru = 'Недостаточно прав для изменения задержки получения.'");
		
	КонецЕсли;
	
	Обработки.пбп_УправлениеНастройкамиОбменаЧерезШину.ЗаписатьНастройкиЗадержкиПолучения(
		ТипНастройкиЗадержки,
		СистемаНастройкаЗадержки,
		НастройкиЗадержки.Выгрузить());
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ТипНастройкиЗадержкиНаВсеСистемы()
	
	Возврат 0;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ТипНастройкиЗадержкиПоСистеме()
	
	Возврат 1;
	
КонецФункции

#КонецОбласти
