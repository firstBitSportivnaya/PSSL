#Область ПрограммныйИнтерфейс

// Получает записи регистра контроля доставки сообщений.
//
// Параметры:
//  ИдентификаторСообщения - Строка - идентификатор сообщения обмена; пустая строка - без отбора
//  Объект - ОпределяемыйТип.пбп_ОбъектыИнтегрируемыхСистем - объект цепочки; не заполнено - без отбора
//  ИнтеграционныйПоток - СправочникСсылка.пбп_ИнтеграционныеПотоки - поток; не заполнено - без отбора
//
// Возвращаемое значение:
//  ТаблицаЗначений - записи регистра
//
Функция ПолучитьЗаписи(ИдентификаторСообщения = "", Объект = Неопределено,
	ИнтеграционныйПоток = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Контроль.ИдентификаторСообщения КАК ИдентификаторСообщения,
	|	Контроль.Объект КАК Объект,
	|	Контроль.ИнтеграционныйПоток КАК ИнтеграционныйПоток,
	|	Контроль.Статус КАК Статус,
	|	Контроль.ПорядокОтправки КАК ПорядокОтправки,
	|	Контроль.ДатаОтправки КАК ДатаОтправки
	|ИЗ
	|	РегистрСведений.пбп_КонтрольДоставкиСообщений КАК Контроль";
	
	Условия = Новый Массив;
	
	Если ЗначениеЗаполнено(ИдентификаторСообщения) Тогда
		
		Условия.Добавить("Контроль.ИдентификаторСообщения = &ИдентификаторСообщения");
		Запрос.УстановитьПараметр("ИдентификаторСообщения", ИдентификаторСообщения);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект) Тогда
		
		Условия.Добавить("Контроль.Объект = &Объект");
		Запрос.УстановитьПараметр("Объект", Объект);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИнтеграционныйПоток) Тогда
		
		Условия.Добавить("Контроль.ИнтеграционныйПоток = &ИнтеграционныйПоток");
		Запрос.УстановитьПараметр("ИнтеграционныйПоток", ИнтеграционныйПоток);
		
	КонецЕсли;
	
	Если Условия.Количество() > 0 Тогда
		
		Запрос = пбп_СхемыЗапросов.ДобавитьОтборВЗапрос(Запрос, СтрСоединить(Условия, " И "));
		
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Добавляет запись контроля доставки.
//
// Параметры:
//  ПараметрыЗаписи - Структура - ключи измерений и ресурсов регистра:
//   * ИдентификаторСообщения - Строка
//   * Объект - ОпределяемыйТип.пбп_ОбъектыИнтегрируемыхСистем
//   * ИнтеграционныйПоток - СправочникСсылка.пбп_ИнтеграционныеПотоки
//   * Статус - ПеречислениеСсылка.пбп_СтатусыАсинхронныхВызовов
//   * ПорядокОтправки - Число
//   * ДатаОтправки - Дата
//
Процедура ДобавитьЗапись(ПараметрыЗаписи) Экспорт
	
	Если ТипЗнч(ПараметрыЗаписи) <> Тип("Структура") Тогда
		ВызватьИсключение НСтр("ru='Некорректный тип параметра'");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПараметрыЗаписи.ИдентификаторСообщения) Тогда
		ВызватьИсключение НСтр("ru='Не указан идентификатор сообщения'");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПараметрыЗаписи.Объект) Тогда
		ВызватьИсключение НСтр("ru='Не указан объект интеграции'");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПараметрыЗаписи.ИнтеграционныйПоток) Тогда
		ВызватьИсключение НСтр("ru='Не указан интеграционный поток'");
	КонецЕсли;
	
	МенеджерЗаписи = СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(МенеджерЗаписи, ПараметрыЗаписи);
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

// Изменяет запись контроля доставки по ключу измерений.
//
// Параметры:
//  ПараметрыЗаписи - Структура - ключи измерений и изменяемые ресурсы, см. ДобавитьЗапись
//
Процедура ИзменитьЗапись(ПараметрыЗаписи) Экспорт
	
	Если ТипЗнч(ПараметрыЗаписи) <> Тип("Структура") Тогда
		ВызватьИсключение НСтр("ru='Некорректный тип параметра'");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПараметрыЗаписи.ИдентификаторСообщения) Тогда
		ВызватьИсключение НСтр("ru='Не указан идентификатор сообщения'");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПараметрыЗаписи.Объект) Тогда
		ВызватьИсключение НСтр("ru='Не указан объект интеграции'");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПараметрыЗаписи.ИнтеграционныйПоток) Тогда
		ВызватьИсключение НСтр("ru='Не указан интеграционный поток'");
	КонецЕсли;
	
	НаборЗаписей = СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ИдентификаторСообщения.Установить(ПараметрыЗаписи.ИдентификаторСообщения);
	НаборЗаписей.Отбор.Объект.Установить(ПараметрыЗаписи.Объект);
	НаборЗаписей.Отбор.ИнтеграционныйПоток.Установить(ПараметрыЗаписи.ИнтеграционныйПоток);
	
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() Тогда
		
		Запись = НаборЗаписей[0];
		
		Для Каждого КлючИЗначение Из ПараметрыЗаписи Цикл
			
			Запись[КлючИЗначение.Ключ] = КлючИЗначение.Значение;
			
		КонецЦикла;
		
		НаборЗаписей.Записать();
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти // ПрограммныйИнтерфейс

#КонецЕсли
