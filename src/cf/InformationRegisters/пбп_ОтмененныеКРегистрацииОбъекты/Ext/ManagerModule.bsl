#Область ПрограммныйИнтерфейс

// Добавляет запись отмененного к регистрации объекта.
//
// Параметры:
//  ПараметрыЗаписи - Структура - набор параметров для записи. Ключи:
//   * Период - Дата - период регистрации объекта
//   * Объект - ОпределяемыйТип.пбп_ОбъектыИнтегрируемыхСистем - ссылка на регистрируемый объект
//   * ПричинаОтмены - Строка - причина отмены регистрации
//   * Пользователь - ОпределяемыйТип.пбп_Пользователи - пользователь, отменивший регистрацию
//
Процедура ДобавитьЗапись(ПараметрыЗаписи) Экспорт
	
	Если ТипЗнч(ПараметрыЗаписи) <> Тип("Структура") Тогда
		ВызватьИсключение НСтр("ru = 'Некорректный тип параметра'");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПараметрыЗаписи.Объект) Тогда
		ВызватьИсключение НСтр("ru = 'Не указан объект'");
	КонецЕсли;
	
	МенеджерЗаписи = СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(МенеджерЗаписи, ПараметрыЗаписи);
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

// Изменяет запись отмененного к регистрации объекта.
//
// Параметры:
//  ПараметрыЗаписи - Структура - набор параметров для записи. Ключи:
//   * Период - Дата - период регистрации объекта
//   * Объект - ОпределяемыйТип.пбп_ОбъектыИнтегрируемыхСистем - ссылка на регистрируемый объект
//   * ПричинаОтмены - Строка - причина отмены регистрации
//   * Пользователь - ОпределяемыйТип.пбп_Пользователи - пользователь, отменивший регистрацию
//
Процедура ИзменитьЗапись(ПараметрыЗаписи) Экспорт
	
	Если ТипЗнч(ПараметрыЗаписи) <> Тип("Структура") Тогда
		ВызватьИсключение НСтр("ru = 'Некорректный тип параметра'");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПараметрыЗаписи.Объект) Тогда
		ВызватьИсключение НСтр("ru = 'Не указан объект'");
	КонецЕсли;
	
	НаборЗаписей = СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Объект.Установить(ПараметрыЗаписи.Объект);
	
	Если ПараметрыЗаписи.Свойство("Период") И ЗначениеЗаполнено(ПараметрыЗаписи.Период) Тогда
		НаборЗаписей.Отбор.Период.Установить(ПараметрыЗаписи.Период);
	КонецЕсли;
	
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'Запись отмененного к регистрации объекта не найдена'");
	КонецЕсли;
	
	ПоляИзменения = Новый Структура;
	
	Для Каждого КлючИЗначение Из ПараметрыЗаписи Цикл
		
		Если КлючИЗначение.Ключ = "Период" Или КлючИЗначение.Ключ = "Объект" Тогда
			Продолжить;
		КонецЕсли;
		
		ПоляИзменения.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		
	КонецЦикла;
	
	Для Каждого Запись Из НаборЗаписей Цикл
		
		ЗаполнитьЗначенияСвойств(Запись, ПоляИзменения);
		
	КонецЦикла;
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

// Удаляет записи отмененных к регистрации объектов.
//
// Параметры:
//  ПараметрыЗаписи - Структура - набор параметров для записи. Ключи:
//   * Период - Дата - период регистрации объекта
//   * Объект - ОпределяемыйТип.пбп_ОбъектыИнтегрируемыхСистем - ссылка на регистрируемый объект
//
Процедура УдалитьЗаписи(ПараметрыЗаписи) Экспорт
	
	Если ТипЗнч(ПараметрыЗаписи) <> Тип("Структура") Тогда
		ВызватьИсключение НСтр("ru = 'Некорректный тип параметра'");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПараметрыЗаписи.Объект) Тогда
		ВызватьИсключение НСтр("ru = 'Не указан объект'");
	КонецЕсли;
	
	ИменаИзмерений = Новый Соответствие;
	ИменаИзмерений.Вставить("Период", Истина);
	ИменаИзмерений.Вставить("Объект", Истина);
	
	НаборЗаписей = СоздатьНаборЗаписей();
	ЕстьОтбор = Ложь;
	
	Для Каждого КлючИЗначение Из ПараметрыЗаписи Цикл
		
		Если Не ЗначениеЗаполнено(КлючИЗначение.Значение) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ИменаИзмерений.Получить(КлючИЗначение.Ключ) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НаборЗаписей.Отбор[КлючИЗначение.Ключ].Установить(КлючИЗначение.Значение);
		ЕстьОтбор = Истина;
		
	КонецЦикла;
	
	Если Не ЕстьОтбор Тогда
		ВызватьИсключение НСтр("ru = 'Не указан ключ удаления записей'");
	КонецЕсли;
	
	НаборЗаписей.Прочитать();
	НаборЗаписей.Очистить();
	НаборЗаписей.Записать();
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
