#Область ПрограммныйИнтерфейс

// Возвращает записи ограничений транспорта сообщений обмена.
//
// Параметры:
//  ИнтеграционныйПоток - СправочникСсылка.пбп_ИнтеграционныеПотоки, Строка - поток или идентификатор настройки
//
// Возвращаемое значение:
//  ТаблицаЗначений - записи регистра ограничений транспорта сообщений обмена
//
Функция ПолучитьЗаписи(ИнтеграционныйПоток = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	пбп_ОграниченияТранспортаСообщенийОбмена.ИнтеграционныйПоток КАК ИнтеграционныйПоток,
	|	пбп_ОграниченияТранспортаСообщенийОбмена.ТранспортЗапрещен КАК ТранспортЗапрещен,
	|	пбп_ОграниченияТранспортаСообщенийОбмена.КонтролироватьДоставку КАК КонтролироватьДоставку,
	|	пбп_ОграниченияТранспортаСообщенийОбмена.ПорядокОтправки КАК ПорядокОтправки,
	|	пбп_ОграниченияТранспортаСообщенийОбмена.КонтролироватьПолучение КАК КонтролироватьПолучение
	|ИЗ
	|	РегистрСведений.пбп_ОграниченияТранспортаСообщенийОбмена КАК пбп_ОграниченияТранспортаСообщенийОбмена";
	
	Если ЗначениеЗаполнено(ИнтеграционныйПоток) Тогда
		Если ТипЗнч(ИнтеграционныйПоток) = Тип("Строка") Тогда
			ИнтеграционныйПоток = пбп_ИнтеграцииСервер.ИнтеграционныйПоток(ИнтеграционныйПоток);
		КонецЕсли;
		Запрос.УстановитьПараметр("ИнтеграционныйПоток", ИнтеграционныйПоток);
		УсловияЗапроса = "пбп_ОграниченияТранспортаСообщенийОбмена.ИнтеграционныйПоток = &ИнтеграционныйПоток";
		Запрос = пбп_СхемыЗапросов.ДобавитьОтборВЗапрос(Запрос, УсловияЗапроса);
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции

// Добавляет запись ограничений транспорта сообщений обмена.
//
// Параметры:
//  ПараметрыЗаписи - Структура - набор параметров для записи. Ключи:
//   * ИнтеграционныйПоток - СправочникСсылка.пбп_ИнтеграционныеПотоки - интеграционный поток
//   * ТранспортЗапрещен - Булево - если Истина, отправка сообщения по потоку отменяется
//   * КонтролироватьДоставку - Булево - если Истина, ожидается квитанция о доставке
//   * ПорядокОтправки - Число - последовательность отправки сообщения обмена
//   * КонтролироватьПолучение - Булево - если Истина, сообщение может быть возвращено в очередь
//
Процедура ДобавитьЗапись(ПараметрыЗаписи) Экспорт
	
	Если ТипЗнч(ПараметрыЗаписи) <> Тип("Структура") Тогда
		ВызватьИсключение НСтр("ru = 'Некорректный тип параметра'");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПараметрыЗаписи.ИнтеграционныйПоток) Тогда
		ВызватьИсключение НСтр("ru = 'Не указан интеграционный поток'");
	КонецЕсли;
	
	МенеджерЗаписи = СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(МенеджерЗаписи, ПараметрыЗаписи);
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

// Изменяет запись ограничений транспорта сообщений обмена.
//
// Параметры:
//  ПараметрыЗаписи - Структура - набор параметров для записи. Ключи:
//   * ИнтеграционныйПоток - СправочникСсылка.пбп_ИнтеграционныеПотоки - интеграционный поток
//   * ТранспортЗапрещен - Булево - если Истина, отправка сообщения по потоку отменяется
//   * КонтролироватьДоставку - Булево - если Истина, ожидается квитанция о доставке
//   * ПорядокОтправки - Число - последовательность отправки сообщения обмена
//   * КонтролироватьПолучение - Булево - если Истина, сообщение может быть возвращено в очередь
//
Процедура ИзменитьЗапись(ПараметрыЗаписи) Экспорт
	
	Если ТипЗнч(ПараметрыЗаписи) <> Тип("Структура") Тогда
		ВызватьИсключение НСтр("ru = 'Некорректный тип параметра'");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПараметрыЗаписи.ИнтеграционныйПоток) Тогда
		ВызватьИсключение НСтр("ru = 'Не указан интеграционный поток'");
	КонецЕсли;
	
	НаборЗаписей = СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ИнтеграционныйПоток.Установить(ПараметрыЗаписи.ИнтеграционныйПоток);
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'Запись ограничений транспорта не найдена'");
	КонецЕсли;
	
	ПоляИзменения = Новый Структура;
	
	Для Каждого КлючИЗначение Из ПараметрыЗаписи Цикл
		
		Если КлючИЗначение.Ключ = "ИнтеграционныйПоток" Тогда
			Продолжить;
		КонецЕсли;
		
		ПоляИзменения.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		
	КонецЦикла;
	
	Для Каждого Запись Из НаборЗаписей Цикл
		
		ЗаполнитьЗначенияСвойств(Запись, ПоляИзменения);
		
	КонецЦикла;
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

// Удаляет записи ограничений транспорта сообщений обмена.
//
// Параметры:
//  ИнтеграционныйПоток - СправочникСсылка.пбп_ИнтеграционныеПотоки - интеграционный поток
//
Процедура УдалитьЗаписи(ИнтеграционныйПоток) Экспорт
	
	Если Не ЗначениеЗаполнено(ИнтеграционныйПоток) Тогда
		ВызватьИсключение НСтр("ru = 'Не указан интеграционный поток'");
	КонецЕсли;
	
	НаборЗаписей = СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ИнтеграционныйПоток.Установить(ИнтеграционныйПоток);
	НаборЗаписей.Прочитать();
	НаборЗаписей.Очистить();
	НаборЗаписей.Записать();
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
