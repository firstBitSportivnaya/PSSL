// Виджеты: программный интерфейс расчета и получения значений показателей виджетов.

#Область ПрограммныйИнтерфейс

// Возвращает значения показателей виджетов для текущего пользователя из кэша.
// При ПересчитатьУстаревшие = Истина отсутствующие и устаревшие значения рассчитываются
// в текущем сеансе перед возвратом.
//
// Параметры:
//  Показатели - Массив из СправочникСсылка.пбп_ПоказателиВиджетов - показатели.
//  ПересчитатьУстаревшие - Булево - рассчитать отсутствующие и устаревшие значения перед возвратом.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - СправочникСсылка.пбп_ПоказателиВиджетов - показатель.
//   * Значение - Структура:
//     ** Значение - Произвольный - значение показателя.
//     ** ДатаРасчета - Дата - дата расчета, пустая, если значение еще не рассчитывалось.
//     ** Актуально - Булево - период актуальности значения не истек.
//     ** Ошибка - Строка - описание ошибки последнего расчета.
//
Функция ЗначенияПоказателей(Показатели, ПересчитатьУстаревшие = Ложь) Экспорт
	
	Значения = пбп_ВиджетыСлужебный.ЗначенияПоказателейИзКэша(Показатели);
	Если Не ПересчитатьУстаревшие Тогда
		
		Возврат Значения;
		
	КонецЕсли;
	
	Устаревшие = пбп_ВиджетыСлужебный.УстаревшиеПоказатели(Значения);
	Если Устаревшие.Количество() = 0 Тогда
		
		Возврат Значения;
		
	КонецЕсли;
	
	пбп_ВиджетыСлужебный.РассчитатьПоказатели(Устаревшие);
	
	Возврат пбп_ВиджетыСлужебный.ЗначенияПоказателейИзКэша(Показатели);
	
КонецФункции

// Запускает фоновый расчет отсутствующих и устаревших значений показателей текущего пользователя.
//
// Параметры:
//  Показатели - Массив из СправочникСсылка.пбп_ПоказателиВиджетов - показатели.
//
// Возвращаемое значение:
//  УникальныйИдентификатор - идентификатор запущенного фонового задания.
//  Неопределено - все значения актуальны или расчет уже выполняется.
//
Функция ЗапуститьРасчетПоказателей(Показатели) Экспорт
	
	Значения = пбп_ВиджетыСлужебный.ЗначенияПоказателейИзКэша(Показатели);
	Устаревшие = пбп_ВиджетыСлужебный.УстаревшиеПоказатели(Значения);
	
	Возврат пбп_ВиджетыСлужебный.ЗапуститьФоновыйРасчет(Устаревшие);
	
КонецФункции

// Сбрасывает кэш значений показателей: при следующем запросе значения будут рассчитаны заново.
// Сбрасываются значения текущего пользователя и общие значения указанных показателей.
//
// Параметры:
//  Показатели - Массив из СправочникСсылка.пбп_ПоказателиВиджетов - показатели.
//
Процедура СброситьКэшПоказателей(Показатели) Экспорт
	
	пбп_ВиджетыСлужебный.СброситьКэшПоказателей(Показатели);
	
КонецПроцедуры

#КонецОбласти
