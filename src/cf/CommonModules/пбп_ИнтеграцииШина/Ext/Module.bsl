#КонецОбласти // Выгрузка

#Область Загрузка

#Область ПереопределениеМетодов

Функция СформироватьПоляПоиска(Поток)
	
	ИмяФункции = пбп_ИнтеграцииШинаПовтИсп.ИменаМетодовПолейПоиска()[Поток];
	Результат = Новый Соответствие;
	
	Если ИмяФункции = Неопределено Тогда
		
		Возврат Результат;
		
	КонецЕсли;
	
	Соответствие = пбп_ИнтеграцииШинаПовтИсп.РезультатПереопределения(ИмяФункции);
	
	Для Каждого Пара Из Соответствие Цикл
		
		ДобавитьЗначениеПоКлючуПоля(Результат, Пара.Ключ, Пара.Значение);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Дополняет поля поиска вложенными ключами соответствия полей.
// Ключ, отличный от имени реквизита приемника, ставится в начало списка,
// если его еще нет отдельным полем и он не входит в явную группу.
// Элементы-группы переносятся как есть. Явные поля остаются после выведенных.
// Табличная часть с ключом "_имя_источника" обрабатывается уровнем ниже.
// Если выведенных и явных полей нет, ключ не создается.
//
// Параметры:
//  ПоляПоиска - Соответствие - имя реквизита и массив: имена полей или ГруппаПолейПоиска.
//  СоответствиеПолей - Соответствие - соответствие полей источника и приемника.
//
Процедура ДополнитьПоляПоискаИзСоответствияПолей(ПоляПоиска, СоответствиеПолей) Экспорт

	Для Каждого ПараПоля Из СоответствиеПолей Цикл

		ВложенныеПоля = ПараПоля.Значение;

		Если ТипЗнч(ВложенныеПоля) <> Тип("Соответствие") Тогда

			Продолжить;

		КонецЕсли;

		Если ВложенныеПоля["_имя_источника"] <> Неопределено Тогда

			ДополнитьПоляПоискаТабличнойЧасти(ПоляПоиска, ПараПоля.Ключ, ВложенныеПоля);

		Иначе

			ДополнитьПоляПоискаРеквизита(ПоляПоиска, ПараПоля.Ключ, ВложенныеПоля);

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Процедура ДополнитьПоляПоискаТабличнойЧасти(ПоляПоиска, ИмяТабличнойЧасти, ВложенныеПоля)

	ПоляТабличнойЧасти = ПоляПоиска[ИмяТабличнойЧасти];

	Если ПоляТабличнойЧасти <> Неопределено
		И ТипЗнч(ПоляТабличнойЧасти) <> Тип("Соответствие") Тогда

		Возврат;

	КонецЕсли;

	СоздатьРаздел = ПоляТабличнойЧасти = Неопределено;

	Если СоздатьРаздел Тогда

		ПоляТабличнойЧасти = Новый Соответствие;

	КонецЕсли;

	Для Каждого ПараРеквизита Из ВложенныеПоля Цикл

		Если ПараРеквизита.Ключ = "_имя_источника"
			Или ТипЗнч(ПараРеквизита.Значение) <> Тип("Соответствие") Тогда

			Продолжить;

		КонецЕсли;

		ДополнитьПоляПоискаРеквизита(ПоляТабличнойЧасти, ПараРеквизита.Ключ, ПараРеквизита.Значение);

	КонецЦикла;

	Если СоздатьРаздел И ПоляТабличнойЧасти.Количество() > 0 Тогда

		ПоляПоиска.Вставить(ИмяТабличнойЧасти, ПоляТабличнойЧасти);

	КонецЕсли;

КонецПроцедуры

Функция ИмяПоляГруппыБезПрефиксаРеквизита(ИмяПоля, ИмяРеквизита)
	
	Если ТипЗнч(ИмяПоля) <> Тип("Строка")
		Или Не ЗначениеЗаполнено(ИмяРеквизита) Тогда
		
		Возврат ИмяПоля;
		
	КонецЕсли;
	
	Префикс = ИмяРеквизита + ".";
	
	Если СтрНачинаетсяС(ИмяПоля, Префикс) Тогда
		
		Возврат Сред(ИмяПоля, СтрДлина(Префикс) + 1);
		
	КонецЕсли;
	
	Возврат ИмяПоля;
	
КонецФункции

Функция НормализованныеЯвныеГруппыПолейПоиска(ЯвныеПоля, ИмяРеквизита)
	
	НормализованныеПоля = Новый Массив;
	
	Для Каждого ЭлементПоля Из ЯвныеПоля Цикл
		
		Если ЭтоГруппаПолейПоиска(ЭлементПоля) Тогда
			
			ИменаПолейГруппы = Новый Массив;
			
			Для Каждого ИмяПоляГруппы Из ЭлементПоля.Поля Цикл
				
				ИменаПолейГруппы.Добавить(ИмяПоляГруппыБезПрефиксаРеквизита(ИмяПоляГруппы, ИмяРеквизита));
				
			КонецЦикла;
			
			НормализованныеПоля.Добавить(ГруппаПолейПоиска(ИменаПолейГруппы));
			
		Иначе
			
			НормализованныеПоля.Добавить(ЭлементПоля);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат НормализованныеПоля;
	
КонецФункции

Процедура ДополнитьПоляПоискаРеквизита(ПоляПоиска, ИмяРеквизита, ВложенныеПоля)
	
	ВыведенныеПоля = Новый Массив;
	
	Для Каждого ПараВложенного Из ВложенныеПоля Цикл
		
		Если ПараВложенного.Ключ <> ИмяРеквизита Тогда
			
			ВыведенныеПоля.Добавить(ПараВложенного.Ключ);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЯвныеПоля = ПоляПоиска[ИмяРеквизита];
	
	Если ВыведенныеПоля.Количество() = 0 И ЯвныеПоля = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если ЯвныеПоля = Неопределено Тогда
		
		ЯвныеПоля = Новый Массив;
		
	КонецЕсли;
	
	ЯвныеПоля = НормализованныеЯвныеГруппыПолейПоиска(ЯвныеПоля, ИмяРеквизита);
	
	Поля = Новый Массив;
	
	Для Каждого ИмяПоля Из ВыведенныеПоля Цикл
		
		Если Не ПолеУжеЕстьВПоляхПоиска(ЯвныеПоля, ИмяПоля) Тогда
			
			Поля.Добавить(ИмяПоля);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого ЭлементПоля Из ЯвныеПоля Цикл
		
		Поля.Добавить(ЭлементПоля);
		
	КонецЦикла;
	
	Если Поля.Количество() = 0 Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ПоляПоиска.Вставить(ИмяРеквизита, Поля);
	
КонецПроцедуры

Функция ПолеУжеЕстьВПоляхПоиска(Поля, ИмяПоля)
	
	Если Поля = Неопределено Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Для Каждого ЭлементПоля Из Поля Цикл
		
		Если ЭлементПоля = ИмяПоля Тогда
			
			Возврат Истина;
			
		КонецЕсли;
		
		Если ЭтоГруппаПолейПоиска(ЭлементПоля)
			И ЭлементПоля.Поля.Найти(ИмяПоля) <> Неопределено Тогда
			
			Возврат Истина;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ПоляНеОбрабатываемыеУниверсальнойЗагрузкой(Поток)
	
	ИмяФункции = пбп_ИнтеграцииШинаПовтИсп
