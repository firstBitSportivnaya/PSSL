	Поля = пбп_ИнтеграцииШинаПовтИсп.РезультатПереопределения(ИмяФункции);
	
	Для Каждого Поле Из Поля Цикл
		
		ДобавитьЗначениеПоКлючуПоля(Результат, Поле, Истина);
		
