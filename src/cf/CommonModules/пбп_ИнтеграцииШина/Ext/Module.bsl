КонецФункции

Процедура ПостобработкаОбъектаПоОбъектуXDTO(ОбъектОбработки, ПараметрыОбмена, ПараметрыСообщения)
	
	Поток = ПараметрыОбмена.Поток;
	ОбъектXDTO = ПараметрыСообщения.ОбъектXDTO;
	СтруктураИсторииИнтеграции = ПараметрыОбмена.СтруктураИстории;
	
	ИмяПроцедуры = пбп_ИнтеграцииШинаПовтИсп.ИменаМетодовПостобработкиОбъектов()[Поток];
	
	Если ИмяПроцедуры = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Параметры = Новый Массив;
	Параметры.Добавить(ОбъектОбработки);
	Параметры.Добавить(ОбъектXDTO);
	Параметры.Добавить(СтруктураИсторииИнтеграции);
	
	пбп_Переадресация.ВыполнитьМетодКонфигурации(ИмяПроцедуры, Параметры);
	
	ОбъектОбработки = Параметры[0];
	
КонецПроцедуры

Функция ПолучитьЗначениеИзСоответствияИсточникаИПриемника(Соответствие, Ключ = "")
	
	ВложенноеСоответствие = Соответствие[Ключ];
	Если ВложенноеСоответствие = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Значение = ВложенноеСоответствие[Ключ];
	
	Если Значение = Неопределено 
		И ТипЗнч(ВложенноеСоответствие) = Тип("Соответствие")
		И ВложенноеСоответствие.Количество() = 1 Тогда
		Для Каждого КлючИЗначение Из ВложенноеСоответствие Цикл
			Значение = КлючИЗначение.Значение;
			Прервать;
		КонецЦикла;
	КонецЕсли;
	
	Если Значение = Неопределено Тогда
		ИмяВИ = ИмяПоляПоискаПоВнешнемуИдентификатору();
		Значение = ВложенноеСоответствие[ИмяВИ];
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

#КонецОбласти // ПереопределениеМетодов

#Область ЗапросПоОбъекту

// Возвращает соответствия заполнения шапки или одной табличной части.
// Пустое вложенное соответствие табличной части заменяется новым. Истина в ПоляИсключения означает,
// что раздел нужно пропустить.
//
// Параметры:
//  КонтекстЗаполнения - Структура - контекст загрузки объекта.
//  ИмяТабличнойЧасти - Строка, Неопределено - имя табличной части. Неопределено - шапка.
//
// Возвращаемое значение:
//  Структура - СоответствиеПолей, ПоляИсключения, СоответствиеТиповПолей, ПоляПоиска, Пропустить.
//
Функция КонтекстЗаполненияРаздела(КонтекстЗаполнения, ИмяТабличнойЧасти = Неопределено)

	Результат = Новый Структура;
	Результат.Вставить("Пропустить", Ложь);

	Если ИмяТабличнойЧасти = Неопределено Тогда

		Результат.Вставить("СоответствиеПолей", КонтекстЗаполнения.СоответствиеПолейИсточникаИПриемника);
		Результат.Вставить("ПоляИсключения", КонтекстЗаполнения.ПоляИсключения);
		Результат.Вставить("СоответствиеТиповПолей", КонтекстЗаполнения.СоответствиеТиповПолей);
		Результат.Вставить("ПоляПоиска", КонтекстЗаполнения.ПоляПоиска);

		Возврат Результат;

	КонецЕсли;

	СоответствиеПолей = КонтекстЗаполнения.СоответствиеПолейИсточникаИПриемника[ИмяТабличнойЧасти];

	Если СоответствиеПолей = Неопределено Тогда

		СоответствиеПолей = Новый Соответствие;

	КонецЕсли;

	ПоляИсключения = КонтекстЗаполнения.ПоляИсключения[ИмяТабличнойЧасти];

	Если ПоляИсключения = Истина Тогда

		Результат.Пропустить = Истина;
		ПоляИсключения = Новый Соответствие;

	ИначеЕсли ПоляИсключения = Неопределено Тогда

		ПоляИсключения = Новый Соответствие;

	КонецЕсли;

	СоответствиеТиповПолей = КонтекстЗаполнения.СоответствиеТиповПолей[ИмяТабличнойЧасти];

	Если СоответствиеТиповПолей = Неопределено Тогда

		СоответствиеТиповПолей = Новый Соответствие;

	КонецЕсли;

	ПоляПоиска = КонтекстЗаполнения.ПоляПоиска[ИмяТабличнойЧасти];

	Если ПоляПоиска = Неопределено Тогда

		ПоляПоиска = Новый Соответствие;

	КонецЕсли;

	Результат.Вставить("СоответствиеПолей", СоответствиеПолей);
	Результат.Вставить("ПоляИсключения", ПоляИсключения);
	Результат.Вставить("СоответствиеТиповПолей", СоответствиеТиповПолей);
	Результат.Вставить("ПоляПоиска", ПоляПоиска);

	Возврат Результат;

КонецФункции

Функция ИмяПоляВИсточнике(СоответствиеПолей, ИмяРеквизита)

	ИмяИзИсточника = ПолучитьЗначениеИзСоответствияИсточникаИПриемника(СоответствиеПолей, ИмяРеквизита);

	Если Не ЗначениеЗаполнено(ИмяИзИсточника) Тогда

		ИмяИзИсточника = ИмяРеквизита;

	КонецЕсли;

	Возврат ИмяИзИсточника;

КонецФункции

Функция КоллекцияСтрокТабличнойЧастиXDTO(ТабличнаяЧастьXDTO, ИмяТабличнойЧасти)

	КоллекцияXDTO = ТабличнаяЧастьXDTO[ИмяТабличнойЧасти];

	Если ТипЗнч(КоллекцияXDTO) = Тип("ОбъектXDTO")
		И КоллекцияXDTO.Свойства().Получить(ИмяТабличнойЧасти) <> Неопределено Тогда

		КоллекцияXDTO = КоллекцияXDTO[ИмяТабличнойЧасти];

	КонецЕсли;

	Если ТипЗнч(КоллекцияXDTO) = Тип("СписокXDTO") Тогда

		Если КоллекцияXDTO.Количество() = 0 Тогда

			Возврат Новый Структура("Коллекция, Свойства", КоллекцияXDTO, Неопределено);

		КонецЕсли;

		СвойстваСпискаXDTO = КоллекцияXDTO[0].Свойства();

	ИначеЕсли ТипЗнч(КоллекцияXDTO) = Тип("ОбъектXDTO") Тогда

		Если КоллекцияXDTO.Свойства().Количество() = 0 Тогда

			Возврат Новый Структура("Коллекция, Свойства", Новый Массив, Неопределено);

		КонецЕсли;

		СвойстваСпискаXDTO = КоллекцияXDTO.Свойства();
		СтрокиКоллекции = Новый Массив;
		СтрокиКоллекции.Добавить(КоллекцияXDTO);
		КоллекцияXDTO = СтрокиКоллекции;

	Иначе

		Возврат Новый Структура("Коллекция, Свойства", Новый Массив, Неопределено);

	КонецЕсли;

	Возврат Новый Структура("Коллекция, Свойства", КоллекцияXDTO, СвойстваСпискаXDTO);

КонецФункции

Функция ТипыПоляИзXDTO(ЭлементыXDTO, ИмяСвойстваТип)

	Если ЭлементыXDTO = Неопределено Или ЭлементыXDTO.Количество() = 0 Тогда

		Возврат Неопределено;

	КонецЕсли;

	Если ЭлементыXDTO[0].Свойства().Получить(ИмяСвойстваТип) = Неопределено Тогда

		Возврат Неопределено;

	КонецЕсли;

	ТипыПоля = Новый Массив;

	Для Каждого Элемент Из ЭлементыXDTO Цикл

		ЗначениеТипа = Элемент[ИмяСвойстваТип];

		Если Не ЗначениеЗаполнено(ЗначениеТипа) Или ЗначениеТипа = "Неопределено" Тогда

			Продолжить;

		КонецЕсли;

		ТипОбъекта = Тип(ЗначениеТипа);

		Если ТипыПоля.Найти(ТипОбъекта) = Неопределено Тогда

			ТипыПоля.Добавить(ТипОбъекта);

		КонецЕсли;

	КонецЦикла;

	Если ТипыПоля.Количество() = 0 Тогда

		Возврат Неопределено;

	КонецЕсли;

	Возврат ТипыПоля;

КонецФункции

Функция ЗначениеПараметраИзXDTO(Значение, ЭтоGUID, МетаданныеТипа = Неопределено)

	Если ЭтоGUID Тогда

		Если Не ЗначениеЗаполнено(Значение) Тогда

			Возврат Неопределено;

		КонецЕсли;

		Возврат Новый УникальныйИдентификатор(Значение);

	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Строка")
		И пбп_ИнтеграцииСлужебный.ЭтоСтандартнаяДата(Значение) Тогда

		Возврат XMLЗначение(Тип("Дата"), Значение);

	КонецЕсли;

	Если МетаданныеТипа = Неопределено Тогда

		Возврат Значение;

	КонецЕсли;

	Менеджер = пбп_Переадресация.МенеджерОбъектаПоПолномуИмени(МетаданныеТипа.ПолноеИмя());

	Если Не ЗначениеЗаполнено(Значение) Тогда

		Возврат Менеджер.ПустаяСсылка();

	КонецЕсли;

	Если ОбъектМетаданныхЯвляетсяПеречислением(МетаданныеТипа)
		И МетаданныеТипа.ЗначенияПеречисления.Найти(Значение) <> Неопределено Тогда

		Возврат Менеджер[Значение];

	КонецЕсли;

	Если ИмяПредопределенногоДоступно(МетаданныеТипа, Значение) Тогда

		Возврат Менеджер[Значение];

	КонецЕсли;

	Возврат Менеджер.ПустаяСсылка();

КонецФункции

Функция ПоляПоискаПоУмолчанию(ПроверяемыйТип, ЭтоGUID, ТипРеквизита = Неопределено)

	ИскатьПоИдентификатору = ЭтоGUID;

	Если ТипРеквизита <> Неопределено
		И ТипРеквизита = Новый ОписаниеТипов("УникальныйИдентификатор") Тогда

		ИскатьПоИдентификатору = Ложь;

	КонецЕсли;

	ЭтоСсылка = пбп_Переадресация.ЭтоСсылка(ПроверяемыйТип);
	ЭтоПеречисление = Ложь;

	Если ЭтоСсылка Тогда

		МетаданныеТипа = Метаданные.НайтиПоТипу(ПроверяемыйТип);
		ЭтоПеречисление = ОбъектМетаданныхЯвляетсяПеречислением(МетаданныеТипа);

	КонецЕсли;

	ВнешнийИдентификатор = ИмяПоляПоискаПоВнешнемуИдентификатору();
	ВнутреннийИдентификатор = ИмяПоляПоискаПоВнутреннемуИдентификатору();
	ИмяПоля = ПолучитьИмяРеквизитаВыгрузкиУниверсально(ПроверяемыйТип);
	ПоляПоиска = Неопределено;

	Если ЗначениеЗаполнено(ИмяПоля) Тогда

		ПоляПоиска = пбп_ПереадресацияКлиентСервер.ЗначениеВМассиве(ИмяПоля);

		Если ИмяПоля = ВнешнийИдентификатор Тогда

			ПоляПоиска.Добавить(ВнутреннийИдентификатор);

		КонецЕсли;

	ИначеЕсли ЭтоСсылка И Не ЭтоПеречисление И ИскатьПоИдентификатору Тогда

		ПоляПоиска = пбп_ПереадресацияКлиентСервер.ЗначениеВМассиве(ВнешнийИдентификатор);
		ПоляПоиска.Добавить(ВнутреннийИдентификатор);

	КонецЕсли;

	Возврат ПоляПоиска;

КонецФункции

Функция ЕстьСсылочныеТипы(ТипыПоля)

	Если ТипыПоля = Неопределено Тогда

		Возврат Ложь;

	КонецЕсли;

	Для Каждого ТипОбъекта Из ТипыПоля Цикл

		Если Не пбп_ОбщегоНазначенияСервер.ЭтоПримитивныйТип(ТипОбъекта) Тогда

			Возврат Истина;

		КонецЕсли;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

Процедура ДобавитьКолонкиПараметраТЧ(ТЗ, ИмяИзИсточника, ТипКолонки, СоответствиеТиповПолей)

	Если СоответствиеТиповПолей.Количество() = 0 Тогда

		Если ТЗ.Колонки.Найти(ИмяИзИсточника) = Неопределено Тогда

			ТЗ.Колонки.Добавить(ИмяИзИсточника, ТипКолонки);

		КонецЕсли;

		Возврат;

	КонецЕсли;

	Для Каждого ТекущийРеквизит Из СоответствиеТиповПолей Цикл

		Если ТЗ.Колонки.Найти(ТекущийРеквизит.Ключ) <> Неопределено Тогда

			Продолжить;

		КонецЕсли;

		Если Не ЗначениеЗаполнено(ТекущийРеквизит.Значение)
			И СоответствиеТиповПолей.Количество() = 1 Тогда

			ТЗ.Колонки.Добавить(ТекущийРеквизит.Ключ, ТипКолонки);

		Иначе

			ТЗ.Колонки.Добавить(ТекущийРеквизит.Ключ, ТекущийРеквизит.Значение);

		КонецЕсли;

	КонецЦикла;

	Если ТЗ.Колонки.Найти(ИмяИзИсточника) = Неопределено Тогда

		ТЗ.Колонки.Добавить(ИмяИзИсточника, пбп_Переадресация.ОписаниеТипаСтрока(36));

	КонецЕсли;

КонецПроцедуры

Функция ДополнитьЦепочкуЕстьNull(Условие, Поле, Индекс, ИндексПоследнего, ЗаменаПустогоЗначения)

	ПервоеУсловие = "ЕСТЬNULL(%1, %2)";

	Если Индекс = 0 И Индекс = ИндексПоследнего Тогда

		Возврат пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
			ПервоеУсловие, Поле, ЗаменаПустогоЗначения);

	КонецЕсли;

	Если Индекс = 0 Тогда

		Возврат пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(ПервоеУсловие, Поле, "%1");

	КонецЕсли;

	Если Индекс = ИндексПоследнего Тогда

		ВремУсловие = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
			ПервоеУсловие, Поле, ЗаменаПустогоЗначения);

		Возврат пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(Условие, ВремУсловие);

	КонецЕсли;

	ВремУсловие = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(ПервоеУсловие, Поле, "%1");

	Возврат пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(Условие, ВремУсловие, "%1");

КонецФункции

Функция ВыражениеПоПолямПоиска(ТекстЗапроса, ОписаниеПоля, ПсевдонимИсточника, ПриемникЗначений, ЗаменаПустогоЗначения)

	ПоляПоиска = ОписаниеПоля.ПоляПоиска;
	ИмяИзИсточника = ОписаниеПоля.ИмяИзИсточника;
	ПроверяемыйТип = ОписаниеПоля.ПроверяемыйТип;
	ЗначениеПараметра = ОписаниеПоля.ЗначениеПараметра;
	ЭтоТабличнаяЧасть = ПриемникЗначений.Свойство("ТЗ");
	ЭтоСсылка = пбп_Переадресация.ЭтоСсылка(ПроверяемыйТип);
	ИмяТаблицы = "";
	Мета = Неопределено;

	Если ЭтоСсылка Тогда

		Мета = Метаданные.НайтиПоТипу(ПроверяемыйТип);
		ИмяТаблицы = Мета.ПолноеИмя();

	КонецЕсли;

	ВнешнИД = ИмяПоляПоискаПоВнешнемуИдентификатору();
	ВнутрИД = ИмяПоляПоискаПоВнутреннемуИдентификатору();
	ВыраженияПоиска = Новый Массив;

	Для Каждого ПолеПоиска Из ПоляПоиска Цикл

		ИскатьПоВнутреннемуИдентификатору = ПолеПоиска = ВнутрИД
			И (Не ЭтоТабличнаяЧасть
				Или (Мета <> Неопределено И Не ОбъектМетаданныхЯвляетсяПеречислением(Мета) И ЭтоСсылка));

		Если ЭтоГруппаПолейПоиска(ПолеПоиска) Тогда

			Поле = ВыражениеПоГруппеПолейПоиска(
				ТекстЗапроса, ОписаниеПоля, ПсевдонимИсточника, ПриемникЗначений,
				ИмяТаблицы, ЭтоСсылка, ПолеПоиска);

		ИначеЕсли ПолеПоиска = ВнешнИД Тогда

			Поле = ВыражениеПоВнешнемуИдентификатору(
				ТекстЗапроса, ОписаниеПоля, ПсевдонимИсточника, ПриемникЗначений, ИмяТаблицы, ЗначениеПараметра);

		ИначеЕсли ИскатьПоВнутреннемуИдентификатору Тогда

			Поле = ВыражениеПоВнутреннемуИдентификатору(
				ТекстЗапроса, ОписаниеПоля, ПсевдонимИсточника, ПриемникЗначений, ИмяТаблицы, ЗначениеПараметра);

		Иначе

			Поле = ВыражениеПоРеквизитуПоиска(ТекстЗапроса, ОписаниеПоля, ПсевдонимИсточника,
				ПриемникЗначений, ИмяТаблицы, ЭтоСсылка, ПолеПоиска, ЗначениеПараметра);

		КонецЕсли;

		Если Поле = "Неопределено" Тогда

			Продолжить;

		КонецЕсли;

		ВыраженияПоиска.Добавить(Поле);

	КонецЦикла;

	Если ВыраженияПоиска.Количество() = 0 Тогда

		Возврат "Неопределено";

	КонецЕсли;

	Условие = "";
	ПоследнийИндекс = ВыраженияПоиска.ВГраница();

	Для Сч = 0 По ПоследнийИндекс Цикл

		Условие = ДополнитьЦепочкуЕстьNull(
			Условие, ВыраженияПоиска[Сч], Сч, ПоследнийИндекс, ЗаменаПустогоЗначения);

	КонецЦикла;

	Если ЭтоТабличнаяЧасть Тогда

		ПриемникЗначений.СоответствиеПоТЧ.Вставить(ИмяИзИсточника, ПриемникЗначений.СоответствиеПолей);

	КонецЕсли;

	Возврат Условие;

КонецФункции

Функция ВыражениеПоГруппеПолейПоиска(ТекстЗапроса, ОписаниеПоля, ПсевдонимИсточника,
	ПриемникЗначений, ИмяТаблицы, ЭтоСсылка, Группа)
	
	Если Не ЭтоСсылка Тогда
		
		Возврат "Неопределено";
		
	КонецЕсли;
	
	ЭтоТабличнаяЧасть = ПриемникЗначений.Свойство("ТЗ");
	ПодготовленныеПоля = Новый Массив;
	
	Для Каждого ИмяПоля Из Группа.Поля Цикл
		
		ИмяПоля = ИмяПоляГруппыБезПрефиксаРеквизита(ИмяПоля, ОписаниеПоля.ИмяРеквизита);
		
		ПолеИзXDTO = Неопределено;
		
		Если ОписаниеПоля.СоответствиеПолейПоиска <> Неопределено Тогда
			
			ПолеИзXDTO = ОписаниеПоля.СоответствиеПолейПоиска.Получить(ИмяПоля);
			
		КонецЕсли;
		
		Если ПолеИзXDTO = Неопределено Тогда
			
			ПолеИзXDTO = ИмяПоля;
			
		КонецЕсли;
		
		ИмяПоляИсточника = ?(ЭтоТабличнаяЧасть, ПолеИзXDTO, ОписаниеПоля.ИмяРеквизита + ИмяПоля);
		
		Если ИмяПоляЯвляетсяИдентификаторомПоиска(ИмяПоля)
			Или Не ИмяПоляДопустимо(ИмяПоля)
			Или Не ИмяПоляДопустимо(ПолеИзXDTO)
			Или Не ИмяПоляДопустимо(ИмяПоляИсточника)
			Или Не ИмяПоляЕстьВМетаданных(ИмяТаблицы, ИмяПоля) Тогда
			
			Возврат "Неопределено";
			
		КонецЕсли;
		
		Если ЭтоТабличнаяЧасть Тогда
			
			Если ПриемникЗначений.КоллекцияXDTO.Количество() = 0
				Или ПриемникЗначений.КоллекцияXDTO[0].Свойства().Получить(ПолеИзXDTO) = Неопределено Тогда
				
				Возврат "Неопределено";
				
			КонецЕсли;
			
		ИначеЕсли ОписаниеПоля.ОбъектXDTO.Свойства().Получить(ПолеИзXDTO) = Неопределено Тогда
			
			Возврат "Неопределено";
			
		КонецЕсли;
		
		ПодготовленныеПоля.Добавить(Новый Структура(
			"ИмяПоляПоиска, ИмяПоляИсточника, ПолеИзXDTO",
			ИмяПоля, ИмяПоляИсточника, ПолеИзXDTO));
		
	КонецЦикла;
	
	Если ПодготовленныеПоля.Количество() = 0 Тогда
		
		Возврат "Неопределено";
		
	КонецЕсли;
	
	ПоляСоединения = Новый Массив;
	
	Для Каждого ПодготовленноеПоле Из ПодготовленныеПоля Цикл
		
		Если ЭтоТабличнаяЧасть Тогда
			
			Часть = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
				"Данные.%1", ПодготовленноеПоле.ПолеИзXDTO);
			
			Если СтрНайти(ТекстЗапроса, ПодготовленноеПоле.ПолеИзXDTO) = 0 Тогда
				
				ДобавитьПолеВЗапросПриЗагрузке(ТекстЗапроса, Часть, "Данные");
				
			КонецЕсли;
			
			Если ПриемникЗначений.ТЗ.Колонки.Найти(ПодготовленноеПоле.ПолеИзXDTO) = Неопределено Тогда
				
				ТипыКолонки = Новый Массив;
				ТипыКолонки.Добавить(ТипЗнч(
					ПриемникЗначений.КоллекцияXDTO[0].Получить(ПодготовленноеПоле.ПолеИзXDTO)));
				ПриемникЗначений.ТЗ.Колонки.Добавить(
					ПодготовленноеПоле.ПолеИзXDTO,
					Новый ОписаниеТипов(ТипыКолонки,,, Новый КвалификаторыЧисла(10, 2), Новый КвалификаторыСтроки(50)));
				
			КонецЕсли;
			
			ПриемникЗначений.СоответствиеПолей.Вставить(
				ПодготовленноеПоле.ПолеИзXDTO, ПодготовленноеПоле.ПолеИзXDTO);
			
		Иначе
			
			ДобавитьПолеВЗапросПриЗагрузке(ТекстЗапроса, ПодготовленноеПоле.ИмяПоляИсточника);
			ПриемникЗначений.ЗначенияПараметров.Вставить(
				ПодготовленноеПоле.ИмяПоляИсточника,
				ЗначениеПараметраИзXDTO(
					ОписаниеПоля.ОбъектXDTO[ПодготовленноеПоле.ПолеИзXDTO], Ложь));
			
		КонецЕсли;
		
		ПоляСоединения.Добавить(Новый Структура(
			"ИмяПоляПоиска, ИмяПоляИсточника",
			ПодготовленноеПоле.ИмяПоляПоиска,
			ПодготовленноеПоле.ИмяПоляИсточника));
		
	КонецЦикла;
	
	ПроверятьНаNull = ?(ЭтоТабличнаяЧасть, ОписаниеПоля.ПроверятьНаNull, Ложь);
	
	ИмяРеквизитаПсевдонима = "";
	
	Если Не ЭтоТабличнаяЧасть Тогда
		
		ИмяРеквизитаПсевдонима = ОписаниеПоля.ИмяРеквизита;
		
	КонецЕсли;
	
	Возврат ДополнитьЗапросПоГруппеПолейПоиска(
		ТекстЗапроса, ПоляСоединения, ИмяТаблицы, ПсевдонимИсточника, ПроверятьНаNull,
		ИмяРеквизитаПсевдонима);
	
КонецФункции

Функция ВыражениеПоВнешнемуИдентификатору(ТекстЗапроса, ОписаниеПоля, ПсевдонимИсточника,
	ПриемникЗначений, ИмяТаблицы, ЗначениеПараметра)

	ОписаниеРегистра = ОписаниеРегистраПубличныхИдентификаторов();

	Если Не ОписаниеРегистра.Использовать Тогда

		Возврат "Неопределено";

	КонецЕсли;

	ЭтоТабличнаяЧасть = ПриемникЗначений.Свойство("ТЗ");

	Если ЭтоТабличнаяЧасть Тогда

		ИмяРеквизитаПоиска = ОписаниеПоля.ИмяИзИсточника + "_Строка";
		ИмяПоля = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку("Данные.%1", ИмяРеквизитаПоиска);
		ДобавитьПолеВЗапросПриЗагрузке(ТекстЗапроса, ИмяПоля, "Данные");
		Поле = ДополнитьЗапросДаннымиПоПубличномуИдентификаторуКонкатенация(
			ТекстЗапроса, ИмяРеквизитаПоиска, ИмяТаблицы, ПсевдонимИсточника, ОписаниеПоля.ПроверятьНаNull);
		ТипКолонки = пбп_Переадресация.ОписаниеТипаСтрока(ОписаниеРегистра.ДлинаИдентификатора);
		ПриемникЗначений.СоответствиеПолей.Вставить(ИмяРеквизитаПоиска, ОписаниеПоля.ИмяИзИсточника);
		ПриемникЗначений.СоответствиеТиповПолей.Вставить(ИмяРеквизитаПоиска, ТипКолонки);
		ПриемникЗначений.ТипКолонки = ТипКолонки;

	Иначе

		ЗначениеПараметра = Строка(ЗначениеПараметра);
		ИмяРеквизитаПоиска = ОписаниеПоля.ИмяРеквизита + "_Строка";
		ДобавитьПолеВЗапросПриЗагрузке(ТекстЗапроса, ИмяРеквизитаПоиска);
		Поле = ДополнитьЗапросДаннымиПоПубличномуИдентификаторуКонкатенация(
			ТекстЗапроса, ИмяРеквизитаПоиска, ИмяТаблицы, ПсевдонимИсточника, Ложь);
		ПриемникЗначений.ЗначенияПараметров.Вставить(ИмяРеквизитаПоиска, ЗначениеПараметра);
		ПриемникЗначений.ЗначенияПараметров.Вставить(ОписаниеПоля.ИмяРеквизита, ЗначениеПараметра);

	КонецЕсли;

	Возврат Поле;

КонецФункции

Функция ВыражениеПоВнутреннемуИдентификатору(ТекстЗапроса, ОписаниеПоля, ПсевдонимИсточника,
	ПриемникЗначений, ИмяТаблицы, ЗначениеПараметра)

	ЭтоТабличнаяЧасть = ПриемникЗначений.Свойство("ТЗ");
	ИмяПоляСоединения = ?(ЭтоТабличнаяЧасть, ОписаниеПоля.ИмяИзИсточника, ОписаниеПоля.ИмяРеквизита);
	ПроверятьНаNull = ?(ЭтоТабличнаяЧасть, ОписаниеПоля.ПроверятьНаNull, Истина);
	ТипДанных = ?(ЭтоТабличнаяЧасть, ОписаниеПоля.ПроверяемыйТип, Неопределено);
	Поле = ДополнитьЗапросСсылочнымПолемКонкатенация(
		ТекстЗапроса, ИмяПоляСоединения, ИмяТаблицы, ПсевдонимИсточника, 1,
		ОписаниеПоля.ИндексОператора, ПроверятьНаNull, ТипДанных);

	Если ЭтоТабличнаяЧасть Тогда

		ТипКолонки = Новый ОписаниеТипов("УникальныйИдентификатор");
		ПриемникЗначений.СоответствиеПолей.Вставить(ОписаниеПоля.ИмяИзИсточника, ОписаниеПоля.ИмяИзИсточника);
		ПриемникЗначений.СоответствиеТиповПолей.Вставить(ОписаниеПоля.ИмяИзИсточника, ТипКолонки);
		ПриемникЗначений.ТипКолонки = ТипКолонки;

	Иначе

		ЗначениеПараметра = Строка(ЗначениеПараметра);

		Если ЗначениеЗаполнено(ЗначениеПараметра) Тогда

			ПриемникЗначений.ЗначенияПараметров.Вставить(
				ОписаниеПоля.ИмяРеквизита, Новый УникальныйИдентификатор(ЗначениеПараметра));

		Иначе

			ПриемникЗначений.ЗначенияПараметров.Вставить(
				ОписаниеПоля.ИмяРеквизита, ПустойУникальныйИдентификатор());

		КонецЕсли;

	КонецЕсли;

	Возврат Поле;

КонецФункции

Функция ВыражениеПоРеквизитуПоиска(ТекстЗапроса, ОписаниеПоля, ПсевдонимИсточника,
	ПриемникЗначений, ИмяТаблицы, ЭтоСсылка, ПолеПоиска, ЗначениеПараметра)

	ЭтоТабличнаяЧасть = ПриемникЗначений.Свойство("ТЗ");

	Если ЭтоТабличнаяЧасть Тогда

		Если ОписаниеПоля.СоответствиеПолейПоиска = Неопределено Тогда

			ПолеИзXDTO = ОписаниеПоля.Реквизит.Имя;

		Иначе

			ПолеИзXDTO = ОписаниеПоля.СоответствиеПолейПоиска[ПолеПоиска];

		КонецЕсли;

		Часть = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку("Данные.%1", ПолеИзXDTO);

		Если СтрНайти(ТекстЗапроса, ПолеИзXDTO) = 0 Тогда

			ДобавитьПолеВЗапросПриЗагрузке(ТекстЗапроса, Часть, "Данные");

		КонецЕсли;

		Если Не ЭтоСсылка Тогда

			Поле = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку("ДанныеТЧ.%1", ПолеИзXDTO);

		Иначе

			Поле = ДополнитьЗапросПоПолюПоискаКонкатенация(ТекстЗапроса, ПолеИзXDTO, ПолеПоиска,
				ИмяТаблицы, ПсевдонимИсточника, 1, 0, ОписаниеПоля.ПроверятьНаNull);

		КонецЕсли;

		мТипов = Новый Массив;

		Если ПриемникЗначений.КоллекцияXDTO.Количество() = 0 Тогда

			мТипов.Добавить(Тип("Строка"));

		Иначе

			мТипов.Добавить(ТипЗнч(ПриемникЗначений.КоллекцияXDTO[0].Получить(ПолеИзXDTO)));

		КонецЕсли;

		Если ПриемникЗначений.ТЗ.Колонки.Найти(ПолеИзXDTO) = Неопределено Тогда

			ПриемникЗначений.ТЗ.Колонки.Добавить(ПолеИзXDTO,
				Новый ОписаниеТипов(мТипов,,, Новый КвалификаторыЧисла(10, 2), Новый КвалификаторыСтроки(50)));

		КонецЕсли;

		ПриемникЗначений.СоответствиеПолей.Вставить(ПолеИзXDTO, ПолеИзXDTO);

	Иначе

		ПолеИзXDTO = Неопределено;

		Если ОписаниеПоля.СоответствиеПолейПоиска <> Неопределено Тогда

			ПолеИзXDTO = ОписаниеПоля.СоответствиеПолейПоиска.Получить(ПолеПоиска);

		КонецЕсли;

		Если ПолеИзXDTO = Неопределено Тогда

			ПолеИзXDTO = ОписаниеПоля.ИмяРеквизита;

		КонецЕсли;

		ПолеПоискаДопустимо = ИмяПоляДопустимо(ПолеИзXDTO)
			И (Не ЭтоСсылка Или ИмяПоляЕстьВМетаданных(ИмяТаблицы, ПолеПоиска));

		Если Не ПолеПоискаДопустимо Тогда

			Поле = "Неопределено";

		Иначе

			Если Не ЭтоСсылка Тогда

				Поле = ПсевдонимИсточника + "." + ОписаниеПоля.ИмяРеквизита;

			Иначе

				ПолеПоискаСоединения = ПолеПоиска;
				ЗначениеДляПараметра = ОписаниеПоля.ОбъектXDTO[ПолеИзXDTO];

				Если ПолеПоиска = "ИмяПредопределенныхДанных" Тогда

					ПолеПоискаСоединения = "Ссылка";
					ЗначениеДляПараметра = СсылкаПредопределенногоПоИмени(ИмяТаблицы, ЗначениеДляПараметра);

				КонецЕсли;

				Поле = ДополнитьЗапросПоПолюПоискаКонкатенация(ТекстЗапроса, ОписаниеПоля.ИмяРеквизита,
					ПолеПоискаСоединения, ИмяТаблицы, ПсевдонимИсточника, 1, ОписаниеПоля.ИндексОператора, Ложь);

			КонецЕсли;

			ПриемникЗначений.ЗначенияПараметров.Вставить(
				ОписаниеПоля.ИмяРеквизита, ЗначениеДляПараметра);

		КонецЕсли;

	КонецЕсли;

	Возврат Поле;

КонецФункции

Процедура ЗаполнитьТаблицуПараметраТЧ(ТЗ, КоллекцияXDTO, ПоляТЧ, СоответствиеПоТЧ)

	Для Каждого Объект Из КоллекцияXDTO Цикл

		нСтрока = ТЗ.Добавить();

		Для Каждого ПолеТЧ Из ПоляТЧ Цикл

			ВложенноеСоответствие = СоответствиеПоТЧ[ПолеТЧ.Имя];

			Если ЗначениеЗаполнено(ВложенноеСоответствие) Тогда

				ЗаполнитьСтрокуТЧПоСоответствию(нСтрока, ТЗ, Объект, ПолеТЧ, ВложенноеСоответствие);

			Иначе

				ИмяИзИсточника = ИмяПоляВИсточнике(СоответствиеПоТЧ, ПолеТЧ.Имя);
				ЗначениеПараметра = Объект.Получить(ИмяИзИсточника);

				Если ПолеТЧ.ЭтоGUID Тогда

					ЗначениеПараметра = ЗначениеПараметраИзXDTO(ЗначениеПараметра, Истина);

				ИначеЕсли ПолеТЧ.Мета <> Неопределено Тогда

					ЗначениеПараметра = ЗначениеПараметраИзXDTO(ЗначениеПараметра, Ложь, ПолеТЧ.Мета);

				Иначе

					ЗначениеПараметра = ЗначениеПараметраИзXDTO(ЗначениеПараметра, Ложь);

				КонецЕсли;

				нСтрока[ПолеТЧ.Имя] = ЗначениеПараметра;

			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьСтрокуТЧПоСоответствию(нСтрока, ТЗ, Объект, ПолеТЧ, ВложенноеСоответствие)

	Для Каждого Пара Из ВложенноеСоответствие Цикл

		ЗначениеПараметра = Объект.Получить(Пара.Значение);

		Если ТипЗнч(ЗначениеПараметра) = Тип("Строка")
			И пбп_ИнтеграцииСлужебный.ЭтоСтандартнаяДата(ЗначениеПараметра) Тогда

			ЗначениеПараметра = XMLЗначение(Тип("Дата"), ЗначениеПараметра);

		КонецЕсли;

		Если Пара.Ключ = ИмяПоляПоискаПоВнешнемуИдентификатору() Тогда

			нСтрока[ПолеТЧ.Имя] = ЗначениеПараметра;

		Иначе

			Если ПолеТЧ.Мета <> Неопределено И Не ПолеТЧ.ЭтоGUID
				И ОбъектМетаданныхЯвляетсяПеречислением(ПолеТЧ.Мета) Тогда

				ЗначениеПараметра = ЗначениеПараметраИзXDTO(ЗначениеПараметра, Ложь, ПолеТЧ.Мета);

			ИначеЕсли Не ЗначениеЗаполнено(ЗначениеПараметра) Тогда

				Если Не ТЗ.Колонки.Найти(ПолеТЧ.Имя) = Неопределено Тогда

					нСтрока[ПолеТЧ.Имя] = Неопределено;

				Иначе

					ЗначениеПараметра = Неопределено;

				КонецЕсли;

			ИначеЕсли ТипЗнч(ЗначениеПараметра) = Тип("Строка")
				И пбп_ИнтеграцииСлужебный.ЭтоСтандартнаяДата(ЗначениеПараметра) Тогда

				ЗначениеПараметра = XMLЗначение(Тип("Дата"), ЗначениеПараметра);

			ИначеЕсли ПолеТЧ.ЭтоGUID Тогда

				ЗначениеПараметра = ЗначениеПараметраИзXDTO(ЗначениеПараметра, Истина);

			КонецЕсли;

			Если Не ТЗ.Колонки.Найти(Пара.Ключ) = Неопределено Тогда

				нСтрока[Пара.Ключ] = ЗначениеПараметра;

			Иначе

				нСтрока[Пара.Значение] = ЗначениеПараметра;

			КонецЕсли;

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьРеквизитТабличнойЧастиВЗапрос(ТекстЗапроса, ТЗ, Поля, ПоляТЧ, Реквизит,
	КоллекцияXDTO, СвойстваСпискаXDTO, КонтекстРаздела)

	ИмяИзИсточника = ИмяПоляВИсточнике(КонтекстРаздела.СоответствиеПолей, Реквизит.Имя);

	Если СвойстваСпискаXDTO.Получить(ИмяИзИсточника) = Неопределено
		Или ЗначениеЗаполнено(КонтекстРаздела.ПоляИсключения[ИмяИзИсточника]) Тогда

		Возврат;

	КонецЕсли;

	ПолеВыборки = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку("Данные.%1", ИмяИзИсточника);
	ДобавитьПолеВЗапросПриЗагрузке(ТекстЗапроса, ПолеВыборки, "Данные");

	СтруктураПоля = Новый Структура("Имя,ЭтоGUID,Мета", Реквизит.Имя, Ложь, Неопределено);

	Для Каждого ЭлементКоллекции Из КоллекцияXDTO Цикл

		СтруктураПоля.ЭтоGUID = пбп_ИнтеграцииСлужебный.ЭтоУникальныйИдентификатор(
			ЭлементКоллекции.Получить(ИмяИзИсточника));

		Если СтруктураПоля.ЭтоGUID Тогда

			Прервать;

		КонецЕсли;

	КонецЦикла;

	СоответствиеПолей = Новый Соответствие;
	СоответствиеТиповПолей = Новый Соответствие;
	ТипыПоля = КонтекстРаздела.СоответствиеТиповПолей[ИмяИзИсточника];
	ЕстьСсылочныеВСоставном = Ложь;

	Если ТипыПоля = Неопределено Тогда

		ТипыПоля = ТипыПоляИзXDTO(КоллекцияXDTO, Реквизит.Имя + "Тип");
		ЕстьСсылочныеВСоставном = ЕстьСсылочныеТипы(ТипыПоля);

	КонецЕсли;

	ПоляПоиска = КонтекстРаздела.ПоляПоиска[ИмяИзИсточника];

	Если ПоляПоиска = Неопределено И ТипыПоля = Неопределено Тогда

		ПоляПоиска = ПоляПоискаПоУмолчанию(Реквизит.Тип.Типы()[0], СтруктураПоля.ЭтоGUID, Реквизит.Тип);

	КонецЕсли;

	Если ТипыПоля <> Неопределено Тогда

		ДанныеДобавленногоПоля = ДобавитьРеквизитСоставногоТипыВЗапросТЧ(КоллекцияXDTO, ТЗ, ТекстЗапроса,
			СтруктураПоля, ИмяИзИсточника, ТипыПоля, Реквизит,
			КонтекстРаздела.СоответствиеПолей, СоответствиеПолей, СоответствиеТиповПолей);

		Если Не ЕстьСсылочныеВСоставном Тогда

			ДанныеДобавленногоПоля.Поле = СтрЗаменить(ДанныеДобавленногоПоля.Поле,
				"ВЫБОР
				|ИНАЧЕ ДанныеТЧ." + ИмяИзИсточника + "
				|КОНЕЦ",
				"ДанныеТЧ." + ИмяИзИсточника);
			МассивПримитивныхТипов = Новый Массив;
			МассивПримитивныхТипов.Добавить(Тип("Число"));
			МассивПримитивныхТипов.Добавить(Тип("Строка"));
			МассивПримитивныхТипов.Добавить(Тип("Дата"));
			МассивПримитивныхТипов.Добавить(Тип("Булево"));
			ДанныеДобавленногоПоля.ТипКолонки = Новый ОписаниеТипов(МассивПримитивныхТипов);

		КонецЕсли;

	Иначе

		ДанныеДобавленногоПоля = ДобавитьРеквизитВЗапросТЧ(КоллекцияXDTO, ТЗ, ТекстЗапроса,
			СтруктураПоля, ИмяИзИсточника, Реквизит.Тип.Типы()[0], ПоляПоиска, Реквизит,
			КонтекстРаздела.СоответствиеПолей, СоответствиеПолей, СоответствиеТиповПолей);

	КонецЕсли;

	ПоляТЧ.Добавить(СтруктураПоля);
	Поля.Добавить(ДанныеДобавленногоПоля.Поле, СтруктураПоля.Имя);
	ДобавитьКолонкиПараметраТЧ(ТЗ, ИмяИзИсточника, ДанныеДобавленногоПоля.ТипКолонки, СоответствиеТиповПолей);

КонецПроцедуры

Функция ДополнитьЗапросДинамическимиДаннымиТабличныхЧастей(МетаОбъекта, ОбъектXDTO, СвойстваXDTO, КонтекстЗаполнения)

	Результат = Новый Структура("ТекстыЗапроса,ПараметрыЗапроса,ПорядокТабличныхЧастей",
		Новый Массив, Новый Структура, Новый Массив);
	ШаблонТекстаЗапросаТабличнойЧасти = "ВЫБРАТЬ
	|	Данные.ИмяТабличнойЧасти КАК ИмяТабличнойЧасти
	|ПОМЕСТИТЬ ВТ_Данные_%1
	|ИЗ
	|	&%1 КАК Данные
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеТЧ.ИмяТабличнойЧасти КАК ИмяТабличнойЧасти
	|ИЗ
	|	ВТ_Данные_%1 КАК ДанныеТЧ";

	Для Каждого ТабличнаяЧасть Из МетаОбъекта.ТабличныеЧасти Цикл

		КонтекстРаздела = КонтекстЗаполненияРаздела(КонтекстЗаполнения, ТабличнаяЧасть.Имя);

		Если КонтекстРаздела.Пропустить Тогда

			Продолжить;

		КонецЕсли;

		ИмяТЧИзИсточника = КонтекстРаздела.СоответствиеПолей["_имя_источника"];

		Если Не ЗначениеЗаполнено(ИмяТЧИзИсточника) Тогда

			ИмяТЧИзИсточника = ТабличнаяЧасть.Имя;

		КонецЕсли;

		СвойствоXDTO = СвойстваXDTO.Получить(ИмяТЧИзИсточника);

		Если СвойствоXDTO = Неопределено Тогда

			Продолжить;

		КонецЕсли;

		ТабличнаяЧастьXDTO = ОбъектXDTO.Получить(СвойствоXDTO);

		Если ТипЗнч(ТабличнаяЧастьXDTO) = Тип("СписокXDTO") Тогда

			Если ТабличнаяЧастьXDTO.Количество() = 0 Тогда

				Продолжить;

			КонецЕсли;

		ИначеЕсли ТипЗнч(ТабличнаяЧастьXDTO) <> Тип("ОбъектXDTO")
			Или Не ЗначениеЗаполнено(ТабличнаяЧастьXDTO.Свойства()) Тогда

			Продолжить;

		КонецЕсли;

		ТекстЗапроса = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
			ШаблонТекстаЗапросаТабличнойЧасти, ТабличнаяЧасть.Имя);
		ДанныеКоллекции = КоллекцияСтрокТабличнойЧастиXDTO(ТабличнаяЧастьXDTO, ИмяТЧИзИсточника);
		ТЗ = Новый ТаблицаЗначений;
		ТЗ.Колонки.Добавить("ИмяТабличнойЧасти", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(30)));

		Если ДанныеКоллекции.Свойства = Неопределено Тогда

			Результат.ПорядокТабличныхЧастей.Добавить(ТабличнаяЧасть.Имя);
			Результат.ПараметрыЗапроса.Вставить(ТабличнаяЧасть.Имя, ТЗ);
			Результат.ТекстыЗапроса.Добавить(ТекстЗапроса);
			Продолжить;

		КонецЕсли;

		ПоляТЧ = Новый Массив;
		Поля = Новый СписокЗначений;

		Для Каждого Реквизит Из ТабличнаяЧасть.Реквизиты Цикл

			ДобавитьРеквизитТабличнойЧастиВЗапрос(ТекстЗапроса, ТЗ, Поля, ПоляТЧ, Реквизит,
				ДанныеКоллекции.Коллекция, ДанныеКоллекции.Свойства, КонтекстРаздела);

		КонецЦикла;

		ДобавитьПоляВЗапросПриЗагрузке(ТекстЗапроса, Поля);
		ЗаполнитьТаблицуПараметраТЧ(ТЗ, ДанныеКоллекции.Коллекция, ПоляТЧ, КонтекстРаздела.СоответствиеПолей);
		Результат.ПорядокТабличныхЧастей.Добавить(ТабличнаяЧасть.Имя);
		Результат.ПараметрыЗапроса.Вставить(ТабличнаяЧасть.Имя, ТЗ);
		Результат.ТекстыЗапроса.Добавить(ТекстЗапроса);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Истина, если составное соответствие реквизита ссылается хотя бы на одно поле источника из сообщения.
//
// Параметры:
//  СоответствиеПолей - Соответствие - соответствие полей раздела загрузки.
//  ИмяРеквизита - Строка - имя реквизита приемника.
//  СвойстваXDTO - КоллекцияСвойствXDTO - свойства объекта сообщения.
//
// Возвращаемое значение:
//  Булево - Истина, если имя поля источника есть в сообщении и отличается от имени реквизита.
//
Функция ЕстьПоляИсточникаДляПоиска(СоответствиеПолей, ИмяРеквизита, СвойстваXDTO)

	ВложенноеСоответствие = СоответствиеПолей[ИмяРеквизита];

	Если ТипЗнч(ВложенноеСоответствие) <> Тип("Соответствие") Тогда

		Возврат Ложь;

	КонецЕсли;

	Для Каждого КлючИЗначение Из ВложенноеСоответствие Цикл

		ИмяПоляИсточника = КлючИЗначение.Значение;

		Если ТипЗнч(ИмяПоляИсточника) = Тип("Строка")
			И ИмяПоляИсточника <> ИмяРеквизита
			И СвойстваXDTO.Получить(ИмяПоляИсточника) <> Неопределено Тогда

			Возврат Истина;

		КонецЕсли;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Истина, если хотя бы одно вложенное поле источника, пригодное для поиска, заполнено.
//
// Параметры:
//  ОбъектXDTO - ОбъектXDTO - объект сообщения.
//  СвойстваXDTO - КоллекцияСвойствXDTO - свойства объекта сообщения.
//  ВложенноеСоответствие - Соответствие - поля реквизита: ключ приемника, значение источника.
//  ИмяРеквизита - Строка - имя реквизита приемника.
//
// Возвращаемое значение:
//  Булево - Истина, если найдено непустое значение поля источника.
//
Функция ВложенныеПоляИсточникаЗаполнены(ОбъектXDTO, СвойстваXDTO, ВложенноеСоответствие, ИмяРеквизита)

	Для Каждого КлючИЗначение Из ВложенноеСоответствие Цикл

		ИмяПоляИсточника = КлючИЗначение.Значение;

		Если ТипЗнч(ИмяПоляИсточника) <> Тип("Строка")
			Или ИмяПоляИсточника = ИмяРеквизита
			Или СвойстваXDTO.Получить(ИмяПоляИсточника) = Неопределено Тогда

			Продолжить;

		КонецЕсли;

		Если ЗначениеПоляИсточникаПустое(ОбъектXDTO.Получить(ИмяПоляИсточника)) Тогда

			Продолжить;

		КонецЕсли;

		Возврат Истина;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Истина, если значение поля источника пустое, пустой идентификатор или пустая дата XML.
//
// Параметры:
//  ЗначениеПоля - Произвольный - значение свойства сообщения.
//
// Возвращаемое значение:
//  Булево - Истина, если значение не нужно использовать для поиска.
//
Функция ЗначениеПоляИсточникаПустое(ЗначениеПоля)

	Если Не ЗначениеЗаполнено(ЗначениеПоля) Тогда

		Возврат Истина;

	КонецЕсли;

	Возврат ТипЗнч(ЗначениеПоля) = Тип("Строка")
		И (СтрНайти(ЗначениеПоля, "00000000-0000-0000-0000-000000000000") > 0
			Или ЗначениеПоля = "0001-01-01T00:00:00");

КонецФункции

// Истина, если реквизит шапки заполнен своим полем или вложенными полями источника.
//
// Параметры:
//  ОбъектXDTO - ОбъектXDTO - объект сообщения.
//  СвойстваXDTO - КоллекцияСвойствXDTO - свойства объекта сообщения.
//  СоответствиеПолей - Соответствие - соответствие полей раздела загрузки.
//  ИмяРеквизита - Строка - имя реквизита приемника.
//  ИмяИзИсточника - Строка - имя поля источника для прямого чтения.
//  ПолеИсточникаНайдено - Булево - имя прямого поля есть в сообщении.
//  ЕстьПоляИсточника - Булево - составное соответствие ссылается на поля источника.
//
// Возвращаемое значение:
//  Булево - Истина, если реквизит можно загружать.
//
Функция РеквизитШапкиЗаполнен(ОбъектXDTO, СвойстваXDTO, СоответствиеПолей, ИмяРеквизита,
	ИмяИзИсточника, ПолеИсточникаНайдено, ЕстьПоляИсточника)

	Если Не ПолеИсточникаНайдено И ЕстьПоляИсточника Тогда

		Возврат ВложенныеПоляИсточникаЗаполнены(ОбъектXDTO, СвойстваXDTO,
			СоответствиеПолей[ИмяРеквизита], ИмяРеквизита);

	КонецЕсли;

	Возврат Не ЗначениеПоляИсточникаПустое(ОбъектXDTO.Получить(ИмяИзИсточника));

КонецФункции

Процедура ДополнитьЗапросРеквизитомШапки(ТекстЗапроса, Результат, Реквизит, ОбъектXDTO, СвойстваXDTO,
	КонтекстЗаполнения, КонтекстРаздела, Сч, ПроверятьЗначение)

	ИмяИзИсточника = ИмяПоляВИсточнике(КонтекстРаздела.СоответствиеПолей, Реквизит.Имя);
	ЕстьПоляИсточника = ЕстьПоляИсточникаДляПоиска(
		КонтекстРаздела.СоответствиеПолей, Реквизит.Имя, СвойстваXDTO);
	ПолеИсточникаНайдено = СвойстваXDTO.Получить(ИмяИзИсточника) <> Неопределено;

	Если Реквизит.Имя = "Ссылка"
		Или ЗначениеЗаполнено(КонтекстРаздела.ПоляИсключения[Реквизит.Имя])
		Или (Не ПолеИсточникаНайдено И Не ЕстьПоляИсточника) Тогда

		Возврат;

	КонецЕсли;

	Если ПроверятьЗначение
		И Не РеквизитШапкиЗаполнен(ОбъектXDTO, СвойстваXDTO, КонтекстРаздела.СоответствиеПолей,
			Реквизит.Имя, ИмяИзИсточника, ПолеИсточникаНайдено, ЕстьПоляИсточника) Тогда

		Возврат;

	КонецЕсли;

	ЗначенияПараметров = ДополнитьТекстЗапросаРеквизитовОбъектаПолем(ТекстЗапроса,
		Реквизит, ИмяИзИсточника, ОбъектXDTO, СвойстваXDTO, КонтекстЗаполнения, Сч);

	Если ПроверятьЗначение
		И ИмяИзИсточника <> Реквизит.Имя
		И Не ЗначенияПараметров.Свойство(Реквизит.Имя)
		И ЗначенияПараметров.Свойство(ИмяИзИсточника) Тогда

		ЗначенияПараметров.Вставить(Реквизит.Имя, ЗначенияПараметров[ИмяИзИсточника]);

	КонецЕсли;

	пбп_ПереадресацияКлиентСервер.ДополнитьСтруктуру(Результат.ПараметрыЗапроса, ЗначенияПараметров);
	Сч = Сч + 1;

КонецПроцедуры

Функция ДополнитьЗапросДинамическимиДаннымиШапки(МетаОбъекта, ОбъектXDTO, СвойстваXDTO, КонтекстЗаполнения)

	Результат = Новый Структура("ТекстЗапроса,ПараметрыЗапроса", "", Новый Структура);
	ТекстЗапроса = "ВЫБРАТЬ
				|	&Заглушка КАК Заглушка
				|ПОМЕСТИТЬ ВТ_Данные";
	Сч = 0;
	КонтекстРаздела = КонтекстЗаполненияРаздела(КонтекстЗаполнения);

	Для Каждого Реквизит Из МетаОбъекта.Реквизиты Цикл

		ДополнитьЗапросРеквизитомШапки(ТекстЗапроса, Результат, Реквизит, ОбъектXDTO, СвойстваXDTO,
			КонтекстЗаполнения, КонтекстРаздела, Сч, Истина);

	КонецЦикла;

	Для Каждого Реквизит Из МетаОбъекта.СтандартныеРеквизиты Цикл

		ДополнитьЗапросРеквизитомШапки(ТекстЗапроса, Результат, Реквизит, ОбъектXDTO, СвойстваXDTO,
			КонтекстЗаполнения, КонтекстРаздела, Сч, Ложь);

	КонецЦикла;

	Результат.ТекстЗапроса = ТекстЗапроса;

	Возврат Результат;

КонецФункции

Функция ДополнитьТекстЗапросаРеквизитовОбъектаПолем(ТекстЗапроса, Реквизит, ИмяИзИсточника, ОбъектXDTO, СвойстваXDTO,
	КонтекстЗаполнения, ИндексОператора)

	ШаблонВыбора = "КОГДА НЕ %1 ЕСТЬ NULL ТОГДА
			|%1";
	ШаблонТекстаЗапроса = "
	|ВЫБРАТЬ
	|	ВТ_Данные.Заглушка Как Заглушка,
	|	NULL КАК ИмяРеквизита,
	|	NULL КАК Значение
	|ИЗ
	|	ВТ_Данные КАК ВТ_Данные";

	Если ИндексОператора = 0 Тогда

		ТекстЗапроса = ТекстЗапроса + пбп_Переадресация.РазделительПакетаЗапросов() + ШаблонТекстаЗапроса;

	Иначе

		ТекстЗапроса = ТекстЗапроса + ТекстОбъединитьВсе() + ШаблонТекстаЗапроса;

	КонецЕсли;

	ИмяРеквизита = Реквизит.Имя;

	Если СвойстваXDTO.Получить(ИмяИзИсточника) = Неопределено Тогда

		Значение = Неопределено;

	Иначе

		Значение = ОбъектXDTO.Получить(ИмяИзИсточника);

	КонецЕсли;
	ЭтоGUID = пбп_ИнтеграцииСлужебный.ЭтоУникальныйИдентификатор(Значение);
	ЗначениеПараметра = ЗначениеПараметраИзXDTO(Значение, ЭтоGUID);
	ТипыПоля = КонтекстЗаполнения.СоответствиеТиповПолей[ИмяРеквизита];
	ПоляПоиска = КонтекстЗаполнения.ПоляПоиска[ИмяРеквизита];
	ЭлементыXDTO = Новый Массив;
	ЭлементыXDTO.Добавить(ОбъектXDTO);
	ТипыИзXDTO = ТипыПоляИзXDTO(ЭлементыXDTO, Реквизит.Имя + "Тип");

	Если ТипыИзXDTO = Неопределено Тогда

		ПроверяемыйТип = Реквизит.Тип.Типы()[0];

	Иначе

		ПроверяемыйТип = ТипыИзXDTO[0];

	КонецЕсли;

	Если ПоляПоиска = Неопределено Тогда

		ЗаполнитьПоляПоискаПоУмолчанию(ПоляПоиска, ЭтоGUID, ПроверяемыйТип);

	КонецЕсли;

	ЗначенияПараметров = Новый Структура;

	Если ТипыПоля <> Неопределено Тогда

		ДобавитьПолеВЗапросПриЗагрузке(ТекстЗапроса, ИмяРеквизита);
		Поле = ПолучитьТекстЗапросаРеквизитовОбъекта_ПоТипамПолей(ТекстЗапроса, ТипыПоля, ЭтоGUID,
			ИмяРеквизита, ИндексОператора, ШаблонВыбора, ЗначенияПараметров, ЗначениеПараметра);

	ИначеЕсли ПоляПоиска <> Неопределено Тогда

		Поле = ПолучитьТекстЗапросаРеквизитовОбъекта_ПоПолямПоиска(ТекстЗапроса, КонтекстЗаполнения,
			ПоляПоиска, ОбъектXDTO, ИмяРеквизита, ИндексОператора, ПроверяемыйТип, ЗначенияПараметров, ЗначениеПараметра);

		Если ЗначенияПараметров.Свойство(ИмяРеквизита) Тогда

			ДобавитьПолеВЗапросПриЗагрузке(ТекстЗапроса, ИмяРеквизита);

		КонецЕсли;

	Иначе

		ДобавитьПолеВЗапросПриЗагрузке(ТекстЗапроса, ИмяРеквизита);
		Поле = ПолучитьТекстЗапросаРеквизитовОбъекта_ПоУмолчанию(ТекстЗапроса, ЭтоGUID,
			ИмяРеквизита, ИндексОператора, ПроверяемыйТип, ЗначенияПараметров, ЗначениеПараметра);

	КонецЕсли;

	ДобавитьЗначенияПоляССоединениямиВЗапросРеквизитовОбъекта(ТекстЗапроса, ИмяРеквизита, Поле);

	Возврат ЗначенияПараметров;

КонецФункции

Функция ПолучитьТекстЗапросаРеквизитовОбъекта_ПоТипамПолей(ТекстЗапроса, ТипыПоля, ЭтоGUID,
	ИмяРеквизита, ИндексОператора, ШаблонВыбора, ЗначенияПараметров, ЗначениеПараметра)
	
	мВыбора = Новый Массив;
	мВыбора.Добавить("ВЫБОР");
	
	Для Каждого ТипПоля Из ТипыПоля Цикл
		ЭтоСсылка = пбп_Переадресация.ЭтоСсылка(ТипПоля);
		
		Если ЭтоСсылка Тогда
			ИмяТаблицы = Метаданные.НайтиПоТипу(ТипПоля).ПолноеИмя();
			
			Менеджер = пбп_Переадресация.МенеджерОбъектаПоПолномуИмени(ИмяТаблицы);
		КонецЕсли;
		
		Если ЭтоСсылка И Не ЭтоGUID Тогда
			Если ЗначениеЗаполнено(ЗначениеПараметра) Тогда
				ЗначениеПараметра = Менеджер[ЗначениеПараметра];
			Иначе
				ЗначениеПараметра = Менеджер.ПустаяСсылка();
			КонецЕсли;
		ИначеЕсли ЭтоСсылка Тогда
			Поле = ДополнитьЗапросСсылочнымПолемКонкатенация(ТекстЗапроса,
				ИмяРеквизита, ИмяТаблицы, "ВТ_Данные", 1, ИндексОператора, Ложь);
			
			Поле = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонВыбора, Поле);
			мВыбора.Добавить(Поле);
		КонецЕсли;
	КонецЦикла;
	
	ЗначенияПараметров.Вставить(ИмяРеквизита, ЗначениеПараметра);
	
	мВыбора.Добавить("КОНЕЦ");
	
	Поле = СтрСоединить(мВыбора, Символы.ПС);
	
	Возврат Поле;
	
КонецФункции

Функция ПолучитьТекстЗапросаРеквизитовОбъекта_ПоПолямПоиска(ТекстЗапроса, КонтекстЗаполнения,
	ПоляПоиска, ОбъектXDTO, ИмяРеквизита, ИндексОператора, ПроверяемыйТип, ЗначенияПараметров, ЗначениеПараметра)

	ОписаниеПоля = Новый Структура;
	ОписаниеПоля.Вставить("ИмяРеквизита", ИмяРеквизита);
	ОписаниеПоля.Вставить("ИмяИзИсточника", ИмяРеквизита);
	ОписаниеПоля.Вставить("ПроверяемыйТип", ПроверяемыйТип);
	ОписаниеПоля.Вставить("ПоляПоиска", ПоляПоиска);
	ОписаниеПоля.Вставить("ЗначениеПараметра", ЗначениеПараметра);
	ОписаниеПоля.Вставить("СоответствиеПолейПоиска",
		КонтекстЗаполнения.СоответствиеПолейИсточникаИПриемника[ИмяРеквизита]);
	ОписаниеПоля.Вставить("ИндексОператора", ИндексОператора);
	ОписаниеПоля.Вставить("ПроверятьНаNull", Истина);
	ОписаниеПоля.Вставить("Реквизит", Неопределено);
	ОписаниеПоля.Вставить("ОбъектXDTO", ОбъектXDTO);

	ПриемникЗначений = Новый Структура("ЗначенияПараметров", ЗначенияПараметров);

	Возврат ВыражениеПоПолямПоиска(ТекстЗапроса, ОписаниеПоля, "ВТ_Данные", ПриемникЗначений, "Неопределено");

КонецФункции

Функция ПолучитьТекстЗапросаРеквизитовОбъекта_ПоУмолчанию(ТекстЗапроса, ЭтоGUID,
	ИмяРеквизита, ИндексОператора, ПроверяемыйТип, ЗначенияПараметров, ЗначениеПараметра)

	ЭтоСсылка = пбп_Переадресация.ЭтоСсылка(ПроверяемыйТип);
	ИмяТаблицы = "";
	МетаданныеОбъект = Неопределено;

	Если ЭтоСсылка Тогда

		МетаданныеОбъект = Метаданные.НайтиПоТипу(ПроверяемыйТип);
		ИмяТаблицы = МетаданныеОбъект.ПолноеИмя();

	КонецЕсли;

	Если ЭтоСсылка И Не ЭтоGUID Тогда

		ЗначениеПараметра = ЗначениеПараметраИзXDTO(ЗначениеПараметра, Ложь, МетаданныеОбъект);
		Поле = "ВТ_Данные." + ИмяРеквизита;

	ИначеЕсли Не ЭтоСсылка Тогда

		ЗначениеПараметра = ЗначениеПараметраИзXDTO(ЗначениеПараметра, Ложь);
		Поле = "ВТ_Данные." + ИмяРеквизита;

	Иначе

		Поле = ДополнитьЗапросСсылочнымПолемКонкатенация(ТекстЗапроса,
			ИмяРеквизита, ИмяТаблицы, "ВТ_Данные", 1, ИндексОператора);

	КонецЕсли;

	ЗначенияПараметров.Вставить(ИмяРеквизита, ЗначениеПараметра);

	Возврат Поле;

КонецФункции

Функция ДополнитьЗапросСсылочнымПолем(ТекстЗапроса, ИмяРеквизита, ИмяТаблицы,
		ПсевдонимИсточника,
		ИндексЗапросаВПакете,
		ИндексОператора,
		ПроверятьНаNull = Истина)
	
	ШаблонСсылочногоПоля = "ЕСТЬNULL(%1.Ссылка, ЗНАЧЕНИЕ(%2.ПустаяССылка))";
	
	ШаблонСоединения = "(УНИКАЛЬНЫЙИДЕНТИФИКАТОР(%1.Ссылка) = %2.%3)";
	
	Части = СтрРазделить(ИмяТаблицы, ".");
	
	ПсевдонимТаблицы = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку("%1_%2", Части[1], ИмяРеквизита);
	Поле = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
		ШаблонСсылочногоПоля,
		ПсевдонимТаблицы,
		ИмяТаблицы);
	Если Не ПроверятьНаNull Тогда
		ШаблонСсылочногоПоля = "%1.Ссылка";
		Поле = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
			ШаблонСсылочногоПоля,
			ПсевдонимТаблицы);
	КонецЕсли;
	
	ОписаниеТаблицы = 
		пбп_СхемыЗапросов.ОписаниеТаблицы(
			Тип("ТаблицаСхемыЗапроса"),
			ИмяТаблицы,
			ПсевдонимТаблицы,
			"Ссылка");
	
	Условие = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
		ШаблонСоединения, ПсевдонимТаблицы, ПсевдонимИсточника, ИмяРеквизита);
	ОписаниеСоединения =
		пбп_СхемыЗапросов.ОписаниеСоединения(
			ОписаниеТаблицы,
			Условие,
			ТипСоединенияСхемыЗапроса.ЛевоеВнешнее);
	
	ТекстЗапроса =
		пбп_СхемыЗапросов.ДобавитьСоединениеВЗапрос(
			ТекстЗапроса,
			ПсевдонимИсточника,
			ОписаниеСоединения,
			ИндексЗапросаВПакете);
			
	Возврат Поле;
	
КонецФункции

Функция ДополнитьЗапросСсылочнымПолемКонкатенация(ТекстЗапроса, ИмяРеквизита, ИмяТаблицы,
		ПсевдонимИсточника,
		ИндексЗапросаВПакете,
		ИндексОператора,
		ПроверятьНаNull = Истина,
		ТипДанных = Неопределено)
	
	ШаблонСсылочногоПоля = "ЕСТЬNULL(%1.Ссылка, ЗНАЧЕНИЕ(%2.ПустаяССылка))";
	
	ШаблонСоединения = "(УНИКАЛЬНЫЙИДЕНТИФИКАТОР(%1.Ссылка) = %2.%3)";
	
	Части = СтрРазделить(ИмяТаблицы, ".");
	
	ПсевдонимТаблицы = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку("%1_%2", Части[1], ИмяРеквизита);
	Поле = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
		ШаблонСсылочногоПоля,
		ПсевдонимТаблицы,
		ИмяТаблицы);
	Если Не ПроверятьНаNull Тогда
		ШаблонСсылочногоПоля = "%1.Ссылка";
		Поле = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
			ШаблонСсылочногоПоля,
			ПсевдонимТаблицы);
	КонецЕсли;
	
	ОписаниеТаблицы = 
		пбп_СхемыЗапросов.ОписаниеТаблицы(
			Тип("ТаблицаСхемыЗапроса"),
			ИмяТаблицы,
			ПсевдонимТаблицы,
			"Ссылка");
	
	Условие = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
		ШаблонСоединения, ПсевдонимТаблицы, ПсевдонимИсточника, ИмяРеквизита);
	ОписаниеСоединения =
		пбп_СхемыЗапросов.ОписаниеСоединения(
			ОписаниеТаблицы,
			Условие,
			ТипСоединенияСхемыЗапроса.ЛевоеВнешнее);
	
	//ТекстЗапроса =
	//	пбп_СхемыЗапросов.ДобавитьСоединениеВЗапрос(
	//		ТекстЗапроса,
	//		ПсевдонимИсточника,
	//		ОписаниеСоединения,
	//		ИндексОператора,
	//		ИндексЗапросаВПакете);
			
	// добавим соединение Конкатенацией, т.к у схемы есть баг при большом количестве соединений (Противоречивая связь)
	СоединениеТаблицы = СтрШаблон("%1 %2 КАК %3",
		ТипСоединенияСтрокой(ОписаниеСоединения.ТипСоединения),
		ОписаниеСоединения.ОписаниеТаблицы.ИмяТаблицы,
		ОписаниеСоединения.ОписаниеТаблицы.ПсевдонимТаблицы);
	
	УсловиеСоединения = СтрШаблон("ПО %1", ОписаниеСоединения.Условие);
	
	МассивСоединения = Новый Массив;
	МассивСоединения.Добавить(ТекстЗапроса);
	МассивСоединения.Добавить(СоединениеТаблицы);
	МассивСоединения.Добавить(УсловиеСоединения);
	
	// доп условие на заполненность строки
	Если Не ТипДанных = Неопределено
		И ТипДанных = Тип("Строка") Тогда
		
		МассивСоединения.Добавить(
			СтрШаблон(
				"И НЕ %1.%2 = """"",
				ОписаниеСоединения.ОписаниеТаблицы.ПсевдонимТаблицы,
				ИмяРеквизита
			)
		);
	КонецЕсли;
	
	ТекстЗапроса = СтрСоединить(МассивСоединения, Символы.ПС);
	
	Возврат Поле;
	
КонецФункции

Функция ДополнитьЗапросПоПолюПоиска(ТекстЗапроса, ИмяПоляОсновное, ИмяПоляПоиска, ИмяТаблицы,
		ПсевдонимИсточника,
		ИндексЗапросаВПакете,
		ИндексОператора,
		ПроверятьНаNull = Истина)
	
	ШаблонСсылочногоПоля = "ЕСТЬNULL(%1.Ссылка, ЗНАЧЕНИЕ(%2.ПустаяССылка))";
	
	ДлинаСтроки = ДлинаСтрокиПоляПоиска(ИмяТаблицы, ИмяПоляПоиска);
	ШаблонСоединения = ШаблонСоединенияПоПолюПоиска(ДлинаСтроки);
	
	Части = СтрРазделить(ИмяТаблицы, ".");
	
	ПсевдонимТаблицы = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
		"%1_%2_%3", Части[1], ИмяПоляОсновное, СтрЗаменить(ИмяПоляПоиска, ".","_"));
	Поле = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
		ШаблонСсылочногоПоля,
		ПсевдонимТаблицы,
		ИмяТаблицы);
	Если Не ПроверятьНаNull Тогда
		ШаблонСсылочногоПоля = "%1.Ссылка";
		Поле = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
			ШаблонСсылочногоПоля,
			ПсевдонимТаблицы);
	КонецЕсли;
	
	ОписаниеТаблицы = 
		пбп_СхемыЗапросов.ОписаниеТаблицы(
			Тип("ТаблицаСхемыЗапроса"),
			ИмяТаблицы,
			ПсевдонимТаблицы,
			"Ссылка," + ИмяПоляПоиска);
	
	Условие = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
		ШаблонСоединения,
		ПсевдонимТаблицы,
		ИмяПоляПоиска,
		ПсевдонимИсточника,
		ИмяПоляОсновное,
		Формат(ДлинаСтроки, "ЧГ=0"));
	ОписаниеСоединения =
		пбп_СхемыЗапросов.ОписаниеСоединения(
			ОписаниеТаблицы,
			Условие,
			ТипСоединенияСхемыЗапроса.ЛевоеВнешнее);
	
	ТекстЗапроса =
		пбп_СхемыЗапросов.ДобавитьСоединениеВЗапрос(
			ТекстЗапроса,
			ПсевдонимИсточника,
			ОписаниеСоединения,
			ИндексЗапросаВПакете);
			
	Возврат Поле;
	
КонецФункции

Функция ДополнитьЗапросПоПолюПоискаКонкатенация(ТекстЗапроса, ИмяПоляОсновное, ИмяПоляПоиска, ИмяТаблицы,
		ПсевдонимИсточника,
		ИндексЗапросаВПакете,
		ИндексОператора,
		ПроверятьНаNull = Истина)
	
	Если Не ИмяПоляДопустимо(ИмяПоляОсновное)
		Или Не ИмяПоляДопустимо(ИмяПоляПоиска)
		Или Не ИмяПоляЕстьВМетаданных(ИмяТаблицы, ИмяПоляПоиска) Тогда
		
		Возврат "Неопределено";
		
	КонецЕсли;
	
	ШаблонСсылочногоПоля = "ЕСТЬNULL(%1.Ссылка, ЗНАЧЕНИЕ(%2.ПустаяССылка))";
	ДлинаСтроки = ДлинаСтрокиПоляПоиска(ИмяТаблицы, ИмяПоляПоиска);
	
	ШаблонСоединения = ШаблонСоединенияПоПолюПоиска(ДлинаСтроки);
	
	Части = СтрРазделить(ИмяТаблицы, ".");
	
	ПсевдонимТаблицы = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
		"%1_%2_%3", Части[1], ИмяПоляОсновное, ИмяПоляПоиска);
	Поле = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
		ШаблонСсылочногоПоля,
		ПсевдонимТаблицы,
		ИмяТаблицы);
	Если Не ПроверятьНаNull Тогда
		ШаблонСсылочногоПоля = "%1.Ссылка";
		Поле = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
			ШаблонСсылочногоПоля,
			ПсевдонимТаблицы);
	КонецЕсли;
	
	ОписаниеТаблицы = 
		пбп_СхемыЗапросов.ОписаниеТаблицы(
			Тип("ТаблицаСхемыЗапроса"),
			ИмяТаблицы,
			ПсевдонимТаблицы,
			"Ссылка," + ИмяПоляПоиска);
	
	Условие = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
		ШаблонСоединения,
		ПсевдонимТаблицы,
		ИмяПоляПоиска,
		ПсевдонимИсточника,
		ИмяПоляОсновное,
		Формат(ДлинаСтроки, "ЧГ=0"));
		
	ОписаниеСоединения =
		пбп_СхемыЗапросов.ОписаниеСоединения(
			ОписаниеТаблицы,
			Условие,
			ТипСоединенияСхемыЗапроса.ЛевоеВнешнее);
	
	// добавим соединение Конкатенацией, т.к у схемы есть баг при большом количестве соединений (Противоречивая связь)
	СоединениеТаблицы = СтрШаблон("%1 %2 КАК %3",
		ТипСоединенияСтрокой(ОписаниеСоединения.ТипСоединения),
		ОписаниеСоединения.ОписаниеТаблицы.ИмяТаблицы,
		ОписаниеСоединения.ОписаниеТаблицы.ПсевдонимТаблицы);
	
	УсловиеСоединения = СтрШаблон("ПО %1", ОписаниеСоединения.Условие);
	
	МассивСоединения = Новый Массив;
	МассивСоединения.Добавить(ТекстЗапроса);
	МассивСоединения.Добавить(СоединениеТаблицы);
	МассивСоединения.Добавить(УсловиеСоединения);
	
	// доп условие на заполненность строки
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ОписаниеСоединения.ОписаниеТаблицы.ИмяТаблицы);
	ПараметрыРеквизита = ОбъектМетаданных.Реквизиты.Найти(ИмяПоляПоиска);
	Если Не ПараметрыРеквизита = Неопределено
		И ПараметрыРеквизита.Тип.Типы().Количество() = 1
		И ПараметрыРеквизита.Тип.Типы()[0] = Тип("Строка") Тогда
		
		МассивСоединения.Добавить(
			СтрШаблон(
				"И НЕ %1.%2 = """"",
				ОписаниеСоединения.ОписаниеТаблицы.ПсевдонимТаблицы,
				ИмяПоляПоиска
			)
		);
	КонецЕсли;
	
	ТекстЗапроса = СтрСоединить(МассивСоединения, Символы.ПС);
	
	Возврат Поле;
	
КонецФункции

Функция ЭтоГруппаПолейПоиска(Элемент)
	
	Возврат ТипЗнч(Элемент) = Тип("Структура")
		И Элемент.Свойство("Тип")
		И Элемент.Тип = "ГруппаПолейПоиска"
		И Элемент.Свойство("Поля")
		И ТипЗнч(Элемент.Поля) = Тип("Массив");
	
КонецФункции

Процедура ДобавитьИмяВГруппуПолейПоиска(ИменаПолей, ИмяПоля)
	
	Если ТипЗнч(ИмяПоля) <> Тип("Строка") Или Не ЗначениеЗаполнено(ИмяПоля) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если ИменаПолей.Найти(ИмяПоля) = Неопределено Тогда
		
		ИменаПолей.Добавить(ИмяПоля);
		
	КонецЕсли;
	
КонецПроцедуры

Функция ИмяПоляЯвляетсяИдентификаторомПоиска(ИмяПоля)
	
	Возврат ИмяПоля = ИмяПоляПоискаПоВнешнемуИдентификатору()
		Или ИмяПоля = ИмяПоляПоискаПоВнутреннемуИдентификатору();
	
КонецФункции

Функция ГруппаПолейПоискаДопустима(ИменаПолей, ПолноеИмяТаблицы)
	
	Если ИменаПолей.Количество() = 0 Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		
		Если ИмяПоляЯвляетсяИдентификаторомПоиска(ИмяПоля)
			Или Не ИмяПоляДопустимо(ИмяПоля)
			Или Не ИмяПоляЕстьВМетаданных(ПолноеИмяТаблицы, ИмяПоля) Тогда
			
			Возврат Ложь;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция КлючГруппыПолейПоиска(ИменаПолей)
	
	Возврат СтрСоединить(ИменаПолей, "+");
	
КонецФункции

Функция РеквизитПоискаЯвляетсяСтрокой(ПолноеИмяТаблицы, ИмяПоля)
	
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмяТаблицы);
	
	Если ОбъектМетаданных = Неопределено Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	ИмяРеквизита = СтрРазделить(ИмяПоля, ".", Ложь)[0];
	Реквизит = ОбъектМетаданных.Реквизиты.Найти(ИмяРеквизита);
	
	Если Реквизит = Неопределено Тогда
		
		Для Каждого СтандартныйРеквизит Из ОбъектМетаданных.СтандартныеРеквизиты Цикл
			
			Если СтандартныйРеквизит.Имя = ИмяРеквизита Тогда
				
				Реквизит = СтандартныйРеквизит;
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если Реквизит = Неопределено Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Возврат Реквизит.Тип.Типы().Количество() = 1
		И Реквизит.Тип.Типы()[0] = Тип("Строка");
	
КонецФункции

Функция ДлинаСтрокиПоляПоиска(ИмяТаблицы, ИмяПоляПоиска)
	
	ЧастиИмени = СтрРазделить(ИмяПоляПоиска, ".", Ложь);
	
	Если ЧастиИмени.Количество() = 0 Тогда
		
		Возврат 0;
		
	КонецЕсли;
	
	ИмяРеквизита = ЧастиИмени[0];
	
	Если ИмяРеквизита = "ИмяПредопределенныхДанных" Тогда
		
		Возврат 255;
		
	КонецЕсли;
	
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ИмяТаблицы);
	
	Если ОбъектМетаданных = Неопределено Тогда
		
		Возврат 0;
		
	КонецЕсли;
	
	Реквизит = ОбъектМетаданных.Реквизиты.Найти(ИмяРеквизита);
	
	Если Реквизит = Неопределено
		И (ИмяРеквизита = "Код" Или ИмяРеквизита = "Наименование") Тогда
		
		Для Каждого СтандартныйРеквизит Из ОбъектМетаданных.СтандартныеРеквизиты Цикл
			
			Если СтандартныйРеквизит.Имя = ИмяРеквизита Тогда
				
				Реквизит = СтандартныйРеквизит;
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если Реквизит = Неопределено Тогда
		
		Возврат 0;
		
	КонецЕсли;
	
	Если Реквизит.Тип.Типы().Количество() <> 1
		Или Реквизит.Тип.Типы()[0] <> Тип("Строка") Тогда
		
		Возврат 0;
		
	КонецЕсли;
	
	ДлинаСтроки = Реквизит.Тип.КвалификаторыСтроки.Длина;
	
	Если ДлинаСтроки > 0 Тогда
		
		Возврат ДлинаСтроки;
		
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

Функция ШаблонСоединенияПоПолюПоиска(ДлинаСтроки)
	
	Если ДлинаСтроки = 0 Тогда
		
		Возврат "(%1.%2 = %3.%4)";
		
	КонецЕсли;
	
	Возврат "(%1.%2 = ВЫРАЗИТЬ(%3.%4 КАК СТРОКА(%5)))";
	
КонецФункции

Функция СсылкаПредопределенногоПоИмени(ИмяТаблицы, ИмяПредопределенного)
	
	ПустаяСсылка = ПустаяСсылкаТаблицы(ИмяТаблицы);
	
	Если ТипЗнч(ИмяПредопределенного) <> Тип("Строка") Тогда
		
		Возврат ПустаяСсылка;
		
	КонецЕсли;
	
	Имя = СокрЛП(ИмяПредопределенного);
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ИмяТаблицы);
	
	Если ОбъектМетаданных = Неопределено Или Не ЗначениеЗаполнено(Имя) Тогда
		
		Возврат ПустаяСсылка;
		
	КонецЕсли;
	
	Если ОбъектМетаданных.ПолучитьИменаПредопределенных().Найти(Имя) = Неопределено Тогда
		
		Возврат ПустаяСсылка;
		
	КонецЕсли;
	
	Возврат ПредопределенноеЗначение(ИмяТаблицы + "." + Имя);
	
КонецФункции

Функция ПустаяСсылкаТаблицы(ИмяТаблицы)
	
	ЧастиИмени = СтрРазделить(ИмяТаблицы, ".", Ложь);
	
	Если ЧастиИмени.Количество() < 2 Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	ИмяОбъекта = ЧастиИмени[1];
	
	Если ЧастиИмени[0] = "Справочник" Тогда
		
		Возврат Справочники[ИмяОбъекта].ПустаяСсылка();
		
	ИначеЕсли ЧастиИмени[0] = "ПланВидовХарактеристик" Тогда
		
		Возврат ПланыВидовХарактеристик[ИмяОбъекта].ПустаяСсылка();
		
	ИначеЕсли ЧастиИмени[0] = "ПланСчетов" Тогда
		
		Возврат ПланыСчетов[ИмяОбъекта].ПустаяСсылка();
		
	ИначеЕсли ЧастиИмени[0] = "ПланВидовРасчета" Тогда
		
		Возврат ПланыВидовРасчета[ИмяОбъекта].ПустаяСсылка();
		
	ИначеЕсли ЧастиИмени[0] = "ПланОбмена" Тогда
		
		Возврат ПланыОбмена[ИмяОбъекта].ПустаяСсылка();
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;
	
КонецФункции

Функция ДополнитьЗапросПоГруппеПолейПоиска(ТекстЗапроса, ПоляГруппы, ИмяТаблицы,
	ПсевдонимИсточника, ПроверятьНаNull = Истина, ИмяРеквизита = "")
	
	ИменаПолейПоиска = Новый Массив;
	
	Для Каждого ОписаниеПоляГруппы Из ПоляГруппы Цикл
		
		Если Не ИмяПоляДопустимо(ОписаниеПоляГруппы.ИмяПоляИсточника) Тогда
			
			Возврат "Неопределено";
			
		КонецЕсли;
		
		ИменаПолейПоиска.Добавить(ОписаниеПоляГруппы.ИмяПоляПоиска);
		
	КонецЦикла;
	
	Если Не ГруппаПолейПоискаДопустима(ИменаПолейПоиска, ИмяТаблицы) Тогда
		
		Возврат "Неопределено";
		
	КонецЕсли;
	
	Части = СтрРазделить(ИмяТаблицы, ".");
	
	Если ЗначениеЗаполнено(ИмяРеквизита) Тогда
		
		ПсевдонимТаблицы = Части[1] + "_" + ИмяРеквизита;
		
	Иначе
		
		ПсевдонимТаблицы = Части[1] + "_" + СтрСоединить(ИменаПолейПоиска, "_");
		
	КонецЕсли;
	
	ПсевдонимТаблицы = СтрЗаменить(ПсевдонимТаблицы, ".", "_");
	
	Если ПроверятьНаNull Тогда
		
		Поле = СтрШаблон(
			"ЕСТЬNULL(%1.Ссылка, ЗНАЧЕНИЕ(%2.ПустаяСсылка))", ПсевдонимТаблицы, ИмяТаблицы);
		
	Иначе
		
		Поле = ПсевдонимТаблицы + ".Ссылка";
		
	КонецЕсли;
	
	Условия = Новый Массив;
	
	Для Каждого ОписаниеПоляГруппы Из ПоляГруппы Цикл
		
		Условия.Добавить(СтрШаблон(
			"(%1.%2 = %3.%4)",
			ПсевдонимТаблицы,
			ОписаниеПоляГруппы.ИмяПоляПоиска,
			ПсевдонимИсточника,
			ОписаниеПоляГруппы.ИмяПоляИсточника));
		
	КонецЦикла;
	
	Условие = "(" + СтрСоединить(Условия, " И ") + ")";
	СоединениеТаблицы = СтрШаблон(
		"%1 %2 КАК %3",
		ТипСоединенияСтрокой(ТипСоединенияСхемыЗапроса.ЛевоеВнешнее),
		ИмяТаблицы,
		ПсевдонимТаблицы);
	
	МассивСоединения = Новый Массив;
	МассивСоединения.Добавить(ТекстЗапроса);
	МассивСоединения.Добавить(СоединениеТаблицы);
	МассивСоединения.Добавить(СтрШаблон("ПО %1", Условие));
	
	Для Каждого ИмяПоляПоиска Из ИменаПолейПоиска Цикл
		
		Если РеквизитПоискаЯвляетсяСтрокой(ИмяТаблицы, ИмяПоляПоиска) Тогда
			
			МассивСоединения.Добавить(СтрШаблон(
				"И НЕ %1.%2 = """"",
				ПсевдонимТаблицы,
				ИмяПоляПоиска));
			
		КонецЕсли;
		
	КонецЦикла;
	
	ТекстЗапроса = СтрСоединить(МассивСоединения, Символы.ПС);
	
	Возврат Поле;
	
КонецФункции

Функция ДобавитьРеквизитСоставногоТипыВЗапросТЧ(КоллекцияXDTO, ТЗ, ТекстЗапроса,
	СтруктураПоля,
	ИмяИзИсточника,
	ТипыПоля,
	Реквизит,
	СоответствиеПоТЧ,
	СоответствиеПолей,
	СоответствиеТиповПолей)

	ШаблонВыбора = "КОГДА НЕ %1 ЕСТЬ NULL ТОГДА
	|%1";
	ШаблонКонцаВыбора = "ИНАЧЕ ДанныеТЧ.%1
	|КОНЕЦ";
	ШаблонКонцаВыбораСтрока = "ИНАЧЕ ВЫРАЗИТЬ(ДанныеТЧ.%1 КАК СТРОКА(1024))
	|КОНЕЦ";

	МассивТипов = Новый Массив;
	мВыбора = Новый Массив;
	мВыбора.Добавить("ВЫБОР");

	Для Каждого ПроверяемыйТип Из ТипыПоля Цикл

		ЭтоСсылка = пбп_Переадресация.ЭтоСсылка(ПроверяемыйТип);
		Мета = Неопределено;

		Если ЭтоСсылка Тогда

			Мета = Метаданные.НайтиПоТипу(ПроверяемыйТип);
			СтруктураПоля.Мета = Мета;

		КонецЕсли;

		Если Мета <> Неопределено И ОбъектМетаданныхЯвляетсяПеречислением(Мета) Или Не ЭтоСсылка Тогда

			Поле = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку("ДанныеТЧ.%1", ИмяИзИсточника);

		Иначе

			Если СтруктураПоля.ЭтоGUID Тогда

				ЛокальныеПоляПоиска = пбп_ПереадресацияКлиентСервер.ЗначениеВМассиве(
					ИмяПоляПоискаПоВнутреннемуИдентификатору());

			Иначе

				ЛокальныеПоляПоиска = ОпределитьПоляПоискаПоТипуРеквизита(ПроверяемыйТип);

			КонецЕсли;
			ДанныеДобавленногоПоля = ДобавитьРеквизитВЗапросТЧ(КоллекцияXDTO, ТЗ, ТекстЗапроса,
				СтруктураПоля,
				ИмяИзИсточника,
				ПроверяемыйТип,
				ЛокальныеПоляПоиска,
				Реквизит,
				СоответствиеПоТЧ,
				СоответствиеПолей,
				СоответствиеТиповПолей);
			Поле = ДанныеДобавленногоПоля.Поле;
			Поле = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонВыбора, Поле);
			мВыбора.Добавить(Поле);

			Если Не ДанныеДобавленногоПоля.ТипКолонки = Неопределено Тогда

				Для Каждого ТекущийТип Из ДанныеДобавленногоПоля.ТипКолонки.Типы() Цикл

					Если МассивТипов.Найти(ТекущийТип) = Неопределено Тогда

						МассивТипов.Добавить(ТекущийТип);

					КонецЕсли;

				КонецЦикла;

			КонецЕсли;

		КонецЕсли;

	КонецЦикла;

	ТипКолонки = Новый ОписаниеТипов(МассивТипов);

	Если мВыбора.Количество() > 1 Тогда

		// Иначе с колонкой УникальныйИдентификатор ломает тип ВЫБОР: ссылка в результате становится пустой.
		Поле = "ИНАЧЕ NULL
		|КОНЕЦ";

	ИначеЕсли МассивТипов.Количество() = 1
		И МассивТипов[0] = Тип("Строка") Тогда

		Поле = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонКонцаВыбораСтрока, ИмяИзИсточника);

	Иначе

		Поле = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонКонцаВыбора, ИмяИзИсточника);

	КонецЕсли;

	мВыбора.Добавить(Поле);
	Поле = СтрСоединить(мВыбора, Символы.ПС);
	СоответствиеТиповПолей.Вставить(ИмяИзИсточника, ТипКолонки);

	СтруктураРеквизита = Новый Структура;
	СтруктураРеквизита.Вставить("Поле", Поле);
	СтруктураРеквизита.Вставить("ТипКолонки", ТипКолонки);

	Возврат СтруктураРеквизита;

КонецФункции

Функция ДобавитьРеквизитВЗапросТЧ(КоллекцияXDTO, ТЗ, ТекстЗапроса,
	СтруктураПоля,
	ИмяИзИсточника,
	ПроверяемыйТип,
	ПоляПоиска,
	Реквизит,
	СоответствиеПоТЧ,
	СоответствиеПолей,
	СоответствиеТиповПолей,
	ПроверятьНаNull = Ложь)

	ЭтоСсылка = пбп_Переадресация.ЭтоСсылка(ПроверяемыйТип);
	Мета = Неопределено;

	Если ЭтоСсылка Тогда

		Мета = Метаданные.НайтиПоТипу(ПроверяемыйТип);
		СтруктураПоля.Мета = Мета;

	КонецЕсли;

	ТипКолонки = Неопределено;

	Если ПоляПоиска <> Неопределено Тогда

		ОписаниеПоля = Новый Структура;
		ОписаниеПоля.Вставить("ИмяРеквизита", Реквизит.Имя);
		ОписаниеПоля.Вставить("ИмяИзИсточника", ИмяИзИсточника);
		ОписаниеПоля.Вставить("ПроверяемыйТип", ПроверяемыйТип);
		ОписаниеПоля.Вставить("ПоляПоиска", ПоляПоиска);
		ОписаниеПоля.Вставить("ЗначениеПараметра", Неопределено);
		ОписаниеПоля.Вставить("СоответствиеПолейПоиска", СоответствиеПоТЧ[Реквизит.Имя]);
		ОписаниеПоля.Вставить("ИндексОператора", 0);
		ОписаниеПоля.Вставить("ПроверятьНаNull", ПроверятьНаNull);
		ОписаниеПоля.Вставить("Реквизит", Реквизит);
		ОписаниеПоля.Вставить("ОбъектXDTO", Неопределено);

		ПриемникЗначений = Новый Структура;
		ПриемникЗначений.Вставить("ТЗ", ТЗ);
		ПриемникЗначений.Вставить("СоответствиеПолей", СоответствиеПолей);
		ПриемникЗначений.Вставить("СоответствиеТиповПолей", СоответствиеТиповПолей);
		ПриемникЗначений.Вставить("КоллекцияXDTO", КоллекцияXDTO);
		ПриемникЗначений.Вставить("СоответствиеПоТЧ", СоответствиеПоТЧ);
		ПриемникЗначений.Вставить("ТипКолонки", Неопределено);

		Поле = ВыражениеПоПолямПоиска(ТекстЗапроса, ОписаниеПоля, "ДанныеТЧ", ПриемникЗначений, "NULL");
		ТипКолонки = ПриемникЗначений.ТипКолонки;

	ИначеЕсли Мета <> Неопределено И ОбъектМетаданныхЯвляетсяПеречислением(Мета)
		Или Не ЭтоСсылка Тогда

		Поле = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку("ДанныеТЧ.%1", ИмяИзИсточника);
		ТипКолонки = Реквизит.Тип;

	Иначе

		ТипКолонки = Новый ОписаниеТипов("УникальныйИдентификатор");
		Поле = ДополнитьЗапросСсылочнымПолемКонкатенация(
			ТекстЗапроса, ИмяИзИсточника, Мета.ПолноеИмя(), "ДанныеТЧ", 1, 0, ПроверятьНаNull);

	КонецЕсли;

	СтруктураРеквизита = Новый Структура;
	СтруктураРеквизита.Вставить("Поле", Поле);
	СтруктураРеквизита.Вставить("ТипКолонки", ТипКолонки);

	Возврат СтруктураРеквизита;

КонецФункции

Функция ОпределитьПоляПоискаПоТипуРеквизита(ТипПоля)

	Возврат ПоляПоискаПоУмолчанию(ТипПоля, Истина);

КонецФункции

Процедура ДобавитьПолеВыборкиВЗапрос(ТекстЗапроса, Выражение, ВыражениеПоля, ПолеЗапросаКлюча, КлючевоеПоле, СтрокаЗамены)
	
	Если СтрНачинаетсяС(ВыражениеПоля, "ЕСТЬNULL(")
		Или СтрНачинаетсяС(ВыражениеПоля, "ВЫРАЗИТЬ(") Тогда
		ШаблонПоля = "%1 КАК %2";
	Иначе
		ШаблонПоля = "Данные.%1 КАК %2";
	КонецЕсли;
	
	ТекстПоля = СтрШаблон(ШаблонПоля, ВыражениеПоля, Выражение.Псевдоним);
	
	// если поле уже добавлено в выборку, то не добавляем
	// при ручном объявлении полей могут случайно задублить
	Если Не СтрНайти(ТекстЗапроса, ТекстПоля) = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если КлючевоеПоле = Выражение.Значение Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ПолеЗапросаКлюча, ТекстПоля);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, СтрокаЗамены,
		",
		|	" + ТекстПоля + СтрокаЗамены);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПоляПоискаПоУмолчанию(ПоляПоиска, ЭтоGUID, ПроверяемыйТип)

	ПоляПоиска = ПоляПоискаПоУмолчанию(ПроверяемыйТип, ЭтоGUID);

КонецПроцедуры

Процедура ДобавитьПоляВЗапросПриЗагрузке(ТекстЗапроса, СписокПолей, ЭтоТЧ = Ложь)
	
	Для Каждого ПолеЗапроса Из СписокПолей Цикл
		ДобавитьПолеВЗапросПриЗагрузке(ТекстЗапроса,
			ПолеЗапроса.Значение, "ДанныеТЧ", ПолеЗапроса.Представление);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьПолеВЗапросПриЗагрузке(ТекстЗапроса, ВыражениеПоля, ИмяТаблицы = "", Представление = "")
	
	Если Не ПустаяСтрока(ИмяТаблицы) Тогда
		ЗаглушкаСтрока = ИмяТаблицы + ".ИмяТабличнойЧасти КАК ИмяТабличнойЧасти";
	Иначе
		ЗаглушкаСтрока = "&Заглушка КАК Заглушка";
	КонецЕсли;
	
	Если Не ПустаяСтрока(Представление) Тогда
		СинонимПоля = Представление;
	ИначеЕсли Не ПустаяСтрока(ИмяТаблицы) Тогда
		СинонимПоля = СтрЗаменить(ВыражениеПоля, ИмяТаблицы + ".", "");
	Иначе
		СинонимПоля = ВыражениеПоля;
	КонецЕсли;
	
	ПолеЗапроса = СтрШаблон("%1 КАК %2,
		|	%3",
		?(Не ПустаяСтрока(ИмяТаблицы), ВыражениеПоля, "&" + ВыражениеПоля),
		СинонимПоля,
		ЗаглушкаСтрока);
	
	Если Не СтрНайти(ТекстЗапроса, ПолеЗапроса) = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ЗаглушкаСтрока, ПолеЗапроса);
	
КонецПроцедуры

Процедура ДобавитьЗначенияПоляССоединениямиВЗапросРеквизитовОбъекта(ТекстЗапроса, ИмяРеквизита, Поле)
	
	ЗаглушкаСтрока = "ВЫБРАТЬ
	|	ВТ_Данные.Заглушка Как Заглушка,
	|	NULL КАК ИмяРеквизита,
	|	NULL КАК Значение
	|ИЗ
	|	ВТ_Данные КАК ВТ_Данные";
	
	РеквизитСтрокой = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку("""%1""", ИмяРеквизита);
	
	ТекстЗамены = СтрШаблон("ВЫБРАТЬ
	|	ВТ_Данные.Заглушка Как Заглушка,
	|	%1 КАК ИмяРеквизита,
	|	%2 КАК Значение
	|ИЗ
	|	ВТ_Данные КАК ВТ_Данные", РеквизитСтрокой, Поле);
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ЗаглушкаСтрока, ТекстЗамены);
	
КонецПроцедуры

Функция ТипСоединенияСтрокой(ТипСоединения)
	
	Если ТипСоединения = ТипСоединенияСхемыЗапроса.ПравоеВнешнее Тогда
		Возврат "ПРАВОЕ СОЕДИНЕНИЕ";
	ИначеЕсли ТипСоединения = ТипСоединенияСхемыЗапроса.Внутреннее Тогда
		Возврат "ВНУТРЕННЕЕ СОЕДИНЕНИЕ";
	ИначеЕсли ТипСоединения = ТипСоединенияСхемыЗапроса.ПолноеВнешнее Тогда
		Возврат "ПОЛНОЕ СОЕДИНЕНИЕ";
	КонецЕсли;
	
	Возврат "ЛЕВОЕ СОЕДИНЕНИЕ";
	
КонецФункции

