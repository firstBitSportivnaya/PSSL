#Область ПрограммныйИнтерфейс

#Область Логгирование

// Формирует и возвращает структуру записи истории интеграции для указанного интеграционного потока.
// При необходимости добавляет данные входящего сообщения в формате JSON и устанавливает параметры протоколирования.
//
// Параметры:
//  Поток						 - Строка - Идентификатор или объект интеграционного потока.
//  ОбъектXDTO					 - ОбъектXDTO, Неопределено - Данные обмена в формате XDTO (используются для входящего потока).
//  ЭтоВходящийПоток			 - Булево - Признак, что поток является входящим.
//  ГенерироватьПротокол		 - Булево - Признак необходимости генерации протокола обмена.
//  ЗаписыватьДанныеСообщения	 - Булево - Признак необходимости записи входящего сообщения.
// 
// Возвращаемое значение:
//  Структура - Заполненная структура истории интеграции, см.пбп_ИнтеграцииСлужебный.ПолучитьСтруктуруЗаписиИстории.
//
Функция ИнициализироватьСтруктуруЗаписиИсторииИнтеграции(Поток, СообщениеСтрокой = Неопределено,
	ЭтоВходящийПоток = Истина, ГенерироватьПротокол = Истина, ЗаписыватьДанныеСообщения = Истина) Экспорт
	
	ИнтеграционныйПоток = пбп_ИнтеграцииСервер.ИнтеграционныйПоток(Поток);
	
	Если Не ЗначениеЗаполнено(ИнтеграционныйПоток) Тогда
		ВызватьИсключение НСтр("ru = 'Не передан или не создан интеграционный поток.';");
	КонецЕсли;
	
	СтруктураИстории = пбп_ИнтеграцииСлужебный.ПолучитьСтруктуруЗаписиИстории();
	
	ИнтегрируемаяСистема = пбп_Переадресация.ЗначениеРеквизитаОбъекта(ИнтеграционныйПоток,
		"НастройкаИнтеграции.ИнтегрируемаяСистема");
	
	СтруктураИстории.ИнтеграционныйПоток = ИнтеграционныйПоток;
	
	Если ЭтоВходящийПоток И ЗаписыватьДанныеСообщения Тогда
		СтруктураИстории.ВходящееСообщение = СообщениеСтрокой;
	КонецЕсли;
	
	СтруктураИстории.ИнтегрируемаяСистема = ИнтегрируемаяСистема;
	СтруктураИстории.ФорматИнтеграции = Перечисления.пбп_ФорматыИнтеграций.JSON;
	СтруктураИстории.ГенерироватьПротокол = ГенерироватьПротокол;
	
	Возврат СтруктураИстории;
	
КонецФункции

// Сохраняет результат обработки интеграционного обмена в историю интеграции,
// включая текст ошибки (при наличии) и данные исходящего сообщения для исходящих потоков.
//
// Параметры:
//  СтруктураИстории	 - Структура - см.пбп_ИнтеграцииСлужебный.ПолучитьСтруктуруЗаписиИстории.
//  ТекстОшибки			 - Строка - Текстовое описание возникшей ошибки.
//  РезультатОбработки	 - Структура - тело исходящего сообщения в свойстве Body.
//  ЭтоВходящийПоток	 - Булево - Признак, что поток является входящим.
//
Процедура ЗаписатьРезультатВИсториюИнтеграции(СтруктураИстории, ТекстОшибки,
	РезультатОбработки = Неопределено, ЭтоВходящийПоток = Истина) Экспорт
	
	Если Не ЭтоВходящийПоток Тогда
		СтруктураИстории.ИсходящееСообщение = РезультатОбработки;
		СтруктураИстории.ГенерироватьПротокол = Ложь;
	КонецЕсли;
	
	СтруктураИстории.ОписаниеОшибки = ТекстОшибки;
	
	пбп_ИнтеграцииСлужебный.СоздатьСообщениеИсторииИнтеграции(СтруктураИстории);
	
КонецПроцедуры

#КонецОбласти // Логгирование

#Область Выгрузка

// Получает данные выгружаемого объекта
//
// Параметры:
//  ОбъектОбработки	 - ЛюбаяСсылка - Выгружаемый объект.
//  СоставПолей		 - Структура - см. КонструкторСоставаПолей.
// 
// Возвращаемое значение:
//  Структура - Данные объекта в виде структуры.
//
Функция ВыгрузитьВПлатформу(Знач ОбъектОбработки, СоставПолей,
	Узел = Неопределено, СтруктураИсторииИнтеграции = Неопределено) Экспорт
	
	ПространствоИмен = ИмяТаблицыПоСсылке(ОбъектОбработки);
	
	ТекстыЗапросов = Новый Массив;
	
	РеквизитыСостава = пбп_Переадресация.СкопироватьРекурсивно(СоставПолей.РеквизитыОбъекта.Реквизиты);
	ЭтоРегистр = ОбъектМетаданныхЯвляетсяРегистром(ОбъектОбработки.Метаданные());
	ОтборыРегистра = Новый Соответствие;
	Если ЭтоРегистр Тогда
		Для Каждого Отбор Из ОбъектОбработки.Отбор Цикл
			Если Не Отбор.Использование Тогда
				Продолжить;
			КонецЕсли;
			ОтборыРегистра.Вставить(Отбор.Имя, Отбор.Значение);
		КонецЦикла;
	Иначе
		Если Не СтруктураИсторииИнтеграции = Неопределено Тогда
			НовыйОбъект = СтруктураИсторииИнтеграции.ОбъектыИнтеграции.Добавить();
			НовыйОбъект.ОбъектИнтеграции = ОбъектОбработки;
		КонецЕсли;
	КонецЕсли;
	
	ТекстыЗапросов.Добавить(ТекстЗапросаРеквизитовОбъекта(ПространствоИмен,
		РеквизитыСостава, ЭтоРегистр, ОтборыРегистра));
	
	Для Каждого Имя Из СоставПолей.ПорядокТабличныхЧастей Цикл
		ТекстыЗапросов.Добавить(ТекстЗапросаРеквизитовТабличнойЧастиОбъекта(ПространствоИмен,
			СоставПолей.ТабличныеЧасти[Имя].Реквизиты,
			Имя));
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = СтрСоединить(ТекстыЗапросов, пбп_Переадресация.РазделительПакетаЗапросов());
	
	Если ЭтоРегистр Тогда
		Для Каждого КлючИЗначение Из ОтборыРегистра Цикл
			Запрос.УстановитьПараметр(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
	Иначе
		Запрос.УстановитьПараметр("Ссылка", ОбъектОбработки);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Узел", Узел);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	РезультатШапки = РезультатыЗапроса[0];
	
	Если РезультатШапки.Пустой() Тогда
		
		Данные = Новый Структура;
		
	Иначе
		
		ВыборкаШапки = РезультатШапки.Выбрать();
		ВыборкаШапки.Следующий();
		Данные = ДанныеВыборкиИзРезультатаЗапросаВСтруктуру(
			ВыборкаШапки, РезультатШапки.Колонки, СоставПолей.РеквизитыОбъекта);
		
	КонецЕсли;
	
	Для Сч = 1 По РезультатыЗапроса.ВГраница() Цикл
		
		Имя = СоставПолей.ПорядокТабличныхЧастей[Сч - 1];
		ДанныеТЧ = Новый Массив;
		РезультатТабличнойЧасти = РезультатыЗапроса[Сч];
		ВыборкаТабличнойЧасти = РезультатТабличнойЧасти.Выбрать();
		РеквизитыТабличнойЧасти = СоставПолей.ТабличныеЧасти[Имя];
		
		Пока ВыборкаТабличнойЧасти.Следующий() Цикл
			
			ДанныеТЧ.Добавить(ДанныеВыборкиИзРезультатаЗапросаВСтруктуру(
				ВыборкаТабличнойЧасти, РезультатТабличнойЧасти.Колонки, РеквизитыТабличнойЧасти));
			
		КонецЦикла;
		
		ИмяВыгрузки = Имя;
		СинонимыТабличныхЧастей = Неопределено;
		СинонимТабличнойЧасти = "";
		Если СоставПолей.Свойство("СинонимыТабличныхЧастей", СинонимыТабличныхЧастей)
			И СинонимыТабличныхЧастей.Свойство(Имя, СинонимТабличнойЧасти)
			И ЗначениеЗаполнено(СинонимТабличнойЧасти) Тогда
			
			ИмяВыгрузки = СинонимТабличнойЧасти;
			
		КонецЕсли;
		
		Данные.Вставить(ИмяВыгрузки, ДанныеТЧ);
		
	КонецЦикла;
	
	
	Возврат Данные;
	
КонецФункции

// Удаляет неиспользуемые реквизиты для обмена
//
// Параметры:
//  СоставПолей	 - Структура	 - Структура полей выгрузки
//
Процедура УдалитьНеиспользуемыеРеквизиты(СоставПолей, УдаляемыеРеквизиты = Неопределено) Экспорт
	
	Если Не ТипЗнч(СоставПолей) = Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если УдаляемыеРеквизиты = Неопределено Тогда
		МассивУдаляемыхТЧ = Новый Массив;
		МассивУдаляемыхРеквизитов = Новый Массив;
	Иначе
		Если УдаляемыеРеквизиты.Свойство("МассивУдаляемыхРеквизитов") Тогда
			МассивУдаляемыхРеквизитов = УдаляемыеРеквизиты.МассивУдаляемыхРеквизитов;
		Иначе
			МассивУдаляемыхРеквизитов = Новый Массив;
		КонецЕсли;
		
		Если УдаляемыеРеквизиты.Свойство("МассивУдаляемыхТЧ") Тогда
			МассивУдаляемыхТЧ = УдаляемыеРеквизиты.МассивУдаляемыхТЧ;
		Иначе
			МассивУдаляемыхТЧ = Новый Массив;
		КонецЕсли;
	КонецЕсли;
	
	Если СоставПолей.Свойство("РеквизитыОбъекта") Тогда
		РеквизитыОбъекта = СоставПолей.РеквизитыОбъекта;
	Иначе
		РеквизитыОбъекта = СоставПолей;
	КонецЕсли;
	
	ЕстьУдаленныйРеквизит = Ложь;
	Реквизиты = РеквизитыОбъекта.Реквизиты;
	Для ОбратныйИндекс = - Реквизиты.ВГраница() По 0 Цикл
		Индекс = - ОбратныйИндекс;
		Если СтрНайти(Реквизиты[Индекс].Имя, "Удалить") = 1 Тогда
			Реквизиты.Удалить(Индекс);
			ЕстьУдаленныйРеквизит = Истина;
		ИначеЕсли Не МассивУдаляемыхРеквизитов.Найти(Реквизиты[Индекс].Имя) = Неопределено Тогда
			Реквизиты.Удалить(Индекс);
			ЕстьУдаленныйРеквизит = Истина;
		КонецЕсли;
	КонецЦикла;
	
	ВложенныеПоля = РеквизитыОбъекта.ВложенныеПоля;
	КлючиКУдалению = Новый Массив;
	
	Для Каждого ЭлементСтруктуры Из ВложенныеПоля Цикл
		
		Если СтрНайти(ЭлементСтруктуры.Ключ, "Удалить") = 1
			Или МассивУдаляемыхРеквизитов.Найти(ЭлементСтруктуры.Ключ) <> Неопределено Тогда
			
			КлючиКУдалению.Добавить(ЭлементСтруктуры.Ключ);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого КлючКУдалению Из КлючиКУдалению Цикл
		
		ВложенныеПоля.Удалить(КлючКУдалению);
		
	КонецЦикла;
	
	Если ЕстьУдаленныйРеквизит Тогда
		Для Индекс = 0 По Реквизиты.ВГраница() Цикл
			ТекущийЭлемент = Реквизиты[Индекс];
			Если Не ЗначениеЗаполнено(ТекущийЭлемент.Синоним) Тогда
				Продолжить;
			КонецЕсли;
			
			Если ВложенныеПоля.Свойство(ТекущийЭлемент.Синоним) Тогда
				ВложенныеПоля[ТекущийЭлемент.Синоним] = Индекс;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если СоставПолей.Свойство("ТабличныеЧасти") Тогда
		
		ТабличныеЧасти = СоставПолей.ТабличныеЧасти;
		КлючиКУдалению = Новый Массив;
		
		Для Каждого ЭлементСтруктуры Из ТабличныеЧасти Цикл
			
			Если СтрНайти(ЭлементСтруктуры.Ключ, "Удалить") = 1
				Или МассивУдаляемыхТЧ.Найти(ЭлементСтруктуры.Ключ) <> Неопределено Тогда
				
				КлючиКУдалению.Добавить(ЭлементСтруктуры.Ключ);
				
			Иначе
				
				УдалитьНеиспользуемыеРеквизиты(ЭлементСтруктуры.Значение, УдаляемыеРеквизиты);
				
			КонецЕсли;
			
		КонецЦикла;
		
		Для Каждого КлючКУдалению Из КлючиКУдалению Цикл
			
			ТабличныеЧасти.Удалить(КлючКУдалению);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если СоставПолей.Свойство("ПорядокТабличныхЧастей") Тогда
		
		ПорядокТабличныхЧастей = СоставПолей.ПорядокТабличныхЧастей;
		Для ОбратныйИндекс = - ПорядокТабличныхЧастей.ВГраница() По 0 Цикл
			Индекс = - ОбратныйИндекс;
			Если СтрНайти(ПорядокТабличныхЧастей[Индекс], "Удалить") = 1 Тогда
				ПорядокТабличныхЧастей.Удалить(Индекс);
			ИначеЕсли Не МассивУдаляемыхТЧ.Найти(ПорядокТабличныхЧастей[Индекс]) = Неопределено Тогда
				ПорядокТабличныхЧастей.Удалить(Индекс);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти // Выгрузка

#Область Загрузка

// Инициализирует структуру хранения параметров обмена для загрузки сообщения
//
// Параметры:
//  Поток						 - Строка		 - идентификатор интеграционного потока, в рамках которого выполняется загрузка данных
//  Источник					 - Строка, ПланОбменаСсылка, СправочникСсылка.пбп_ИнтегрируемыеСистемы -
//                                 имя источника или уже найденная ссылка. В структуре сохраняется ссылка
//  Задержка					 - Число		 - время задержки перед повторной обработкой в случае блокировки
//  КоличествоПопытокОжидания	 - Число		 - количество попыток ожидания при блокировках
//  Функции						 - Соответствие	 - дополнительные функции, используемые в обработке
//  ТекстОшибки					 - Строка		 - текст ошибки, формируемый при возникновении исключений
//  СтруктураИстории			 - Структура	 - см.пбп_ИнтеграцииСлужебный.ПолучитьСтруктуруЗаписиИстории
//  УниверсальноеЗаполнение		 - Булево		 - признак использования универсального механизма заполнения
// 
// Возвращаемое значение:
//  Структура - заполненные параметры обмена:
//   * Источник - ПланОбменаСсылка, СправочникСсылка.пбп_ИнтегрируемыеСистемы - узел интеграции
//
Функция ИнициализироватьПараметрыОбмена(Поток, Источник, Задержка,
	КоличествоПопытокОжидания, Функции, ТекстОшибки, СтруктураИстории, УниверсальноеЗаполнение = Ложь) Экспорт
	
	ПараметрыОбмена = Новый Структура;
	ПараметрыОбмена.Вставить("Поток"					, Поток);
	ПараметрыОбмена.Вставить("Источник"					, УзелИнтеграцииПоИсточнику(Источник));
	ПараметрыОбмена.Вставить("Задержка"					, Задержка);
	ПараметрыОбмена.Вставить("КоличествоПопытокОжидания", КоличествоПопытокОжидания);
	ПараметрыОбмена.Вставить("Функции"					, Функции);
	ПараметрыОбмена.Вставить("ТекстОшибки"				, ТекстОшибки);
	ПараметрыОбмена.Вставить("СтруктураИстории"			, СтруктураИстории);
	ПараметрыОбмена.Вставить("УниверсальноеЗаполнение"	, УниверсальноеЗаполнение);
	
	Возврат ПараметрыОбмена;
	
КонецФункции

// Инициализирует структуру хранения параметров сообщения в процессе загрузки
//
// Параметры:
//  МенеджерОбъекта		 - МодульМенеджераОбъекта	 - менеджер метаданных, в котором выполняется поиск объекта
//  ОбъектXDTO			 - ОбъектXDTO				 - объект XDTO, содержащий данные для загрузки
//  Идентификатор		 - Строка					 - строковое значение идентификатора сообщения
//  СостояниеСообщения	 - Произвольный				 - состояние сообщения, его меняет вызывающий код
//  ОбменДаннымиЗагрузка - Булево					 - признак того, что загрузка выполняется в режиме ОбменДанными.Загрузка
//  НумерацияПриемника	 - Булево					 - признак нумерации приемника
// 
// Возвращаемое значение:
//  Структура - заполненные параметры сообщения:
//   * СсылкаЯвляетсяВнешнимИдентификатором - Булево - признак того, что ссылка
//       из сообщения является внешним идентификатором.
//
//   * СостояниеЗагрузки - Структура - состояние объекта в процессе загрузки:
//      ** ЭтоНовый - Булево - объект еще не записан в информационную базу.
//      ** БылПроведен - Булево - документ был проведен до заполнения из сообщения.
//      ** ТребуетсяПроведение - Булево - после заполнения документ нужно провести.
//
Функция ИнициализироватьПараметрыСообщения(МенеджерОбъекта, ОбъектXDTO, Идентификатор,
	СостояниеСообщения, ОбменДаннымиЗагрузка = Ложь, НумерацияПриемника = Истина) Экспорт
	
	ПараметрыСообщения = Новый Структура;
	ПараметрыСообщения.Вставить("МенеджерОбъекта"		, МенеджерОбъекта);
	ПараметрыСообщения.Вставить("ОбъектXDTO"			, ОбъектXDTO);
	ПараметрыСообщения.Вставить("Идентификатор"			, Идентификатор);
	ПараметрыСообщения.Вставить("СостояниеСообщения"	, СостояниеСообщения);
	ПараметрыСообщения.Вставить("ОбменДаннымиЗагрузка"	, ОбменДаннымиЗагрузка);
	ПараметрыСообщения.Вставить("НумерацияПриемника"	, НумерацияПриемника);
	ПараметрыСообщения.Вставить("СсылкаИзXDTO"			, "");
	ПараметрыСообщения.Вставить("ЭтоГруппа"				, Ложь);
	ПараметрыСообщения.Вставить("СсылкаЯвляетсяВнешнимИдентификатором", Ложь);
	ПараметрыСообщения.Вставить("СостояниеЗагрузки"		, НовоеСостояниеЗагрузки());
	
	Возврат ПараметрыСообщения;
	
КонецФункции

// Выполняет загрузку данных из XDTO-объекта в информационную базу 1С,
// создавая или обновляя соответствующий объект метаданных.
// Реализует транзакционную обработку, обработку ошибок и регистрацию результатов интеграции.
//
// Параметры:
//  ПараметрыОбмена		 - Структур	 - см. ИнициализироватьПараметрыОбмена
//  ПараметрыСообщения	 - Структур	 - см. ИнициализироватьПараметрыСообщения
//
// Возвращаемое значение:
//  ЛюбаяСсылка, Неопределено - ссылка записанного объекта. Неопределено, если сообщение
//   отложено из-за блокировки объекта.
//
Функция ЗагрузитьИзПлатформы(ПараметрыОбмена, ПараметрыСообщения) Экспорт
	
	ПараметрыСообщения.СостояниеЗагрузки = НовоеСостояниеЗагрузки();
	СостояниеЗагрузки = ПараметрыСообщения.СостояниеЗагрузки;
	
	Если ПараметрыСообщения.ОбъектXDTO = Неопределено Тогда
		
		ВызватьИсключение НСтр("ru = 'Тело сообщения пустое или его не удалось прочитать.';");
		
	КонецЕсли;
	
	ПараметрыСообщения.Вставить("МетаданныеОбъекта",
		ОпределитьМетаданныеОбъекта(ПараметрыСообщения.МенеджерОбъекта));
	
	КонтекстЗаполнения = КонтекстЗаполненияОбъектаПоОбъектуXDTO(ПараметрыОбмена.Поток);
	ДобавитьПоляНомерИКодВПоляИсключенияПоиска(КонтекстЗаполнения, ПараметрыСообщения.НумерацияПриемника);
	
	ОпределитьИдентификаторыСообщения(
		КонтекстЗаполнения.СоответствиеПолейИсточникаИПриемника,
		ПараметрыСообщения);
	
	ПравилаПоискаСсылки = ПолучитьПравилаПоискаСсылки(КонтекстЗаполнения, ПараметрыСообщения);
	
	ОбъектОбработки = Неопределено;
	Статус = Неопределено;
	СсылкаНаОбъект = Неопределено;
	
	// Блокировка идентификатора удерживается до записи объекта и публичного идентификатора.
	НачатьТранзакцию();
	Попытка
		
		ОбъектОбработки = ПолучитьОбъектОбработкиСБлокировкойИдентификатора(
			ПараметрыСообщения, ПараметрыОбмена.Источник, ПравилаПоискаСсылки);
		
		Если СостояниеЗагрузки.ЭтоНовый Тогда
			Статус = Перечисления.пбп_СозданОбновлен.Создан;
		Иначе
			Статус = Перечисления.пбп_СозданОбновлен.Обновлен;
		КонецЕсли;
		
		ЗаполнитьОбъектПоОбъектуXDTO(ОбъектОбработки, ПараметрыОбмена, ПараметрыСообщения, КонтекстЗаполнения);
		ПостобработкаОбъектаПоОбъектуXDTO(ОбъектОбработки, ПараметрыОбмена, ПараметрыСообщения);
		СсылкаНаОбъект = ЗаписатьСсылочныйЭлемент(ОбъектОбработки, ПараметрыОбмена, ПараметрыСообщения);
		
		НовыйОбъект = ПараметрыОбмена.СтруктураИстории.ОбъектыИнтеграции.Добавить();
		НовыйОбъект.ОбъектИнтеграции = СсылкаНаОбъект;
		НовыйОбъект.Идентификатор = ПараметрыСообщения.СсылкаИзXDTO;
		НовыйОбъект.СозданОбновлен = Статус;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		Если ОшибкаЗагрузкиТребуетПовтора(ОбъектОбработки, Статус, ПараметрыОбмена,
			ПараметрыСообщения, ИнформацияОбОшибке()) Тогда
			
			Возврат Неопределено;
			
		КонецЕсли;
		
		ВызватьИсключение ПараметрыОбмена.ТекстОшибки;
		
	КонецПопытки;
	
	// Проведение отдельно от записи: ошибка проведения не откатывает загрузку
	// и вызывается исключением после фиксации транзакции.
	ПровестиЗагруженныйДокумент(ОбъектОбработки, ПараметрыОбмена, ПараметрыСообщения, СостояниеЗагрузки);
	
	Возврат СсылкаНаОбъект;
	
КонецФункции

// Находит объект по идентификатору или создает новый и назначает ему ссылку.
// Запись выполняется вызывающим кодом в той же транзакции.
//
// Параметры:
//  Идентификатор - Строка - публичный или внутренний идентификатор.
//  МенеджерОбъекта - МодульМенеджераОбъекта - менеджер искомого объекта.
//  Источник - ПланОбменаСсылка, СправочникСсылка.пбп_ИнтегрируемыеСистемы - владелец публичного идентификатора.
//  ЭтоГруппа - Булево - создавать группу справочника.
//  СтруктураПоискаСсылки - Соответствие - поля поиска ссылки.
//                          Если не задана, поиск идет по публичному и внутреннему идентификатору.
//
// Возвращаемое значение:
//  ЛюбойОбъект - объект для заполнения.
//
Функция ПолучитьОбъектОбработкиСБлокировкойИдентификатора(ПараметрыСообщения,
	Источник, СтруктураПоискаСсылки = Неопределено) Экспорт
	
	МенеджерОбъекта = ПараметрыСообщения.МенеджерОбъекта;
	ЭтоГруппа = ПараметрыСообщения.ЭтоГруппа;
	Идентификатор = ПараметрыСообщения.СсылкаИзXDTO;
	ОбъектОбработки = Неопределено;
	
	Если Не ТранзакцияАктивна() Тогда
		
		ВызватьИсключение НСтр(
			"ru = 'Блокировка идентификатора выполняется только внутри транзакции вызывающего кода.'");
		
	КонецЕсли;
	
	ЗаблокироватьПубличныйИдентификатор(Идентификатор);
	
	ПроверкаСуществования = Новый Структура("Проверена, Существует, Ссылка", Ложь, Ложь, Неопределено);
	СсылкаНаЭлемент = НайтиПоИдентификаторуПолямПоиска(
		МенеджерОбъекта, Идентификатор, Источник, СтруктураПоискаСсылки, ПроверкаСуществования);
	
	Результат = ПолучитьСсылочныйЭлемент(
		МенеджерОбъекта, СсылкаНаЭлемент, ЭтоГруппа, ПараметрыСообщения);
	
	Если ЗначениеЗаполнено(Результат.ТекстОшибки) Тогда
		
		ВызватьИсключение Результат.ТекстОшибки;
		
	КонецЕсли;
	
	ОбъектОбработки = Результат.ОбъектОбработки;
	
	ЗаполнитьСостояниеЗагрузки(ОбъектОбработки, ПараметрыСообщения);
	
	Если ОбъектОбработки.ЭтоНовый() Тогда
		
		Если ПроверкаСуществования.Проверена И Не ПроверкаСуществования.Существует Тогда
			
			Если ЗначениеЗаполнено(ПроверкаСуществования.Ссылка) Тогда
				
				СсылкаНового = ПроверкаСуществования.Ссылка;
				
			Иначе
				
				СсылкаНового = МенеджерОбъекта.ПолучитьСсылку(Новый УникальныйИдентификатор);
				
			КонецЕсли;
			
		Иначе
			
			СсылкаПоИдентификатору = СсылкаПоВнутреннемуИдентификатору(МенеджерОбъекта, Идентификатор);
			
			Если ЗначениеЗаполнено(СсылкаПоИдентификатору)
				И Не СсылкаСуществует(СсылкаПоИдентификатору) Тогда
				
				СсылкаНового = СсылкаПоИдентификатору;
				
			Иначе
				
				СсылкаНового = МенеджерОбъекта.ПолучитьСсылку(Новый УникальныйИдентификатор);
				
			КонецЕсли;
			
		КонецЕсли;
		
		ОбъектОбработки.УстановитьСсылкуНового(СсылкаНового);
		
	КонецЕсли;
	
	Возврат ОбъектОбработки;
	
КонецФункции

// Возвращает ссылку на объект по указанному идентификатору или полям поиска.
// Поддерживает поиск как по внутреннему уникальному идентификатору (UUID),
// так и по внешнему (публичному) идентификатору из регистра синхронизации.
// При пустых полях поиска сначала ищется публичный идентификатор, если источник
// является его владельцем, затем существующая ссылка по UUID.
//
// Параметры:
//  Менеджер - МодульМенеджераОбъекта - менеджер метаданных, в котором выполняется поиск.
//  Идентификатор - Строка - внутренний или внешний идентификатор объекта.
//  Источник - ПланОбменаСсылка, СправочникСсылка.пбп_ИнтегрируемыеСистемы, Неопределено -
//   владелец публичного идентификатора. Допустимо Неопределено: поиск по публичному идентификатору пропускается.
//  ПоляПоиска - Соответствие - поля поиска. Ключ - имя поля, значение - значение отбора.
//   Для группы ключ - имена через "+", значение - Соответствие имени поля и значения.
//   Совпадение группы требует равенства всех ее полей. Пустое соответствие и Неопределено
//   включают поиск по умолчанию.
//   Несуществующий UUID в этом режиме возвращает Неопределено.
//  ПроверкаСуществования - Структура, Неопределено - необязательный приемник проверки
//   существования по внутреннему идентификатору: Проверена, Существует, Ссылка.
//
// Возвращаемое значение:
//  ЛюбаяСсылка, Неопределено - найденная ссылка либо Неопределено, если объект не найден.
//
Функция НайтиПоИдентификаторуПолямПоиска(Менеджер, Идентификатор, Источник,
	Знач ПоляПоиска = Неопределено, ПроверкаСуществования = Неопределено) Экспорт
	
	// ПроверкаСуществования - необязательный приемник: Проверена, Существует, Ссылка.
	// Заполняется после проверки существования по внутреннему идентификатору.
	
	Если ПоляПоиска = Неопределено Тогда
		
		ПоляПоиска = Новый Соответствие;
		
	Иначе
		
		ПоляПоиска = пбп_Переадресация.СкопироватьРекурсивно(ПоляПоиска);
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПоляПоиска) Тогда
		
		Возврат НайтиПоИдентификаторуПоУмолчанию(
			Менеджер, Идентификатор, Источник, ПроверкаСуществования);
		
	КонецЕсли;
	
	ИмяВнешнегоИдентификатора = ИмяПоляПоискаПоВнешнемуИдентификатору();
	
	Если ПоляПоиска[ИмяВнешнегоИдентификатора] <> Неопределено Тогда
		
		ПоляПоиска.Удалить(ИмяВнешнегоИдентификатора);
		Найдено = НайтиСсылкуПоПубличномуИдентификатору(Идентификатор, Источник);
		
		Если ЗначениеЗаполнено(Найдено) Тогда
			
			Возврат Найдено;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПоляПоиска) Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	ИмяВнутреннегоИдентификатора = ИмяПоляПоискаПоВнутреннемуИдентификатору();
	
	Если ПоискТолькоПоВнутреннемуИдентификатору(ПоляПоиска, ИмяВнутреннегоИдентификатора) Тогда
		
		Возврат СсылкаПоЕдинственномуВнутреннемуИдентификатору(
			Менеджер, ПоляПоиска, ИмяВнутреннегоИдентификатора, ПроверкаСуществования);
		
	КонецЕсли;
	
	Мета = Метаданные.НайтиПоТипу(ТипЗнч(Менеджер));
	Запрос = Новый Запрос;
	ТекстЗапроса = ТекстШаблонаПоискаСсылки();
	СтрокаЗамены = СтрокаЗаменыПоискаСсылки();
	Выражения = Новый Массив;
	
	Для Каждого Пара Из ПоляПоиска Цикл
		
		Если ТипЗнч(Пара.Значение) = Тип("Соответствие") Тогда
			
			Поле = ДобавитьГруппуВЗапросПоискаСсылки(
				Запрос, ТекстЗапроса, Пара.Значение, Мета.ПолноеИмя());
			
		Иначе
			
			Поле = ДобавитьПолеВЗапросПоискаСсылки(
				Запрос, ТекстЗапроса, Пара.Ключ, Пара.Значение,
				ИмяВнутреннегоИдентификатора, Мета, Менеджер);
			
		КонецЕсли;
		
		Если Поле = "Неопределено" Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		Выражения.Добавить(Поле);
		
	КонецЦикла;
	
	Возврат НайтиСсылкуПоВыражениямПоиска(Запрос, ТекстЗапроса, Выражения, СтрокаЗамены);
	
КонецФункции

Функция ТекстШаблонаПоискаСсылки()
	
	Возврат
	"ВЫБРАТЬ
	|	&Заглушка КАК Заглушка
	|ПОМЕСТИТЬ ВТ_Данные
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВТ_Данные.Заглушка КАК Заглушка
	|ИЗ
	|	ВТ_Данные КАК ВТ_Данные";
	
КонецФункции

Функция СтрокаЗаменыПоискаСсылки()
	
	Возврат "
	|ИЗ
	|	ВТ_Данные КАК ВТ_Данные";
	
КонецФункции

Функция НайтиСсылкуПоВыражениямПоиска(Запрос, ТекстЗапроса, Выражения, СтрокаЗамены)
	
	Если Выражения.Количество() = 0 Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	Условие = "";
	ПоследнийИндекс = Выражения.ВГраница();
	
	Для Индекс = 0 По ПоследнийИндекс Цикл
		
		Условие = ДополнитьЦепочкуЕстьNull(
			Условие, Выражения[Индекс], Индекс, ПоследнийИндекс, "Неопределено");
		
	КонецЦикла;
	
	ВыражениеСсылки = Новый Структура("Значение, Псевдоним", Условие, "Ссылка");
	ДобавитьПолеВыборкиВЗапрос(ТекстЗапроса, ВыражениеСсылки, Условие, "", "", СтрокаЗамены);
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Заглушка", "");
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.Ссылка;
	
КонецФункции

Функция ДобавитьГруппуВЗапросПоискаСсылки(Запрос, ТекстЗапроса, ЗначенияПолей, ПолноеИмяТаблицы)
	
	ИменаПолей = Новый Массив;
	ПоляСоединения = Новый Массив;
	
	Для Каждого ПараПоля Из ЗначенияПолей Цикл
		
		ИменаПолей.Добавить(ПараПоля.Ключ);
		ПоляСоединения.Добавить(Новый Структура(
			"ИмяПоляПоиска, ИмяПоляИсточника", ПараПоля.Ключ, ПараПоля.Ключ));
		
	КонецЦикла;
	
	Если Не ГруппаПолейПоискаДопустима(ИменаПолей, ПолноеИмяТаблицы) Тогда
		
		Возврат "Неопределено";
		
	КонецЕсли;
	
	Для Каждого ПараПоля Из ЗначенияПолей Цикл
		
		ДобавитьПолеВЗапросПриЗагрузке(ТекстЗапроса, ПараПоля.Ключ);
		Запрос.УстановитьПараметр(
			ПараПоля.Ключ, ЗначениеПараметраИзXDTO(ПараПоля.Значение, Ложь));
		
	КонецЦикла;
	
	Возврат ДополнитьЗапросПоГруппеПолейПоиска(
		ТекстЗапроса, ПоляСоединения, ПолноеИмяТаблицы, "ВТ_Данные", Ложь);
	
КонецФункции

Функция ДобавитьПолеВЗапросПоискаСсылки(Запрос, ТекстЗапроса, Имя, ЗначениеПараметра,
	ИмяВнутреннегоИдентификатора, Мета, Менеджер)
	
	ДобавитьПолеВЗапросПриЗагрузке(ТекстЗапроса, Имя);
	
	Если Имя = ИмяВнутреннегоИдентификатора Тогда
		
		Поле = ДополнитьЗапросПоПолюПоискаКонкатенация(
			ТекстЗапроса, Имя, "Ссылка", Мета.ПолноеИмя(), "ВТ_Данные", 1, 0, Ложь);
		ЗначениеПараметра = СсылкаПоВнутреннемуИдентификатору(Менеджер, ЗначениеПараметра);
		
	Иначе
		
		Поле = ДополнитьЗапросПоПолюПоискаКонкатенация(
			ТекстЗапроса, Имя, Имя, Мета.ПолноеИмя(), "ВТ_Данные", 1, 0, Ложь);
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр(Имя, ЗначениеПараметра);
	
	Возврат Поле;
	
КонецФункции

// Возвращает объект по переданной ссылке или создаёт новый элемент,
// если ссылка не определена. При наличии ссылки выполняет блокировку объекта для предотвращения параллельных изменений.
//
// Параметры:
//  МенеджерОбъекта	 - МодульМенеджераОбъекта - Менеджер метаданных, в котором выполняется поиск объекта.
//  СсылкаНаЭлемент	 - ЛюбаяСсылка - Ссылка на объект, который требуется получить.
//                                             Если Неопределено - создается новый объект.
//  ЭтоГруппа - Булево - создавать группу, если ссылка не передана.
//  ПараметрыСообщения - Структура, Неопределено - кэш МетаданныеОбъекта. Если ключ заполнен,
//   класс объекта берется из него.
//
// Возвращаемое значение:
//  Структура - Результат выполнения
//   * ОбъектОбработки - ЛюбойОбъект - Объект, полученный по ссылке.
//   * ТекстОшибки - Строка - Текст ошибки выполнения.
//
Функция ПолучитьСсылочныйЭлемент(МенеджерОбъекта, СсылкаНаЭлемент, ЭтоГруппа = Ложь,
	ПараметрыСообщения = Неопределено) Экспорт
	
	// ПараметрыСообщения.МетаданныеОбъекта, если заполнены, задают класс без повторного разбора имени.
	Результат = Новый Структура("ОбъектОбработки,ТекстОшибки");
	
	Если СсылкаНаЭлемент = Неопределено Тогда
		
		КлассОбъекта = КлассОбъектаМенеджера(МенеджерОбъекта, ПараметрыСообщения);
		УстановитьНовыйОбъектОбработки(Результат, МенеджерОбъекта, КлассОбъекта, ЭтоГруппа);
		Возврат Результат;
		
	КонецЕсли;
	
	ЗаблокироватьСсылкуОбъекта(СсылкаНаЭлемент);
	
	ОбъектОбработки = СсылкаНаЭлемент.ПолучитьОбъект();
	
	Если ОбъектОбработки = Неопределено Тогда
		
		КлассОбъекта = КлассОбъектаМенеджера(МенеджерОбъекта, ПараметрыСообщения);
		УстановитьНовыйОбъектОбработки(Результат, МенеджерОбъекта, КлассОбъекта, Ложь);
		Возврат Результат;
		
	КонецЕсли;
	
	Результат.ОбъектОбработки = ОбъектОбработки;
	//BSLLS:MissingCodeTryCatchEx-off
	Попытка
		ОбъектОбработки.Заблокировать();
	Исключение
		Результат.ТекстОшибки = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Невозможно заблокировать документ %1'"), СсылкаНаЭлемент);
	КонецПопытки;
	//BSLLS:MissingCodeTryCatchEx-on
	
	Возврат Результат;
	
КонецФункции

// Выполняет запись переданного объекта в базу данных с установкой необходимых флагов,
// а также регистрацию связи между объектом и внешним идентификатором при синхронизации данных.
// Поддерживает работу со справочниками и документами.
//
// Параметры:
//  ОбъектОбработки - ЛюбойОбъект - объект, который требуется записать в базу данных.
//  ПараметрыОбмена - Структура - см. ИнициализироватьПараметрыОбмена. Используется Источник.
//  ПараметрыСообщения - Структура - см. ИнициализироватьПараметрыСообщения.
//                       Используются МенеджерОбъекта, СсылкаИзXDTO,
//                       СсылкаЯвляетсяВнешнимИдентификатором, ОбменДаннымиЗагрузка
//                       и СостояниеЗагрузки.
//
// Возвращаемое значение:
//  ЛюбаяСсылка - ссылка записанного объекта.
//
Функция ЗаписатьСсылочныйЭлемент(ОбъектОбработки, ПараметрыОбмена, ПараметрыСообщения) Экспорт
	
	МенеджерОбъекта = ПараметрыСообщения.МенеджерОбъекта;
	Идентификатор = ПараметрыСообщения.СсылкаИзXDTO;
	Источник = ПараметрыОбмена.Источник;
	СсылкаЯвляетсяВнешнимИдентификатором = ПараметрыСообщения.СсылкаЯвляетсяВнешнимИдентификатором;
	ОбменДаннымиЗагрузка = ПараметрыСообщения.ОбменДаннымиЗагрузка;
	
	Если ПараметрыСообщения.Свойство("СостояниеЗагрузки") Тогда
		СостояниеЗагрузки = ПараметрыСообщения.СостояниеЗагрузки;
	Иначе
		СостояниеЗагрузки = НовоеСостояниеЗагрузки();
		СостояниеЗагрузки.ЭтоНовый = ОбъектОбработки.ЭтоНовый();
	КонецЕсли;
	
	ОбъектОбработки.ОбменДанными.Загрузка = ОбменДаннымиЗагрузка;
	
	КлассОбъекта = КлассОбъектаМенеджера(МенеджерОбъекта, ПараметрыСообщения);
	Если КлассОбъекта = "Документ" Тогда
		// Обработка документа.          АвтоматическоеДобавлениеИсчтоника
		// вызов процедуры проведения документа.
		Мета = ОбъектОбработки.Метаданные();
		Если ЭтоСтандартныйРеквизит(Мета.СтандартныеРеквизиты, "Дата")
			Или Не Мета.Реквизиты.Найти("Дата") = Неопределено Тогда
			
			Если Не ЗначениеЗаполнено(ОбъектОбработки.Дата) Тогда
				ОбъектОбработки.Дата = ТекущаяДатаСеанса();
			КонецЕсли;
		КонецЕсли;
		
		СостояниеЗагрузки.ТребуетсяПроведение = ОбъектОбработки.Проведен;
		ОбъектОбработки.Записать();
		
	ИначеЕсли КлассОбъекта = "Задача" Тогда
		ОбъектОбработки.Дата = ?(ЗначениеЗаполнено(ОбъектОбработки.Дата),ОбъектОбработки.Дата, ТекущаяДатаСеанса());
		ОбъектОбработки.Записать();
		
	Иначе
		ОбъектОбработки.Записать();
	КонецЕсли;
	
	Если СсылкаЯвляетсяВнешнимИдентификатором Тогда
		
		ЗаписатьПубличныйИдентификатор(ОбъектОбработки.Ссылка, Источник, Идентификатор);
		
	КонецЕсли;
	
	СсылкаРезультата = ОбъектОбработки.Ссылка;
	Возврат СсылкаРезультата;
	
КонецФункции

#КонецОбласти // Загрузка

#КонецОбласти // ПрограммныйИнтерфейс

#Область СлужебныйПрограммныйИнтерфейс

#Область Выгрузка

// Конструктор состава полей
// 
// Возвращаемое значение:
//  Структура - :
//  * РеквизитыОбъекта - Структура
//     * Реквизиты - Массив
//     * ВложенныеПоля - Структура
//  * ТабличныеЧасти - Структура - где ключ имя табличной части, значение структура см. КонструкторНабораДанных
//  * ПорядокТабличныхЧастей - Массив
//
//  * СинонимыТабличныхЧастей - Структура - ключ имя табличной части, значение синоним ключа выгрузки
//
Функция КонструкторСоставаПолей() Экспорт
	
	Результат = Новый Структура;
	
	НаборДанных = КонструкторНабораДанных();
	
	Результат.Вставить("РеквизитыОбъекта", НаборДанных);
	Результат.Вставить("ТабличныеЧасти", Новый Структура);
	Результат.Вставить("СинонимыТабличныхЧастей", Новый Структура);
	Результат.Вставить("ПорядокТабличныхЧастей", Новый Массив);
	
	Возврат Результат;
	
КонецФункции

// Добавляет поля в состав полей
//
// Параметры:
//  СоставПолей	 - Структура - см. КонструкторСоставаПолей
//  Поля		 - 			 - Строка, Массив из Строка, Массив из Структура - поля, которые необходимо добавить в состав,
//  			если массив из Структура см. КонструкторПолейСТипом
//
Процедура ДобавитьПоляВСоставПолей(СоставПолей, Знач Поля) Экспорт
	
	ДобавитьПоляОбъекта(СоставПолей, Поля);
	
КонецПроцедуры

// Добавляет поле в состав полей
//
// Параметры:
//  СоставПолей	 - Структура - см. КонструкторСоставаПолей
//  Поле		 - Строка	 - поле, которые необходимо добавить в состав
//
Процедура ДобавитьПолеВСоставПолей(СоставПолей, Знач Поле, Синоним = "",
	ВыводитьВСтруктуру = Ложь, ВыгрузитьКакПубличныйИдентификатор = Ложь) Экспорт
	
	Поле = ОбернутьПолеВСтруктуруСТипом(Поле, Синоним, Неопределено, ВыводитьВСтруктуру, ВыгрузитьКакПубличныйИдентификатор);
	
	ДобавитьПоляОбъекта(СоставПолей, Поле);
	
КонецПроцедуры

// Добавляет поля табличной части в состав полей
//
// Параметры:
//  СоставПолей			 - Структура - см. КонструкторСоставаПолей
//  ИмяТабличнойЧасти	 - Строка	 - Имя табличной части объекта
//  Поля				 - 			 - Строка, Массив из Строка, Массив из Структура - поля, которые необходимо добавить в состав,
//  			если массив из Структура см. КонструкторПолейСТипом
//
//  СинонимТабличнойЧасти - Строка - ключ выгрузки табличной части; пустая строка оставляет имя метаданных
//
Процедура ДобавитьПоляТабличнойЧастиВСоставПолей(СоставПолей, ИмяТабличнойЧасти, Знач Поля, СинонимТабличнойЧасти = "") Экспорт
	
	ДобавитьПоляТабличнойЧасти(СоставПолей, ИмяТабличнойЧасти, Поля, СинонимТабличнойЧасти);
	
КонецПроцедуры

// Добавляет поле табличной части в состав полей
//
// Параметры:
//  СоставПолей			 - Структура - см. КонструкторСоставаПолей
//  ИмяТабличнойЧасти	 - Строка	 - Имя табличной части объекта
//  Поле				 - Строка	 - поле табличной части, которое необходимо добавить в состав
//
Процедура ДобавитьПолеТабличнойЧастиВСоставПолей(СоставПолей, ИмяТабличнойЧасти, Знач Поле,
	Синоним = "", ВыводитьВСтруктуру = Ложь, ВыгрузитьКакПубличныйИдентификатор = Ложь) Экспорт
	
	Поле = ОбернутьПолеВСтруктуруСТипом(Поле, Синоним, Неопределено, ВыводитьВСтруктуру, ВыгрузитьКакПубличныйИдентификатор);
	
	ДобавитьПоляТабличнойЧасти(СоставПолей, ИмяТабличнойЧасти, Поле);
	
КонецПроцедуры

// Конструктор полей с типом
// 
// Возвращаемое значение:
//  Массив - обертка для полей с типом.
//
Функция КонструкторПолейСТипом() Экспорт
	Возврат Новый Массив;
КонецФункции

// Дополняет поля, полем с типом
//
// Параметры:
//  МассивПриемник	 - Массив - см. КонструкторПолейСТипом
//  Поле			 - Строка - Имя получаемого поля.
//  Тип				 - Тип, Неопределено - Тип поля
//
Процедура ДополнитьПоляПолемСТипом(МассивПриемник, Поле, Синоним = "", Тип = Неопределено,
	ВыводитьВСтруктуру = Ложь, ВыгрузитьКакПубличныйИдентификатор = Ложь, СоставнойТип = Ложь, ЧастиДаты = Неопределено) Экспорт
	
	Данные = ОбернутьПолеВСтруктуруСТипом(Поле, Синоним, Тип, ВыводитьВСтруктуру,
		ВыгрузитьКакПубличныйИдентификатор, СоставнойТип, ЧастиДаты);
	
	МассивПриемник.Добавить(Данные);
	
КонецПроцедуры

// Возвращает описание полей исходящего запроса для указанного типа метаданных.
//
// Делает это универсально по следующим правилам:
//  1) Для примитивных типов заполняет соответствие 1 к 1 - имя реквизита = имени атрибута запроса
//  2) Для ссылочных типов выгружается уникальный идентификатор ссылки,
//     если карта исключений типов не задаёт другое поле.
//
// Параметры:
//  Менеджер		 - ОбъектМетаданных	 - объект метаданных, для которого необходимо выполнить сопоставление полей
//  ИсключенияТипов	 - Соответствие		 - ключ - тип ссылочного реквизита объекта, для которого необходимо выключить подстановку
// реквизита по универсальному механизму, значение - имя реквизита, из которого необходимо выгрузить данные для типа.
// 
// Возвращаемое значение:
//  Структура - описание полей объекта
//
Функция ПолучитьОписаниеПолейПоМетаданным(МетаданныеОбъект, ИсключенияТипов = Неопределено,
	ОбъектОбработки = Неопределено, СтруктураИстории = Неопределено) Экспорт
	
	Если МетаданныеОбъект = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнен параметр ""МетаданныеОбъект""'");
	КонецЕсли;
	
	Если ИсключенияТипов = Неопределено Тогда
		ИсключенияТипов = Новый Соответствие;
	КонецЕсли;
	
	ВыгружатьУниверсальноеВремя = Ложь;
	
	Результат = КонструкторСоставаПолей();
	
	Поля = КонструкторПолейСТипом();
	
	ЭтоРегистр = ОбъектМетаданныхЯвляетсяРегистром(МетаданныеОбъект);
	ЭтоДокумент = ОбъектМетаданныхЯвляетсяДокументом(МетаданныеОбъект);
	
	Для Каждого СтандартныйРеквизит Из МетаданныеОбъект.СтандартныеРеквизиты Цикл
		Если Не ЭтоДокумент И Не ЭтоРегистр Тогда
			Если СтандартныйРеквизит.Имя = "Код" И МетаданныеОбъект.ДлинаКода = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Если СтандартныйРеквизит.Имя = "Наименование" И МетаданныеОбъект.ДлинаНаименования = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Если СтандартныйРеквизит.Имя = "Предопределенный" Тогда
				Продолжить;
			КонецЕсли;
			
			Если Не МетаданныеОбъект.Иерархический
				И (СтандартныйРеквизит.Имя = "ЭтоГруппа"
				Или СтандартныйРеквизит.Имя = "Родитель") Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		ВыгрузитьКакПубличныйИдентификатор = Ложь;
		Для Каждого ПроверяемыйТип Из СтандартныйРеквизит.Тип.Типы() Цикл
			Если пбп_Переадресация.ЭтоСсылка(ПроверяемыйТип)
				И Не ОбъектМетаданныхЯвляетсяПеречислением(Метаданные.НайтиПоТипу(ПроверяемыйТип)) Тогда
				ВыгрузитьКакПубличныйИдентификатор = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		ЗначениеИсключения = ИсключенияТипов.Получить(ПроверяемыйТип);
		Если ЗначениеИсключения = Неопределено Тогда
			ИмяРеквизитаСопоставления = ПолучитьИмяРеквизитаВыгрузкиУниверсально(ПроверяемыйТип);
		Иначе
			ИмяРеквизитаСопоставления = ЗначениеИсключения;
		КонецЕсли;
		
		Тип = Неопределено;
		ЗначениеПоля = СтандартныйРеквизит.Имя;
		Если ЗначениеЗаполнено(ИмяРеквизитаСопоставления) Тогда
			
			Если ИмяРеквизитаСопоставления = "ВнешнийИдентификатор" Тогда
				ВыгрузитьКакПубличныйИдентификатор = Истина;
			Иначе
				ВыгрузитьКакПубличныйИдентификатор = Ложь;
				
				ЗначениеПоля = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
					"%1.%2", СтандартныйРеквизит.Имя, ИмяРеквизитаСопоставления);
			КонецЕсли;
			
			Если СтандартныйРеквизит.Имя = "Ссылка"
				И Не ИмяРеквизитаСопоставления = "ВнешнийИдентификатор" Тогда
				
				Если пбп_Переадресация.ЭтоСсылка(ПроверяемыйТип)
					И Не ОбъектМетаданныхЯвляетсяПеречислением(Метаданные.НайтиПоТипу(ПроверяемыйТип))
					И МетаданныеОбъект.Реквизиты.Найти(ИмяРеквизитаСопоставления) = Неопределено Тогда
					
					ДополнитьПоляПолемСТипом(Поля, ЗначениеПоля, ИмяРеквизитаСопоставления, Тип,, ВыгрузитьКакПубличныйИдентификатор,
						СтандартныйРеквизит.Тип.Типы().Количество() > 1,
						?(СтандартныйРеквизит.Имя = "Дата", ЧастиДаты.ДатаВремя, Неопределено));
						
				КонецЕсли;
				
				ЗначениеПоля = СтандартныйРеквизит.Имя;
				ВыгрузитьКакПубличныйИдентификатор = Истина;
				Тип = Неопределено;
				
			КонецЕсли;
			
		КонецЕсли;
		
		ДополнитьПоляПолемСТипом(Поля, ЗначениеПоля,, Тип,, ВыгрузитьКакПубличныйИдентификатор,
			СтандартныйРеквизит.Тип.Типы().Количество() > 1,
			?(СтандартныйРеквизит.Имя = "Дата" И ВыгружатьУниверсальноеВремя, ЧастиДаты.ДатаВремя, Неопределено));
	КонецЦикла;
	
	Для Каждого Реквизит Из МетаданныеОбъект.Реквизиты Цикл
		Если ОбъектОбработки <> Неопределено Тогда
			ЗначениеОбъекта = ОбъектОбработки[Реквизит.Имя];
		Иначе
			ЗначениеОбъекта = Неопределено;
		КонецЕсли;
		
		ДополнитьПолеВыгрузкиУниверсально(Поля, Реквизит, ИсключенияТипов, ЗначениеОбъекта, ВыгружатьУниверсальноеВремя);
	КонецЦикла;
	
	Если ЭтоРегистр Тогда
		Для Каждого Измерение Из МетаданныеОбъект.Измерения Цикл
			Если ОбъектОбработки <> Неопределено Тогда
				ЗначениеОбъекта = ОбъектОбработки[Измерение.Имя];
			Иначе
				ЗначениеОбъекта = Неопределено;
			КонецЕсли;
			
			ДополнитьПолеВыгрузкиУниверсально(Поля, Измерение, ИсключенияТипов, ЗначениеОбъекта, ВыгружатьУниверсальноеВремя);
			
			Если Измерение.Тип.Типы().Количество() = 1 Тогда
				Поля[Поля.Количество() - 1].Тип = Неопределено;
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого Ресурс Из МетаданныеОбъект.Ресурсы Цикл
			Если ОбъектОбработки <> Неопределено Тогда
				ЗначениеОбъекта = ОбъектОбработки[Ресурс.Имя];
			Иначе
				ЗначениеОбъекта = Неопределено;
			КонецЕсли;
			
			ДополнитьПолеВыгрузкиУниверсально(Поля, Ресурс, ИсключенияТипов, ЗначениеОбъекта, ВыгружатьУниверсальноеВремя);
		КонецЦикла;
	КонецЕсли;
	
	ДобавитьПоляВСоставПолей(Результат, Поля);
	
	Если Не ЭтоРегистр Тогда
		Для Каждого ТабличнаяЧасть Из МетаданныеОбъект.ТабличныеЧасти Цикл
			
			ПоляТЧ = КонструкторПолейСТипом();
			
			ИмяТЧ = ТабличнаяЧасть.Имя;
			Для Каждого РеквизитТЧ Из ТабличнаяЧасть.Реквизиты Цикл
				Если ОбъектОбработки <> Неопределено И ОбъектОбработки[ИмяТЧ].Количество() Тогда
					ЗначениеОбъекта = ОбъектОбработки[ИмяТЧ][0][РеквизитТЧ.Имя];
				Иначе
					ЗначениеОбъекта = Неопределено;
				КонецЕсли;
				
				ДополнитьПолеВыгрузкиУниверсально(ПоляТЧ, РеквизитТЧ, ИсключенияТипов, ЗначениеОбъекта, ВыгружатьУниверсальноеВремя);
			КонецЦикла;
			
			ДобавитьПоляТабличнойЧастиВСоставПолей(Результат, ИмяТЧ, ПоляТЧ);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти // Выгрузка

#Область Загрузка

// Конструктор соответствия полей источника и приемника
// 
// Возвращаемое значение:
//  Соответствие - Соответствие полей.
//
Функция КонструкторСоответствияПолейИсточникаИПриемника() Экспорт
	Возврат Новый Соответствие;
КонецФункции

// Дополняет соответствие полей источника и приемника
//
// Параметры:
//  СоответствиеПолей	 - Соответствие - Состав полей источника (внешней системы) и приемника (внутренней системы), для маппинга.
//  ПолеИсточника		 - Строка - Поле внешней системы.
//  ПолеПриемника		 - Строка - Поле внутренней системы.
//  ЭтоТабличнаяЧасть	 - Булево - Если Истина, поле является табличной частью.
//
//  ЭтоВнешнийИдентификатор - Булево - Вложенное поле поиска - ВнешнийИдентификатор.
//                                 Вложенный ключ, отличный от имени поля приемника, задает поле поиска.
Процедура ДополнитьСоответствиеПолейИсточникаИПриемника(СоответствиеПолей, ПолеИсточника,
	ПолеПриемника, ЭтоТабличнаяЧасть = Ложь, ЭтоВнешнийИдентификатор = Ложь) Экспорт
	
	ЧастиПоляПриемника = СтрРазделить(ПолеПриемника, ".");
	ЧастиПоляИсточника = СтрРазделить(ПолеИсточника, ".");
	
	Данные = Новый Структура("ВложенноеПоле,ПолеИсточника");
	
	Если ЭтоТабличнаяЧасть Тогда
		ИмяТЧПрием = ЧастиПоляПриемника[0];
		ИмяРеквизитаПрием = ЧастиПоляПриемника[1];
		
		ИмяТЧИст = ЧастиПоляИсточника[0];
		
		Вложенное = ИмяРеквизитаПрием;
		Если ЧастиПоляПриемника.Количество() = 3 Тогда
			Вложенное = ЧастиПоляПриемника[2];
		ИначеЕсли ЭтоВнешнийИдентификатор Тогда
			Вложенное = ИмяПоляПоискаПоВнешнемуИдентификатору();
		КонецЕсли;
		Данные.ВложенноеПоле = Вложенное;
		Данные.ПолеИсточника = ЧастиПоляИсточника[1];
		
		Если Не ЗначениеЗаполнено(СоответствиеПолей[ИмяТЧПрием]) Тогда
			Подсоотв = Новый Соответствие;
			Подсоотв.Вставить("_имя_источника", ИмяТЧИст);
			
			СоответствиеПолей.Вставить(ИмяТЧПрием, Подсоотв);
		Иначе
			Подсоотв = СоответствиеПолей[ИмяТЧПрием];
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Подсоотв[ИмяРеквизитаПрием]) Тогда
			ПодПод = Новый Соответствие;
			
			Подсоотв.Вставить(ИмяРеквизитаПрием, ПодПод);
		Иначе
			ПодПод = Подсоотв[ИмяРеквизитаПрием];
		КонецЕсли;
		ПодПод.Вставить(Вложенное, ЧастиПоляИсточника[1]);
		//Подсоотв.Вставить(ИмяРеквизитаПрием, Данные);
		
		Возврат;
	КонецЕсли;
	
	Основное = ЧастиПоляПриемника[0];
	Вложенное = Основное;
	Если ЧастиПоляПриемника.Количество() = 2 Тогда
		Вложенное = ЧастиПоляПриемника[1];
	ИначеЕсли ЭтоВнешнийИдентификатор Тогда
		Вложенное = ИмяПоляПоискаПоВнешнемуИдентификатору();
	КонецЕсли;
	
	Данные.ВложенноеПоле = Вложенное;
	Данные.ПолеИсточника = ПолеИсточника;
	
	Если Не ЗначениеЗаполнено(СоответствиеПолей[Основное]) Тогда
		Подсоотв = Новый Соответствие;
		
		СоответствиеПолей.Вставить(Основное, Подсоотв);
	Иначе
		Подсоотв = СоответствиеПолей[Основное];
	КонецЕсли;
	Подсоотв.Вставить(Вложенное, ПолеИсточника);
	
КонецПроцедуры

// Имя вложенного поля поиска объекта по публичному идентификатору внешней системы.
//
// Возвращаемое значение:
//  Строка - имя поля поиска.
Функция ИмяПоляПоискаПоВнешнемуИдентификатору() Экспорт
	Возврат "ВнешнийИдентификатор";
КонецФункции

// Имя вложенного поля поиска объекта по внутреннему идентификатору.
//
// Возвращаемое значение:
//  Строка - имя поля поиска.
Функция ИмяПоляПоискаПоВнутреннемуИдентификатору() Экспорт
	Возврат "Идентификатор";
КонецФункции

// Собирает поля, которые ищутся вместе: совпасть должны все значения.
// Дата сравнивается на точное равенство.
// Внешний и внутренний идентификаторы внутри группы недопустимы: при поиске такая группа пропускается.
//
// Параметры:
//  Поля - Строка, Массив из Строка - имена полей через запятую или массив имен.
//
// Возвращаемое значение:
//  Структура - Тип "ГруппаПолейПоиска", Поля - массив имен полей.
//
Функция ГруппаПолейПоиска(Знач Поля) Экспорт
	
	ИменаПолей = Новый Массив;
	
	Если ТипЗнч(Поля) = Тип("Массив") Тогда
		
		Для Каждого ИмяПоля Из Поля Цикл
			
			ДобавитьИмяВГруппуПолейПоиска(ИменаПолей, ИмяПоля);
			
		КонецЦикла;
		
	Иначе
		
		Для Каждого Часть Из СтрРазделить(Строка(Поля), ",", Ложь) Цикл
			
			ДобавитьИмяВГруппуПолейПоиска(ИменаПолей, СокрЛП(Часть));
			
		КонецЦикла;
		
	КонецЕсли;
	
	Группа = Новый Структура;
	Группа.Вставить("Тип", "ГруппаПолейПоиска");
	Группа.Вставить("Поля", ИменаПолей);
	
	Возврат Группа;
	
КонецФункции

#КонецОбласти // Загрузка

// Возвращает узел интеграции по источнику сообщения шины.
// Строка ищется как узел плана обмена или как интегрируемая система.
// Уже переданная ссылка возвращается без изменений.
//
// Параметры:
//  Источник - Строка, ПланОбменаСсылка, СправочникСсылка.пбп_ИнтегрируемыеСистемы -
//   имя источника или уже найденная ссылка.
//
// Возвращаемое значение:
//  ПланОбменаСсылка, СправочникСсылка.пбп_ИнтегрируемыеСистемы - узел интеграции.
//
Функция УзелИнтеграцииПоИсточнику(Источник) Экспорт
	
	Если пбп_Переадресация.ЭтоСсылка(ТипЗнч(Источник)) Тогда
		
		Возврат Источник;
		
	КонецЕсли;
	
	ОписаниеРегистра = пбп_ИнтеграцииШинаПовтИсп.ОписаниеРегистраПубличныхИдентификаторов();
	ПолноеИмяПлана = пбп_ИнтеграцииШинаПовтИсп.ПолноеИмяПланаОбменаИнтеграций();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Источник", Источник);
	
	Если ОписаниеРегистра.ЭтоРегистрБСП И ЗначениеЗаполнено(ПолноеИмяПлана) Тогда
		
		ТекстЗапроса =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Узлы.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.пбп_ИнтегрируемыеСистемы КАК Узлы
			|ГДЕ
			|	Узлы.Наименование = &Источник
			|	И НЕ Узлы.ПометкаУдаления";
		Запрос.Текст = СтрЗаменить(ТекстЗапроса, "Справочник.пбп_ИнтегрируемыеСистемы", ПолноеИмяПлана);
		
	Иначе
		
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	ИнтегрируемыеСистемы.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.пбп_ИнтегрируемыеСистемы КАК ИнтегрируемыеСистемы
			|ГДЕ
			|	ИнтегрируемыеСистемы.ИдентификаторНастройки = &Источник
			|	И НЕ ИнтегрируемыеСистемы.ПометкаУдаления";
		
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Возврат Выборка.Ссылка;
		
	КонецЕсли;
	
	ВызватьИсключение СтрШаблон(
		НСтр("ru = 'Не найден узел интеграции для источника ""%1""'"),
		Источник);
	
КонецФункции

#КонецОбласти // СлужебныйПрограммныйИнтерфейс

#Область СлужебныеПроцедурыИФункции

#Область Общее

Функция ПолучитьИмяРеквизитаВыгрузкиУниверсально(ТипРеквизита)
	
	ИмяФункции = пбп_ИнтеграцииШинаПовтИсп.ИменаМетодовИмениРеквизитаВыгрузки()[ТипРеквизита];
	
	Если ИмяФункции = Неопределено Тогда
		
		Возврат "";
		
	КонецЕсли;
	
	Возврат пбп_ИнтеграцииШинаПовтИсп.РезультатПереопределения(ИмяФункции);
	
КонецФункции

Функция ОбъектМетаданныхЯвляетсяПеречислением(МетаданныеОбъекта)
	
	Если МетаданныеОбъекта = Неопределено Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Возврат СтрНачинаетсяС(МетаданныеОбъекта.ПолноеИмя(), "Перечисление.");
	
КонецФункции

Функция ИмяПоляДопустимо(ИмяПоля)
	
	Если ТипЗнч(ИмяПоля) <> Тип("Строка") Или Не ЗначениеЗаполнено(ИмяПоля) Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Части = СтрРазделить(ИмяПоля, ".", Ложь);
	
	Если Части.Количество() = 0 Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Для Каждого Часть Из Части Цикл
		
		Если Не ИмяСегментаДопустимо(Часть) Тогда
			
			Возврат Ложь;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ИмяСегментаДопустимо(Сегмент)
	
	Длина = СтрДлина(Сегмент);
	
	Если Длина = 0 Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Для Позиция = 1 По Длина Цикл
		
		Код = КодСимвола(Сегмент, Позиция);
		ЭтоЛатиница = (Код >= 65 И Код <= 90) Или (Код >= 97 И Код <= 122);
		ЭтоЦифра = Код >= 48 И Код <= 57;
		ЭтоПодчеркивание = Код = 95;
		ЭтоКириллица = (Код >= 1040 И Код <= 1103) Или Код = 1025 Или Код = 1105;
		
		Если Позиция = 1 И ЭтоЦифра Тогда
			
			Возврат Ложь;
			
		КонецЕсли;
		
		Если Не ЭтоЛатиница И Не ЭтоЦифра И Не ЭтоПодчеркивание И Не ЭтоКириллица Тогда
			
			Возврат Ложь;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ИмяПоляЕстьВМетаданных(ПолноеИмяТаблицы, ИмяПоля)
	
	Если Не ИмяПоляДопустимо(ИмяПоля) Или Не ЗначениеЗаполнено(ПолноеИмяТаблицы) Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмяТаблицы);
	
	Если ОбъектМетаданных = Неопределено Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	ИмяРеквизита = СтрРазделить(ИмяПоля, ".", Ложь)[0];
	
	Если ОбъектМетаданных.Реквизиты.Найти(ИмяРеквизита) <> Неопределено Тогда
		
		Возврат Истина;
		
	КонецЕсли;
	
	Для Каждого СтандартныйРеквизит Из ОбъектМетаданных.СтандартныеРеквизиты Цикл
		
		Если СтандартныйРеквизит.Имя = ИмяРеквизита Тогда
			
			Возврат Истина;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЭтоРегистр = Метаданные.РегистрыСведений.Содержит(ОбъектМетаданных)
		Или Метаданные.РегистрыНакопления.Содержит(ОбъектМетаданных);
	
	Если ЭтоРегистр
		И (ОбъектМетаданных.Измерения.Найти(ИмяРеквизита) <> Неопределено
			Или ОбъектМетаданных.Ресурсы.Найти(ИмяРеквизита) <> Неопределено) Тогда
		
		Возврат Истина;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

// Проверяет, что среди типов есть дата.
//
// Параметры:
//  Типы - Массив из Тип - типы реквизита.
//
// Возвращаемое значение:
//  Булево - Истина, если среди типов есть дата.
//
Функция ЭтоДата(Типы)
	
	Для Каждого ПроверяемыйТип Из Типы Цикл
		Если ПроверяемыйТип = Тип("Дата") Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

#Область ПубличныеИдентификаторы

// Описание регистра публичных идентификаторов: регистр БСП либо регистр соответствий ПБП.
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура - Использовать, ЭтоРегистрБСП, ИмяТаблицы, ИмяСсылки,
//                           ИмяИдентификатора, ИмяУзла, ДлинаИдентификатора.
//
Функция ОписаниеРегистраПубличныхИдентификаторов()
	
	Возврат пбп_ИнтеграцииШинаПовтИсп.ОписаниеРегистраПубличныхИдентификаторов();
	
КонецФункции

Функция ИсточникЯвляетсяВладельцемПубличногоИдентификатора(Источник)
	
	Если Не пбп_Переадресация.ЭтоСсылка(ТипЗнч(Источник)) Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	ОписаниеРегистра = ОписаниеРегистраПубличныхИдентификаторов();
	
	Если Не ОписаниеРегистра.Использовать Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	МетаданныеИсточника = Источник.Метаданные();
	
	Если ОписаниеРегистра.ЭтоРегистрБСП Тогда
		
		Возврат Метаданные.ПланыОбмена.Содержит(МетаданныеИсточника);
		
	КонецЕсли;
	
	Возврат МетаданныеИсточника.ПолноеИмя() = "Справочник.пбп_ИнтегрируемыеСистемы";
	
КонецФункции

Функция НайтиСсылкуПоПубличномуИдентификатору(Идентификатор, Источник)
	
	ОписаниеРегистра = ОписаниеРегистраПубличныхИдентификаторов();
	
	Если Не ОписаниеРегистра.Использовать
		Или Не ЗначениеЗаполнено(Идентификатор)
		Или Источник = Неопределено Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	Если ОписаниеРегистра.ЭтоРегистрБСП Тогда
		
		// РегистрСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов
		Возврат НайтиСсылкуВРегистреИдентификаторов(ОписаниеРегистра, Идентификатор, Источник);
		
	КонецЕсли;
	
	// РегистрСведений.пбп_СоответствиеОбъектовИнтегрируемыхСистем
	Возврат НайтиСсылкуВРегистреИдентификаторов(ОписаниеРегистра, Идентификатор, Источник);
	
КонецФункции

Функция НайтиСсылкуВРегистреИдентификаторов(ОписаниеРегистра, Идентификатор, Источник)
	
	Запрос = Новый Запрос;
	Запрос.Текст = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	РегистрИдентификаторов.%1 КАК Ссылка
		|ИЗ
		|	%2 КАК РегистрИдентификаторов
		|ГДЕ
		|	РегистрИдентификаторов.%3 = &Идентификатор
		|	И РегистрИдентификаторов.%4 В (&Источник)",
		ОписаниеРегистра.ИмяСсылки,
		ОписаниеРегистра.ИмяТаблицы,
		ОписаниеРегистра.ИмяИдентификатора,
		ОписаниеРегистра.ИмяУзла);
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	Запрос.УстановитьПараметр("Источник", Источник);
	
	// Служебные данные обмена, чтение не зависит от прав пользователя.
	// При ошибке запроса режим снимается при выходе из функции.
	УстановитьПривилегированныйРежим(Истина);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Если РезультатЗапроса.Пустой() Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Не Выборка.Следующий() Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	Возврат Выборка.Ссылка;
	
КонецФункции

Процедура ЗаписатьПубличныйИдентификатор(Ссылка, Источник, Идентификатор)
	
	ОписаниеРегистра = ОписаниеРегистраПубличныхИдентификаторов();
	
	Если Не ОписаниеРегистра.Использовать
		Или Не ЗначениеЗаполнено(Идентификатор)
		Или Не ЗначениеЗаполнено(Источник) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если ОписаниеРегистра.ЭтоРегистрБСП Тогда
		
		МенеджерРегистра = пбп_Переадресация.МенеджерОбъектаПоПолномуИмени(ОписаниеРегистра.ИмяТаблицы);
		СтруктураЗаписи = Новый Структура;
		СтруктураЗаписи.Вставить(ОписаниеРегистра.ИмяСсылки, Ссылка);
		СтруктураЗаписи.Вставить(ОписаниеРегистра.ИмяУзла, Источник);
		
		Если Не МенеджерРегистра.ЗаписьЕстьВРегистре(СтруктураЗаписи) Тогда
			
			СтруктураЗаписи.Вставить(ОписаниеРегистра.ИмяИдентификатора, Идентификатор);
			МенеджерРегистра.ДобавитьЗапись(СтруктураЗаписи);
			
		КонецЕсли;
		
	Иначе
		
		пбп_ИнтеграцииСервер.СоздатьИзменитьСоответствиеОбъектовИнтегрируемыхСистем(
			Источник, Ссылка, Идентификатор);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаблокироватьПубличныйИдентификатор(Идентификатор)
	
	ОписаниеРегистра = ОписаниеРегистраПубличныхИдентификаторов();
	
	Если Не ОписаниеРегистра.Использовать Или Не ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат;
	КонецЕсли;
	
	БлокировкаДанных = Новый БлокировкаДанных;
	ЭлементБлокировки = БлокировкаДанных.Добавить(ОписаниеРегистра.ИмяТаблицы);
	ЭлементБлокировки.УстановитьЗначение(ОписаниеРегистра.ИмяИдентификатора, Идентификатор);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	БлокировкаДанных.Заблокировать();
	
КонецПроцедуры

// Удаляет зарезервированный публичный идентификатор, если объект так и не был записан.
//
// Параметры:
//  Ссылка - ЛюбаяСсылка - ссылка, зарезервированная без записи объекта.
//  Источник - ПланОбменаСсылка, СправочникСсылка.пбп_ИнтегрируемыеСистемы - владелец идентификатора.
//  Идентификатор - Строка - идентификатор объекта внешней системы.
//
Процедура УдалитьПубличныйИдентификатор(Ссылка, Источник, Идентификатор)
	
	ОписаниеРегистра = ОписаниеРегистраПубличныхИдентификаторов();
	
	Если Не ОписаниеРегистра.Использовать
		Или Не ЗначениеЗаполнено(Идентификатор)
		Или Не ЗначениеЗаполнено(Ссылка)
		Или Не ЗначениеЗаполнено(Источник) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		
		ЗаблокироватьПубличныйИдентификатор(Идентификатор);
		
		Если ОписаниеРегистра.ЭтоРегистрБСП Тогда
			
			МенеджерРегистра = пбп_Переадресация.МенеджерОбъектаПоПолномуИмени(ОписаниеРегистра.ИмяТаблицы);
			НаборЗаписей = МенеджерРегистра.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор[ОписаниеРегистра.ИмяИдентификатора].Установить(Идентификатор);
			НаборЗаписей.Отбор[ОписаниеРегистра.ИмяСсылки].Установить(Ссылка);
			НаборЗаписей.Отбор[ОписаниеРегистра.ИмяУзла].Установить(Источник);
			НаборЗаписей.Записать();
			
		Иначе
			
			пбп_ИнтеграцииСервер.УдалитьСоответствиеОбъектовИнтегрируемыхСистем(
				Источник, Ссылка, Идентификатор);
			
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецПроцедуры

Функция ДополнитьЗапросДаннымиПоПубличномуИдентификаторуКонкатенация(ТекстЗапроса,
	ИмяРеквизита, ПолноеИмяТаблицыИзРеквизита, ПсевдонимИсточника = "Данные", ПроверятьНаNull = Истина)
	
	ОписаниеРегистра = ОписаниеРегистраПубличныхИдентификаторов();
	
	Если Не ОписаниеРегистра.Использовать Тогда
		
		Возврат "Неопределено";
		
	КонецЕсли;
	
	ПсевдонимТаблицы = ИмяРеквизита + "_ПублИдент";
	
	Если ПроверятьНаNull И ЗначениеЗаполнено(ПолноеИмяТаблицыИзРеквизита) Тогда
		
		Поле = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
			"ЕСТЬNULL(%1.%2, ЗНАЧЕНИЕ(%3.ПустаяСсылка))",
			ПсевдонимТаблицы,
			ОписаниеРегистра.ИмяСсылки,
			ПолноеИмяТаблицыИзРеквизита);
		
	Иначе
		
		Поле = ПсевдонимТаблицы + "." + ОписаниеРегистра.ИмяСсылки;
		
	КонецЕсли;
	
	Условие = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
		"%1.%2 = ВЫРАЗИТЬ(%3.%4 КАК СТРОКА(%5))
		|	И %1.%6 В (&Узел)",
		ПсевдонимТаблицы,
		ОписаниеРегистра.ИмяИдентификатора,
		ПсевдонимИсточника,
		ИмяРеквизита,
		ОписаниеРегистра.ДлинаИдентификатора,
		ОписаниеРегистра.ИмяУзла);
	
	ТекстЗапроса = ТекстЗапроса + СтрШаблон("
		|	ЛЕВОЕ СОЕДИНЕНИЕ %1 КАК %2
		|		ПО (%3)", ОписаниеРегистра.ИмяТаблицы, ПсевдонимТаблицы, Условие);
	
	Возврат Поле;
	
КонецФункции

Функция ДополнитьЗапросИнформациейПроИдентификаторы(ТекстЗапроса, Знач Реквизит, СтрокаЗамены = "", ВыражениеПоля = "")
	
	ОписаниеРегистра = ОписаниеРегистраПубличныхИдентификаторов();
	ИмяПоля = Реквизит.Имя;
	ЗапасноеВыражение = ?(ЗначениеЗаполнено(ВыражениеПоля), ВыражениеПоля, "Данные." + ИмяПоля);
	
	Если Не ОписаниеРегистра.Использовать Тогда
		
		Возврат ЗапасноеВыражение;
		
	КонецЕсли;
	
	Если СтрокаЗамены = "" Тогда
		
		СтрокаЗамены = "
		|ГДЕ
		|	Данные.Ссылка = &Ссылка";
		
	КонецЕсли;
	
	ПсевдонимТаблицы = СтрЗаменить(ИмяПоля, ".", "_") + "_ПублИдент";
	УсловиеСвязи = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
		"ЛЕВОЕ СОЕДИНЕНИЕ %1 КАК %2
		|		ПО %3.%4 = Данные.%5
		|		И %3.%6 В (&Узел)",
		ОписаниеРегистра.ИмяТаблицы,
		ПсевдонимТаблицы,
		ПсевдонимТаблицы,
		ОписаниеРегистра.ИмяСсылки,
		ИмяПоля,
		ОписаниеРегистра.ИмяУзла);
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, СтрокаЗамены, "
		|	" + УсловиеСвязи + СтрокаЗамены);
	
	Возврат пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
		"ЕСТЬNULL(%1.%2, %3)", ПсевдонимТаблицы, ОписаниеРегистра.ИмяИдентификатора, ЗапасноеВыражение);
	
КонецФункции

