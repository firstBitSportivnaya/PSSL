КонецФункции

Функция ИмяПредопределенногоДоступно(ОбъектМетаданных, Имя)
	
	Если ОбъектМетаданных = Неопределено Или Не ЗначениеЗаполнено(Имя) Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	ПоддерживаетПредопределенные = Метаданные.Справочники.Содержит(ОбъектМетаданных)
		Или Метаданные.ПланыВидовХарактеристик.Содержит(ОбъектМетаданных)
		Или Метаданные.ПланыСчетов.Содержит(ОбъектМетаданных)
		Или Метаданные.ПланыВидовРасчета.Содержит(ОбъектМетаданных);
	
	Если Не ПоддерживаетПредопределенные Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Возврат ОбъектМетаданных.ПолучитьИменаПредопределенных().Найти(Имя) <> Неопределено;
	
КонецФункции

#КонецОбласти // ЗапросПоОбъекту

// Возвращает пустое состояние загрузки объекта из сообщения.
//
// Возвращаемое значение:
//  Структура - состояние объекта в процессе загрузки:
//   * ЭтоНовый - Булево - объект еще не записан в информационную базу.
//   * БылПроведен - Булево - документ был проведен до заполнения из сообщения.
//   * ТребуетсяПроведение - Булево - после заполнения документ нужно провести.
//
Функция НовоеСостояниеЗагрузки()
	
	СостояниеЗагрузки = Новый Структура;
	СостояниеЗагрузки.Вставить("ЭтоНовый"            , Ложь);
	СостояниеЗагрузки.Вставить("БылПроведен"         , Ложь);
	СостояниеЗагрузки.Вставить("ТребуетсяПроведение" , Ложь);
	
	Возврат СостояниеЗагрузки;
	
КонецФункции

// Запоминает, новый ли объект и был ли документ проведен, до установки ссылки и заполнения из сообщения.
//
// Параметры:
//  ОбъектОбработки - ЛюбойОбъект - объект, полученный для записи.
//  ПараметрыСообщения - Структура - см. ИнициализироватьПараметрыСообщения.
//
Процедура ЗаполнитьСостояниеЗагрузки(ОбъектОбработки, ПараметрыСообщения)
	
	Если Не ПараметрыСообщения.Свойство("СостояниеЗагрузки") Тогда
		ПараметрыСообщения.Вставить("СостояниеЗагрузки", НовоеСостояниеЗагрузки());
	КонецЕсли;
	
	СостояниеЗагрузки = ПараметрыСообщения.СостояниеЗагрузки;
	СостояниеЗагрузки.ЭтоНовый = ОбъектОбработки.ЭтоНовый();
	
	Если КлассОбъектаМенеджера(ПараметрыСообщения.МенеджерОбъекта, ПараметрыСообщения) = "Документ" Тогда
		СостояниеЗагрузки.БылПроведен = ОбъектОбработки.Проведен;
	КонецЕсли;
	
КонецПроцедуры

// Проводит документ после записи. Ошибка проведения дописывается в историю интеграции.
// Если документ был проведен, ошибка отмены проведения добавляется к тому же тексту.
//
// Параметры:
//  ОбъектОбработки - ДокументОбъект - записанный документ.
//  ПараметрыОбмена - Структура - см. ИнициализироватьПараметрыОбмена.
//  ПараметрыСообщения - Структура - см. ИнициализироватьПараметрыСообщения.
//  СостояниеЗагрузки - Структура - см. НовоеСостояниеЗагрузки.
//
Процедура ПровестиЗагруженныйДокумент(ОбъектОбработки, ПараметрыОбмена, ПараметрыСообщения, СостояниеЗагрузки)
	
	Если КлассОбъектаМенеджера(ПараметрыСообщения.МенеджерОбъекта, ПараметрыСообщения) <> "Документ"
		Или Не СостояниеЗагрузки.ТребуетсяПроведение
		Или ПараметрыСообщения.ОбменДаннымиЗагрузка Тогда
		
		Возврат;
		
	КонецЕсли;
	
	// Ошибка проведения не откатывает уже записанный объект и видна вызывающему коду.
	//BSLLS:MissingCodeTryCatchEx-off
	Попытка
		
		ОбъектОбработки.Записать(РежимЗаписиДокумента.Проведение);
		
	Исключение
		
		ТекстОшибкиПроведения = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		
		Если СостояниеЗагрузки.БылПроведен Тогда
			
			Попытка
				
				ОбъектОбработки.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				
			Исключение
				
				ТекстОшибкиПроведения = ТекстОшибкиПроведения + Символы.ПС
					+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				
			КонецПопытки;
			
		КонецЕсли;
		
		ПараметрыОбмена.ТекстОшибки = ТекстОшибкиПроведения;
		ВызватьИсключение ПараметрыОбмена.ТекстОшибки;
		
	КонецПопытки;
	//BSLLS:MissingCodeTryCatchEx-on
	
КонецПроцедуры

Функция КонтекстЗаполненияОбъектаПоОбъектуXDTO(Поток)
	
	Контекст = Новый Структура("ПоляИсключения,
	|СоответствиеПолейИсточникаИПриемника,СоответствиеТиповПолей,ПоляПоиска");
	
	Контекст.ПоляИсключения = ПоляНеОбрабатываемыеУниверсальнойЗагрузкой(Поток);
	Контекст.СоответствиеПолейИсточникаИПриемника = СоответствиеПолейИсточникаИПриемника(Поток);
	Контекст.СоответствиеТиповПолей = СформироватьСоответствиеТиповПолей(Поток);
	Контекст.ПоляПоиска = СформироватьПоляПоиска(Поток);
	ДополнитьПоляПоискаИзСоответствияПолей(Контекст.ПоляПоиска, Контекст.СоответствиеПолейИсточникаИПриемника);
	
	Возврат Контекст;
	
КонецФункции

Процедура ДобавитьПоляНомерИКодВПоляИсключенияПоиска(КонтекстЗаполнения, НумерацияПриемника)
	
	Если Не НумерацияПриемника Тогда

		Возврат;

	КонецЕсли;
	
	Если КонтекстЗаполнения.ПоляИсключения.Получить("Номер") = Неопределено Тогда
		КонтекстЗаполнения.ПоляИсключения.Вставить("Номер", Истина);
	КонецЕсли;
	Если КонтекстЗаполнения.ПоляИсключения.Получить("Код") = Неопределено Тогда
		КонтекстЗаполнения.ПоляИсключения.Вставить("Код", Истина);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОпределитьИдентификаторыСообщения(СоответствиеПолейИсточникаИПриемника, ПараметрыСообщения)
	
	ИДСтрокой = ПолучитьЗначениеИзСоответствияИсточникаИПриемника(
		СоответствиеПолейИсточникаИПриемника, "Ссылка");
	Если Не ЗначениеЗаполнено(ИДСтрокой) Тогда
		ИДСтрокой = "Ссылка";
	КонецЕсли;
	
	Если ПараметрыСообщения.ОбъектXDTO.Свойства().Получить(ИДСтрокой) <> Неопределено Тогда
		ПараметрыСообщения.СсылкаИзXDTO = ПараметрыСообщения.ОбъектXDTO[ИДСтрокой];
		Если Не ЗначениеЗаполнено(ПараметрыСообщения.Идентификатор) Тогда
			ПараметрыСообщения.Идентификатор = ПараметрыСообщения.СсылкаИзXDTO;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьПравилаПоискаСсылки(КонтекстЗаполнения, ПараметрыСообщения)
	
	ИмяПоляПоискаИдентификатора = ИмяПоляПоискаПоВнешнемуИдентификатору();
	СтруктураПоискаСсылки = ПодготовитьСтруктуруПоискаСсылки(
		КонтекстЗаполнения, ПараметрыСообщения.ОбъектXDTO, ПараметрыСообщения.СсылкаИзXDTO);
	ПараметрыСообщения.СсылкаЯвляетсяВнешнимИдентификатором = СтруктураПоискаСсылки[ИмяПоляПоискаИдентификатора] <> Неопределено;
	
	// по умолчанию ищем по внешней ссылке
	Если СтруктураПоискаСсылки.Количество() = 0 Тогда
		ПроверяемыйТип = ТипЗнч(ПараметрыСообщения.МенеджерОбъекта.ПустаяСсылка());
		ПоляПоиска = ПолучитьИмяРеквизитаВыгрузкиУниверсально(ПроверяемыйТип);
		
		ПараметрыСообщения.СсылкаЯвляетсяВнешнимИдентификатором = Истина;
		СтруктураПоискаСсылки.Вставить(ИмяПоляПоискаИдентификатора, ПараметрыСообщения.СсылкаИзXDTO);
		СтруктураПоискаСсылки.Вставить(ИмяПоляПоискаПоВнутреннемуИдентификатору(), ПараметрыСообщения.СсылкаИзXDTO);
		
		Если СтруктураПоискаСсылки.Получить(ПоляПоиска) = Неопределено
			И Не ПараметрыСообщения.ОбъектXDTO.Свойства().Получить(ПоляПоиска) = Неопределено Тогда
			
			СтруктураПоискаСсылки.Вставить(ПоляПоиска, ПараметрыСообщения.ОбъектXDTO[ПоляПоиска]);
		КонецЕсли;
	КонецЕсли;
	
	Если ПараметрыСообщения.ОбъектXDTO.Свойства().Получить("ЭтоГруппа") <> Неопределено Тогда
		ПараметрыСообщения.ЭтоГруппа = ПараметрыСообщения.ОбъектXDTO.ЭтоГруппа;
	КонецЕсли;
	
	Возврат СтруктураПоискаСсылки;
	
КонецФункции

// Готовит текст ошибки загрузки и снимает резерв идентификатора, если объект не записан.
//
// Параметры:
//  ОбъектОбработки - ЛюбойОбъект, Неопределено - объект, если его успели получить.
//  Статус - ПеречислениеСсылка.пбп_СозданОбновлен, Неопределено - создан или обновлен.
//  ПараметрыОбмена - Структура - см. ИнициализироватьПараметрыОбмена.
//                    СтруктураИстории и Источник читаются из структуры,
//                    Задержка и ТекстОшибки записываются в неё.
//  ПараметрыСообщения - Структура - см. ИнициализироватьПараметрыСообщения.
//                       СсылкаИзXDTO и СостояниеЗагрузки читаются из структуры.
//  ОписаниеОшибки - ИнформацияОбОшибке - ошибка загрузки.
//
// Возвращаемое значение:
//  Булево - Истина, если сообщение нужно отложить из-за блокировки объекта.
//
Функция ОшибкаЗагрузкиТребуетПовтора(ОбъектОбработки, Статус, ПараметрыОбмена,
	ПараметрыСообщения, ОписаниеОшибки)
	
	СтруктураИсторииИнтеграции = ПараметрыОбмена.СтруктураИстории;
	Источник = ПараметрыОбмена.Источник;
	ИдентификаторРезерва = ПараметрыСообщения.СсылкаИзXDTO;
	
	Если Не ОбъектОбработки = Неопределено Тогда
		
		НовыйОбъект = СтруктураИсторииИнтеграции.ОбъектыИнтеграции.Добавить();
		НовыйОбъект.ОбъектИнтеграции	= ОбъектОбработки.Ссылка;
		НовыйОбъект.Идентификатор		= ИдентификаторРезерва;
		НовыйОбъект.СозданОбновлен		= Статус;
		
	КонецЕсли;
	
	ПараметрыОбмена.ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ОписаниеОшибки);
	
	Сообщения = ПолучитьСообщенияПользователю(Истина);
	Части = Новый Массив;
	Части.Добавить(ПараметрыОбмена.ТекстОшибки);
	
	Для Каждого Сообщение Из Сообщения Цикл
		
		Части.Добавить(Сообщение.Текст);
		
	КонецЦикла;
	
	ПараметрыОбмена.ТекстОшибки = СтрСоединить(Части, Символы.ПС);
	
	Если СтрНайти(НРег(ПараметрыОбмена.ТекстОшибки), "невозможно заблокировать") > 0 Тогда
		
		ПараметрыОбмена.Задержка = 30;
		Возврат Истина;
		
	КонецЕсли;
	
	Если Не ОбъектОбработки = Неопределено
		И ПараметрыСообщения.СостояниеЗагрузки.ЭтоНовый
		И Не СсылкаСуществует(ОбъектОбработки.Ссылка) Тогда
		
		Попытка
			
			УдалитьПубличныйИдентификатор(
				ОбъектОбработки.Ссылка, Источник, ИдентификаторРезерва);
			
		Исключение
			
			ПараметрыОбмена.ТекстОшибки = ПараметрыОбмена.ТекстОшибки + Символы.ПС
				+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ВызватьИсключение ПараметрыОбмена.ТекстОшибки;
			
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

// Создает объект по классу метаданных и записывает его в Результат.ОбъектОбработки.
// Для неподдерживаемого класса заполняет Результат.ТекстОшибки.
//
// Параметры:
//  Результат - Структура - поля ОбъектОбработки и ТекстОшибки.
//  МенеджерОбъекта - МодульМенеджераОбъекта - менеджер создаваемого объекта.
//  КлассОбъекта - Строка - класс метаданных: Справочник, Документ, Задача и другие.
//  ЭтоГруппа - Булево - создать группу справочника или плана видов характеристик.
//
Процедура УстановитьНовыйОбъектОбработки(Результат, МенеджерОбъекта, КлассОбъекта, ЭтоГруппа)
	
	Если КлассОбъекта = "Справочник" Или КлассОбъекта = "ПланВидовХарактеристик" Тогда
		
		Если ЭтоГруппа Тогда
			
			ОбъектОбработки = МенеджерОбъекта.СоздатьГруппу();
			
		Иначе
			
			ОбъектОбработки = МенеджерОбъекта.СоздатьЭлемент();
			
		КонецЕсли;
		
		Результат.ОбъектОбработки = ОбъектОбработки;
		
	ИначеЕсли КлассОбъекта = "Документ" Тогда
		
		ОбъектОбработки = МенеджерОбъекта.СоздатьДокумент();
		Результат.ОбъектОбработки = ОбъектОбработки;
		
	ИначеЕсли КлассОбъекта = "Задача" Тогда
		
		ОбъектОбработки = МенеджерОбъекта.СоздатьЗадачу();
		Результат.ОбъектОбработки = ОбъектОбработки;
		
	Иначе
		
		Результат.ТекстОшибки = НСтр("ru = 'пришел не поддерживаемый тип объекта'");
		
	КонецЕсли;
	
КонецПроцедуры

Функция СсылкаПоЕдинственномуВнутреннемуИдентификатору(Менеджер, ПоляПоиска,
	ИмяВнутреннегоИдентификатора, ПроверкаСуществования)
	
	СсылкаПоИдентификатору = СсылкаПоВнутреннемуИдентификатору(
		Менеджер, ПоляПоиска[ИмяВнутреннегоИдентификатора]);
	Существует = ЗначениеЗаполнено(СсылкаПоИдентификатору)
		И СсылкаСуществует(СсылкаПоИдентификатору);
	ЗафиксироватьПроверкуСуществованияСсылки(
		ПроверкаСуществования, СсылкаПоИдентификатору, Существует);
	
	Если Существует Тогда
		
		Возврат СсылкаПоИдентификатору;
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Процедура ЗаблокироватьСсылкуОбъекта(СсылкаНаЭлемент)
	
	Если Не ТранзакцияАктивна() Или Не ЗначениеЗаполнено(СсылкаНаЭлемент) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	БлокировкаДанных = Новый БлокировкаДанных;
	ЭлементБлокировки = БлокировкаДанных.Добавить(СсылкаНаЭлемент.Метаданные().ПолноеИмя());
	ЭлементБлокировки.УстановитьЗначение("Ссылка", СсылкаНаЭлемент);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	БлокировкаДанных.Заблокировать();
	
КонецПроцедуры

Функция ПоискТолькоПоВнутреннемуИдентификатору(ПоляПоиска, ИмяВнутреннегоИдентификатора)
	
	Если ПоляПоиска.Количество() <> 1 Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	ЗначениеПоля = ПоляПоиска[ИмяВнутреннегоИдентификатора];
	ТипЗначения = ТипЗнч(ЗначениеПоля);
	
	Возврат ЗначениеПоля <> Неопределено
		И ТипЗначения <> Тип("Соответствие")
		И ТипЗначения <> Тип("Структура");
	
КонецФункции

Процедура ЗафиксироватьПроверкуСуществованияСсылки(ПроверкаСуществования, Ссылка, Существует)
	
	Если ПроверкаСуществования = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ПроверкаСуществования.Проверена = Истина;
	ПроверкаСуществования.Существует = Существует;
	ПроверкаСуществования.Ссылка = Ссылка;
	
КонецПроцедуры

Функция МетаданныеОбъектаСообщения(ПараметрыСообщения, МенеджерОбъекта)
	
	Если ПараметрыСообщения <> Неопределено
		И ПараметрыСообщения.Свойство("МетаданныеОбъекта")
		И ТипЗнч(ПараметрыСообщения.МетаданныеОбъекта) = Тип("Структура")
		И ПараметрыСообщения.МетаданныеОбъекта.Свойство("Класс") Тогда
		
		Возврат ПараметрыСообщения.МетаданныеОбъекта;
		
	КонецЕсли;
	
	МетаданныеОбъекта = ОпределитьМетаданныеОбъекта(МенеджерОбъекта);
	
	Если ПараметрыСообщения <> Неопределено
		И ТипЗнч(МетаданныеОбъекта) = Тип("Структура") Тогда
		
		ПараметрыСообщения.Вставить("МетаданныеОбъекта", МетаданныеОбъекта);
		
	КонецЕсли;
	
	Возврат МетаданныеОбъекта;
	
КонецФункции

Функция КлассОбъектаМенеджера(МенеджерОбъекта, ПараметрыСообщения = Неопределено)
	
	Возврат МетаданныеОбъектаСообщения(ПараметрыСообщения, МенеджерОбъекта).Класс;
	
КонецФункции

Функция СтандартныеРеквизитыПоИмени(МетаОбъекта)
	
	Результат = Новый Соответствие;
	
	Для Каждого Реквизит Из МетаОбъекта.СтандартныеРеквизиты Цикл
		
		Результат.Вставить(Реквизит.Имя, Реквизит);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ЗначениеРеквизитаПослеЗагрузки(Значение, Реквизит, ВыгружатьУниверсальноеВремя, ЧасовойПоясБазы)
	
	Если Не ВыгружатьУниверсальноеВремя
		Или Реквизит = Неопределено
		Или Не ЭтоДата(Реквизит.Тип.Типы()) Тогда
		
		Возврат Значение;
		
	КонецЕсли;
	
	Возврат пбп_ИнтеграцииСервер.ПреобразоватьДатуПоУниверсальномуВремени(
		Значение,
		Реквизит.Тип.КвалификаторыДаты.ЧастиДаты,
		ЧасовойПоясБазы,
		Истина);
	
КонецФункции

Функция КолонкиДатТабличнойЧасти(Колонки, РеквизитТЧ, ВыгружатьУниверсальноеВремя)
	
	Результат = Новый Массив;
	
	Если Не ВыгружатьУниверсальноеВремя Или РеквизитТЧ = Неопределено Тогда
		
		Возврат Результат;
		
	КонецЕсли;
	
	Для Каждого Колонка Из Колонки Цикл
		
		Реквизит = РеквизитТЧ.Реквизиты.Найти(Колонка.Имя);
		
		Если Реквизит = Неопределено Или Не ЭтоДата(Реквизит.Тип.Типы()) Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		ОписаниеКолонки = Новый Структура;
		ОписаниеКолонки.Вставить("Имя", Реквизит.Имя);
		ОписаниеКолонки.Вставить("ЧастиДаты", Реквизит.Тип.КвалификаторыДаты.ЧастиДаты);
		Результат.Добавить(ОписаниеКолонки);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ОпределитьМетаданныеОбъекта(МенеджерОбъекта)
	
	Результат = Новый Структура("ПолноеИмя,Класс,Объект");
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗнч(МенеджерОбъекта));
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Результат.ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
	
	ПозицияРазделителя = СтрНайти(Результат.ПолноеИмя, ".");
	Результат.Класс = Лев(Результат.ПолноеИмя, ПозицияРазделителя-1);
	Результат.Объект = Сред(Результат.ПолноеИмя, ПозицияРазделителя+1, СтрДлина(Результат.ПолноеИмя) - ПозицияРазделителя);
	
	Возврат Результат
	
КонецФункции

Процедура ЗаполнитьОбъектПоОбъектуXDTO(ОбъектОбработки, ПараметрыОбмена, ПараметрыСообщения, КонтекстЗаполнения)
	
	ИспользоватьУниверсальноеЗаполнение = ПараметрыОбмена.УниверсальноеЗаполнение;
	Источник = ПараметрыОбмена.Источник;
	ОбъектXDTO = ПараметрыСообщения.ОбъектXDTO;
	
	Если Не ИспользоватьУниверсальноеЗаполнение Тогда
		Возврат;
	КонецЕсли;
	
	ВыгружатьУниверсальноеВремя = Ложь;
	
	МетаОбъекта = ОбъектОбработки.Метаданные();
	
	СвойстваXDTO = ОбъектXDTO.Свойства();
	
	ТекстыЗапросовГлобальный = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Заглушка", "");
	Запрос.УстановитьПараметр("Узел", Источник);
	
	ЧасовойПоясБазы = пбп_ИнтеграцииШинаПовтИсп.ЧасовойПоясБазыДанных();
	
	Результат = ДополнитьЗапросДинамическимиДаннымиШапки(МетаОбъекта,
		ОбъектXDTO,
		СвойстваXDTO,
		КонтекстЗаполнения);
	ТекстыЗапросовГлобальный.Добавить(Результат.ТекстЗапроса);
	
	РезультатДополненияТабличнымиЧастями = ДополнитьЗапросДинамическимиДаннымиТабличныхЧастей(МетаОбъекта,
		ОбъектXDTO,
		СвойстваXDTO,
		КонтекстЗаполнения);
	пбп_ПереадресацияКлиентСервер.ДополнитьМассив(ТекстыЗапросовГлобальный, РезультатДополненияТабличнымиЧастями.ТекстыЗапроса);
	
	пбп_ПереадресацияКлиентСервер.ДополнитьСтруктуру(Результат.ПараметрыЗапроса,
		РезультатДополненияТабличнымиЧастями.ПараметрыЗапроса);
	
	Для Каждого Пара Из Результат.ПараметрыЗапроса Цикл
		Запрос.УстановитьПараметр(Пара.Ключ, Пара.Значение);
	КонецЦикла;
	
	Запрос.Текст = СтрСоединить(ТекстыЗапросовГлобальный, пбп_Переадресация.РазделительПакетаЗапросов());
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	РеквизитыИсключения = РеквизитыИсключенияЗаполнения();
	РеквизитыПоИмени = Неопределено;
	
	Если ВыгружатьУниверсальноеВремя Тогда
		
		РеквизитыПоИмени = СтандартныеРеквизитыПоИмени(МетаОбъекта);
		
	КонецЕсли;
	
	ВыборкаШапка = РезультатыЗапроса[1].Выбрать();
	
	Пока ВыборкаШапка.Следующий() Цикл
		
		Если Не РеквизитыИсключения.Найти(ВыборкаШапка.ИмяРеквизита) = Неопределено Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		ЗначениеРеквизита = ВыборкаШапка.Значение;
		
		Если ВыгружатьУниверсальноеВремя Тогда
			
			Реквизит = РеквизитыПоИмени[ВыборкаШапка.ИмяРеквизита];
			
			Если Реквизит = Неопределено Тогда
				
				Реквизит = МетаОбъекта.Реквизиты.Найти(ВыборкаШапка.ИмяРеквизита);
				
			КонецЕсли;
			
			ЗначениеРеквизита = ЗначениеРеквизитаПослеЗагрузки(
				ЗначениеРеквизита, Реквизит, ВыгружатьУниверсальноеВремя, ЧасовойПоясБазы);
			
		КонецЕсли;
		
		ОбъектОбработки[ВыборкаШапка.ИмяРеквизита] = ЗначениеРеквизита;
		
	КонецЦикла;
	
	Сч = 3;
	СчТЧ = 0;
	
	Пока Сч <= РезультатыЗапроса.ВГраница() Цикл
		
		ИмяТабличнойЧасти = РезультатДополненияТабличнымиЧастями.ПорядокТабличныхЧастей[СчТЧ];
		ТабличнаяЧасть = ОбъектОбработки[ИмяТабличнойЧасти];
		ТабличнаяЧасть.Очистить(); // в последующем будем и обновлять строки
		
		РеквизитТЧ = МетаОбъекта.ТабличныеЧасти.Найти(ИмяТабличнойЧасти);
		КолонкиДат = КолонкиДатТабличнойЧасти(
			РезультатыЗапроса[Сч].Колонки, РеквизитТЧ, ВыгружатьУниверсальноеВремя);
		
		ВыборкаТабличнаяЧасть = РезультатыЗапроса[Сч].Выбрать();
		
		Пока ВыборкаТабличнаяЧасть.Следующий() Цикл
			
			нСтрока = ТабличнаяЧасть.Добавить();
			ЗаполнитьЗначенияСвойств(нСтрока, ВыборкаТабличнаяЧасть);
			
			Для Каждого КолонкаДаты Из КолонкиДат Цикл
				
				нСтрока[КолонкаДаты.Имя] = пбп_ИнтеграцииСервер.ПреобразоватьДатуПоУниверсальномуВремени(
					нСтрока[КолонкаДаты.Имя], КолонкаДаты.ЧастиДаты, ЧасовойПоясБазы, Истина);
				
			КонецЦикла;
			
		КонецЦикла;
		
		Сч = Сч + 2;
		СчТЧ = СчТЧ + 1;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПодготовитьСтруктуруПоискаСсылки(КонтекстЗаполнения, ОбъектXDTO, СсылкаИзXDTO)
	
	СвойстваXDTO = ОбъектXDTO.Свойства();
	ПоляПоискаСсылки = КонтекстЗаполнения.ПоляПоиска["Ссылка"];
	СтруктураПоиска = Новый Соответствие;
	
	Если Не ЗначениеЗаполнено(ПоляПоискаСсылки) Тогда
		
		Возврат СтруктураПоиска;
		
	КонецЕсли;
	
	ИмяВнешнегоИдентификатора = ИмяПоляПоискаПоВнешнемуИдентификатору();
	ИмяВнутреннегоИдентификатора = ИмяПоляПоискаПоВнутреннемуИдентификатору();
	
	Для Каждого Поле Из ПоляПоискаСсылки Цикл
		
		Если ЭтоГруппаПолейПоиска(Поле) Тогда
			
			ЗначенияГруппы = ЗначенияГруппыПолейИзXDTO(
				Поле.Поля, КонтекстЗаполнения, СвойстваXDTO, ОбъектXDTO);
			
			Если ЗначенияГруппы <> Неопределено Тогда
				
				СтруктураПоиска.Вставить(КлючГруппыПолейПоиска(Поле.Поля), ЗначенияГруппы);
				
			КонецЕсли;
			
		ИначеЕсли Поле = ИмяВнешнегоИдентификатора Тогда
			
			СтруктураПоиска.Вставить(Поле, СсылкаИзXDTO);
			
		ИначеЕсли Поле = ИмяВнутреннегоИдентификатора Тогда
			
			ИмяИзИсточника = ИмяПоляИсточникаДляПоиска(
				КонтекстЗаполнения.СоответствиеПолейИсточникаИПриемника, "Ссылка", Поле);
			
			Если СвойстваXDTO.Получить(ИмяИзИсточника) <> Неопределено Тогда
				
				СтруктураПоиска.Вставить(Поле, ОбъектXDTO[ИмяИзИсточника]);
				
			КонецЕсли;
			
		Иначе
			
			ИмяИзИсточника = ИмяПоляИсточникаДляПоиска(
				КонтекстЗаполнения.СоответствиеПолейИсточникаИПриемника, Поле, Поле);
			
			Если СвойстваXDTO.Получить(ИмяИзИсточника) <> Неопределено Тогда
				
				СтруктураПоиска.Вставить(Поле, ОбъектXDTO[ИмяИзИсточника]);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СтруктураПоиска;
	
КонецФункции

Функция ИмяПоляИсточникаДляПоиска(СоответствиеПолей, КлючПоиска, ИмяПоУмолчанию)
	
	Значение = ПолучитьЗначениеИзСоответствияИсточникаИПриемника(СоответствиеПолей, КлючПоиска);
	
	Возврат ?(ЗначениеЗаполнено(Значение), Значение, ИмяПоУмолчанию);
	
КонецФункции

Функция ЗначенияГруппыПолейИзXDTO(ИменаПолей, КонтекстЗаполнения, СвойстваXDTO, ОбъектXDTO)
	
	Если ИменаПолей.Количество() = 0 Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	ЗначенияГруппы = Новый Соответствие;
	ПоляСсылки = КонтекстЗаполнения.СоответствиеПолейИсточникаИПриемника["Ссылка"];
	
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		
		Если ИмяПоляЯвляетсяИдентификаторомПоиска(ИмяПоля) Тогда
			
			Возврат Неопределено;
			
		КонецЕсли;
		
		ИмяИзИсточника = "";
		
		Если ТипЗнч(ПоляСсылки) = Тип("Соответствие")
			И ТипЗнч(ПоляСсылки[ИмяПоля]) = Тип("Строка") Тогда
			
			ИмяИзИсточника = ПоляСсылки[ИмяПоля];
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ИмяИзИсточника) Тогда
			
			ИмяИзИсточника = ИмяПоляИсточникаДляПоиска(
				КонтекстЗаполнения.СоответствиеПолейИсточникаИПриемника, ИмяПоля, ИмяПоля);
			
		КонецЕсли;
		
		Если СвойстваXDTO.Получить(ИмяИзИсточника) = Неопределено Тогда
			
			Возврат Неопределено;
			
		КонецЕсли;
		
		ЗначениеПоля = ЗначениеПараметраИзXDTO(ОбъектXDTO[ИмяИзИсточника], Ложь);
		ЗначенияГруппы.Вставить(ИмяПоля, ЗначениеПоля);
		
	КонецЦикла;
	
	Возврат ЗначенияГруппы;
	
КонецФункции

Процедура ЗаполнитьИсточникОбъекта(ОбъектОбработки, Узел)
	
	Если Не пбп_ПереадресацияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ОбъектОбработки, "ЗагруженоИз")
		Или Не ЗначениеЗаполнено(Узел) Тогда
		
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры

Функция РеквизитыИсключенияЗаполнения()
	
	МассивИсключений = Новый Массив;
	МассивИсключений.Добавить("ЭтоГруппа");
	
	Возврат МассивИсключений;
	
КонецФункции

Функция СсылкаСуществует(Ссылка)
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК Поле1
	|ИЗ
	|	#Таблица КАК Таблица
	|ГДЕ
	|	Таблица.Ссылка = &Ссылка";
	
	Запрос = Новый Запрос;
	Запрос.Текст = СтрЗаменить(ТекстЗапроса, "#Таблица", Ссылка.Метаданные().ПолноеИмя());
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Функция ЭтоСтандартныйРеквизит(СтандартныеРеквизиты, ИмяРеквизита)
	
	Для Каждого Реквизит Из СтандартныеРеквизиты Цикл
		
		Если Реквизит.Имя = ИмяРеквизита Тогда
			
			Возврат Истина;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция СсылкаПоВнутреннемуИдентификатору(МенеджерОбъекта, Идентификатор)
	
	Если пбп_Переадресация.ЭтоСсылка(ТипЗнч(Идентификатор)) Тогда
		
		Возврат Идентификатор;
		
	КонецЕсли;
	
	Если Не пбп_ИнтеграцииСлужебный.ЭтоУникальныйИдентификатор(Идентификатор) Тогда
		
		Возврат МенеджерОбъекта.ПустаяСсылка();
		
	КонецЕсли;
	
	Возврат МенеджерОбъекта.ПолучитьСсылку(Новый УникальныйИдентификатор(Строка(Идентификатор)));
	
КонецФункции

Функция НайтиПоИдентификаторуПоУмолчанию(Менеджер, Идентификатор, Источник, ПроверкаСуществования = Неопределено)
	
	Если ИсточникЯвляетсяВладельцемПубличногоИдентификатора(Источник) Тогда
		
		Ссылка = НайтиСсылкуПоПубличномуИдентификатору(Идентификатор, Источник);
		
		Если Ссылка <> Неопределено Тогда
			
			Возврат Ссылка;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не пбп_ИнтеграцииСлужебный.ЭтоУникальныйИдентификатор(Идентификатор) Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	Ссылка = СсылкаПоВнутреннемуИдентификатору(Менеджер, Идентификатор);
	Существует = ЗначениеЗаполнено(Ссылка) И СсылкаСуществует(Ссылка);
	ЗафиксироватьПроверкуСуществованияСсылки(ПроверкаСуществования, Ссылка, Существует);
	
	Если Существует Тогда
		
		Возврат Ссылка;
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Процедура ДобавитьЗначениеПоКлючуПоля(Результат, Ключ, Значение)
	
	Части = СтрРазделить(Ключ, ".", Ложь);
	
	Если Части.Количество() = 1 Тогда
		
		Результат.Вставить(Части[0], Значение);
		Возврат;
		
	КонецЕсли;
	
	ИмяТабличнойЧасти = Части[0];
	ИмяРеквизита = Части[1];
	ВложенныеЗначения = Результат[ИмяТабличнойЧасти];
	
	Если ВложенныеЗначения = Неопределено Тогда
		
		ВложенныеЗначения = Новый Соответствие;
		Результат.Вставить(ИмяТабличнойЧасти, ВложенныеЗначения);
		
	КонецЕсли;
	
	ВложенныеЗначения.Вставить(ИмяРеквизита, Значение);
	
КонецПроцедуры

