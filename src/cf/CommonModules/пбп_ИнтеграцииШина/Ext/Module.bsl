#Область УниверсальнаяВыгрузка

Процедура ДополнитьПолеВыгрузкиУниверсально(Поля, Реквизит, ИсключенияТипов, ЗначениеОбъекта, ВыгружатьУниверсальноеВремя = Ложь)
	ТипыРеквизита = Реквизит.Тип.Типы();
	Если ТипыРеквизита.Количество() = 0 Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ЭтоДата = ЭтоДата(Реквизит.Тип.Типы());
	Если ЭтоДата И ВыгружатьУниверсальноеВремя Тогда
		ЧастиДатыЗначение = Реквизит.Тип.КвалификаторыДаты.ЧастиДаты;
	Иначе
		ЧастиДатыЗначение = Неопределено;
	КонецЕсли;
	
	ВыгрузитьКакПубличныйИдентификатор = Ложь;
	Для Каждого ПроверяемыйТип Из ТипыРеквизита Цикл
		Если пбп_Переадресация.ЭтоСсылка(ПроверяемыйТип)
				И Не ОбъектМетаданныхЯвляетсяПеречислением(Метаданные.НайтиПоТипу(ПроверяемыйТип)) Тогда
			ВыгрузитьКакПубличныйИдентификатор = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	// Если составной тип, то выгружаем без преобразований
	Если ТипыРеквизита.Количество() > 1 Тогда
		Если ЗначениеОбъекта <> Неопределено Тогда
			СоставнойТип = Истина;
			ТипРеквизита = ТипЗнч(ЗначениеОбъекта);
		Иначе
			ДополнитьПоляПолемСТипом(Поля, Реквизит.Имя,,,, ВыгрузитьКакПубличныйИдентификатор, Истина, ЧастиДатыЗначение);
			Возврат;
		КонецЕсли;
	Иначе
		СоставнойТип = Ложь;
		ТипРеквизита = ТипыРеквизита[0];
	КонецЕсли;

	Если Не пбп_Переадресация.ЭтоСсылка(ТипРеквизита) Тогда
		Если ТипРеквизита = Тип("Дата") Тогда
			ДополнитьПоляПолемСТипом(Поля, Реквизит.Имя,,,,,, ЧастиДатыЗначение);
		Иначе
			ДополнитьПоляПолемСТипом(Поля, Реквизит.Имя,,,,,, ЧастиДатыЗначение);
		КонецЕсли;
		
		Возврат;
	ИначеЕсли Не ОбъектМетаданныхЯвляетсяПеречислением(Метаданные.НайтиПоТипу(ТипРеквизита)) Тогда
		ВыгрузитьКакПубличныйИдентификатор = Истина;
	КонецЕсли;
	
	ЗначениеИсключения = ИсключенияТипов.Получить(ТипРеквизита);
	Если ЗначениеИсключения = Неопределено Тогда
		ИмяРеквизитаСопоставления = ПолучитьИмяРеквизитаВыгрузкиУниверсально(ТипРеквизита);
	Иначе
		ИмяРеквизитаСопоставления = ЗначениеИсключения;
	КонецЕсли;
	
	ЗначениеПоля = Реквизит.Имя;
	Если ЗначениеЗаполнено(ИмяРеквизитаСопоставления) Тогда
		Если ИмяРеквизитаСопоставления = "ВнешнийИдентификатор" Тогда
			ВыгрузитьКакПубличныйИдентификатор = Истина;
		Иначе
			ВыгрузитьКакПубличныйИдентификатор = Ложь;
			
			ЗначениеПоля = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
				"%1.%2", Реквизит.Имя, ИмяРеквизитаСопоставления);
		КонецЕсли;
	КонецЕсли;
	
	ДополнитьПоляПолемСТипом(
		Поля, ЗначениеПоля, Реквизит.Имя, ТипРеквизита, ,
		ВыгрузитьКакПубличныйИдентификатор, СоставнойТип, ЧастиДатыЗначение);
	
КонецПроцедуры

#КонецОбласти // УниверсальнаяВыгрузка

#Область ЗапросПоОбъекту

Функция ТекстЗапросаРеквизитовОбъекта(ПространствоИмен, Реквизиты, ЭтоРегистр, ОтборыРегистра)
	
	КлючевоеПоле = "Ссылка";
	ПолеЗапросаСсылка = "Данные." + КлючевоеПоле + " КАК Ссылка";
	ШаблонЗапроса =
	"ВЫБРАТЬ
	|	" + ПолеЗапросаСсылка + "
	|ИЗ
	|	%1 КАК Данные
	|ГДЕ
	|	Данные.Ссылка = &Ссылка";

	Если ЭтоРегистр Тогда
		
		Если Реквизиты.Количество() = 0 Тогда
			
			ВызватьИсключение НСтр("ru = 'Не заданы реквизиты для выгрузки регистра.'");
			
		КонецЕсли;
		
		Инкремент = 0;
		Выражение = Неопределено;
		
		Для Каждого РеквизитЭлемент Из Реквизиты Цикл
			
			Если Не ЗначениеЗаполнено(РеквизитЭлемент.Тип) Тогда
				
				Выражение = ПолучитьВыражениеПоля(РеквизитЭлемент);
				Прервать;
				
			КонецЕсли;
			
			Инкремент = Инкремент + 1;
			
		КонецЦикла;
		
		Если Выражение = Неопределено Тогда
			
			Инкремент = 0;
			ИмяКлюча = СтрРазделить(Реквизиты[0].Имя, ".", Ложь)[0];
			Выражение = Новый Структура("Значение, Псевдоним", ИмяКлюча, ИмяКлюча);
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Выражение.Псевдоним) Тогда
			
			Выражение.Псевдоним = Выражение.Значение;
			
		КонецЕсли;
		
		КлючевоеПоле = Выражение.Значение;
		ПолеЗапросаКлюча = СтрШаблон("Данные.%1 КАК %2", Выражение.Значение, Выражение.Псевдоним);
		ШаблонЗапроса = СтрЗаменить(ШаблонЗапроса, ПолеЗапросаСсылка, ПолеЗапросаКлюча);
		Реквизиты.Удалить(Инкремент);
		
		Если ОтборыРегистра.Количество() Тогда
			
			УсловияПоОтборам = Новый Массив;
			
			Для Каждого Отбор Из ОтборыРегистра Цикл
				
				Если ИмяПоляЕстьВМетаданных(ПространствоИмен, Отбор.Ключ) Тогда
					
					УсловияПоОтборам.Добавить(СтрШаблон("Данные.%1 = &%1", Отбор.Ключ));
					
				КонецЕсли;
				
			КонецЦикла;
			
			Условие = СтрСоединить(УсловияПоОтборам, Символы.ПС + "	И ");
			ШаблонЗапроса = СтрЗаменить(ШаблонЗапроса, "Данные.Ссылка = &Ссылка", Условие);
			
		Иначе
			
			ШаблонЗапроса = СтрЗаменить(ШаблонЗапроса, "Данные.Ссылка = &Ссылка", "ИСТИНА");
			
		КонецЕсли;
		
	Иначе
		
		ПолеЗапросаКлюча = ПолеЗапросаСсылка;
		
	КонецЕсли;

	ТекстЗапроса = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонЗапроса, ПространствоИмен);
	//СтрокаЗамены = "
	//|ИЗ
	//|	" + ПространствоИмен;
	СтрокаЗамены = "
	|ИЗ
	|	" + ПространствоИмен + " КАК Данные";
	
	//СтрокаЗаменыУсловия = "
	//	|ГДЕ
	//	|	Данные.Ссылка = &Ссылка";
	Если НЕ ЭтоРегистр Тогда
		СтрокаЗаменыУсловия = "
		|ГДЕ
		|	Данные.Ссылка = &Ссылка";
	Иначе
		СтрокаПоискаУсловия = "
		|ГДЕ
		|	Данные.";
		СтрокаЗаменыУсловия = Сред(ТекстЗапроса,СтрНайти(ТекстЗапроса,СтрокаПоискаУсловия));
	КонецЕсли;
	
	Для Каждого Реквизит Из Реквизиты Цикл
		Выражение = ПолучитьВыражениеПоля(Реквизит);
		
		ВыражениеПоля = Выражение.Значение;
		Если Не ЗначениеЗаполнено(Выражение.Псевдоним) Тогда
			Выражение.Псевдоним = Выражение.Значение;
		КонецЕсли;
		
		Если пбп_ПереадресацияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Реквизит, "ВыгрузитьКакПубличныйИдентификатор")
				И Реквизит.ВыгрузитьКакПубличныйИдентификатор Тогда
			
			ВыражениеПоля = ДополнитьЗапросИнформациейПроИдентификаторы(
				ТекстЗапроса, Реквизит, СтрокаЗаменыУсловия, ВыражениеПоля);
			
			Если Реквизит.СоставнойТип Тогда
				
				ДобавитьПолеВыборкиВЗапрос(
					ТекстЗапроса, Выражение, ВыражениеПоля, ПолеЗапросаКлюча, КлючевоеПоле, СтрокаЗамены);
				ВыражениеПоля = Выражение.Значение;
				Выражение.Псевдоним = Выражение.Псевдоним + "_Ссылка";
				
			КонецЕсли;
			
		КонецЕсли;
		
		//ТекстЗапроса = пбп_СхемыЗапросов.ДобавитьПолеВыборкиВЗапрос(ТекстЗапроса,
		//ВыражениеПоля,
		//Выражение.Псевдоним, , ,
		//Истина);
		ДобавитьПолеВыборкиВЗапрос(ТекстЗапроса, Выражение, ВыражениеПоля, ПолеЗапросаКлюча, КлючевоеПоле, СтрокаЗамены);
		
	КонецЦикла;
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаРеквизитовТабличнойЧастиОбъекта(ПространствоИмен, Реквизиты, ИмяТабличнойЧасти)
	
	ШаблонЗапроса = "ВЫБРАТЬ
		|	Данные.Ссылка КАК Ссылка
		|ИЗ
		|	%1.%2 КАК Данные
		|ГДЕ
		|	Данные.Ссылка = &Ссылка";
	
	ТекстЗапроса = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонЗапроса,
		ПространствоИмен,
		ИмяТабличнойЧасти);
	
	СтрокаЗамены = СтрШаблон("
		|ИЗ
		|	%1.%2 КАК Данные",
		ПространствоИмен,
		ИмяТабличнойЧасти
	);
	
	СтрокаЗаменыУсловия = "
	|ГДЕ
	|	Данные.Ссылка = &Ссылка";
	
	Для Каждого Реквизит Из Реквизиты Цикл
		Выражение = ПолучитьВыражениеПоля(Реквизит);
		
		ВыражениеПоля = Выражение.Значение;
		
		Если Не ЗначениеЗаполнено(Выражение.Псевдоним) Тогда
			Выражение.Псевдоним = Выражение.Значение;
		КонецЕсли;
		
		Если пбп_ПереадресацияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Реквизит, "ВыгрузитьКакПубличныйИдентификатор")
			И Реквизит.ВыгрузитьКакПубличныйИдентификатор Тогда
			
			ВыражениеПоля = ДополнитьЗапросИнформациейПроИдентификаторы(
				ТекстЗапроса, Реквизит, СтрокаЗаменыУсловия, ВыражениеПоля);
			
			Если Реквизит.СоставнойТип Тогда
				
				ДобавитьПолеВыборкиВЗапрос(ТекстЗапроса,
					Выражение,
					ВыражениеПоля,
					"",
					"",
					СтрокаЗамены);
				ВыражениеПоля = Выражение.Значение;
				Выражение.Псевдоним = Выражение.Псевдоним + "_Ссылка";
				
			КонецЕсли;
			
		КонецЕсли;
		
		//ТекстЗапроса = пбп_СхемыЗапросов.ДобавитьПолеВыборкиВЗапрос(ТекстЗапроса,
		//		ВыражениеПоля,
		//		Выражение.Псевдоним, , ,
		//		Истина);
		ДобавитьПолеВыборкиВЗапрос(ТекстЗапроса,
			Выражение,
			ВыражениеПоля,
			"",
			"",
			СтрокаЗамены);
	КонецЦикла;
	
	//ТекстЗапроса = пбп_СхемыЗапросов.УдалитьПоляИзЗапроса(ТекстЗапроса, "Ссылка");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Данные.Ссылка КАК Ссылка,", "");
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ПолучитьВыраженияПолей(Реквизиты)
	
	Выражения = Новый СписокЗначений;
	Для Каждого Реквизит Из Реквизиты Цикл
		Если Реквизит.Тип = Неопределено Тогда
			Выражения.Добавить(Реквизит.Имя);
		Иначе
			ПолноеИмяМета = ПолноеИмяОбъектаМетаданных(Реквизит.Тип);
			Части = СтрРазделить(Реквизит.Имя, ".");
			
			Выражение = ПреобразованиеПоля(Реквизит, Части);
			
			Выражения.Добавить(Выражение, СтрСоединить(Части, ""));
		КонецЕсли;
	КонецЦикла;
	
	Возврат Выражения;
	
КонецФункции

Функция ПолучитьВыражениеПоля(Реквизит)
	
	Выражение = Новый Структура("Значение, Псевдоним", "", "");
	Выражение.Псевдоним = Реквизит.Синоним;
	
	Если НЕ ЗначениеЗаполнено(Выражение.Псевдоним) 
		И НЕ ЗначениеЗаполнено(Реквизит.Тип)
		И СтрНайти(Реквизит.Имя,".") > 0 Тогда
		Выражение.Псевдоним = СтрРазделить (Реквизит.Имя,".")[0];
	КонецЕсли;
	
	Если Реквизит.Тип = Неопределено Тогда
		Выражение.Значение = Реквизит.Имя;
		
		Возврат Выражение;
	КонецЕсли;
	
	Части = СтрРазделить(Реквизит.Имя, ".");
	Поле = ПреобразованиеПоля(Реквизит, Части);
	
	Выражение.Значение = Поле;
	
	Если Не ЗначениеЗаполнено(Выражение.Псевдоним) Тогда
		Выражение.Псевдоним = СтрСоединить(Части, "");
	КонецЕсли;
	
	Возврат Выражение;
	
КонецФункции

Функция ПреобразованиеПоля(Реквизит, Части)
	
	ШаблонВыражения = "ВЫРАЗИТЬ(%1 КАК %2)";
	ШаблонВыраженияЧерезТочку = "ВЫРАЗИТЬ(%1 КАК %2).%3";
	
	ПолноеИмяМета = ПолноеИмяОбъектаМетаданных(Реквизит.Тип);
	Если Части.Количество() = 2 Тогда
		
		Возврат пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
			ШаблонВыраженияЧерезТочку,
			ПолеОсновнойТаблицы(Части[0]),
			ПолноеИмяМета,
			Части[1]);
		
	КонецЕсли;
	
	Возврат пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
		ШаблонВыражения,
		ПолеОсновнойТаблицы(Реквизит.Имя),
		ПолноеИмяМета);
	
КонецФункции

Функция ПолеОсновнойТаблицы(ИмяПоля)
	
	Если СтрНачинаетсяС(ИмяПоля, "Данные.") Тогда
		
		Возврат ИмяПоля;
		
	КонецЕсли;
	
	Возврат "Данные." + ИмяПоля;
	
КонецФункции

Функция ПолноеИмяОбъектаМетаданных(ТипИлиОписание)
	
	ПроверяемыйТип = ТипИлиОписание;
	Если ТипЗнч(ПроверяемыйТип) = Тип("ОписаниеТипов") Тогда
		
		Типы = ПроверяемыйТип.Типы();
		Если Типы.Количество() = 0 Тогда
			Возврат "";
		КонецЕсли;
		
		ПроверяемыйТип = Типы[0];
		
	КонецЕсли;
	
	Если ТипЗнч(ПроверяемыйТип) <> Тип("Тип") Тогда
		Возврат Строка(ПроверяемыйТип);
	КонецЕсли;
	
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ПроверяемыйТип);
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат ОбъектМетаданных.ПолноеИмя();
	
КонецФункции

#КонецОбласти // ЗапросПоОбъекту

Функция ЗначениеПоляДляВыгрузки(Значение)
	
	Если Значение = Null Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("УникальныйИдентификатор") Тогда
		
		Возврат Строка(Значение);
		
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("ХранилищеЗначения") Тогда
		
		Содержимое = Значение.Получить();
		Если ТипЗнч(Содержимое) = Тип("ДвоичныеДанные") Тогда
			
			Возврат ПолучитьBase64СтрокуИзДвоичныхДанных(Содержимое);
			
		КонецЕсли;
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	Если пбп_Переадресация.ЭтоСсылка(ТипЗнч(Значение)) Тогда
		
		Если Значение.Пустая() Тогда
			
			Возврат "";
			
		КонецЕсли;
		
		Если ОбъектМетаданныхЯвляетсяПеречислением(Значение.Метаданные()) Тогда
			
			Возврат XMLСтрока(Значение);
			
		КонецЕсли;
		
		Возврат Строка(Значение.УникальныйИдентификатор());
		
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

Функция ДанныеВыборкиИзРезультатаЗапросаВСтруктуру(Выборка, КолонкиРезультатаЗапроса, Реквизиты)
	
	Результат = Новый Структура;
	
	СоответствиеРеквизитов = МассивРеквизитовВСоответствие(Реквизиты.Реквизиты);
	ЧасовойПоясБазы = пбп_ИнтеграцииШинаПовтИсп.ЧасовойПоясБазыДанных();
	
	Для Каждого Колонка Из КолонкиРезультатаЗапроса Цикл
		Имя = Колонка.Имя;
		
		ДанныеРеквизита = СоответствиеРеквизитов.Получить(Имя);
		ЧастиДатыЗначения = ?(ДанныеРеквизита <> Неопределено И ДанныеРеквизита.Свойство("ЧастиДаты"),
			ДанныеРеквизита.ЧастиДаты, Неопределено);
		
		Если Не Реквизиты.ВложенныеПоля.Свойство(Имя) Тогда
			
			ЗначениеПоля = ЗначениеПоляДляВыгрузки(Выборка[Имя]);
			Результат.Вставить(Имя, пбп_ИнтеграцииСервер.ПреобразоватьДатуПоУниверсальномуВремени(
				ЗначениеПоля, ЧастиДатыЗначения, ЧасовойПоясБазы));
			Если Не ДанныеРеквизита = Неопределено
				И ДанныеРеквизита.СоставнойТип Тогда
				
				ИмяРеквизитаСсылки = Имя+"_Ссылка";
				Если КолонкиРезультатаЗапроса.Найти(ИмяРеквизитаСсылки) = Неопределено Тогда
					Результат.Вставить(
						Имя+"Тип", 
						пбп_Переадресация.СтроковоеПредставлениеТипа(ТипЗнч(Выборка[Имя]))
					);
				Иначе
					Результат.Вставить(
						Имя+"Тип", 
						пбп_Переадресация.СтроковоеПредставлениеТипа(ТипЗнч(Выборка[ИмяРеквизитаСсылки]))
					);
				КонецЕсли;
			КонецЕсли;

			
			Продолжить;
			
		КонецЕсли;
		
		ИндексПоля = Реквизиты.ВложенныеПоля[Имя];
		Поле = Реквизиты.Реквизиты[ИндексПоля];
		
		Части = СтрРазделить(Поле.Имя, ".");
		ИмяВерхнегоУровня = Части[0];
		ИмяВложенного = ?(ЗначениеЗаполнено(Поле.Синоним), Поле.Синоним, Части[1]);
		
		ЧастиДатыЗначения = ?(Поле <> Неопределено И Поле.Свойство("ЧастиДаты"),
		Поле.ЧастиДаты, Неопределено);
		
		ЗначениеПоля = ЗначениеПоляДляВыгрузки(Выборка[Имя]);
		
		Если Поле.ВыводитьВСтруктуру Тогда
			Если Не Результат.Свойство(ИмяВерхнегоУровня) Тогда
				Результат.Вставить(ИмяВерхнегоУровня, Новый Структура);
			КонецЕсли;
			Результат[ИмяВерхнегоУровня].Вставить(ИмяВложенного,
				пбп_ИнтеграцииСервер.ПреобразоватьДатуПоУниверсальномуВремени(
				ЗначениеПоля, ЧастиДатыЗначения, ЧасовойПоясБазы));
		Иначе
			Если ЗначениеЗаполнено(Поле.Синоним) Тогда
				ИмяВерхнегоУровня = Поле.Синоним;
			КонецЕсли;
			
			Если пбп_Переадресация.ЭтоСсылка(ТипЗнч(Выборка[Имя]))
				И Выборка[Имя].Пустая() Тогда 
				Результат.Вставить(ИмяВерхнегоУровня, "");
			Иначе
				Результат.Вставить(ИмяВерхнегоУровня,
					пбп_ИнтеграцииСервер.ПреобразоватьДатуПоУниверсальномуВремени(
					ЗначениеПоля, ЧастиДатыЗначения, ЧасовойПоясБазы));
				ДанныеРеквизита = СоответствиеРеквизитов.Получить(ИмяВерхнегоУровня);
				ЗаполнитьТипИзДанныхРеквизита = Ложь;
				Если ДанныеРеквизита = Неопределено Тогда
					ДанныеРеквизита = СоответствиеРеквизитов.Получить(Поле.Имя);
					ЗаполнитьТипИзДанныхРеквизита = Истина;
				КонецЕсли;
				
				Если Не ДанныеРеквизита = Неопределено
					И ДанныеРеквизита.СоставнойТип Тогда
					
					ИмяРеквизитаСсылки = ИмяВерхнегоУровня+"_Ссылка";
					
					Если ЗаполнитьТипИзДанныхРеквизита И Не ДанныеРеквизита.Тип = Неопределено Тогда
						ТипЗначения = пбп_Переадресация.СтроковоеПредставлениеТипа(ДанныеРеквизита.Тип);
						
					ИначеЕсли КолонкиРезультатаЗапроса.Найти(ИмяРеквизитаСсылки) = Неопределено Тогда
						ТипЗначения = пбп_Переадресация.СтроковоеПредставлениеТипа(ТипЗнч(Выборка[ИмяВерхнегоУровня]));
						
					Иначе
						ТипЗначения = пбп_Переадресация.СтроковоеПредставлениеТипа(ТипЗнч(Выборка[ИмяРеквизитаСсылки]));
					КонецЕсли;
					
					Результат.Вставить(ИмяВерхнегоУровня+"Тип", ТипЗначения);
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	Если Результат.Свойство("ВерсияДанных") Тогда
		СтрокаВерсии16 = "0x"+СтрЗаменить(Base64Значение(Результат.ВерсияДанных), " ", "");
		Результат.ВерсияДанных = ЧислоИзШестнадцатеричнойСтроки(СтрокаВерсии16);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция КонструкторНабораДанных()
	
	Результат = Новый Структура("Реквизиты,ВложенныеПоля", Новый Массив, Новый Структура);
	
	Возврат Результат;
	
КонецФункции

Функция КонструкторПоляСТипом()
	
	Результат = Новый Структура;
	Результат.Вставить("Имя", "");
	Результат.Вставить("Синоним", "");
	Результат.Вставить("Тип", Неопределено);
	Результат.Вставить("ВыводитьВСтруктуру", Ложь);
	Результат.Вставить("ВыгрузитьКакПубличныйИдентификатор", Истина);
	Результат.Вставить("СоставнойТип", Ложь);
	Результат.Вставить("ЧастиДаты", Неопределено);
	
	Возврат Результат;
	
КонецФункции

Процедура ПроверкаУровняВложенности(ИмяРеквизита, Разделитель = ".")
	
	Части = СтрРазделить(ИмяРеквизита, Разделитель);
	// проверить что их ровно две, глубже проваливаться нельзя,
	// возможно в будущем изменим, тут надо аккуратно,
	// т.к. поля могут быть составного типа и при динамическом формировании запроса, ограничение типа не накладывается.
	Если Части.Количество() > 3 Тогда
		ВызватьИсключение (пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Допускается только два уровня вложенности: %1'"),
			ИмяРеквизита),
			КатегорияОшибки.ОшибкаКонфигурации);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьПоляОбъекта(СоставПолей, Знач Поля)
	
	ДобавитьПоля(СоставПолей.РеквизитыОбъекта, Поля);
	
КонецПроцедуры

Процедура ДобавитьПоляТабличнойЧасти(СоставПолей, ИмяТабличнойЧасти, Знач Поля, СинонимТабличнойЧасти = "")
	
	Если Не СоставПолей.ТабличныеЧасти.Свойство(ИмяТабличнойЧасти) Тогда
		
		НаборДанных = КонструкторНабораДанных();
		
		СоставПолей.ТабличныеЧасти.Вставить(ИмяТабличнойЧасти, НаборДанных);
		СоставПолей.ПорядокТабличныхЧастей.Добавить(ИмяТабличнойЧасти);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СинонимТабличнойЧасти) Тогда
		
		СинонимыТабличныхЧастей = Неопределено;
		Если Не СоставПолей.Свойство("СинонимыТабличныхЧастей", СинонимыТабличныхЧастей) Тогда
			
			СинонимыТабличныхЧастей = Новый Структура;
			СоставПолей.Вставить("СинонимыТабличныхЧастей", СинонимыТабличныхЧастей);
			
		КонецЕсли;
		
		СинонимыТабличныхЧастей.Вставить(ИмяТабличнойЧасти, СинонимТабличнойЧасти);
		
	КонецЕсли;
	
	ДобавитьПоля(СоставПолей.ТабличныеЧасти[ИмяТабличнойЧасти], Поля);
	
КонецПроцедуры

Процедура ДобавитьПоля(НаборДанных, Знач Поля)
	
	Если ТипЗнч(Поля) = Тип("Строка") Тогда
		Поля = СтрРазделить(Поля, ",", Ложь);
	ИначеЕсли ТипЗнч(Поля) = Тип("Структура") Тогда
		Поля = пбп_ПереадресацияКлиентСервер.ЗначениеВМассиве(Поля);
	КонецЕсли;
	
	Для Каждого Поле Из Поля Цикл
		Если ТипЗнч(Поле) <> Тип("Структура") Тогда
			Поле = ОбернутьПолеВСтруктуруСТипом(Поле, Поле, Неопределено, Ложь, Ложь);
		КонецЕсли;
		ДополнитьНаборДанных(НаборДанных, Поле);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДополнитьНаборДанных(ВходящийНаборДанных, Реквизит)
	
	Значение = КонструкторПоляСТипом();
	Если ТипЗнч(Реквизит) = Тип("Структура") Тогда
		Значение = пбп_Переадресация.СкопироватьРекурсивно(Реквизит);
	Иначе
		Значение.Имя = Реквизит;
	КонецЕсли;
	
	Разделитель = ".";
	ТекущийИндекс = ВходящийНаборДанных.Реквизиты.ВГраница() + 1;
	Если СтрНайти(Значение.Имя, Разделитель) > 0 Тогда
		ПроверкаУровняВложенности(Значение.Имя, Разделитель);
		
		ВходящийНаборДанных.Реквизиты.Добавить(Значение);
		Ключ = СтрЗаменить(Значение.Имя, Разделитель, "");
		Если ЗначениеЗаполнено(Значение.Синоним) Тогда
			Ключ = Значение.Синоним;
		КонецЕсли;
		
		ВходящийНаборДанных.ВложенныеПоля.Вставить(Ключ, ТекущийИндекс);
		
		Возврат;
	КонецЕсли;
	
	ВходящийНаборДанных.Реквизиты.Добавить(Реквизит);
	
КонецПроцедуры

Функция ОбернутьПолеВСтруктуруСТипом(Поле, Синоним, Тип, ВыводитьВСтруктуру, ВыгрузитьКакПубличныйИдентификатор = Ложь, СоставнойТип = Ложь, ЧастиДаты = Неопределено)
	
	Данные = КонструкторПоляСТипом();
	Данные.Имя = Поле;
	Данные.Синоним = Синоним;
	Данные.Тип = Тип;
	Данные.ВыводитьВСтруктуру = ВыводитьВСтруктуру;
	Данные.ВыгрузитьКакПубличныйИдентификатор = ВыгрузитьКакПубличныйИдентификатор;
	Данные.СоставнойТип = СоставнойТип;
	Данные.ЧастиДаты = ЧастиДаты;
	
	Возврат Данные;
	
КонецФункции

Функция МассивРеквизитовВСоответствие(Реквизиты)
	
