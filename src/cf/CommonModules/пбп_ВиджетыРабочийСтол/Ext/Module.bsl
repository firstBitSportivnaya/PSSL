// Виджеты (служебный): размещение виджетов рабочего стола на форме и действия по нажатию.

#Область СлужебныйПрограммныйИнтерфейс

// Размещает на форме виджеты рабочего стола. Ранее размещенные виджеты удаляются.
// При первом вызове создает служебный реквизит формы пбп_ДанныеВиджетов.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, на которой размещаются виджеты.
//  Группа - ГруппаФормы, Строка - группа формы или ее имя, в которую размещаются колонки виджетов.
//  РабочийСтол - СправочникСсылка.пбп_РабочиеСтолы - рабочий стол.
//
Процедура РазместитьВиджеты(Форма, Группа, РабочийСтол) Экспорт

	ДанныеВиджетов = ПодготовленныеДанныеВиджетов(Форма);
	пбп_РаботаСФормами.УдалитьЭлементы(Форма, ДанныеВиджетов.Элементы);
	ДанныеВиджетов.Элементы = Новый Массив;
	ДанныеВиджетов.Действия = Новый Соответствие;

	Если ЗначениеЗаполнено(РабочийСтол) Тогда

		ДанныеСтола = ДанныеРабочегоСтола(РабочийСтол);
		Значения = пбп_Виджеты.ЗначенияПоказателей(ДанныеСтола.Показатели.ВыгрузитьКолонку("Показатель"), Истина);

		Для Каждого ОписаниеВиджета Из ДанныеСтола.Виджеты Цикл

			РазместитьВиджет(Форма, Группа, ОписаниеВиджета, ДанныеСтола, Значения, ДанныеВиджетов);

		КонецЦикла;

	КонецЕсли;

	Форма.пбп_ДанныеВиджетов = ДанныеВиджетов;

КонецПроцедуры

// Возвращает рабочий стол текущего пользователя: сохраненный выбор
// или первый не помеченный на удаление рабочий стол по коду.
//
// Возвращаемое значение:
//  СправочникСсылка.пбп_РабочиеСтолы - рабочий стол, пустая ссылка, если рабочих столов нет.
//
Функция РабочийСтолПользователя() Экспорт

	РабочийСтол = пбп_Переадресация.ХранилищеОбщихНастроекЗагрузить(КлючОбъектаНастроек(), КлючНастройкиРабочегоСтола());
	Если ТипЗнч(РабочийСтол) = Тип("СправочникСсылка.пбп_РабочиеСтолы") И ЗначениеЗаполнено(РабочийСтол) Тогда

		Возврат РабочийСтол;

	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	РабочиеСтолы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.пбп_РабочиеСтолы КАК РабочиеСтолы
	|ГДЕ
	|	НЕ РабочиеСтолы.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	РабочиеСтолы.Код";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда

		Возврат Выборка.Ссылка;

	КонецЕсли;

	Возврат Справочники.пбп_РабочиеСтолы.ПустаяСсылка();

КонецФункции

// Сохраняет рабочий стол, выбранный текущим пользователем.
//
// Параметры:
//  РабочийСтол - СправочникСсылка.пбп_РабочиеСтолы - рабочий стол.
//
Процедура СохранитьРабочийСтолПользователя(РабочийСтол) Экспорт

	пбп_Переадресация.ХранилищеОбщихНастроекСохранить(КлючОбъектаНастроек(), КлючНастройкиРабочегоСтола(), РабочийСтол);

КонецПроцедуры

// Возвращает описание действия по клику на показатель или команду виджета.
//
// Параметры:
//  Действие - ПеречислениеСсылка.пбп_ДействияВиджетов - действие.
//  ПараметрДействия - Строка - имя формы, полное имя объекта метаданных, навигационная ссылка или имя метода.
//  Источник - СправочникСсылка.пбп_ПоказателиВиджетов, СправочникСсылка.пбп_Виджеты - показатель или виджет команды.
//  НомерКоманды - Число - номер строки команды виджета, 0 для показателя.
//  НастройкаОтбора - СправочникСсылка.пбп_НастройкиОтбораОбъектов - настройка отбора источника показателя.
//
// Возвращаемое значение:
//  Структура:
//   * Действие - ПеречислениеСсылка.пбп_ДействияВиджетов - действие.
//   * ИмяФормы - Строка - имя открываемой формы.
//   * ПараметрыФормы - Структура - параметры открываемой формы.
//   * НавигационнаяСсылка - Строка - ссылка для перехода.
//   * ОбъектМетаданных - Строка - полное имя объекта метаданных, право на который проверяется.
//   * Право - Строка - имя проверяемого права.
//   * Источник - СправочникСсылка.пбп_ПоказателиВиджетов, СправочникСсылка.пбп_Виджеты - источник действия.
//   * НомерКоманды - Число - номер строки команды виджета.
//
Функция ОписаниеДействия(Действие, ПараметрДействия, Источник, НомерКоманды = 0,
	НастройкаОтбора = Неопределено) Экспорт

	Описание = Новый Структура;
	Описание.Вставить("Действие", Действие);
	Описание.Вставить("ИмяФормы", "");
	Описание.Вставить("ПараметрыФормы", Новый Структура);
	Описание.Вставить("НавигационнаяСсылка", "");
	Описание.Вставить("ОбъектМетаданных", "");
	Описание.Вставить("Право", "Просмотр");
	Описание.Вставить("Источник", Источник);
	Описание.Вставить("НомерКоманды", НомерКоманды);

	Действия = Перечисления.пбп_ДействияВиджетов;
	Параметр = СокрЛП(ПараметрДействия);

	Если Действие = Действия.ОткрытьФорму Тогда

		Описание.ИмяФормы = Параметр;
		Описание.ОбъектМетаданных = ИмяОбъектаМетаданных(Параметр);

	ИначеЕсли Действие = Действия.ОткрытьСписок Тогда

		ЗаполнитьОписаниеОткрытияСписка(Описание, Параметр, НастройкаОтбора);

	ИначеЕсли Действие = Действия.ПереходПоСсылке Тогда

		ЗаполнитьОписаниеПереходаПоСсылке(Описание, Параметр);

	ИначеЕсли Действие = Действия.СоздатьОбъект Тогда

		Описание.ИмяФормы = Параметр + ".ФормаОбъекта";
		Описание.ОбъектМетаданных = ИмяОбъектаМетаданных(Параметр);
		Описание.Право = "ИнтерактивноеДобавление";

	ИначеЕсли Действие = Действия.ВыполнитьМетод Тогда

		Описание.Право = "";

	Иначе

		ВызватьИсключение СтрШаблон(НСтр("ru = 'Неизвестное действие виджета: %1.'"), Действие);

	КонецЕсли;

	Возврат Описание;

КонецФункции

// Проверяет, что у пользователя есть право на объект, к которому ведет действие.
// Действие без проверяемого права (метод, внешняя ссылка) доступно всегда; действие без объекта
// или с объектом, которого нет в конфигурации, недоступно.
//
// Параметры:
//  ОписаниеДействия - см. ОписаниеДействия
//  ОбъектПроверкиПрав - ОбъектМетаданныхРоль, ПользовательИнформационнойБазы, Неопределено - для кого проверяется право,
//                       Неопределено - текущий пользователь.
//
// Возвращаемое значение:
//  Булево - цель действия доступна.
//
Функция ЦельДействияДоступна(ОписаниеДействия, ОбъектПроверкиПрав = Неопределено) Экспорт

	Если Не ЗначениеЗаполнено(ОписаниеДействия.ОбъектМетаданных) Тогда

		Возврат Не ЗначениеЗаполнено(ОписаниеДействия.Право);

	КонецЕсли;

	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ОписаниеДействия.ОбъектМетаданных);
	Если ОбъектМетаданных = Неопределено Тогда

		Возврат Ложь;

	КонецЕсли;

	Если ОбъектПроверкиПрав = Неопределено Тогда

		Возврат ПравоДоступа(ОписаниеДействия.Право, ОбъектМетаданных);

	КонецЕсли;

	Возврат ПравоДоступа(ОписаниеДействия.Право, ОбъектМетаданных, ОбъектПроверкиПрав);

КонецФункции

// Выполняет метод конфигурации из действия показателя или команды виджета.
// Имя метода читается из информационной базы по источнику, а не передается с клиента.
//
// Параметры:
//  Источник - СправочникСсылка.пбп_ПоказателиВиджетов, СправочникСсылка.пбп_Виджеты - показатель или виджет команды.
//  НомерКоманды - Число - номер строки команды виджета, 0 для показателя.
//
Процедура ВыполнитьМетодДействия(Источник, НомерКоманды = 0) Экспорт

	Если ТипЗнч(Источник) = Тип("СправочникСсылка.пбп_ПоказателиВиджетов") Тогда

		ДанныеДействия = пбп_Переадресация.ЗначенияРеквизитовОбъекта(Источник, "Действие, ПараметрДействия");
		ПараметрыМетода = Новый Структура("Показатель, Пользователь", Источник, пбп_Переадресация.ТекущийПользователь());

	Иначе

		ДанныеДействия = ДанныеКомандыВиджета(Источник, НомерКоманды);
		ПараметрыМетода = Новый Структура("Виджет, Команда", Источник, ДанныеДействия.Представление);

	КонецЕсли;

	Если ДанныеДействия.Действие <> Перечисления.пбп_ДействияВиджетов.ВыполнитьМетод Тогда

		ВызватьИсключение НСтр("ru = 'Действие виджета не является выполнением метода.'");

	КонецЕсли;

	Параметры = Новый Массив;
	Параметры.Добавить(ПараметрыМетода);
	пбп_Переадресация.ВыполнитьМетодКонфигурации(ДанныеДействия.ПараметрДействия, Параметры);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПодготовленныеДанныеВиджетов(Форма)

	ИмяРеквизита = "пбп_ДанныеВиджетов";
	Для Каждого Реквизит Из Форма.ПолучитьРеквизиты() Цикл

		Если Реквизит.Имя = ИмяРеквизита Тогда

			Возврат Форма[ИмяРеквизита];

		КонецЕсли;

	КонецЦикла;

	пбп_РаботаСФормами.СоздатьРеквизит(Форма, ИмяРеквизита, Новый ОписаниеТипов);

	Возврат Новый Структура("Элементы, Действия", Новый Массив, Новый Соответствие);

КонецФункции

Функция ДанныеРабочегоСтола(РабочийСтол)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("РабочийСтол", РабочийСтол);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВиджетыСтола.НомерСтроки КАК НомерСтроки,
	|	ВиджетыСтола.Виджет КАК Виджет,
	|	ВиджетыСтола.Колонка КАК Колонка,
	|	ВиджетыСтола.Порядок КАК Порядок,
	|	ВиджетыСтола.Виджет.Наименование КАК Наименование,
	|	ВиджетыСтола.Виджет.Вид КАК Вид,
	|	ВиджетыСтола.Виджет.Цвет КАК Цвет,
	|	ВиджетыСтола.Виджет.Размер КАК Размер
	|ПОМЕСТИТЬ ВиджетыСтола
	|ИЗ
	|	Справочник.пбп_РабочиеСтолы.Виджеты КАК ВиджетыСтола
	|ГДЕ
	|	ВиджетыСтола.Ссылка = &РабочийСтол
	|	И НЕ ВиджетыСтола.Виджет.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВиджетыСтола.НомерСтроки КАК НомерСтроки,
	|	ВиджетыСтола.Виджет КАК Виджет,
	|	ВиджетыСтола.Колонка КАК Колонка,
	|	ВиджетыСтола.Наименование КАК Наименование,
	|	ВиджетыСтола.Вид КАК Вид,
	|	ВиджетыСтола.Цвет КАК Цвет,
	|	ВиджетыСтола.Размер КАК Размер
	|ИЗ
	|	ВиджетыСтола КАК ВиджетыСтола
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВиджетыСтола.Колонка,
	|	ВиджетыСтола.Порядок,
	|	ВиджетыСтола.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПоказателиВиджетов.Ссылка КАК Виджет,
	|	ПоказателиВиджетов.НомерСтроки КАК НомерСтроки,
	|	ПоказателиВиджетов.Показатель КАК Показатель,
	|	ПоказателиВиджетов.Показатель.Наименование КАК Наименование,
	|	ПоказателиВиджетов.Показатель.Подсказка КАК Подсказка,
	|	ПоказателиВиджетов.Показатель.Действие КАК Действие,
	|	ПоказателиВиджетов.Показатель.ПараметрДействия КАК ПараметрДействия,
	|	ВЫБОР
	|		КОГДА ПоказателиВиджетов.Показатель.ВидИсточника
	|				= ЗНАЧЕНИЕ(Перечисление.пбп_ВидыИсточниковПоказателейВиджетов.НастройкаОтбора)
	|			ТОГДА ПоказателиВиджетов.Показатель.НастройкаОтбора
	|		ИНАЧЕ NULL
	|	КОНЕЦ КАК НастройкаОтбора
	|ИЗ
	|	Справочник.пбп_Виджеты.Показатели КАК ПоказателиВиджетов
	|ГДЕ
	|	ПоказателиВиджетов.Ссылка В
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				ВиджетыСтола.Виджет
	|			ИЗ
	|				ВиджетыСтола КАК ВиджетыСтола)
	|	И НЕ ПоказателиВиджетов.Показатель.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КомандыВиджетов.Ссылка КАК Виджет,
	|	КомандыВиджетов.НомерСтроки КАК НомерСтроки,
	|	КомандыВиджетов.Представление КАК Представление,
	|	КомандыВиджетов.Действие КАК Действие,
	|	КомандыВиджетов.ПараметрДействия КАК ПараметрДействия
	|ИЗ
	|	Справочник.пбп_Виджеты.Команды КАК КомандыВиджетов
	|ГДЕ
	|	КомандыВиджетов.Ссылка В
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				ВиджетыСтола.Виджет
	|			ИЗ
	|				ВиджетыСтола КАК ВиджетыСтола)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";

	Результаты = Запрос.ВыполнитьПакет();

	ДанныеСтола = Новый Структура;
	ДанныеСтола.Вставить("Виджеты", Результаты[1].Выгрузить());
	ДанныеСтола.Вставить("Показатели", Результаты[2].Выгрузить());
	ДанныеСтола.Вставить("Команды", Результаты[3].Выгрузить());

	Возврат ДанныеСтола;

КонецФункции

Процедура РазместитьВиджет(Форма, Группа, ОписаниеВиджета, ДанныеСтола, Значения, ДанныеВиджетов)

	ВидыВиджетов = Перечисления.пбп_ВидыВиджетов;
	Отбор = Новый Структура("Виджет", ОписаниеВиджета.Виджет);

	Если ОписаниеВиджета.Вид = ВидыВиджетов.Показатели Тогда

		ЭлементыВиджета = ЭлементыПоказателей(ДанныеСтола.Показатели.НайтиСтроки(Отбор), Значения);
		Группировка = 3;

	ИначеЕсли ОписаниеВиджета.Вид = ВидыВиджетов.Команда Тогда

		ЭлементыВиджета = ЭлементыКоманд(ДанныеСтола.Команды.НайтиСтроки(Отбор));
		Группировка = 1;

	Иначе

		// Виды "Список" и "Диаграмма" размещаются следующим этапом подсистемы.
		Возврат;

	КонецЕсли;

	Если ЭлементыВиджета.Количество() = 0 Тогда

		Возврат;

	КонецЕсли;

	Колонка = ГруппаКолонкиВиджетов(Форма, Группа, ОписаниеВиджета.Колонка, ДанныеВиджетов);

	НомерВиджета = Формат(ОписаниеВиджета.НомерСтроки, "ЧГ=0");
	ГруппаВиджета = пбп_РаботаСФормами.СоздатьГруппаОбычнаяБезОтображения(Форма,
		"пбп_Виджет" + НомерВиджета, Колонка, Группировка, , , СвойстваГруппыВиджета(ОписаниеВиджета));

	Для Каждого ЭлементВиджета Из ЭлементыВиджета Цикл

		Суффикс = "_" + НомерВиджета + "_" + Формат(ЭлементВиджета.НомерСтроки, "ЧГ=0");
		РазместитьЭлементВиджета(Форма, ГруппаВиджета, Суффикс, ЭлементВиджета, ДанныеВиджетов);

	КонецЦикла;

КонецПроцедуры

Функция ЭлементыПоказателей(СтрокиПоказателей, Значения)

	МаксимумПоказателей = 3;
	ЭлементыВиджета = Новый Массив;

	Для Индекс = 0 По Мин(СтрокиПоказателей.Количество(), МаксимумПоказателей) - 1 Цикл

		СтрокаПоказателя = СтрокиПоказателей[Индекс];
		Действие = Неопределено;
		Если ЗначениеЗаполнено(СтрокаПоказателя.Действие) Тогда

			Действие = ОписаниеДействия(СтрокаПоказателя.Действие, СтрокаПоказателя.ПараметрДействия,
				СтрокаПоказателя.Показатель, 0, СтрокаПоказателя.НастройкаОтбора);

		КонецЕсли;

		Если Действие <> Неопределено И Не ЦельДействияДоступна(Действие) Тогда

			Продолжить;

		КонецЕсли;

		ЭлементВиджета = НовыйЭлементВиджета(СтрокаПоказателя.НомерСтроки, Действие);
		ЭлементВиджета.Значение = ПредставлениеЗначения(Значения.Получить(СтрокаПоказателя.Показатель));
		ЭлементВиджета.Подпись = СтрокаПоказателя.Наименование;
		ЭлементВиджета.Подсказка = СтрокаПоказателя.Подсказка;
		ЭлементыВиджета.Добавить(ЭлементВиджета);

	КонецЦикла;

	Возврат ЭлементыВиджета;

КонецФункции

Функция ЭлементыКоманд(СтрокиКоманд)

	ЭлементыВиджета = Новый Массив;

	Для Каждого СтрокаКоманды Из СтрокиКоманд Цикл

		Если Не ЗначениеЗаполнено(СтрокаКоманды.Действие) Тогда

			Продолжить;

		КонецЕсли;

		Действие = ОписаниеДействия(СтрокаКоманды.Действие, СтрокаКоманды.ПараметрДействия,
			СтрокаКоманды.Виджет, СтрокаКоманды.НомерСтроки);
		Если Не ЦельДействияДоступна(Действие) Тогда

			Продолжить;

		КонецЕсли;

		ЭлементВиджета = НовыйЭлементВиджета(СтрокаКоманды.НомерСтроки, Действие);
		ЭлементВиджета.Подпись = СтрокаКоманды.Представление;
		ЭлементыВиджета.Добавить(ЭлементВиджета);

	КонецЦикла;

	Возврат ЭлементыВиджета;

КонецФункции

Функция НовыйЭлементВиджета(НомерСтроки, Действие)

	ЭлементВиджета = Новый Структура;
	ЭлементВиджета.Вставить("НомерСтроки", НомерСтроки);
	ЭлементВиджета.Вставить("Действие", Действие);
	ЭлементВиджета.Вставить("Значение", Неопределено);
	ЭлементВиджета.Вставить("Подпись", "");
	ЭлементВиджета.Вставить("Подсказка", "");

	Возврат ЭлементВиджета;

КонецФункции

Функция ПредставлениеЗначения(ЗначениеПоказателя)

	Если ЗначениеПоказателя = Неопределено Или ЗначениеЗаполнено(ЗначениеПоказателя.Ошибка) Тогда

		Возврат "—";

	КонецЕсли;

	Возврат пбп_ВиджетыКлиентСервер.ПредставлениеЗначенияПоказателя(ЗначениеПоказателя.Значение);

КонецФункции

Процедура РазместитьЭлементВиджета(Форма, ГруппаВиджета, Суффикс, ЭлементВиджета, ДанныеВиджетов)

	Родитель = ГруппаВиджета;
	ЭтоПоказатель = ЭлементВиджета.Значение <> Неопределено;

	Если ЭтоПоказатель Тогда

		Родитель = пбп_РаботаСФормами.СоздатьГруппаОбычнаяБезОтображения(Форма,
			"пбп_ВиджетПоказатель" + Суффикс, ГруппаВиджета, 1);
		НажимаемыйЭлемент = пбп_РаботаСФормами.СоздатьДекорацияНадпись(Форма,
			"пбп_ВиджетЗначение" + Суффикс, Родитель, ЭлементВиджета.Значение, Ложь);
		НажимаемыйЭлемент.Шрифт = Новый Шрифт(ШрифтыСтиля.ОбычныйШрифтТекста, , 18, Истина);
		НажимаемыйЭлемент.Подсказка = ЭлементВиджета.Подсказка;
		пбп_РаботаСФормами.СоздатьДекорацияНадпись(Форма, "пбп_ВиджетПодпись" + Суффикс, Родитель, ЭлементВиджета.Подпись, Ложь);

	Иначе

		НажимаемыйЭлемент = пбп_РаботаСФормами.СоздатьДекорацияНадпись(Форма,
			"пбп_ВиджетКоманда" + Суффикс, Родитель, ЭлементВиджета.Подпись, Ложь);

	КонецЕсли;

	Если ЭлементВиджета.Действие <> Неопределено Тогда

		НажимаемыйЭлемент.Гиперссылка = Истина;
		пбп_РаботаСФормами.УстановитьСобытияЭлементу(НажимаемыйЭлемент,
			Новый Структура("Нажатие", "Подключаемый_ВиджетНажатие"));
		ДанныеВиджетов.Действия.Вставить(НажимаемыйЭлемент.Имя, ЭлементВиджета.Действие);

	КонецЕсли;
КонецПроцедуры

Функция ГруппаКолонкиВиджетов(Форма, Группа, НомерКолонки, ДанныеВиджетов)

	ИмяГруппы = "пбп_ВиджетыКолонка" + Формат(НомерКолонки, "ЧН=0; ЧГ=0");
	ГруппаКолонки = Форма.Элементы.Найти(ИмяГруппы);
	Если ГруппаКолонки = Неопределено Тогда

		ГруппаКолонки = пбп_РаботаСФормами.СоздатьГруппаОбычнаяБезОтображения(Форма, ИмяГруппы, Группа, 1);
		ДанныеВиджетов.Элементы.Добавить(ИмяГруппы);

	КонецЕсли;

	Возврат ГруппаКолонки;

КонецФункции

Функция СвойстваГруппыВиджета(ОписаниеВиджета)

	Свойства = Новый Структура;
	Свойства.Вставить("Заголовок", ОписаниеВиджета.Наименование);
	Свойства.Вставить("ОтображатьЗаголовок", Истина);
	Свойства.Вставить("Отображение", ОтображениеОбычнойГруппы.СлабоеВыделение);
	Свойства.Вставить("ЦветФона", ЦветФонаВиджета(ОписаниеВиджета.Цвет));
	Свойства.Вставить("Ширина", ШиринаВиджета(ОписаниеВиджета.Размер));

	Возврат Свойства;

КонецФункции

Функция ЦветФонаВиджета(Цвет)

	Цвета = Перечисления.пбп_ЦветаВиджетов;
	Если Цвет = Цвета.Синий Тогда

		Возврат Новый Цвет(227, 239, 252);

	ИначеЕсли Цвет = Цвета.Зеленый Тогда

		Возврат Новый Цвет(228, 245, 228);

	ИначеЕсли Цвет = Цвета.Желтый Тогда

		Возврат Новый Цвет(255, 247, 214);

	ИначеЕсли Цвет = Цвета.Красный Тогда

		Возврат Новый Цвет(252, 228, 228);

	ИначеЕсли Цвет = Цвета.Серый Тогда

		Возврат Новый Цвет(238, 238, 238);

	Иначе

		Возврат Новый Цвет;

	КонецЕсли;

КонецФункции

Функция ШиринаВиджета(Размер)

	Размеры = Перечисления.пбп_РазмерыВиджетов;
	Если Размер = Размеры.Маленький Тогда

		Возврат 15;

	ИначеЕсли Размер = Размеры.Средний Тогда

		Возврат 25;

	ИначеЕсли Размер = Размеры.Большой Тогда

		Возврат 40;

	Иначе

		Возврат 0;

	КонецЕсли;

КонецФункции

Процедура ЗаполнитьОписаниеОткрытияСписка(Описание, ИмяОбъекта, НастройкаОтбора)

	ИмяСписка = ИмяОбъекта;
	Если ЗначениеЗаполнено(НастройкаОтбора) Тогда

		ДанныеНастройки = ДанныеНастройкиОтбора(НастройкаОтбора);
		Если Не ЗначениеЗаполнено(ИмяСписка) Тогда

			ИмяСписка = ДанныеНастройки.ОбъектМетаданных;

		КонецЕсли;

		Если НРег(ИмяСписка) = НРег(ДанныеНастройки.ОбъектМетаданных) Тогда

			Описание.ПараметрыФормы.Вставить("ФиксированныеНастройки", НастройкиСпискаПоОтбору(ДанныеНастройки.Отбор));

		КонецЕсли;

	КонецЕсли;

	Описание.ИмяФормы = ИмяСписка + ".ФормаСписка";
	Описание.ОбъектМетаданных = ИмяОбъектаМетаданных(ИмяСписка);

КонецПроцедуры

// Настройка отбора читается в привилегированном режиме: у пользователя рабочего стола может не быть
// права на справочник настроек отбора. Право на открываемый список проверяется отдельно.
Функция ДанныеНастройкиОтбора(НастройкаОтбора)

	УстановитьПривилегированныйРежим(Истина);

	Возврат пбп_Переадресация.ЗначенияРеквизитовОбъекта(НастройкаОтбора, "ОбъектМетаданных, Отбор");

КонецФункции

Функция НастройкиСпискаПоОтбору(ОтборXML)

	Настройки = Новый НастройкиКомпоновкиДанных;
	Если ЗначениеЗаполнено(ОтборXML) Тогда

		Отбор = пбп_Переадресация.ЗначениеИзСтрокиXML(ОтборXML);
		Справочники.пбп_НастройкиОтбораОбъектов.СкопироватьЭлементыОтбора(Настройки.Отбор, Отбор);

	КонецЕсли;

	Возврат Настройки;

КонецФункции

Процедура ЗаполнитьОписаниеПереходаПоСсылке(Описание, Параметр)

	Если СтрНайти(Параметр, "/") = 0 Тогда

		Описание.НавигационнаяСсылка = НавигационнаяСсылкаОбъекта(Параметр);
		Описание.ОбъектМетаданных = ИмяОбъектаМетаданных(Параметр);
		Возврат;

	КонецЕсли;

	Описание.НавигационнаяСсылка = Параметр;

	Префикс = "e1cib/";
	Если Не СтрНачинаетсяС(НРег(Параметр), Префикс) Тогда

		// Внешняя ссылка: права информационной базы к ней не применяются.
		Описание.Право = "";
		Возврат;

	КонецЕсли;

	ПутьБезПрефикса = Сред(Параметр, СтрДлина(Префикс) + 1);
	ПутьОбъекта = Сред(ПутьБезПрефикса, СтрНайти(ПутьБезПрефикса, "/") + 1);
	ПозицияПараметров = СтрНайти(ПутьОбъекта, "?");
	Если ПозицияПараметров > 0 Тогда

		ПутьОбъекта = Лев(ПутьОбъекта, ПозицияПараметров - 1);

	КонецЕсли;

	Описание.ОбъектМетаданных = ИмяОбъектаМетаданных(ПутьОбъекта);

КонецПроцедуры

Функция НавигационнаяСсылкаОбъекта(ПолноеИмя)

	ИмяВНижнемРегистре = НРег(ПолноеИмя);
	ВидОбъекта = НРег(Лев(ПолноеИмя, СтрНайти(ПолноеИмя, ".") - 1));

	Если СтрНайти(ИмяВНижнемРегистре, ".команда.") > 0 Или ВидОбъекта = "общаякоманда" Тогда

		Возврат "e1cib/command/" + ПолноеИмя;

	ИначеЕсли ВидОбъекта = "обработка" Или ВидОбъекта = "отчет" Или ВидОбъекта = "общаяформа" Тогда

		Возврат "e1cib/app/" + ПолноеИмя;

	Иначе

		Возврат "e1cib/list/" + ПолноеИмя;

	КонецЕсли;

КонецФункции

Функция ИмяОбъектаМетаданных(ПолноеИмя)

	Части = СтрРазделить(ПолноеИмя, ".", Ложь);
	Если Части.Количество() < 2 Тогда

		Возврат ПолноеИмя;

	КонецЕсли;

	Возврат Части[0] + "." + Части[1];

КонецФункции

Функция ДанныеКомандыВиджета(Виджет, НомерКоманды)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Виджет", Виджет);
	Запрос.УстановитьПараметр("НомерСтроки", НомерКоманды);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КомандыВиджета.Представление КАК Представление,
	|	КомандыВиджета.Действие КАК Действие,
	|	КомандыВиджета.ПараметрДействия КАК ПараметрДействия
	|ИЗ
	|	Справочник.пбп_Виджеты.Команды КАК КомандыВиджета
	|ГДЕ
	|	КомандыВиджета.Ссылка = &Виджет
	|	И КомандыВиджета.НомерСтроки = &НомерСтроки";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда

		ВызватьИсключение НСтр("ru = 'Команда виджета не найдена.'");

	КонецЕсли;

	ДанныеКоманды = Новый Структура("Представление, Действие, ПараметрДействия");
	ЗаполнитьЗначенияСвойств(ДанныеКоманды, Выборка);

	Возврат ДанныеКоманды;

КонецФункции

Функция КлючОбъектаНастроек()

	Возврат "пбп_Виджеты";

КонецФункции

Функция КлючНастройкиРабочегоСтола()

	Возврат "РабочийСтол";

КонецФункции

#КонецОбласти
