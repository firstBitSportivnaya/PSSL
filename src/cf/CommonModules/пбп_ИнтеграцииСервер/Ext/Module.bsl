#Область КоманднаяСтрока

// Выполняет указанную команду системы интеграционного потока
//
// Параметры:
//  ИнтеграционныйПоток			 - СправочникСсылка.пбп_ИнтеграционныеПотоки - интеграционный поток, хранящий данные команды
//  СтруктураАтрибутов			 - Структура - ключ - наименование атрибута, значение - значение атрибута
//  СимволПараметра				 - Строка - символ инициализации параметра команды (по-умолчанию "/")
//  РазделительПараметраЗначения - Строка - символ разделителя между именем и значением параметра (по-умолчанию " ")
//  ПараметрыЗапускаКоманды		 - Структура - см. пбп_ФайловаяСистема.ПараметрыЗапускаПрограммы
//  СтруктураИстории			 - Структура - см. пбп_ИнтеграцииСлужебный.ПолучитьСтруктуруЗаписиИстории
// 
// Возвращаемое значение:
//  Число, Строка - см. пбп_ФайловаяСистема.ЗапуститьПрограмму
//
Функция ВыполнитьКомандуСистемы(ИнтеграционныйПоток, СтруктураАтрибутов,
	СимволПараметра = "/", РазделительПараметраЗначения = " ",
	ПараметрыЗапускаКоманды = Неопределено, СтруктураИстории = Неопределено) Экспорт
	
	РеквизитыПотока = пбп_Переадресация.ЗначенияРеквизитовОбъекта(
		ИнтеграционныйПоток, "НастройкаИнтеграции.ИнтегрируемаяСистема, НастройкаИнтеграции.СтрокаПодключения, ТочкаВхода");
	
	СтрокаАтрибутов = "";
	
	Для Каждого КлючИЗначение Из СтруктураАтрибутов Цикл
		Разделитель = ?(ПустаяСтрока(СтрокаАтрибутов), СимволПараметра, " " + СимволПараметра);
		СтрокаАтрибутов = СтрокаАтрибутов + Разделитель + КлючИЗначение.Ключ
			+ РазделительПараметраЗначения + """" + КлючИЗначение.Значение + """";
	КонецЦикла;
	
	ИтоговаяКоманда = СтрШаблон("%1 %2 %3", РеквизитыПотока.НастройкаИнтеграцииСтрокаПодключения,
		РеквизитыПотока.ТочкаВхода, СтрокаАтрибутов);
	
	Если ПараметрыЗапускаКоманды = Неопределено Тогда
		ПараметрыЗапускаКоманды = пбп_Переадресация.ПараметрыЗапускаПрограммы();
		ПараметрыЗапускаКоманды.ДождатьсяЗавершения = Истина;
	КонецЕсли;
	
	Если СтруктураИстории <> Неопределено Тогда
		НачалоВызова = ТекущаяДатаСеанса();
	КонецЕсли;
	
	// BSLLS:ExternalAppStarting-off
	Результат = пбп_Переадресация.ЗапуститьПрограмму(ИтоговаяКоманда, ПараметрыЗапускаКоманды);
	// BSLLS:ExternalAppStarting-on
	
	Если СтруктураИстории <> Неопределено Тогда
		СтруктураИстории.ДлительностьВызова = ТекущаяДатаСеанса() - НачалоВызова;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти // КоманднаяСтрока

#КонецОбласти

#КонецОбласти // ПрограммныйИнтерфейс

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьДанныеОбъектовИзСоставногоЗапроса(Запрос,
	СимволыРазделителя, ПоместитьФайлыВХранилище, СтруктураИстории)
	
	Заголовки = КонвертироватьЗаголовкиПоСтандартуRFC(Запрос.Заголовки);
	Тело = Запрос.ПолучитьТелоКакДвоичныеДанные();
	
	РезультатЧтения = ПрочитатьСообщениеСоставногоЗапроса(Заголовки,
		Тело, СимволыРазделителя, ПоместитьФайлыВХранилище);
	
	Если ЗначениеЗаполнено(СтруктураИстории)
		И ТипЗнч(РезультатЧтения) = Тип("Структура") Тогда
		СтруктураИстории.ВходящееСообщение = РезультатЧтения.ТекстСообщения;
	КонецЕсли;
	
	Возврат РезультатЧтения;
	
КонецФункции

Функция КонвертироватьЗаголовкиПоСтандартуRFC(Заголовки)
	
	ЗаголовкиRFC = Новый Соответствие;
	Для Каждого КлючИЗначение Из Заголовки Цикл
		ЗаголовкиRFC.Вставить(НРег(КлючИЗначение.Ключ), КлючИЗначение.Значение);
	КонецЦикла;
	
	Возврат ЗаголовкиRFC;
	
КонецФункции

Функция ПрочитатьСообщениеСоставногоЗапроса(Заголовки,
	Тело, СимволыРазделителя, ПоместитьФайлыВХранилище)
	
	Разделитель = ПолучитьРазделительСоставногоЗапроса(Заголовки);
	Если Не ЗначениеЗаполнено(Разделитель) Тогда
		Возврат "ru = 'Разделитель boundary не заполнен в заголовках запроса'";
	КонецЕсли;
	
	Маркеры = Новый Массив;
	Маркеры.Добавить(ПолучитьБуферДвоичныхДанныхИзСтроки(СимволыРазделителя + Разделитель));
	Маркеры.Добавить(ПолучитьБуферДвоичныхДанныхИзСтроки(СимволыРазделителя + Разделитель + Символы.ПС));
	Маркеры.Добавить(ПолучитьБуферДвоичныхДанныхИзСтроки(СимволыРазделителя + Разделитель + Символы.ВК));
	Маркеры.Добавить(ПолучитьБуферДвоичныхДанныхИзСтроки(СимволыРазделителя + Разделитель + Символы.ВК + Символы.ПС));
	Маркеры.Добавить(ПолучитьБуферДвоичныхДанныхИзСтроки(СимволыРазделителя + Разделитель + СимволыРазделителя));
	
	ТекстСообщения = Неопределено;
	ФайлыСообщения = Новый Соответствие;
	
	ЧтениеДанных = Новый ЧтениеДанных(Тело);
	
	// Перейти к началу первой части.
	ЧтениеДанных.ПропуститьДо(Маркеры);
	
	ОбщийБуферДвоичныхДанных = ЧтениеДанных.ПрочитатьВБуферДвоичныхДанных();
	БуферыДвоичныхДанных = ОбщийБуферДвоичныхДанных.Разделить(Маркеры);
	
	Если Не БуферыДвоичныхДанных.Количество() Тогда
		Возврат "ru = 'Запрос типа multipart/form-data составлен некорректно'";
	КонецЕсли;
	
	// Прочитать в цикле все части тела сообщения.
	Для Каждого Буфер Из БуферыДвоичныхДанных Цикл
		Поток = Новый ПотокВПамяти(Буфер);
		ЧтениеЧасти = Новый ЧтениеДанных(Поток);
		
		ЗаголовкиЧасти = ПрочитатьЗаголовкиСоставногоЗапроса(ЧтениеЧасти);
		ИменаЧасти = ПолучитьИмяСообщенияСоставногоЗапроса(ЗаголовкиЧасти);
		Если Не ЗначениеЗаполнено(ИменаЧасти) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ИменаЧасти.Свойство("name") Тогда
			Продолжить;
		КонецЕсли;
		
		// Если блок не содержит filename, то это содержимое запроса
		Если Не ИменаЧасти.Свойство("filename") Тогда
			ТекстСообщения = ЧтениеЧасти.ПрочитатьСимволы();
		Иначе
			ИмяЧасти = ИменаЧасти.filename;
			
			ФайлыСообщения.Вставить(ИмяЧасти);
			
			ДанныеФайла = ЧтениеЧасти.Прочитать().ПолучитьДвоичныеДанные();
			Если ПоместитьФайлыВХранилище Тогда
				ФайлыСообщения[ИмяЧасти] = ПоместитьВоВременноеХранилище(
					ДанныеФайла,
					Новый УникальныйИдентификатор);
			Иначе
				ФайлыСообщения[ИмяЧасти] = ДанныеФайла;
			КонецЕсли;
		КонецЕсли;
		
		ПерваяИтерация = Ложь;
		
		ЧтениеЧасти.Закрыть();
		Поток.Закрыть();
	КонецЦикла;
	
	ЧтениеДанных.Закрыть();
	
	Возврат Новый Структура("ТекстСообщения, ФайлыСообщения", ТекстСообщения, ФайлыСообщения);
	
КонецФункции

Функция ПолучитьРазделительСоставногоЗапроса(Заголовки)
	
	ТипСодержимого = Заголовки.Получить("content-type");
	Если ТипСодержимого = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Свойства = СтрРазделить(ТипСодержимого, ";", Ложь);
	
	Граница = Неопределено;
	
	Для Каждого Свойство Из Свойства Цикл
		Части = СтрРазделить(Свойство, "=", Ложь);
		ИмяСвойства = СокрЛП(Части[0]);
		
		Если ИмяСвойства = "boundary" Тогда
			Граница = СокрЛП(Части[1]);
			Граница = СтрЗаменить(Граница, """", "");
			
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Граница;
	
КонецФункции

Функция ПрочитатьЗаголовкиСоставногоЗапроса(Чтение)
	
	Заголовки = Новый Соответствие;
	
	Пока Истина Цикл
		Строка = Чтение.ПрочитатьСтроку();
		
		Если Строка = "" Тогда
			Прервать;
		КонецЕсли;
		
		Части = СтрРазделить(Строка, ":");
		Если Части.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяЗаголовка = СокрЛП(Части[0]);
		Значение = СокрЛП(Части[1]);
		
		Заголовки.Вставить(ИмяЗаголовка, Значение);
	КонецЦикла;
	
	Возврат Заголовки;
	
КонецФункции

Функция ПолучитьИмяСообщенияСоставногоЗапроса(Заголовки)
	
	Описание = Заголовки.Получить("content-disposition");
	Если Описание = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Свойства = СтрРазделить(Описание, ";", Ложь);
	
	Имена = Новый Структура;
	Для Каждого Свойство Из Свойства Цикл
		Части = СтрРазделить(Свойство, "=", Ложь);
		
		ИмяСвойства = СокрЛП(Части[0]);
		
		Если Части.Количество() = 2 И (ИмяСвойства = "name" Или ИмяСвойства = "filename") Тогда
			Имя = СокрЛП(Части[1]);
			Имя = СтрЗаменить(Имя, """", "");
			Имена.Вставить(ИмяСвойства, Имя);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Имена;
	
КонецФункции

Процедура ЗаписатьФайлыСоставногоЗапросаВИсториюИнтеграции(ФайлыЗапроса,
	СтруктураИстории, ПоместитьФайлыВХранилище)
	
	КоличествоФайлов = ФайлыЗапроса.Количество();
	Если КоличествоФайлов = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если КоличествоФайлов = 1 Тогда
		Для Каждого КлючИЗначение Из ФайлыЗапроса Цикл
			СтруктураИстории.ИмяФайлаСообщения = КлючИЗначение.Ключ;
			Если ПоместитьФайлыВХранилище Тогда
				ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(КлючИЗначение.Значение);
			Иначе
				ДвоичныеДанныеФайла = КлючИЗначение.Значение;
			КонецЕсли;
			
			СтруктураИстории.ФайлСообщения = Новый ХранилищеЗначения(ДвоичныеДанныеФайла, Новый СжатиеДанных(9));
		КонецЦикла;
	Иначе
		ЗаписатьФайлыСоставногоЗапросаВАрхив(ФайлыЗапроса, СтруктураИстории, ПоместитьФайлыВХранилище);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаписатьФайлыСоставногоЗапросаВАрхив(ФайлыЗапроса, СтруктураИстории, ПоместитьФайлыВХранилище)
	
	ИмяФайлаАрхива = ПолучитьИмяВременногоФайла("zip");
	ZipФайл = Новый ЗаписьZipФайла(ИмяФайлаАрхива);
	
	МассивИменВременныхФайлов = Новый Массив;
	
	Для Каждого КлючИЗначение Из ФайлыЗапроса Цикл
		ИмяВременногоФайла = ПолучитьИмяВременногоФайлаДляФайлаСоставногоЗапроса(КлючИЗначение.Ключ);
		
		Если ПоместитьФайлыВХранилище Тогда
			ДанныеФайла = ПолучитьИзВременногоХранилища(КлючИЗначение.Значение);
		Иначе
			ДанныеФайла = КлючИЗначение.Значение;
		КонецЕсли;
		
		ДанныеФайла.Записать(ИмяВременногоФайла);
		
		ZipФайл.Добавить(ИмяВременногоФайла);
		МассивИменВременныхФайлов.Добавить(ИмяВременногоФайла);
	КонецЦикла;
	
	ZipФайл.Записать();
	
	СтруктураИстории.ИмяФайлаСообщения = "Файлы запроса.zip";
	
	ДвоичныеДанныеАрхива = Новый ДвоичныеДанные(ИмяФайлаАрхива);
	СтруктураИстории.ФайлСообщения = Новый ХранилищеЗначения(ДвоичныеДанныеАрхива, Новый СжатиеДанных(9));
	
	Для Каждого ИмяФайла Из МассивИменВременныхФайлов Цикл
		пбп_Переадресация.УдалитьВременныйФайл(ИмяФайла);
	КонецЦикла;
	
	пбп_Переадресация.УдалитьВременныйФайл(ИмяФайлаАрхива);
	
КонецПроцедуры

Функция ПолучитьИмяВременногоФайлаДляФайлаСоставногоЗапроса(ИмяФайла)
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
	РазделительПутиОС = ПолучитьРазделительПути();
	МассивРазделителей = пбп_ПереадресацияКлиентСервер.РазложитьСтрокуВМассивПодстрок(
		ИмяВременногоФайла, РазделительПутиОС);
	
	МассивРазделителей.Удалить(МассивРазделителей.Количество() - 1);
	ИмяВременногоФайла = СтрСоединить(МассивРазделителей, РазделительПутиОС);
	
	Возврат ИмяВременногоФайла + РазделительПутиОС + ИмяФайла;
	
КонецФункции

#КонецОбласти // СлужебныеПроцедурыИФункции