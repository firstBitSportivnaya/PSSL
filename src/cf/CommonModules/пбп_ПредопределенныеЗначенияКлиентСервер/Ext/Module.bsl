// Работа с коллекциями (клиент, сервер): Модуль содержит методы работы с универсальными коллекциями значений.

#Область СлужебныйПрограммныйИнтерфейс

Функция ИмяКомандыЗаполненияПредопределенных() Экспорт
	Возврат "ЗаполнитьПредопределенные";
КонецФункции

#КонецОбласти
#Область ПрограммныйИнтерфейс

// Формирует фрагмент кода добавления элемента плана видов характеристик
// пбп_ПредопределенныеЗначения для вставки в процедуру ПредопределенныеЗначения
// модуля пбп_ПредопределенныеЗначенияПереопределяемый.
//
// Параметры:
//  ОписаниеЭлемента - Структура:
//   * Наименование - Строка - наименование элемента.
//   * ИдентификаторНастройки - Строка - идентификатор настройки.
//   * ЭтоГруппа - Булево - Истина, если нужна группа.
//   * ИдентификаторРодитель - Строка - идентификатор родителя.
//   * УровеньИерархии - Число - уровень группы.
//   * Пароль - Булево - признак пароля.
//   * СписокЗначений - Булево - признак списка значений.
//   * Кэшируется - Булево - признак кэширования.
//   * ВидТипа - Строка - Строка, Число, Булево, Дата, Другой или имя типа из состава плана.
//   * ДлинаСтроки - Число - длина строки, 0 - без ограничения.
//   * ДопустимаяДлина - Строка - Переменная или Фиксированная.
//   * Разрядность - Число - разрядность числа.
//   * РазрядностьДробнойЧасти - Число - дробная часть числа.
//   * Неотрицательное - Булево - допустимый знак неотрицательный.
//   * ЧастиДаты - Строка - Дата, Время или ДатаВремя.
//   * ИмяТипа - Строка - имя типа, если ВидТипа = Другой.
//   * ДопустимыеИменаТипов - Массив из Строка - имена из состава типа плана.
//     Для Строка, Число, Булево и Дата не нужен. Для Другого и ссылочного имени
//     без списка ТипЗначения в код не попадает.
//
// Возвращаемое значение:
//  Строка - фрагмент кода на встроенном языке.
//
Функция КодЭлементаПредопределенногоЗначения(ОписаниеЭлемента) Экспорт
	
	Строки = Новый Массив;
	Строки.Добавить("// Вставить в процедуру ПредопределенныеЗначения");
	Строки.Добавить("// модуля пбп_ПредопределенныеЗначенияПереопределяемый.");
	Строки.Добавить("НоваяНастройка = Таблица.Добавить();");
	ДобавитьПрисваивание(Строки, "Наименование", ЛитералСтроки(ЗначениеСвойства(ОписаниеЭлемента, "Наименование", "")));
	ДобавитьПрисваивание(Строки, "ИдентификаторНастройки",
		ЛитералСтроки(ЗначениеСвойства(ОписаниеЭлемента, "ИдентификаторНастройки", "")));
	
	ЭтоГруппа = ЗначениеСвойства(ОписаниеЭлемента, "ЭтоГруппа", Ложь);
	
	Если ЭтоГруппа Тогда
		
		ДобавитьПрисваивание(Строки, "ЭтоГруппа", "Истина");
		ДобавитьПрисваивание(Строки, "УровеньИерархии",
			ЛитералЧисла(ЗначениеСвойства(ОписаниеЭлемента, "УровеньИерархии", 0)));
		
	КонецЕсли;
	
	ИдентификаторРодитель = ЗначениеСвойства(ОписаниеЭлемента, "ИдентификаторРодитель", "");
	
	Если ЗначениеЗаполнено(ИдентификаторРодитель) Тогда
		
		ДобавитьПрисваивание(Строки, "ИдентификаторРодитель", ЛитералСтроки(ИдентификаторРодитель));
		
	КонецЕсли;
	
	Если Не ЭтоГруппа Тогда
		
		ДобавитьПрисваивание(Строки, "Пароль", ЛитералБулево(ЗначениеСвойства(ОписаниеЭлемента, "Пароль", Ложь)));
		ДобавитьПрисваивание(Строки, "СписокЗначений",
			ЛитералБулево(ЗначениеСвойства(ОписаниеЭлемента, "СписокЗначений", Ложь)));
		ДобавитьКодТипа(Строки, ОписаниеЭлемента);
		
		Если ЗначениеСвойства(ОписаниеЭлемента, "Кэшируется", Ложь) Тогда
			
			ДобавитьПрисваивание(Строки, "Кэшируется", "Истина");
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьПрисваивание(Строки, ИмяСвойства, Литерал)
	
	Строки.Добавить("НоваяНастройка." + ИмяСвойства + " = " + Литерал + ";");
	
КонецПроцедуры

Процедура ДобавитьКодТипа(Строки, ОписаниеЭлемента)
	
	ВыражениеТипа = ВыражениеОписанияТипов(ОписаниеЭлемента);
	
	Если ЗначениеЗаполнено(ВыражениеТипа) Тогда
		
		ДобавитьПрисваивание(Строки, "ТипЗначения", ВыражениеТипа);
		
	КонецЕсли;
	
КонецПроцедуры

Функция ВыражениеОписанияТипов(ОписаниеЭлемента)
	
	ВидТипа = ЗначениеСвойства(ОписаниеЭлемента, "ВидТипа", "");
	ИмяТипа = "";
	
	Если ВидТипа = "Строка" Тогда
		
		Возврат ВыражениеТипаСтрока(ОписаниеЭлемента);
		
	ИначеЕсли ВидТипа = "Число" Тогда
		
		Возврат ВыражениеТипаЧисло(ОписаниеЭлемента);
		
	ИначеЕсли ВидТипа = "Дата" Тогда
		
		Возврат ВыражениеТипаДата(ОписаниеЭлемента);
		
	ИначеЕсли ВидТипа = "Булево" Тогда
		
		Возврат "пбп_РаботаСФормами.ОписаниеТипаБулево()";
		
	ИначеЕсли ВидТипа = "Другой" Тогда
		
		ИмяТипа = ДопустимоеИмяТипаПлана(ЗначениеСвойства(ОписаниеЭлемента, "ИмяТипа", ""), ОписаниеЭлемента);
		
	Иначе
		
		ИмяТипа = ДопустимоеИмяТипаПлана(ВидТипа, ОписаниеЭлемента);
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ИмяТипа) Тогда
		
		Возврат "";
		
	КонецЕсли;
	
	Возврат ВыражениеТипаПоИмени(ИмяТипа);
	
КонецФункции

Функция ВыражениеТипаПоИмени(ИмяТипа)
	
	Если ИмяТипа = "Строка" Тогда
		
		Возврат "пбп_РаботаСФормами.ОписаниеТипаСтрока()";
		
	ИначеЕсли ИмяТипа = "Число" Тогда
		
		Возврат "пбп_РаботаСФормами.ОписаниеТипаЧисло(0, 0)";
		
	ИначеЕсли ИмяТипа = "Дата" Тогда
		
		Возврат "пбп_РаботаСФормами.ОписаниеТипаДатаВремя()";
		
	ИначеЕсли ИмяТипа = "Булево" Тогда
		
		Возврат "пбп_РаботаСФормами.ОписаниеТипаБулево()";
		
	КонецЕсли;
	
	ПозицияТочки = СтрНайти(ИмяТипа, ".");
	
	Если ПозицияТочки = 0 Тогда
		
		Возврат "Новый ОписаниеТипов(" + ЛитералСтроки(ИмяТипа) + ")";
		
	КонецЕсли;
	
	Префикс = Лев(ИмяТипа, ПозицияТочки - 1);
	ИмяОбъекта = Сред(ИмяТипа, ПозицияТочки + 1);
	ЛитералИмени = ЛитералСтроки(ИмяОбъекта);
	
	Если Префикс = "СправочникСсылка" Тогда
		
		Возврат "пбп_РаботаСФормами.ОписаниеТипаСправочник(" + ЛитералИмени + ")";
		
	ИначеЕсли Префикс = "ДокументСсылка" Тогда
		
		Возврат "пбп_РаботаСФормами.ОписаниеТипаДокумент(" + ЛитералИмени + ")";
		
	ИначеЕсли Префикс = "ПеречислениеСсылка" Тогда
		
		Возврат "пбп_РаботаСФормами.ОписаниеТипаПеречисление(" + ЛитералИмени + ")";
		
	КонецЕсли;
	
	Возврат "Новый ОписаниеТипов(" + ЛитералСтроки(ИмяТипа) + ")";
	
КонецФункции

// Каноническое имя, если оно есть в составе типа плана. Иначе пустая строка.
//
Функция ДопустимоеИмяТипаПлана(ИмяТипа, ОписаниеЭлемента)
	
	Имя = ВРег(СокрЛП(ИмяТипа));
	ДопустимыеИмена = ЗначениеСвойства(ОписаниеЭлемента, "ДопустимыеИменаТипов", Новый Массив);
	
	Если Не ЗначениеЗаполнено(Имя) Или ТипЗнч(ДопустимыеИмена) <> Тип("Массив") Тогда
		
		Возврат "";
		
	КонецЕсли;
	
	Для Каждого ИмяПлана Из ДопустимыеИмена Цикл
		
		Если ВРег(ИмяПлана) = Имя Тогда
			
			Возврат ИмяПлана;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

Функция ВыражениеТипаСтрока(ОписаниеЭлемента)
	
	ДлинаСтроки = ЗначениеСвойства(ОписаниеЭлемента, "ДлинаСтроки", 0);
	ИмяДопустимойДлины = ЗначениеСвойства(ОписаниеЭлемента, "ДопустимаяДлина", "Переменная");
	Фиксированная = ИмяДопустимойДлины = "Фиксированная";
	Аргументы = "";
	
	Если ДлинаСтроки > 0 Или Фиксированная Тогда
		
		Аргументы = ЛитералЧисла(ДлинаСтроки);
		
	КонецЕсли;
	
	Если Фиксированная Тогда
		
		Аргументы = Аргументы + ", ДопустимаяДлина.Фиксированная";
		
	КонецЕсли;
	
	Возврат "пбп_РаботаСФормами.ОписаниеТипаСтрока(" + Аргументы + ")";
	
КонецФункции

Функция ВыражениеТипаЧисло(ОписаниеЭлемента)
	
	Разрядность = ЗначениеСвойства(ОписаниеЭлемента, "Разрядность", 0);
	ДробнаяЧасть = ЗначениеСвойства(ОписаниеЭлемента, "РазрядностьДробнойЧасти", 0);
	Аргументы = ЛитералЧисла(Разрядность) + ", " + ЛитералЧисла(ДробнаяЧасть);
	
	Если ЗначениеСвойства(ОписаниеЭлемента, "Неотрицательное", Ложь) Тогда
		
		Аргументы = Аргументы + ", ДопустимыйЗнак.Неотрицательный";
		
	КонецЕсли;
	
	Возврат "пбп_РаботаСФормами.ОписаниеТипаЧисло(" + Аргументы + ")";
	
КонецФункции

Функция ВыражениеТипаДата(ОписаниеЭлемента)
	
	ИмяЧастейДаты = ЗначениеСвойства(ОписаниеЭлемента, "ЧастиДаты", "Дата");
	ИмяЧастей = "Дата";
	
	Если ИмяЧастейДаты = "Время" Тогда
		
		ИмяЧастей = "Время";
		
	ИначеЕсли ИмяЧастейДаты = "ДатаВремя" Тогда
		
		ИмяЧастей = "ДатаВремя";
		
	КонецЕсли;
	
	Возврат "пбп_РаботаСФормами.ОписаниеТипаДатаВремя(" + ЛитералСтроки(ИмяЧастей) + ")";
	
КонецФункции

Функция ЛитералСтроки(Значение)
	
	Текст = Строка(Значение);
	Текст = СтрЗаменить(Текст, Символы.ВК, " ");
	Текст = СтрЗаменить(Текст, Символы.ПС, " ");
	Текст = СтрЗаменить(Текст, """", """""");
	
	Возврат """" + Текст + """";
	
КонецФункции

Функция ЛитералЧисла(Значение)
	
	Возврат Формат(Значение, "ЧН=0; ЧГ=0");
	
КонецФункции

Функция ЛитералБулево(Значение)
	
	Если Значение Тогда
		
		Возврат "Истина";
		
	КонецЕсли;
	
	Возврат "Ложь";
	
КонецФункции

Функция ЗначениеСвойства(Описание, Имя, ПоУмолчанию)
	
	Значение = Неопределено;
	
	Если ТипЗнч(Описание) <> Тип("Структура")
		Или Не Описание.Свойство(Имя, Значение)
		Или Значение = Неопределено Тогда
		
		Возврат ПоУмолчанию;
		
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

#КонецОбласти
