#Область ПрограммныйИнтерфейс

// Функция предназначена для обработки входящих запросов формирования спецификации.
//
// Параметры:
//  Запрос	 - HTTPСервисЗапрос - Запрос формирования спецификации.
// 
// Возвращаемое значение:
//  HTTPСервисОтвет - Ответ с ошибкой или данными спецификации.
//
Функция ОбработатьЗапросСпецификации(Запрос) Экспорт
	
	Перем РезультатОбработчика;
	
	Параметры = ПараметрыОбработчика(Запрос);
	
	Попытка
		Обработчик = ПеренаправлениеНаОбработчик(Запрос.ОтносительныйURL, Параметры);
	Исключение
		ОписаниеОшибки = ОписаниеОшибки();
		
		Возврат СформироватьОтветОшибки(ОписаниеОшибки);
	КонецПопытки;
	
	Если ЗначениеЗаполнено(Обработчик) Тогда
		Попытка
			РезультатОбработчика = пбп_Переадресация.ВычислитьВБезопасномРежиме(Обработчик, Параметры);
		Исключение
			ОписаниеОшибки = ОписаниеОшибки();
			
			Возврат СформироватьОтветОшибки(ОписаниеОшибки);
		КонецПопытки;
		
		КонтекстОтвета = СформироватьДанныеКонтекстаОтвета(РезультатОбработчика);
	Иначе
		ОписаниеОшибки = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Ресурс %1 не найден'"),
			Запрос.ОтносительныйURL);
		
		Возврат СформироватьОтветОшибки(ОписаниеОшибки);
	КонецЕсли;
		
	Возврат СформироватьОтвет(КонтекстОтвета);
	
КонецФункции

// Возвращает обработчик для передаваемого ресурса.
//
// Параметры:
//  Ресурс	 - Строка - Ресурс сервиса. 
// 
// Возвращаемое значение:
//  Строка - Обработчик ресурса
//
Функция ПолучитьОбработчикРесурса(Ресурс) Экспорт
	
	Обработчик = пбп_ПостроительСпецификацииOpenAPIПовтИсп.ОбработчикиРесурсов()[Ресурс];
	
	Если Обработчик = Неопределено Тогда
		ВызватьИсключение пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Не найден обработчик для ресурса %1'"),
			Ресурс);
	КонецЕсли;
	
	Возврат Обработчик;
	
КонецФункции

// Возвращает спецификация по имени сервиса.
//
// Параметры:
//  ИмяСервиса	 - Строка - Имя сервиса, по которому запрошена спецификация.
// 
// Возвращаемое значение:
//  Строка - Содержит текст спецификации.
//
Функция ПолучитьСпецификациюСервиса(ИмяСервиса) Экспорт 
	
	ИмяСпецификации = пбп_ПостроительСпецификацииOpenAPIПереопределяемый.ИменаМакетовСервисов()[ИмяСервиса];
	
	Если ИмяСпецификации = Неопределено Тогда
		ВызватьИсключение пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Не найдена спецификация сервиса %1'"),
			ИмяСервиса);
	КонецЕсли;
	
	Возврат ПолучитьОбщийМакет(ИмяСпецификации).ПолучитьТекст();
	
КонецФункции

#КонецОбласти // ПрограммныйИнтерфейс

#Область СлужебныйПрограммныйИнтерфейс

Функция ПеренаправлениеНаОбработчик(Ресурс, Параметры) Экспорт
	
	Обработчик = ПолучитьОбработчикРесурса(Ресурс);
	
	ПередаваемыеПараметры = ?(ЗначениеЗаполнено(Параметры), "Параметры", "");
	
	Выражение = Обработчик + "(" + ПередаваемыеПараметры + ")";
	
	Возврат Выражение;

КонецФункции

Функция ОбработчикМетодаДокументацииСервиса(Параметры) Экспорт
	
	КорневойURL = Параметры.КорневойURL;
	
	Иконка16Ссылка = КорневойURL + "/favicon-16x16.png";
	Иконка32Ссылка = КорневойURL + "/favicon-32x32.png";
	СтилиСсылка = КорневойURL + "/swagger-ui.css";
	СкриптыСсылка = КорневойURL + "/swagger-ui-bundle.js";
	СпецификацияСсылка = КорневойURL + "/openapi.json";
	
	ТипОтвета = Перечисления.пбп_ТипыОтветовREST.Успешно;
	
	Макет = ПолучитьОбщийМакет("СпецификацияСтраницаREST");
	Макет.ВставитьСтроку(15, "supportedSubmitMethods: [], // Отключает кнопку ""Try it out""");
	
	СодержаниеОтвета = Макет.ПолучитьТекст();
	СодержаниеОтвета = СтрЗаменить(СодержаниеОтвета, "[Заголовок]", "Swagger UI");
	СодержаниеОтвета = СтрЗаменить(СодержаниеОтвета, "[Иконка16Ссылка]", Иконка16Ссылка);
	СодержаниеОтвета = СтрЗаменить(СодержаниеОтвета, "[Иконка32Ссылка]", Иконка32Ссылка);
	СодержаниеОтвета = СтрЗаменить(СодержаниеОтвета, "[СтилиСсылка]", СтилиСсылка);
	СодержаниеОтвета = СтрЗаменить(СодержаниеОтвета, "[СкриптыСсылка]", СкриптыСсылка);
	СодержаниеОтвета = СтрЗаменить(СодержаниеОтвета, "[СпецификацияСсылка]", СпецификацияСсылка);
	
	ЗаголовкиОтвета = Новый Соответствие;
	ЗаголовкиОтвета.Вставить("Content-Type", "text/html; charset=utf-8");
	
	Возврат СформироватьРезультатОбработчика(ТипОтвета, СодержаниеОтвета, ЗаголовкиОтвета);
	
КонецФункции

Функция ОбработчикМетодаИконка16ДокументацииСервиса() Экспорт
	
	ТипОтвета = Перечисления.пбп_ТипыОтветовREST.Успешно;
	
