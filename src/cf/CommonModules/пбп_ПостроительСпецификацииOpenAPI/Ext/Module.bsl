#Область ПрограммныйИнтерфейс

// Функция предназначена для обработки входящих запросов формирования спецификации.
//
// Параметры:
//  Запрос	 - HTTPСервисЗапрос - Запрос формирования спецификации.
// 
// Возвращаемое значение:
//  HTTPСервисОтвет - Ответ с ошибкой или данными спецификации.
//
Функция ОбработатьЗапросСпецификации(Запрос) Экспорт
	
	Перем РезультатОбработчика;
	
	КодыСостояния = пбп_КоннекторHTTP.КодыСостоянияHTTP();
	
	Параметры = ПараметрыОбработчика(Запрос, КодыСостояния);
	
	ОписаниеОшибки = "";
	Попытка
		РезультатПеренаправления = ПеренаправлениеНаОбработчик(Запрос.ОтносительныйURL, Параметры);
		Если РезультатПеренаправления.КодСостояния <> Неопределено Тогда
			Возврат СформироватьОтветОшибки(ОписаниеОшибки, РезультатПеренаправления.КодСостояния, КодыСостояния);
		КонецЕсли;
	Исключение
		ОписаниеОшибки = ОписаниеОшибки(); // только для логирования
		КодСостояния = КодыСостояния.ВнутренняяОшибкаСервера_500;
		
		Возврат СформироватьОтветОшибки(ОписаниеОшибки, КодСостояния, КодыСостояния);
	КонецПопытки;
	
	Попытка
		РезультатОбработчика = пбп_Переадресация.ВычислитьВБезопасномРежиме(РезультатПеренаправления.Данные, Параметры);
	Исключение
		ОписаниеОшибки = ОписаниеОшибки(); // только для логирования
		КодСостояния = КодыСостояния.ВнутренняяОшибкаСервера_500;
		
		Возврат СформироватьОтветОшибки(ОписаниеОшибки, КодСостояния, КодыСостояния);
	КонецПопытки;
	
	КонтекстОтвета = СформироватьДанныеКонтекстаОтвета(РезультатОбработчика, КодыСостояния);
	
	Возврат СформироватьОтвет(КонтекстОтвета);
	
КонецФункции

// Возвращает обработчик для передаваемого ресурса.
//
// Параметры:
//  Ресурс			 - Строка	 - Ресурс сервиса.
//  КодыСостояния	 - Структура - см. пбп_КоннекторHTTP.КодыСостоянияHTTP
// 
// Возвращаемое значение:
//  Структура - см. пбп_ПостроительСпецификацииOpenAPI.РезультатВыполнения
//
Функция ПолучитьОбработчикРесурса(Ресурс, КодыСостояния) Экспорт
	
	Результат = РезультатВыполнения();
	
	Обработчик = пбп_ПостроительСпецификацииOpenAPIПовтИсп.ОбработчикиРесурсов()[Ресурс];
	
	Если Обработчик = Неопределено Тогда
		Результат.КодСостояния = КодыСостояния.НеРеализовано_501;
		Возврат Результат;
	КонецЕсли;
	
	Результат.Данные = Обработчик;
	
	Возврат Результат;
	
КонецФункции

// Возвращает спецификация по имени сервиса.
//
// Параметры:
//  ИмяСервиса	 - Строка - Имя сервиса, по которому запрошена спецификация.
// 
// Возвращаемое значение:
//  Строка - Содержит текст спецификации.
//
Функция ПолучитьСпецификациюСервиса(ИмяСервиса) Экспорт
	
	ИмяСпецификации = пбп_ПостроительСпецификацииOpenAPIПереопределяемый.ИменаМакетовСервисов()[ИмяСервиса];
	
	Если ЗначениеЗаполнено(ИмяСпецификации) Тогда
		Возврат пбп_ПостроительСпецификацииOpenAPIПовтИсп.ПолучитьМакетСпецификации(ИмяСпецификации);
	КонецЕсли;
	
	Спецификация = пбп_ПостроительСпецификацииOpenAPIПереопределяемый.СпецификацииСервисовСтрокой()[ИмяСервиса];
	Если ЗначениеЗаполнено(Спецификация) Тогда
		Возврат Спецификация;
	КонецЕсли;
	
	ВызватьИсключение пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru='Не найдена спецификация сервиса %1'"),
		ИмяСервиса);
	
КонецФункции

#КонецОбласти // ПрограммныйИнтерфейс

