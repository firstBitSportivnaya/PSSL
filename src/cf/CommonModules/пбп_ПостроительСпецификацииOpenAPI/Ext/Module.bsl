#Область СлужебныеПроцедурыИФункции

Функция СформироватьОтветОшибки(ОписаниеОшибки, КодСостояния, КодыСостояния)
	
	СодержаниеОшибки = пбп_КоннекторHTTP.ПредставлениеКодаСостоянияHTTP(КодСостояния);
	
	РезультатОбработчика = СформироватьРезультатОбработчика(КодСостояния, СодержаниеОшибки);
	
	КонтекстОтвета = СформироватьДанныеКонтекстаОтвета(РезультатОбработчика, КодыСостояния);
	
	Возврат СформироватьОтвет(КонтекстОтвета);
	
КонецФункции

Функция СформироватьОтвет(КонтекстОтвета)
	
	Результат = Новый HTTPСервисОтвет(КонтекстОтвета.Код);
	
	Если ЗначениеЗаполнено(КонтекстОтвета.ТелоСтрока) Тогда
		Результат.УстановитьТелоИзСтроки(КонтекстОтвета.ТелоСтрока);
	ИначеЕсли ЗначениеЗаполнено(КонтекстОтвета.ТелоДвоичныеДанные) Тогда
		Результат.УстановитьТелоИзДвоичныхДанных(КонтекстОтвета.ТелоДвоичныеДанные);
	КонецЕсли;
	
	Для Каждого КЗ Из КонтекстОтвета.Заголовки Цикл
		Результат.Заголовки.Вставить(КЗ.Ключ, КЗ.Значение);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция СтруктураДанныхКонтекстаОтвета()
	
	Результат = Новый Структура;
	
	Результат.Вставить("Код", 200);
	Результат.Вставить("ТелоСтрока", Неопределено);
	Результат.Вставить("ТелоДвоичныеДанные", Неопределено);
	Результат.Вставить("Заголовки", Новый Соответствие);
	
	Возврат Результат;
	
КонецФункции

Функция СформироватьДанныеКонтекстаОтвета(РезультатОбработчика, КодыСостояния)
	
	Код = РезультатОбработчика.Код;
	СодержаниеОтвета = РезультатОбработчика.СодержаниеОтвета;
	ЗаголовкиОтвета = РезультатОбработчика.ЗаголовкиОтвета;
	
	Результат = СтруктураДанныхКонтекстаОтвета();
	
	Результат.Код = Код;
	Если Код = КодыСостояния.ОК_200 Тогда
		Если ТипЗнч(СодержаниеОтвета) = Тип("ДвоичныеДанные") Тогда
			Результат.ТелоДвоичныеДанные = СодержаниеОтвета;
		Иначе
			Результат.ТелоСтрока = СодержаниеОтвета;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЗаголовкиОтвета) Тогда
			Для Каждого КЗ Из ЗаголовкиОтвета Цикл
				Результат.Заголовки.Вставить(КЗ.Ключ, КЗ.Значение);
			КонецЦикла;
		КонецЕсли;
	Иначе
		ОписаниеОшибки = СтруктураДанныхОписаниеОшибки();
		ОписаниеОшибки.error = СодержаниеОтвета;
		
		Результат.ТелоСтрока = пбп_КоннекторHTTP.ОбъектВJson(ОписаниеОшибки);
		Результат.Заголовки.Вставить("Content-Type", "application/json");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СтруктураДанныхОписаниеОшибки()
	
	Результат = Новый Структура;
	
	Результат.Вставить("error");
	
	Возврат Результат;
	
КонецФункции

#Область Ресурсы

Функция БазовыйРесурс()
	Возврат "/docs/openapi";
КонецФункции

Функция РесурсСпецификацииСервиса()
	Возврат "/spec/openapi.json";
КонецФункции

#КонецОбласти

Функция ПараметрыОбработчика(Запрос, КодыСостояния)
	
	Параметры = Новый Структура;
	
	ИмяСервиса = ПолучитьКлючСервиса(Запрос);
	
	Если Запрос.ОтносительныйURL = БазовыйРесурс() Тогда
		Параметры.Вставить("КорневойURL", Запрос.БазовыйURL);
	ИначеЕсли Запрос.ОтносительныйURL = РесурсСпецификацииСервиса() Тогда
		Параметры.Вставить("ИмяСервиса", ИмяСервиса);
	КонецЕсли;
	
	Параметры.Вставить("КодыСостояния", КодыСостояния);
	
	Возврат Параметры;
	
КонецФункции

Функция ПолучитьКлючСервиса(Запрос)
	
	Адрес = Запрос.БазовыйURL;
	Позиция = СтрНайти(Адрес, "/", НаправлениеПоиска.СКонца);
	
	Результат = Сред(Адрес, Позиция + 1);
	
	Возврат Результат;
	
КонецФункции

Функция СформироватьРезультатОбработчика(Код, СодержаниеОтвета = Неопределено, ЗаголовкиОтвета = Неопределено)
	
	Результат = Новый Структура;
	
	Результат.Вставить("Код", Код);
