#Область СлужебныеПроцедурыИФункции

Функция ПолучитьИмяМетода(Источник, Событие) Экспорт
	
	МетодСоответствия = пбп_ОбщегоНазначенияСервер
		.ПолучитьИмяФункцииСоответствияОбработчиковСобытий(Источник, Событие);
	
	СоответствиеОбработчиков = пбп_ОбщегоНазначенияПовтИсп
		.ПолучитьСоответствиеСуществующихОбработчиковСобытий(МетодСоответствия);
	
	ИмяМетода = СоответствиеОбработчиков.Получить(ТипЗнч(Источник));
	
	Возврат ИмяМетода;
	
КонецФункции

Функция ПолучитьТекстОшибки(ИмяМетода, ОписаниеОшибки)
	
	ТекстОшибки = СтрШаблон("ru = '%1%2Имя метода: %3';en = '%1%2Method name: %3'",
		ОписаниеОшибки, Символы.ПС, ИмяМетода);
	
	Возврат НСтр(ТекстОшибки);
	
КонецФункции

Процедура ПриУстановкеНовогоКодаИлиНомера(ИмяМетода, Источник, СтандартнаяОбработка, Префикс)
	
	Если Не ЗначениеЗаполнено(ИмяМетода) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		ПараметрыМетода = Новый Массив;
		ПараметрыМетода.Добавить(Источник);
		ПараметрыМетода.Добавить(СтандартнаяОбработка);
		ПараметрыМетода.Добавить(Префикс);
		
		пбп_Переадресация.ВыполнитьМетодКонфигурации(ИмяМетода, ПараметрыМетода);
		
	Исключение
		ВызватьИсключение ПолучитьТекстОшибки(ИмяМетода, ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

Процедура ВыпонитьСПараметрамиИсточникИОтказ(ИмяМетода, Источник, Отказ)
	
	Если Не ЗначениеЗаполнено(ИмяМетода) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ПараметрыМетода = Новый Массив;
		ПараметрыМетода.Добавить(Источник);
		ПараметрыМетода.Добавить(Отказ);
		
		пбп_Переадресация.ВыполнитьМетодКонфигурации(ИмяМетода, ПараметрыМетода);
		
		Источник = ПараметрыМетода[0];
		Если ПараметрыМетода[1] Тогда
			Отказ = Истина;
		КонецЕсли;
	Исключение
		ВызватьИсключение ПолучитьТекстОшибки(ИмяМетода, ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

Процедура ПриОтправкеДанных(ИмяМетода, Источник, ЭлементДанных,
	ОтправкаЭлемента, СозданиеНачальногоОбраза = Неопределено)
	
	Если Не ЗначениеЗаполнено(ИмяМетода) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ПараметрыМетода = Новый Массив;
		ПараметрыМетода.Добавить(Источник);
		ПараметрыМетода.Добавить(ЭлементДанных);
		ПараметрыМетода.Добавить(ОтправкаЭлемента);
		Если СозданиеНачальногоОбраза <> Неопределено Тогда
			ПараметрыМетода.Добавить(СозданиеНачальногоОбраза);
		КонецЕсли;
		
		пбп_Переадресация.ВыполнитьМетодКонфигурации(ИмяМетода, ПараметрыМетода);
		
		Источник			= ПараметрыМетода[0];
		ЭлементДанных		= ПараметрыМетода[1];
		ОтправкаЭлемента	= ПараметрыМетода[2];
		Если СозданиеНачальногоОбраза <> Неопределено Тогда
			СозданиеНачальногоОбраза = ПараметрыМетода[3];
		КонецЕсли;
	Исключение
		ВызватьИсключение ПолучитьТекстОшибки(ИмяМетода, ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

