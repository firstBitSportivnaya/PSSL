КонецПроцедуры

// Обработка формирования по версии истории данных
//
// Параметры:
//  Источник			 - СправочникОбъект, КонстантаМенеджерЗначения, ДокументОбъект, ПланВидовХарактеристикОбъект,
// ПланСчетовОбъект, ПланВидовРасчетаОбъект, ПланОбменаОбъект, БизнесПроцессОбъект, ЗадачаОбъект - источник подписки на событие
//  ДанныеВерсии		 - ФиксированнаяСтруктура	 - данные версии
//  НомерВерсии			 - Число					 - номер версии
//  ИсключитьДанные		 - Массив					 - список полей, исключаемые из стандартной обработки
//  СтандартнаяОбработка - Булево					 - стандартная обработка
//
Процедура ОбработкаФормированияПоВерсииИсторииДанных(Источник,
	ДанныеВерсии, НомерВерсии, ИсключитьДанные, СтандартнаяОбработка) Экспорт
	
	Событие = "ОбработкаФормированияПоВерсииИсторииДанных";
	ИмяМетода = пбп_ОбработкаСобытий.ПолучитьИмяМетода(Источник, Событие);
	
	пбп_ОбработкаСобытий.ОбработкаФормированияПоВерсииИсторииДанных(ИмяМетода,
		Источник, ДанныеВерсии, НомерВерсии, ИсключитьДанные, СтандартнаяОбработка);
	
КонецПроцедуры

// Обработка интерактивной активации
//
// Параметры:
//  Источник			 - БизнесПроцессОбъект, ЗадачаОбъект - источник подписки на событие
//  СтандартнаяОбработка - Булево							 - стандартная обработка
//
Процедура ОбработкаИнтерактивнойАктивации(Источник, СтандартнаяОбработка) Экспорт
	
	Событие = "ОбработкаИнтерактивнойАктивации";
	ИмяМетода = пбп_ОбработкаСобытий.ПолучитьИмяМетода(Источник, Событие);
	
	Если ЗначениеЗаполнено(ИмяМетода) Тогда
		Попытка
			ПараметрыМетода = Новый Массив;
			ПараметрыМетода.Добавить(Источник);
			ПараметрыМетода.Добавить(СтандартнаяОбработка);
			
			пбп_Переадресация.ВыполнитьМетодКонфигурации(ИмяМетода, ПараметрыМетода);
			
			Источник = ПараметрыМетода[0];
			Если Не ПараметрыМетода[1] Тогда
				СтандартнаяОбработка = Ложь;
			КонецЕсли;
		Исключение
			ВызватьИсключение пбп_ОбработкаСобытий.ПолучитьТекстОшибки(ИмяМетода, ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

