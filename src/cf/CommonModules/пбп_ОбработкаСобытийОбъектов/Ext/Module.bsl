// При копировании
// Используется для:
//  Справочников, документов, внешних источников данных, планов видов характеристик,
//  планов счетов, планов вида расчета, планов обмена, бизнес-процессов, задач
//
// Параметры:
//  Источник			 - 	 - 
//  ОбъектКопирования	 - 	 - 
//
Процедура ПриКопировании(Источник, ОбъектКопирования) Экспорт
	
	Событие = "ПриКопировании";
	ИмяМетода = ПолучитьИмяМетода(Источник, Событие);
	
	Если ЗначениеЗаполнено(ИмяМетода) Тогда
		Попытка
			ПараметрыМетода = Новый Массив;
			ПараметрыМетода.Добавить(Источник);
			ПараметрыМетода.Добавить(ОбъектКопирования);
			
			пбп_Переадресация.ВыполнитьМетодКонфигурации(ИмяМетода, ПараметрыМетода);
		Исключение
			ВызватьИсключение ПолучитьТекстОшибки(ИмяМетода, ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

// Обработка заполнения
// Используется для:
//  Справочников, документов, внешних источников данных, планов видов характеристик,
//  планов счетов, планов вида расчета, планов обмена, бизнес-процессов, задач
//
// Параметры:
//  Источник			 - 	 - 
//  ДанныеЗаполнения	 - 	 - 
//  ТекстЗаполнения		 - 	 - 
//  СтандартнаяОбработка - 	 - 
//
Процедура ОбработкаЗаполнения(Источник, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка) Экспорт
	
	Событие = "ОбработкаЗаполнения";
	ИмяМетода = ПолучитьИмяМетода(Источник, Событие);
	
	Если ЗначениеЗаполнено(ИмяМетода) Тогда
		Попытка
			ПараметрыМетода = Новый Массив;
			ПараметрыМетода.Добавить(Источник);
			ПараметрыМетода.Добавить(ДанныеЗаполнения);
			ПараметрыМетода.Добавить(ТекстЗаполнения);
			ПараметрыМетода.Добавить(СтандартнаяОбработка);
			
			пбп_Переадресация.ВыполнитьМетодКонфигурации(ИмяМетода, ПараметрыМетода);
			
			Источник			= ПараметрыМетода[0];
			ДанныеЗаполнения	= ПараметрыМетода[1];
			ТекстЗаполнения		= ПараметрыМетода[2];
			Если Не ПараметрыМетода[3] Тогда
				СтандартнаяОбработка = Ложь;
			КонецЕсли;
		Исключение
			ВызватьИсключение ПолучитьТекстОшибки(ИмяМетода, ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

// Перед записью
// Используется для:
//  Справочников, документов, внешних источников данных, планов видов характеристик,
//  планов счетов, планов вида расчета, планов обмена, бизнес-процессов, задач
//
// Параметры:
//  Источник		 - 	 - 
//  Отказ			 - 	 - 
//  РежимЗаписи		 - 	 - 
//  РежимПроведения	 - 	 - 
//
Процедура ПередЗаписью(Источник, Отказ, РежимЗаписи = Неопределено, РежимПроведения = Неопределено) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Событие = "ПередЗаписью";
	ИмяМетода = ПолучитьИмяМетода(Источник, Событие);
	
	Если ЗначениеЗаполнено(ИмяМетода) Тогда
		Попытка
			ПараметрыМетода = Новый Массив;
			ПараметрыМетода.Добавить(Источник);
			ПараметрыМетода.Добавить(Отказ);
			Если ЗначениеЗаполнено(РежимЗаписи) Тогда
				ПараметрыМетода.Добавить(РежимЗаписи);
			КонецЕсли;
			Если ЗначениеЗаполнено(РежимПроведения) Тогда
				ПараметрыМетода.Добавить(РежимПроведения);
			КонецЕсли;
			
			пбп_Переадресация.ВыполнитьМетодКонфигурации(ИмяМетода, ПараметрыМетода);
			
			Источник = ПараметрыМетода[0];
			Если ПараметрыМетода[1] Тогда
				Отказ = Истина;
			КонецЕсли;
		Исключение
			ВызватьИсключение ПолучитьТекстОшибки(ИмяМетода, ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

