#Область ПланыОбмена

// При отправке данных подчиненному
//
// Параметры:
//  Источник				 - ПланОбменаОбъект			 - источник подписки на событие
//  ЭлементДанных			 - Произвольный				 - элемент данных
//  ОтправкаЭлемента		 - ОтправкаЭлементаДанных	 - отправка элемента данных
//  СозданиеНачальногоОбраза - Булево					 - создани начального образа
//
Процедура ПриОтправкеДанныхПодчиненному(Источник, ЭлементДанных, ОтправкаЭлемента, СозданиеНачальногоОбраза) Экспорт
	
	Событие = "ПриОтправкеДанныхПодчиненному";
	ИмяМетода = пбп_ОбработкаСобытий.ПолучитьИмяМетода(Источник, Событие);
	
	ПриОтправкеДанных(ИмяМетода, Источник, ЭлементДанных,
		ОтправкаЭлемента, СозданиеНачальногоОбраза);
	
КонецПроцедуры

// При отправке данных главному
//
// Параметры:
//  Источник				 - ПланОбменаОбъект			 - источник подписки на событие
//  ЭлементДанных			 - Произвольный				 - элемент данных
//  ОтправкаЭлемента		 - ОтправкаЭлементаДанных	 - отправка элемента данных
//
