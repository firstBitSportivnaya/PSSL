// Виджеты (клиент, сервер): представление значений показателей виджетов.

#Область ПрограммныйИнтерфейс

// Возвращает представление значения показателя виджета для вывода на форме.
// Число больше максимума выводится как "<Максимум>+", незаполненное значение - как ПредставлениеНуля.
//
// Параметры:
//  ЗначениеПоказателя - Произвольный - значение показателя.
//  МаксимумПоказателя - Число - наибольшее число, которое выводится полностью.
//  ПредставлениеНуля - Строка - представление нуля и незаполненного значения.
//
// Возвращаемое значение:
//  Строка - представление значения показателя.
//
Функция ПредставлениеЗначенияПоказателя(ЗначениеПоказателя, МаксимумПоказателя = 9999, ПредставлениеНуля = "0") Экспорт
	
	ТипЗначения = ТипЗнч(ЗначениеПоказателя);
	Если ТипЗначения = Тип("Булево") Тогда
		
		Возврат Формат(ЗначениеПоказателя, НСтр("ru = 'БЛ=Нет; БИ=Да'"));
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЗначениеПоказателя) Тогда
		
		Возврат ПредставлениеНуля;
		
	КонецЕсли;
	
	Если ТипЗначения = Тип("Число") Тогда
		
		Возврат ПредставлениеЧисла(ЗначениеПоказателя, МаксимумПоказателя);
		
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		
		Возврат Формат(ЗначениеПоказателя, "ДЛФ=D");
		
	КонецЕсли;
	
	Возврат Строка(ЗначениеПоказателя);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПредставлениеЧисла(Число, МаксимумПоказателя)
	
	Если Число > МаксимумПоказателя Тогда
		
		Возврат Формат(МаксимумПоказателя, "ЧГ=0") + "+";
		
	КонецЕсли;
	
	Возврат Формат(Число, "ЧГ=0");
	
КонецФункции

#КонецОбласти
