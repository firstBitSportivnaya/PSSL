////////////////////////////////////////////////////////////////////////////////
// Виджеты (клиент): выполнение действий по нажатию на элементы виджетов.

#Область ПрограммныйИнтерфейс

// Обрабатывает нажатие на показатель или команду виджета: выполняет действие, сохраненное
// при размещении виджетов в служебном реквизите формы пбп_ДанныеВиджетов.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, на которой размещены виджеты.
//  Элемент - ДекорацияФормы - нажатый элемент виджета.
//
Процедура ВиджетНажатие(Форма, Элемент) Экспорт
	
	Действие = Форма.пбп_ДанныеВиджетов.Действия.Получить(Элемент.Имя);
	Если Действие = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ВыполнитьДействие(Действие);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ВыполнитьДействие(Действие)
	
	Действия = Новый Структура;
	Действия.Вставить("ПереходПоСсылке", ПредопределенноеЗначение("Перечисление.пбп_ДействияВиджетов.ПереходПоСсылке"));
	Действия.Вставить("ВыполнитьМетод", ПредопределенноеЗначение("Перечисление.пбп_ДействияВиджетов.ВыполнитьМетод"));
	
	Если Действие.Действие = Действия.ПереходПоСсылке Тогда
		
		ПерейтиПоНавигационнойСсылке(Действие.НавигационнаяСсылка);
		
	ИначеЕсли Действие.Действие = Действия.ВыполнитьМетод Тогда
		
		пбп_ВиджетыВызовСервера.ВыполнитьМетод(Действие.Источник, Действие.НомерКоманды);
		
	Иначе
		
		ОткрытьФорму(Действие.ИмяФормы, Действие.ПараметрыФормы);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
