// Документы (обработка событий)

#Область СлужебныйПрограммныйИнтерфейс

// Запрещает запись документа, пока он стоит в очереди отложенного проведения.
// Запись из задания разрешена: в дополнительных свойствах передается пбп_ОтложенноеПроведение.
//
// Параметры:
//  Источник - ДокументОбъект - записываемый документ.
//  Отказ - Булево - признак отказа от записи.
//  РежимЗаписи - РежимЗаписиДокумента - режим записи документа.
//  РежимПроведения - РежимПроведенияДокумента - режим проведения документа.
//
Процедура ПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт

	Если Источник.ОбменДанными.Загрузка Или Отказ Тогда

		Возврат;

	КонецЕсли;

	ПроведениеИзЗадания = Ложь;
	ИмяСвойства = "пбп_ОтложенноеПроведение";

	Если Источник.ДополнительныеСвойства.Свойство(ИмяСвойства, ПроведениеИзЗадания) И ПроведениеИзЗадания Тогда

		Возврат;

	КонецЕсли;

	ИмяОпции = "пбп_ИспользоватьОтложенноеПроведениеДокументов";

	Если Не ПолучитьФункциональнуюОпцию(ИмяОпции) Тогда

		Возврат;

	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	Состояние = пбп_ОтложенноеПроведениеДокументов.СостояниеОтложенногоПроведения(Источник.Ссылка);
	УстановитьПривилегированныйРежим(Ложь);

	Если Состояние = Неопределено Или Не Состояние.Активна Тогда

		Возврат;

	КонецЕсли;

	Отказ = Истина;
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = НСтр("ru = 'Документ находится в очереди отложенного проведения и недоступен для изменения.'");
	Сообщение.УстановитьДанные(Источник);
	Сообщение.Сообщить();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#КонецОбласти
