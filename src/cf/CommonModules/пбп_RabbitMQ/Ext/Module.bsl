
#Область ПрограммныйИнтерфейс

Функция КлиентRabbitMQ() Экспорт
	
	ИмяМакета = "пбп_PinkRabbitMQ";
	ИмяКомпоненты = "BITERP";
	Идентификатор = "AddIn.BITERP.PinkRabbitMQ";
	
	Если Не ПодключитьВнешнююКомпоненту("ОбщийМакет." + ИмяМакета, ИмяКомпоненты, ТипВнешнейКомпоненты.Native) Тогда
		пбп_Переадресация.СообщитьПользователю("Не удалось подключить внешнюю компоненту RabbitMQ");
		Возврат Неопределено;
	КонецЕсли;
	
	Клиент = Неопределено;
	Попытка
		Клиент  = Новый(Идентификатор);
	Исключение
		ПараметрыОшибки = ПараметрыОшибки();
		ПараметрыОшибки.ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ОбработатьОшибку(Клиент, ПараметрыОшибки);
	КонецПопытки;
	
	Возврат Клиент;
	
КонецФункции

Процедура Подключиться(Клиент, ПараметрыПодключения) Экспорт
	
	ПроверитьКлиент(Клиент);
	
	Попытка
		Клиент.Connect(
			ПараметрыПодключения.Хост,
			ПараметрыПодключения.Порт,
			ПараметрыПодключения.Логин,
			ПараметрыПодключения.Пароль,
			ПараметрыПодключения.ВиртуальныйХост,
			ПараметрыПодключения.ЧастотаПульса,
			ПараметрыПодключения.ИспользоватьTLS,
			ПараметрыПодключения.Таймаут
		);
	Исключение
		ПараметрыОшибки = ПараметрыОшибки();
		ПараметрыОшибки.ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ПараметрыОшибки.ОписаниеОшибки = ОписаниеОшибкиПодключения();
		ОбработатьОшибку(Клиент, ПараметрыОшибки);
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗавершитьРаботуСКомпонентой(Клиент) Экспорт
	Клиент = Неопределено;
КонецПроцедуры

#Область РаботаСТочкамиОбмена

Процедура DeclareExchange(Клиент, Параметры) Экспорт
	
	ПроверитьКлиент(Клиент);
	
	Попытка
		Клиент.DeclareExchange(
			Параметры.Имя,
			Параметры.Тип,
			Параметры.НеСоздаватьНовую,
			Параметры.СохранятьСообщения,
			Параметры.АвтоматическоеУдаление,
			Параметры.Аргументы
		);
	Исключение
		ПараметрыОшибки = ПараметрыОшибки();
		ПараметрыОшибки.lastError = Клиент.GetLastError();
		ПараметрыОшибки.ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ПараметрыОшибки.ОписаниеОшибки = ОписаниеОшибкиСозданияТочкиОбмена(Параметры.Имя);
		ОбработатьОшибку(Клиент, ПараметрыОшибки);
	КонецПопытки;
	
КонецПроцедуры

