#Область РаботаСПродюсером

Процедура BasicPublish(Клиент, ПараметрыОтправки) Экспорт
	
	ПроверитьКлиент(Клиент);
	
	Попытка
		Клиент.BasicPublish(
			ПараметрыОтправки.ИмяТочки,
			ПараметрыОтправки.КлючМаршрутизации,
			ПараметрыОтправки.ТелоСообщения,
			ПараметрыОтправки.ВремяЖизниСообщения,
			ПараметрыОтправки.СохранятьНаДиск,
			ПараметрыОтправки.Аргументы
		);
	Исключение
		ПараметрыОшибки = ПараметрыОшибки();
		ПараметрыОшибки.lastError = Клиент.GetLastError();
		ПараметрыОшибки.ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ПараметрыОшибки.ОписаниеОшибки = ОписаниеОшибкиПубликацииСообщения(ПараметрыОтправки.ИмяТочки,
			ПараметрыОтправки.КлючМаршрутизации);
		ОбработатьОшибку(Клиент, ПараметрыОшибки);
	КонецПопытки;
	
КонецПроцедуры

Процедура BasicPublishСПовторами(Клиент, ПараметрыОтправки, КоличествоПовторов = 3, ИнтервалМС = 500) Экспорт
	
	ПроверитьКлиент(Клиент);
	
	ПараметрыОшибки = ПараметрыОшибки();
	
	Для Повтор = 1 По КоличествоПовторов Цикл
		Попытка
			Клиент.BasicPublish(
				ПараметрыОтправки.ИмяТочки,
				ПараметрыОтправки.КлючМаршрутизации,
				ПараметрыОтправки.ТелоСообщения,
				ПараметрыОтправки.ВремяЖизниСообщения,
				ПараметрыОтправки.СохранятьНаДиск,
				ПараметрыОтправки.Аргументы
			);
			Возврат;
		Исключение
			ПараметрыОшибки.lastError = Клиент.GetLastError();
			ПараметрыОшибки.ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			ПараметрыОшибки.ОписаниеОшибки = ОписаниеОшибкиПубликацииСообщения(ПараметрыОтправки.ИмяТочки,
				ПараметрыОтправки.КлючМаршрутизации);
			
			Если Повтор = КоличествоПовторов Тогда
				ПараметрыОшибки.УровеньЖурналаРегистрации = УровеньЖурналаРегистрации.Ошибка;
				ОбработатьОшибку(Клиент, ПараметрыОшибки);
			Иначе
				ПараметрыОшибки.УровеньЖурналаРегистрации = УровеньЖурналаРегистрации.Предупреждение;
				ОбработатьОшибку(Клиент, ПараметрыОшибки, Ложь, Ложь);
				// Пауза между попытками
				Попытка
					Клиент.SleepNative(ИнтервалМС);
					// BSLLS:MissingCodeTryCatchEx-off
				Исключение
					// BSLLS:MissingCodeTryCatchEx-on
				КонецПопытки;
			КонецЕсли;
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область РаботаСПотребителем

Функция BasicConsume(Клиент, ПараметрыРегистрации) Экспорт
	
	ПроверитьКлиент(Клиент);
	
	Попытка
		Возврат Клиент.BasicConsume(
			ПараметрыРегистрации.ИмяОчереди,
			ПараметрыРегистрации.ИдПотребителя,
			ПараметрыРегистрации.БезПодтверждения,
			ПараметрыРегистрации.Эксклюзивно,
			ПараметрыРегистрации.РазмерВыборки,
			ПараметрыРегистрации.Аргументы);
	Исключение
		ПараметрыОшибки = ПараметрыОшибки();
		ПараметрыОшибки.lastError = Клиент.GetLastError();
		ПараметрыОшибки.ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ПараметрыОшибки.ОписаниеОшибки = ОписаниеОшибкиРегистрацииПотребителя(ПараметрыРегистрации.ИмяОчереди);
		ОбработатьОшибку(Клиент, ПараметрыОшибки);
	КонецПопытки;
	
	Возврат "";
	
КонецФункции

Функция BasicConsumeMessage(Клиент, ПараметрыЧтения, Подтверждать = Ложь, ВыбрасыватьИсключение = Ложь, Завершить = Истина) Экспорт
	
	ПроверитьКлиент(Клиент);
	
	Результат = РезультатОперацииЧтения();
	
	ТелоСообщения = "";
	ТегСообщения = 0;
	
	Попытка
		Результат.СообщениеПрочитано = Клиент.BasicConsumeMessage(
			ПараметрыЧтения.ИдПотребителя,
			ТелоСообщения,
			ТегСообщения,
			ПараметрыЧтения.Таймаут);
		Если Результат.СообщениеПрочитано И Подтверждать Тогда
			Клиент.BasicAck(ТегСообщения);
		КонецЕсли;
	Исключение
		ПараметрыОшибки = ПараметрыОшибки();
		ПараметрыОшибки.lastError = Клиент.GetLastError();
		ПараметрыОшибки.ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ПараметрыОшибки.ОписаниеОшибки = ОписаниеОшибкиЧтенияСообщения();
		Результат.ТекстОшибки = ОбработатьОшибку(Клиент, ПараметрыОшибки, ВыбрасыватьИсключение, Завершить);
	КонецПопытки;
	
	ПараметрыЧтения.Тело = ТелоСообщения;
	ПараметрыЧтения.Тег = ТегСообщения;
	
	// Очищаем память по указателю, который неявной хранится в этой переменной
	ТелоСообщения = "";
	ТегСообщения = 0;
	
	Возврат Результат;
	
КонецФункции

Функция BasicConsumeMessageСПовторами(Клиент, ПараметрыЧтения, КоличествоПовторов = 3, ИнтервалМС = 500, Подтверждать = Ложь) Экспорт
	
	ПроверитьКлиент(Клиент);
	
	Для Повтор = 1 По КоличествоПовторов Цикл
		Результат = BasicConsumeMessage(Клиент, ПараметрыЧтения, Подтверждать, Ложь, Ложь);
		
		Если Результат.СообщениеПрочитано Тогда
			Возврат Результат;
		КонецЕсли;
		
		// На последней попытке уже не спим
		Если Повтор < КоличествоПовторов Тогда
			Попытка
				Клиент.SleepNative(ИнтервалМС);
				// BSLLS:MissingCodeTryCatchEx-off
			Исключение
				// BSLLS:MissingCodeTryCatchEx-on
				// Проглатываем ошибку sleep-а, чтобы не мешала retry
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ЧитатьСообщенияИзОчереди(Клиент, ПараметрыЧтения, Подтверждать = Ложь, ИспользоватьПовторы = Ложь, КоличествоПовторов = 3, ИнтервалМС = 500) Экспорт
	
	ПроверитьКлиент(Клиент);
	
	Результат = Новый Структура("Сообщения, ТекстОшибки", Новый Массив, "");
	
	ПараметрыЧтенияСообщения = ПараметрыЧтенияСообщения(ПараметрыЧтения.ИдПотребителя, ПараметрыЧтения.Таймаут);
	
	Попытка
		Пока Истина Цикл 
			Если ИспользоватьПовторы Тогда
				РезультатЧтения = BasicConsumeMessageСПовторами(Клиент,
					ПараметрыЧтенияСообщения,
					КоличествоПовторов,
					ИнтервалМС,
					Подтверждать);
			Иначе
				РезультатЧтения = BasicConsumeMessage(Клиент, ПараметрыЧтенияСообщения, Подтверждать, Ложь, Ложь);
			КонецЕсли;
			
			Если Не РезультатЧтения.СообщениеПрочитано Тогда
				Результат.ТекстОшибки = РезультатЧтения.ТекстОшибки;
				Прервать;
			КонецЕсли;
			
			Результат.Сообщения.Добавить(ПараметрыЧтенияСообщения.Тело);
		КонецЦикла;
		Клиент.BasicCancel(ПараметрыЧтения.ИдПотребителя);
	Исключение
		ПараметрыОшибки = ПараметрыОшибки();
		ПараметрыОшибки.lastError = Клиент.GetLastError();
		ПараметрыОшибки.ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ПараметрыОшибки.ОписаниеОшибки = ОписаниеОшибкиЧтенияСообщения();
		ОбработатьОшибку(Клиент, ПараметрыОшибки);
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

