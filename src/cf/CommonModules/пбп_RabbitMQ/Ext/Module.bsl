		ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ОписаниеОшибки = "";
		ОбработатьОшибку(Клиент, ОписаниеОшибки, ТекстОшибки, lastError);
	КонецПопытки;
	
	Возврат "";
	
КонецФункции

Процедура SleepNative(Клиент, Таймаут) Экспорт
	
	ПроверитьКлиент(Клиент);
	
	Попытка
		Клиент.SleepNative(Таймаут);
	Исключение
		lastError = Клиент.GetLastError();
		ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ОписаниеОшибки = "";
		ОбработатьОшибку(Клиент, ОписаниеОшибки, ТекстОшибки, lastError);
	КонецПопытки;
	
КонецПроцедуры

Функция МетаданныеПоследнегоСообщения(Клиент) Экспорт
	Возврат Новый Структура("Приоритет, Заголовки, КлючМаршрутизации",
		Клиент.GetPriority(),
		Клиент.GetHeaders(),
		Клиент.GetRoutingKey());
КонецФункции

