// Работа со строками (клиент, сервер): Модуль содержит методы работы со строками.

#Область ПрограммныйИнтерфейс

// Разбирает строку с разделителями и упаковывает значения в массив.
// 
// Параметры:
//  ИсходнаяСтрока  - Строка
//  Разделитель     - Строка
//  ПоНарастающей   - Булево (По умолчанию = Ложь) .
//
// ВозвращаемоеЗначение:
//  Массив
//
Функция РазобратьСтрокуСРазделителями(ИсходнаяСтрока, Разделитель, ПоНарастающей = Ложь) Экспорт
	
	Результат = Новый Массив;
	
	Список = пбп_ОбщегоНазначенияКлиентСервер.РазобратьСтрокуСРазделителями(ИсходнаяСтрока, Разделитель);
	Если ПоНарастающей Тогда
		НарастающаяСтрока = "";
		Для Каждого СтрокаСписка Из Список Цикл
			
			НарастающаяСтрока = ?(ПустаяСтрока(НарастающаяСтрока),
				СтрокаСписка, СтрШаблон("%1.%2", НарастающаяСтрока, СтрокаСписка));
			Результат.Добавить(НарастающаяСтрока);
		КонецЦикла; 
	Иначе
		Результат = Список;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает текст с добавлением/удаление разделителя "|".
// 
// Параметры:
//  Текст    - Строка - Обрабатываемый текст.
//  Добавить - Булево - Признак добавления/удаления вертикальной черты.
// 
// Возвращаемое значение:
//  Строка - Результат обработки строки.
//
Функция УбратьДобавитьВертикальнуюЧерту(Текст, Добавить = Ложь) Экспорт
	
	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.УстановитьТекст(Текст);
	КоличествоСтрок = ТекстовыйДокумент.КоличествоСтрок();
	
	Если Добавить Тогда
		
		Для Сч = 1 По КоличествоСтрок Цикл
		
			ТекущаяСтрока = ТекстовыйДокумент.ПолучитьСтроку(Сч);
			
			Если Сч = 1 Тогда
				ТекущаяСтрока = """" + ТекущаяСтрока;
			Иначе
				
				ТекущаяСтрока = СтрЗаменить(ТекущаяСтрока, """", """""");
				ТекущаяСтрока = СтрШаблон("|%1", ТекущаяСтрока);
				
				Если Сч = КоличествоСтрок Тогда
					ТекущаяСтрока = СтрШаблон("%1%2", ТекущаяСтрока, """");
				КонецЕсли;
			КонецЕсли;
			
			ТекстовыйДокумент.ЗаменитьСтроку(Сч, ТекущаяСтрока);
		КонецЦикла;
	Иначе
		
		Для Сч = 1 По КоличествоСтрок Цикл
		
			ТекущаяСтрока = ТекстовыйДокумент.ПолучитьСтроку(Сч);
			
			Если Сч = 1 Тогда
				ТекущаяСтрока = Сред(ТекущаяСтрока, 2);
			ИначеЕсли Сч = КоличествоСтрок Тогда
				ТекущаяСтрока = Сред(ТекущаяСтрока, 1, СтрДлина(ТекущаяСтрока) - 1);
			КонецЕсли;
			
			ТекущаяСтрока = СтрЗаменить(ТекущаяСтрока, """""", """");
			ТекущаяСтрока = СтрЗаменить(ТекущаяСтрока, "|", "");
			
			ТекстовыйДокумент.ЗаменитьСтроку(Сч, ТекущаяСтрока);
		КонецЦикла;
	КонецЕсли;
	
	Результат = ТекстовыйДокумент.ПолучитьТекст();
	Результат = Сред(Результат, 1, СтрДлина(Результат) - 1);
	
	Возврат Результат;
	
КонецФункции

// Превращает строку camelCase в синоним
//
// Параметры:
//  ИсходнаяСтрока - Строка - Строка типа ИдентификаторНастройки
// 
// Возвращаемое значение:
//  Строка - Синоним
//
Функция СинонимСтроки(ИсходнаяСтрока) Экспорт
	
	Результат = пбп_ПереадресацияКлиентСервер.РазложитьСтрокуВМассивПодстрок(ИсходнаяСтрока);
	Если Результат.Количество() > 1 Тогда
		Возврат "";
	КонецЕсли;
	
	ДлинаСтроки = СтрДлина(ИсходнаяСтрока) + 1;
	Старт = 1;
	Конец = 0;
	Части = Новый Массив;
	Для Конец = 2 По ДлинаСтроки Цикл
		КодСимвола = КодСимвола(Сред(ИсходнаяСтрока, Конец, 1));
		Если СимволВерхнегоРегистра(КодСимвола) Или Конец = ДлинаСтроки Тогда
			КолСимволов = Конец - Старт;
			Части.Добавить(Сред(ИсходнаяСтрока, Старт, ?(КолСимволов = 0, ДлинаСтроки - Старт, КолСимволов)));
			Старт = Конец;
		КонецЕсли;
	КонецЦикла;
	Синоним = НРег(СтрСоединить(Части, " "));
	Синоним = ВРег(Лев(Синоним, 1)) + Сред(Синоним,2);
	
	Возврат Синоним;
	
КонецФункции

// Преобразовать дату из строки по строковому формату
//
// Параметры:
//  ВхЗначение	 - Строка - дата строкой
//  НомерФормата - Строка - номер формата с разделителями "_". Подробнее см.
//  в пбп_ЗагрузкаФайлаЧерезТабличныйДокументСервер.ПолучитьНомерФорматаДатыИзСтроки
// 
// Возвращаемое значение:
//  Дата - дата, полученная из преобразования даты строкой по формату
//
Функция ПреобразоватьДатуИзСтрокиПоФормату(ВхЗначение, НомерФормата) Экспорт
	
	Если Не ЗначениеЗаполнено(ВхЗначение) Или Не ЗначениеЗаполнено(НомерФормата) Тогда
		Возврат Дата(1, 1, 1, 0, 0, 0);
	КонецЕсли;
	
	ПреобразованнаяДата = Дата(1, 1, 1, 0, 0, 0);
	Если НомерФормата = "0_0_0" Тогда
		#Если Не ВебКлиент Тогда
		Попытка
			СтрокаДаты = Строка(ВхЗначение);
			ПозицияT = СтрНайти(СтрокаДаты, "T");
			Если ПозицияT > 0 Тогда
				ПозицияТочки = СтрНайти(СтрокаДаты, ".", , ПозицияT);
				Если ПозицияТочки > 0 Тогда
					// Отсекаем миллисекунды после T
					СтрокаДаты = Лев(СтрокаДаты, ПозицияТочки - 1);
				Иначе
					ПозицияZ = СтрНайти(ВРег(СтрокаДаты), "Z", , ПозицияT);
					Если ПозицияZ > 0 Тогда
						СтрокаДаты = Лев(СтрокаДаты, ПозицияZ - 1);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			ДатаИзXML = XMLЗначение(Тип("Дата"), СтрокаДаты);
			Если ДатаИзXML <> Неопределено Тогда
				ПреобразованнаяДата = ДатаИзXML;
			КонецЕсли;
			
		Исключение
			ПреобразованнаяДата = Дата(1, 1, 1, 0, 0, 0);
		КонецПопытки;
		#Иначе
		// В веб-клиенте XMLЗначение недоступна - ручной разбор ISO
		Попытка
			ДатаВремяСтрока = Строка(ВхЗначение);
			Если СтрНайти(ДатаВремяСтрока, "T") > 0 Тогда
				ЧастиДатаВремя = СтрРазделить(ДатаВремяСтрока, "T");
				Если ЧастиДатаВремя.Количество() >= 2 Тогда
					ЧастиДаты = СтрРазделить(ЧастиДатаВремя[0], "-");
					ЧастиВремени = СтрРазделить(ЧастиДатаВремя[1], ":");
					Если ЧастиДаты.Количество() >= 3 И ЧастиВремени.Количество() >= 2 Тогда
						Год = БезопасноПреобразоватьСтрокуВЧисло(ЧастиДаты[0], 1);
						Месяц = БезопасноПреобразоватьСтрокуВЧисло(ЧастиДаты[1], 1);
						День = БезопасноПреобразоватьСтрокуВЧисло(ЧастиДаты[2], 1);
						Часы = БезопасноПреобразоватьСтрокуВЧисло(ЧастиВремени[0], 0);
						Минуты = БезопасноПреобразоватьСтрокуВЧисло(ЧастиВремени[1], 0);
						СекундыСтрока = ?(ЧастиВремени.Количество() >= 3, ЧастиВремени[2], "0");
						Если Прав(ВРег(СекундыСтрока), 1) = "Z" Тогда
							СекундыСтрока = Лев(СекундыСтрока, СтрДлина(СекундыСтрока) - 1);
						КонецЕсли;
						Если СтрНайти(СекундыСтрока, ".") > 0 Тогда
							ЧастиСекунды = СтрРазделить(СекундыСтрока, ".");
							Секунды = БезопасноПреобразоватьСтрокуВЧисло(ЧастиСекунды[0], 0);
						Иначе
							Секунды = БезопасноПреобразоватьСтрокуВЧисло(СекундыСтрока, 0);
						КонецЕсли;
						ПреобразованнаяДата = Дата(Год, Месяц, День, Часы, Минуты, Секунды);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		Исключение
			ПреобразованнаяДата = Дата(1, 1, 1, 0, 0, 0);
		КонецПопытки;
		#КонецЕсли
	Иначе
		Часы = 0;
		РазрядыФормата = пбп_ПереадресацияКлиентСервер.РазложитьСтрокуВМассивПодстрок(НомерФормата, "_");
		
		Если РазрядыФормата.Количество() < 3 Тогда
			Возврат ПреобразованнаяДата;
		КонецЕсли;
		
		МинутыСекунды = "";
		Если РазрядыФормата[2] = "0" Тогда
			ТолькоДата = ВхЗначение;
		Иначе
			МассивРазделителей = пбп_ПереадресацияКлиентСервер.РазложитьСтрокуВМассивПодстрок(
				ВхЗначение, ":", Истина, Истина);
			
			Если МассивРазделителей.Количество() = 0 Тогда
				Возврат ПреобразованнаяДата;
			КонецЕсли;
			
			МассивРазделителейДатаВремя = пбп_ПереадресацияКлиентСервер.РазложитьСтрокуВМассивПодстрок(
				МассивРазделителей[0], " ", Истина, Истина);
			Если РазрядыФормата[0] = "4" Тогда
				ТолькоДата = ПолучитьТолькоДатуЕслиРазделительПробел(МассивРазделителейДатаВремя);
			Иначе
				ТолькоДата = МассивРазделителейДатаВремя[0];
			КонецЕсли;
			
			Если РазрядыФормата[1] = "1" Тогда
				Часы = МассивРазделителейДатаВремя[МассивРазделителейДатаВремя.Количество() - 1];
				Если МассивРазделителей.Количество() = 3 Тогда
					МинутыСекунды = МассивРазделителей[1] + ":" + МассивРазделителей[2];
				ИначеЕсли МассивРазделителей.Количество() >= 2 Тогда
					МинутыСекунды = МассивРазделителей[1];
				Иначе
					МинутыСекунды = "00:00";
				КонецЕсли;
			Иначе
				Если МассивРазделителей.Количество() = 3 Тогда
					МинутыСекунды = МассивРазделителей[1] + ":" + МассивРазделителей[2];
				ИначеЕсли МассивРазделителей.Количество() >= 2 Тогда
					МинутыСекунды = МассивРазделителей[1];
				Иначе
					МинутыСекунды = "00:00";
				КонецЕсли;
				
				ЧасыБезСдвигаЧисло = БезопасноПреобразоватьСтрокуВЧисло(
					МассивРазделителейДатаВремя[МассивРазделителейДатаВремя.Количество() - 1]);
				КоличествоСимволовДоПослеОбеда = 2;
				КоличествоЧасовСдвига = 12;
				Если Прав(МинутыСекунды, КоличествоСимволовДоПослеОбеда) = "PM" Тогда
					Часы = ЧасыБезСдвигаЧисло + КоличествоЧасовСдвига;
				Иначе
					Часы = ЧасыБезСдвигаЧисло;
				КонецЕсли;
				
				МинутыСекунды = СтрЗаменить(МинутыСекунды, " AM", "");
				МинутыСекунды = СтрЗаменить(МинутыСекунды, " PM", "");
			КонецЕсли;
			
		КонецЕсли;
		
		Если РазрядыФормата[0] = "1" Тогда
			РазделительРазрядов = ".";
		ИначеЕсли РазрядыФормата[0] = "2" Тогда
			РазделительРазрядов = "/";
		ИначеЕсли РазрядыФормата[0] = "3" Тогда
			РазделительРазрядов = "-";
		ИначеЕсли РазрядыФормата[0] = "4" Тогда
			РазделительРазрядов = " ";
		Иначе
			РазделительРазрядов = "";
		КонецЕсли;
		
		Если Не ПустаяСтрока(РазделительРазрядов) Тогда
			МассивГодМесяцДата = пбп_ПереадресацияКлиентСервер.РазложитьСтрокуВМассивПодстрок(
				ТолькоДата, РазделительРазрядов, Истина, Истина);
			
			Если МассивГодМесяцДата.Количество() < 3 Тогда
				Возврат ПреобразованнаяДата;
			КонецЕсли;
			
			Если РазрядыФормата[1] = "0" Тогда
				Год = МассивГодМесяцДата[2];
				Месяц = МассивГодМесяцДата[0];
				День = МассивГодМесяцДата[1];
			ИначеЕсли РазрядыФормата[1] = "1" Тогда
				Год = МассивГодМесяцДата[0];
				Месяц = МассивГодМесяцДата[1];
				День = МассивГодМесяцДата[2];
			ИначеЕсли РазрядыФормата[1] = "2" Тогда
				Год = МассивГодМесяцДата[2];
				Месяц = МассивГодМесяцДата[1];
				День = МассивГодМесяцДата[0];
			Иначе
				Год = МассивГодМесяцДата[2];
				КоличествоПервыхСимволов = 3;
				СокрМесяц = ТРег(Лев(МассивГодМесяцДата[1], КоличествоПервыхСимволов));
				Месяц = пбп_ОбщегоНазначенияКлиентСервер.ПолучитьНомерМесяцаПоСтроковомуПредставлению(СокрМесяц);
				День = МассивГодМесяцДата[0];
			КонецЕсли;
			
		Иначе // формат без разделителей
			Если СтрДлина(ТолькоДата) <> 8 Тогда
				Возврат ПреобразованнаяДата;
			КонецЕсли;
			
			Если РазрядыФормата[1] = "0" Тогда
				Год = Прав(ТолькоДата, 4);
				Месяц = Лев(ТолькоДата, 2);
				День = Сред(ТолькоДата, 3, 2);
			ИначеЕсли РазрядыФормата[1] = "1" Тогда
				Год = Лев(ТолькоДата, 4);
				Месяц = Сред(ТолькоДата, 5, 2);
				День = Прав(ТолькоДата, 2);
			ИначеЕсли РазрядыФормата[1] = "2" Тогда
				Год = Прав(ТолькоДата, 4);
				Месяц = Сред(ТолькоДата, 3, 2);
				День = Лев(ТолькоДата, 2);
			Иначе
				Возврат ПреобразованнаяДата;
			КонецЕсли;
		КонецЕсли;
		
		ГодЧисло = БезопасноПреобразоватьСтрокуВЧисло(Год);
		МесяцЧисло = БезопасноПреобразоватьСтрокуВЧисло(Месяц);
		ДеньЧисло = БезопасноПреобразоватьСтрокуВЧисло(День);
		
		Если ЗначениеЗаполнено(МинутыСекунды) Тогда
			МассивСекМин = пбп_ПереадресацияКлиентСервер.РазложитьСтрокуВМассивПодстрок(
				МинутыСекунды, ":", Истина, Истина);
			
			МинутыЧисло = БезопасноПреобразоватьСтрокуВЧисло(МассивСекМин[0]);
			Если МассивСекМин.Количество() > 1 Тогда
				СекундыЧисло = БезопасноПреобразоватьСтрокуВЧисло(МассивСекМин[1]);
			Иначе
				СекундыЧисло = 0;
			КонецЕсли;
		Иначе
			МинутыЧисло = 0;
			СекундыЧисло = 0;
		КонецЕсли;
		
		ЧасыЧисло = БезопасноПреобразоватьСтрокуВЧисло(Часы);
		
		Попытка
			ПреобразованнаяДата = Дата(ГодЧисло, МесяцЧисло, ДеньЧисло, ЧасыЧисло, МинутыЧисло, СекундыЧисло);
		Исключение
			ПреобразованнаяДата = Дата(1, 1, 1, 0, 0, 0);
		КонецПопытки;
		
		МаксимальнаяДата = Дата(3999, 12, 31, 23, 59, 59);
		Если ПреобразованнаяДата > МаксимальнаяДата Тогда
			ПреобразованнаяДата = МаксимальнаяДата;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ПреобразованнаяДата;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьТолькоДатуЕслиРазделительПробел(МассивРазделителейДатаВремя) Экспорт
	
	ТолькоДата = "";
	Для Счетчик = 0 По МассивРазделителейДатаВремя.Количество() - 2 Цикл
		ТолькоДата = ТолькоДата + МассивРазделителейДатаВремя[Счетчик] + " ";
	КонецЦикла;
	
	Возврат Лев(ТолькоДата, СтрДлина(ТолькоДата) - 1);
	
КонецФункции

// Безопасное преобразование строки в число для веб-клиента
Функция БезопасноПреобразоватьСтрокуВЧисло(СтрокаЗначение, ЗначениеПоУмолчанию = 0) Экспорт
	
	Попытка
		Возврат Число(СтрокаЗначение);
	Исключение
		Возврат ЗначениеПоУмолчанию;
	КонецПопытки;
	
КонецФункции

Функция СимволВерхнегоРегистра(КодСимвола)
	
	минКирилица = 1040;
	максКирилица = 1070;
	минЛатиница = 65;
	максЛатиница = 90;
	
	Если (КодСимвола >= минКирилица И КодСимвола <= максКирилица)
