#Область Прочее

// Помещает сообщение обмена в очередь исходящих сообщений Datareon.
// Если общий модуль сшпПользовательскиеМетоды отсутствует в конфигурации, выход без ошибки.
//
// Параметры:
//  ИмяОбъекта     - Строка - имя объекта метаданных сообщения обмена
//  СсылкаНаОбъект - ЛюбаяСсылка - ссылка на регистрируемый объект
//
Процедура ПоместитьСообщениеВОчередьИсходящихСообщений(ИмяОбъекта, СсылкаНаОбъект) Экспорт
	
	Если Метаданные.ОбщиеМодули.Найти("сшпПользовательскиеМетоды") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Модуль = пбп_ОбщегоНазначенияСервер.ОбщийМодуль("сшпПользовательскиеМетоды");
	Модуль.ПоместитьВОчередьИсходящих(ИмяОбъекта, СсылкаНаОбъект);
	
КонецПроцедуры

// Записывает объект в регистр отмененных к регистрации, если в дополнительных свойствах указана причина отмены.
//
// Параметры:
//  Источник - Объект - объект с дополнительным свойством пбп_ПричинаОтменыРегистрации
//
Процедура ЗаписатьОбъектКакОтмененныйКРегистрацииПриНеобходимости(Источник) Экспорт
	
	Если Не Источник.ДополнительныеСвойства.Свойство("пбп_ПричинаОтменыРегистрации") Тогда
		Возврат;
	КонецЕсли;
	
	МетаданныеОбъекта = Источник.Метаданные();
	Если Не Метаданные.Справочники.Содержит(МетаданныеОбъекта)
		И Не Метаданные.Документы.Содержит(МетаданныеОбъекта)
		И Не Метаданные.Задачи.Содержит(МетаданныеОбъекта) Тогда
		Возврат;
	КонецЕсли;
	
	пбп_ИнтеграцииСервер.СоздатьИзменитьОтмененныеКРегистрацииОбъекты(
		Источник.Ссылка, ,
		Источник.ДополнительныеСвойства.пбп_ПричинаОтменыРегистрации);
	
КонецПроцедуры

