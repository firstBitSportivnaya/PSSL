Функция Справочник_пбп_ИнтеграционныеПотоки_СоответствиеПолейИсточникаИПриемника() Экспорт
	
	Поля = пбп_ИнтеграцииШина.КонструкторСоответствияПолейИсточникаИПриемника();
	
	пбп_ИнтеграцииШина.ДополнитьСоответствиеПолейИсточникаИПриемника(Поля, "ref"			,	"Ссылка", , Истина);
	пбп_ИнтеграцииШина.ДополнитьСоответствиеПолейИсточникаИПриемника(Поля, "name"			,	"Наименование");
	пбп_ИнтеграцииШина.ДополнитьСоответствиеПолейИсточникаИПриемника(Поля, "isGroup"		,	"ЭтоГруппа");
	пбп_ИнтеграцииШина.ДополнитьСоответствиеПолейИсточникаИПриемника(Поля, "parent"			,	"Родитель.ИдентификаторНастройки");
	пбп_ИнтеграцииШина.ДополнитьСоответствиеПолейИсточникаИПриемника(Поля, "identifier"		,	"ИдентификаторНастройки");
	пбп_ИнтеграцииШина.ДополнитьСоответствиеПолейИсточникаИПриемника(Поля, "changed"		,	"ИзмененВручную");
	пбп_ИнтеграцииШина.ДополнитьСоответствиеПолейИсточникаИПриемника(Поля, "schedulerKey"	,	"КлючРегламентногоЗадания");
	пбп_ИнтеграцииШина.ДополнитьСоответствиеПолейИсточникаИПриемника(Поля, "daysOfStorageSuccess"	, "КоличествоДнейХранения");
	пбп_ИнтеграцииШина.ДополнитьСоответствиеПолейИсточникаИПриемника(Поля, "daysOfStorageError"		, "КоличествоДнейХраненияОшибок");
	пбп_ИнтеграцииШина.ДополнитьСоответствиеПолейИсточникаИПриемника(Поля, "threadDirection"		, "НаправлениеПотока");
	пбп_ИнтеграцииШина.ДополнитьСоответствиеПолейИсточникаИПриемника(Поля, "integrationSettings"	, "НастройкаИнтеграции", , Истина);
	пбп_ИнтеграцииШина.ДополнитьСоответствиеПолейИсточникаИПриемника(Поля, "userFunction"			, "ПользовательскаяФункция", , Истина);
	пбп_ИнтеграцииШина.ДополнитьСоответствиеПолейИсточникаИПриемника(
		Поля, "functionCode", "ПользовательскаяФункция.Код");
	пбп_ИнтеграцииШина.ДополнитьСоответствиеПолейИсточникаИПриемника(
		Поля, "functionName", "ПользовательскаяФункция.Наименование");
	пбп_ИнтеграцииШина.ДополнитьСоответствиеПолейИсточникаИПриемника(Поля, "endpoint"				, "ТочкаВхода");
	пбп_ИнтеграцииШина.ДополнитьСоответствиеПолейИсточникаИПриемника(Поля, "storeVersionNumbers"	, "ХранитьНомераВерсий");
	пбп_ИнтеграцииШина.ДополнитьСоответствиеПолейИсточникаИПриемника(Поля, "method"					, "Метод");
	пбп_ИнтеграцииШина.ДополнитьСоответствиеПолейИсточникаИПриемника(Поля, "port"					, "Порт");
	
	Возврат Поля;
	
