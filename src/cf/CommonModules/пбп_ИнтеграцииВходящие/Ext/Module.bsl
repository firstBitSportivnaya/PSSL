// Процедура-пример обработчика Datareon ESB.
// Вызов данной процедуры прописывается в самой шине для соответствующего типа сообщения обмена.
// Подсистема обмена Datareon (поставляемая вендором шины), выполняет указанный в шине вызов,
// передавая в параметры процедуры контекст обмена.
// Набор параметров предопределенный и соответствует вызову из подсистемы вендора шины.
//
// Параметры:
//  СообщениеОбмена				 - Строка	 - данные сообщения обмена
//  Источник					 - Строка, ПланОбменаСсылка, СправочникСсылка.пбп_ИнтегрируемыеСистемы -
//                                 имя ИС-источника сообщения или уже найденная ссылка узла
//  Идентификатор				 - Строка	 - внутренний идентификатор сообщения в очереди шины
//  СостояниеСообщения			 - ПеречислениеСсылка	 - состояние загрузки сообщения обмена
//  Задержка					 - Число	 - количество секунд для повторной загрузки в случае ошибки
// или повторной обработки сообщения обмена (в этом случае сообщение не удаляется из входящей очереди шины)
//  КоличествоПопытокОжидания	 - Число	 - количество попыток загрузки в случае повторной обработки сообщения.
// После указанного количества попыток загрузки, сообщение заархивируется и будет удалено из входящей очереди)
//  Функции						 - Массив	 - названия функций для доп. обработки
//  ТекстОшибки					 - Строка	 - текст ошибки обмена (будет видна в шине, в том числе)
//
Процедура Справочник_пбп_ИнтеграционныеПотоки(СообщениеОбмена, Источник, Идентификатор,
	СостояниеСообщения, Задержка, КоличествоПопытокОжидания, Функции, ТекстОшибки) Экспорт
	
	Поток = "ПолучениеИнтеграционногоПотока";
	
	СтруктураИстории = пбп_ИнтеграцииШина.ИнициализироватьСтруктуруЗаписиИсторииИнтеграции(
		Поток, СообщениеОбмена);
	
	Попытка
		ОбъектXDTO = пбп_ИнтеграцииСлужебный.ПолучитьОбъектXDTOИзСообщенияОбменаJSON(СообщениеОбмена);
		
		ПараметрыОбмена = пбп_ИнтеграцииШина.ИнициализироватьПараметрыОбмена(
			Поток, Источник, Задержка, КоличествоПопытокОжидания,
			Функции, ТекстОшибки, СтруктураИстории, Истина);
		
		ПараметрыСообщения = пбп_ИнтеграцииШина.ИнициализироватьПараметрыСообщения(
			Справочники.пбп_ИнтеграционныеПотоки, ОбъектXDTO,
			Идентификатор, СостояниеСообщения, Ложь, Ложь);
		
		пбп_ИнтеграцииШина.ЗагрузитьИзПлатформы(ПараметрыОбмена, ПараметрыСообщения);
		Задержка = ПараметрыОбмена.Задержка;
		ТекстОшибки = ПараметрыОбмена.ТекстОшибки;
	Исключение
		ТекстОшибки = пбп_ИнтеграцииСервер.ПолучитьПодробноеПредставлениеОшибкиИсключения(
			НСтр("ru = 'Не удалось обработать полученное сообщение'"),
			ИнформацияОбОшибке());
	КонецПопытки;
	
	пбп_ИнтеграцииШина.ЗаписатьРезультатВИсториюИнтеграции(СтруктураИстории, ТекстОшибки);
	
КонецПроцедуры

Процедура Справочник_пбп_НастройкиИнтеграции(СообщениеОбмена, Источник, Идентификатор,
	СостояниеСообщения, Задержка, КоличествоПопытокОжидания, Функции, ТекстОшибки) Экспорт
	
	Поток = "ПолучениеНастройкиИнтеграции";
	
	СтруктураИстории = пбп_ИнтеграцииШина.ИнициализироватьСтруктуруЗаписиИсторииИнтеграции(
		Поток, СообщениеОбмена, Истина, Истина, Истина);
	
	ИнтегрируемаяСистема = пбп_ИнтеграцииСервер.ИнтегрируемаяСистема(Источник);
	
	Если ЗначениеЗаполнено(ИнтегрируемаяСистема) Тогда
		СтруктураИстории.ИнтегрируемаяСистема = ИнтегрируемаяСистема;
	КонецЕсли;
	
	Попытка
		ОбъектXDTO = пбп_ИнтеграцииСлужебный.ПолучитьОбъектXDTOИзСообщенияОбменаJSON(СообщениеОбмена);
		
		МенеджерОбъекта = Справочники.пбп_НастройкиИнтеграции;
		
		ПараметрыОбмена = пбп_ИнтеграцииШина.ИнициализироватьПараметрыОбмена(
			Поток, Источник, Задержка, КоличествоПопытокОжидания,
			Функции, ТекстОшибки, СтруктураИстории, Истина);
		
		ПараметрыСообщения = пбп_ИнтеграцииШина.ИнициализироватьПараметрыСообщения(
			МенеджерОбъекта, ОбъектXDTO,
			Идентификатор, СостояниеСообщения, Ложь, Ложь);
		
		пбп_ИнтеграцииШина.ЗагрузитьИзПлатформы(ПараметрыОбмена, ПараметрыСообщения);
		Задержка = ПараметрыОбмена.Задержка;
		ТекстОшибки = ПараметрыОбмена.ТекстОшибки;
	Исключение
		ТекстОшибки = пбп_ИнтеграцииСервер.ПолучитьПодробноеПредставлениеОшибкиИсключения(
			НСтр("ru = 'Не удалось обработать полученное сообщение'"),
			ИнформацияОбОшибке());
	КонецПопытки;
	
	пбп_ИнтеграцииШина.ЗаписатьРезультатВИсториюИнтеграции(СтруктураИстории, ТекстОшибки);
	
КонецПроцедуры

