
#Область ПрограммныйИнтерфейс

#Область Выгрузка

// Получает данные выгружаемого объекта
//
// Параметры:
//  ОбъектОбработки	 - ЛюбаяСсылка - Выгружаемый объект.
//  СоставПолей		 - Структура - см. КонструкторСоставаПолей.
// 
// Возвращаемое значение:
//  Структура - Данные объекта в виде структуры.
//
Функция ПолучитьДанныеВыгружаемогоОбъекта(Знач ОбъектОбработки, СоставПолей, Узел = Неопределено, СтруктураИсторииИнтеграции = Неопределено) Экспорт
	
	ПространствоИмен = ИмяТаблицыПоСсылке(ОбъектОбработки);
	
	ТекстыЗапросов = Новый Массив;
	
	РеквизитыСостава = пбп_Переадресация.СкопироватьРекурсивно(СоставПолей.РеквизитыОбъекта.Реквизиты);
	ЭтоРегистр = ОбъектМетаданныхЯвляетсяРегистром(ОбъектОбработки.Метаданные());
	ОтборыРегистра = Новый Соответствие;
	Если ЭтоРегистр Тогда
		Для Каждого Отбор Из ОбъектОбработки.Отбор Цикл
			Если Не Отбор.Использование Тогда
				Продолжить;
			КонецЕсли;
			ОтборыРегистра.Вставить(Отбор.Имя, Отбор.Значение);
		КонецЦикла;
	Иначе
		Если Не СтруктураИсторииИнтеграции = Неопределено Тогда
			НовыйОбъект = СтруктураИсторииИнтеграции.ОбъектыИнтеграции.Добавить();
			НовыйОбъект.ОбъектИнтеграции = ОбъектОбработки;
		КонецЕсли;
	КонецЕсли;
	
	ТекстыЗапросов.Добавить(ТекстЗапросаРеквизитовОбъекта(ПространствоИмен,
		РеквизитыСостава, ЭтоРегистр, ОтборыРегистра));
	
	Для Каждого Имя Из СоставПолей.ПорядокТабличныхЧастей Цикл
		ТекстыЗапросов.Добавить(ТекстЗапросаРеквизитовТабличнойЧастиОбъекта(ПространствоИмен,
			СоставПолей.ТабличныеЧасти[Имя].Реквизиты,
			Имя));
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = СтрСоединить(ТекстыЗапросов, пбп_Переадресация.РазделительПакетаЗапросов());
	
	Если ЭтоРегистр Тогда
		Для Каждого КлючИЗначение Из ОтборыРегистра Цикл
			Запрос.УстановитьПараметр(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
	Иначе
		Запрос.УстановитьПараметр("Ссылка", ОбъектОбработки);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Узел", Узел);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	Данные = РезультатЗапросаВСтруктуру(РезультатыЗапроса[0], СоставПолей.РеквизитыОбъекта);
	
	Для Сч = 1 По РезультатыЗапроса.ВГраница() Цикл
		Имя = СоставПолей.ПорядокТабличныхЧастей[Сч - 1];
		
		ДанныеТЧ = РезультатЗапросаВМассивСтруктур(РезультатыЗапроса[Сч], СоставПолей.ТабличныеЧасти[Имя]);
		Данные.Вставить(Имя, ДанныеТЧ);
	КонецЦикла;
	
	
	Возврат Данные;
	
КонецФункции

// Преобразует значение реквизита при выгрузке. Дату со временем переводит в универсальное время.
//
// Параметры:
//  Значение - Произвольный - значение реквизита.
//  ЧастиДатыЗначения - ЧастиДаты, Неопределено - части даты. Для даты без времени преобразование не выполняется.
//
// Возвращаемое значение:
//  Произвольный - значение для сообщения.
//
Функция ПреобразоватьВыгружаемыйРеквизит(Значение, ЧастиДатыЗначения) Экспорт
	
	Если ТипЗнч(Значение) = Тип("Дата") И ЧастиДатыЗначения <> Неопределено И Не ЧастиДатыЗначения = ЧастиДаты.Дата Тогда
		Возврат УниверсальноеВремя(Значение,
			пбп_ИнтеграцииDatareonПовтИсп.ЧасовойПоясБазыДанных());
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

#КонецОбласти // Выгрузка

#Область Загрузка

#КонецОбласти // Загрузка



// Возвращает ссылку на объект по указанному идентификатору.
// Поддерживает поиск как по внутреннему уникальному идентификатору (UUID),
// так и по внешнему (публичному) идентификатору из регистра синхронизации.
//
// Параметры:
//  Менеджер							 - МодульМенеджераОбъекта - Менеджер метаданных, в котором выполняется поиск объекта.
//  Идентификатор						 - Строка - Внутренний или внешний идентификатор объекта.
//  Источник - ПланОбменаСсылка, СправочникСсылка.пбп_ИнтегрируемыеСистемы - владелец публичного идентификатора.
//  УзелMDM - Произвольный - параметр оставлен для совместимости вызова, в поиске не используется.
//  ПоляПоиска - Соответствие - поля поиска: ключ - имя поля, значение - значение отбора.
//
// Возвращаемое значение:
//  ЛюбаяСсылка, Неопределено - найденная ссылка либо Неопределено, если объект не найден.
//
//BSLLS:UnusedParameters-off
Функция НайтиПоИдентификатору(Менеджер, Идентификатор, Источник, УзелMDM, Знач ПоляПоиска = Неопределено) Экспорт
//BSLLS:UnusedParameters-on
	
	Если ПоляПоиска = Неопределено Тогда
		
		ПоляПоиска = Новый Соответствие;
		
	Иначе
		
		ПоляПоиска = пбп_Переадресация.СкопироватьРекурсивно(ПоляПоиска);
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПоляПоиска) Тогда
		
		Если Не ЭтоУникальныйИдентификатор(Идентификатор) Тогда
			
			Возврат Неопределено;
			
		КонецЕсли;
		
		Возврат СсылкаПоВнутреннемуИдентификатору(Менеджер, Идентификатор);
		
	КонецЕсли;
	
	Мета = Метаданные.НайтиПоТипу(ТипЗнч(Менеджер));
	ИмяТаблицы = Мета.ПолноеИмя();
	
	Запрос = Новый Запрос;
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	&Заглушка КАК Заглушка
	|ПОМЕСТИТЬ ВТ_Данные
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВТ_Данные.Заглушка КАК Заглушка
	|ИЗ
	|	ВТ_Данные КАК ВТ_Данные";
	
	ШаблонУсловия = "ЕСТЬNULL(%1, %2)";
	Условие = "";
	
	ПИ = ИмяПоляПоискаПоПубличномуИдентификатору();
	
	Если ПоляПоиска[ПИ] <> Неопределено Тогда
		
		ОписаниеРегистра = ОписаниеРегистраПубличныхИдентификаторов();
		
		Если ОписаниеРегистра.Использовать Тогда
			
			ИмяИдентификатораСтрока = "Идентификатор_Строка";
			ТекстЗапроса = пбп_СхемыЗапросов.ДобавитьПолеВыборкиВЗапрос(
				ТекстЗапроса, "&" + ИмяИдентификатораСтрока, ИмяИдентификатораСтрока, 0);
			Поле = ДополнитьЗапросДаннымиПоПубличномуИдентификаторуКонкатенация(
				ТекстЗапроса, ИмяИдентификатораСтрока, "", "ВТ_Данные", Ложь);
			ПоляПоиска.Удалить(ПИ);
			ПоУмолчанию = ?(ЗначениеЗаполнено(ПоляПоиска), "%1", "Неопределено");
			Условие = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонУсловия, Поле, ПоУмолчанию);
			Запрос.УстановитьПараметр(ИмяИдентификатораСтрока, Идентификатор);
			Запрос.УстановитьПараметр("Узел", Источник);
			
		Иначе
			
			ПоляПоиска.Удалить(ПИ);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПоляПоиска) И ПустаяСтрока(Условие) Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	ВИ = ИмяПоляПоискаПоВнутреннемуИдентификатору();
	
	Сч = 0;
	КоличествоПолей = ПоляПоиска.Количество() - 1;
	
	Для Каждого Пара Из ПоляПоиска Цикл
		
		Имя = Пара.Ключ;
		ТекстЗапроса = пбп_СхемыЗапросов.ДобавитьПолеВыборкиВЗапрос(ТекстЗапроса, "&" + Имя, Имя, 0);
		
		Если Имя = ВИ Тогда
			
			Поле = ДополнитьЗапросПоПолюПоискаКонкатенация(ТекстЗапроса, Имя, "Ссылка", Мета.ПолноеИмя(), "ВТ_Данные", 1, 0, Ложь);
			
		Иначе
			
			Поле = ДополнитьЗапросПоПолюПоискаКонкатенация(ТекстЗапроса, Имя, Имя, Мета.ПолноеИмя(), "ВТ_Данные", 1, 0, Ложь);
			
		КонецЕсли;
		
		Если ПустаяСтрока(Условие) Тогда
			
			Условие = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонУсловия, Поле, "%1");
			Условие = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(Условие, "Неопределено");
			
		Иначе
			
			ПоУмолчанию = ?(Сч = КоличествоПолей, "Неопределено", "%1");
			ВремУсловие = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонУсловия, Поле, ПоУмолчанию);
			Условие = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(Условие, ВремУсловие);
			
		КонецЕсли;
		
		ЗначениеПараметра = Пара.Значение;
		
		Если Имя = ВИ Тогда
			
			ЗначениеПараметра = СсылкаПоВнутреннемуИдентификатору(Менеджер, ЗначениеПараметра);
			
		КонецЕсли;
		
		Запрос.УстановитьПараметр(Пара.Ключ, ЗначениеПараметра);
		Сч = Сч + 1;
		
	КонецЦикла;
	
	Схема = Новый СхемаЗапроса;
	Схема.УстановитьТекстЗапроса(ТекстЗапроса);
	ЗапросПакета = Схема.ПакетЗапросов[1];
	ОператорЗапроса = ЗапросПакета.Операторы[0];
	ВыбранноеПоле = ОператорЗапроса.ВыбираемыеПоля.Добавить(Условие);
	КолонкаСсылки = ЗапросПакета.Колонки.Найти(ВыбранноеПоле);
	КолонкаСсылки.Псевдоним = "Ссылка";
	Запрос.Текст = Схема.ПолучитьТекстЗапроса();
	Запрос.УстановитьПараметр("Заглушка", "");
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.Ссылка;
	
КонецФункции

// Возвращает объект по переданной ссылке или создаёт новый элемент,
// если ссылка не определена. При наличии ссылки выполняет блокировку объекта для предотвращения параллельных изменений.
//
// Параметры:
//  МенеджерОбъекта	 - МодульМенеджераОбъекта - Менеджер метаданных, в котором выполняется поиск объекта.
//  СсылкаНаЭлемент	 - ЛюбаяСсылка - Ссылка на объект, который требуется получить. 
//                                             Если Неопределено - создается новый объект.
// 
// Возвращаемое значение:
//  Структура - Результат выполнения
//   * ОбъектОбработки - ЛюбойОбъект - Объект, полученный по ссылке.
//   * ТекстОшибки - Строка - Текст ошибки выполнения.
//
Функция ПолучитьСсылочныйОбъект(МенеджерОбъекта, СсылкаНаЭлемент, ЭтоГруппа = Ложь) Экспорт
	
	Результат = Новый Структура("ОбъектОбработки,ТекстОшибки");
	
	Если СсылкаНаЭлемент = Неопределено Тогда
		
		КлассОбъекта = ОпределитьМетаданныеОбъекта(МенеджерОбъекта).Класс;
		УстановитьНовыйОбъектОбработки(Результат, МенеджерОбъекта, КлассОбъекта, ЭтоГруппа);
		
	ИначеЕсли НЕ СсылкаСуществует(СсылкаНаЭлемент) Тогда
		
		КлассОбъекта = ОпределитьМетаданныеОбъекта(МенеджерОбъекта).Класс;
		УстановитьНовыйОбъектОбработки(Результат, МенеджерОбъекта, КлассОбъекта, Ложь);
		
	Иначе
		
		ОбъектОбработки = СсылкаНаЭлемент.ПолучитьОбъект();
		Результат.ОбъектОбработки = ОбъектОбработки;
		//BSLLS:MissingCodeTryCatchEx-off
		Попытка
			ОбъектОбработки.Заблокировать();
		Исключение
			Результат.ТекстОшибки = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Невозможно заблокировать документ %1'"), СсылкаНаЭлемент);
		КонецПопытки;
		//BSLLS:MissingCodeTryCatchEx-on
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Создает объект по классу метаданных и записывает его в Результат.ОбъектОбработки.
// Для неподдерживаемого класса заполняет Результат.ТекстОшибки.
//
// Параметры:
//  Результат - Структура - поля ОбъектОбработки и ТекстОшибки.
//  МенеджерОбъекта - МодульМенеджераОбъекта - менеджер создаваемого объекта.
//  КлассОбъекта - Строка - класс метаданных: Справочник, Документ, Задача и другие.
//  ЭтоГруппа - Булево - создать группу справочника или плана видов характеристик.
//
Процедура УстановитьНовыйОбъектОбработки(Результат, МенеджерОбъекта, КлассОбъекта, ЭтоГруппа)
	
	Если КлассОбъекта = "Справочник" Или КлассОбъекта = "ПланВидовХарактеристик" Тогда
		
		Если ЭтоГруппа Тогда
			
			ОбъектОбработки = МенеджерОбъекта.СоздатьГруппу();
			
		Иначе
			
			ОбъектОбработки = МенеджерОбъекта.СоздатьЭлемент();
			
		КонецЕсли;
		
		Результат.ОбъектОбработки = ОбъектОбработки;
		
	ИначеЕсли КлассОбъекта = "Документ" Тогда
		
		ОбъектОбработки = МенеджерОбъекта.СоздатьДокумент();
		Результат.ОбъектОбработки = ОбъектОбработки;
		
	ИначеЕсли КлассОбъекта = "Задача" Тогда
		
		ОбъектОбработки = МенеджерОбъекта.СоздатьЗадачу();
		Результат.ОбъектОбработки = ОбъектОбработки;
		
	Иначе
		
		Результат.ТекстОшибки = НСтр("ru = 'пришел не поддерживаемый тип объекта'");
		
	КонецЕсли;
	
КонецПроцедуры

// Выполняет запись переданного объекта в базу данных с установкой необходимых флагов,
// а также регистрацию связи между объектом и внешним идентификатором при синхронизации данных.
// Поддерживает работу со справочниками и документами.
//
// Параметры:
//  МенеджерОбъекта						 - МодульМенеджераОбъекта - Менеджер метаданных, в котором выполняется поиск объекта.
//  ОбъектОбработки						 - ЛюбойОбъект - Объект, который требуется записать в базу данных.
//  Идентификатор						 - Строка - Внешний или внутренний идентификатор объекта.
//  Источник							 - Строка - Источник данных (узел информационной базы).
//  СсылкаЯвляетсяВнешнимИдентификатором - Булево - Признак того, что идентификатор является внешним.
//  ОбменДаннымиЗагрузка				 - Булево - Признак того, что загрузка выполняется в режиме ОбменДанными.Загрузка.
//
Функция ЗаписатьСсылочныйЭлемент(МенеджерОбъекта, ОбъектОбработки, Идентификатор, Источник,
	СсылкаЯвляетсяВнешнимИдентификатором = Ложь, ОбменДаннымиЗагрузка = Ложь) Экспорт
	
	Если ОбъектОбработки.ДополнительныеСвойства.Свойство("пбп_ЭтоНовый") Тогда
		ЭтоНовый = ОбъектОбработки.ДополнительныеСвойства.пбп_ЭтоНовый;
	Иначе
		ЭтоНовый = ОбъектОбработки.ЭтоНовый();
	КонецЕсли;
	ОбъектОбработки.ОбменДанными.Загрузка = ОбменДаннымиЗагрузка;
	ОбъектОбработки.ДополнительныеСвойства.Вставить("пбп_ЭтоНовый", ЭтоНовый);

	КлассОбъекта = ОпределитьМетаданныеОбъекта(МенеджерОбъекта).Класс;
	Если КлассОбъекта = "Документ" Тогда
		// Обработка документа.          АвтоматическоеДобавлениеИсчтоника
		// вызов процедуры проведения документа.
		Мета = ОбъектОбработки.Метаданные();
		Если ЭтоСтандартныйРеквизит(Мета.СтандартныеРеквизиты, "Дата")
			Или Не Мета.Реквизиты.Найти("Дата") = Неопределено Тогда
			
			Если Не ЗначениеЗаполнено(ОбъектОбработки.Дата) Тогда
				ОбъектОбработки.Дата = ТекущаяДатаСеанса();
			КонецЕсли;
		КонецЕсли;
		
		ОбъектОбработки.ДополнительныеСвойства.Вставить("пбп_Проведен", ОбъектОбработки.Проведен);
		
		Если ЭтоНовый Тогда
			ОбъектОбработки.ДополнительныеСвойства.Вставить("пбп_БылПроведен", Ложь);
		Иначе
			ОбъектОбработки.ДополнительныеСвойства.Вставить("пбп_БылПроведен",
				пбп_Переадресация.ЗначениеРеквизитаОбъекта(ОбъектОбработки.Ссылка, "Проведен", Истина));
		КонецЕсли;
		
		ОбъектОбработки.Записать();
		
	ИначеЕсли КлассОбъекта = "Задача" Тогда
		ОбъектОбработки.Дата = ?(ЗначениеЗаполнено(ОбъектОбработки.Дата),ОбъектОбработки.Дата, ТекущаяДатаСеанса());
		ОбъектОбработки.Записать();
		
	Иначе
		ОбъектОбработки.Записать();
	КонецЕсли;
	
	Если СсылкаЯвляетсяВнешнимИдентификатором И ЭтоНовый Тогда
		
		ЗаписатьПубличныйИдентификатор(ОбъектОбработки.Ссылка, Источник, Идентификатор);
		
	КонецЕсли;
	
	СсылкаРезультата = ОбъектОбработки.Ссылка;
	Возврат СсылкаРезультата;
	
КонецФункции

// Находит объект по идентификатору или создает новый и назначает ему ссылку.
// Запись выполняется вызывающим кодом в той же транзакции.
//
// Параметры:
//  Идентификатор - Строка - публичный или внутренний идентификатор.
//  МенеджерОбъекта - МодульМенеджераОбъекта - менеджер искомого объекта.
//  Источник - ПланОбменаСсылка, СправочникСсылка.пбп_ИнтегрируемыеСистемы - владелец публичного идентификатора.
//  ЭтоГруппа - Булево - создавать группу справочника.
//  МассивУзлов - Произвольный - дополнительный узел, передается в поиск по полям.
//  СтруктураПоискаСсылки - Соответствие - поля поиска ссылки.
//                          Если не задана, поиск идет по публичному и внутреннему идентификатору.
//
// Возвращаемое значение:
//  ЛюбойОбъект - объект для заполнения.
//
Функция ОбъектОбработкиПоИдентификатору(Идентификатор, МенеджерОбъекта, Источник,
	ЭтоГруппа = Ложь, МассивУзлов = Неопределено, СтруктураПоискаСсылки = Неопределено) Экспорт
	
	ОбъектОбработки = Неопределено;
	ТранзакцияОткрытаЗдесь = Не ТранзакцияАктивна();
	
	Если ТранзакцияОткрытаЗдесь Тогда
		
		НачатьТранзакцию();
		
	КонецЕсли;
	
	Попытка
		
		ЗаблокироватьПубличныйИдентификатор(Идентификатор);
		
		Если СтруктураПоискаСсылки = Неопределено Тогда
			
			СсылкаНаЭлемент = ПолучитьОбъектПоВнешнейВнутреннейСсылке(
				МенеджерОбъекта, Идентификатор, Источник);
			
		Иначе
			
			СсылкаНаЭлемент = НайтиПоИдентификатору(
				МенеджерОбъекта, Идентификатор, Источник, МассивУзлов, СтруктураПоискаСсылки);
			
		КонецЕсли;
		
		Результат = ПолучитьСсылочныйОбъект(МенеджерОбъекта, СсылкаНаЭлемент, ЭтоГруппа);
		
		Если ЗначениеЗаполнено(Результат.ТекстОшибки) Тогда
			
			ВызватьИсключение Результат.ТекстОшибки;
			
		КонецЕсли;
		
		ОбъектОбработки = Результат.ОбъектОбработки;
		
		Если ОбъектОбработки.ЭтоНовый() Тогда
			
			СсылкаНового = МенеджерОбъекта.ПолучитьСсылку(Новый УникальныйИдентификатор);
			ОбъектОбработки.УстановитьСсылкуНового(СсылкаНового);
			
		КонецЕсли;
		
		ЗаполнитьДополнительныеСвойства(ОбъектОбработки, МенеджерОбъекта, Источник);
		
		Если ТранзакцияОткрытаЗдесь Тогда
			
			ЗафиксироватьТранзакцию();
			
		КонецЕсли;
		
	Исключение
		
		Если ТранзакцияОткрытаЗдесь Тогда
			
			ОтменитьТранзакцию();
			ВызватьИсключение ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			
		КонецЕсли;
		
		ВызватьИсключение;
		
	КонецПопытки;
	
	Возврат ОбъектОбработки;
	
КонецФункции

// Заполняет служебные дополнительные свойства объекта перед записью.
//
// Параметры:
//  ОбъектОбработки - ЛюбойОбъект - заполняемый объект.
//  МенеджерОбъекта - МодульМенеджераОбъекта - менеджер объекта.
//  Источник - Произвольный - владелец данных. В текущей реализации не используется.
//
//BSLLS:UnusedParameters-off
Процедура ЗаполнитьДополнительныеСвойства(ОбъектОбработки, МенеджерОбъекта, Источник) Экспорт
//BSLLS:UnusedParameters-on
	
	ЭтоНовый = ОбъектОбработки.ЭтоНовый();
	
	ОбъектОбработки.ДополнительныеСвойства.Вставить("пбп_ЭтоНовый", ЭтоНовый);
	
	КлассОбъекта = ОпределитьМетаданныеОбъекта(МенеджерОбъекта).Класс;
	Если КлассОбъекта = "Документ" Тогда
		
		ОбъектОбработки.ДополнительныеСвойства.Вставить("пбп_Проведен", ОбъектОбработки.Проведен);
		
		Если ЭтоНовый Тогда
			
			ОбъектОбработки.ДополнительныеСвойства.Вставить("пбп_БылПроведен", Ложь);
			
		Иначе
			
			ОбъектОбработки.ДополнительныеСвойства.Вставить("пбп_БылПроведен",
				пбп_Переадресация.ЗначениеРеквизитаОбъекта(ОбъектОбработки.Ссылка, "Проведен", Истина));
			ОбъектОбработки.ДополнительныеСвойства.Вставить("пбп_ЭтоНовый", Не ЗначениеЗаполнено(ОбъектОбработки.Номер));
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Преобразовать массив структур в таблицу значений
//
// Параметры:
//  МассивСтруктур	 - Массив	 - массив структур, который необходимо преобразовать в таблицу значений
//  ДлинаСтроки		 - Число	 - количество символов в колонках с типом строка
// 
// Возвращаемое значение:
//  ТаблицаЗначений - преобразованная таблица значений
//
Функция ПреобразоватьМассивСтруктурВТаблицуЗначений(МассивСтруктур, ДлинаСтроки = 200) Экспорт
	
	СтруктураКолонок = Новый Структура;
	
	Для Каждого ЭлементМассива Из МассивСтруктур Цикл
		Для Каждого ЗначениеСтруктуры Из ЭлементМассива Цикл
			ТипЗначенияКолонки = ТипЗнч(ЗначениеСтруктуры.Значение);
			Если НЕ СтруктураКолонок.Свойство(ЗначениеСтруктуры.Ключ) Тогда
				МассивДопустимыеТипы = Новый Массив;
				МассивДопустимыеТипы.Добавить(ТипЗначенияКолонки);
				СтруктураКолонок.Вставить(ЗначениеСтруктуры.Ключ, МассивДопустимыеТипы);
			Иначе
				СодержитТип = СтруктураКолонок[ЗначениеСтруктуры.Ключ].Найти(ТипЗначенияКолонки);
				Если СодержитТип = Неопределено Тогда
					СтруктураКолонок[ЗначениеСтруктуры.Ключ].Добавить(ТипЗначенияКолонки)
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ТаблицаЗначенийПреобразованная = Новый ТаблицаЗначений;
	
	Для Каждого Колонка Из СтруктураКолонок Цикл
		ТипНеопределено = Новый ОписаниеТипов("Неопределено");
		ТипСтрока = Новый ОписаниеТипов("Строка");
		ТипКолонки = Новый ОписаниеТипов(Колонка.Значение);
		ТипСтрокаОграниченная = пбп_Переадресация.ОписаниеТипаСтрока(ДлинаСтроки);
		Если ТипКолонки = ТипНеопределено ИЛИ ТипКолонки = ТипСтрока Тогда
			ТипКолонки = ТипСтрокаОграниченная;
		КонецЕсли;
		ТаблицаЗначенийПреобразованная.Колонки.Добавить(Колонка.Ключ, ТипКолонки);
	КонецЦикла;
	
	Для Каждого ЭлементМассива Из МассивСтруктур Цикл
		СтрокаТЗ = ТаблицаЗначенийПреобразованная.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТЗ,ЭлементМассива);
	КонецЦикла;
	
	Возврат ТаблицаЗначенийПреобразованная;

КонецФункции

// Проверяет существование и заполненность свойства в объекте XDTO
//
// Параметры:
//  ОбъектXDTO	 - ОбъектXDTO	 - объект, в рамках которого находится свойство
//  ИмяСвойства	 - Строка		 - имя свойства объекта XDTO
// 
// Возвращаемое значение:
//  Булево - Истина, если свойство существует, и оно заполнено
//
Функция СвойствоЗаполненоВXDTO(ОбъектXDTO, ИмяСвойства) Экспорт
	
	Возврат ОбъектXDTO.Свойства().Получить(ИмяСвойства) <> Неопределено
		И ЗначениеЗаполнено(ОбъектXDTO.Получить(ИмяСвойства));
	
КонецФункции

// Возвращает ссылку на объект по внутреннему идентификатору.
//
// Параметры:
//  Идентификатор - Строка - уникальный идентификатор объекта.
//  Источник - МенеджерОбъекта, ПланОбменаСсылка, СправочникСсылка.пбп_ИнтегрируемыеСистемы - менеджер либо владелец публичного идентификатора.
//
// Возвращаемое значение:
//  ЛюбаяСсылка - найденная ссылка на объект.
//
Функция ПолучитьОбъектПоСсылке(Идентификатор, Источник) Экспорт
	
	Если ИсточникЯвляетсяВладельцемПубличногоИдентификатора(Источник) Тогда
		
		Возврат ПолучитьОбъектПоВнешнейСсылке(Идентификатор, Источник);
		
	КонецЕсли;
	
	Возврат ПолучитьОбъектПоВнутреннейСсылке(Идентификатор, Источник);
	
КонецФункции

// Возвращает ссылку по публичному идентификатору.
// При наличии БСП поиск идет по регистру публичных идентификаторов синхронизируемых объектов.
// Без БСП и при включенной константе соответствий - по пбп_СоответствиеОбъектовИнтегрируемыхСистем.
//
// Параметры:
//  Идентификатор - Строка - идентификатор объекта во внешней системе.
//  Источник - ПланОбменаСсылка, СправочникСсылка.пбп_ИнтегрируемыеСистемы - владелец идентификатора.
//
// Возвращаемое значение:
//  ЛюбаяСсылка, Неопределено - найденная ссылка либо Неопределено, если регистр не используется.
//
Функция ПолучитьОбъектПоВнешнейСсылке(Идентификатор, Источник) Экспорт
	
	Возврат НайтиСсылкуПоПубличномуИдентификатору(Идентификатор, Источник);
	
КонецФункции

// Возвращает ссылку на объект по идентификатору из менеджеру объекта
//
// Параметры:
//  Идентификатор	 - Строка	 - идентификатор объекта
//  Источник		 - МенеджерОбъект	 - менеджер, в рамках которого необходимо выполнить поиск ссылки
// 
// Возвращаемое значение:
//  ЛюбаяСсылка - найденная ссылка на объект
//
Функция ПолучитьОбъектПоВнутреннейСсылке(Идентификатор, МенеджерОбъекта) Экспорт
	
	ОбъектСсылка = СсылкаПоВнутреннемуИдентификатору(МенеджерОбъекта, Идентификатор);
	
	Если СсылкаСуществует(ОбъектСсылка) Тогда
		
		Возврат ОбъектСсылка;
		
	КонецЕсли;
	
	Возврат МенеджерОбъекта.ПустаяСсылка();
	
КонецФункции

// Возвращает ссылку по публичному идентификатору, а если запись не найдена - по внутреннему UUID.
//
// Параметры:
//  МенеджерОбъекта - МенеджерОбъекта - менеджер, в котором выполняется поиск по внутреннему идентификатору.
//  Идентификатор - Строка - публичный или внутренний идентификатор объекта.
//  Источник - ПланОбменаСсылка, СправочникСсылка.пбп_ИнтегрируемыеСистемы, Массив - владелец публичного идентификатора.
//
// Возвращаемое значение:
//  ЛюбаяСсылка - найденная или пустая ссылка.
//
Функция ПолучитьОбъектПоВнешнейВнутреннейСсылке(МенеджерОбъекта, Идентификатор, Источник) Экспорт
	
	Если Источник = Неопределено И Не ЗначениеЗаполнено(Идентификатор) Тогда
		
		Возврат МенеджерОбъекта.ПустаяСсылка();
		
	КонецЕсли;
	
	СсылкаПоПубличномуИдентификатору = НайтиСсылкуПоПубличномуИдентификатору(Идентификатор, Источник);
	
	Если СсылкаПоПубличномуИдентификатору <> Неопределено Тогда
		
		Возврат СсылкаПоПубличномуИдентификатору;
		
	КонецЕсли;
	
	Возврат ПолучитьОбъектПоВнутреннейСсылке(Идентификатор, МенеджерОбъекта);
	
КонецФункции

// Процедура - Удаляет неиспользуемые реквизиты для обмена
//
// Параметры:
//  СоставПолей	 - Структура	 - Структура полей выгрузки
//
Процедура УдалитьНеиспользуемыеРеквизиты(СоставПолей, УдаляемыеРеквизиты = Неопределено) Экспорт
	
	Если Не ТипЗнч(СоставПолей) = Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если УдаляемыеРеквизиты = Неопределено Тогда
		МассивУдаляемыхТЧ = Новый Массив;
		МассивУдаляемыхРеквизитов = Новый Массив;
	Иначе
		Если УдаляемыеРеквизиты.Свойство("МассивУдаляемыхРеквизитов") Тогда
			МассивУдаляемыхРеквизитов = УдаляемыеРеквизиты.МассивУдаляемыхРеквизитов;
		Иначе
			МассивУдаляемыхРеквизитов = Новый Массив;
		КонецЕсли;
		
		Если УдаляемыеРеквизиты.Свойство("МассивУдаляемыхТЧ") Тогда
			МассивУдаляемыхТЧ = УдаляемыеРеквизиты.МассивУдаляемыхТЧ;
		Иначе
			МассивУдаляемыхТЧ = Новый Массив;
		КонецЕсли;
	КонецЕсли;
	
	Если СоставПолей.Свойство("РеквизитыОбъекта") Тогда
		РеквизитыОбъекта = СоставПолей.РеквизитыОбъекта;
	Иначе
		РеквизитыОбъекта = СоставПолей;
	КонецЕсли;
	
	ЕстьУдаленныйРеквизит = Ложь;
	Реквизиты = РеквизитыОбъекта.Реквизиты;
	Для ОбратныйИндекс = - Реквизиты.ВГраница() По 0 Цикл
		Индекс = - ОбратныйИндекс;
		Если СтрНайти(Реквизиты[Индекс].Имя, "Удалить") = 1 Тогда
			Реквизиты.Удалить(Индекс);
			ЕстьУдаленныйРеквизит = Истина;
		ИначеЕсли Не МассивУдаляемыхРеквизитов.Найти(Реквизиты[Индекс].Имя) = Неопределено Тогда
			Реквизиты.Удалить(Индекс);
			ЕстьУдаленныйРеквизит = Истина;
		КонецЕсли;
	КонецЦикла;
	
	ВложенныеПоля = РеквизитыОбъекта.ВложенныеПоля;
	КлючиКУдалению = Новый Массив;
	
	Для Каждого ЭлементСтруктуры Из ВложенныеПоля Цикл
		
		Если СтрНайти(ЭлементСтруктуры.Ключ, "Удалить") = 1
			Или МассивУдаляемыхРеквизитов.Найти(ЭлементСтруктуры.Ключ) <> Неопределено Тогда
			
			КлючиКУдалению.Добавить(ЭлементСтруктуры.Ключ);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого КлючКУдалению Из КлючиКУдалению Цикл
		
		ВложенныеПоля.Удалить(КлючКУдалению);
		
	КонецЦикла;
	
	Если ЕстьУдаленныйРеквизит Тогда
		Для Индекс = 0 По Реквизиты.ВГраница() Цикл
			ТекущийЭлемент = Реквизиты[Индекс];
			Если Не ЗначениеЗаполнено(ТекущийЭлемент.Синоним) Тогда
				Продолжить;
			КонецЕсли;
			
			Если ВложенныеПоля.Свойство(ТекущийЭлемент.Синоним) Тогда
				ВложенныеПоля[ТекущийЭлемент.Синоним] = Индекс;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если СоставПолей.Свойство("ТабличныеЧасти") Тогда
		
		ТабличныеЧасти = СоставПолей.ТабличныеЧасти;
		КлючиКУдалению = Новый Массив;
		
		Для Каждого ЭлементСтруктуры Из ТабличныеЧасти Цикл
			
			Если СтрНайти(ЭлементСтруктуры.Ключ, "Удалить") = 1
				Или МассивУдаляемыхТЧ.Найти(ЭлементСтруктуры.Ключ) <> Неопределено Тогда
				
				КлючиКУдалению.Добавить(ЭлементСтруктуры.Ключ);
				
			Иначе
				
				УдалитьНеиспользуемыеРеквизиты(ЭлементСтруктуры.Значение, УдаляемыеРеквизиты);
				
			КонецЕсли;
			
		КонецЦикла;
		
		Для Каждого КлючКУдалению Из КлючиКУдалению Цикл
			
			ТабличныеЧасти.Удалить(КлючКУдалению);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если СоставПолей.Свойство("ПорядокТабличныхЧастей") Тогда
		
		ПорядокТабличныхЧастей = СоставПолей.ПорядокТабличныхЧастей;
		Для ОбратныйИндекс = - ПорядокТабличныхЧастей.ВГраница() По 0 Цикл
			Индекс = - ОбратныйИндекс;
			Если СтрНайти(ПорядокТабличныхЧастей[Индекс], "Удалить") = 1 Тогда
				ПорядокТабличныхЧастей.Удалить(Индекс);
			ИначеЕсли Не МассивУдаляемыхТЧ.Найти(ПорядокТабличныхЧастей[Индекс]) = Неопределено Тогда
				ПорядокТабличныхЧастей.Удалить(Индекс);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

// Преобразует значение реквизита при загрузке. Универсальное время переводит во время базы.
//
// Параметры:
//  Значение - Произвольный - значение из сообщения.
//  ЧастиДатыЗначения - ЧастиДаты, Неопределено - части даты.
//
// Возвращаемое значение:
//  Произвольный - значение для записи в объект.
//
Функция ПреобразоватьЗагружаемыйРеквизит(Значение, ЧастиДатыЗначения) Экспорт
	
	Если ТипЗнч(Значение) = Тип("Дата") и ЗначениеЗаполнено(Значение)
			И ЧастиДатыЗначения <> Неопределено И Не ЧастиДатыЗначения = ЧастиДаты.Дата Тогда
		Возврат МестноеВремя(Значение,
			пбп_ИнтеграцииDatareonПовтИсп.ЧасовойПоясБазыДанных());
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

// Проверяет, что среди типов есть дата.
//
// Параметры:
//  Типы - Массив из Тип - типы реквизита.
//
// Возвращаемое значение:
//  Булево - Истина, если среди типов есть дата.
//
Функция ЭтоДата(Типы) Экспорт
	
	Для Каждого ПроверяемыйТип Из Типы Цикл
		Если ПроверяемыйТип = Тип("Дата") Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция СтандартныйРеквизитПоИмени(МетаОбъекта, ИмяРеквизита) Экспорт
	
	Для Каждого Реквизит Из МетаОбъекта.СтандартныеРеквизиты Цикл
		Если Реквизит.Имя = ИмяРеквизита Тогда
			Возврат Реквизит;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Процедура УстановитьБезопасно(Объект, Реквизит, ОбъектXDTO, ИмяПоля, ТипСтрокой = "" ,СтруктураИстории) Экспорт
	
	ЗначениеСвойства = ПолучитьБезопасно(ОбъектXDTO,ИмяПоля);
	Если ЗначениеЗаполнено(ЗначениеСвойства) Тогда
		Если ТипСтрокой = "Булево" Тогда
			Результат = Булево(ЗначениеСвойства);
		ИначеЕсли ТипСтрокой = "Дата" Тогда
			Результат = ПрочитатьДатуJSON(ЗначениеСвойства, ФорматДатыJSON.ISO);
		Иначе
			Результат = ЗначениеСвойства;
		КонецЕсли;
		Объект[Реквизит] = Результат;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьБезопасно(ОбъектXDTO,ИмяПоля) Экспорт
	
	Если СвойствоЗаполненоВXDTO(ОбъектXDTO, ИмяПоля) Тогда
		ЗначениеСвойства = ОбъектXDTO.Получить(ИмяПоля);
	Иначе
		ЗначениеСвойства = Неопределено;
	КонецЕсли;
	
	Возврат ЗначениеСвойства;
	
КонецФункции

#Область КонвертацияXDTOВТаблицуЗначений

// Преобразует данные формата XDTO в таблицу значений 1С.
//  Поддерживает обработку как одиночных объектов XDTO, так и списков XDTO,
//  выполняет определение типов данных и преобразование идентификаторов и дат.
//
// Параметры:
//  ДанныеXDTO					 - ОбъектXDTO, СписокXDTO - Данные, полученные в формате XDTO, подлежащие конвертации.
//  ЭлементыМутабельногоТипа	 - Массив из Строка - Список свойств, значения которых могут изменяться при обработке.
//  КонвертироватьИдентификаторы - Булево - Признак необходимости преобразования идентификаторов.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Таблица, содержащая данные, сконвертированные из структуры XDTO.
//
Функция КонвертироватьДанныеXDTOВТаблицуЗначений(ДанныеXDTO,
	ЭлементыМутабельногоТипа, КонвертироватьИдентификаторы = Ложь, ПоляИсключения = Неопределено) Экспорт
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	Если ТипЗнч(ДанныеXDTO) = Тип("СписокXDTO") Тогда
		СтрокаДанныхXDTO = ДанныеXDTO[0];
	Иначе
		СтрокаДанныхXDTO = ДанныеXDTO;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПоляИсключения) Тогда
		ПоляИсключения = Новый Массив;
	КонецЕсли;
	
	МассивИдентификаторов = Новый Массив;
	МассивДатСтрокой = Новый Массив;
	ТипСтрокаУИД = пбп_Переадресация.ОписаниеТипаСтрока(36);
	Для Каждого СвойствоXDTO Из СтрокаДанныхXDTO.Свойства() Цикл
		Если ПоляИсключения.Найти(СвойствоXDTO.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ТипДанных = ОпределитьТипЗначенияXDTO(СтрокаДанныхXDTO,
			СвойствоXDTO, ЭлементыМутабельногоТипа, КонвертироватьИдентификаторы,
			МассивИдентификаторов, МассивДатСтрокой);
		
		ТаблицаДанных.Колонки.Добавить(СвойствоXDTO.Имя, ТипДанных);
		Если КонвертироватьИдентификаторы И ТипДанных.Типы()[0] = Тип("УникальныйИдентификатор") Тогда
			ТаблицаДанных.Колонки.Добавить(СвойствоXDTO.Имя + "_Строка", ТипСтрокаУИД);
		КонецЕсли;
	КонецЦикла;
	
	МутабельныеИИдентификаторы = СкопироватьМассив(ЭлементыМутабельногоТипа);
	пбп_ПереадресацияКлиентСервер.ДополнитьМассив(МутабельныеИИдентификаторы, МассивИдентификаторов);
	пбп_ПереадресацияКлиентСервер.ДополнитьМассив(МутабельныеИИдентификаторы, МассивДатСтрокой);
	ИсключаемыеСвойства = СтрСоединить(МутабельныеИИдентификаторы, ",");
	
	Если ТипЗнч(ДанныеXDTO) = Тип("СписокXDTO") Тогда
		Для Каждого СтрокаСпискаXDTO Из ДанныеXDTO Цикл
			ЗаполнитьСтрокуТаблицыЗначенийДаннымиXDTO(ТаблицаДанных, СтрокаСпискаXDTO, 
				ИсключаемыеСвойства, ЭлементыМутабельногоТипа, КонвертироватьИдентификаторы,
				МассивИдентификаторов, МассивДатСтрокой, ПоляИсключения);
		КонецЦикла;
	Иначе
		ЗаполнитьСтрокуТаблицыЗначенийДаннымиXDTO(ТаблицаДанных, ДанныеXDTO, 
			ИсключаемыеСвойства, ЭлементыМутабельногоТипа, КонвертироватьИдентификаторы,
			МассивИдентификаторов, МассивДатСтрокой, ПоляИсключения);
	КонецЕсли;
	
	Возврат ТаблицаДанных;
	
КонецФункции

// Возвращает разделенные таблицы значений, содержащиеся в исходных данных XDTO.
// При этом сохраняет связь между дочерними и основными записями через поле "Владелец",
// соответствующее идентификатору родительской записи.
//
// Параметры:
//  СырыеДанные					 - ТаблицаЗначений - Таблица, содержащая исходные (сырые) данные, полученные из XDTO.
//  ПолеИдентификатора			 - Строка - Имя поля, используемого как идентификатор владельца.
//  ЭлементыМутабельногоТипа	 - Массив из Строка - Список имён полей, которые представляют вложенные таблицы и подлежат разделению.
//  КонвертироватьИдентификаторы - Булево - Признак необходимости конвертации идентификаторов.
// 
// Возвращаемое значение:
//  Структура - Структура, содержащая набор таблиц значений.
//
Функция РазделитьТаблицыЗначенийИзСырыхДанныхXDTOПоИдентификатору(
	СырыеДанные, ПолеИдентификатора, ЭлементыМутабельногоТипа, КонвертироватьИдентификаторы = Ложь) Экспорт
	
	СтруктураТаблиц = Новый Структура;
	Для Каждого ЭлементТипа Из ЭлементыМутабельногоТипа Цикл
		ТаблицаПоТипу = Неопределено;
		
		Для Каждого СтрокаТаблицы Из СырыеДанные Цикл
			Если ТаблицаПоТипу = Неопределено Тогда
				ТаблицаПоТипу = СтрокаТаблицы[ЭлементТипа].СкопироватьКолонки();
				ТаблицаПоТипу.Колонки.Добавить("Владелец", пбп_Переадресация.ОписаниеТипаСтрока(36));
			КонецЕсли;
			
			Для Каждого СтрокаВложеннойТаблицы Из СтрокаТаблицы[ЭлементТипа] Цикл
				НоваяСтрока = ТаблицаПоТипу.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаВложеннойТаблицы);
				
				НоваяСтрока.Владелец = СтрокаТаблицы[ПолеИдентификатора];
			КонецЦикла;
		КонецЦикла;
		
		СтруктураТаблиц.Вставить(ЭлементТипа, ТаблицаПоТипу);
		
		СырыеДанные.Колонки.Удалить(ЭлементТипа);
	КонецЦикла;
	
	СтруктураТаблиц.Вставить("ОсновнаяТаблица", СырыеДанные);
	
	Возврат СтруктураТаблиц;
	
КонецФункции

#КонецОбласти // КонвертацияXDTOВТаблицуЗначений

#Область РаботаСДаннымиXDTO

//Проверяет сообщение обмена на Тип ОбъектXDTO или конвертирует в него.
// Параметры:
//  Json - Строка/ОбъектXDTO (сообщения обмена из шины).
// 
// Возвращаемое значение:
//  ОбъектXDTO - объект сформированный фабрикойXDTO из исходного текста. 
//  В случае невозможности преобразования возвращается Неопределено. 
Функция ПолучитьОбъектXDTOИзСообщенияОбменаJSON(Json) Экспорт
	
	Если ТипЗнч(Json) = Тип("ОбъектXDTO") Тогда
		Возврат Json;
	КонецЕсли;
	
	Если ТипЗнч(Json) <> Тип("Строка") Или Не ЗначениеЗаполнено(Json) Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(Json);
	
	//BSLLS:MissingCodeTryCatchEx-off
	Попытка
		
		Возврат СериализаторXDTO.ПрочитатьJSON(ЧтениеJSON);
		
	Исключение
		
		Возврат Неопределено;
		
	КонецПопытки;
	//BSLLS:MissingCodeTryCatchEx-on
	
КонецФункции

// Определяет соответствующий тип данных 1С для значения, полученного из объекта XDTO.
// Используется при формировании структуры таблицы значений из XDTO.
// Поддерживает определение числовых, логических, строковых, табличных, идентификаторных и датированных типов.
//
// Параметры:
//  СтрокаДанныхXDTO			 - ОбъектXDTO - Объект XDTO, содержащий анализируемое свойство.
//  СвойствоXDTO				 - СвойствоXDTO - Описание свойства XDTO, для которого определяется тип данных.
//  ЭлементыМутабельногоТипа	 - Массив из Строка - Список имён свойств, представляющих вложенные объекты.
//  КонвертироватьИдентификаторы - Булево - Признак необходимости преобразования строк, содержащих UUID, в тип "УникальныйИдентификатор".
//  МассивИдентификаторов		 - Массив из Строка - Коллекция имён свойств, определённых как идентификаторы.
//  МассивДатСтрокой			 - Массив из Строка - Коллекция имён свойств, значения которых интерпретируются как даты.
// 
// Возвращаемое значение:
//  ОписаниеТипов - Определённый тип данных 1С, соответствующий значению свойства XDTO.
//
Функция ОпределитьТипЗначенияXDTO(СтрокаДанныхXDTO, СвойствоXDTO,
	ЭлементыМутабельногоТипа, КонвертироватьИдентификаторы, МассивИдентификаторов, МассивДатСтрокой) Экспорт
	
	ЗначениеXDTO = СтрокаДанныхXDTO.Получить(СвойствоXDTO);
	ТипЗначенияXDTO = ТипЗнч(ЗначениеXDTO);
	
	Если ТипЗначенияXDTO = Тип("Число") Тогда
		ТипДанных = пбп_Переадресация.ОписаниеТипаЧисло(21, 4);
	ИначеЕсли ТипЗначенияXDTO = Тип("Дата") Тогда
		ТипДанных = ОписаниеТипаДата(ЧастиДаты.ДатаВремя);
	ИначеЕсли ТипЗначенияXDTO = Тип("Булево") Тогда
		ТипДанных = Новый ОписаниеТипов("Булево");
	ИначеЕсли ТипЗначенияXDTO = Тип("ОбъектXDTO") Тогда
		ТипДанных = Новый ОписаниеТипов("ТаблицаЗначений");
		ЭлементыМутабельногоТипа.Добавить(СвойствоXDTO.Имя);
	Иначе
		Если КонвертироватьИдентификаторы И ЭтоУникальныйИдентификатор(ЗначениеXDTO) Тогда
			ТипДанных = Новый ОписаниеТипов("УникальныйИдентификатор");
			МассивИдентификаторов.Добавить(СвойствоXDTO.Имя);
		ИначеЕсли ЭтоСтандартнаяДата(ЗначениеXDTO) Тогда
			ТипДанных = ОписаниеТипаДата(ЧастиДаты.ДатаВремя);
			МассивДатСтрокой.Добавить(СвойствоXDTO.Имя);
		Иначе
			ТипДанных = пбп_Переадресация.ОписаниеТипаСтрока(200);
		КонецЕсли;
	КонецЕсли;
	
	Возврат ТипДанных;
	
КонецФункции

// Проверяет, соответствует ли переданное значение стандартному формату даты ISO 8601 вида "ГГГГ-ММ-ДДTчч:мм:сс".
// Используется для определения, является ли строка корректным представлением даты.
//
// Параметры:
//  Значение - Строка - Проверяемое значение.
// 
// Возвращаемое значение:
//  Булево - Истина, если строка соответствует формату стандартной даты, иначе Ложь.
// Пример:
//  ЭтоСтандартнаяДата("2024-11-05T14:23:56") // Истина  
//  ЭтоСтандартнаяДата("2024/11/05 14:23:56") // Ложь
//
Функция ЭтоСтандартнаяДата(Значение) Экспорт
	
	Шаблон = "XXXX-XX-XXTXX:XX:XX";
	
	Если СтрДлина(Шаблон) <> СтрДлина(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Позиция = 1 По СтрДлина(Значение) Цикл
		Если КодСимвола(Шаблон, Позиция) = 88 // X
			И (КодСимвола(Значение, Позиция) < 48 Или КодСимвола(Значение, Позиция) > 57) // 0..9
			Или КодСимвола(Шаблон, Позиция) = 45 И КодСимвола(Значение, Позиция) <> 45 // -
			Или КодСимвола(Шаблон, Позиция) = 84 И КодСимвола(Значение, Позиция) <> 84 // T
			Или КодСимвола(Шаблон, Позиция) = 58 И КодСимвола(Значение, Позиция) <> 58 Тогда // :
				Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти // РаботаСДаннымиXDTO

#Область Логгирование

// Формирует и возвращает структуру записи истории интеграции для указанного интеграционного потока.
// При необходимости добавляет данные входящего сообщения в формате JSON и устанавливает параметры протоколирования.
//
// Параметры:
//  Поток						 - Строка - Идентификатор или объект интеграционного потока.
//  ОбъектXDTO					 - ОбъектXDTO, Неопределено - Данные обмена в формате XDTO (используются для входящего потока).
//  ЭтоВходящийПоток			 - Булево - Признак, что поток является входящим.
//  ГенерироватьПротокол		 - Булево - Признак необходимости генерации протокола обмена.
//  ЗаписыватьДанныеСообщения	 - Булево - Признак необходимости записи входящего сообщения.
// 
// Возвращаемое значение:
//  Структура - Заполненная структура истории интеграции, см.пбп_ИнтеграцииСлужебный.ПолучитьСтруктуруЗаписиИстории.
//
Функция ИнициализироватьСтруктуруЗаписиИсторииИнтеграции(Поток, СообщениеСтрокой = Неопределено,
	ЭтоВходящийПоток = Истина, ГенерироватьПротокол = Истина, ЗаписыватьДанныеСообщения = Истина) Экспорт
	
	ИнтеграционныйПоток = пбп_ИнтеграцииСервер.ИнтеграционныйПоток(Поток);
	
	Если Не ЗначениеЗаполнено(ИнтеграционныйПоток) Тогда
		ВызватьИсключение НСтр("ru = 'Не передан или не создан интеграционный поток.';");
	КонецЕсли;
	
	СтруктураИстории = пбп_ИнтеграцииСлужебный.ПолучитьСтруктуруЗаписиИстории();
	
	ИнтегрируемаяСистема = пбп_Переадресация.ЗначениеРеквизитаОбъекта(ИнтеграционныйПоток,
		"НастройкаИнтеграции.ИнтегрируемаяСистема");
	
	СтруктураИстории.ИнтеграционныйПоток = ИнтеграционныйПоток;
	
	Если ЭтоВходящийПоток И ЗаписыватьДанныеСообщения Тогда
		
		СтруктураИстории.ВходящееСообщение = СообщениеСтрокой;
	КонецЕсли;
	
	СтруктураИстории.ИнтегрируемаяСистема = ИнтегрируемаяСистема;
	СтруктураИстории.ФорматИнтеграции = Перечисления.пбп_ФорматыИнтеграций.JSON;
	СтруктураИстории.ГенерироватьПротокол = ГенерироватьПротокол;
	
	Возврат СтруктураИстории;
	
КонецФункции

// Сохраняет результат обработки интеграционного обмена в историю интеграции,
// включая текст ошибки (при наличии) и данные исходящего сообщения для исходящих потоков.
//
// Параметры:
//  СтруктураИстории	 - Структура - см.пбп_ИнтеграцииСлужебный.ПолучитьСтруктуруЗаписиИстории.
//  ТекстОшибки			 - Строка - Текстовое описание возникшей ошибки.
//  РезультатОбработки	 - Структура - тело исходящего сообщения в свойстве Body.
//  ЭтоВходящийПоток	 - Булево - Признак, что поток является входящим.
//
Процедура ЗаписатьРезультатВИсториюИнтеграции(СтруктураИстории, ТекстОшибки, РезультатОбработки = Неопределено, ЭтоВходящийПоток = Истина) Экспорт
	
	Если Не ЭтоВходящийПоток Тогда
		СтруктураИстории.ИсходящееСообщение = РезультатОбработки.Body;
		СтруктураИстории.ГенерироватьПротокол = Ложь;
	КонецЕсли;
	
	СтруктураИстории.ОписаниеОшибки = ТекстОшибки;
	
	пбп_ИнтеграцииСлужебный.СоздатьСообщениеИсторииИнтеграции(СтруктураИстории);
	
КонецПроцедуры

#КонецОбласти // Логгирование

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

#Область ИнтеграцииИсходящие

// Конструктор состава полей
// 
// Возвращаемое значение:
//  Структура - :
//  * РеквизитыОбъекта - Структура
//     * Реквизиты - Массив
//     * ВложенныеПоля - Структура
//  * ТабличныеЧасти - Структура - где ключ имя табличной части, значение структура см. КонструкторНабораДанных
//  * ПорядокТабличныхЧастей - Массив
//
Функция КонструкторСоставаПолей() Экспорт
	
	Результат = Новый Структура;
	
	НаборДанных = КонструкторНабораДанных();
	
	Результат.Вставить("РеквизитыОбъекта", НаборДанных);
	Результат.Вставить("ТабличныеЧасти", Новый Структура);
	Результат.Вставить("ПорядокТабличныхЧастей", Новый Массив);
	
	Возврат Результат;
	
КонецФункции

// Добавляет поля в состав полей
//
// Параметры:
//  СоставПолей	 - Структура - см. КонструкторСоставаПолей
//  Поля		 - 			 - Строка, Массив из Строка, Массив из Структура - поля, которые необходимо добавить в состав,
//  			если массив из Структура см. КонструкторПолейСТипом
//
Процедура ДобавитьПоляВСоставПолей(СоставПолей, Знач Поля) Экспорт
	
	ДобавитьПоляОбъекта(СоставПолей, Поля);
	
КонецПроцедуры

// Добавляет поле в состав полей
//
// Параметры:
//  СоставПолей	 - Структура - см. КонструкторСоставаПолей
//  Поле		 - Строка	 - поле, которые необходимо добавить в состав
//
Процедура ДобавитьПолеВСоставПолей(СоставПолей, Знач Поле, Синоним = "", ВыводитьВСтруктуру = Ложь, ВыгрузитьКакПубличныйИдентификатор = Ложь) Экспорт
	
	Поле = ОбернутьПолеВСтруктуруСТипом(Поле, Синоним, Неопределено, ВыводитьВСтруктуру, Ложь, ВыгрузитьКакПубличныйИдентификатор);
	
	ДобавитьПоляОбъекта(СоставПолей, Поле);
	
КонецПроцедуры

// Добавляет поля табличной части в состав полей
//
// Параметры:
//  СоставПолей			 - Структура - см. КонструкторСоставаПолей
//  ИмяТабличнойЧасти	 - Строка	 - Имя табличной части объекта
//  Поля				 - 			 - Строка, Массив из Строка, Массив из Структура - поля, которые необходимо добавить в состав,
//  			если массив из Структура см. КонструкторПолейСТипом
//
Процедура ДобавитьПоляТабличнойЧастиВСоставПолей(СоставПолей, ИмяТабличнойЧасти, Знач Поля) Экспорт
	
	ДобавитьПоляТабличнойЧасти(СоставПолей, ИмяТабличнойЧасти, Поля);
	
КонецПроцедуры

// Добавляет поле табличной части в состав полей
//
// Параметры:
//  СоставПолей			 - Структура - см. КонструкторСоставаПолей
//  ИмяТабличнойЧасти	 - Строка	 - Имя табличной части объекта
//  Поле				 - Строка	 - поле табличной части, которое необходимо добавить в состав
//
Процедура ДобавитьПолеТабличнойЧастиВСоставПолей(СоставПолей, ИмяТабличнойЧасти, Знач Поле, Синоним = "", ВыводитьВСтруктуру = Ложь, ВыгрузитьКакПубличныйИдентификатор = Ложь) Экспорт
	
	Поле = ОбернутьПолеВСтруктуруСТипом(Поле, Синоним, Неопределено, ВыводитьВСтруктуру, Ложь, ВыгрузитьКакПубличныйИдентификатор);
	
	ДобавитьПоляТабличнойЧасти(СоставПолей, ИмяТабличнойЧасти, Поле);
	
КонецПроцедуры

// Конструктор полей с типом
// 
// Возвращаемое значение:
//  Массив - обертка для полей с типом.
//
Функция КонструкторПолейСТипом() Экспорт
	Возврат Новый Массив;
КонецФункции

// Дополняет поля, полем с типом
//
// Параметры:
//  МассивПриемник	 - Массив - см. КонструкторПолейСТипом
//  Поле			 - Строка - Имя получаемого поля.
//  Тип				 - Тип, Неопределено - Тип поля.
//  ЭтоEmail		 - Булево - Если это email, получаем из контактной информации.
//
Процедура ДополнитьПоляПолемСТипом(МассивПриемник, Поле, Синоним = "", Тип = Неопределено,
	ВыводитьВСтруктуру = Ложь, ЭтоEmail = Ложь, ВыгрузитьКакПубличныйИдентификатор = Ложь, СоставнойТип = Ложь, ЧастиДаты = Неопределено) Экспорт
	
	Данные = ОбернутьПолеВСтруктуруСТипом(Поле, Синоним, Тип, ВыводитьВСтруктуру,
		ЭтоEmail, ВыгрузитьКакПубличныйИдентификатор, СоставнойТип, ЧастиДаты);
	
	МассивПриемник.Добавить(Данные);
	
КонецПроцедуры

// Возвращает описание полей исходящего запроса для указанного типа метаданных.
//
// Делает это универсально по следующим правилам:
//  1) Для примитивных типов заполняет соответствие 1 к 1 - имя реквизита = имени атрибута запроса
//  2) Для ссылочных типов выгружается уникальный идентификатор ссылки,
//     если карта исключений типов не задаёт другое поле.
//
// Параметры:
//  Менеджер		 - ОбъектМетаданных	 - объект метаданных, для которого необходимо выполнить сопоставление полей
//  ИсключенияТипов	 - Соответствие		 - ключ - тип ссылочного реквизита объекта, для которого необходимо выключить подстановку
// реквизита по универсальному механизму, значение - имя реквизита, из которого необходимо выгрузить данные для типа.
// 
// Возвращаемое значение:
//  Структура - описание полей объекта
//
Функция ПолучитьОписаниеПолейПоМетаданным(МетаданныеОбъект, ИсключенияТипов = Неопределено, ОбъектОбработки = Неопределено, СтруктураИстории = Неопределено) Экспорт
	
	Если МетаданныеОбъект = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнен параметр ""МетаданныеОбъект""'");
	КонецЕсли;
	
	Если ИсключенияТипов = Неопределено Тогда
		ИсключенияТипов = Новый Соответствие;
	КонецЕсли;
	
	ВыгружатьУниверсальноеВремя = Ложь;
	
	Результат = КонструкторСоставаПолей();
	
	Поля = КонструкторПолейСТипом();
	
	ЭтоРегистр = ОбъектМетаданныхЯвляетсяРегистром(МетаданныеОбъект);
	ЭтоДокумент = ОбъектМетаданныхЯвляетсяДокументом(МетаданныеОбъект);
	
	Для Каждого СтандартныйРеквизит Из МетаданныеОбъект.СтандартныеРеквизиты Цикл
		Если Не ЭтоДокумент И Не ЭтоРегистр Тогда
			Если СтандартныйРеквизит.Имя = "Код" И МетаданныеОбъект.ДлинаКода = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Если СтандартныйРеквизит.Имя = "Наименование" И МетаданныеОбъект.ДлинаНаименования = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Если СтандартныйРеквизит.Имя = "Предопределенный" Тогда
				Продолжить;
			КонецЕсли;
			
			Если Не МетаданныеОбъект.Иерархический
				И (СтандартныйРеквизит.Имя = "ЭтоГруппа"
				Или СтандартныйРеквизит.Имя = "Родитель") Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		ВыгрузитьКакПубличныйИдентификатор = Ложь;
		Для Каждого ПроверяемыйТип Из СтандартныйРеквизит.Тип.Типы() Цикл
			Если пбп_Переадресация.ЭтоСсылка(ПроверяемыйТип)
				И Не ОбъектМетаданныхЯвляетсяПеречислением(Метаданные.НайтиПоТипу(ПроверяемыйТип)) Тогда
				ВыгрузитьКакПубличныйИдентификатор = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		ЗначениеИсключения = ИсключенияТипов.Получить(ПроверяемыйТип);
		Если ЗначениеИсключения = Неопределено Тогда
			ИмяРеквизитаСопоставления = ПолучитьИмяРеквизитаВыгрузкиУниверсально(ПроверяемыйТип);
		Иначе
			ИмяРеквизитаСопоставления = ЗначениеИсключения;
		КонецЕсли;
		
		ПоEmail = Ложь;
		Тип = Неопределено;
		ЗначениеПоля = СтандартныйРеквизит.Имя;
		Если ЗначениеЗаполнено(ИмяРеквизитаСопоставления) Тогда
			
			Если ИмяРеквизитаСопоставления = "ВнешнийИдентификатор" Тогда
				ВыгрузитьКакПубличныйИдентификатор = Истина;
			Иначе
				ВыгрузитьКакПубличныйИдентификатор = Ложь;
				Если ИмяРеквизитаСопоставления = "email" Тогда
					ПоEmail = Истина;
					Если СтандартныйРеквизит.Тип.Типы().Количество() =1  Тогда
						Тип = СтандартныйРеквизит.Тип.Типы()[0];
					КонецЕсли;
				Иначе
					ЗначениеПоля = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
						"%1.%2", СтандартныйРеквизит.Имя, ИмяРеквизитаСопоставления);
				КонецЕсли;
			КонецЕсли;
			
			Если СтандартныйРеквизит.Имя = "Ссылка"
				И Не ИмяРеквизитаСопоставления = "ВнешнийИдентификатор" Тогда
				
				Если пбп_Переадресация.ЭтоСсылка(ПроверяемыйТип)
					И Не ОбъектМетаданныхЯвляетсяПеречислением(Метаданные.НайтиПоТипу(ПроверяемыйТип))
					И МетаданныеОбъект.Реквизиты.Найти(ИмяРеквизитаСопоставления) = Неопределено Тогда
					
					ДополнитьПоляПолемСТипом(Поля, ЗначениеПоля, ИмяРеквизитаСопоставления, Тип,, ПоEmail, ВыгрузитьКакПубличныйИдентификатор,
						СтандартныйРеквизит.Тип.Типы().Количество() > 1,
						?(СтандартныйРеквизит.Имя = "Дата", ЧастиДаты.ДатаВремя, Неопределено));
						
				КонецЕсли;
				
				ПоEmail = Ложь;
				ЗначениеПоля = СтандартныйРеквизит.Имя;
				ВыгрузитьКакПубличныйИдентификатор = Истина;
				Тип = Неопределено;
				
			КонецЕсли;
			
		КонецЕсли;
		
		ДополнитьПоляПолемСТипом(Поля, ЗначениеПоля,, Тип,, ПоEmail, ВыгрузитьКакПубличныйИдентификатор,
			СтандартныйРеквизит.Тип.Типы().Количество() > 1,
			?(СтандартныйРеквизит.Имя = "Дата" И ВыгружатьУниверсальноеВремя, ЧастиДаты.ДатаВремя, Неопределено));
	КонецЦикла;
	
	Для Каждого Реквизит Из МетаданныеОбъект.Реквизиты Цикл
		Если ОбъектОбработки <> Неопределено Тогда
			ЗначениеОбъекта = ОбъектОбработки[Реквизит.Имя];
		Иначе
			ЗначениеОбъекта = Неопределено;
		КонецЕсли;
		
		ДополнитьПолеВыгрузкиУниверсально(Поля, Реквизит, ИсключенияТипов, ЗначениеОбъекта, ВыгружатьУниверсальноеВремя);
	КонецЦикла;
	
	Если ЭтоРегистр Тогда
		Для Каждого Измерение Из МетаданныеОбъект.Измерения Цикл
			Если ОбъектОбработки <> Неопределено Тогда
				ЗначениеОбъекта = ОбъектОбработки[Измерение.Имя];
			Иначе
				ЗначениеОбъекта = Неопределено;
			КонецЕсли;
			
			ДополнитьПолеВыгрузкиУниверсально(Поля, Измерение, ИсключенияТипов, ЗначениеОбъекта, ВыгружатьУниверсальноеВремя);
			
			Если Измерение.Тип.Типы().Количество() = 1 Тогда
				Поля[Поля.Количество() - 1].Тип = Неопределено;
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого Ресурс Из МетаданныеОбъект.Ресурсы Цикл
			Если ОбъектОбработки <> Неопределено Тогда
				ЗначениеОбъекта = ОбъектОбработки[Ресурс.Имя];
			Иначе
				ЗначениеОбъекта = Неопределено;
			КонецЕсли;
			
			ДополнитьПолеВыгрузкиУниверсально(Поля, Ресурс, ИсключенияТипов, ЗначениеОбъекта, ВыгружатьУниверсальноеВремя);
		КонецЦикла;
	КонецЕсли;
	
	ДобавитьПоляВСоставПолей(Результат, Поля);
	
	Если Не ЭтоРегистр Тогда
		Для Каждого ТабличнаяЧасть Из МетаданныеОбъект.ТабличныеЧасти Цикл
			
			ПоляТЧ = КонструкторПолейСТипом();
			
			ИмяТЧ = ТабличнаяЧасть.Имя;
			Для Каждого РеквизитТЧ Из ТабличнаяЧасть.Реквизиты Цикл
				Если ОбъектОбработки <> Неопределено И ОбъектОбработки[ИмяТЧ].Количество() Тогда
					ЗначениеОбъекта = ОбъектОбработки[ИмяТЧ][0][РеквизитТЧ.Имя];
				Иначе
					ЗначениеОбъекта = Неопределено;
				КонецЕсли;
				
				ДополнитьПолеВыгрузкиУниверсально(ПоляТЧ, РеквизитТЧ, ИсключенияТипов, ЗначениеОбъекта, ВыгружатьУниверсальноеВремя);
			КонецЦикла;
			
			ДобавитьПоляТабличнойЧастиВСоставПолей(Результат, ИмяТЧ, ПоляТЧ);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

// Конструктор соответствия полей источника и приемника
// 
// Возвращаемое значение:
//  Соответствие - Соответствие полей.
//
Функция КонструкторСоответствияПолейИсточникаИПриемника() Экспорт
	Возврат Новый Соответствие;
КонецФункции

// Дополняет соответствие полей источника и приемника
//
// Параметры:
//  СоответствиеПолей	 - Соответствие - Состав полей источника (внешней системы) и приемника (внутренней системы), для маппинга.
//  ПолеИсточника		 - Строка - Поле внешней системы.
//  ПолеПриемника		 - Строка - Поле внутренней системы.
//  ЭтоТабличнаяЧасть	 - Булево - Если Истина, поле является табличной частью.
//
Процедура ДополнитьСоответствиеПолейИсточникаИПриемника(СоответствиеПолей, ПолеИсточника, ПолеПриемника, ЭтоТабличнаяЧасть = Ложь, ЭтоВнешнийИдентификатор = Ложь) Экспорт
	
	ЧастиПоляПриемника = СтрРазделить(ПолеПриемника, ".");
	ЧастиПоляИсточника = СтрРазделить(ПолеИсточника, ".");
	
	Данные = Новый Структура("ВложенноеПоле,ПолеИсточника");
	
	Если ЭтоТабличнаяЧасть Тогда
		ИмяТЧПрием = ЧастиПоляПриемника[0];
		ИмяРеквизитаПрием = ЧастиПоляПриемника[1];
		
		ИмяТЧИст = ЧастиПоляИсточника[0];
		
		Вложенное = ИмяРеквизитаПрием;
		Если ЧастиПоляПриемника.Количество() = 3 Тогда
			Вложенное = ЧастиПоляПриемника[2];
		ИначеЕсли ЭтоВнешнийИдентификатор Тогда
			Вложенное = ИмяПоляПоискаПоПубличномуИдентификатору();
		КонецЕсли;
		Данные.ВложенноеПоле = Вложенное;
		Данные.ПолеИсточника = ЧастиПоляИсточника[1];
		
		Если Не ЗначениеЗаполнено(СоответствиеПолей[ИмяТЧПрием]) Тогда
			Подсоотв = Новый Соответствие;
			Подсоотв.Вставить("_имя_источника", ИмяТЧИст);
			
			СоответствиеПолей.Вставить(ИмяТЧПрием, Подсоотв);
		Иначе
			Подсоотв = СоответствиеПолей[ИмяТЧПрием];
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Подсоотв[ИмяРеквизитаПрием]) Тогда
			ПодПод = Новый Соответствие;
			
			Подсоотв.Вставить(ИмяРеквизитаПрием, ПодПод);
		Иначе
			ПодПод = Подсоотв[ИмяРеквизитаПрием];
		КонецЕсли;
		ПодПод.Вставить(Вложенное, ЧастиПоляИсточника[1]);
		//Подсоотв.Вставить(ИмяРеквизитаПрием, Данные);
		
		Возврат;
	КонецЕсли;
	
	Основное = ЧастиПоляПриемника[0];
	Вложенное = Основное;
	Если ЧастиПоляПриемника.Количество() = 2 Тогда
		Вложенное = ЧастиПоляПриемника[1];
	ИначеЕсли ЭтоВнешнийИдентификатор Тогда
		Вложенное = ИмяПоляПоискаПоПубличномуИдентификатору();
	КонецЕсли;
	
	Данные.ВложенноеПоле = Вложенное;
	Данные.ПолеИсточника = ПолеИсточника;
	
	Если Не ЗначениеЗаполнено(СоответствиеПолей[Основное]) Тогда
		Подсоотв = Новый Соответствие;
		
		СоответствиеПолей.Вставить(Основное, Подсоотв);
	Иначе
		Подсоотв = СоответствиеПолей[Основное];
	КонецЕсли;
	Подсоотв.Вставить(Вложенное, ПолеИсточника);
	
КонецПроцедуры

// Выполняет загрузку данных из XDTO-объекта в информационную базу 1С,
//  создавая или обновляя соответствующий объект метаданных.
//  Реализует транзакционную обработку, обработку ошибок и регистрацию результатов интеграции.
//
// Параметры:
//  Поток								 - Строка - Идентификатор интеграционного потока, в рамках которого выполняется загрузка данных.
//  МенеджерОбъекта						 - МодульМенеджераОбъекта - Менеджер метаданных, в котором выполняется поиск объекта.
//  ОбъектXDTO							 - ОбъектXDTO - Объект XDTO, содержащий данные для загрузки.
//  Источник							 - Строка - Источник данных.
//  Идентификатор						 - Строка - строковое значение идентификатора сообщения.
//  СостояниеСообщения					 - Произвольный - состояние сообщения, его меняет вызывающий код.
//  Задержка							 - Число - Время задержки перед повторной обработкой в случае блокировки.
//  КоличествоПопытокОжидания			 - Число - Количество попыток ожидания при блокировках.
//  Функции								 - Соответствие - Дополнительные функции, используемые в обработке.
//  ТекстОшибки							 - Строка - Текст ошибки, формируемый при возникновении исключений.
//  СтруктураИсторииИнтеграции			 - Структура - см.пбп_ИнтеграцииСлужебный.ПолучитьСтруктуруЗаписиИстории.
//  ИспользоватьУниверсальноеЗаполнение	 - Булево - Признак использования универсального механизма заполнения.
//  ОбменДаннымиЗагрузка				 - Булево - Признак того, что загрузка выполняется в режиме ОбменДанными.Загрузка.
//	НумерацияПриемника - Булево - признак нумерации приемника.
//	УзелMDM - Произвольный - дополнительный узел для заполнения объекта.
//
//BSLLS:UnusedParameters-off
Функция ЗагрузитьИзПлатформы(Поток, МенеджерОбъекта, ОбъектXDTO, Источник, Идентификатор,
	СостояниеСообщения,
	Задержка,
	КоличествоПопытокОжидания,
	Функции,
	ТекстОшибки,
	СтруктураИсторииИнтеграции,
	ИспользоватьУниверсальноеЗаполнение = Ложь,
	ОбменДаннымиЗагрузка = Ложь,
	НумерацияПриемника = Истина,
	УзелMDM = Неопределено) Экспорт
	
	Если ОбъектXDTO = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Тело сообщения пустое или его не удалось прочитать.';");
	КонецЕсли;
	
	КонтекстЗаполнения = КонтекстЗаполненияОбъектаПоОбъектуXDTO(Поток);
	Если НумерацияПриемника Тогда
		Если КонтекстЗаполнения.ПоляИсключения.Получить("Номер") = Неопределено Тогда
			КонтекстЗаполнения.ПоляИсключения.Вставить("Номер", Истина);
		КонецЕсли;
		Если КонтекстЗаполнения.ПоляИсключения.Получить("Код") = Неопределено Тогда
			КонтекстЗаполнения.ПоляИсключения.Вставить("Код", Истина);
		КонецЕсли;
	КонецЕсли;
	//
	ИДСтрокой = ПолучитьЗначениеИзСоответствияИсточникаИПриемника(КонтекстЗаполнения.СоответствиеПолейИсточникаИПриемника, "Ссылка");
	Если Не ЗначениеЗаполнено(ИДСтрокой) Тогда
		ИДСтрокой = "Ссылка";
	КонецЕсли;
	
	СсылкаИзXDTO = "";
	Если ОбъектXDTO.Свойства().Получить(ИДСтрокой) <> Неопределено Тогда
		СсылкаИзXDTO = ОбъектXDTO[ИДСтрокой];
		Если Не ЗначениеЗаполнено(Идентификатор) Тогда
			Идентификатор = СсылкаИзXDTO;
		КонецЕсли;
	КонецЕсли;
	
	СтруктураПоискаСсылки = ПодготовитьСтруктуруПоискаСсылки(КонтекстЗаполнения, ОбъектXDTO, СсылкаИзXDTO);
	СсылкаЯвляетсяВнешнимИдентификатором = СтруктураПоискаСсылки[ИмяПоляПоискаПоПубличномуИдентификатору()] <> Неопределено;
	
	// по умолчанию ищем по внешней ссылке
	Если СтруктураПоискаСсылки.Количество() = 0 Тогда
		ПроверяемыйТип = ТипЗнч(МенеджерОбъекта.ПолучитьСсылку());
		ПоляПоиска = ПолучитьИмяРеквизитаВыгрузкиУниверсально(ПроверяемыйТип);
		
		СсылкаЯвляетсяВнешнимИдентификатором = Истина;
		СтруктураПоискаСсылки.Вставить(ИмяПоляПоискаПоПубличномуИдентификатору(), СсылкаИзXDTO);
		СтруктураПоискаСсылки.Вставить(ИмяПоляПоискаПоВнутреннемуИдентификатору(), СсылкаИзXDTO);
		
		Если СтруктураПоискаСсылки.Получить(ПоляПоиска) = Неопределено
			И Не ОбъектXDTO.Свойства().Получить(ПоляПоиска) = Неопределено Тогда
			
			СтруктураПоискаСсылки.Вставить(ПоляПоиска, ОбъектXDTO[ПоляПоиска]);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ОбъектXDTO.Свойства().Получить("ЭтоГруппа") = Неопределено Тогда
		ЭтоГруппа = Ложь;
	Иначе
		ЭтоГруппа = ОбъектXDTO.ЭтоГруппа;
	КонецЕсли;
	
	ОбъектОбработки = Неопределено;
	
	НачатьТранзакцию();
	Попытка
		
		ОбъектОбработки = ОбъектОбработкиПоИдентификатору(СсылкаИзXDTO, МенеджерОбъекта, Источник,
			ЭтоГруппа, УзелMDM, СтруктураПоискаСсылки);
		
		Если ОбъектОбработки.ДополнительныеСвойства.пбп_ЭтоНовый Тогда
			
			Статус = Перечисления.пбп_СозданОбновлен.Создан;
			
		Иначе
			
			Статус = Перечисления.пбп_СозданОбновлен.Обновлен;
			
		КонецЕсли;
		
		// Заполнение данных
		ЗаполнитьОбъектПоОбъектуXDTO(МенеджерОбъекта,
			ОбъектОбработки,
			ОбъектXDTO,
			Источник,
			КонтекстЗаполнения,
			ИспользоватьУниверсальноеЗаполнение,
			УзелMDM,
			СтруктураИсторииИнтеграции);
		
		// постобработка
		ПостобработкаОбъектаПоОбъектуXDTO(Поток, ОбъектОбработки, ОбъектXDTO, СтруктураИсторииИнтеграции);
		
		// Сохранить объект
		СсылкаНаОбъект = ЗаписатьСсылочныйЭлемент(МенеджерОбъекта, ОбъектОбработки, СсылкаИзXDTO,
			Источник, СсылкаЯвляетсяВнешнимИдентификатором, ОбменДаннымиЗагрузка);
		
		НовыйОбъект = СтруктураИсторииИнтеграции.ОбъектыИнтеграции.Добавить();
		НовыйОбъект.ОбъектИнтеграции	= СсылкаНаОбъект;
		НовыйОбъект.Идентификатор		= СсылкаИзXDTO;
		НовыйОбъект.СозданОбновлен		= Статус;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		
		Если Не ОбъектОбработки = Неопределено Тогда
			
			НовыйОбъект = СтруктураИсторииИнтеграции.ОбъектыИнтеграции.Добавить();
			НовыйОбъект.ОбъектИнтеграции	= ОбъектОбработки.Ссылка;
			НовыйОбъект.Идентификатор		= СсылкаИзXDTO;
			НовыйОбъект.СозданОбновлен		= Статус;
			
		КонецЕсли;
		
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()); 
		
		Сообщения = ПолучитьСообщенияПользователю(Истина);
		Части = Новый Массив;
		Части.Добавить(ТекстОшибки);
		Для Каждого Сообщение Из Сообщения Цикл
			Части.Добавить(Сообщение.Текст);
		КонецЦикла;
		ТекстОшибки = СтрСоединить(Части, Символы.ПС);
		
		Если СтрНайти(НРег(ТекстОшибки), "невозможно заблокировать") > 0 Тогда
			Задержка = 30;
			Возврат Неопределено;
		Иначе
			// пишем в историю интеграции
			ЗаписатьРезультатВИсториюИнтеграции(СтруктураИсторииИнтеграции, ТекстОшибки);
			
			ВызватьИсключение ТекстОшибки;
		КонецЕсли;
	КонецПопытки;
	
	Если ОпределитьМетаданныеОбъекта(МенеджерОбъекта).Класс = "Документ"
		И ОбъектОбработки.ДополнительныеСвойства.пбп_Проведен И Не ОбменДаннымиЗагрузка Тогда
		
		Попытка
			ОбъектОбработки.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			Если ОбъектОбработки.ДополнительныеСвойства.пбп_БылПроведен Тогда
				ОбъектОбработки.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			КонецЕсли;
			
			ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписатьРезультатВИсториюИнтеграции(СтруктураИсторииИнтеграции, ТекстОшибки);
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат СсылкаНаОбъект;
	
КонецФункции
//BSLLS:UnusedParameters-on

Функция РазделительОператоровЗапросаОбъединитьВсе() Экспорт
	Возврат Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС;
КонецФункции

Функция ИмяПоляПоискаПоПубличномуИдентификатору() Экспорт
	Возврат "ВнешнийИдентификатор";
КонецФункции

Функция ИмяПоляПоискаПоВнутреннемуИдентификатору() Экспорт
	Возврат "Идентификатор";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ИнтеграцииИсходящие

Функция ДанныеВыборкиИзРезультатаЗапросаВСтруктуру(Выборка, КолонкиРезультатаЗапроса, Реквизиты)
	
	Результат = Новый Структура;
	
	СоответствиеРеквизитов = МассивРеквизитовВСоответствие(Реквизиты.Реквизиты);
	
	Для Каждого Колонка Из КолонкиРезультатаЗапроса Цикл
		Имя = Колонка.Имя;
		
		ДанныеРеквизита = СоответствиеРеквизитов.Получить(Имя);
		ЧастиДатыЗначения = ?(ДанныеРеквизита <> Неопределено И ДанныеРеквизита.Свойство("ЧастиДаты"),
			ДанныеРеквизита.ЧастиДаты, Неопределено);
		
		Если Не Реквизиты.ВложенныеПоля.Свойство(Имя) Тогда 
			Если пбп_Переадресация.ЭтоСсылка(ТипЗнч(Выборка[Имя]))
				И Выборка[Имя].Пустая() Тогда 
				Результат.Вставить(Имя, "");
			Иначе
				Результат.Вставить(Имя, ПреобразоватьВыгружаемыйРеквизит(Выборка[Имя], ЧастиДатыЗначения));
				Если Не ДанныеРеквизита = Неопределено
					И ДанныеРеквизита.СоставнойТип Тогда
					
					ИмяРеквизитаСсылки = Имя+"_Ссылка";
					Если КолонкиРезультатаЗапроса.Найти(ИмяРеквизитаСсылки) = Неопределено Тогда
						Результат.Вставить(
							Имя+"Тип", 
							пбп_Переадресация.СтроковоеПредставлениеТипа(ТипЗнч(Выборка[Имя]))
						);
					Иначе
						Результат.Вставить(
							Имя+"Тип", 
							пбп_Переадресация.СтроковоеПредставлениеТипа(ТипЗнч(Выборка[ИмяРеквизитаСсылки]))
						);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли; 
			
			Продолжить;
			
		КонецЕсли;
		
		ИндексПоля = Реквизиты.ВложенныеПоля[Имя];
		Поле = Реквизиты.Реквизиты[ИндексПоля];
		
		Части = СтрРазделить(Поле.Имя, ".");
		ИмяВерхнегоУровня = Части[0];
		ИмяВложенного = ?(ЗначениеЗаполнено(Поле.Синоним), Поле.Синоним, Части[1]);
		
		ЧастиДатыЗначения = ?(Поле <> Неопределено И Поле.Свойство("ЧастиДаты"),
		Поле.ЧастиДаты, Неопределено);
		
		Если Поле.ВыводитьВСтруктуру Тогда
			Если Не Результат.Свойство(ИмяВерхнегоУровня) Тогда
				Результат.Вставить(ИмяВерхнегоУровня, Новый Структура);
			КонецЕсли;
			Результат[ИмяВерхнегоУровня].Вставить(ИмяВложенного, ПреобразоватьВыгружаемыйРеквизит(Выборка[Имя], ЧастиДатыЗначения));
		Иначе
			Если ЗначениеЗаполнено(Поле.Синоним) Тогда
				ИмяВерхнегоУровня = Поле.Синоним;
			КонецЕсли;
			
			Если пбп_Переадресация.ЭтоСсылка(ТипЗнч(Выборка[Имя]))
				И Выборка[Имя].Пустая() Тогда 
				Результат.Вставить(ИмяВерхнегоУровня, "");
			Иначе
				Результат.Вставить(ИмяВерхнегоУровня, ПреобразоватьВыгружаемыйРеквизит(Выборка[Имя], ЧастиДатыЗначения));
				ДанныеРеквизита = СоответствиеРеквизитов.Получить(ИмяВерхнегоУровня);
				ЗаполнитьТипИзДанныхРеквизита = Ложь;
				Если ДанныеРеквизита = Неопределено Тогда
					ДанныеРеквизита = СоответствиеРеквизитов.Получить(Поле.Имя);
					ЗаполнитьТипИзДанныхРеквизита = Истина;
				КонецЕсли;
				
				Если Не ДанныеРеквизита = Неопределено
					И ДанныеРеквизита.СоставнойТип Тогда
					
					ИмяРеквизитаСсылки = ИмяВерхнегоУровня+"_Ссылка";
					
					Если ЗаполнитьТипИзДанныхРеквизита И Не ДанныеРеквизита.Тип = Неопределено Тогда
						ТипЗначения = пбп_Переадресация.СтроковоеПредставлениеТипа(ДанныеРеквизита.Тип);
						
					ИначеЕсли КолонкиРезультатаЗапроса.Найти(ИмяРеквизитаСсылки) = Неопределено Тогда
						ТипЗначения = пбп_Переадресация.СтроковоеПредставлениеТипа(ТипЗнч(Выборка[ИмяВерхнегоУровня]));
						
					Иначе
						ТипЗначения = пбп_Переадресация.СтроковоеПредставлениеТипа(ТипЗнч(Выборка[ИмяРеквизитаСсылки]));
					КонецЕсли;
					
					Результат.Вставить(ИмяВерхнегоУровня+"Тип", ТипЗначения);
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	Если Результат.Свойство("ВерсияДанных") Тогда
		СтрокаВерсии16 = "0x"+СтрЗаменить(Base64Значение(Результат.ВерсияДанных), " ", "");
		Результат.ВерсияДанных = ЧислоИзШестнадцатеричнойСтроки(СтрокаВерсии16);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция КонструкторНабораДанных()
	
	Результат = Новый Структура("Реквизиты,ВложенныеПоля", Новый Массив, Новый Структура);
	
	Возврат Результат;
	
КонецФункции

Функция КонструкторПоляСТипом()
	
	Результат = Новый Структура;
	Результат.Вставить("Имя", "");
	Результат.Вставить("Синоним", "");
	Результат.Вставить("Тип", Неопределено);
	Результат.Вставить("ВыводитьВСтруктуру", Ложь);
	Результат.Вставить("ЭтоEmail", Ложь);
	Результат.Вставить("ВыгрузитьКакПубличныйИдентификатор", Истина);
	Результат.Вставить("СоставнойТип", Ложь);
	Результат.Вставить("ЧастиДаты", Неопределено);
	
	Возврат Результат;
	
КонецФункции

Процедура ПроверкаУровняВложенности(ИмяРеквизита, Разделитель = ".")
	
	Части = СтрРазделить(ИмяРеквизита, Разделитель);
	// проверить что их ровно две, глубже проваливаться нельзя,
	// возможно в будущем изменим, тут надо аккуратно,
	// т.к. поля могут быть составного типа и при динамическом формировании запроса, ограничение типа не накладывается.
	Если Части.Количество() > 3 Тогда
		ВызватьИсключение (пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Допускается только два уровня вложенности: %1'"),
			ИмяРеквизита),
			КатегорияОшибки.ОшибкаКонфигурации);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьПоляОбъекта(СоставПолей, Знач Поля)
	
	ДобавитьПоля(СоставПолей.РеквизитыОбъекта, Поля);
	
КонецПроцедуры

Процедура ДобавитьПоляТабличнойЧасти(СоставПолей, ИмяТабличнойЧасти, Знач Поля)
	
	Если Не СоставПолей.ТабличныеЧасти.Свойство(ИмяТабличнойЧасти) Тогда
		НаборДанных = КонструкторНабораДанных();
		
		СоставПолей.ТабличныеЧасти.Вставить(ИмяТабличнойЧасти, НаборДанных);
		СоставПолей.ПорядокТабличныхЧастей.Добавить(ИмяТабличнойЧасти);
	КонецЕсли;
	
	ДобавитьПоля(СоставПолей.ТабличныеЧасти[ИмяТабличнойЧасти], Поля);
	
КонецПроцедуры

Процедура ДобавитьПоля(НаборДанных, Знач Поля)
	
	Если ТипЗнч(Поля) = Тип("Строка") Тогда
		Поля = СтрРазделить(Поля, ",", Ложь);
	ИначеЕсли ТипЗнч(Поля) = Тип("Структура") Тогда
		Поля = пбп_ПереадресацияКлиентСервер.ЗначениеВМассиве(Поля);
	КонецЕсли;
	
	Для Каждого Поле Из Поля Цикл
		Если ТипЗнч(Поле) <> Тип("Структура") Тогда
			Поле = ОбернутьПолеВСтруктуруСТипом(Поле, Поле, Неопределено, Ложь, Ложь);
		КонецЕсли;
		ДополнитьНаборДанных(НаборДанных, Поле);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДополнитьНаборДанных(ВходящийНаборДанных, Реквизит)
	
	Значение = КонструкторПоляСТипом();
	Если ТипЗнч(Реквизит) = Тип("Структура") Тогда
		Значение = пбп_Переадресация.СкопироватьРекурсивно(Реквизит);
	Иначе
		Значение.Имя = Реквизит;
	КонецЕсли;
	
	Разделитель = ".";
	ТекущийИндекс = ВходящийНаборДанных.Реквизиты.ВГраница() + 1;
	Если СтрНайти(Значение.Имя, Разделитель) > 0 Тогда
		ПроверкаУровняВложенности(Значение.Имя, Разделитель);
		
		ВходящийНаборДанных.Реквизиты.Добавить(Значение);
		Ключ = СтрЗаменить(Значение.Имя, Разделитель, "");
		Если ЗначениеЗаполнено(Значение.Синоним) Тогда
			Ключ = Значение.Синоним;
		КонецЕсли;
		
		ВходящийНаборДанных.ВложенныеПоля.Вставить(Ключ, ТекущийИндекс);
		
		Возврат;
	КонецЕсли;
	
	ВходящийНаборДанных.Реквизиты.Добавить(Реквизит);
	
КонецПроцедуры

Функция ТекстЗапросаРеквизитовОбъекта(ПространствоИмен, Реквизиты, ЭтоРегистр, ОтборыРегистра)
	
	КлючевоеПоле = "Ссылка";
	ПолеЗапросаСсылка = "Данные." + КлючевоеПоле + " КАК Ссылка";
	ШаблонЗапроса =
	"ВЫБРАТЬ
	|	" + ПолеЗапросаСсылка + "
	|ИЗ
	|	%1 КАК Данные
	|ГДЕ
	|	Данные.Ссылка = &Ссылка";

	Если ЭтоРегистр Тогда
		
		Если Реквизиты.Количество() = 0 Тогда
			
			ВызватьИсключение НСтр("ru = 'Не заданы реквизиты для выгрузки регистра.'");
			
		КонецЕсли;
		
		Инкремент = 0;
		Выражение = Неопределено;
		
		Для Каждого РеквизитЭлемент Из Реквизиты Цикл
			
			Если Не ЗначениеЗаполнено(РеквизитЭлемент.Тип) Тогда
				
				Выражение = ПолучитьВыражениеПоля(РеквизитЭлемент);
				Прервать;
				
			КонецЕсли;
			
			Инкремент = Инкремент + 1;
			
		КонецЦикла;
		
		Если Выражение = Неопределено Тогда
			
			Инкремент = 0;
			ИмяКлюча = СтрРазделить(Реквизиты[0].Имя, ".", Ложь)[0];
			Выражение = Новый Структура("Значение, Псевдоним", ИмяКлюча, ИмяКлюча);
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Выражение.Псевдоним) Тогда
			
			Выражение.Псевдоним = Выражение.Значение;
			
		КонецЕсли;
		
		КлючевоеПоле = Выражение.Значение;
		ПолеЗапросаКлюча = СтрШаблон("Данные.%1 КАК %2", Выражение.Значение, Выражение.Псевдоним);
		ШаблонЗапроса = СтрЗаменить(ШаблонЗапроса, ПолеЗапросаСсылка, ПолеЗапросаКлюча);
		Реквизиты.Удалить(Инкремент);
		
		Если ОтборыРегистра.Количество() Тогда
			
			УсловияПоОтборам = Новый Массив;
			
			Для Каждого Отбор Из ОтборыРегистра Цикл
				
				Если ИмяПоляЕстьВМетаданных(ПространствоИмен, Отбор.Ключ) Тогда
					
					УсловияПоОтборам.Добавить(СтрШаблон("Данные.%1 = &%1", Отбор.Ключ));
					
				КонецЕсли;
				
			КонецЦикла;
			
			Условие = СтрСоединить(УсловияПоОтборам, Символы.ПС + "	И ");
			ШаблонЗапроса = СтрЗаменить(ШаблонЗапроса, "Данные.Ссылка = &Ссылка", Условие);
			
		Иначе
			
			ШаблонЗапроса = СтрЗаменить(ШаблонЗапроса, "Данные.Ссылка = &Ссылка", "ИСТИНА");
			
		КонецЕсли;
		
	Иначе
		
		ПолеЗапросаКлюча = ПолеЗапросаСсылка;
		
	КонецЕсли;

	ТекстЗапроса = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонЗапроса, ПространствоИмен);
	//СтрокаЗамены = "
	//|ИЗ
	//|	" + ПространствоИмен;
	СтрокаЗамены = "
	|ИЗ
	|	" + ПространствоИмен + " КАК Данные";
	
	//СтрокаЗаменыУсловия = "
	//	|ГДЕ
	//	|	Данные.Ссылка = &Ссылка";
	Если НЕ ЭтоРегистр Тогда
		СтрокаЗаменыУсловия = "
		|ГДЕ
		|	Данные.Ссылка = &Ссылка";
	Иначе
		СтрокаПоискаУсловия = "
		|ГДЕ
		|	Данные.";
		СтрокаЗаменыУсловия = Сред(ТекстЗапроса,СтрНайти(ТекстЗапроса,СтрокаПоискаУсловия));
	КонецЕсли;
	
	Для Каждого Реквизит Из Реквизиты Цикл
		Выражение = ПолучитьВыражениеПоля(Реквизит);
		
		ВыражениеПоля = Выражение.Значение;
		Если Не ЗначениеЗаполнено(Выражение.Псевдоним) Тогда
			Выражение.Псевдоним = Выражение.Значение;
		КонецЕсли;
		
		Если пбп_ПереадресацияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Реквизит, "ВыгрузитьКакПубличныйИдентификатор")
				И Реквизит.ВыгрузитьКакПубличныйИдентификатор Тогда
			
			ВыражениеПоля = ДополнитьЗапросИнформациейПроИдентификаторы(
				ТекстЗапроса, Реквизит, СтрокаЗаменыУсловия, ВыражениеПоля);
			
			Если Реквизит.СоставнойТип Тогда
				
				ДобавитьПолеВыборкиВЗапрос(
					ТекстЗапроса, Выражение, ВыражениеПоля, ПолеЗапросаКлюча, КлючевоеПоле, СтрокаЗамены);
				ВыражениеПоля = Выражение.Значение;
				Выражение.Псевдоним = Выражение.Псевдоним + "_Ссылка";
				
			КонецЕсли;
			
		КонецЕсли;
		
		//ТекстЗапроса = пбп_СхемыЗапросов.ДобавитьПолеВыборкиВЗапрос(ТекстЗапроса,
		//ВыражениеПоля,
		//Выражение.Псевдоним, , ,
		//Истина);
		ДобавитьПолеВыборкиВЗапрос(ТекстЗапроса, Выражение, ВыражениеПоля, ПолеЗапросаКлюча, КлючевоеПоле, СтрокаЗамены);
		
	КонецЦикла;
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаРеквизитовТабличнойЧастиОбъекта(ПространствоИмен, Реквизиты, ИмяТабличнойЧасти)
	
	ШаблонЗапроса = "ВЫБРАТЬ
		|	Данные.Ссылка КАК Ссылка
		|ИЗ
		|	%1.%2 КАК Данные
		|ГДЕ
		|	Данные.Ссылка = &Ссылка";
	
	ТекстЗапроса = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонЗапроса,
		ПространствоИмен,
		ИмяТабличнойЧасти);
	
	СтрокаЗамены = СтрШаблон("
		|ИЗ
		|	%1.%2 КАК Данные",
		ПространствоИмен,
		ИмяТабличнойЧасти
	);
	
	СтрокаЗаменыУсловия = "
	|ГДЕ
	|	Данные.Ссылка = &Ссылка";
	
	Для Каждого Реквизит Из Реквизиты Цикл
		Выражение = ПолучитьВыражениеПоля(Реквизит);
		
		ВыражениеПоля = Выражение.Значение;
		
		Если Не ЗначениеЗаполнено(Выражение.Псевдоним) Тогда
			Выражение.Псевдоним = Выражение.Значение;
		КонецЕсли;
		
		Если пбп_ПереадресацияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Реквизит, "ВыгрузитьКакПубличныйИдентификатор")
			И Реквизит.ВыгрузитьКакПубличныйИдентификатор Тогда
			
			ВыражениеПоля = ДополнитьЗапросИнформациейПроИдентификаторы(
				ТекстЗапроса, Реквизит, СтрокаЗаменыУсловия, ВыражениеПоля);
			
			Если Реквизит.СоставнойТип Тогда
				
				ДобавитьПолеВыборкиВЗапрос(ТекстЗапроса,
					Выражение,
					ВыражениеПоля,
					"",
					"",
					СтрокаЗамены);
				ВыражениеПоля = Выражение.Значение;
				Выражение.Псевдоним = Выражение.Псевдоним + "_Ссылка";
				
			КонецЕсли;
			
		КонецЕсли;
		
		//ТекстЗапроса = пбп_СхемыЗапросов.ДобавитьПолеВыборкиВЗапрос(ТекстЗапроса,
		//		ВыражениеПоля,
		//		Выражение.Псевдоним, , ,
		//		Истина);
		ДобавитьПолеВыборкиВЗапрос(ТекстЗапроса,
			Выражение,
			ВыражениеПоля,
			"",
			"",
			СтрокаЗамены);
	КонецЦикла;
	
	//ТекстЗапроса = пбп_СхемыЗапросов.УдалитьПоляИзЗапроса(ТекстЗапроса, "Ссылка");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Данные.Ссылка КАК Ссылка,", "");
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ПолучитьВыраженияПолей(Реквизиты)
	
	Выражения = Новый СписокЗначений;
	Для Каждого Реквизит Из Реквизиты Цикл
		Если Реквизит.Тип = Неопределено Тогда
			Выражения.Добавить(Реквизит.Имя);
		Иначе
			ПолноеИмяМета = ПолноеИмяОбъектаМетаданных(Реквизит.Тип);
			Части = СтрРазделить(Реквизит.Имя, ".");
			
			Выражение = ПреобразованиеПоля(Реквизит, Части);
			
			Выражения.Добавить(Выражение, СтрСоединить(Части, ""));
		КонецЕсли;
	КонецЦикла;
	
	Возврат Выражения;
	
КонецФункции

Функция ПолучитьВыражениеПоля(Реквизит)
	
	Выражение = Новый Структура("Значение, Псевдоним", "", "");
	Выражение.Псевдоним = Реквизит.Синоним;
	
	Если НЕ ЗначениеЗаполнено(Выражение.Псевдоним) 
		И НЕ ЗначениеЗаполнено(Реквизит.Тип)
		И СтрНайти(Реквизит.Имя,".") > 0 Тогда
		Выражение.Псевдоним = СтрРазделить (Реквизит.Имя,".")[0];
	КонецЕсли;
	
	Если Реквизит.Тип = Неопределено Тогда
		Выражение.Значение = Реквизит.Имя;
		
		Возврат Выражение;
	КонецЕсли;
	
	Части = СтрРазделить(Реквизит.Имя, ".");
	Поле = ПреобразованиеПоля(Реквизит, Части);
	
	Выражение.Значение = Поле;
	
	Если Не ЗначениеЗаполнено(Выражение.Псевдоним) Тогда
		Выражение.Псевдоним = СтрСоединить(Части, "");
	КонецЕсли;
	
	Возврат Выражение;
	
КонецФункции

Функция ПреобразованиеПоля(Реквизит, Части)
	
	ШаблонВыражения = "ВЫРАЗИТЬ(%1 КАК %2)";
	ШаблонВыраженияЧерезТочку = "ВЫРАЗИТЬ(%1 КАК %2).%3";
	
	ПолноеИмяМета = ПолноеИмяОбъектаМетаданных(Реквизит.Тип);
	Если Части.Количество() = 2 Тогда
		Возврат пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
			ШаблонВыраженияЧерезТочку,
			Части[0],
			ПолноеИмяМета,
			Части[1]);
	КонецЕсли;
	
	Возврат пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
		ШаблонВыражения,
		Реквизит.Имя,
		ПолноеИмяМета);
	
КонецФункции

Функция ОбернутьПолеВСтруктуруСТипом(Поле, Синоним, Тип, ВыводитьВСтруктуру, ЭтоEmail, ВыгрузитьКакПубличныйИдентификатор = Ложь, СоставнойТип = Ложь, ЧастиДаты = Неопределено)
	
	Данные = КонструкторПоляСТипом();
	Данные.Имя = Поле;
	Данные.Синоним = Синоним;
	Данные.Тип = Тип;
	Данные.ЭтоEmail = ЭтоEmail;
	Данные.ВыводитьВСтруктуру = ВыводитьВСтруктуру;
	Данные.ВыгрузитьКакПубличныйИдентификатор = ВыгрузитьКакПубличныйИдентификатор;
	Данные.СоставнойТип = СоставнойТип;
	Данные.ЧастиДаты = ЧастиДаты;
	
	Возврат Данные;
	
КонецФункции

#Область УниверсальнаяВыгрузка

Процедура ДополнитьПолеВыгрузкиУниверсально(Поля, Реквизит, ИсключенияТипов, ЗначениеОбъекта, ВыгружатьУниверсальноеВремя = Ложь)
	ТипыРеквизита = Реквизит.Тип.Типы();
	
	ЭтоДата = ЭтоДата(Реквизит.Тип.Типы());
	Если ЭтоДата И ВыгружатьУниверсальноеВремя Тогда
		ЧастиДатыЗначение = Реквизит.Тип.КвалификаторыДаты.ЧастиДаты;
	Иначе
		ЧастиДатыЗначение = Неопределено;
	КонецЕсли;
	
	ВыгрузитьКакПубличныйИдентификатор = Ложь;
	Для Каждого ПроверяемыйТип Из ТипыРеквизита Цикл
		Если пбп_Переадресация.ЭтоСсылка(ПроверяемыйТип)
				И Не ОбъектМетаданныхЯвляетсяПеречислением(Метаданные.НайтиПоТипу(ПроверяемыйТип)) Тогда
			ВыгрузитьКакПубличныйИдентификатор = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	// Если составной тип, то выгружаем без преобразований
	Если ТипыРеквизита.Количество() > 1 Тогда
		Если ЗначениеОбъекта <> Неопределено Тогда
			СоставнойТип = Истина;
			ТипРеквизита = ТипЗнч(ЗначениеОбъекта);
		Иначе
			ДополнитьПоляПолемСТипом(Поля, Реквизит.Имя,,,,, ВыгрузитьКакПубличныйИдентификатор, Истина, ЧастиДатыЗначение);
			Возврат;
		КонецЕсли;
	Иначе
		СоставнойТип = Ложь;
		ТипРеквизита = ТипыРеквизита[0];
	КонецЕсли;

	Если Не пбп_Переадресация.ЭтоСсылка(ТипРеквизита) Тогда
		Если ТипРеквизита = Тип("Дата") Тогда
			ДополнитьПоляПолемСТипом(Поля, Реквизит.Имя,,,,,,, ЧастиДатыЗначение);
		Иначе
			ДополнитьПоляПолемСТипом(Поля, Реквизит.Имя,,,,,,, ЧастиДатыЗначение);
		КонецЕсли;
		
		Возврат;
	ИначеЕсли Не ОбъектМетаданныхЯвляетсяПеречислением(Метаданные.НайтиПоТипу(ТипРеквизита)) Тогда
		ВыгрузитьКакПубличныйИдентификатор = Истина;
	КонецЕсли;
	
	ЗначениеИсключения = ИсключенияТипов.Получить(ТипРеквизита);
	Если ЗначениеИсключения = Неопределено Тогда
		ИмяРеквизитаСопоставления = ПолучитьИмяРеквизитаВыгрузкиУниверсально(ТипРеквизита);
	Иначе
		ИмяРеквизитаСопоставления = ЗначениеИсключения;
	КонецЕсли;
	
	ПоEmail = Ложь;
	ЗначениеПоля = Реквизит.Имя;
	Если ЗначениеЗаполнено(ИмяРеквизитаСопоставления) Тогда
		Если ИмяРеквизитаСопоставления = "ВнешнийИдентификатор" Тогда
			ВыгрузитьКакПубличныйИдентификатор = Истина;
		Иначе
			ВыгрузитьКакПубличныйИдентификатор = Ложь;
			Если ИмяРеквизитаСопоставления = "email" Тогда
				ПоEmail = Истина;
			КонецЕсли;
			
			ЗначениеПоля = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
			"%1.%2", Реквизит.Имя, ИмяРеквизитаСопоставления);
		КонецЕсли;
	КонецЕсли;
	
	ДополнитьПоляПолемСТипом(
		Поля, ЗначениеПоля, Реквизит.Имя, ТипРеквизита, , ПоEmail,
		ВыгрузитьКакПубличныйИдентификатор, СоставнойТип, ЧастиДатыЗначение);
	
КонецПроцедуры

Функция ПолучитьИмяРеквизитаВыгрузкиУниверсально(ТипРеквизита)
	
	ИмяФункции = пбп_ИнтеграцииDatareonПовтИсп.ИменаМетодовИмениРеквизитаВыгрузки()[ТипРеквизита];
	
	Если ИмяФункции = Неопределено Тогда
		
		Возврат "";
		
	КонецЕсли;
	
	Возврат пбп_ИнтеграцииDatareonПовтИсп.РезультатПереопределения(ИмяФункции);
	
КонецФункции

#КонецОбласти // УниверсальнаяВыгрузка

#КонецОбласти

Функция ОпределитьМетаданныеОбъекта(МенеджерОбъекта)
	
	Результат = Новый Структура("ПолноеИмя,Класс,Объект");
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗнч(МенеджерОбъекта));
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Результат.ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
	
	ПозицияРазделителя = СтрНайти(Результат.ПолноеИмя, ".");
	Результат.Класс = Лев(Результат.ПолноеИмя, ПозицияРазделителя-1);
	Результат.Объект = Сред(Результат.ПолноеИмя, ПозицияРазделителя+1, СтрДлина(Результат.ПолноеИмя) - ПозицияРазделителя);
	
	Возврат Результат
	
КонецФункции

Процедура ЗаполнитьСтрокуТаблицыЗначенийДаннымиXDTO(ТаблицаДанных,
	ДанныеXDTO, ИсключаемыеСвойства, ЭлементыМутабельногоТипа,
	КонвертироватьИдентификаторы, МассивИдентификаторов, МассивДатСтрокой, ПоляИсключения)
	
	НоваяСтрока = ТаблицаДанных.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеXDTO, , ИсключаемыеСвойства);
	
	Если КонвертироватьИдентификаторы Тогда
		Для Каждого ЭлементИдентификатор Из МассивИдентификаторов Цикл
			НоваяСтрока[ЭлементИдентификатор] = Новый УникальныйИдентификатор(ДанныеXDTO.Получить(ЭлементИдентификатор));
			НоваяСтрока[ЭлементИдентификатор + "_Строка"] = ДанныеXDTO.Получить(ЭлементИдентификатор);
		КонецЦикла;
	КонецЕсли;
	
	Для Каждого ЭлементДата Из МассивДатСтрокой Цикл
		НоваяСтрока[ЭлементДата] = XMLЗначение(Тип("Дата"), ДанныеXDTO.Получить(ЭлементДата));
	КонецЦикла;
	
	Для Каждого ЭлементТипа Из ЭлементыМутабельногоТипа Цикл
		ОбъектXDTO = ДанныеXDTO.Получить(ЭлементТипа);
		Если Не ОбъектXDTO.Свойства().Количество() Тогда
			Продолжить;
		КонецЕсли;
		
		ОбъектИлиСписокXDTO = ДанныеXDTO.Получить(ЭлементТипа);
		Если ОбъектИлиСписокXDTO.Свойства().Количество() > 1 Тогда
			ЭлементXDTO = ОбъектИлиСписокXDTO;
		Иначе
			ТипТекущегоОбъекта = ОбъектИлиСписокXDTO.Свойства().Получить(ЭлементТипа);
			Если ТипТекущегоОбъекта <> Неопределено Тогда
				ЭлементXDTO = ОбъектИлиСписокXDTO[ЭлементТипа];
			Иначе
				ЭлементXDTO = ОбъектИлиСписокXDTO;
			КонецЕсли;
		КонецЕсли;
		
		ЭлементыМутабельногоТипаВлож = Новый Массив;
		НоваяСтрока[ЭлементТипа] = КонвертироватьДанныеXDTOВТаблицуЗначений(
			ЭлементXDTO, ЭлементыМутабельногоТипаВлож, КонвертироватьИдентификаторы, ПоляИсключения);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьОбъектПоОбъектуXDTO(МенеджерОбъекта,
	ОбъектОбработки,
	ОбъектXDTO,
	Источник,
	КонтекстЗаполнения,
	ИспользоватьУниверсальноеЗаполнение,
	УзелMDM,
	СтруктураИсторииИнтеграции)
	
	Если Не ИспользоватьУниверсальноеЗаполнение Тогда
		Возврат;
	КонецЕсли;
	
	ВыгружатьУниверсальноеВремя = Ложь;
	
	МетаОбъекта = ОбъектОбработки.Метаданные();
	
	СвойстваXDTO = ОбъектXDTO.Свойства();
	
	ТекстыЗапросовГлобальный = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Заглушка", "");
	Запрос.УстановитьПараметр("Узел", Источник);
	Запрос.УстановитьПараметр("УзелMDM", УзелMDM);
	
	Результат = ДополнитьЗапросДинамическимиДаннымиШапки(МетаОбъекта,
		ОбъектXDTO,
		СвойстваXDTO,
		КонтекстЗаполнения);
	ТекстыЗапросовГлобальный.Добавить(Результат.ТекстЗапроса);
	
	РезультатДополненияТабличнымиЧастями = ДополнитьЗапросДинамическимиДаннымиТабличныхЧастей(МетаОбъекта,
		ОбъектXDTO,
		СвойстваXDTO,
		КонтекстЗаполнения);
	пбп_ПереадресацияКлиентСервер.ДополнитьМассив(ТекстыЗапросовГлобальный, РезультатДополненияТабличнымиЧастями.ТекстыЗапроса);
	
	пбп_ПереадресацияКлиентСервер.ДополнитьСтруктуру(Результат.ПараметрыЗапроса,
		РезультатДополненияТабличнымиЧастями.ПараметрыЗапроса);
	
	Для Каждого Пара Из Результат.ПараметрыЗапроса Цикл
		Запрос.УстановитьПараметр(Пара.Ключ, Пара.Значение);
	КонецЦикла;
	
	Запрос.Текст = СтрСоединить(ТекстыЗапросовГлобальный, пбп_Переадресация.РазделительПакетаЗапросов());
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	РеквизитыИсключения = РеквизитыИсключенияЗаполнения();
	
	ВыборкаШапка = РезультатыЗапроса[1].Выбрать();
	Пока ВыборкаШапка.Следующий() Цикл
		Если Не РеквизитыИсключения.Найти(ВыборкаШапка.ИмяРеквизита) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ЧастиДатыЗначение = Неопределено;
		Реквизит = СтандартныйРеквизитПоИмени(МетаОбъекта, ВыборкаШапка.ИмяРеквизита);
		Если Реквизит = Неопределено Тогда
			Реквизит = МетаОбъекта.Реквизиты.Найти(ВыборкаШапка.ИмяРеквизита);
		КонецЕсли;
		
		Если Не Реквизит = Неопределено И ЭтоДата(Реквизит.Тип.Типы()) И ВыгружатьУниверсальноеВремя Тогда
			ЧастиДатыЗначение = Реквизит.Тип.КвалификаторыДаты.ЧастиДаты;
		КонецЕсли;
		
		ОбъектОбработки[ВыборкаШапка.ИмяРеквизита] = ПреобразоватьЗагружаемыйРеквизит(ВыборкаШапка.Значение, ЧастиДатыЗначение);
	КонецЦикла;
	
	Сч = 3;
	СчТЧ = 0;
	Пока Сч <= РезультатыЗапроса.ВГраница() Цикл
		ТабличнаяЧасть = ОбъектОбработки[РезультатДополненияТабличнымиЧастями.ПорядокТабличныхЧастей[СчТЧ]];
		ТабличнаяЧасть.Очистить();// в последующем будем и обновлять строки
		
		РеквизитТЧ = МетаОбъекта.ТабличныеЧасти.Найти(РезультатДополненияТабличнымиЧастями.ПорядокТабличныхЧастей[СчТЧ]);
		
		ВыборкаТабличнаяЧасть = РезультатыЗапроса[Сч].Выбрать();
		Пока ВыборкаТабличнаяЧасть.Следующий() Цикл
			нСтрока = ТабличнаяЧасть.Добавить();
			ЗаполнитьЗначенияСвойств(нСтрока, ВыборкаТабличнаяЧасть);
			
			Для Каждого РеквизитВыборки Из РезультатыЗапроса[Сч].Колонки Цикл
				
				ЧастиДатыЗначение = Неопределено;
				Реквизит = РеквизитТЧ.Реквизиты.Найти(РеквизитВыборки.Имя);
				Если Реквизит = Неопределено Тогда
					Продолжить;
				ИначеЕсли ЭтоДата(Реквизит.Тип.Типы()) И ВыгружатьУниверсальноеВремя Тогда
					ЧастиДатыЗначение = Реквизит.Тип.КвалификаторыДаты.ЧастиДаты;
				КонецЕсли;
				
				нСтрока[Реквизит.Имя] = ПреобразоватьЗагружаемыйРеквизит(нСтрока[Реквизит.Имя], ЧастиДатыЗначение);
			КонецЦикла;
			
		КонецЦикла;
		
		Сч = Сч + 2;
		СчТЧ = СчТЧ + 1;
	КонецЦикла;
	
КонецПроцедуры

Функция ДополнитьЗапросДинамическимиДаннымиТабличныхЧастей(МетаОбъекта, ОбъектXDTO, СвойстваXDTO, КонтекстЗаполнения)
	
	Результат = Новый Структура("ТекстыЗапроса,ПараметрыЗапроса,ПорядокТабличныхЧастей", Новый Массив, Новый Структура, Новый Массив);
	
	ШаблонТекстаЗапросаТабличнойЧасти = "ВЫБРАТЬ
	|	Данные.ИмяТабличнойЧасти КАК ИмяТабличнойЧасти
	|ПОМЕСТИТЬ ВТ_Данные_%1
	|ИЗ
	|	&%1 КАК Данные
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеТЧ.ИмяТабличнойЧасти КАК ИмяТабличнойЧасти
	|ИЗ
	|	ВТ_Данные_%1 КАК ДанныеТЧ";
	
	ШаблонСсылочногоПоля = "ЕСТЬNULL(%1.Ссылка, ЗНАЧЕНИЕ(%2.ПустаяССылка))";
	ШаблонСсылочногоПоляБезПроверкиNull = "%1.Ссылка";
	ШаблонСоединения = "ЛЕВОЕ СОЕДИНЕНИЕ %1 КАК %2
	    | ПО (УНИКАЛЬНЫЙИДЕНТИФИКАТОР(%2.Ссылка) = ДанныеТЧ.%3)";
	//ШаблонСоединенияСоставногоТипа = "ЛЕВОЕ СОЕДИНЕНИЕ %1 КАК %2
	//    | ПО (%2.Ссылка) = ДанныеТЧ.%3)";
	ШаблонВыбора = "КОГДА НЕ %1 ЕСТЬ NULL ТОГДА
	    |%1";
	ШаблонКонцаВыбора = "ИНАЧЕ ДанныеТЧ.%1
	    |КОНЕЦ";
	
	ПорядокТЧ = Новый Массив;
	Для Каждого ТабличнаяЧасть Из МетаОбъекта.ТабличныеЧасти Цикл
		
		СоответствиеПоТЧ = КонтекстЗаполнения.СоответствиеПолейИсточникаИПриемника[ТабличнаяЧасть.Имя];
		Если СоответствиеПоТЧ = Неопределено Тогда
			СоответствиеПоТЧ = Новый Соответствие;
		КонецЕсли;
		ИмяТЧИзИсточника = СоответствиеПоТЧ["_имя_источника"];
		Если Не ЗначениеЗаполнено(ИмяТЧИзИсточника) Тогда
			ИмяТЧИзИсточника = ТабличнаяЧасть.Имя;
		КонецЕсли;
		
		ПоляИсключенияТЧ = КонтекстЗаполнения.ПоляИсключения[ТабличнаяЧасть.Имя];
		Если ПоляИсключенияТЧ = Истина Тогда
			Продолжить;
		ИначеЕсли ПоляИсключенияТЧ = Неопределено Тогда
			ПоляИсключенияТЧ = Новый Соответствие;
		КонецЕсли;
		
		СоответствиеТиповПолейТЧ = КонтекстЗаполнения.СоответствиеТиповПолей[ТабличнаяЧасть.Имя];
		Если СоответствиеТиповПолейТЧ = Неопределено Тогда
			СоответствиеТиповПолейТЧ = Новый Соответствие;
		КонецЕсли;
		
		ПоляПоискаТЧ = КонтекстЗаполнения.ПоляПоиска[ТабличнаяЧасть.Имя];
		Если ПоляПоискаТЧ = Неопределено Тогда
			ПоляПоискаТЧ = Новый Соответствие;
		КонецЕсли;
		
		СвойствоXDTO = СвойстваXDTO.Получить(ИмяТЧИзИсточника);
		Если СвойствоXDTO = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ТабличнаяЧастьXDTO = ОбъектXDTO.Получить(СвойствоXDTO);
		Свойства = ТабличнаяЧастьXDTO.Свойства();
		Если Не ЗначениеЗаполнено(Свойства) Тогда
			Продолжить;
		КонецЕсли;
		
		ТекстЗапроса = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонТекстаЗапросаТабличнойЧасти, ТабличнаяЧасть.Имя);
		
		КоллекцияXDTO = ТабличнаяЧастьXDTO[ИмяТЧИзИсточника];
		Если ТипЗнч(КоллекцияXDTO) = Тип("СписокXDTO") Тогда
			СвойстваСпискаXDTO = КоллекцияXDTO[0].Свойства();
		Иначе
			СвойстваСпискаXDTO = КоллекцияXDTO.Свойства();
			//КоллекцияXDTO = пбп_ПереадресацияКлиентСервер.ЗначениеВМассиве(КоллекцияXDTO);
			Если СвойстваСпискаXDTO.Получить(ИмяТЧИзИсточника) <> Неопределено Тогда
				КоллекцияXDTO = КоллекцияXDTO[ИмяТЧИзИсточника]; //СписокXDTO
				СвойстваСпискаXDTO = КоллекцияXDTO[0].Свойства();
			Иначе
				КоллекцияXDTO = пбп_ПереадресацияКлиентСервер.ЗначениеВМассиве(КоллекцияXDTO);
			КонецЕсли;
		КонецЕсли;
		
		ТЗ = Новый ТаблицаЗначений;
		ТЗ.Колонки.Добавить("ИмяТабличнойЧасти", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(30)));
		
		ПоляТЧ = Новый Массив;
		ЧастиЗапроса = Новый Массив;
		
		Поля = Новый СписокЗначений;
		Для Каждого Реквизит Из ТабличнаяЧасть.Реквизиты Цикл
			ИмяИзИсточника = ПолучитьЗначениеИзСоответствияИсточникаИПриемника(СоответствиеПоТЧ, Реквизит.Имя);
			Если Не ЗначениеЗаполнено(ИмяИзИсточника) Тогда
				ИмяИзИсточника = Реквизит.Имя;
			КонецЕсли;
			
			ИмяРеквизита = Реквизит.Имя;
			Если СвойстваСпискаXDTO.Получить(ИмяИзИсточника) = Неопределено 
				Или ЗначениеЗаполнено(ПоляИсключенияТЧ[ИмяИзИсточника]) Тогда
				Продолжить;
			КонецЕсли;
			
			Поле = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку("Данные.%1", ИмяИзИсточника);
			//ТекстЗапроса = пбп_СхемыЗапросов.ДобавитьПолеВыборкиВЗапрос(ТекстЗапроса, Поле, , 0);
			ДобавитьПолеВЗапросПриЗагрузке(ТекстЗапроса, Поле, "Данные");
			
			СтруктураПоля = Новый Структура("Имя,ЭтоGUID,Мета");
			
			СтруктураПоля.Имя = ИмяРеквизита;
			//СтруктураПоля.Имя = ИмяИзИсточника;
			
			Для Каждого ЭлементКоллекции Из КоллекцияXDTO Цикл
				СтруктураПоля.ЭтоGUID =
					ЭтоУникальныйИдентификатор(ЭлементКоллекции.Получить(ИмяИзИсточника));
				Если СтруктураПоля.ЭтоGUID Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
			СтруктураПоля.Мета = Неопределено;
			
			СоответствиеПолей = Новый Соответствие;
			СоответствиеТиповПолей = Новый Соответствие;
			ТипыПоля = СоответствиеТиповПолейТЧ[ИмяИзИсточника];
			ИмяТипаРеквизита = "" + ИмяРеквизита + "Тип";
			ЕстьСсылочныеВСоставном = Ложь;
			Если ТипыПоля = Неопределено
				И Не СвойстваСпискаXDTO.Получить(ИмяТипаРеквизита) = Неопределено Тогда
				
				ТипыПоляXDTO = Новый Массив;
				Для Каждого ЭлементКоллекции Из КоллекцияXDTO Цикл
					
					Если Не ЭлементКоллекции[ИмяТипаРеквизита] = "Неопределено" Тогда
						ТипОбъекта = Тип(ЭлементКоллекции[ИмяТипаРеквизита]);
						Если ТипыПоляXDTO.Найти(ТипОбъекта) = Неопределено Тогда
							ТипыПоляXDTO.Добавить(ТипОбъекта);
							
							Если Не ЕстьСсылочныеВСоставном
								И Не пбп_ОбщегоНазначенияСервер.ЭтоПримитивныйТип(ТипОбъекта) Тогда
								ЕстьСсылочныеВСоставном = Истина;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
					
				КонецЦикла;
				
				Если Не ТипыПоляXDTO.Количество() = 0 Тогда
					ТипыПоля = ТипыПоляXDTO;
				КонецЕсли;
				
			КонецЕсли;
			ПоляПоиска = ПоляПоискаТЧ[ИмяИзИсточника];
			
			// Проверим, если это классификатор и не заданы поля поиска
			// зададим поля по умолчанию
			Если ПоляПоиска = Неопределено
				И ТипыПоля = Неопределено Тогда
				
				Если СтруктураПоля.ЭтоGUID И Не Реквизит.Тип = Новый ОписаниеТипов("УникальныйИдентификатор") Тогда
					ПоляПоиска = пбп_ПереадресацияКлиентСервер.ЗначениеВМассиве(ИмяПоляПоискаПоПубличномуИдентификатору());
					ПоляПоиска.Добавить(ИмяПоляПоискаПоВнутреннемуИдентификатору());
				Иначе
					ПоляПоиска = Новый Массив;
				КонецЕсли;
				
				ПолеПоиска = ПолучитьИмяРеквизитаВыгрузкиУниверсально(Реквизит.Тип.Типы()[0]);
				Если ЗначениеЗаполнено(ПолеПоиска)
					И Не ПолеПоиска = "email" Тогда // поиск по емэйл пока не реализован
					
					Если ПоляПоиска.Найти(ПолеПоиска) = Неопределено Тогда
						ПоляПоиска.Добавить(ПолеПоиска);
					КонецЕсли;
					
				КонецЕсли;
				
				Если ПоляПоиска.Количество() = 0 Тогда
					ПоляПоиска = Неопределено;
				КонецЕсли;
				
			КонецЕсли;
			
			Если ТипыПоля <> Неопределено Тогда
				ДанныеДобалвенногоПоля = ДобавитьРеквизитСоставногоТипыВЗапросТЧ(КоллекцияXDTO, ТЗ, ТекстЗапроса,
					СтруктураПоля, 
					ИмяИзИсточника, 
					ТипыПоля, 
					ЧастиЗапроса,
					Реквизит,
					СоответствиеПоТЧ,
					СоответствиеПолей,
					СоответствиеТиповПолей);
					
				// могут быть составные без ссылочных значений: зачистим лишнее
				Если Не ЕстьСсылочныеВСоставном Тогда
					ДанныеДобалвенногоПоля.Поле = СтрЗаменить(ДанныеДобалвенногоПоля.Поле,
					"ВЫБОР
					|ИНАЧЕ ДанныеТЧ." + ИмяИзИсточника + "
					|КОНЕЦ",
					"ДанныеТЧ." + ИмяИзИсточника);
					
					МассивПримитивныхТипов = Новый Массив;
					МассивПримитивныхТипов.Добавить(Тип("Число"));
					МассивПримитивныхТипов.Добавить(Тип("Строка"));
					МассивПримитивныхТипов.Добавить(Тип("Дата"));
					МассивПримитивныхТипов.Добавить(Тип("Булево"));
					ДанныеДобалвенногоПоля.ТипКолонки = Новый ОписаниеТипов(МассивПримитивныхТипов);
				КонецЕсли;
				
				Поле = ДанныеДобалвенногоПоля.Поле;
				ТипКолонки = ДанныеДобалвенногоПоля.ТипКолонки;
			Иначе
				ПроверяемыйТип = Реквизит.Тип.Типы()[0];
				
				ДанныеДобалвенногоПоля = ДобавитьРеквизитВЗапросТЧ(КоллекцияXDTO, ТЗ, ТекстЗапроса,
					СтруктураПоля, 
					ИмяИзИсточника, 
					ПроверяемыйТип, 
					ПоляПоиска, 
					ЧастиЗапроса,
					Реквизит,
					СоответствиеПоТЧ,
					СоответствиеПолей,
					СоответствиеТиповПолей);
				
				Поле = ДанныеДобалвенногоПоля.Поле;
				ТипКолонки = ДанныеДобалвенногоПоля.ТипКолонки;
			КонецЕсли;
			ПоляТЧ.Добавить(СтруктураПоля);
			Поля.Добавить(Поле, СтруктураПоля.Имя);
			
			Если СоответствиеТиповПолей.Количество() = 0 Тогда
				//ТЗ.Колонки.Добавить(Реквизит.Имя, ТипКолонки);
				Если ТЗ.Колонки.Найти(ИмяИзИсточника) = Неопределено Тогда
					ТЗ.Колонки.Добавить(ИмяИзИсточника, ТипКолонки);
				КонецЕсли;
				//
			Иначе
				Для Каждого ТекущийРеквизит Из СоответствиеТиповПолей Цикл
					Если ТЗ.Колонки.Найти(ТекущийРеквизит.Ключ) = Неопределено Тогда
						Если Не ЗначениеЗаполнено(ТекущийРеквизит.Значение)
							И СоответствиеТиповПолей.Количество() = 1 Тогда
							ТЗ.Колонки.Добавить(ТекущийРеквизит.Ключ, ТипКолонки);
						Иначе
							ТЗ.Колонки.Добавить(ТекущийРеквизит.Ключ, ТекущийРеквизит.Значение);
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
				
				Если ТЗ.Колонки.Найти(ИмяИзИсточника) = Неопределено Тогда
					ТЗ.Колонки.Добавить(ИмяИзИсточника, пбп_Переадресация.ОписаниеТипаСтрока(36));
				КонецЕсли; 
			КонецЕсли;
			
		КонецЦикла;
		
		Части = Новый Массив;
		Части.Добавить(ТекстЗапроса);
		пбп_ПереадресацияКлиентСервер.ДополнитьМассив(Части, ЧастиЗапроса);
		
		ТекстЗапроса = СтрСоединить(Части, Символы.ПС);
		//ТекстЗапроса = пбп_СхемыЗапросов.ДобавитьПоляВыборкиВЗапрос(ТекстЗапроса, Поля, 1);
		
		ДобавитьПоляВЗапросПриЗагрузке(ТекстЗапроса, Поля);
		
		Для Каждого Объект Из КоллекцияXDTO Цикл
			нСтрока = ТЗ.Добавить();
			
			Для Каждого ПолеТЧ Из ПоляТЧ Цикл
				ВложенноеСоответствие = СоответствиеПоТЧ[ПолеТЧ.Имя];
				Если ЗначениеЗаполнено(ВложенноеСоответствие) Тогда
					Для Каждого Пара Из ВложенноеСоответствие Цикл
						ЗначениеПараметра = Объект.Получить(Пара.Значение);
						Если ЭтоСтандартнаяДата(ЗначениеПараметра) Тогда
							ЗначениеПараметра = XMLЗначение(Тип("Дата"), ЗначениеПараметра);
						КонецЕсли;
						Если Пара.Ключ = ИмяПоляПоискаПоПубличномуИдентификатору() Тогда
							нСтрока[ПолеТЧ.Имя] = ЗначениеПараметра;
						Иначе
							//нСтрока[Пара.Значение] = ЗначениеПараметра;
							Если ПолеТЧ.Мета <> Неопределено И Не ПолеТЧ.ЭтоGUID И ОбъектМетаданныхЯвляетсяПеречислением(ПолеТЧ.Мета)  Тогда
								Менеджер = пбп_Переадресация.МенеджерОбъектаПоПолномуИмени(ПолеТЧ.Мета.ПолноеИмя());
								Если ЗначениеЗаполнено(ЗначениеПараметра) Тогда
									ЗначениеПараметра = Менеджер[ЗначениеПараметра];
								Иначе
									ЗначениеПараметра = Менеджер.ПустаяСсылка();
								КонецЕсли;
							ИначеЕсли Не ЗначениеЗаполнено(ЗначениеПараметра) Тогда
								Если Не ТЗ.Колонки.Найти(ПолеТЧ.Имя) = Неопределено Тогда
									нСтрока[ПолеТЧ.Имя] = Неопределено;
								Иначе
									ЗначениеПараметра = Неопределено;
								КонецЕсли;
							ИначеЕсли ЭтоСтандартнаяДата(ЗначениеПараметра) Тогда
								ЗначениеПараметра = XMLЗначение(Тип("Дата"), ЗначениеПараметра);
							ИначеЕсли ПолеТЧ.ЭтоGUID Тогда
								ЗначениеПараметра = Новый УникальныйИдентификатор(ЗначениеПараметра);
							КонецЕсли;
							
							Если Не ТЗ.Колонки.Найти(Пара.Ключ) = Неопределено Тогда
								нСтрока[Пара.Ключ] = ЗначениеПараметра;
							Иначе
								нСтрока[Пара.Значение] = ЗначениеПараметра;
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;
				Иначе
					ИмяИзИсточника = ПолучитьЗначениеИзСоответствияИсточникаИПриемника(СоответствиеПоТЧ, ПолеТЧ.Имя);
					Если Не ЗначениеЗаполнено(ИмяИзИсточника) Тогда
						ИмяИзИсточника = ПолеТЧ.Имя;
					КонецЕсли;
					
					ЗначениеПараметра = Объект.Получить(ИмяИзИсточника);
					Если ПолеТЧ.ЭтоGUID Тогда
						Если Не ЗначениеЗаполнено(ЗначениеПараметра) Тогда
							ЗначениеПараметра = Неопределено;
						Иначе
							ЗначениеПараметра = Новый УникальныйИдентификатор(ЗначениеПараметра);
						КонецЕсли;
					КонецЕсли;
					
					// заведомо для составного типа не может быть передано предопределенное значение,
					// если в дальнейшем измениться, поменяем логику
					Если ПолеТЧ.Мета <> Неопределено И Не ПолеТЧ.ЭтоGUID Тогда
						Менеджер = пбп_Переадресация.МенеджерОбъектаПоПолномуИмени(ПолеТЧ.Мета.ПолноеИмя());
						Если ЗначениеЗаполнено(ЗначениеПараметра) Тогда
							ЗначениеПараметра = Менеджер[ЗначениеПараметра];
						Иначе
							ЗначениеПараметра = Менеджер.ПустаяСсылка();
						КонецЕсли;
					ИначеЕсли ЭтоСтандартнаяДата(ЗначениеПараметра) Тогда
						ЗначениеПараметра = XMLЗначение(Тип("Дата"), ЗначениеПараметра);
					КонецЕсли;
					
					нСтрока[ПолеТЧ.Имя] = ЗначениеПараметра;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		Результат.ПорядокТабличныхЧастей.Добавить(ТабличнаяЧасть.Имя);
		Результат.ПараметрыЗапроса.Вставить(ТабличнаяЧасть.Имя, ТЗ);
		Результат.ТекстыЗапроса.Добавить(ТекстЗапроса);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ДополнитьЗапросДинамическимиДаннымиШапки(МетаОбъекта, ОбъектXDTO, СвойстваXDTO, КонтекстЗаполнения)
	
	Результат = Новый Структура("ТекстЗапроса,ПараметрыЗапроса", "", Новый Структура);
	
	ТекстЗапроса = "ВЫБРАТЬ
				|	&Заглушка КАК Заглушка
				|ПОМЕСТИТЬ ВТ_Данные";
	
	Сч = 0;
	Для Каждого Реквизит Из МетаОбъекта.Реквизиты Цикл
		ИмяИзИсточника = ПолучитьЗначениеИзСоответствияИсточникаИПриемника(
		КонтекстЗаполнения.СоответствиеПолейИсточникаИПриемника, Реквизит.Имя);
		Если Не ЗначениеЗаполнено(ИмяИзИсточника) Тогда
			ИмяИзИсточника = Реквизит.Имя;
		КонецЕсли;
		
		Если Реквизит.Имя = "Ссылка"
			Или ЗначениеЗаполнено(КонтекстЗаполнения.ПоляИсключения[Реквизит.Имя])
			Или СвойстваXDTO.Получить(ИмяИзИсточника) = Неопределено
			Или НЕ ЗначениеЗаполнено(ОбъектXDTO.Получить(ИмяИзИсточника)) 
			Или СтрНайти(ОбъектXDTO.Получить(ИмяИзИсточника),"00000000-0000-0000-0000-000000000000") > 0 
			Или ОбъектXDTO.Получить(ИмяИзИсточника) = XMLСтрока(Дата(1,1,1)) Тогда
			Продолжить;
		КонецЕсли;
		
		ЗначенияПараметров = ДополнитьТекстЗапросаРеквизитовОбъектаПолем(ТекстЗапроса,
		Реквизит,
		ИмяИзИсточника,
		ОбъектXDTO,
		СвойстваXDTO,
		КонтекстЗаполнения,
		Сч);
		
		Если ИмяИзИсточника <> Реквизит.Имя
			И НЕ ЗначенияПараметров.Свойство(Реквизит.Имя)
			И ЗначенияПараметров.Свойство(ИмяИзИсточника) Тогда
			ЗначенияПараметров.Вставить(Реквизит.Имя, ЗначенияПараметров[ИмяИзИсточника]);
		КонецЕсли;
		//
		пбп_ПереадресацияКлиентСервер.ДополнитьСтруктуру(Результат.ПараметрыЗапроса, ЗначенияПараметров);
		
		Сч = Сч + 1;
	КонецЦикла;
	
	Для Каждого Реквизит Из МетаОбъекта.СтандартныеРеквизиты Цикл
		ИмяИзИсточника = ПолучитьЗначениеИзСоответствияИсточникаИПриемника(
		КонтекстЗаполнения.СоответствиеПолейИсточникаИПриемника, Реквизит.Имя);
		Если Не ЗначениеЗаполнено(ИмяИзИсточника) Тогда
			ИмяИзИсточника = Реквизит.Имя;
		КонецЕсли;
		
		Если Реквизит.Имя = "Ссылка"
			Или ЗначениеЗаполнено(КонтекстЗаполнения.ПоляИсключения[Реквизит.Имя])
			Или СвойстваXDTO.Получить(ИмяИзИсточника) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ЗначенияПараметров = ДополнитьТекстЗапросаРеквизитовОбъектаПолем(ТекстЗапроса,
		Реквизит,
		ИмяИзИсточника,
		ОбъектXDTO,
		СвойстваXDTO,
		КонтекстЗаполнения,
		Сч);
		
		пбп_ПереадресацияКлиентСервер.ДополнитьСтруктуру(Результат.ПараметрыЗапроса, ЗначенияПараметров);
		
		Сч = Сч + 1;
	КонецЦикла;
	
	Результат.ТекстЗапроса = ТекстЗапроса;
	
	Возврат Результат;

	
КонецФункции

Функция ДополнитьТекстЗапросаРеквизитовОбъектаПолем(ТекстЗапроса, Реквизит, ИмяИзИсточника, ОбъектXDTO, СвойстваXDTO,
	КонтекстЗаполнения, ИндексОператора)
	
	ШаблонВыбора = "КОГДА НЕ %1 ЕСТЬ NULL ТОГДА
			|%1";
	ШаблонКонцаВыбора = "ИНАЧЕ ВТ_Данные.%1";
	ШаблонТекстаЗапроса = "
	|ВЫБРАТЬ
	|	ВТ_Данные.Заглушка Как Заглушка,
	|	NULL КАК ИмяРеквизита,
	|	NULL КАК Значение
	|ИЗ
	|	ВТ_Данные КАК ВТ_Данные";
	
	Если ИндексОператора = 0 Тогда
		ТекстЗапроса = ТекстЗапроса + пбп_Переадресация.РазделительПакетаЗапросов() + ШаблонТекстаЗапроса;
	Иначе
		ТекстЗапроса = ТекстЗапроса + ТекстОбъединитьВсе() + ШаблонТекстаЗапроса;
	КонецЕсли;
	
	ИмяРеквизита = Реквизит.Имя;
	
	ДобавитьПолеВЗапросПриЗагрузке(ТекстЗапроса, ИмяРеквизита);
	
	ИмяТаблицы = "";
	Значение = ОбъектXDTO.Получить(ИмяИзИсточника);
	ЭтоGUID = ЭтоУникальныйИдентификатор(Значение);
	
	ЗначениеПараметра = Значение;
	Если ЭтоGUID Тогда// И Не ЭтоПолеПоискаПоВнешнемуИдентификатору Тогда
		ЗначениеПараметра = Новый УникальныйИдентификатор(Значение);
	ИначеЕсли ЭтоСтандартнаяДата(ЗначениеПараметра) Тогда
		ЗначениеПараметра = XMLЗначение(Тип("Дата"), ЗначениеПараметра);
	КонецЕсли;
	
	ТипыПоля = КонтекстЗаполнения.СоответствиеТиповПолей[ИмяРеквизита];
	ПоляПоиска = КонтекстЗаполнения.ПоляПоиска[ИмяРеквизита];
	
	// Добавление выгрузки типа реквизита, если он составной
	// Если в XDTO передадут тип, то поиск делаем по нему
	ИмяСвойстваТип = "" + Реквизит.Имя + "Тип";
	Если Не ОбъектXDTO.Свойства().Получить(ИмяСвойстваТип) = Неопределено
		И ЗначениеЗаполнено(ОбъектXDTO[ИмяСвойстваТип]) Тогда
		
		ПроверяемыйТип = Тип(ОбъектXDTO[ИмяСвойстваТип]);
	Иначе
		ПроверяемыйТип = Реквизит.Тип.Типы()[0];
	КонецЕсли;
	
	// Проверим, если это классификатор и не заданы поля поиска
	// зададим поля по умолчанию
	Если ПоляПоиска = Неопределено Тогда
		ЗаполнитьПоляПоискаПоУмолчанию(ПоляПоиска, ЭтоGUID, ПроверяемыйТип);
	КонецЕсли;
	
	ЗначенияПараметров = Новый Структура;
	// Объединить. Вынести поиск по полям, чтобы можно было использовать из составного типа и одиночного
	Если ТипыПоля <> Неопределено Тогда
		Поле = ПолучитьТекстЗапросаРеквизитовОбъекта_ПоТипамПолей(ТекстЗапроса, ТипыПоля, ЭтоGUID,
			ИмяРеквизита, ИндексОператора, ШаблонВыбора, ЗначенияПараметров, ЗначениеПараметра);
	ИначеЕсли ПоляПоиска <> Неопределено Тогда
		Поле = ПолучитьТекстЗапросаРеквизитовОбъекта_ПоПолямПоиска(ТекстЗапроса, КонтекстЗаполнения,
			ПоляПоиска, ОбъектXDTO, ИмяРеквизита, ИндексОператора, ПроверяемыйТип, ЗначенияПараметров, ЗначениеПараметра);
	Иначе
		Поле = ПолучитьТекстЗапросаРеквизитовОбъекта_ПоУмолчанию(ТекстЗапроса, ЭтоGUID,
			ИмяРеквизита, ИндексОператора, ПроверяемыйТип, ЗначенияПараметров, ЗначениеПараметра);
	КонецЕсли;
	
	ДобавитьЗначенияПоляССоединениямиВЗапросРеквизитовОбъекта(ТекстЗапроса, ИмяРеквизита, Поле);
	
	Возврат ЗначенияПараметров;
	
КонецФункции

Функция ПолучитьТекстЗапросаРеквизитовОбъекта_ПоТипамПолей(ТекстЗапроса, ТипыПоля, ЭтоGUID,
	ИмяРеквизита, ИндексОператора, ШаблонВыбора, ЗначенияПараметров, ЗначениеПараметра)
	
	мВыбора = Новый Массив;
	мВыбора.Добавить("ВЫБОР");
	
	Для Каждого ТипПоля Из ТипыПоля Цикл
		ЭтоСсылка = пбп_Переадресация.ЭтоСсылка(ТипПоля);
		
		Если ЭтоСсылка Тогда
			ИмяТаблицы = Метаданные.НайтиПоТипу(ТипПоля).ПолноеИмя();
			
			Менеджер = пбп_Переадресация.МенеджерОбъектаПоПолномуИмени(ИмяТаблицы);
		КонецЕсли;
		
		Если ЭтоСсылка И Не ЭтоGUID Тогда
			Если ЗначениеЗаполнено(ЗначениеПараметра) Тогда
				ЗначениеПараметра = Менеджер[ЗначениеПараметра];
			Иначе
				ЗначениеПараметра = Менеджер.ПустаяСсылка();
			КонецЕсли;
		ИначеЕсли ЭтоСсылка Тогда
			Поле = ДополнитьЗапросСсылочнымПолемКонкатенация(ТекстЗапроса,
				ИмяРеквизита, ИмяТаблицы, "ВТ_Данные", 1, ИндексОператора, Ложь);
			
			Поле = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонВыбора, Поле);
			мВыбора.Добавить(Поле);
		КонецЕсли;
	КонецЦикла;
	
	ЗначенияПараметров.Вставить(ИмяРеквизита, ЗначениеПараметра);
	
	мВыбора.Добавить("КОНЕЦ");
	
	Поле = СтрСоединить(мВыбора, Символы.ПС);
	
	Возврат Поле;
	
КонецФункции

Функция ПолучитьТекстЗапросаРеквизитовОбъекта_ПоПолямПоиска(ТекстЗапроса, КонтекстЗаполнения,
	ПоляПоиска, ОбъектXDTO, ИмяРеквизита, ИндексОператора, ПроверяемыйТип, ЗначенияПараметров, ЗначениеПараметра)
	
	СоотвПолей = КонтекстЗаполнения.СоответствиеПолейИсточникаИПриемника[ИмяРеквизита];
	Если СоотвПолей = Неопределено Тогда
		СоотвПолей = Новый Соответствие;
	КонецЕсли;
	
	ВнешнИД = ИмяПоляПоискаПоПубличномуИдентификатору();
	ВнутрИД = ИмяПоляПоискаПоВнутреннемуИдентификатору();
	
	ЭтоСсылка = пбп_Переадресация.ЭтоСсылка(ПроверяемыйТип);
	
	Если ЭтоСсылка Тогда
		ИмяТаблицы = Метаданные.НайтиПоТипу(ПроверяемыйТип).ПолноеИмя();
		
		Менеджер = пбп_Переадресация.МенеджерОбъектаПоПолномуИмени(ИмяТаблицы);
	КонецЕсли;
	
	ПоследнееУсловие = "ЕСТЬNULL(%1, Неопределено)";
	ПервоеУсловие = "ЕСТЬNULL(%1, %2)";
	Для Сч = 0 По ПоляПоиска.ВГраница() Цикл
		ПолеПоиска = ПоляПоиска[Сч];
		
		Если ПолеПоиска = ВнешнИД Тогда
			
			ОписаниеРегистра = ОписаниеРегистраПубличныхИдентификаторов();
			
			Если ОписаниеРегистра.Использовать Тогда
				
				ЗначениеПараметра = Строка(ЗначениеПараметра);
				ИмяРеквизитаПоиска = ИмяРеквизита + "_Строка";
				ДобавитьПолеВЗапросПриЗагрузке(ТекстЗапроса, ИмяРеквизитаПоиска);
				Поле = ДополнитьЗапросДаннымиПоПубличномуИдентификаторуКонкатенация(
					ТекстЗапроса, ИмяРеквизитаПоиска, ИмяТаблицы, "ВТ_Данные", Ложь);
				ЗначенияПараметров.Вставить(ИмяРеквизитаПоиска, ЗначениеПараметра);
				ЗначенияПараметров.Вставить(ИмяРеквизита, ЗначениеПараметра);
				
			Иначе
				
				Поле = "Неопределено";
				
			КонецЕсли;
			
		ИначеЕсли ПолеПоиска = ВнутрИД Тогда
			ЗначениеПараметра = Строка(ЗначениеПараметра);
			Поле = ДополнитьЗапросСсылочнымПолемКонкатенация(ТекстЗапроса, ИмяРеквизита, ИмяТаблицы, "ВТ_Данные", 1, ИндексОператора);
			Если ЗначениеЗаполнено(ЗначениеПараметра) Тогда
				ЗначенияПараметров.Вставить(ИмяРеквизита, Новый УникальныйИдентификатор(ЗначениеПараметра));
			Иначе
				ЗначенияПараметров.Вставить(ИмяРеквизита,
					ПустойУникальныйИдентификатор());
			КонецЕсли;
			
		ИначеЕсли ПолеПоиска = "email" Тогда
			Поле = "Неопределено";
			
		Иначе
			ПолеИзXDTO = СоотвПолей.Получить(ПолеПоиска);
			
			Если ПолеИзXDTO = Неопределено Тогда
				
				ПолеИзXDTO = ИмяРеквизита;
				
			КонецЕсли;
			
			ПолеПоискаДопустимо = ИмяПоляДопустимо(ПолеИзXDTO)
				И (Не ЭтоСсылка Или ИмяПоляЕстьВМетаданных(ИмяТаблицы, ПолеПоиска));
			
			Если Не ПолеПоискаДопустимо Тогда
				
				Поле = "Неопределено";
				
			Иначе
				
				Если СтрНайти(ТекстЗапроса, "&" + ПолеИзXDTO) = 0 Тогда
					
					ДобавитьПолеВЗапросПриЗагрузке(ТекстЗапроса, ПолеИзXDTO);
					
				КонецЕсли;
				
				Если ЭтоСтандартнаяДата(ЗначениеПараметра) Тогда
					
					ЗначениеПараметра = XMLЗначение(Тип("Дата"), ЗначениеПараметра);
					Поле = "ВТ_Данные." + ПолеИзXDTO;
					
				ИначеЕсли Не ЭтоСсылка Тогда
					
					Поле = "ВТ_Данные." + ПолеИзXDTO;
					
				Иначе
					
					Поле = ДополнитьЗапросПоПолюПоискаКонкатенация(ТекстЗапроса, ПолеИзXDTO,
						ПолеПоиска, ИмяТаблицы, "ВТ_Данные", 1, ИндексОператора, Ложь);
					
				КонецЕсли;
				
				ЗначенияПараметров.Вставить(ПолеИзXDTO, ОбъектXDTO[ПолеИзXDTO]);
				
			КонецЕсли;
		КонецЕсли;
		
		Если Сч = 0 Тогда
			Если Сч = ПоляПоиска.ВГраница() Тогда
				Условие = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(ПервоеУсловие, Поле, "Неопределено");
			Иначе
				Условие = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(ПервоеУсловие, Поле, "%1");
			КонецЕсли;
		ИначеЕсли Сч = ПоляПоиска.ВГраница() Тогда
			ВремУсловие = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(ПервоеУсловие, Поле, "Неопределено");
			Условие = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(Условие, ВремУсловие);
		Иначе
			ВремУсловие = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(ПервоеУсловие, Поле, "%1");
			Условие = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(Условие, ВремУсловие, "%1");
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Условие;
	
КонецФункции

Функция ПолучитьТекстЗапросаРеквизитовОбъекта_ПоУмолчанию(ТекстЗапроса, ЭтоGUID,
			ИмяРеквизита, ИндексОператора, ПроверяемыйТип, ЗначенияПараметров, ЗначениеПараметра)
	
	ЭтоСсылка = пбп_Переадресация.ЭтоСсылка(ПроверяемыйТип);
	
	Если ЭтоСсылка Тогда
		МетаданныеОбъект = Метаданные.НайтиПоТипу(ПроверяемыйТип);
		ИмяТаблицы = МетаданныеОбъект.ПолноеИмя();
		
		Менеджер = пбп_Переадресация.МенеджерОбъектаПоПолномуИмени(ИмяТаблицы);
	КонецЕсли;
	
	Если ЭтоСсылка И Не ЭтоGUID Тогда
		Если ЗначениеЗаполнено(ЗначениеПараметра) Тогда
			Если ОбъектМетаданныхЯвляетсяПеречислением(МетаданныеОбъект)
				И МетаданныеОбъект.ЗначенияПеречисления.Найти(ЗначениеПараметра) <> Неопределено Тогда
				
				ЗначениеПараметра = Менеджер[ЗначениеПараметра];
				
			ИначеЕсли ИмяПредопределенногоДоступно(МетаданныеОбъект, ЗначениеПараметра) Тогда
				
				ЗначениеПараметра = Менеджер[ЗначениеПараметра];
				
			Иначе
				
				ЗначениеПараметра = Менеджер.ПустаяСсылка();
				
			КонецЕсли;
		Иначе
			ЗначениеПараметра = Менеджер.ПустаяСсылка();
		КонецЕсли;
		Поле = "ВТ_Данные." + ИмяРеквизита;
	ИначеЕсли ЭтоСтандартнаяДата(ЗначениеПараметра) Тогда
		ЗначениеПараметра = XMLЗначение(Тип("Дата"), ЗначениеПараметра);
		Поле = "ВТ_Данные." + ИмяРеквизита;
	ИначеЕсли Не ЭтоСсылка Тогда
		Поле = "ВТ_Данные." + ИмяРеквизита;
	Иначе
		Поле = ДополнитьЗапросСсылочнымПолемКонкатенация(ТекстЗапроса,
			ИмяРеквизита, ИмяТаблицы, "ВТ_Данные", 1, ИндексОператора);
	КонецЕсли;
	
	ЗначенияПараметров.Вставить(ИмяРеквизита, ЗначениеПараметра);
	
	Возврат Поле;
	
КонецФункции

Функция ДополнитьЗапросСсылочнымПолем(ТекстЗапроса, ИмяРеквизита, ИмяТаблицы,
		ПсевдонимИсточника,
		ИндексЗапросаВПакете,
		ИндексОператора,
		ПроверятьНаNull = Истина)
	
	ШаблонСсылочногоПоля = "ЕСТЬNULL(%1.Ссылка, ЗНАЧЕНИЕ(%2.ПустаяССылка))";
	
	ШаблонСоединения = "(УНИКАЛЬНЫЙИДЕНТИФИКАТОР(%1.Ссылка) = %2.%3)";
	
	Части = СтрРазделить(ИмяТаблицы, ".");
	
	ПсевдонимТаблицы = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку("%1_%2", Части[1], ИмяРеквизита);
	Поле = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
		ШаблонСсылочногоПоля,
		ПсевдонимТаблицы,
		ИмяТаблицы);
	Если Не ПроверятьНаNull Тогда
		ШаблонСсылочногоПоля = "%1.Ссылка";
		Поле = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
			ШаблонСсылочногоПоля,
			ПсевдонимТаблицы);
	КонецЕсли;
	
	ОписаниеТаблицы = 
		пбп_СхемыЗапросов.ОписаниеТаблицы(
			Тип("ТаблицаСхемыЗапроса"),
			ИмяТаблицы,
			ПсевдонимТаблицы,
			"Ссылка");
	
	Условие = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСоединения, ПсевдонимТаблицы, ПсевдонимИсточника, ИмяРеквизита);
	ОписаниеСоединения =
		пбп_СхемыЗапросов.ОписаниеСоединения(
			ОписаниеТаблицы,
			Условие,
			ТипСоединенияСхемыЗапроса.ЛевоеВнешнее);
	
	ТекстЗапроса =
		пбп_СхемыЗапросов.ДобавитьСоединениеВЗапрос(
			ТекстЗапроса,
			ПсевдонимИсточника,
			ОписаниеСоединения,
			ИндексЗапросаВПакете);
			
	Возврат Поле;
	
КонецФункции

Функция ДополнитьЗапросСсылочнымПолемКонкатенация(ТекстЗапроса, ИмяРеквизита, ИмяТаблицы,
		ПсевдонимИсточника,
		ИндексЗапросаВПакете,
		ИндексОператора,
		ПроверятьНаNull = Истина,
		ТипДанных = Неопределено)
	
	ШаблонСсылочногоПоля = "ЕСТЬNULL(%1.Ссылка, ЗНАЧЕНИЕ(%2.ПустаяССылка))";
	
	ШаблонСоединения = "(УНИКАЛЬНЫЙИДЕНТИФИКАТОР(%1.Ссылка) = %2.%3)";
	
	Части = СтрРазделить(ИмяТаблицы, ".");
	
	ПсевдонимТаблицы = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку("%1_%2", Части[1], ИмяРеквизита);
	Поле = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
		ШаблонСсылочногоПоля,
		ПсевдонимТаблицы,
		ИмяТаблицы);
	Если Не ПроверятьНаNull Тогда
		ШаблонСсылочногоПоля = "%1.Ссылка";
		Поле = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
			ШаблонСсылочногоПоля,
			ПсевдонимТаблицы);
	КонецЕсли;
	
	ОписаниеТаблицы = 
		пбп_СхемыЗапросов.ОписаниеТаблицы(
			Тип("ТаблицаСхемыЗапроса"),
			ИмяТаблицы,
			ПсевдонимТаблицы,
			"Ссылка");
	
	Условие = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСоединения, ПсевдонимТаблицы, ПсевдонимИсточника, ИмяРеквизита);
	ОписаниеСоединения =
		пбп_СхемыЗапросов.ОписаниеСоединения(
			ОписаниеТаблицы,
			Условие,
			ТипСоединенияСхемыЗапроса.ЛевоеВнешнее);
	
	//ТекстЗапроса =
	//	пбп_СхемыЗапросов.ДобавитьСоединениеВЗапрос(
	//		ТекстЗапроса,
	//		ПсевдонимИсточника,
	//		ОписаниеСоединения,
	//		ИндексОператора,
	//		ИндексЗапросаВПакете);
			
	// добавим соединение Конкатенацией, т.к у схемы есть баг при большом количестве соединений (Противоречивая связь)
	СоединениеТаблицы = СтрШаблон("%1 %2 КАК %3",
		ТипСоединенияСтрокой(ОписаниеСоединения.ТипСоединения),
		ОписаниеСоединения.ОписаниеТаблицы.ИмяТаблицы,
		ОписаниеСоединения.ОписаниеТаблицы.ПсевдонимТаблицы);
	
	УсловиеСоединения = СтрШаблон("ПО %1", ОписаниеСоединения.Условие);
	
	МассивСоединения = Новый Массив;
	МассивСоединения.Добавить(ТекстЗапроса);
	МассивСоединения.Добавить(СоединениеТаблицы);
	МассивСоединения.Добавить(УсловиеСоединения);
	
	// доп условие на заполненность строки
	Если Не ТипДанных = Неопределено
		И ТипДанных = Тип("Строка") Тогда
		
		МассивСоединения.Добавить(
			СтрШаблон(
				"И НЕ %1.%2 = """"",
				ОписаниеСоединения.ОписаниеТаблицы.ПсевдонимТаблицы,
				ИмяРеквизита
			)
		);
	КонецЕсли;
	
	ТекстЗапроса = СтрСоединить(МассивСоединения, Символы.ПС);
	
	Возврат Поле;
	
КонецФункции

Функция ДополнитьЗапросПоПолюПоиска(ТекстЗапроса, ИмяПоляОсновное, ИмяПоляПоиска, ИмяТаблицы,
		ПсевдонимИсточника,
		ИндексЗапросаВПакете,
		ИндексОператора,
		ПроверятьНаNull = Истина)
	
	ШаблонСсылочногоПоля = "ЕСТЬNULL(%1.Ссылка, ЗНАЧЕНИЕ(%2.ПустаяССылка))";
	
	ШаблонСоединения = "(%1.%2 = %3.%4)";
	
	Части = СтрРазделить(ИмяТаблицы, ".");
	
	ПсевдонимТаблицы = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку("%1_%2_%3", Части[1], ИмяПоляОсновное, СтрЗаменить(ИмяПоляПоиска, ".","_"));
	Поле = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
		ШаблонСсылочногоПоля,
		ПсевдонимТаблицы,
		ИмяТаблицы);
	Если Не ПроверятьНаNull Тогда
		ШаблонСсылочногоПоля = "%1.Ссылка";
		Поле = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
			ШаблонСсылочногоПоля,
			ПсевдонимТаблицы);
	КонецЕсли;
	
	ОписаниеТаблицы = 
		пбп_СхемыЗапросов.ОписаниеТаблицы(
			Тип("ТаблицаСхемыЗапроса"),
			ИмяТаблицы,
			ПсевдонимТаблицы,
			"Ссылка," + ИмяПоляПоиска);
	
	Условие = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСоединения,
		ПсевдонимТаблицы,
		ИмяПоляПоиска,
		ПсевдонимИсточника,
		ИмяПоляОсновное);
	ОписаниеСоединения =
		пбп_СхемыЗапросов.ОписаниеСоединения(
			ОписаниеТаблицы,
			Условие,
			ТипСоединенияСхемыЗапроса.ЛевоеВнешнее);
	
	ТекстЗапроса =
		пбп_СхемыЗапросов.ДобавитьСоединениеВЗапрос(
			ТекстЗапроса,
			ПсевдонимИсточника,
			ОписаниеСоединения,
			ИндексЗапросаВПакете);
			
	Возврат Поле;
	
КонецФункции

Функция ДополнитьЗапросПоПолюПоискаКонкатенация(ТекстЗапроса, ИмяПоляОсновное, ИмяПоляПоиска, ИмяТаблицы,
		ПсевдонимИсточника,
		ИндексЗапросаВПакете,
		ИндексОператора,
		ПроверятьНаNull = Истина)
	
	Если Не ИмяПоляДопустимо(ИмяПоляОсновное)
		Или Не ИмяПоляДопустимо(ИмяПоляПоиска)
		Или Не ИмяПоляЕстьВМетаданных(ИмяТаблицы, ИмяПоляПоиска) Тогда
		
		Возврат "Неопределено";
		
	КонецЕсли;
	
	ШаблонСсылочногоПоля = "ЕСТЬNULL(%1.Ссылка, ЗНАЧЕНИЕ(%2.ПустаяССылка))";
	ШаблонСоединения = "(%1.%2 = %3.%4)";
	
	Части = СтрРазделить(ИмяТаблицы, ".");
	
	ПсевдонимТаблицы = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку("%1_%2_%3", Части[1], ИмяПоляОсновное, ИмяПоляПоиска);
	Поле = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
		ШаблонСсылочногоПоля,
		ПсевдонимТаблицы,
		ИмяТаблицы);
	Если Не ПроверятьНаNull Тогда
		ШаблонСсылочногоПоля = "%1.Ссылка";
		Поле = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
			ШаблонСсылочногоПоля,
			ПсевдонимТаблицы);
	КонецЕсли;
	
	ОписаниеТаблицы = 
		пбп_СхемыЗапросов.ОписаниеТаблицы(
			Тип("ТаблицаСхемыЗапроса"),
			ИмяТаблицы,
			ПсевдонимТаблицы,
			"Ссылка," + ИмяПоляПоиска);
	
	Условие = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСоединения,
		ПсевдонимТаблицы,
		ИмяПоляПоиска,
		ПсевдонимИсточника,
		ИмяПоляОсновное);
	ОписаниеСоединения =
		пбп_СхемыЗапросов.ОписаниеСоединения(
			ОписаниеТаблицы,
			Условие,
			ТипСоединенияСхемыЗапроса.ЛевоеВнешнее);
	
	//ТекстЗапроса =
	//	пбп_СхемыЗапросов.ДобавитьСоединениеВЗапрос(
	//		ТекстЗапроса,
	//		ПсевдонимИсточника,
	//		ОписаниеСоединения,
	//		ИндексОператора,
	//		ИндексЗапросаВПакете);
	
	// добавим соединение Конкатенацией, т.к у схемы есть баг при большом количестве соединений (Противоречивая связь)
	СоединениеТаблицы = СтрШаблон("%1 %2 КАК %3",
		ТипСоединенияСтрокой(ОписаниеСоединения.ТипСоединения),
		ОписаниеСоединения.ОписаниеТаблицы.ИмяТаблицы,
		ОписаниеСоединения.ОписаниеТаблицы.ПсевдонимТаблицы);
	
	УсловиеСоединения = СтрШаблон("ПО %1", ОписаниеСоединения.Условие);
	
	МассивСоединения = Новый Массив;
	МассивСоединения.Добавить(ТекстЗапроса);
	МассивСоединения.Добавить(СоединениеТаблицы);
	МассивСоединения.Добавить(УсловиеСоединения);
	
	// доп условие на заполненность строки
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ОписаниеСоединения.ОписаниеТаблицы.ИмяТаблицы);
	ПараметрыРеквизита = ОбъектМетаданных.Реквизиты.Найти(ИмяПоляПоиска);
	Если Не ПараметрыРеквизита = Неопределено
		И ПараметрыРеквизита.Тип.Типы().Количество() = 1
		И ПараметрыРеквизита.Тип.Типы()[0] = Тип("Строка") Тогда
		
		МассивСоединения.Добавить(
			СтрШаблон(
				"И НЕ %1.%2 = """"",
				ОписаниеСоединения.ОписаниеТаблицы.ПсевдонимТаблицы,
				ИмяПоляПоиска
			)
		);
	КонецЕсли;
	
	ТекстЗапроса = СтрСоединить(МассивСоединения, Символы.ПС);
	
	Возврат Поле;
	
КонецФункции

Функция КонтекстЗаполненияОбъектаПоОбъектуXDTO(Поток)
	
	Контекст = Новый Структура("ПоляИсключения,
		|СоответствиеПолейИсточникаИПриемника,СоответствиеТиповПолей,ПоляПоиска");
	
	Контекст.ПоляИсключения = ПоляНеОбрабатываемыеУниверсальнойЗагрузкой(Поток);
	Контекст.СоответствиеПолейИсточникаИПриемника = СоответствиеПолейИсточникаИПриемника(Поток);
	Контекст.СоответствиеТиповПолей = СформироватьСоответствиеТиповПолей(Поток);
	Контекст.ПоляПоиска = СформироватьПоляПоиска(Поток);
	
	Возврат Контекст;
	
КонецФункции

Функция ПодготовитьСтруктуруПоискаСсылки(КонтекстЗаполнения, ОбъектXDTO, СсылкаИзXDTO)
	
	СвойстваXDTO = ОбъектXDTO.Свойства();

	ПоляПоискаСсылки = КонтекстЗаполнения.ПоляПоиска["Ссылка"];
	СтруктураПоиска = Новый Соответствие;
	Если ЗначениеЗаполнено(ПоляПоискаСсылки) Тогда
		ПИ = ИмяПоляПоискаПоПубличномуИдентификатору();
		ВИ = ИмяПоляПоискаПоВнутреннемуИдентификатору();
		Для Каждого Поле Из ПоляПоискаСсылки Цикл
			Если Поле = ПИ Тогда
				СтруктураПоиска.Вставить(Поле, СсылкаИзXDTO);

			ИначеЕсли Поле = ВИ Тогда

				ПолеПоискаВИ = "Ссылка";

				Значение = ПолучитьЗначениеИзСоответствияИсточникаИПриемника(
				КонтекстЗаполнения.СоответствиеПолейИсточникаИПриемника, ПолеПоискаВИ);
				ИмяИзИсточника = ?(ЗначениеЗаполнено(Значение), Значение, Поле);

				СвойствоXDTO = СвойстваXDTO.Получить(ИмяИзИсточника);
				Если СвойствоXDTO <> Неопределено Тогда
					СтруктураПоиска.Вставить(Поле, ОбъектXDTO[ИмяИзИсточника]);
				КонецЕсли;

			Иначе
				Значение = ПолучитьЗначениеИзСоответствияИсточникаИПриемника(
				КонтекстЗаполнения.СоответствиеПолейИсточникаИПриемника, Поле);
				ИмяИзИсточника = ?(ЗначениеЗаполнено(Значение), Значение, Поле);

				СвойствоXDTO = СвойстваXDTO.Получить(ИмяИзИсточника);
				Если СвойствоXDTO <> Неопределено Тогда
					СтруктураПоиска.Вставить(Поле, ОбъектXDTO[ИмяИзИсточника]);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат СтруктураПоиска;
	
КонецФункции

Процедура ЗаполнитьИсточникОбъекта(ОбъектОбработки, Узел)
	
	Если Не пбп_ПереадресацияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ОбъектОбработки, "ЗагруженоИз")
		Или Не ЗначениеЗаполнено(Узел) Тогда
		
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ДобавитьРеквизитСоставногоТипыВЗапросТЧ(КоллекцияXDTO, ТЗ, ТекстЗапроса,
	СтруктураПоля, 
	ИмяИзИсточника, 
	ТипыПоля,  
	ЧастиЗапроса,
	Реквизит,
	СоответствиеПоТЧ,
	СоответствиеПолей,
	СоответствиеТиповПолей)
	
	ШаблонСсылочногоПоля = "ЕСТЬNULL(%1.Ссылка, ЗНАЧЕНИЕ(%2.ПустаяССылка))";
	ШаблонВыбора = "КОГДА НЕ %1 ЕСТЬ NULL ТОГДА
	|%1";
	ШаблонКонцаВыбора = "ИНАЧЕ ДанныеТЧ.%1
	|КОНЕЦ";
	ШаблонКонцаВыбораСтрока = "ИНАЧЕ ВЫРАЗИТЬ(ДанныеТЧ.%1 КАК СТРОКА(1024))
	|КОНЕЦ";
	ШаблонСсылочногоПоляБезПроверкиNull = "%1.Ссылка";
	ШаблонСоединения = "ЛЕВОЕ СОЕДИНЕНИЕ %1 КАК %2
	| ПО (УНИКАЛЬНЫЙИДЕНТИФИКАТОР(%2.Ссылка) = ДанныеТЧ.%3)";
	
	МассивТипов = Новый Массив;
	
	мВыбора = Новый Массив;
	мВыбора.Добавить("ВЫБОР");
	Для Каждого ПроверяемыйТип Из ТипыПоля Цикл
		
		ЭтоСсылка = пбп_Переадресация.ЭтоСсылка(ПроверяемыйТип);
		
		Мета = Неопределено;
		Если ЭтоСсылка Тогда
			Мета = Метаданные.НайтиПоТипу(ПроверяемыйТип);
			СтруктураПоля.Мета = Мета;
		КонецЕсли;

		Если Мета <> Неопределено И ОбъектМетаданныхЯвляетсяПеречислением(Мета) Или Не ЭтоСсылка Тогда
			Поле = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку("ДанныеТЧ.%1", ИмяИзИсточника);
		Иначе
			
			ЛокальныеПоляПоиска = ОпределитьПоляПоискаПоТипуРеквизита(ПроверяемыйТип);
			
			ДанныеДобавленногоПоля = ДобавитьРеквизитВЗапросТЧ(КоллекцияXDTO, ТЗ, ТекстЗапроса,
				СтруктураПоля, 
				ИмяИзИсточника, 
				ПроверяемыйТип, 
				ЛокальныеПоляПоиска, 
				ЧастиЗапроса,
				Реквизит,
				СоответствиеПоТЧ,
				СоответствиеПолей,
				СоответствиеТиповПолей);
			
			Поле = ДанныеДобавленногоПоля.Поле;
			Поле = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонВыбора, Поле);
			
			мВыбора.Добавить(Поле);
			
			Если Не ДанныеДобавленногоПоля.ТипКолонки = Неопределено Тогда
				Для Каждого ТекущийТип Из ДанныеДобавленногоПоля.ТипКолонки.Типы() Цикл
					Если МассивТипов.Найти(ТекущийТип) = Неопределено Тогда
						МассивТипов.Добавить(ТекущийТип);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ТипКолонки = Новый ОписаниеТипов(МассивТипов);
	Если МассивТипов.Количество() = 1
			И МассивТипов[0] = Тип("Строка") Тогда
		Поле = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонКонцаВыбораСтрока, ИмяИзИсточника);
	Иначе
		Поле = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонКонцаВыбора, ИмяИзИсточника);
	КонецЕсли;
	мВыбора.Добавить(Поле);
	
	Поле = СтрСоединить(мВыбора, Символы.ПС);
	
	СоответствиеТиповПолей.Вставить(ИмяИзИсточника, ТипКолонки);
	
	СтруктураРеквизита = Новый Структура;
	СтруктураРеквизита.Вставить("Поле", Поле);
	СтруктураРеквизита.Вставить("ТипКолонки", ТипКолонки);
	
	Возврат СтруктураРеквизита;
	
КонецФункции

Функция ДобавитьРеквизитВЗапросТЧ(КоллекцияXDTO, ТЗ, ТекстЗапроса,
	СтруктураПоля, 
	ИмяИзИсточника, 
	ПроверяемыйТип, 
	ПоляПоиска, 
	ЧастиЗапроса,
	Реквизит,
	СоответствиеПоТЧ,
	СоответствиеПолей,
	СоответствиеТиповПолей,
	ПроверятьНаNull = Ложь)
	
	ШаблонСсылочногоПоля = "ЕСТЬNULL(%1.Ссылка, ЗНАЧЕНИЕ(%2.ПустаяССылка))";
	ШаблонСсылочногоПоляБезПроверкиNull = "%1.Ссылка";
	ШаблонСоединения = "ЛЕВОЕ СОЕДИНЕНИЕ %1 КАК %2
	| ПО (УНИКАЛЬНЫЙИДЕНТИФИКАТОР(%2.Ссылка) = ДанныеТЧ.%3)";
	
	ЭтоСсылка = пбп_Переадресация.ЭтоСсылка(ПроверяемыйТип);
	
	Мета = Неопределено;
	Если ЭтоСсылка Тогда
		Мета = Метаданные.НайтиПоТипу(ПроверяемыйТип);
		СтруктураПоля.Мета = Мета;
	КонецЕсли;
	
	ВнешнИД = ИмяПоляПоискаПоПубличномуИдентификатору();
	ВнутрИД = ИмяПоляПоискаПоВнутреннемуИдентификатору();
	
	Если ПоляПоиска <> Неопределено Тогда
		
		Если ЭтоСсылка Тогда
			ИмяТаблицы = Метаданные.НайтиПоТипу(ПроверяемыйТип).ПолноеИмя();
			Менеджер = пбп_Переадресация.МенеджерОбъектаПоПолномуИмени(ИмяТаблицы);
		КонецЕсли;

		ПоследнееУсловие = "ЕСТЬNULL(%1, NULL)";
		ПервоеУсловие = "ЕСТЬNULL(%1, %2)";
		ПоляСоответствия = СоответствиеПоТЧ[Реквизит.Имя];
		Для Сч = 0 По ПоляПоиска.ВГраница() Цикл
			ПолеПоиска = ПоляПоиска[Сч];
			
			Если ПолеПоиска = ВнешнИД Тогда
				
				ОписаниеРегистра = ОписаниеРегистраПубличныхИдентификаторов();
				
				Если ОписаниеРегистра.Использовать Тогда
					
					ИмяРеквизитаПоиска = ИмяИзИсточника + "_Строка";
					ИмяПоля = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку("Данные.%1", ИмяРеквизитаПоиска);
					ДобавитьПолеВЗапросПриЗагрузке(ТекстЗапроса, ИмяПоля, "Данные");
					Поле = ДополнитьЗапросДаннымиПоПубличномуИдентификаторуКонкатенация(
						ТекстЗапроса, ИмяРеквизитаПоиска, ИмяТаблицы, "ДанныеТЧ", ПроверятьНаNull);
					ТипКолонки = пбп_Переадресация.ОписаниеТипаСтрока(ОписаниеРегистра.ДлинаИдентификатора);
					СоответствиеПолей.Вставить(ИмяРеквизитаПоиска, ИмяИзИсточника);
					СоответствиеТиповПолей.Вставить(ИмяРеквизитаПоиска, ТипКолонки);
					
				Иначе
					
					Поле = "Неопределено";
					
				КонецЕсли;
				
			ИначеЕсли ПолеПоиска = ВнутрИД 
				И Мета <> Неопределено И Не ОбъектМетаданныхЯвляетсяПеречислением(Мета) 
				И ЭтоСсылка Тогда
				
				Поле = ДополнитьЗапросСсылочнымПолемКонкатенация(ТекстЗапроса, ИмяИзИсточника, ИмяТаблицы, "ДанныеТЧ", 1, 0, ПроверятьНаNull, ПроверяемыйТип);
				ТипКолонки = Новый ОписаниеТипов("УникальныйИдентификатор");
				
				СоответствиеПолей.Вставить(ИмяИзИсточника, ИмяИзИсточника);
				СоответствиеТиповПолей.Вставить(ИмяИзИсточника, ТипКолонки);
				
			ИначеЕсли ПолеПоиска = "email" Тогда
				Поле = "Неопределено";
				
			Иначе
				Если ПоляСоответствия = Неопределено Тогда
					ПолеИзXDTO = Реквизит.Имя;
				Иначе
					ПолеИзXDTO = ПоляСоответствия[ПолеПоиска];
				КонецЕсли;

				Часть = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку("Данные.%1", ПолеИзXDTO);

				Если СтрНайти(ТекстЗапроса, ПолеИзXDTO) = 0 Тогда
					//ТекстЗапроса = пбп_СхемыЗапросов.ДобавитьПолеВыборкиВЗапрос(ТекстЗапроса, Часть, , 0);
					ДобавитьПолеВЗапросПриЗагрузке(ТекстЗапроса, Часть, "Данные");
				КонецЕсли;
				// 

				Если Не ЭтоСсылка Тогда
					Поле = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку("ДанныеТЧ.%1", ПолеИзXDTO);
				Иначе
					Поле = ДополнитьЗапросПоПолюПоискаКонкатенация(ТекстЗапроса, ПолеИзXDTO, ПолеПоиска, ИмяТаблицы, "ДанныеТЧ", 1, 0, ПроверятьНаNull);
				КонецЕсли;
				мТипов = Новый Массив;
				мТипов.Добавить(ТипЗнч(КоллекцияXDTO[0].Получить(ПолеИзXDTO)));

				Если ТЗ.Колонки.Найти(ПолеИзXDTO) = Неопределено ТОгда 
					ТЗ.Колонки.Добавить(ПолеИзXDTO, Новый ОписаниеТипов(мТипов,,,Новый КвалификаторыЧисла(10, 2),Новый КвалификаторыСтроки(50)));
				КонецЕсли;
				
				СоответствиеПолей.Вставить(ПолеИзXDTO, ПолеИзXDTO);
			КонецЕсли;

			Если Сч = 0 Тогда
				Если Сч = ПоляПоиска.ВГраница() Тогда
					Условие = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(ПервоеУсловие, Поле, "%1"); 
					Условие = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(Условие, "NULL");
				Иначе
					Условие = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(ПервоеУсловие, Поле, "%1");
				КонецЕсли;
				
			ИначеЕсли Сч = ПоляПоиска.ВГраница() Тогда
				ВремУсловие = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(ПервоеУсловие, Поле, "NULL");
				Условие = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(Условие, ВремУсловие);
			Иначе
				ВремУсловие = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(ПервоеУсловие, Поле, "%1");
				Условие = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(Условие, ВремУсловие, "%1");
			КонецЕсли;
			
		КонецЦикла;
		Поле = Условие;
		СоответствиеПоТЧ.Вставить(ИмяИзИсточника, СоответствиеПолей);
	Иначе
		ТипРеквизита = Реквизит.Тип.Типы()[0];
		ЭтоСсылка = пбп_Переадресация.ЭтоСсылка(ТипРеквизита);
 		
		ТипКолонки = Реквизит.Тип;
		Если Мета <> Неопределено И ОбъектМетаданныхЯвляетсяПеречислением(Мета)
			Или Не ЭтоСсылка Тогда
			Поле = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку("ДанныеТЧ.%1", ИмяИзИсточника);
		Иначе
			ИмяТаблицыИзРеквизита = Мета.ПолноеИмя();
			
			ТипКолонки = Новый ОписаниеТипов("УникальныйИдентификатор");
			
			Части = СтрРазделить(ИмяТаблицыИзРеквизита, ".");
			
			ПсевдонимТаблицы = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку("%1_%2", Части[1], ИмяИзИсточника);
			Если ПроверятьНаNull Тогда
				Поле = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
					ШаблонСсылочногоПоля,
					ПсевдонимТаблицы,
					ИмяТаблицыИзРеквизита);
			Иначе
				Поле = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(
					ШаблонСсылочногоПоляБезПроверкиNull,
					ПсевдонимТаблицы);
			КонецЕсли;
			
			Условие = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСоединения,
				ИмяТаблицыИзРеквизита,
				ПсевдонимТаблицы,
				ИмяИзИсточника);
			ЧастиЗапроса.Добавить(Условие);
			//КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	СтруктураРеквизита = Новый Структура;
	СтруктураРеквизита.Вставить("Поле", Поле);
	СтруктураРеквизита.Вставить("ТипКолонки", ТипКолонки);
	
	Возврат СтруктураРеквизита;
	
КонецФункции

Функция ОпределитьПоляПоискаПоТипуРеквизита(ТипПоля)
	
	ПоляПоиска = Неопределено;
	
	ЭтоСсылка = пбп_Переадресация.ЭтоСсылка(ТипПоля);
	
	ЭтоПеречисление = Ложь;
	Если ЭтоСсылка Тогда
		Мета = Метаданные.НайтиПоТипу(ТипПоля);
		ЭтоПеречисление = ОбъектМетаданныхЯвляетсяПеречислением(Мета);
	КонецЕсли;
	
	ПолеПоискаПИ = ИмяПоляПоискаПоПубличномуИдентификатору();
	ПолеПоискаВИ = ИмяПоляПоискаПоВнутреннемуИдентификатору();
	
	ПолеПоиска = ПолучитьИмяРеквизитаВыгрузкиУниверсально(ТипПоля);
	Если ЗначениеЗаполнено(ПолеПоиска) Тогда
		ПоляПоиска = пбп_ПереадресацияКлиентСервер.ЗначениеВМассиве(ПолеПоиска);
		// Если ищем по публичному иденртификатору, то дополнительно и по внутреннему
		Если ПолеПоиска = ПолеПоискаПИ Тогда
			ПоляПоиска.Добавить(ПолеПоискаВИ);
		КонецЕсли;
		
	ИначеЕсли ЭтоСсылка И Не ЭтоПеречисление Тогда
		ПоляПоиска = пбп_ПереадресацияКлиентСервер.ЗначениеВМассиве(ПолеПоискаПИ);
		ПоляПоиска.Добавить(ПолеПоискаВИ);
	КонецЕсли;
	
	Возврат ПоляПоиска;
	
КонецФункции

Процедура ДобавитьПолеВыборкиВЗапрос(ТекстЗапроса, Выражение, ВыражениеПоля, ПолеЗапросаКлюча, КлючевоеПоле, СтрокаЗамены)
	
	Если СтрНачинаетсяС(ВыражениеПоля, "ЕСТЬNULL(")
		Или СтрНачинаетсяС(ВыражениеПоля, "ВЫРАЗИТЬ(") Тогда
		ШаблонПоля = "%1 КАК %2";
	Иначе
		ШаблонПоля = "Данные.%1 КАК %2";
	КонецЕсли;
	
	ТекстПоля = СтрШаблон(ШаблонПоля, ВыражениеПоля, Выражение.Псевдоним);
	
	// если поле уже добавлено в выборку, то не добавляем
	// при ручном объявлении полей могут случайно задублить
	Если Не СтрНайти(ТекстЗапроса, ТекстПоля) = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если КлючевоеПоле = Выражение.Значение Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ПолеЗапросаКлюча, ТекстПоля);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, СтрокаЗамены,
		",
		|	" + ТекстПоля + СтрокаЗамены);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПоляПоискаПоУмолчанию(ПоляПоиска, ЭтоGUID, ПроверяемыйТип)
	
	ПолеПоискаПИ = ИмяПоляПоискаПоПубличномуИдентификатору();
	ПолеПоискаВИ = ИмяПоляПоискаПоВнутреннемуИдентификатору();
	
	ЭтоСсылка = пбп_Переадресация.ЭтоСсылка(ПроверяемыйТип);
	ПолеПоиска = ПолучитьИмяРеквизитаВыгрузкиУниверсально(ПроверяемыйТип);
	Если ЗначениеЗаполнено(ПолеПоиска) Тогда
		ПоляПоиска = пбп_ПереадресацияКлиентСервер.ЗначениеВМассиве(ПолеПоиска);
		// Если ищем по публичному иденртификатору, то дополнительно и по внутреннему
		Если ПолеПоиска = ПолеПоискаПИ Тогда
			ПоляПоиска.Добавить(ПолеПоискаВИ);
		КонецЕсли;
		
	ИначеЕсли ЭтоСсылка И ЭтоGUID Тогда
		ПоляПоиска = пбп_ПереадресацияКлиентСервер.ЗначениеВМассиве(ПолеПоискаПИ);
		ПоляПоиска.Добавить(ПолеПоискаВИ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьПоляВЗапросПриЗагрузке(ТекстЗапроса, СписокПолей, ЭтоТЧ = Ложь)
	
	Для Каждого ПолеЗапроса Из СписокПолей Цикл
		ДобавитьПолеВЗапросПриЗагрузке(ТекстЗапроса,
			ПолеЗапроса.Значение, "ДанныеТЧ", ПолеЗапроса.Представление);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьПолеВЗапросПриЗагрузке(ТекстЗапроса, ВыражениеПоля, ИмяТаблицы = "", Представление = "")
	
	Если Не ПустаяСтрока(ИмяТаблицы) Тогда
		ЗаглушкаСтрока = ИмяТаблицы + ".ИмяТабличнойЧасти КАК ИмяТабличнойЧасти";
	Иначе
		ЗаглушкаСтрока = "&Заглушка КАК Заглушка";
	КонецЕсли;
	
	Если Не ПустаяСтрока(Представление) Тогда
		СинонимПоля = Представление;
	ИначеЕсли Не ПустаяСтрока(ИмяТаблицы) Тогда
		СинонимПоля = СтрЗаменить(ВыражениеПоля, ИмяТаблицы + ".", "");
	Иначе
		СинонимПоля = ВыражениеПоля;
	КонецЕсли;
	
	ПолеЗапроса = СтрШаблон("%1 КАК %2,
		|	%3",
		?(Не ПустаяСтрока(ИмяТаблицы), ВыражениеПоля, "&" + ВыражениеПоля),
		СинонимПоля,
		ЗаглушкаСтрока);
	
	Если Не СтрНайти(ТекстЗапроса, ПолеЗапроса) = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ЗаглушкаСтрока, ПолеЗапроса);
	
КонецПроцедуры

Процедура ДобавитьЗначенияПоляССоединениямиВЗапросРеквизитовОбъекта(ТекстЗапроса, ИмяРеквизита, Поле)
	
	ЗаглушкаСтрока = "ВЫБРАТЬ
	|	ВТ_Данные.Заглушка Как Заглушка,
	|	NULL КАК ИмяРеквизита,
	|	NULL КАК Значение
	|ИЗ
	|	ВТ_Данные КАК ВТ_Данные";
	
	РеквизитСтрокой = пбп_ПереадресацияКлиентСервер.ПодставитьПараметрыВСтроку("""%1""", ИмяРеквизита);
	
	ТекстЗамены = СтрШаблон("ВЫБРАТЬ
	|	ВТ_Данные.Заглушка Как Заглушка,
	|	%1 КАК ИмяРеквизита,
	|	%2 КАК Значение
	|ИЗ
	|	ВТ_Данные КАК ВТ_Данные", РеквизитСтрокой, Поле);
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ЗаглушкаСтрока, ТекстЗамены);
	
КонецПроцедуры

