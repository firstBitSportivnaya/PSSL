#Область ПрограммныйИнтерфейс

// При установке нового номера
//
// Параметры:
//  Источник			 - ДокументОбъект, БизнесПроцессОбъект, ЗадачаОбъект - источник подписки на событие
//  СтандартнаяОбработка - Булево	 - стандартная обработка
//  Префикс				 - Строка	 - префикс, который будет использоваться при генерации номера
//
Процедура ПриУстановкеНовогоНомера(Источник, СтандартнаяОбработка, Префикс) Экспорт
	
	Событие = "ПриУстановкеНовогоНомера";
	ИмяМетода = ПолучитьИмяМетода(Источник, Событие);
	
	ПриУстановкеНовогоКодаИлиНомера(ИмяМетода, Источник, СтандартнаяОбработка, Префикс);
	
КонецПроцедуры

// При установке нового кода
//
// Параметры:
//  Источник			 - СправочникОбъект, ПланВидовХарактеристикОбъект, ПланОбменаОбъект - источник подписки на событие
//  СтандартнаяОбработка - Булево	 - стандартная обработка
//  Префикс				 - Строка	 - префикс, который будет использоваться при генерации номера
//
Процедура ПриУстановкеНовогоКода(Источник, СтандартнаяОбработка, Префикс) Экспорт
	
	Событие = "ПриУстановкеНовогоКода";
	ИмяМетода = ПолучитьИмяМетода(Источник, Событие);
	
	ПриУстановкеНовогоКодаИлиНомера(ИмяМетода, Источник, СтандартнаяОбработка, Префикс);
	
КонецПроцедуры

// При копировании
//
// Параметры:
//  Источник			 - СправочникОбъект, ДокументОбъект, ПланВидовХарактеристикОбъект, ПланСчетовОбъект,
// ПланВидовРасчетаОбъект, ПланОбменаОбъект, БизнесПроцессОбъект, ЗадачаОбъект - источник подписки на событие
//  ОбъектКопирования	 - СправочникОбъект, ДокументОбъект, ПланВидовХарактеристикОбъект, ПланСчетовОбъект,
// ПланВидовРасчетаОбъект, ПланОбменаОбъект, БизнесПроцессОбъект, ЗадачаОбъект - исходный элемент для копирования
//
Процедура ПриКопировании(Источник, ОбъектКопирования) Экспорт
	
	Событие = "ПриКопировании";
	ИмяМетода = ПолучитьИмяМетода(Источник, Событие);
	
	Если ЗначениеЗаполнено(ИмяМетода) Тогда
		Попытка
			ПараметрыМетода = Новый Массив;
			ПараметрыМетода.Добавить(Источник);
			ПараметрыМетода.Добавить(ОбъектКопирования);
			
			пбп_Переадресация.ВыполнитьМетодКонфигурации(ИмяМетода, ПараметрыМетода);
		Исключение
			ВызватьИсключение ПолучитьТекстОшибки(ИмяМетода, ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

// Обработка заполнения
//
// Параметры:
//  Источник			 - СправочникОбъект, ДокументОбъект, ПланВидовХарактеристикОбъект, ПланСчетовОбъект,
// ПланВидовРасчетаОбъект, ПланОбменаОбъект, БизнесПроцессОбъект, ЗадачаОбъект, РегистрСведенийНаборЗаписей - источник подписки на событие
//  ДанныеЗаполнения	 - Произвольный		 - данные заполнения
//  Параметр3			 - Строка, Булево	 - текст заполнения или стандартная обработка для регистра сведений
//  Параметр4			 - Булево			 - стандартная обработка - отсутствует для регистре сведений
//
Процедура ОбработкаЗаполнения(Источник, ДанныеЗаполнения, Параметр3, Параметр4 = Неопределено) Экспорт
	
	Событие = "ОбработкаЗаполнения";
	ИмяМетода = ПолучитьИмяМетода(Источник, Событие);
	
	Если ЗначениеЗаполнено(ИмяМетода) Тогда
		Попытка
			ПараметрыМетода = Новый Массив;
			ПараметрыМетода.Добавить(Источник);
			ПараметрыМетода.Добавить(ДанныеЗаполнения);
			ПараметрыМетода.Добавить(Параметр3); // текст заполнения или стандартная обработка
			Если Параметр4 <> Неопределено Тогда
				ПараметрыМетода.Добавить(Параметр4); // стандартная обработка
			КонецЕсли;
			
			пбп_Переадресация.ВыполнитьМетодКонфигурации(ИмяМетода, ПараметрыМетода);
			
			Источник			= ПараметрыМетода[0];
			ДанныеЗаполнения	= ПараметрыМетода[1];
			Параметр3			= ПараметрыМетода[2];
			Если Параметр4 <> Неопределено Тогда
				Параметр4		= ПараметрыМетода[3];
			КонецЕсли;
		Исключение
			ВызватьИсключение ПолучитьТекстОшибки(ИмяМетода, ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

// Перед записью
//
// Параметры:
//  Источник	 - СправочникОбъект, КонстантаМенеджерЗначения, ДокументОбъект, ПланВидовХарактеристикОбъект,
// ПланСчетовОбъект, ПланВидовРасчетаОбъект, ПланОбменаОбъект, БизнесПроцессОбъект, ЗадачаОбъект,
// РегистрСведенийНаборЗаписей, РегистрНакопленияНаборЗаписей, РегистрБухгалтерииНаборЗаписей,
// РегистрРасчетаНаборЗаписей, ПоследовательностьНаборЗаписей - источник подписки на событие
//  Отказ		 - Булево							 - отказ
//  Параметр3	 - РежимЗаписиДокумента, Булево		 - режим записи документа или Замещение для наборов записей
//  Параметр4	 - РежимПроведенияДокумента, Булево	 - режим проведения документа или ТолькоЗапись для РегистрРасчетаНаборЗаписей
//  Параметр5	 - Булево							 - ЗаписьФактическогоПериодаДействия для РегистрРасчетаНаборЗаписей
//  Параметр6	 - Булево							 - ЗаписьПерерасчетов для РегистрРасчетаНаборЗаписей
//
Процедура ПередЗаписью(Источник, Отказ, Параметр3 = Неопределено,
	Параметр4 = Неопределено, Параметр5 = Неопределено, Параметр6 = Неопределено) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Событие = "ПередЗаписью";
	ИмяМетода = ПолучитьИмяМетода(Источник, Событие);
	
	ПередЗаписьюПриЗаписи(ИмяМетода, Источник,
		Отказ, Параметр3, Параметр4, Параметр5, Параметр6);
	
КонецПроцедуры

// При записи
//
// Параметры:
//  Источник	 - СправочникОбъект, КонстантаМенеджерЗначения, ДокументОбъект, ПланВидовХарактеристикОбъект,
// ПланСчетовОбъект, ПланВидовРасчетаОбъект, ПланОбменаОбъект, БизнесПроцессОбъект, ЗадачаОбъект,
// РегистрСведенийНаборЗаписей, РегистрНакопленияНаборЗаписей, РегистрБухгалтерииНаборЗаписей,
// РегистрРасчетаНаборЗаписей, ПоследовательностьНаборЗаписей - источник подписки на событие
//  Отказ		 - Булево	 - отказ
//  Параметр3	 - Булево	 - Замещение для наборов записей
//  Параметр4	 - Булево	 - ТолькоЗапись для РегистрРасчетаНаборЗаписей
//  Параметр5	 - Булево	 - ЗаписьФактическогоПериодаДействия для РегистрРасчетаНаборЗаписей
//  Параметр6	 - Булево	 - ЗаписьПерерасчетов для РегистрРасчетаНаборЗаписей
//
Процедура ПриЗаписи(Источник, Отказ, Параметр3 = Неопределено,
	Параметр4 = Неопределено, Параметр5 = Неопределено, Параметр6 = Неопределено) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Событие = "ПриЗаписи";
	ИмяМетода = ПолучитьИмяМетода(Источник, Событие);
	
	ПередЗаписьюПриЗаписи(ИмяМетода, Источник,
		Отказ, Параметр3, Параметр4, Параметр5, Параметр6);
	
КонецПроцедуры

// Перед удалением
//
// Параметры:
//  Источник - СправочникОбъект, ДокументОбъект, ПланВидовХарактеристикОбъект, ПланСчетовОбъект,
// ПланВидовРасчетаОбъект, ПланОбменаОбъект, БизнесПроцессОбъект, ЗадачаОбъект - источник подписки на событие
//  Отказ	 - Булево	 - отказ
//
Процедура ПередУдалением(Источник, Отказ) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Событие = "ПередУдалением";
	ИмяМетода = ПолучитьИмяМетода(Источник, Событие);
	
	ВыполнитьСПараметрамиИсточникИОтказ(ИмяМетода, Источник, Отказ);
	
КонецПроцедуры

// Обработка проведения
//
// Параметры:
//  Источник		 - ДокументОбъект			 - источник подписки на событие
//  Отказ			 - Булево					 - отказ
//  РежимПроведения	 - РежимПроведенияДокумента	 - режим проведения документа
//
Процедура ОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	
	Событие = "ОбработкаПроведения";
	ИмяМетода = ПолучитьИмяМетода(Источник, Событие);
	
	Если ЗначениеЗаполнено(ИмяМетода) Тогда
		Попытка
			ПараметрыМетода = Новый Массив;
			ПараметрыМетода.Добавить(Источник);
			ПараметрыМетода.Добавить(Отказ);
			ПараметрыМетода.Добавить(РежимПроведения);
			
			пбп_Переадресация.ВыполнитьМетодКонфигурации(ИмяМетода, ПараметрыМетода);
			
			Источник = ПараметрыМетода[0];
			Если ПараметрыМетода[1] Тогда
				Отказ = Истина;
			КонецЕсли;
		Исключение
			ВызватьИсключение ПолучитьТекстОшибки(ИмяМетода, ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

// Обработка удаления проведения
//
// Параметры:
//  Источник		 - ДокументОбъект	 - источник подписки на событие
//  Отказ			 - Булево			 - отказ
//
Процедура ОбработкаУдаленияПроведения(Источник, Отказ) Экспорт
	
	Событие = "ПередУдалением";
	ИмяМетода = ПолучитьИмяМетода(Источник, Событие);
	
	ВыполнитьСПараметрамиИсточникИОтказ(ИмяМетода, Источник, Отказ);
	
КонецПроцедуры

// Обработка проверки заполнения
//
// Параметры:
//  Источник			 - СправочникОбъект, КонстантаМенеджерЗначения, ДокументОбъект, ПланВидовХарактеристикОбъект,
// ПланСчетовОбъект, ПланВидовРасчетаОбъект, ПланОбменаОбъект, БизнесПроцессОбъект, ЗадачаОбъект,
// РегистрСведенийНаборЗаписей, РегистрНакопленияНаборЗаписей, РегистрБухгалтерииНаборЗаписей,
// РегистрРасчетаНаборЗаписей, ПоследовательностьНаборЗаписей - источник подписки на событие
//  Отказ				 - Булево	 - отказ
//  ПроверяемыеРеквизиты - Массив	 - список проверяемых реквизитов
//
Процедура ОбработкаПроверкиЗаполнения(Источник, Отказ, ПроверяемыеРеквизиты) Экспорт
	
	Событие = "ОбработкаПроверкиЗаполнения";
	ИмяМетода = ПолучитьИмяМетода(Источник, Событие);
	
	Если ЗначениеЗаполнено(ИмяМетода) Тогда
		Попытка
			ПараметрыМетода = Новый Массив;
			ПараметрыМетода.Добавить(Источник);
			ПараметрыМетода.Добавить(Отказ);
			ПараметрыМетода.Добавить(ПроверяемыеРеквизиты);
			
			пбп_Переадресация.ВыполнитьМетодКонфигурации(ИмяМетода, ПараметрыМетода);
			
			Источник = ПараметрыМетода[0];
			Если ПараметрыМетода[1] Тогда
				Отказ = Истина;
			КонецЕсли;
			ПроверяемыеРеквизиты = ПараметрыМетода[2];
		Исключение
			ВызватьИсключение ПолучитьТекстОшибки(ИмяМетода, ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

// Обработка формирования по версии истории данных
//
// Параметры:
//  Источник		 - СправочникОбъект, КонстантаМенеджерЗначения, ДокументОбъект,
// ПланВидовХарактеристикОбъект, ПланСчетовОбъект, ПланВидовРасчетаОбъект, ПланОбменаОбъект,
// БизнесПроцессОбъект, ЗадачаОбъект, РегистрСведенийНаборЗаписей - источник подписки на событие
//  ДанныеВерсии	 - ФиксированнаяСтруктура				 - данные версии
//  НомерВерсии		 - Число								 - номер версии
//  Параметр4		 - РегистрСведенийКлючЗаписи, Массив	 - ключ записи для РегистрСведенийНаборЗаписей или исключить данные
//  Параметр5		 - Массив, Булево						 - исключить данные для РегистрСведенийНаборЗаписей или стандартная обработка
//  Параметр6		 - Булево								 - стандартная обработка для РегистрСведенийНаборЗаписей
//
Процедура ОбработкаФормированияПоВерсииИсторииДанных(Источник,
	ДанныеВерсии, НомерВерсии, Параметр4, Параметр5, Параметр6 = Неопределено) Экспорт
	
	Событие = "ОбработкаФормированияПоВерсииИсторииДанных";
	ИмяМетода = ПолучитьИмяМетода(Источник, Событие);
	
	Попытка
		ПараметрыМетода = Новый Массив;
		ПараметрыМетода.Добавить(Источник);
		ПараметрыМетода.Добавить(ДанныеВерсии);
		ПараметрыМетода.Добавить(НомерВерсии);
		ПараметрыМетода.Добавить(Параметр4);
		ПараметрыМетода.Добавить(Параметр5);
		Если Параметр6 <> Неопределено Тогда
			ПараметрыМетода.Добавить(Параметр6);
		КонецЕсли;
		
		пбп_Переадресация.ВыполнитьМетодКонфигурации(ИмяМетода, ПараметрыМетода);
		
		Источник		= ПараметрыМетода[0];
		ДанныеВерсии	= ПараметрыМетода[1];
		НомерВерсии		= ПараметрыМетода[2];
		Параметр4		= ПараметрыМетода[3];
		Параметр5		= ПараметрыМетода[4];
		Если Параметр6 <> Неопределено Тогда
			Параметр6	= ПараметрыМетода[5];
		КонецЕсли;
	Исключение
		ВызватьИсключение ПолучитьТекстОшибки(ИмяМетода, ОписаниеОшибки());
	КонецПопытки
	
КонецПроцедуры

// Обработка интерактивной активации
//
// Параметры:
//  Источник			 - БизнесПроцессОбъект, ЗадачаОбъект - источник подписки на событие
//  СтандартнаяОбработка - Булево							 - стандартная обработка
//
Процедура ОбработкаИнтерактивнойАктивации(Источник, СтандартнаяОбработка) Экспорт
	
	Событие = "ОбработкаИнтерактивнойАктивации";
	ИмяМетода = ПолучитьИмяМетода(Источник, Событие);
	
	Если ЗначениеЗаполнено(ИмяМетода) Тогда
		Попытка
			ПараметрыМетода = Новый Массив;
			ПараметрыМетода.Добавить(Источник);
			ПараметрыМетода.Добавить(СтандартнаяОбработка);
			
			пбп_Переадресация.ВыполнитьМетодКонфигурации(ИмяМетода, ПараметрыМетода);
			
			Источник = ПараметрыМетода[0];
			Если Не ПараметрыМетода[1] Тогда
				СтандартнаяОбработка = Ложь;
			КонецЕсли;
		Исключение
			ВызватьИсключение ПолучитьТекстОшибки(ИмяМетода, ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

// Обработка получения данных выбора
//
// Параметры:
//  Источник			 - СправочникМенеджер, ПеречислениеМенеджер, ДокументМенеджер, ПланВидовХарактеристикМенеджер, ПланСчетовМенеджер,
// ПланВидовРасчетаМенеджер, ПланОбменаМенеджер, БизнесПроцессМенеджер, ЗадачаМенеджер - источник подписки на событие
//  ДанныеВыбора		 - СписокЗначений	 - данные выбора
//  Параметры			 - Структура		 - параметры
//  СтандартнаяОбработка - Булево			 - стандартная обработка
//
Процедура ОбработкаПолученияДанныхВыбора(Источник, ДанныеВыбора, Параметры, СтандартнаяОбработка) Экспорт
	
	Событие = "ОбработкаПолученияДанныхВыбора";
	ИмяМетода = ПолучитьИмяМетода(Источник, Событие);
	
	Если ЗначениеЗаполнено(ИмяМетода) Тогда
		Попытка
			ПараметрыМетода = Новый Массив;
			ПараметрыМетода.Добавить(Источник);
			ПараметрыМетода.Добавить(ДанныеВыбора);
