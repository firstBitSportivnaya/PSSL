		ПараметрыМетода.Добавить(ПолучениеЭлемента);
		ПараметрыМетода.Добавить(ОтправкаНазад);
		
		пбп_Переадресация.ВыполнитьМетодКонфигурации(ИмяМетода, ПараметрыМетода);
		
