Процедура ПередНачаломОтправкиДанныхГлавному(Источник, ПотокОбменаДанными) Экспорт
	
	Событие = "ПередНачаломОтправкиДанныхГлавному";
	ИмяМетода = ПолучитьИмяМетода(Источник, Событие);
	
	ПередНачаломОтправкиДанных(ИмяМетода, Источник, ПотокОбменаДанными);
	
КонецПроцедуры

#КонецОбласти // ПланыОбмена

#КонецОбласти // ПрограммныйИнтерфейс

#Область СлужебныеПроцедурыИФункции

// Получить функцию соответствия обработчиков
//
// Параметры:
//  Источник	 - Произвольный	 - объект, набор записей или менеджер
//  Событие		 - Строка		 - имя события подписки
// 
// Возвращаемое значение:
//  Строка - имя метода, где будет расположено получение соответствия обработчиков событий
//
Функция ПолучитьИмяФункцииСоответствияОбработчиковСобытий(Источник, Событие)
	
	ТипЗначения = ТипЗнч(Источник);
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗначения);
	
	Если Метаданные.Справочники.Содержит(ОбъектМетаданных) Тогда
		ПрефиксМетода = "Справочники";
	ИначеЕсли Метаданные.Документы.Содержит(ОбъектМетаданных) Тогда
		ПрефиксМетода = "Документы";
	ИначеЕсли Метаданные.ПланыВидовХарактеристик.Содержит(ОбъектМетаданных) Тогда
		ПрефиксМетода = "ПланыВидовХарактеристик";
	ИначеЕсли Метаданные.ПланыСчетов.Содержит(ОбъектМетаданных) Тогда
		ПрефиксМетода = "ПланыСчетов";
	ИначеЕсли Метаданные.ПланыВидовРасчета.Содержит(ОбъектМетаданных) Тогда
		ПрефиксМетода = "ПланыВидовРасчета";
	ИначеЕсли Метаданные.БизнесПроцессы.Содержит(ОбъектМетаданных) Тогда
		ПрефиксМетода = "БизнесПроцессы";
	ИначеЕсли Метаданные.Задачи.Содержит(ОбъектМетаданных) Тогда
		ПрефиксМетода = "Задачи";
	ИначеЕсли Метаданные.ПланыОбмена.Содержит(ОбъектМетаданных) Тогда
		ПрефиксМетода = "ПланыОбмена";
	ИначеЕсли Метаданные.РегистрыСведений.Содержит(ОбъектМетаданных) Тогда
		ПрефиксМетода = "РегистрыСведений";
	ИначеЕсли Метаданные.РегистрыНакопления.Содержит(ОбъектМетаданных) Тогда
		ПрефиксМетода = "РегистрыНакопления";
	ИначеЕсли Метаданные.РегистрыБухгалтерии.Содержит(ОбъектМетаданных) Тогда
		ПрефиксМетода = "РегистрыБухгалтерии";
	ИначеЕсли Метаданные.РегистрыРасчета.Содержит(ОбъектМетаданных) Тогда
		ПрефиксМетода = "РегистрыРасчета";
	ИначеЕсли Метаданные.Константы.Содержит(ОбъектМетаданных) Тогда
		ПрефиксМетода = "Константы";
	ИначеЕсли Метаданные.Обработки.Содержит(ОбъектМетаданных) Тогда
		ПрефиксМетода = "Обработки";
	ИначеЕсли Метаданные.Отчеты.Содержит(ОбъектМетаданных) Тогда
		ПрефиксМетода = "Отчеты";
	ИначеЕсли Метаданные.ЖурналыДокументов.Содержит(ОбъектМетаданных) Тогда
		ПрефиксМетода = "ЖурналыДокументов";
	ИначеЕсли Метаданные.КритерииОтбора.Содержит(ОбъектМетаданных) Тогда
		ПрефиксМетода = "КритерииОтбора";
	ИначеЕсли Метаданные.Последовательности.Содержит(ОбъектМетаданных) Тогда
		ПрефиксМетода = "Последовательности";
	ИначеЕсли Метаданные.ХранилищаНастроек.Содержит(ОбъектМетаданных) Тогда
		ПрефиксМетода = "ХранилищаНастроек";
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат СтрШаблон("%1%2", ПрефиксМетода, Событие);
	
КонецФункции

// Получить соответствие существующих обработчиков событий
//
// Параметры:
//  ИмяМетода	 - Строка	 - имя метода, где расположено получение соответствия обработчиков событий
// 
// Возвращаемое значение:
//  Соответствие - ключ - тип объекта, значение - наименование искомой функции с общим модулем
//
Функция ПолучитьСоответствиеСуществующихОбработчиковСобытий(ИмяМетода)
	
	Если Не ЗначениеЗаполнено(ИмяМетода) Тогда
		ВызватьИсключение НСтр("ru = 'Параметр ИмяМетода не может быть пустым'");
	КонецЕсли;
	
	// BSLLS:ExecuteExternalCodeInCommonModule-off
	ПолноеИмяМетода = СтрШаблон("пбп_ОбработкаСобытийПовтИсп.%1", ИмяМетода);
	Соответствие = пбп_Переадресация.ВызватьФункциюКонфигурации(ПолноеИмяМетода);
	// BSLLS:ExecuteExternalCodeInCommonModule-on
	
	Возврат Соответствие;
	
КонецФункции

// Получить имя метода
//
// Параметры:
//  Источник	 - Произвольный	 - объект, набор записей или менеджер
//  Событие		 - Строка		 - имя события подписки
// 
// Возвращаемое значение:
//  Строка - имя метода, которое должно быть вызвано при возникновении подписки на событие
//
Функция ПолучитьИмяМетода(Источник, Событие)
	
	МетодСоответствия = ПолучитьИмяФункцииСоответствияОбработчиковСобытий(Источник, Событие);
	
	СоответствиеОбработчиков = ПолучитьСоответствиеСуществующихОбработчиковСобытий(МетодСоответствия);
	
	ИмяМетода = СоответствиеОбработчиков.Получить(ТипЗнч(Источник));
	
	Возврат ИмяМетода;
	
КонецФункции

// Получить текст ошибки
//
// Параметры:
//  ИмяМетода		 - Строка	 - см. ПолучитьИмяМетода
//  ОписаниеОшибки	 - Строка	 - текст ошибки исключения
// 
// Возвращаемое значение:
//  Строка - сформированный текст ошибки мультиязычный
//
Функция ПолучитьТекстОшибки(ИмяМетода, ОписаниеОшибки)
	
	ТекстОшибки = СтрШаблон("ru = '%1%2Имя метода: %3';en = '%1%2Method name: %3'",
		ОписаниеОшибки, Символы.ПС, ИмяМетода);
	
	Возврат НСтр(ТекстОшибки);
	
КонецФункции

Процедура ПередЗаписьюПриЗаписи(ИмяМетода, Источник,
	Отказ, Параметр3, Параметр4, Параметр5, Параметр6)
	
	Если Не ЗначениеЗаполнено(ИмяМетода) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ПараметрыМетода = Новый Массив;
		ПараметрыМетода.Добавить(Источник);
		ПараметрыМетода.Добавить(Отказ);
		Если Параметр3 <> Неопределено Тогда
			ПараметрыМетода.Добавить(Параметр3); // Режим записи или замещение
		КонецЕсли;
		Если Параметр4 <> Неопределено Тогда
			ПараметрыМетода.Добавить(Параметр4); // Режим проведения или только запись
		КонецЕсли;
		Если Параметр5 <> Неопределено Тогда
			ПараметрыМетода.Добавить(Параметр5); // Запись фактического периода действия
		КонецЕсли;
		Если Параметр6 <> Неопределено Тогда
			ПараметрыМетода.Добавить(Параметр6); // Запись перерасчетов
		КонецЕсли;
		
		пбп_Переадресация.ВыполнитьМетодКонфигурации(ИмяМетода, ПараметрыМетода);
		
		Источник = ПараметрыМетода[0];
		Если ПараметрыМетода[1] Тогда
			Отказ = Истина;
		КонецЕсли;
	Исключение
		ВызватьИсключение ПолучитьТекстОшибки(ИмяМетода, ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

Процедура ПриУстановкеНовогоКодаИлиНомера(ИмяМетода, Источник, СтандартнаяОбработка, Префикс)
	
	Если Не ЗначениеЗаполнено(ИмяМетода) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ПараметрыМетода = Новый Массив;
		ПараметрыМетода.Добавить(Источник);
		ПараметрыМетода.Добавить(СтандартнаяОбработка);
		ПараметрыМетода.Добавить(Префикс);
		
		пбп_Переадресация.ВыполнитьМетодКонфигурации(ИмяМетода, ПараметрыМетода);
	Исключение
		ВызватьИсключение ПолучитьТекстОшибки(ИмяМетода, ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

Процедура ВыполнитьСПараметрамиИсточникИОтказ(ИмяМетода, Источник, Отказ)
	
	Если Не ЗначениеЗаполнено(ИмяМетода) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ПараметрыМетода = Новый Массив;
		ПараметрыМетода.Добавить(Источник);
		ПараметрыМетода.Добавить(Отказ);
		
		пбп_Переадресация.ВыполнитьМетодКонфигурации(ИмяМетода, ПараметрыМетода);
		
		Источник = ПараметрыМетода[0];
		Если ПараметрыМетода[1] Тогда
			Отказ = Истина;
		КонецЕсли;
	Исключение
		ВызватьИсключение ПолучитьТекстОшибки(ИмяМетода, ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

Процедура ПриОтправкеДанных(ИмяМетода, Источник, ЭлементДанных,
	ОтправкаЭлемента, СозданиеНачальногоОбраза = Неопределено)
	
	Если Не ЗначениеЗаполнено(ИмяМетода) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ПараметрыМетода = Новый Массив;
		ПараметрыМетода.Добавить(Источник);
		ПараметрыМетода.Добавить(ЭлементДанных);
		ПараметрыМетода.Добавить(ОтправкаЭлемента);
		Если СозданиеНачальногоОбраза <> Неопределено Тогда
			ПараметрыМетода.Добавить(СозданиеНачальногоОбраза);
		КонецЕсли;
		
		пбп_Переадресация.ВыполнитьМетодКонфигурации(ИмяМетода, ПараметрыМетода);
		
		Источник			= ПараметрыМетода[0];
		ЭлементДанных		= ПараметрыМетода[1];
		ОтправкаЭлемента	= ПараметрыМетода[2];
		Если СозданиеНачальногоОбраза <> Неопределено Тогда
			СозданиеНачальногоОбраза = ПараметрыМетода[3];
		КонецЕсли;
	Исключение
		ВызватьИсключение ПолучитьТекстОшибки(ИмяМетода, ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

