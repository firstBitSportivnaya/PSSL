#Область СлужебныйПрограммныйИнтерфейс

// Возвращает часовой пояс информационной базы.
//
// Возвращаемое значение:
//  Строка - идентификатор часового пояса.
//
Функция ЧасовойПоясБазыДанных() Экспорт
	
	Возврат ПолучитьЧасовойПоясИнформационнойБазы();
	
КонецФункции

// Описание регистра публичных идентификаторов. Результат кэшируется на время сеанса.
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура - Использовать, ЭтоРегистрБСП, ИмяТаблицы, ИмяСсылки, ИмяИдентификатора, ИмяУзла, ДлинаИдентификатора.
//
Функция ОписаниеРегистраПубличныхИдентификаторов() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Использовать", Ложь);
	Результат.Вставить("ЭтоРегистрБСП", Ложь);
	Результат.Вставить("ИмяТаблицы", "");
	Результат.Вставить("ИмяСсылки", "");
	Результат.Вставить("ИмяИдентификатора", "");
	Результат.Вставить("ИмяУзла", "");
	Результат.Вставить("ДлинаИдентификатора", 36);
	
	ИмяРегистраБСП = "ПубличныеИдентификаторы" + "СинхронизируемыхОбъектов";
	
	Если пбп_Переадресация.ПодсистемаСуществует("СтандартныеПодсистемы")
		И Метаданные.РегистрыСведений.Найти(ИмяРегистраБСП) <> Неопределено Тогда
		
		Результат.Использовать = Истина;
		Результат.ЭтоРегистрБСП = Истина;
		Результат.ИмяТаблицы = "РегистрСведений." + ИмяРегистраБСП;
		Результат.ИмяСсылки = "Ссылка";
		Результат.ИмяИдентификатора = "Идентификатор";
		Результат.ИмяУзла = "УзелИнформационнойБазы";
		Результат.ДлинаИдентификатора = 36;
		
	ИначеЕсли пбп_ОбщегоНазначенияСервер.ПолучитьЗначениеКонстанты(
		"пбп_ИспользоватьСоответствияОбъектовИнтегрируемыхСистем") Тогда
		
		Результат.Использовать = Истина;
		Результат.ИмяТаблицы = "РегистрСведений.пбп_СоответствиеОбъектовИнтегрируемыхСистем";
		Результат.ИмяСсылки = "СсылкаНаОбъект";
		Результат.ИмяИдентификатора = "ИдентификаторСистемы";
		Результат.ИмяУзла = "ИнтегрируемаяСистема";
		Результат.ДлинаИдентификатора = 100;
		
	КонецЕсли;
	
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

// Вычисляет метод переопределения и кэширует результат на время сеанса.
//
// Параметры:
//  ИмяФункции - Строка - имя метода с круглыми скобками.
//
// Возвращаемое значение:
//  Произвольный, Неопределено - результат метода.
//
Функция РезультатПереопределения(ИмяФункции) Экспорт
	
	Если Не ЗначениеЗаполнено(ИмяФункции) Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	Возврат пбп_Переадресация.ВычислитьВБезопасномРежиме(ИмяФункции);
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Карта обработчиков полей, которые не заполняются универсальной загрузкой.
// Ядро библиотеки возвращает пустое соответствие. Конфигурация-потребитель наполняет карту.
//
// Возвращаемое значение:
//  Соответствие - ключ потока, значение - имя метода с круглыми скобками.
//
Функция ИменаМетодовПолейНеОбрабатываемыхУниверсальнойЗагрузкой() Экспорт
	
	Возврат ОбработатьСоответствиеФункций(Новый Соответствие);
	
КонецФункции

// Карта обработчиков полей поиска.
//
// Возвращаемое значение:
//  Соответствие - ключ потока, значение - имя метода с круглыми скобками.
//
Функция ИменаМетодовПолейПоиска() Экспорт
	
	Возврат ОбработатьСоответствиеФункций(Новый Соответствие);
	
КонецФункции

// Карта обработчиков соответствия полей источника и приемника.
//
// Возвращаемое значение:
//  Соответствие - ключ потока, значение - имя метода с круглыми скобками.
//
Функция ИменаМетодовСоответствияПолейИсточникаИПриемника() Экспорт
	
	Возврат ОбработатьСоответствиеФункций(Новый Соответствие);
	
КонецФункции

// Карта обработчиков соответствия типов полей.
//
// Возвращаемое значение:
//  Соответствие - ключ потока, значение - имя метода с круглыми скобками.
//
Функция ИменаМетодовСоответствияТиповПолей() Экспорт
	
	Возврат ОбработатьСоответствиеФункций(Новый Соответствие);
	
КонецФункции

// Карта процедур постобработки.
// Круглые скобки не добавляются: вызывающий код передаёт имя в ВыполнитьМетодКонфигурации.
//
// Возвращаемое значение:
//  Соответствие - ключ потока, значение - имя процедуры.
//
Функция ИменаМетодовПостобработкиОбъектов() Экспорт
	
	Возврат Новый Соответствие;
	
КонецФункции

// Карта имени реквизита, которым ссылка выгружается в универсальном формате.
// Ключ - тип ссылки, значение - имя метода, возвращающего имя реквизита.
//
// Возвращаемое значение:
//  Соответствие - пустая карта ядра. Конфигурация-потребитель наполняет ее.
//
Функция ИменаМетодовИмениРеквизитаВыгрузки() Экспорт
	
	Возврат ОбработатьСоответствиеФункций(Новый Соответствие);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОбработатьСоответствиеФункций(СоответствиеФункций)
	
	Результат = Новый Соответствие;
	
	Для Каждого КлючИЗначение Из СоответствиеФункций Цикл
		
		Результат.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение + "()");
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
