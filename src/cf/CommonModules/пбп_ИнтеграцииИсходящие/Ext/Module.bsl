
#Область ПрограммныйИнтерфейс

#Область Справочники

Процедура Справочник_пбп_НастройкиИнтеграции(ОбъектОбработки, РезультатОбработки, СостояниеСообщения,
	ТипОбъекта, МетодХранения, Задержка, ФорматСообщения, ТекстОшибки, ДатаРегистрации, СсылкаНаОбъект, Функции) Экспорт
	
	Поток = "ОтправкаНастройкиИнтеграции";
	
	СтруктураИстории = пбп_ИнтеграцииШина
		.ИнициализироватьСтруктуруЗаписиИсторииИнтеграции(Поток, , Ложь);
	
	Попытка
		МетаданныеОбъект = Метаданные.Справочники.пбп_НастройкиИнтеграции;
		
		СоставПолей = пбп_ИнтеграцииШина.ПолучитьОписаниеПолейПоМетаданным(МетаданныеОбъект, , ОбъектОбработки, СтруктураИстории);
		пбп_ИнтеграцииШина.УдалитьНеиспользуемыеРеквизиты(СоставПолей);
		
		Данные = пбп_ИнтеграцииШина.ВыгрузитьВПлатформу(ОбъектОбработки, СоставПолей, , СтруктураИстории);
		
		РезультатОбработки = пбп_КоннекторHTTP.ОбъектВJson(Данные);
	Исключение
		ТекстОшибки = пбп_ИнтеграцииСервер.ПолучитьПодробноеПредставлениеОшибкиИсключения(
			НСтр("ru = 'Не удалось сформировать сообщение для отправки по причине'"),
			ИнформацияОбОшибке());
	КонецПопытки;
	
	пбп_ИнтеграцииШина.ЗаписатьРезультатВИсториюИнтеграции(СтруктураИстории, ТекстОшибки, РезультатОбработки, Ложь);
	
КонецПроцедуры

Процедура Справочник_пбп_ИнтеграционныеПотоки(ОбъектОбработки, РезультатОбработки, СостояниеСообщения,
	ТипОбъекта, МетодХранения, Задержка, ФорматСообщения, ТекстОшибки, ДатаРегистрации, СсылкаНаОбъект, Функции) Экспорт
	
	Поток = "ОтправкаИнтеграционногоПотока";
	
	СтруктураИстории = пбп_ИнтеграцииШина
		.ИнициализироватьСтруктуруЗаписиИсторииИнтеграции(Поток, , Ложь);
	
	Попытка
		МетаданныеОбъект = Метаданные.Справочники.пбп_ИнтеграционныеПотоки;
		
		СоставПолей = ПоляВыгрузки_Справочник_пбп_ИнтеграционныеПотоки();
		
		Данные = пбп_ИнтеграцииШина.ВыгрузитьВПлатформу(ОбъектОбработки, СоставПолей, , СтруктураИстории);
		
		РезультатОбработки = пбп_КоннекторHTTP.ОбъектВJson(Данные);
	Исключение
		ТекстОшибки = пбп_ИнтеграцииСервер.ПолучитьПодробноеПредставлениеОшибкиИсключения(
			НСтр("ru = 'Не удалось сформировать сообщение для отправки по причине'"),
			ИнформацияОбОшибке());
	КонецПопытки;
	
	пбп_ИнтеграцииШина.ЗаписатьРезультатВИсториюИнтеграции(СтруктураИстории, ТекстОшибки, РезультатОбработки, Ложь);
	
КонецПроцедуры

