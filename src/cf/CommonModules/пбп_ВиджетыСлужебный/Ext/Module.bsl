// Виджеты (служебный): расчет показателей виджетов, кэш значений и фоновый расчет.

#Область СлужебныйПрограммныйИнтерфейс

// Возвращает значения показателей виджетов из кэша для текущего пользователя.
// Для общих показателей читается запись кэша без пользователя.
//
// Параметры:
//  Показатели - Массив из СправочникСсылка.пбп_ПоказателиВиджетов - показатели, значения которых нужно получить.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - СправочникСсылка.пбп_ПоказателиВиджетов - показатель.
//   * Значение - см. НовоеЗначениеПоказателя
//
Функция ЗначенияПоказателейИзКэша(Показатели) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Показатели.Ссылка КАК Показатель,
	|	Показатели.ПериодАктуальности КАК ПериодАктуальности,
	|	Значения.Значение КАК Значение,
	|	Значения.ДатаРасчета КАК ДатаРасчета,
	|	Значения.ОшибкаРасчета КАК ОшибкаРасчета
	|ИЗ
	|	Справочник.пбп_ПоказателиВиджетов КАК Показатели
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.пбп_ЗначенияПоказателейВиджетов КАК Значения
	|		ПО (Значения.Показатель = Показатели.Ссылка)
	|			И (Значения.Пользователь = ВЫБОР
	|				КОГДА Показатели.Общий
	|					ТОГДА &ПустойПользователь
	|				ИНАЧЕ &Пользователь
	|			КОНЕЦ)
	|ГДЕ
	|	Показатели.Ссылка В(&Показатели)";
	Запрос.УстановитьПараметр("Показатели", Показатели);
	Запрос.УстановитьПараметр("Пользователь", ТекущийПользовательКэша());
	Запрос.УстановитьПараметр("ПустойПользователь", ПустойПользовательКэша());
	
	ТекущаяДата = ТекущаяДатаСеанса();
	Результат = Новый Соответствие;
	
	// Прямого права на регистр кэша у ролей нет: читаются только записи текущего пользователя и общих показателей.
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	
	Пока Выборка.Следующий() Цикл
		
		ЗначениеПоказателя = НовоеЗначениеПоказателя();
		Если ЗначениеЗаполнено(Выборка.ДатаРасчета) Тогда
			
			ЗначениеПоказателя.Значение = Выборка.Значение.Получить();
			ЗначениеПоказателя.ДатаРасчета = Выборка.ДатаРасчета;
			ЗначениеПоказателя.Ошибка = Выборка.ОшибкаРасчета;
			ЗначениеПоказателя.Актуально = ЗначениеАктуально(Выборка.ДатаРасчета, Выборка.ПериодАктуальности, ТекущаяДата);
			
		КонецЕсли;
		Результат.Вставить(Выборка.Показатель, ЗначениеПоказателя);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает показатели, значения которых в кэше отсутствуют или устарели.
//
// Параметры:
//  ЗначенияПоказателей - см. ЗначенияПоказателейИзКэша
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.пбп_ПоказателиВиджетов - показатели, требующие пересчета.
//
Функция УстаревшиеПоказатели(ЗначенияПоказателей) Экспорт
	
	Результат = Новый Массив;
	Для Каждого КлючИЗначение Из ЗначенияПоказателей Цикл
		
		Если Не КлючИЗначение.Значение.Актуально Тогда
			
			Результат.Добавить(КлючИЗначение.Ключ);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Рассчитывает значения показателей виджетов и записывает их в кэш.
// Групповой показатель рассчитывается один раз за вызов, даже если из него берут значения несколько показателей.
// Ошибка расчета показателя записывается в кэш и не прерывает расчет остальных показателей.
// Используется как метод фонового задания.
//
// Параметры:
//  Показатели - Массив из СправочникСсылка.пбп_ПоказателиВиджетов - рассчитываемые показатели.
//
Процедура РассчитатьПоказатели(Показатели) Экспорт
	
	Пользователь = ТекущийПользовательКэша();
	ПустойПользователь = ПустойПользовательКэша();
	РезультатыИсточников = Новый Соответствие;
	
	Выборка = РеквизитыРасчетаПоказателей(Показатели).Выбрать();
	Пока Выборка.Следующий() Цикл
		
		РезультатИсточника = РезультатыИсточников.Получить(Выборка.ИсточникРасчета);
		Если РезультатИсточника = Неопределено Тогда
			
			РезультатИсточника = РезультатРасчетаИсточника(Выборка, Пользователь);
			РезультатыИсточников.Вставить(Выборка.ИсточникРасчета, РезультатИсточника);
			
		КонецЕсли;
		
		Результат = РезультатИсточника;
		Если ЗначениеЗаполнено(Выборка.ГрупповойПоказатель) Тогда
			
			Результат = РезультатИзГрупповогоПоказателя(РезультатИсточника, Выборка.СвойствоГрупповогоПоказателя);
			
		КонецЕсли;
		
		ПользовательЗаписи = ?(Выборка.Общий, ПустойПользователь, Пользователь);
		ЗаписатьЗначениеВКэш(Выборка.Показатель, ПользовательЗаписи, Результат);
		
	КонецЦикла;
	
КонецПроцедуры

// Запускает фоновый расчет показателей виджетов для текущего пользователя.
// Если расчет текущего пользователя уже выполняется, новое задание не запускается.
//
// Параметры:
//  Показатели - Массив из СправочникСсылка.пбп_ПоказателиВиджетов - рассчитываемые показатели.
//
// Возвращаемое значение:
//  УникальныйИдентификатор - идентификатор запущенного фонового задания.
//  Неопределено - задание не запущено: нет показателей или расчет уже выполняется.
//
Функция ЗапуститьФоновыйРасчет(Показатели) Экспорт
	
	Если Показатели.Количество() = 0 Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	КлючЗадания = "пбп_Виджеты_" + Строка(ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор);
	Отбор = Новый Структура("Ключ, Состояние", КлючЗадания, СостояниеФоновогоЗадания.Активно);
	Если ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор).Количество() > 0 Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	ПараметрыЗадания = Новый Массив;
	ПараметрыЗадания.Добавить(Показатели);
	
	Задание = ФоновыеЗадания.Выполнить("пбп_ВиджетыСлужебный.РассчитатьПоказатели", ПараметрыЗадания, КлючЗадания,
		НСтр("ru = 'Расчет показателей виджетов'"));
	
	Возврат Задание.УникальныйИдентификатор;
	
КонецФункции

// Удаляет из кэша значения показателей текущего пользователя и общие значения этих показателей.
// При следующем запросе значения будут рассчитаны заново.
//
// Параметры:
//  Показатели - Массив из СправочникСсылка.пбп_ПоказателиВиджетов - показатели, кэш которых сбрасывается.
//
Процедура СброситьКэшПоказателей(Показатели) Экспорт
	
	ПользователиКэша = Новый Массив;
	ПользователиКэша.Добавить(ТекущийПользовательКэша());
	ПользователиКэша.Добавить(ПустойПользовательКэша());
	
	УстановитьПривилегированныйРежим(Истина);
	
	Для Каждого Показатель Из Показатели Цикл
		
		Для Каждого ПользовательКэша Из ПользователиКэша Цикл
			
			НаборЗаписей = РегистрыСведений.пбп_ЗначенияПоказателейВиджетов.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Пользователь.Установить(ПользовательКэша);
			НаборЗаписей.Отбор.Показатель.Установить(Показатель);
			НаборЗаписей.Записать();
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает описание значения показателя виджета.
//
// Возвращаемое значение:
//  Структура:
//   * Значение - Произвольный - значение показателя.
//   * ДатаРасчета - Дата - дата расчета значения, пустая, если значение еще не рассчитывалось.
//   * Актуально - Булево - значение рассчитано и период актуальности не истек.
//   * Ошибка - Строка - описание ошибки последнего расчета.
//
Функция НовоеЗначениеПоказателя()
	
	Результат = Новый Структура;
	Результат.Вставить("Значение", Неопределено);
	Результат.Вставить("ДатаРасчета", Дата(1, 1, 1));
	Результат.Вставить("Актуально", Ложь);
	Результат.Вставить("Ошибка", "");
	
	Возврат Результат;
	
КонецФункции

Функция ЗначениеАктуально(ДатаРасчета, ПериодАктуальности, ТекущаяДата)
	
	Возврат ПериодАктуальности > 0 И ДатаРасчета + ПериодАктуальности >= ТекущаяДата;
	
КонецФункции

Функция РеквизитыРасчетаПоказателей(Показатели)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Показатели.Ссылка КАК Показатель,
	|	Показатели.Общий КАК Общий,
	|	Показатели.ГрупповойПоказатель КАК ГрупповойПоказатель,
	|	Показатели.СвойствоГрупповогоПоказателя КАК СвойствоГрупповогоПоказателя,
	|	ЕСТЬNULL(Групповые.Ссылка, Показатели.Ссылка) КАК ИсточникРасчета,
	|	ЕСТЬNULL(Групповые.ВидИсточника, Показатели.ВидИсточника) КАК ВидИсточника,
	|	ЕСТЬNULL(Групповые.НастройкаОтбора, Показатели.НастройкаОтбора) КАК НастройкаОтбора,
	|	ЕСТЬNULL(Групповые.ПользовательскаяФункция, Показатели.ПользовательскаяФункция) КАК ПользовательскаяФункция,
	|	ЕСТЬNULL(Групповые.ИмяМетода, Показатели.ИмяМетода) КАК ИмяМетода
	|ИЗ
	|	Справочник.пбп_ПоказателиВиджетов КАК Показатели
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.пбп_ПоказателиВиджетов КАК Групповые
	|		ПО Показатели.ГрупповойПоказатель = Групповые.Ссылка
	|ГДЕ
	|	Показатели.Ссылка В(&Показатели)";
	Запрос.УстановитьПараметр("Показатели", Показатели);
	
	Возврат Запрос.Выполнить();
	
КонецФункции

Функция РезультатРасчетаИсточника(РеквизитыРасчета, Пользователь)
	
	Результат = Новый Структура("Значение, Ошибка", Неопределено, "");
	
	// Источник выполняет произвольный прикладной код: его ошибка не должна прерывать расчет остальных показателей.
	Попытка
		Результат.Значение = ЗначениеИсточника(РеквизитыРасчета, Пользователь);
	Исключение
		Результат.Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция ЗначениеИсточника(РеквизитыРасчета, Пользователь)
	
	ВидыИсточников = Перечисления.пбп_ВидыИсточниковПоказателейВиджетов;
	ПараметрыРасчета = Новый Структура("Показатель, Пользователь", РеквизитыРасчета.ИсточникРасчета, Пользователь);
	
	Если РеквизитыРасчета.ВидИсточника = ВидыИсточников.НастройкаОтбора Тогда
		
		Данные = Справочники.пбп_НастройкиОтбораОбъектов.ПолучитьДанныеПоНастройкеОтбора(РеквизитыРасчета.НастройкаОтбора);
		Возврат Данные.Количество();
		
	ИначеЕсли РеквизитыРасчета.ВидИсточника = ВидыИсточников.ПользовательскаяФункция Тогда
		
		Если Не ПолучитьФункциональнуюОпцию("пбп_ИспользоватьПользовательскиеФункции") Тогда
			
			ВызватьИсключение НСтр("ru = 'Использование пользовательских функций отключено.'");
			
		КонецЕсли;
		
		Возврат пбп_ОбщегоНазначенияСервер.ВыполнитьПользовательскуюФункциюСПараметрами(
			РеквизитыРасчета.ПользовательскаяФункция, ПараметрыРасчета);
		
	ИначеЕсли РеквизитыРасчета.ВидИсточника = ВидыИсточников.МетодКонфигурации Тогда
		
		ПараметрыМетода = Новый Массив;
		ПараметрыМетода.Добавить(ПараметрыРасчета);
		Возврат пбп_Переадресация.ВызватьФункциюКонфигурации(РеквизитыРасчета.ИмяМетода, ПараметрыМетода);
		
	Иначе
		
		ВызватьИсключение НСтр("ru = 'Не указан вид источника показателя.'");
		
	КонецЕсли;
	
КонецФункции

Функция РезультатИзГрупповогоПоказателя(РезультатГруппового, ИмяСвойства)
	
	Результат = Новый Структура("Значение, Ошибка", Неопределено, РезультатГруппового.Ошибка);
	Если ЗначениеЗаполнено(Результат.Ошибка) Тогда
		
		Возврат Результат;
		
	КонецЕсли;
	
	ЗначениеГруппового = РезультатГруппового.Значение;
	ТипЗначения = ТипЗнч(ЗначениеГруппового);
	ЭтоСтруктура = ТипЗначения = Тип("Структура") Или ТипЗначения = Тип("ФиксированнаяСтруктура");
	
	ЗначениеСвойства = Неопределено;
	Если ЭтоСтруктура И ЗначениеГруппового.Свойство(ИмяСвойства, ЗначениеСвойства) Тогда
		
		Результат.Значение = ЗначениеСвойства;
		
	Иначе
		
		Результат.Ошибка = СтрШаблон(НСтр("ru = 'Групповой показатель не вернул свойство %1.'"), ИмяСвойства);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаписатьЗначениеВКэш(Показатель, Пользователь, Результат)
	
	УстановитьПривилегированныйРежим(Истина);
	
	МенеджерЗаписи = РегистрыСведений.пбп_ЗначенияПоказателейВиджетов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Пользователь = Пользователь;
	МенеджерЗаписи.Показатель = Показатель;
	МенеджерЗаписи.Значение = Новый ХранилищеЗначения(Результат.Значение);
	МенеджерЗаписи.ДатаРасчета = ТекущаяДатаСеанса();
	МенеджерЗаписи.ОшибкаРасчета = Результат.Ошибка;
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

// Без БСП пбп_Переадресация.ТекущийПользователь() возвращает Неопределено:
// значение приводится к определяемому типу пбп_Пользователи.
Функция ТекущийПользовательКэша()
	
	Возврат Метаданные.ОпределяемыеТипы.пбп_Пользователи.Тип.ПривестиЗначение(пбп_Переадресация.ТекущийПользователь());
	
КонецФункции

Функция ПустойПользовательКэша()
	
	Возврат Метаданные.ОпределяемыеТипы.пбп_Пользователи.Тип.ПривестиЗначение(Неопределено);
	
КонецФункции

#КонецОбласти
