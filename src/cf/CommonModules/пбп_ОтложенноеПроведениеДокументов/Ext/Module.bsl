#Область ПрограммныйИнтерфейс

// Параметры постановки документа в очередь отложенного проведения.
// Пустые время ожидания, шаг и максимум попыток при записи не меняют настройку вида документа.
// Незаданные поля читаются из общей настройки в момент проведения.
//
// Параметры:
//  Ссылка - ОпределяемыйТип.пбп_ОбъектОтложенногоПроведения - документ из состава типа.
//
// Возвращаемое значение:
//  Структура - параметры постановки:
//   * Объект - ОпределяемыйТип.пбп_ОбъектОтложенногоПроведения - документ очереди.
//   * Перепроведение - Булево - провести документ повторно, если он уже проведен.
//   * ДатаСледующейПопытки - Дата - момент первой попытки; пустая дата означает текущую дату сеанса.
//   * ВремяОжидания - Число, Неопределено - пауза в секундах; Неопределено - из настроек.
//   * ШагУвеличенияОжидания - Число, Неопределено - добавка к паузе на каждую попытку, в секундах.
//   * МаксимумПопыток - Число, Неопределено - после скольких ошибок прекратить обработку.
//   * ОбработчикПередПроведением - Строка - имя экспортной процедуры Модуль.Процедура.
//   * ОбработчикПослеПроведения - Строка - имя экспортной процедуры Модуль.Процедура.
//   * ОбработчикОшибкиПроведения - Строка - имя экспортной процедуры Модуль.Процедура.
//   * ДополнительныеПараметры - Произвольный - значения, сериализуемые в JSON, и ссылки.
//   * СброситьПопытки - Булево - обнулить счетчик и снять признак прекращения.
//
Функция ПараметрыОтложенногоПроведения(Ссылка) Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("Объект", Ссылка);
	Параметры.Вставить("Перепроведение", Ложь);
	Параметры.Вставить("ДатаСледующейПопытки", Дата(1, 1, 1));
	Параметры.Вставить("ВремяОжидания", Неопределено);
	Параметры.Вставить("ШагУвеличенияОжидания", Неопределено);
	Параметры.Вставить("МаксимумПопыток", Неопределено);
	Параметры.Вставить("ОбработчикПередПроведением", "");
	Параметры.Вставить("ОбработчикПослеПроведения", "");
	Параметры.Вставить("ОбработчикОшибкиПроведения", "");
	Параметры.Вставить("ДополнительныеПараметры", Новый Структура);
	Параметры.Вставить("СброситьПопытки", Ложь);

	Возврат Параметры;

КонецФункции

// Ставит документ в очередь отложенного проведения.
// Повторный вызов сохраняет счетчик попыток, если не передан СброситьПопытки.
// При выключенной функциональной опции вызывает исключение и ничего не записывает.
//
// Параметры:
//  Параметры - Структура - результат ПараметрыОтложенногоПроведения.
//
Процедура ЗапланироватьПроведение(Параметры) Экспорт

	Если Не ОтложенноеПроведениеВключено() Тогда

		ВызватьИсключение НСтр("ru = 'Отложенное проведение документов выключено. Включите функциональную опцию.'");

	КонецЕсли;

	Если Не ЗначениеЗаполнено(Параметры.Объект) Тогда

		ВызватьИсключение НСтр("ru = 'Не указан документ для отложенного проведения.'");

	КонецЕсли;

	ОписаниеТипа = Метаданные.ОпределяемыеТипы.пбп_ОбъектОтложенногоПроведения.Тип;

	Если Не ОписаниеТипа.СодержитТип(ТипЗнч(Параметры.Объект)) Тогда

		ВызватьИсключение НСтр("ru = 'Документ не входит в определяемый тип пбп_ОбъектОтложенногоПроведения.'");

	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	НачатьТранзакцию();

	Попытка

		ЗаблокироватьОбъектОчереди(Параметры.Объект);
		ЗаписатьПереопределениеНастроек(Параметры);
		ЗаписатьСтрокуОчереди(Параметры);
		ЗафиксироватьТранзакцию();

	Исключение

		ОтменитьТранзакцию();
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;

	КонецПопытки;

	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

// Снимает документ с очереди отложенного проведения.
//
// Параметры:
//  Ссылка - ОпределяемыйТип.пбп_ОбъектОтложенногоПроведения - документ, который нужно убрать из очереди.
//
Процедура ОтменитьОтложенноеПроведение(Ссылка) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	НачатьТранзакцию();

	Попытка

		ЗаблокироватьОбъектОчереди(Ссылка);
		Запись = МенеджерЗаписиОчереди(Ссылка);
		Запись.Прочитать();

		Если Запись.Выбран() Тогда

			Запись.Удалить();

		КонецЕсли;

		ЗафиксироватьТранзакцию();

	Исключение

		ОтменитьТранзакцию();
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;

	КонецПопытки;

	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

// Состояние документа в очереди отложенного проведения.
//
// Параметры:
//  Ссылка - ОпределяемыйТип.пбп_ОбъектОтложенногоПроведения - документ очереди.
//
// Возвращаемое значение:
//  Неопределено - документа нет в очереди.
//  Структура - состояние:
//   * Активна - Булево - строка есть и обработка не прекращена.
//   * КоличествоПопыток - Число - сколько ошибок проведения уже зафиксировано.
//   * ДатаСледующейПопытки - Дата - когда задание возьмет документ снова.
//   * ТекстОшибки - Строка - текст последней ошибки.
//   * ОбработкаПрекращена - Булево - попытки исчерпаны или остановлены обработчиком.
//
Функция СостояниеОтложенногоПроведения(Ссылка) Экспорт

	ПривилегированныйРежимБылВключен = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);

	Попытка

		Запись = МенеджерЗаписиОчереди(Ссылка);
		Запись.Прочитать();

	Исключение

		УстановитьПривилегированныйРежим(ПривилегированныйРежимБылВключен);
		ВызватьИсключение;

	КонецПопытки;

	УстановитьПривилегированныйРежим(ПривилегированныйРежимБылВключен);

	Если Не Запись.Выбран() Тогда

		Возврат Неопределено;

	КонецЕсли;

	Состояние = Новый Структура;
	Состояние.Вставить("Активна", Не Запись.ОбработкаПрекращена);
	Состояние.Вставить("КоличествоПопыток", Запись.КоличествоПопыток);
	Состояние.Вставить("ДатаСледующейПопытки", Запись.ДатаСледующейПопытки);
	Состояние.Вставить("ТекстОшибки", Запись.ТекстОшибки);
	Состояние.Вставить("ОбработкаПрекращена", Запись.ОбработкаПрекращена);

	Возврат Состояние;

КонецФункции

// Тело регламентного задания отложенного проведения документов.
// При выключенной функциональной опции завершается без обработки очереди.
//
Процедура ОтложенноеПроведениеДокументов() Экспорт

	Если Не ОтложенноеПроведениеВключено() Тогда

		Возврат;

	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	Попытка

		Порция = ПорцияОчереди();

		Для Каждого СтрокаОчереди Из Порция Цикл

			ОбработатьСтрокуОчереди(СтрокаОчереди.Объект);

		КонецЦикла;

	Исключение

		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;

	КонецПопытки;

	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОтложенноеПроведениеВключено() Экспорт

	// Включено ли отложенное проведение документов.
	// Функциональная опция с привилегированным получением кэшируется на все сеансы.
	// ОбновитьПовторноИспользуемыеЗначения() этот кэш не очищает: в пустой базе
	// первое чтение остается Ложь до перезапуска сеанса. Поэтому читается константа-хранилище.
	//
	// Возвращаемое значение:
	//  Булево - Истина, если отложенное проведение включено.

	ПривилегированныйРежимБылВключен = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Включено = Константы.пбп_ИспользоватьОтложенноеПроведениеДокументов.Получить();
	УстановитьПривилегированныйРежим(ПривилегированныйРежимБылВключен);

	Возврат Включено;

КонецФункции

Функция УстареваниеЗахватаСекунд()

	// Захват старше этого срока считается брошенным и строка снова попадает в порцию.
	Возврат 600;

КонецФункции

Функция ИмяСвойстваОтложенногоПроведения()

	Возврат "пбп_ОтложенноеПроведение";

КонецФункции

Процедура ЗаписатьСтрокуОчереди(Параметры)

	Запись = МенеджерЗаписиОчереди(Параметры.Объект);
	Запись.Прочитать();
	ЭтоНоваяСтрока = Не Запись.Выбран();
	СброситьСчетчик = ЭтоНоваяСтрока Или Параметры.СброситьПопытки;

	Если СброситьСчетчик Тогда

		Запись.КоличествоПопыток = 0;
		Запись.ДатаПоследнейПопытки = Дата(1, 1, 1);
		Запись.ТекстОшибки = "";

	КонецЕсли;

	Запись.Объект = Параметры.Объект;
	Запись.Перепроведение = Параметры.Перепроведение;
	Запись.ОбработкаПрекращена = Ложь;
	Запись.ВОбработке = Ложь;
	Запись.ДатаЗахвата = Дата(1, 1, 1);
	Запись.ОбработчикПередПроведением = Параметры.ОбработчикПередПроведением;
	Запись.ОбработчикПослеПроведения = Параметры.ОбработчикПослеПроведения;
	Запись.ОбработчикОшибкиПроведения = Параметры.ОбработчикОшибкиПроведения;
	Запись.ДополнительныеПараметры = ДополнительныеПараметрыВСтроку(Параметры.ДополнительныеПараметры);

	Если ЗначениеЗаполнено(Параметры.ДатаСледующейПопытки) Тогда

		Запись.ДатаСледующейПопытки = Параметры.ДатаСледующейПопытки;

	Иначе

		Запись.ДатаСледующейПопытки = ТекущаяДатаСеанса();

	КонецЕсли;

	Если ЭтоНоваяСтрока Тогда

		Запись.ДатаДобавления = ТекущаяДатаСеанса();

	КонецЕсли;

	Запись.Записать();

КонецПроцедуры

Процедура ЗаписатьПереопределениеНастроек(Параметры)

	ВремяНеЗадано = Параметры.ВремяОжидания = Неопределено;
	ШагНеЗадан = Параметры.ШагУвеличенияОжидания = Неопределено;
	МаксимумНеЗадан = Параметры.МаксимумПопыток = Неопределено;

	Если ВремяНеЗадано И ШагНеЗадан И МаксимумНеЗадан Тогда

		Возврат;

	КонецЕсли;

	ИмяДокумента = Параметры.Объект.Метаданные().Имя;
	ЗаблокироватьНастройкиДокумента(ИмяДокумента);
	Запись = РегистрыСведений.пбп_НастройкиОтложенногоПроведения.СоздатьМенеджерЗаписи();
	Запись.ИмяДокумента = ИмяДокумента;
	Запись.Прочитать();
	ЭтоНоваяСтрока = Не Запись.Выбран();

	Если ЭтоНоваяСтрока Тогда

		Запись.ИмяДокумента = ИмяДокумента;

	КонецЕсли;

	Если Не ВремяНеЗадано Тогда

		Запись.ВремяОжидания = Параметры.ВремяОжидания;
		Запись.ВремяОжиданияЗадано = Истина;

	ИначеЕсли ЭтоНоваяСтрока Тогда

		Запись.ВремяОжиданияЗадано = Ложь;

	КонецЕсли;

	Если Не ШагНеЗадан Тогда

		Запись.ШагУвеличенияОжидания = Параметры.ШагУвеличенияОжидания;
		Запись.ШагУвеличенияОжиданияЗадан = Истина;

	ИначеЕсли ЭтоНоваяСтрока Тогда

		Запись.ШагУвеличенияОжиданияЗадан = Ложь;

	КонецЕсли;

	Если Не МаксимумНеЗадан Тогда

		Запись.МаксимумПопыток = Параметры.МаксимумПопыток;
		Запись.МаксимумПопытокЗадан = Истина;

	ИначеЕсли ЭтоНоваяСтрока Тогда

		Запись.МаксимумПопытокЗадан = Ложь;

	КонецЕсли;

	Запись.Записать();

КонецПроцедуры

Функция НастройкиОтложенногоПроведения(ИмяДокумента)

	Настройки = НастройкиПоУмолчанию();
	Общие = НастройкиПоИмени("");

	Если Общие <> Неопределено Тогда

		Настройки.ВремяОжидания = Общие.ВремяОжидания;
		Настройки.ШагУвеличенияОжидания = Общие.ШагУвеличенияОжидания;
		Настройки.МаксимумПопыток = Общие.МаксимумПопыток;

	КонецЕсли;

	Если Не ЗначениеЗаполнено(ИмяДокумента) Тогда

		Возврат Настройки;

	КонецЕсли;

	Свои = НастройкиПоИмени(ИмяДокумента);

	Если Свои = Неопределено Тогда

		Возврат Настройки;

	КонецЕсли;

	Если Свои.ВремяОжиданияЗадано Тогда

		Настройки.ВремяОжидания = Свои.ВремяОжидания;

	КонецЕсли;

	Если Свои.ШагУвеличенияОжиданияЗадан Тогда

		Настройки.ШагУвеличенияОжидания = Свои.ШагУвеличенияОжидания;

	КонецЕсли;

	Если Свои.МаксимумПопытокЗадан Тогда

		Настройки.МаксимумПопыток = Свои.МаксимумПопыток;

	КонецЕсли;

	Возврат Настройки;

КонецФункции

Функция НастройкиПоУмолчанию()

	Настройки = Новый Структура;
	Настройки.Вставить("ВремяОжидания", 0);
	Настройки.Вставить("ШагУвеличенияОжидания", 0);
	Настройки.Вставить("МаксимумПопыток", 3);

	Возврат Настройки;

КонецФункции

Функция НастройкиПоИмени(ИмяДокумента)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Настройки.ВремяОжидания КАК ВремяОжидания,
	|	Настройки.ШагУвеличенияОжидания КАК ШагУвеличенияОжидания,
	|	Настройки.МаксимумПопыток КАК МаксимумПопыток,
	|	Настройки.ВремяОжиданияЗадано КАК ВремяОжиданияЗадано,
	|	Настройки.ШагУвеличенияОжиданияЗадан КАК ШагУвеличенияОжиданияЗадан,
	|	Настройки.МаксимумПопытокЗадан КАК МаксимумПопытокЗадан
	|ИЗ
	|	РегистрСведений.пбп_НастройкиОтложенногоПроведения КАК Настройки
	|ГДЕ
	|	Настройки.ИмяДокумента = &ИмяДокумента";
	Запрос.УстановитьПараметр("ИмяДокумента", ИмяДокумента);
	Выборка = Запрос.Выполнить().Выбрать();

	Если Не Выборка.Следующий() Тогда

		Возврат Неопределено;

	КонецЕсли;

	Настройки = Новый Структура;
	Настройки.Вставить("ВремяОжидания", Выборка.ВремяОжидания);
	Настройки.Вставить("ШагУвеличенияОжидания", Выборка.ШагУвеличенияОжидания);
	Настройки.Вставить("МаксимумПопыток", Выборка.МаксимумПопыток);
	Настройки.Вставить("ВремяОжиданияЗадано", Выборка.ВремяОжиданияЗадано);
	Настройки.Вставить("ШагУвеличенияОжиданияЗадан", Выборка.ШагУвеличенияОжиданияЗадан);
	Настройки.Вставить("МаксимумПопытокЗадан", Выборка.МаксимумПопытокЗадан);

	Возврат Настройки;

КонецФункции

Функция ПорцияОчереди()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 50
	|	Очередь.Объект КАК Объект
	|ИЗ
	|	РегистрСведений.пбп_ОтложенноеПроведениеДокументов КАК Очередь
	|ГДЕ
	|	НЕ Очередь.ОбработкаПрекращена
	|	И Очередь.ДатаСледующейПопытки <= &Сейчас
	|	И (НЕ Очередь.ВОбработке
	|		ИЛИ Очередь.ДатаЗахвата < &ГраницаЗахвата)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Очередь.ДатаСледующейПопытки,
	|	Очередь.ДатаДобавления";
	Сейчас = ТекущаяДатаСеанса();
	Запрос.УстановитьПараметр("Сейчас", Сейчас);
	Запрос.УстановитьПараметр("ГраницаЗахвата", Сейчас - УстареваниеЗахватаСекунд());

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Процедура ОбработатьСтрокуОчереди(Ссылка)

	Если Не ЗахватитьСтроку(Ссылка) Тогда

		Возврат;

	КонецЕсли;

	НачатьТранзакцию();

	Попытка

		ПровестиЗахваченныйДокумент(Ссылка);
		ЗафиксироватьТранзакцию();

	Исключение

		ОтменитьТранзакцию();
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗафиксироватьОшибкуПроведения(Ссылка, ТекстОшибки);

	КонецПопытки;

КонецПроцедуры

Функция ЗахватитьСтроку(Ссылка)

	Захвачена = Ложь;
	НачатьТранзакцию();

	Попытка

		ЗаблокироватьОбъектОчереди(Ссылка);
		Запись = МенеджерЗаписиОчереди(Ссылка);
		Запись.Прочитать();

		Если СтрокаДоступнаДляЗахвата(Запись) Тогда

			Запись.ВОбработке = Истина;
			Запись.ДатаЗахвата = ТекущаяДатаСеанса();
			Запись.Записать();
			ЗафиксироватьТранзакцию();
			Захвачена = Истина;

		Иначе

			ОтменитьТранзакцию();

		КонецЕсли;

	Исключение

		ОтменитьТранзакцию();
		ВызватьИсключение;

	КонецПопытки;

	Возврат Захвачена;

КонецФункции

Функция СтрокаДоступнаДляЗахвата(Запись)

	Если Не Запись.Выбран() Тогда

		Возврат Ложь;

	КонецЕсли;

	Если Запись.ОбработкаПрекращена Тогда

		Возврат Ложь;

	КонецЕсли;

	Сейчас = ТекущаяДатаСеанса();

	Если Запись.ДатаСледующейПопытки > Сейчас Тогда

		Возврат Ложь;

	КонецЕсли;

	ГраницаЗахвата = Сейчас - УстареваниеЗахватаСекунд();
	ЗахватСвежий = Запись.ВОбработке И Запись.ДатаЗахвата >= ГраницаЗахвата;

	Возврат Не ЗахватСвежий;

КонецФункции

Процедура ПровестиЗахваченныйДокумент(Ссылка)

	ЗаблокироватьОбъектОчереди(Ссылка);
	Запись = МенеджерЗаписиОчереди(Ссылка);
	Запись.Прочитать();

	Если Не Запись.Выбран() Тогда

		Возврат;

	КонецЕсли;

	ДокументОбъект = Ссылка.ПолучитьОбъект();
	СнятьСОчереди = ДокументОбъект = Неопределено;

	Если Не СнятьСОчереди И ДокументОбъект.ПометкаУдаления Тогда

		СнятьСОчереди = Истина;

	КонецЕсли;

	Если Не СнятьСОчереди И ДокументОбъект.Проведен И Не Запись.Перепроведение Тогда

		СнятьСОчереди = Истина;

	КонецЕсли;

	Если СнятьСОчереди Тогда

		Запись.Удалить();
		Возврат;

	КонецЕсли;

	Контекст = КонтекстПроведения(Запись, "");
	ВызватьОбработчик(Запись.ОбработчикПередПроведением, ДокументОбъект, Контекст);
	ОбеспечитьПривилегированныйРежим();

	Если Контекст.ПрекратитьПопытки Тогда

		Запись.ОбработкаПрекращена = Истина;
		Запись.ВОбработке = Ложь;
		Запись.ДатаЗахвата = Дата(1, 1, 1);
		Запись.Записать();
		Возврат;

	КонецЕсли;

	Если Контекст.ТребуетсяПроведение Тогда

		ИмяСвойства = ИмяСвойстваОтложенногоПроведения();
		ДокументОбъект.ДополнительныеСвойства.Вставить(ИмяСвойства, Истина);

		Если Контекст.ВыполнитьКонтрольЗаполнения И Не ДокументОбъект.ПроверитьЗаполнение() Тогда

			ВызватьИсключение НСтр("ru = 'Не пройдена проверка заполнения документа.'");

		КонецЕсли;

		ДокументОбъект.Записать(Контекст.РежимЗаписи);
		ВызватьОбработчик(Запись.ОбработчикПослеПроведения, ДокументОбъект, Контекст);
		ОбеспечитьПривилегированныйРежим();

	КонецЕсли;

	Запись.Удалить();

КонецПроцедуры

Процедура ЗафиксироватьОшибкуПроведения(Ссылка, ТекстОшибки)

	Запись = МенеджерЗаписиОчереди(Ссылка);
	Запись.Прочитать();

	Если Не Запись.Выбран() Тогда

		Возврат;

	КонецЕсли;

	Настройки = НастройкиОтложенногоПроведения(Ссылка.Метаданные().Имя);
	НомерПопытки = Запись.КоличествоПопыток + 1;
	Контекст = КонтекстПроведения(Запись, ТекстОшибки);
	Контекст.НомерПопытки = НомерПопытки;
	Контекст.ЭтоПоследняяПопытка = НомерПопытки >= Настройки.МаксимумПопыток;
	ДокументОбъект = Ссылка.ПолучитьОбъект();
	ВызватьОбработчикОшибки(Запись.ОбработчикОшибкиПроведения, ДокументОбъект, Контекст);
	ОбеспечитьПривилегированныйРежим();

	НачатьТранзакцию();

	Попытка

		ЗаблокироватьОбъектОчереди(Ссылка);
		Запись.Прочитать();

		Если Запись.Выбран() Тогда

			Сейчас = ТекущаяДатаСеанса();
			НомерПопытки = Запись.КоличествоПопыток + 1;
			Запись.КоличествоПопыток = НомерПопытки;
			Запись.ДатаПоследнейПопытки = Сейчас;
			Запись.ТекстОшибки = Контекст.ТекстОшибки;
			Запись.ДатаСледующейПопытки = ДатаСледующейПопытки(Контекст, Настройки, НомерПопытки, Сейчас);
			ПопыткиИсчерпаны = НомерПопытки >= Настройки.МаксимумПопыток;
			Запись.ОбработкаПрекращена = ПопыткиИсчерпаны Или Контекст.ПрекратитьПопытки;
			Запись.ВОбработке = Ложь;
			Запись.ДатаЗахвата = Дата(1, 1, 1);
			Запись.Записать();

		КонецЕсли;

		ЗафиксироватьТранзакцию();

	Исключение

		ОтменитьТранзакцию();
		ВызватьИсключение;

	КонецПопытки;

КонецПроцедуры

Функция ДатаСледующейПопытки(Контекст, Настройки, НомерПопытки, Сейчас)

	Если ЗначениеЗаполнено(Контекст.ДатаСледующейПопытки) Тогда

		Возврат Контекст.ДатаСледующейПопытки;

	КонецЕсли;

	СдвигСекунд = Настройки.ВремяОжидания + Настройки.ШагУвеличенияОжидания * НомерПопытки;

	Возврат Сейчас + СдвигСекунд;

КонецФункции

Функция КонтекстПроведения(Запись, ТекстОшибки)

	Настройки = НастройкиОтложенногоПроведения(Запись.Объект.Метаданные().Имя);
	НомерПопытки = Запись.КоличествоПопыток + 1;
	Контекст = Новый Структура;
	Контекст.Вставить("Перепроведение", Запись.Перепроведение);
	Контекст.Вставить("ДополнительныеПараметры", ДополнительныеПараметрыИзСтроки(Запись.ДополнительныеПараметры));
	Контекст.Вставить("НомерПопытки", НомерПопытки);
	Контекст.Вставить("ЭтоПоследняяПопытка", НомерПопытки >= Настройки.МаксимумПопыток);
	Контекст.Вставить("ТребуетсяПроведение", Истина);
	Контекст.Вставить("ВыполнитьКонтрольЗаполнения", Истина);
	Контекст.Вставить("РежимЗаписи", РежимЗаписиДокумента.Проведение);
	Контекст.Вставить("ТекстОшибки", ТекстОшибки);
	Контекст.Вставить("ПрекратитьПопытки", Ложь);
	Контекст.Вставить("ДатаСледующейПопытки", Дата(1, 1, 1));

	Возврат Контекст;

КонецФункции

Процедура ВызватьОбработчик(ИмяОбработчика, ДокументОбъект, Контекст)

	Если Не ЗначениеЗаполнено(ИмяОбработчика) Тогда

		Возврат;

	КонецЕсли;

	ПараметрыВызова = Новый Массив;
	ПараметрыВызова.Добавить(ДокументОбъект);
	ПараметрыВызова.Добавить(Контекст);
	пбп_Переадресация.ВыполнитьМетодКонфигурации(ИмяОбработчика, ПараметрыВызова);

КонецПроцедуры

Процедура ВызватьОбработчикОшибки(ИмяОбработчика, ДокументОбъект, Контекст)

	Если ДокументОбъект = Неопределено Или Не ЗначениеЗаполнено(ИмяОбработчика) Тогда

		Возврат;

	КонецЕсли;

	Попытка

		ВызватьОбработчик(ИмяОбработчика, ДокументОбъект, Контекст);

	Исключение

		Контекст.ТекстОшибки = Контекст.ТекстОшибки + Символы.ПС + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());

	КонецПопытки;

КонецПроцедуры

Процедура ОбеспечитьПривилегированныйРежим()

	Если Не ПривилегированныйРежим() Тогда

		УстановитьПривилегированныйРежим(Истина);

	КонецЕсли;

КонецПроцедуры

Процедура ЗаблокироватьНастройкиДокумента(ИмяДокумента)

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.пбп_НастройкиОтложенногоПроведения");
	ЭлементБлокировки.УстановитьЗначение("ИмяДокумента", ИмяДокумента);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();

КонецПроцедуры

Процедура ЗаблокироватьОбъектОчереди(Ссылка)

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.пбп_ОтложенноеПроведениеДокументов");
	ЭлементБлокировки.УстановитьЗначение("Объект", Ссылка);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();

КонецПроцедуры

Функция МенеджерЗаписиОчереди(Ссылка)

	Запись = РегистрыСведений.пбп_ОтложенноеПроведениеДокументов.СоздатьМенеджерЗаписи();
	Запись.Объект = Ссылка;

	Возврат Запись;

КонецФункции

Функция ДополнительныеПараметрыВСтроку(Значение)

	Если Значение = Неопределено Тогда

		Возврат "";

	КонецЕсли;

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	Настройки = Новый НастройкиСериализацииJSON;
	Настройки.ФорматСериализацииДаты = ФорматДатыJSON.ISO;
	Настройки.ВариантЗаписиДаты = ВариантЗаписиДатыJSON.ЛокальнаяДата;
	ЗаписатьJSON(Запись, ПодготовитьЗначениеДляЗаписи(Значение), Настройки);

	Возврат Запись.Закрыть();

КонецФункции

Функция ДополнительныеПараметрыИзСтроки(Текст)

	Если Не ЗначениеЗаполнено(Текст) Тогда

		Возврат Новый Структура;

	КонецЕсли;

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Значение = ПрочитатьJSON(Чтение, Ложь, , ФорматДатыJSON.ISO);
	Чтение.Закрыть();

	Возврат ВосстановитьЗначениеИзЗаписи(Значение);

КонецФункции

Функция ПодготовитьЗначениеДляЗаписи(Значение)

	Если ЭтоСсылка(Значение) Тогда

		ОписаниеСсылки = Новый Структура;
		ОписаниеСсылки.Вставить("пбпСсылка", Истина);
		ОписаниеСсылки.Вставить("Тип", XMLТипЗнч(Значение).ИмяТипа);
		ОписаниеСсылки.Вставить("Идентификатор", XMLСтрока(Значение));

		Возврат ОписаниеСсылки;

	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("Дата") Тогда

		ОписаниеДаты = Новый Структура;
		ОписаниеДаты.Вставить("пбпДата", Истина);
		ОписаниеДаты.Вставить("Значение", XMLСтрока(Значение));

		Возврат ОписаниеДаты;

	КонецЕсли;

	Если ТипЗначения = Тип("Структура") Тогда

		Результат = Новый Структура;

		Для Каждого КлючИЗначение Из Значение Цикл

			Результат.Вставить(КлючИЗначение.Ключ, ПодготовитьЗначениеДляЗаписи(КлючИЗначение.Значение));

		КонецЦикла;

		Возврат Результат;

	КонецЕсли;

	Если ТипЗначения = Тип("Соответствие") Тогда

		Результат = Новый Соответствие;

		Для Каждого КлючИЗначение Из Значение Цикл

			Результат.Вставить(КлючИЗначение.Ключ, ПодготовитьЗначениеДляЗаписи(КлючИЗначение.Значение));

		КонецЦикла;

		Возврат Результат;

	КонецЕсли;

	Если ТипЗначения = Тип("Массив") Тогда

		Результат = Новый Массив;

		Для Каждого Элемент Из Значение Цикл

			Результат.Добавить(ПодготовитьЗначениеДляЗаписи(Элемент));

		КонецЦикла;

		Возврат Результат;

	КонецЕсли;

	Если Значение = Неопределено Тогда

		Возврат Null;

	КонецЕсли;

	Возврат Значение;

КонецФункции

Функция ВосстановитьЗначениеИзЗаписи(Значение)

	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("Структура") Тогда

		Маркер = ВосстановитьМаркер(Значение);

		Если Маркер <> Неопределено Тогда

			Возврат Маркер;

		КонецЕсли;

		Результат = Новый Структура;

		Для Каждого КлючИЗначение Из Значение Цикл

			Результат.Вставить(КлючИЗначение.Ключ, ВосстановитьЗначениеИзЗаписи(КлючИЗначение.Значение));

		КонецЦикла;

		Возврат Результат;

	КонецЕсли;

	Если ТипЗначения = Тип("Соответствие") Тогда

		Результат = Новый Соответствие;

		Для Каждого КлючИЗначение Из Значение Цикл

			Результат.Вставить(КлючИЗначение.Ключ, ВосстановитьЗначениеИзЗаписи(КлючИЗначение.Значение));

		КонецЦикла;

		Возврат Результат;

	КонецЕсли;

	Если ТипЗначения = Тип("Массив") Тогда

		Результат = Новый Массив;

		Для Каждого Элемент Из Значение Цикл

			Результат.Добавить(ВосстановитьЗначениеИзЗаписи(Элемент));

		КонецЦикла;

		Возврат Результат;

	КонецЕсли;

	Возврат Значение;

КонецФункции

Функция ВосстановитьМаркер(Значение)

	Если Значение.Свойство("пбпСсылка") И Значение.пбпСсылка Тогда

		ТипXML = Новый ТипДанныхXML(Значение.Тип, "");
		ТипСсылки = ИзXMLТипа(ТипXML);

		Если ТипСсылки = Неопределено Тогда

			Возврат Значение;

		КонецЕсли;

		Возврат XMLЗначение(ТипСсылки, Значение.Идентификатор);

	КонецЕсли;

	Если Значение.Свойство("пбпДата") И Значение.пбпДата Тогда

		Возврат XMLЗначение(Тип("Дата"), Значение.Значение);

	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ЭтоСсылка(Значение)

	Если Значение = Неопределено Или Значение = Null Тогда

		Возврат Ложь;

	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);

	Возврат Документы.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или Справочники.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или ПланыВидовХарактеристик.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или ПланыСчетов.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или ПланыВидовРасчета.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или ПланыОбмена.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или БизнесПроцессы.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или Задачи.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или Перечисления.ТипВсеСсылки().СодержитТип(ТипЗначения);

КонецФункции

#КонецОбласти
