КонецФункции

// Карта имени реквизита, которым ссылка выгружается в универсальном формате.
// Ключ - тип ссылки, значение - имя метода, возвращающего имя реквизита.
//
// Возвращаемое значение:
//  Соответствие - пустая карта ядра. Конфигурация-потребитель наполняет ее.
//
Функция ИменаМетодовИмениРеквизитаВыгрузки() Экспорт
	
	СоответствиеТипов = Новый Соответствие;
	СоответствиеТипов.Вставить(Тип("СправочникСсылка.пбп_ИнтегрируемыеСистемы"),
		"пбп_ИнтеграцииИсходящие.ПолеВыгрузки_ИнтегрируемаяСистема");
	СоответствиеТипов.Вставить(Тип("СправочникСсылка.пбп_ТипыИнтеграций"),
		"пбп_ИнтеграцииИсходящие.ПолеВыгрузки_ТипИнтеграции");
	
	Возврат ОбработатьСоответствиеФункций(СоответствиеТипов);
	
КонецФункции

#КонецОбласти // СлужебныйПрограммныйИнтерфейс

#Область СлужебныеПроцедурыИФункции

Функция ОбработатьСоответствиеФункций(СоответствиеФункций)
	
	Результат = Новый Соответствие;
	
	Для Каждого КлючИЗначение Из СоответствиеФункций Цикл
		
		Результат.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение + "()");
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьНаименованиеПубличныхИдентификаторов()
	
	Возврат "ПубличныеИдентификаторыСинхронизируемыхОбъектов";
	
КонецФункции

#КонецОбласти // СлужебныеПроцедурыИФункции
