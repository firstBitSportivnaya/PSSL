#Область ПрограммныйИнтерфейс

// Возвращает часовой пояс информационной базы.
//
// Возвращаемое значение:
//  Строка - идентификатор часового пояса.
//
Функция ЧасовойПоясБазыДанных() Экспорт
	
	Возврат ПолучитьЧасовойПоясИнформационнойБазы();
	
КонецФункции

// Описание регистра публичных идентификаторов. Результат кэшируется на время сеанса.
// 
// Если ПБП без БСП, тогда по умолчанию всегда используется пбп_СоответствиеОбъектовИнтегрируемыхСистем.
// Если БСП есть в конфигурации, то запись публичных идентификаторов в соответствующий регистр регулируется
// предопределенным значением "ИспользоватьПубличныеИдентификаторыСинхронизируемыхОбъектов".
// Необходимо потому, что соответствия объектов может использоваться вместе с публичными идентификаторами,
// но для разных целей. Например, в соответствия можно положить мигрированные объекты, чтобы не потерять
// идентификаторы и номера/коды исторических данных, а публичные идентификаторы для интеграций.
// Или использовать публичные идентификаторы для интеграций через КД 3.0, а соответствия объектов
// интегрируемых систем для нетиповых интеграций, и т.д. Либо использовать только публичные идентификаторы.
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура - Использовать, ЭтоРегистрБСП, ИмяТаблицы, ИмяСсылки, ИмяИдентификатора, ИмяУзла, ДлинаИдентификатора.
//
Функция ОписаниеРегистраПубличныхИдентификаторов() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Использовать", Ложь);
	Результат.Вставить("ЭтоРегистрБСП", Ложь);
	Результат.Вставить("ИмяТаблицы", "");
	Результат.Вставить("ИмяСсылки", "");
	Результат.Вставить("ИмяИдентификатора", "");
	Результат.Вставить("ИмяУзла", "");
	Результат.Вставить("ДлинаИдентификатора", 36);
	
	Если пбп_Переадресация.ПодсистемаСуществует("СтандартныеПодсистемы")
		И РегистрПубличныхИдентификаторовСуществует() Тогда
		
		ИспользоватьПубличныеИдентификаторы = пбп_ОбщегоНазначенияСервер.ПолучитьПредопределенноеЗначение(
			"ИспользоватьПубличныеИдентификаторыСинхронизируемыхОбъектов", Истина);
		
		Если пбп_ОбщегоНазначенияСервер.ПолучитьЗначениеКонстанты(
			"пбп_ИспользоватьСоответствияОбъектовИнтегрируемыхСистем")
			И Не ИспользоватьПубличныеИдентификаторы Тогда
			ЗаполнитьПараметрыИспользованияСоответствияОбъектовИнтегрируемыхСистем(Результат);
		Иначе
			Результат.Использовать = Истина;
			Результат.ЭтоРегистрБСП = Истина;
			Результат.ИмяТаблицы = "РегистрСведений." + ПолучитьНаименованиеПубличныхИдентификаторов();
			Результат.ИмяСсылки = "Ссылка";
			Результат.ИмяИдентификатора = "Идентификатор";
			Результат.ИмяУзла = "УзелИнформационнойБазы";
			Результат.ДлинаИдентификатора = 36;
		КонецЕсли;
	Иначе
		ЗаполнитьПараметрыИспользованияСоответствияОбъектовИнтегрируемыхСистем(Результат);
	КонецЕсли;
	
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

// Проверяет, что в конфигурации есть регистр сведений публичных идентификаторов БСП.
//
// Возвращаемое значение:
//  Булево - Истина, если регистр ПубличныеИдентификаторыСинхронизируемыхОбъектов есть в метаданных.
Функция РегистрПубличныхИдентификаторовСуществует() Экспорт
	
	ИмяРегистраБСП = ПолучитьНаименованиеПубличныхИдентификаторов();
	Возврат Метаданные.РегистрыСведений.Найти(ИмяРегистраБСП) <> Неопределено;
	
КонецФункции

// Вычисляет метод переопределения и кэширует результат на время сеанса.
//
// Параметры:
//  ИмяФункции - Строка - имя метода с круглыми скобками.
//
// Возвращаемое значение:
//  Произвольный, Неопределено - результат метода.
//
Функция РезультатПереопределения(ИмяФункции) Экспорт
	
	Если Не ЗначениеЗаполнено(ИмяФункции) Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	Возврат пбп_Переадресация.ВычислитьВБезопасномРежиме(ИмяФункции);
	
КонецФункции

// Полное имя первого плана обмена из определяемого типа пбп_УзелПланаОбменаИнтеграций.
// Результат кэшируется на время сеанса.
//
// Возвращаемое значение:
//  Строка - полное имя плана обмена. Пустая строка, если план обмена не задан.
//
Функция ПолноеИмяПланаОбменаИнтеграций() Экспорт
	
	ТипыУзла = Метаданные.ОпределяемыеТипы.пбп_УзелПланаОбменаИнтеграций.Тип.Типы();
	
	Для Каждого ТипУзла Из ТипыУзла Цикл
		
		ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипУзла);
		
		Если ОбъектМетаданных = Неопределено Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		НайденныйПлан = Метаданные.ПланыОбмена.Найти(ОбъектМетаданных.Имя);
		
		Если НайденныйПлан = ОбъектМетаданных Тогда
			
			Возврат НайденныйПлан.ПолноеИмя();
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

#КонецОбласти // ПрограммныйИнтерфейс

#Область СлужебныйПрограммныйИнтерфейс

// Карта обработчиков полей, которые не заполняются универсальной загрузкой.
// Ядро библиотеки возвращает пустое соответствие. Конфигурация-потребитель наполняет карту.
//
// Возвращаемое значение:
//  Соответствие - ключ потока, значение - имя метода с круглыми скобками.
//
Функция ИменаМетодовПолейНеОбрабатываемыхУниверсальнойЗагрузкой() Экспорт
	
	ИменаМетодов = Новый Соответствие;
	ИменаМетодов.Вставить("ПолучениеИнтеграционногоПотока",
		"пбп_ИнтеграцииВходящие.Справочник_пбп_ИнтеграционныеПотоки_ПоляНеОбрабатываемыеУниверсальнойЗагрузкой");
	
	Возврат ОбработатьСоответствиеФункций(ИменаМетодов);
	
КонецФункции

// Карта обработчиков соответствия полей источника и приемника.
//
// Возвращаемое значение:
//  Соответствие - ключ потока, значение - имя метода с круглыми скобками.
//
Функция ИменаМетодовСоответствияПолейИсточникаИПриемника() Экспорт
	
	ИменаМетодов = Новый Соответствие;
	ИменаМетодов.Вставить("ПолучениеИнтеграционногоПотока",
		"пбп_ИнтеграцииВходящие.Справочник_пбп_ИнтеграционныеПотоки_СоответствиеПолейИсточникаИПриемника");
	ИменаМетодов.Вставить("ПолучениеДемоДокумента",
		"пбп_ИнтеграцииВходящие.Документ_ДемоРаботаСФормами_СоответствиеПолейИсточникаИПриемника");
	
	Возврат ОбработатьСоответствиеФункций(ИменаМетодов);
	
КонецФункции

// Карта обработчиков полей поиска.
//
// Возвращаемое значение:
//  Соответствие - ключ потока, значение - имя метода с круглыми скобками.
//
Функция ИменаМетодовПолейПоиска() Экспорт
	
	ИменаМетодов = Новый Соответствие;
	ИменаМетодов.Вставить("ПолучениеИнтеграционногоПотока",
		"пбп_ИнтеграцииВходящие.Справочник_пбп_ИнтеграционныеПотоки_ПоляПоиска");
	ИменаМетодов.Вставить("ПолучениеДемоДокумента",
		"пбп_ИнтеграцииВходящие.Документ_ДемоРаботаСФормами_ПоляПоиска");
	
	Возврат ОбработатьСоответствиеФункций(ИменаМетодов);
	
КонецФункции

// Карта обработчиков соответствия типов полей.
//
// Возвращаемое значение:
//  Соответствие - ключ потока, значение - имя метода с круглыми скобками.
//
Функция ИменаМетодовСоответствияТиповПолей() Экспорт
	
	ИменаМетодов = Новый Соответствие;
	ИменаМетодов.Вставить("ПолучениеИнтеграционногоПотока",
		"пбп_ИнтеграцииВходящие.Справочник_пбп_ИнтеграционныеПотоки_СоответствиеТиповПолей");
	
	Возврат ОбработатьСоответствиеФункций(ИменаМетодов);
	
КонецФункции

// Карта процедур постобработки.
// Круглые скобки не добавляются: вызывающий код передаёт имя в ВыполнитьМетодКонфигурации.
//
// Возвращаемое значение:
//  Соответствие - ключ потока, значение - имя процедуры.
//
Функция ИменаМетодовПостобработкиОбъектов() Экспорт
	
	ИменаМетодов = Новый Соответствие;
	ИменаМетодов.Вставить("ПолучениеИнтеграционногоПотока",
		"пбп_ИнтеграцииВходящие.Справочник_пбп_ИнтеграционныеПотоки_Постобработка");
	
	Возврат ИменаМетодов;
	
КонецФункции

// Карта имени реквизита, которым ссылка выгружается в универсальном формате.
// Ключ - тип ссылки, значение - имя метода, возвращающего имя реквизита.
//
// Возвращаемое значение:
//  Соответствие - пустая карта ядра. Конфигурация-потребитель наполняет ее.
//
Функция ИменаМетодовИмениРеквизитаВыгрузки() Экспорт
	
	СоответствиеТипов = Новый Соответствие;
	СоответствиеТипов.Вставить(Тип("СправочникСсылка.пбп_ИнтегрируемыеСистемы"),
		"пбп_ИнтеграцииИсходящие.ПолеВыгрузки_ИнтегрируемаяСистема");
	СоответствиеТипов.Вставить(Тип("СправочникСсылка.пбп_ТипыИнтеграций"),
		"пбп_ИнтеграцииИсходящие.ПолеВыгрузки_ТипИнтеграции");
	
	Возврат ОбработатьСоответствиеФункций(СоответствиеТипов);
	
КонецФункции

#КонецОбласти // СлужебныйПрограммныйИнтерфейс

#Область СлужебныеПроцедурыИФункции

Функция ОбработатьСоответствиеФункций(СоответствиеФункций)
	
	Результат = Новый Соответствие;
	
	Для Каждого КлючИЗначение Из СоответствиеФункций Цикл
		
		Результат.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение + "()");
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьНаименованиеПубличныхИдентификаторов()
	
	Возврат "ПубличныеИдентификаторыСинхронизируемыхОбъектов";
	
КонецФункции

Процедура ЗаполнитьПараметрыИспользованияСоответствияОбъектовИнтегрируемыхСистем(Результат)
	
	Результат.Использовать = Истина;
	Результат.ИмяТаблицы = "РегистрСведений.пбп_СоответствиеОбъектовИнтегрируемыхСистем";
	Результат.ИмяСсылки = "СсылкаНаОбъект";
	Результат.ИмяИдентификатора = "ИдентификаторСистемы";
	Результат.ИмяУзла = "ИнтегрируемаяСистема";
	Результат.ДлинаИдентификатора = 100;
	
КонецПроцедуры

#КонецОбласти // СлужебныеПроцедурыИФункции
