//  Соответствие - ключ потока, значение - имя метода с круглыми скобками.
//
Функция ИменаМетодовСоответствияПолейИсточникаИПриемника() Экспорт
	
	ИменаМетодов = Новый Соответствие;
	ИменаМетодов.Вставить("ПолучениеИнтеграционногоПотока",
		"пбп_ИнтеграцииВходящие.Справочник_пбп_ИнтеграционныеПотоки_СоответствиеПолейИсточникаИПриемника");
	ИменаМетодов.Вставить("ПолучениеДемоДокумента",
		"пбп_ИнтеграцииВходящие.Документ_ДемоРаботаСФормами_СоответствиеПолейИсточникаИПриемника");
	
	Возврат ОбработатьСоответствиеФункций(ИменаМетодов);
	
КонецФункции

