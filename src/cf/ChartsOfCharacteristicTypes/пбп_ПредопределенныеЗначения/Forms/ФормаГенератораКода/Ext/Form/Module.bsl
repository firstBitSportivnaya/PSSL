#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не ПравоДоступа("Изменение", Метаданные.ПланыВидовХарактеристик.пбп_ПредопределенныеЗначения) Тогда
		
		ВызватьИсключение НСтр("ru = 'Недостаточно прав для генерации кода предопределенных значений.'");
		
	КонецЕсли;
	
	УстановитьЗначенияПоУмолчанию();
	ЗаполнитьСпискиВыбора();
	НастроитьВидимостьЭлементов(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ЭтоГруппаПриИзменении(Элемент)
	
	НастроитьВидимостьЭлементов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидТипаПриИзменении(Элемент)
	
	НастроитьВидимостьЭлементов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ИдентификаторРодительПриИзменении(Элемент)
	
	УровеньИерархии = УровеньИерархииПоРодителю(ИдентификаторРодитель);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сгенерировать(Команда)
	
	Если Не ЗначениеЗаполнено(Наименование) Или Не ЗначениеЗаполнено(ИдентификаторНастройки) Тогда
		
		ПоказатьПредупреждение(, НСтр("ru = 'Заполните наименование и идентификатор.'"));
		Возврат;
		
	КонецЕсли;
	
	Код = КодЭлементаНаСервере(ОписаниеЭлемента());
	
КонецПроцедуры

// Код элемента. Состав типа плана читается на сервере.
//
&НаСервереБезКонтекста
Функция КодЭлементаНаСервере(Знач Описание)
	
	Описание.Вставить("ДопустимыеИменаТипов", пбп_ПредопределенныеЗначения.ИменаТиповПлана());
	
	Возврат пбп_ПредопределенныеЗначенияКлиентСервер.КодЭлементаПредопределенногоЗначения(Описание);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьЗначенияПоУмолчанию()
	
	ВидТипа = "Строка";
	ДопустимаяДлина = "Переменная";
	ЧастиДаты = "Дата";
	Разрядность = 10;
	РазрядностьДробнойЧасти = 0;
	ДлинаСтроки = 0;
	УровеньИерархии = 0;
	
КонецПроцедуры

// Уровень иерархии группы: 0 без родителя, иначе уровень родителя плюс 1.
//
// Параметры:
//  ИдентификаторРодителя - Строка - идентификатор группы-родителя.
//
// Возвращаемое значение:
//  Число - уровень иерархии.
//
&НаСервереБезКонтекста
Функция УровеньИерархииПоРодителю(Знач ИдентификаторРодителя)
	
	Родители = РодителиГрупп();
	Уровень = 0;
	ТекущийИдентификатор = ИдентификаторРодителя;
	Просмотренные = Новый Соответствие;
	
	Пока ЗначениеЗаполнено(ТекущийИдентификатор) Цикл
		
		Если Просмотренные[ТекущийИдентификатор] <> Неопределено Тогда
			
			Прервать;
			
		КонецЕсли;
		
		ИдентификаторВыше = Родители[ТекущийИдентификатор];
		
		Если ИдентификаторВыше = Неопределено Тогда
			
			Прервать;
			
		КонецЕсли;
		
		Просмотренные.Вставить(ТекущийИдентификатор, Истина);
		Уровень = Уровень + 1;
		
		Если Не ЗначениеЗаполнено(ИдентификаторВыше) Тогда
			
			Прервать;
			
		КонецЕсли;
		
		ТекущийИдентификатор = ИдентификаторВыше;
		
	КонецЦикла;
	
	Возврат Уровень;
	
КонецФункции

&НаСервереБезКонтекста
Функция РодителиГрупп()
	
	Родители = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПВХ.ИдентификаторНастройки КАК Идентификатор,
	|	ПВХ.Родитель.ИдентификаторНастройки КАК ИдентификаторРодителя
	|ИЗ
	|	ПланВидовХарактеристик.пбп_ПредопределенныеЗначения КАК ПВХ
	|ГДЕ
	|	ПВХ.ЭтоГруппа
	|	И НЕ ПВХ.ПометкаУдаления
	|	И ПВХ.ИдентификаторНастройки <> &ПустойИдентификатор";
	Запрос.УстановитьПараметр("ПустойИдентификатор", "");
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Родители[Выборка.Идентификатор] <> Неопределено Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		ИдентификаторВыше = "";
		
		Если ЗначениеЗаполнено(Выборка.ИдентификаторРодителя) Тогда
			
			ИдентификаторВыше = Выборка.ИдентификаторРодителя;
			
		КонецЕсли;
		
		Родители.Вставить(Выборка.Идентификатор, ИдентификаторВыше);
		
	КонецЦикла;
	
	Возврат Родители;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьСпискиВыбора()
	
	Элементы.ВидТипа.РежимВыбораИзСписка = Истина;
	Элементы.ВидТипа.СписокВыбора.Очистить();
	
	Для Каждого ИмяТипа Из пбп_ПредопределенныеЗначения.ИменаТиповПлана() Цикл
		
		Элементы.ВидТипа.СписокВыбора.Добавить(ИмяТипа);
		
	КонецЦикла;
	
	Элементы.ДопустимаяДлина.РежимВыбораИзСписка = Истина;
	Элементы.ДопустимаяДлина.СписокВыбора.Очистить();
	Элементы.ДопустимаяДлина.СписокВыбора.Добавить("Переменная");
	Элементы.ДопустимаяДлина.СписокВыбора.Добавить("Фиксированная");
	Элементы.ДопустимаяДлина.Заголовок = НСтр("ru = 'Допустимая длина'");
	
	Элементы.ЧастиДаты.РежимВыбораИзСписка = Истина;
	Элементы.ЧастиДаты.СписокВыбора.Очистить();
	Элементы.ЧастиДаты.СписокВыбора.Добавить("Дата");
	Элементы.ЧастиДаты.СписокВыбора.Добавить("Время");
	Элементы.ЧастиДаты.СписокВыбора.Добавить("ДатаВремя");
	Элементы.ЧастиДаты.Заголовок = НСтр("ru = 'Части даты'");
	
	Элементы.ИдентификаторРодитель.РежимВыбораИзСписка = Истина;
	Элементы.ИдентификаторРодитель.СписокВыбора.Очистить();
	
	Для Каждого ПараРодителя Из РодителиГрупп() Цикл
		
		Элементы.ИдентификаторРодитель.СписокВыбора.Добавить(ПараРодителя.Ключ);
		
	КонецЦикла;
	
	Элементы.ИдентификаторРодитель.СписокВыбора.СортироватьПоЗначению();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьЭлементов(Форма)
	
	ЭлементыФормы = Форма.Элементы;
	ЭтоГруппа = Форма.ЭтоГруппа;
	ВидТипа = Форма.ВидТипа;
	ПоказыватьТип = Не ЭтоГруппа;
	
	ЭлементыФормы.ГруппаПараметрыЭлемента.Видимость = ПоказыватьТип;
	ЭлементыФормы.ГруппаТипЗначения.Видимость = ПоказыватьТип;
	ЭлементыФормы.ГруппаКвалификаторСтроки.Видимость = ПоказыватьТип И ВидТипа = "Строка";
	ЭлементыФормы.ГруппаКвалификаторЧисла.Видимость = ПоказыватьТип И ВидТипа = "Число";
	ЭлементыФормы.ГруппаКвалификаторДаты.Видимость = ПоказыватьТип И ВидТипа = "Дата";
	
КонецПроцедуры

&НаКлиенте
Функция ОписаниеЭлемента()
	
	Описание = Новый Структура;
	Описание.Вставить("Наименование", Наименование);
	Описание.Вставить("ИдентификаторНастройки", ИдентификаторНастройки);
	Описание.Вставить("ЭтоГруппа", ЭтоГруппа);
	Описание.Вставить("ИдентификаторРодитель", ИдентификаторРодитель);
	Описание.Вставить("УровеньИерархии", УровеньИерархии);
	Описание.Вставить("Пароль", Пароль);
	Описание.Вставить("СписокЗначений", СписокЗначений);
	Описание.Вставить("Кэшируется", Кэшируется);
	Описание.Вставить("ВидТипа", ВидТипа);
	Описание.Вставить("ДлинаСтроки", ДлинаСтроки);
	Описание.Вставить("ДопустимаяДлина", ДопустимаяДлина);
	Описание.Вставить("Разрядность", Разрядность);
	Описание.Вставить("РазрядностьДробнойЧасти", РазрядностьДробнойЧасти);
	Описание.Вставить("Неотрицательное", Неотрицательное);
	Описание.Вставить("ЧастиДаты", ЧастиДаты);
	Описание.Вставить("ИмяТипа", ИмяТипа);
	
	Возврат Описание;
	
КонецФункции

#КонецОбласти
