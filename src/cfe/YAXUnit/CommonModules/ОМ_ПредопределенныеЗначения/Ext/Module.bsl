Процедура ПредопределенныйЭлемент_Кэш_ВозвращаетИзКэша() Экспорт
	
	ИмяОбъекта = "Справочник.пбп_НастройкиИнтеграции";
	Идентификатор = "RabbitMq";
	
	ОжидаемаяСсылка = ЮТест.Данные().КонструкторОбъекта("Справочник.пбп_НастройкиИнтеграции")
		.Установить("ИдентификаторНастройки", Идентификатор)
		.Записать();
	
	Результат = пбп_ПредопределенныеЗначения.ПредопределенныйЭлемент(
		ИмяОбъекта,
		Идентификатор,
		Истина,
		Неопределено,
		Истина);
	
	ЮТест.ОжидаетЧто(Результат).Равно(ОжидаемаяСсылка);
	
КонецПроцедуры

Процедура ПредопределенныйЭлемент_ПлохойИсточник_ВыбрасываетИсключение() Экспорт
	
	мПараметры = Мокито.МассивПараметров("undefined", "Ид", Истина, Неопределено, Ложь);
	
	ЮТест.ОжидаетЧто(пбп_ПредопределенныеЗначения)
		.Метод("ПредопределенныйЭлемент", мПараметры)
		.ВыбрасываетИсключение("Объект метаданных не найден");
	
КонецПроцедуры

#Область ПредопределенныеЭлементы

Процедура ПредопределенныеЭлементы_ВРазрезеКлючей_БезКэша_ВозвращаетМассив() Экспорт
	
	SimpleKafkaИд = "SimpleKafka";
	SimpleKafka = ЮТест.Данные().КонструкторОбъекта("Справочник.пбп_НастройкиИнтеграции")
		.Установить("ИдентификаторНастройки", SimpleKafkaИд)
		.Записать();
	RabbitMqИд = "RabbitMq";
	RabbitMq = ЮТест.Данные().КонструкторОбъекта("Справочник.пбп_НастройкиИнтеграции")
		.Установить("ИдентификаторНастройки", RabbitMqИд)
		.Записать();
	
	ИмяОбъекта = "Справочник.пбп_НастройкиИнтеграции";
	Идентификаторы = SimpleKafkaИд + "," + RabbitMqИд;
	
	Результат = пбп_ПредопределенныеЗначения.ПредопределенныеЭлементы(ИмяОбъекта, Идентификаторы, Ложь, Ложь);
	
	КоличествоЭлементов = 2;

	ЮТест.ОжидаетЧто(ТипЗнч(Результат)).Равно(Тип("Массив"));
	ЮТест.ОжидаетЧто(Результат.Количество()).Равно(КоличествоЭлементов);
	ЮТест.ОжидаетЧто(Результат.Получить(0)).Равно(SimpleKafka);
	ЮТест.ОжидаетЧто(Результат.Получить(1)).Равно(RabbitMq);
	
КонецПроцедуры

#КонецОбласти

#Область ЗначениеПредопределенногоЭлемента

Процедура ЗначениеПредопределенногоЭлемента_Кэш_ВозвращаетИзКэша() Экспорт
	
	ИмяОбъекта = "ПланВидовХарактеристик.пбп_ПредопределенныеЗначения";
	
	ОжидаемоеЗначение = Ложь;
	
	Ссылка = ЮТест.Данные().КонструкторОбъекта(ИмяОбъекта)
		.Установить("ИдентификаторНастройки", "Тест_булево")
		.Установить("ТипЗначения", Новый ОписаниеТипов("Булево"))
		.Установить("Значение", ОжидаемоеЗначение)
		.Записать();
	
	РезультатДоКэширования = пбп_ПредопределенныеЗначения.ЗначениеПредопределенногоЭлемента(
		ИмяОбъекта, Ссылка, Истина, Неопределено, Истина);
	
	РезультатПослеКэширования = пбп_ПредопределенныеЗначения.ЗначениеПредопределенногоЭлемента(
		ИмяОбъекта, Ссылка, Истина, Неопределено, Истина);
	
	ЮТест.ОжидаетЧто(РезультатДоКэширования).Равно(ОжидаемоеЗначение);
	ЮТест.ОжидаетЧто(РезультатДоКэширования).Равно(ОжидаемоеЗначение);
	ЮТест.ОжидаетЧто(РезультатДоКэширования).Равно(РезультатПослеКэширования);
	
КонецПроцедуры

