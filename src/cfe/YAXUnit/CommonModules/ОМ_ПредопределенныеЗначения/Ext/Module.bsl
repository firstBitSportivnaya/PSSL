Процедура ПредопределенныйЭлемент_Кэш_ВозвращаетИзКэша() Экспорт
	
	ИмяОбъекта = "Справочник.пбп_НастройкиИнтеграции";
	Идентификатор = "RabbitMq";
	ОжидаемаяСсылка = Справочники.пбп_НастройкиИнтеграции.НайтиПоРеквизиту("ИдентификаторНастройки", Идентификатор);
	
	Результат = пбп_ПредопределенныеЗначения.ПредопределенныйЭлемент(
		ИмяОбъекта,
		Идентификатор,
		Истина,
		Неопределено,
		Истина);
	
	ЮТест.ОжидаетЧто(Результат).Равно(ОжидаемаяСсылка);
	
КонецПроцедуры

Процедура ПредопределенныйЭлемент_ПлохойИсточник_ВыбрасываетИсключение() Экспорт
	
	мПараметры = Мокито.МассивПараметров("undefined", "Ид", Истина, Неопределено, Ложь);
	
	ЮТест.ОжидаетЧто(пбп_ПредопределенныеЗначения)
		.Метод("ПредопределенныйЭлемент", мПараметры)
		.ВыбрасываетИсключение("Объект метаданных не найден");
	
КонецПроцедуры

#Область ПредопределенныеЭлементы

Процедура ПредопределенныеЭлементы_ВРазрезеКлючей_БезКэша_ВозвращаетСоответствие() Экспорт
	
	SimpleKafka = Справочники.пбп_НастройкиИнтеграции.НайтиПоРеквизиту("ИдентификаторНастройки", "SimpleKafka");
	ИмяОбъекта = "Справочник.пбп_НастройкиИнтеграции";
	Идентификаторы = "RabbitMq, SimpleKafka";
	
	Результат = пбп_ПредопределенныеЗначения.ПредопределенныеЭлементы(ИмяОбъекта, Идентификаторы, Ложь, Истина);
	
	КоличествоЭлементов = 2;

	ЮТест.ОжидаетЧто(ТипЗнч(Результат)).Равно(Тип("Соответствие"));
	ЮТест.ОжидаетЧто(Результат.Количество()).Равно(КоличествоЭлементов);
	ЮТест.ОжидаетЧто(Результат.Получить("SimpleKafka")).Равно(SimpleKafka);
	
КонецПроцедуры

