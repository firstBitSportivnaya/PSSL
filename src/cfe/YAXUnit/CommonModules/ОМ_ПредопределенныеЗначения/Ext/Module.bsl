#Область ДополнитьЗначенияПредопределенных

Процедура ДополнитьЗначенияПредопределенных_Множественный_Соответствие() Экспорт
	
	Приемник = Новый Соответствие;
	Значение = "V";
	Ключ = "K";
	
	пбп_ПредопределенныеЗначения.ДополнитьЗначенияПредопределенных(Приемник, Значение, Ключ, Истина);
	
	ЮТест.ОжидаетЧто(Приемник.Получить(Ключ)).Равно(Значение);
	
КонецПроцедуры

Процедура ДополнитьЗначенияПредопределенных_Множественный_Массив() Экспорт
	
	Значение1 = 1;
	Значение2 = 2;
	КоличествоЭлементов = 2;

	Приемник = Новый Массив;
	Значение = Новый Массив;
	Значение.Добавить(Значение1);
	Значение.Добавить(Значение2);
	
	пбп_ПредопределенныеЗначения.ДополнитьЗначенияПредопределенных(Приемник, Значение, Неопределено, Истина);
	
	ЮТест.ОжидаетЧто(Приемник.Количество()).Равно(КоличествоЭлементов);
	ЮТест.ОжидаетЧто(Приемник[1]).Равно(Значение2);
	
КонецПроцедуры

Процедура ДополнитьЗначенияПредопределенных_Единичный() Экспорт
	
	Приемник = Неопределено;
	Значение = Новый УникальныйИдентификатор;
	
	пбп_ПредопределенныеЗначения.ДополнитьЗначенияПредопределенных(Приемник, Значение, Неопределено, Ложь);
	
	ЮТест.ОжидаетЧто(Приемник).Равно(Значение);
	
КонецПроцедуры

