#Область ЗначенияПредопределенныхЭлементов

Процедура ЗначенияПредопределенныхЭлементов_ВРазрезеКлючей_БезКэша() Экспорт
	
	ИмяОбъекта = "ПланВидовХарактеристик.пбп_ПредопределенныеЗначения";
	Ссылки = Новый Массив;
	Ссылки.Добавить(
		ПланыВидовХарактеристик.пбп_ПредопределенныеЗначения.НайтиПоРеквизиту("ИдентификаторНастройки", "Тест_булево"));
	Ссылки.Добавить(
		ПланыВидовХарактеристик.пбп_ПредопределенныеЗначения.НайтиПоРеквизиту("ИдентификаторНастройки", "Тест_список"));
	
	Результат = пбп_ПредопределенныеЗначения.ЗначенияПредопределенныхЭлементов(ИмяОбъекта, Ссылки, Истина, Истина);
	
	ЮТест.ОжидаетЧто(ТипЗнч(Результат)).Равно(Тип("Соответствие"));
	ЮТест.ОжидаетЧто(ТипЗнч(Результат.Получить(Ссылки[1]))).Равно(Тип("Массив"));
	
КонецПроцедуры

