#Область ЗначенияПредопределенныхЭлементов

Процедура ЗначенияПредопределенныхЭлементов_ВРазрезеКлючей_БезКэша() Экспорт
	
	ИмяОбъекта = "ПланВидовХарактеристик.пбп_ПредопределенныеЗначения";
	ОжидаемоеЗначениеБулево = Ложь;
	ОжидаемоеЗначениеСтрока = "тест";
	
	Тест_булево = ЮТест.Данные().КонструкторОбъекта(ИмяОбъекта)
		.Установить("ИдентификаторНастройки", "Тест_булево")
		.Установить("ТипЗначения", Новый ОписаниеТипов("Булево"))
		.Установить("Значение", ОжидаемоеЗначениеБулево)
		.Записать();
	Тест_список = ЮТест.Данные().КонструкторОбъекта(ИмяОбъекта)
		.Установить("ИдентификаторНастройки", "Тест_список")
		.Установить("СписокЗначений", Истина)
		.Установить("ТипЗначения", Новый ОписаниеТипов("Строка"))
		.ТабличнаяЧасть("ЗначенияЭлементов")
			.ДобавитьСтроку()
				.Установить("Значение", ОжидаемоеЗначениеСтрока)
		.Записать();
	
	Ссылки = Новый Массив;
	Ссылки.Добавить(Тест_булево);
	Ссылки.Добавить(Тест_список);
	
	Результат = пбп_ПредопределенныеЗначения.ЗначенияПредопределенныхЭлементов(ИмяОбъекта, Ссылки, , Истина);
	
	ЮТест.ОжидаетЧто(ТипЗнч(Результат)).Равно(Тип("Соответствие"));
	ЮТест.ОжидаетЧто(Результат.Получить(Ссылки[0])).Равно(ОжидаемоеЗначениеБулево);
	ЮТест.ОжидаетЧто(ТипЗнч(Результат.Получить(Ссылки[1]))).Равно(Тип("Массив"));
	ЮТест.ОжидаетЧто(Результат.Получить(Ссылки[1])[0]).Равно(ОжидаемоеЗначениеСтрока);
	
КонецПроцедуры

