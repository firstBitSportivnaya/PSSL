Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты.ДобавитьТестовыйНабор("пбп_ПредопределенныеЗначения")
		// ПредопределенныйЭлемент
		.ДобавитьТест("ПредопределенныйЭлемент_Кэш_ВозвращаетИзКэша")
		.ДобавитьТест("ПредопределенныйЭлемент_ПлохойИсточник_ВыбрасываетИсключение")
		// ПредопределенныеЭлементы
		.ДобавитьТест("ПредопределенныеЭлементы_ВРазрезеКлючей_БезКэша_ВозвращаетСоответствие")
		// ЗначениеПредопределенногоЭлемента
		.ДобавитьТест("ЗначениеПредопределенногоЭлемента_Кэш_ВозвращаетИзКэша")
		.ДобавитьТест("ЗначениеПредопределенногоЭлемента_БезКэша_ЧерезМенеджер")
		// ЗначенияПредопределенныхЭлементов
		.ДобавитьТест("ЗначенияПредопределенныхЭлементов_ВРазрезеКлючей_БезКэша")
		// ДополнитьЗначенияПредопределенных
		.ДобавитьТест("ДополнитьЗначенияПредопределенных_Множественный_Соответствие")
		.ДобавитьТест("ДополнитьЗначенияПредопределенных_Множественный_Массив")
		.ДобавитьТест("ДополнитьЗначенияПредопределенных_Единичный");
	
КонецПроцедуры

