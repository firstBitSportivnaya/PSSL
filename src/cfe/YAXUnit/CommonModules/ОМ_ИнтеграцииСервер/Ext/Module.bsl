Процедура ТестДолженПреобразоватьМассивСтруктурБезУсеченияСтроки() Экспорт
	
	ДлинныйТекст = "1234567890";
	
	Пока СтрДлина(ДлинныйТекст) < 250 Цикл
		
		ДлинныйТекст = ДлинныйТекст + "1234567890";
		
	КонецЦикла;
	
	Массив = Новый Массив;
	Массив.Добавить(Новый Структура("Имя, Комментарий", "A", Неопределено));
	Массив.Добавить(Новый Структура("Имя, Комментарий", "B", ДлинныйТекст));
	Таблица = пбп_ОбщегоНазначенияСервер.ПреобразоватьМассивСтруктурВТаблицуЗначений(Массив);
	
	ЮТест.ОжидаетЧто(Таблица.Количество()).Равно(2);
	ЮТест.ОжидаетЧто(Таблица[1].Комментарий).Равно(ДлинныйТекст);
	
	МассивИзТаблицы = пбп_Переадресация.ТаблицаЗначенийВМассив(Таблица);
	ЮТест.ОжидаетЧто(МассивИзТаблицы[0].Имя).Равно("A");
	СтруктураСтроки = пбп_Переадресация.СтрокаТаблицыЗначенийВСтруктуру(Таблица[1]);
	ЮТест.ОжидаетЧто(СтруктураСтроки.Комментарий).Равно(ДлинныйТекст);
	
КонецПроцедуры

Процедура ТестДолженСохранитьНеопределеноПриОграниченииСтроки() Экспорт
	
