Процедура ТестДолженИзменитьВсеПериодыОтменыРегистрации() Экспорт
	
	Объект = ЮТест.Данные().КонструкторОбъекта(Справочники.пбп_ИнтеграционныеПотоки)
		.Установить("Наименование", "Отмена регистрации")
		.Установить("ИдентификаторНастройки", "YAX_Cancel")
		.Записать(Ложь, Истина);
	
	пбп_ИнтеграцииСервер.СоздатьИзменитьОтмененныеКРегистрацииОбъекты(
		Объект, Дата(2024, 1, 1), "первая", , Ложь);
	пбп_ИнтеграцииСервер.СоздатьИзменитьОтмененныеКРегистрацииОбъекты(
		Объект, Дата(2024, 2, 1), "вторая", , Ложь);
	пбп_ИнтеграцииСервер.СоздатьИзменитьОтмененныеКРегистрацииОбъекты(
		Объект, , "общая", , Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Записи.ПричинаОтмены КАК ПричинаОтмены
	|ИЗ
	|	РегистрСведений.пбп_ОтмененныеКРегистрацииОбъекты КАК Записи
	|ГДЕ
	|	Записи.Объект = &Объект";
	Запрос.УстановитьПараметр("Объект", Объект);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Количество = 0;
	
	Пока Выборка.Следующий() Цикл
		
		Количество = Количество + 1;
		ЮТест.ОжидаетЧто(Выборка.ПричинаОтмены).Равно("общая");
		
	КонецЦикла;
	
	ЮТест.ОжидаетЧто(Количество).Равно(2);
	
КонецПроцедуры

