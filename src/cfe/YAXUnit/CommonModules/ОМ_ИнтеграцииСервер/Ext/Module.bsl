Процедура ТестДолженУдалитьНулевуюЗадержкуНаВсеСистемы() Экспорт
	
	Система = ЮТест.Данные().КонструкторОбъекта(Справочники.пбп_ИнтегрируемыеСистемы)
		.Установить("Наименование", "Задержка ноль")
		.Установить("ИдентификаторНастройки", "YAX_Delay0")
		.Записать(Ложь, Истина);
	ПараметрыЗаписи = Новый Структура;
	ПараметрыЗаписи.Вставить("ИнтегрируемаяСистема", Система);
	ПараметрыЗаписи.Вставить("НомерПопыткиЗагрузки", 1);
	ПараметрыЗаписи.Вставить("ВремяЗадержки", 10);
	РегистрыСведений.пбп_ЗадержкаПолученияСообщенийОбмена.ДобавитьЗапись(ПараметрыЗаписи);
	ПараметрыЗаписи.НомерПопыткиЗагрузки = 2;
	ПараметрыЗаписи.ВремяЗадержки = 20;
	РегистрыСведений.пбп_ЗадержкаПолученияСообщенийОбмена.ДобавитьЗапись(ПараметрыЗаписи);
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("НомерПопыткиЗагрузки", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("ВремяЗадержки", Новый ОписаниеТипов("Число"));
	СтрокаНуля = Таблица.Добавить();
	СтрокаНуля.НомерПопыткиЗагрузки = 1;
	СтрокаНуля.ВремяЗадержки = 0;
	СтрокаЗадержки = Таблица.Добавить();
	СтрокаЗадержки.НомерПопыткиЗагрузки = 2;
	СтрокаЗадержки.ВремяЗадержки = 5;
	
	Менеджер = Обработки.пбп_УправлениеНастройкамиОбменаЧерезШину;
	Менеджер.ЗаписатьНастройкиЗадержкиПолучения(
		Менеджер.ТипНастройкиЗадержкиНаВсеСистемы(), Неопределено, Таблица);
	
	Записи = РегистрыСведений.пбп_ЗадержкаПолученияСообщенийОбмена.ПолучитьЗаписи(Система);
	ЮТест.ОжидаетЧто(Записи.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Записи[0].НомерПопыткиЗагрузки).Равно(2);
	ЮТест.ОжидаетЧто(Записи[0].ВремяЗадержки).Равно(5);
	
КонецПроцедуры

