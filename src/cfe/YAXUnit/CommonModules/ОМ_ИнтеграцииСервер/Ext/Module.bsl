Процедура ТестДолженУбиратьПереносыИСпецсимволыВBase64Url() Экспорт
	
	Исходная = "ab+c/d==" + Символы.ВК + Символы.ПС;
	Результат = пбп_ИнтеграцииСервер.Base64UrlEncode(Исходная);
	
	ЮТест.ОжидаетЧто(Результат).Равно("ab-c_d");
	ЮТест.ОжидаетЧто(СтрНайти(Результат, Символы.ПС)).Равно(0);
	ЮТест.ОжидаетЧто(СтрНайти(Результат, Символы.ВК)).Равно(0);
	
	ДлиннаяСтрока = "";
	Для Индекс = 1 По 80 Цикл
		
		ДлиннаяСтрока = ДлиннаяСтрока + "A";
		
	КонецЦикла;
	
	СтрокаBase64 = ПолучитьBase64СтрокуИзДвоичныхДанных(
		ПолучитьДвоичныеДанныеИзСтроки(ДлиннаяСтрока, КодировкаТекста.UTF8, Ложь));
	РезультатДлинной = пбп_ИнтеграцииСервер.Base64UrlEncode(СтрокаBase64);
	
	ЮТест.ОжидаетЧто(СтрНайти(СтрокаBase64, Символы.ПС)).Больше(0);
	ЮТест.ОжидаетЧто(СтрНайти(РезультатДлинной, Символы.ПС)).Равно(0);
	ЮТест.ОжидаетЧто(СтрНайти(РезультатДлинной, Символы.ВК)).Равно(0);
	
КонецПроцедуры

Процедура ТестДолженФормироватьТриЧастиJWTБезПереносов() Экспорт
	
	Данные = Новый Структура;
	Данные.Вставить("sub", "1234567890");
	
	Токен = пбп_ИнтеграцииСервер.ПолучитьJWT(Данные, "your-256-bit-secret", "HS256");
	Части = СтрРазделить(Токен, ".");
	
	ЮТест.ОжидаетЧто(Части.Количество()).Равно(3);
	ЮТест.ОжидаетЧто(СтрНайти(Токен, Символы.ПС)).Равно(0);
	ЮТест.ОжидаетЧто(СтрНайти(Токен, Символы.ВК)).Равно(0);
	ЮТест.ОжидаетЧто(СтрНайти(Токен, "=")).Равно(0);
	ЮТест.ОжидаетЧто(Части[0]).Равно("eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9");
	
КонецПроцедуры

Процедура ТестДолженВыбрасыватьИсключениеПриНеизвестномАлгоритме() Экспорт
	
	Данные = Новый Структура("sub", "1");
	мПараметры = Мокито.МассивПараметров(Данные, "secret", "HS1");
	
	ЮТест.ОжидаетЧто(пбп_ИнтеграцииСервер)
