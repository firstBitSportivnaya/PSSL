КонецПроцедуры

Процедура ТестДолженЗаписатьИИзменитьДанныеОтвета() Экспорт
	
	Идентификатор = "yax-async-response-data";
	ПервыйОтвет = Новый ХранилищеЗначения("первый-ответ", Новый СжатиеДанных(9));
	
	пбп_ИнтеграцииСервер.СоздатьИзменитьОжиданиеАсинхронногоВызова(
		Идентификатор, , , , , , ПервыйОтвет);
	
	Записи = РегистрыСведений.пбп_ОжиданиеАсинхронныхВызовов.ПолучитьЗаписи(Идентификатор);
	ЮТест.ОжидаетЧто(Записи.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Записи[0].ДанныеОтвета.Получить()).Равно("первый-ответ");
	
	ВторойОтвет = Новый ХранилищеЗначения("второй-ответ", Новый СжатиеДанных(9));
	пбп_ИнтеграцииСервер.СоздатьИзменитьОжиданиеАсинхронногоВызова(
		Идентификатор, , , , , Истина, ВторойОтвет);
	
	Записи = РегистрыСведений.пбп_ОжиданиеАсинхронныхВызовов.ПолучитьЗаписи(Идентификатор);
	ЮТест.ОжидаетЧто(Записи.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Записи[0].ДанныеОтвета.Получить()).Равно("второй-ответ");
	
КонецПроцедуры

Функция ПричиныОтменыРегистрации(Объект)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Записи.ПричинаОтмены КАК ПричинаОтмены
	|ИЗ
	|	РегистрСведений.пбп_ОтмененныеКРегистрацииОбъекты КАК Записи
	|ГДЕ
	|	Записи.Объект = &Объект";
	Запрос.УстановитьПараметр("Объект", Объект);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

