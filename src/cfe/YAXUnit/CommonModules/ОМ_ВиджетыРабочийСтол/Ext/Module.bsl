// Выполняет проверку заполнения объекта и возвращает сообщение о неразрешенном методе.
// Другие сообщения проверки (например, о незаполненных реквизитах) не учитываются.
Функция ПолеОшибкиНеРазрешенногоМетода(ОбъектПроверки)

	ПолучитьСообщенияПользователю(Истина);
	ОбъектПроверки.ПроверитьЗаполнение();

	Поле = Неопределено;
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл

		Если СтрНайти(Сообщение.Текст, "не разрешен для действий виджетов") > 0 Тогда

			Поле = Сообщение.Поле;

		КонецЕсли;

	КонецЦикла;

	Возврат Поле;

КонецФункции

Функция ИмяНеРазрешенногоДействия()

	Возврат "ОМ_ВиджетыРабочийСтол.НеРазрешенноеДействие";

КонецФункции

#КонецОбласти

#Область ТестыПраваНаОтборНастройки

Процедура ОткрытьСписок_ОтборНастройки_ТребуетПраваНаНастройки() Экспорт

	Действие = Перечисления.пбп_ДействияВиджетов.ОткрытьСписок;
	Источник = Справочники.пбп_ПоказателиВиджетов.ПустаяСсылка();
	РольБезПрава = РольБезПравНаНастройкиОтбора();

	// Список виджетов роли доступен, а настройка отбора - нет: отбор на клиент не передается.
	НастройкаВиджетов = ЮТест.Данные().КонструкторОбъекта(Справочники.пбп_НастройкиОтбораОбъектов)
		.Установить("Наименование", "Отбор виджетов " + Строка(Новый УникальныйИдентификатор))
		.Установить("ОбъектМетаданных", "Справочник.пбп_Виджеты")
		.Записать(Ложь, Истина);
	СОтбором = пбп_ВиджетыРабочийСтол.ОписаниеДействия(Действие, "", Источник, 0, НастройкаВиджетов);
	БезОтбора = пбп_ВиджетыРабочийСтол.ОписаниеДействия(Действие, "Справочник.пбп_Виджеты", Источник);

	ЮТест.ОжидаетЧто(СОтбором.ПараметрыФормы).ИмеетСвойство("ФиксированныеНастройки");
	ЮТест.ОжидаетЧто(пбп_ВиджетыРабочийСтол.ЦельДействияДоступна(БезОтбора, РольБезПрава)).ЭтоИстина();
	ЮТест.ОжидаетЧто(пбп_ВиджетыРабочийСтол.ЦельДействияДоступна(СОтбором, РольБезПрава)).ЭтоЛожь();

	// Роль с просмотром настроек отбора получает список настроек с отбором.
	НастройкаНастроек = СоздатьНастройкуОтбораПоНаименованию("Право на отбор");
	СписокНастроек = пбп_ВиджетыРабочийСтол.ОписаниеДействия(Действие, "", Источник, 0, НастройкаНастроек);
	РольСПравом = Метаданные.Роли.пбп_ЧтениеНастроекОтборовОбъектов;
	ЮТест.ОжидаетЧто(пбп_ВиджетыРабочийСтол.ЦельДействияДоступна(СписокНастроек, РольСПравом)).ЭтоИстина();

КонецПроцедуры

