Процедура ВыполнитьМетод_КомандыВиджета_ВызываетМетод() Экспорт

	Представление = "Команда " + Лев(Строка(Новый УникальныйИдентификатор), 8);
	ВиджетОбъект = Справочники.пбп_Виджеты.СоздатьЭлемент();
	ВиджетОбъект.Наименование = "Виджет " + Представление;
	ВиджетОбъект.Вид = Перечисления.пбп_ВидыВиджетов.Команда;
	СтрокаКоманды = ВиджетОбъект.Команды.Добавить();
	СтрокаКоманды.Представление = Представление;
	СтрокаКоманды.Действие = Перечисления.пбп_ДействияВиджетов.ВыполнитьМетод;
	СтрокаКоманды.ПараметрДействия = ИмяТестовогоДействия();
	ВиджетОбъект.Записать();

	пбп_ВиджетыВызовСервера.ВыполнитьМетод(ВиджетОбъект.Ссылка, 1);

	ПараметрыВызова = ХранилищеОбщихНастроек.Загрузить(КлючОбъектаВызова(), КлючНастройкиВызова());
	ЮТест.ОжидаетЧто(ПараметрыВызова).ИмеетТип("Структура");
	ЮТест.ОжидаетЧто(ПараметрыВызова.Виджет).Равно(ВиджетОбъект.Ссылка);
	ЮТест.ОжидаетЧто(ПараметрыВызова.Команда).Равно(Представление);

КонецПроцедуры

