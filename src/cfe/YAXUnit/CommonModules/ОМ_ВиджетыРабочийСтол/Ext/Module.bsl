Процедура ОткрытьСписок_ПоНастройкеОтбора_ПередаетОтбор() Экспорт

	Наименование = "Рабочий стол " + Лев(Строка(Новый УникальныйИдентификатор), 8);
	Настройка = СоздатьНастройкуОтбораПоНаименованию(Наименование);

	Описание = пбп_ВиджетыРабочийСтол.ОписаниеДействия(Перечисления.пбп_ДействияВиджетов.ОткрытьСписок, "",
		Справочники.пбп_ПоказателиВиджетов.ПустаяСсылка(), 0, Настройка);

	ЮТест.ОжидаетЧто(Описание.ИмяФормы).Равно("Справочник.пбп_НастройкиОтбораОбъектов.ФормаСписка");
	ЮТест.ОжидаетЧто(Описание.ОбъектМетаданных).Равно("Справочник.пбп_НастройкиОтбораОбъектов");
	ЮТест.ОжидаетЧто(Описание.Право).Равно("Просмотр");
	ЮТест.ОжидаетЧто(Описание.ПараметрыФормы).ИмеетСвойство("ФиксированныеНастройки");

	ЭлементыОтбора = Описание.ПараметрыФормы.ФиксированныеНастройки.Отбор.Элементы;
	ЮТест.ОжидаетЧто(ЭлементыОтбора.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Строка(ЭлементыОтбора[0].ЛевоеЗначение)).Равно("Наименование");
	ЮТест.ОжидаетЧто(ЭлементыОтбора[0].ВидСравнения).Равно(ВидСравненияКомпоновкиДанных.Равно);
	ЮТест.ОжидаетЧто(ЭлементыОтбора[0].ПравоеЗначение).Равно(Наименование);

КонецПроцедуры

