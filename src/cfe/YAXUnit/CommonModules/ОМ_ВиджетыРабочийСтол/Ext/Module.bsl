Процедура ВыполнитьМетод_НеРазрешенныйМетод_Исключение() Экспорт

	Показатель = ЮТест.Данные().КонструкторОбъекта(Справочники.пбп_ПоказателиВиджетов)
		.Установить("Наименование", "Показатель " + Строка(Новый УникальныйИдентификатор))
		.Установить("Действие", Перечисления.пбп_ДействияВиджетов.ВыполнитьМетод)
		.Установить("ПараметрДействия", ИмяНеРазрешенногоДействия())
		.Записать();
	ХранилищеОбщихНастроек.Удалить(КлючОбъектаВызова(), КлючНастройкиВызова(), ИмяПользователя());

	ПараметрыМетода = ЮТКоллекции.ЗначениеВМассиве(Показатель);
	ЮТест.ОжидаетЧто(пбп_ВиджетыВызовСервера)
		.Метод("ВыполнитьМетод", ПараметрыМетода)
		.ВыбрасываетИсключение("не разрешен для действий виджетов");

	ПараметрыВызова = ХранилищеОбщихНастроек.Загрузить(КлючОбъектаВызова(), КлючНастройкиВызова());
	ЮТест.ОжидаетЧто(ПараметрыВызова).НеЗаполнено();

КонецПроцедуры

Процедура ПроверкаЗаполнения_ПоказательСНеРазрешеннымМетодом_Ошибка() Экспорт

	Показатель = Справочники.пбп_ПоказателиВиджетов.СоздатьЭлемент();
	Показатель.Наименование = "Показатель с методом";
	Показатель.Действие = Перечисления.пбп_ДействияВиджетов.ВыполнитьМетод;

	Показатель.ПараметрДействия = ИмяНеРазрешенногоДействия();
	ЮТест.ОжидаетЧто(ПолеОшибкиНеРазрешенногоМетода(Показатель)).Содержит("ПараметрДействия");

	Показатель.ПараметрДействия = ИмяТестовогоДействия();
	ЮТест.ОжидаетЧто(ПолеОшибкиНеРазрешенногоМетода(Показатель)).Равно(Неопределено);

КонецПроцедуры

Процедура ПроверкаЗаполнения_КомандаСНеРазрешеннымМетодом_Ошибка() Экспорт

	Виджет = Справочники.пбп_Виджеты.СоздатьЭлемент();
	Виджет.Наименование = "Виджет с методом";
