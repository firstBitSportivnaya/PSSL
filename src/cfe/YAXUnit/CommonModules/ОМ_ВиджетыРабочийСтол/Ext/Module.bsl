Функция СоздатьНастройкуОтбораПоНаименованию(Наименование)

	Настройки = Новый НастройкиКомпоновкиДанных;
	ЭлементОтбора = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Наименование");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Наименование;
	ЭлементОтбора.Использование = Истина;

	Возврат ЮТест.Данные().КонструкторОбъекта(Справочники.пбп_НастройкиОтбораОбъектов)
		.Установить("Наименование", "Отбор " + Наименование)
		.Установить("ОбъектМетаданных", "Справочник.пбп_НастройкиОтбораОбъектов")
		.Установить("Отбор", пбп_Переадресация.ЗначениеВСтрокуXML(Настройки.Отбор))
		.Записать(Ложь, Истина);

