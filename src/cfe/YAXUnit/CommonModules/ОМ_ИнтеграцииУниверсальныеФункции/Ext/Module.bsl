#Область СлужебныеПроцедурыИФункции

Функция НовыйСоставПолей(ИменаРеквизитов, ИменаВложенных, ИменаТабличныхЧастей)

	Реквизиты = Новый Массив;

	Для Каждого ИмяРеквизита Из ИменаРеквизитов Цикл

		Реквизиты.Добавить(Новый Структура("Имя, Синоним", ИмяРеквизита, ИмяРеквизита));

	КонецЦикла;

	ВложенныеПоля = Новый Структура;

	Для Каждого ИмяПоля Из ИменаВложенных Цикл

		ВложенныеПоля.Вставить(ИмяПоля, ВложенныеПоля.Количество());

	КонецЦикла;

	ТабличныеЧасти = Новый Структура;

	Для Каждого ИмяТабличнойЧасти Из ИменаТабличныхЧастей Цикл

		ПустойСостав = Новый Структура;
		ПустойСостав.Вставить("Реквизиты", Новый Массив);
		ПустойСостав.Вставить("ВложенныеПоля", Новый Структура);
		ТабличныеЧасти.Вставить(ИмяТабличнойЧасти, ПустойСостав);

	КонецЦикла;

	РеквизитыОбъекта = Новый Структура;
	РеквизитыОбъекта.Вставить("Реквизиты", Реквизиты);
	РеквизитыОбъекта.Вставить("ВложенныеПоля", ВложенныеПоля);

	СоставПолей = Новый Структура;
	СоставПолей.Вставить("РеквизитыОбъекта", РеквизитыОбъекта);
	СоставПолей.Вставить("ТабличныеЧасти", ТабличныеЧасти);
	СоставПолей.Вставить("ПорядокТабличныхЧастей", ИменаТабличныхЧастей);

	Возврат СоставПолей;

КонецФункции

Функция Имена(Имя1, Имя2 = Неопределено, Имя3 = Неопределено)

	ИменаПолей = Новый Массив;
	ИменаПолей.Добавить(Имя1);

	Если Имя2 <> Неопределено Тогда

		ИменаПолей.Добавить(Имя2);

	КонецЕсли;

	Если Имя3 <> Неопределено Тогда

		ИменаПолей.Добавить(Имя3);

	КонецЕсли;

	Возврат ИменаПолей;

КонецФункции

Функция ИменаРеквизитов(Реквизиты)

	ИменаПолей = Новый Массив;

	Для Каждого Реквизит Из Реквизиты Цикл

		ИменаПолей.Добавить(Реквизит.Имя);

	КонецЦикла;

	Возврат ИменаПолей;

КонецФункции

Функция ЗагрузитьОбъектУниверсально(МенеджерОбъекта, Данные, ИдентификаторПотока, Система)

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	ОбъектXDTO = пбп_ИнтеграцииСлужебный.ПолучитьОбъектXDTOИзСообщенияОбменаJSON(СтрокаJSON);

	СтруктураИстории = пбп_ИнтеграцииШина.ИнициализироватьСтруктуруЗаписиИсторииИнтеграции(
		ИдентификаторПотока, СтрокаJSON, Истина, Ложь, Ложь);
	ПараметрыОбмена = пбп_ИнтеграцииШина.ИнициализироватьПараметрыОбмена(
		ИдентификаторПотока, Система, 0, 0, Новый Соответствие, "", СтруктураИстории, Истина);
	ПараметрыСообщения = пбп_ИнтеграцииШина.ИнициализироватьПараметрыСообщения(
		МенеджерОбъекта, ОбъектXDTO, "", Неопределено, Истина, Ложь);

	Возврат пбп_ИнтеграцииШина.ЗагрузитьИзПлатформы(ПараметрыОбмена, ПараметрыСообщения);

КонецФункции

Функция ОболочкаСтрокИстории(Система, ИмяСозданОбновлен)

	СтрокаТЧ = Новый Структура;
	СтрокаТЧ.Вставить("СозданОбновлен", ИмяСозданОбновлен);
	СтрокаТЧ.Вставить("ОбъектИнтеграции", Строка(Система.УникальныйИдентификатор()));
	СтрокаТЧ.Вставить("ОбъектИнтеграцииТип", "СправочникСсылка.пбп_ИнтегрируемыеСистемы");
	СтрокаТЧ.Вставить("Идентификатор", "YAX-ROW");

	СтрокиТЧ = Новый Массив;
	СтрокиТЧ.Добавить(СтрокаТЧ);

	Оболочка = Новый Структура;
	Оболочка.Вставить("ОбъектыИнтеграции", СтрокиТЧ);

	Возврат Оболочка;

КонецФункции

Функция ОболочкаСтрокПараметра(ИдентификаторПараметра)

	СтрокаТЧ = Новый Структура;
	СтрокаТЧ.Вставить("Идентификатор", Строка(ИдентификаторПараметра));
	СтрокаТЧ.Вставить("Наименование", "Параметр");

	СтрокиТЧ = Новый Массив;
	СтрокиТЧ.Добавить(СтрокаТЧ);

	Оболочка = Новый Структура;
	Оболочка.Вставить("ПараметрыФункции", СтрокиТЧ);

	Возврат Оболочка;

КонецФункции

#КонецОбласти
