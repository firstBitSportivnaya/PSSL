Процедура ТестДолженСохранитьДатуПриПреобразованииТудаИОбратно() Экспорт

	ИсходнаяДата = Дата(2024, 1, 15, 12, 0, 0);
	ЧасовойПояс = "Europe/Moscow";

	УниверсальнаяДата = пбп_ИнтеграцииСервер.ПреобразоватьДатуПоУниверсальномуВремени(
		ИсходнаяДата, ЧастиДаты.ДатаВремя, ЧасовойПояс);
	МестнаяДата = пбп_ИнтеграцииСервер.ПреобразоватьДатуПоУниверсальномуВремени(
		УниверсальнаяДата, ЧастиДаты.ДатаВремя, ЧасовойПояс, Истина);

	ЮТест.ОжидаетЧто(УниверсальнаяДата <> ИсходнаяДата).Равно(Истина);
	ЮТест.ОжидаетЧто(МестнаяДата).Равно(ИсходнаяДата);

