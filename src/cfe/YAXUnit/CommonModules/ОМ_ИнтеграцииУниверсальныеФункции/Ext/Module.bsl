Процедура ТестДолженПрочитатьСтруктуруИзСообщенияJSON() Экспорт

	Данные = Новый Структура;
	Данные.Вставить("name", "Сообщение шины");
	Данные.Вставить("port", 0);
	Данные.Вставить("isGroup", Ложь);

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	СтрокаJSON = ЗаписьJSON.Закрыть();

	Результат = пбп_ИнтеграцииСлужебный.ПолучитьОбъектXDTOИзСообщенияОбменаJSON(СтрокаJSON);

	ЮТест.ОжидаетЧто(ТипЗнч(Результат)).Равно(Тип("ОбъектXDTO"));
	ЮТест.ОжидаетЧто(Результат.Получить("name")).Равно("Сообщение шины");
	ЮТест.ОжидаетЧто(Результат.Получить("port")).Равно(0);
	ЮТест.ОжидаетЧто(Результат.Получить("isGroup")).Равно(Ложь);

КонецПроцедуры

Процедура ТестДолженЗаписатьНайтиИУдалитьПубличныйИдентификатор() Экспорт

	ОписаниеРегистра = пбп_ИнтеграцииШинаПовтИсп.ОписаниеРегистраПубличныхИдентификаторов();

	Если Не ОписаниеРегистра.Использовать Или ОписаниеРегистра.ЭтоРегистрБСП Тогда

		ЮТест.Пропустить("Регистр соответствий ПБП не используется");
		Возврат;

	КонецЕсли;

	Система = ЮТест.Данные().КонструкторОбъекта(Справочники.пбп_ИнтегрируемыеСистемы)
		.Установить("Наименование", "Система записи идентификатора")
		.Записать(Ложь, Истина);
	Идентификатор = "EXT-WRITE";
	Объект = Справочники.пбп_ИнтегрируемыеСистемы.СоздатьЭлемент();
	Объект.Наименование = "Объект с внешним идентификатором";

	ПараметрыСообщения = пбп_ИнтеграцииШина.ИнициализироватьПараметрыСообщения(
		Справочники.пбп_ИнтегрируемыеСистемы, Неопределено, Идентификатор, Неопределено);
	ПараметрыСообщения.СсылкаИзXDTO = Идентификатор;
	ПараметрыСообщения.СсылкаЯвляетсяВнешнимИдентификатором = Истина;
	ПараметрыСообщения.СостояниеЗагрузки.ЭтоНовый = Истина;
	ПараметрыОбмена = пбп_ИнтеграцииШина.ИнициализироватьПараметрыОбмена(
		Неопределено, Система, 0, 0, Новый Соответствие, "", Неопределено);

	Ссылка = пбп_ИнтеграцииШина.ЗаписатьСсылочныйЭлемент(Объект, ПараметрыОбмена, ПараметрыСообщения);
	Найдено = пбп_ИнтеграцииШина.НайтиПоИдентификаторуПолямПоиска(
		Справочники.пбп_ИнтегрируемыеСистемы, Идентификатор, Система);
	ПовторныйПоиск = пбп_ИнтеграцииШина.НайтиПоИдентификаторуПолямПоиска(
		Справочники.пбп_ИнтегрируемыеСистемы, Идентификатор, Система);

	ЮТест.ОжидаетЧто(Найдено).Равно(Ссылка);
	ЮТест.ОжидаетЧто(ПовторныйПоиск).Равно(Ссылка);

	пбп_ИнтеграцииСервер.УдалитьСоответствиеОбъектовИнтегрируемыхСистем(Система, Ссылка, Идентификатор);
	ПослеУдаления = пбп_ИнтеграцииШина.НайтиПоИдентификаторуПолямПоиска(
		Справочники.пбп_ИнтегрируемыеСистемы, Идентификатор, Система);

	ЮТест.ОжидаетЧто(ПослеУдаления).Равно(Неопределено);

КонецПроцедуры

Процедура ТестДолженНайтиСистемуПоИдентификаторуНастройки() Экспорт
	
	Идентификатор = "YAX_Узел_" + Строка(Новый УникальныйИдентификатор);
	Система = ЮТест.Данные().КонструкторОбъекта(Справочники.пбп_ИнтегрируемыеСистемы)
		.Установить("Наименование", "Узел по идентификатору")
		.Установить("ИдентификаторНастройки", Идентификатор)
		.Записать(Ложь, Истина);
	
	Найдено = пбп_ИнтеграцииШина.УзелИнтеграцииПоИсточнику(Идентификатор);
	
	ЮТест.ОжидаетЧто(Найдено).Равно(Система);
	
КонецПроцедуры

Процедура ТестДолженВыброситьИсключениеЕслиИсточникНеНайден() Экспорт
	
	Источник = "YAX_НетУзла_" + Строка(Новый УникальныйИдентификатор);
	ПараметрыМетода = Мокито.МассивПараметров(Источник);
	
