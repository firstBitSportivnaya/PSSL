	ЮТест.ОжидаетЧто(СоставПолей.РеквизитыОбъекта.ВложенныеПоля.Свойство("Код")).Равно(Истина);
	ЮТест.ОжидаетЧто(СоставПолей.РеквизитыОбъекта.ВложенныеПоля.Свойство("Лишний")).Равно(Ложь);
