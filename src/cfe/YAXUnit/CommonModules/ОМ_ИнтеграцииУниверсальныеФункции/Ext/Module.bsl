#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("НайтиПоИдентификатору")
			.ДобавитьТест("ТестДолженВернутьСсылкуПоВнутреннемуИдентификатору")
			.ДобавитьТест("ТестДолженВернутьНеопределеноДляИдентификатораНеUUID")
			.ДобавитьТест("ТестДолженНайтиОбъектПоРегиструСоответствийПБП").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("УдалитьНеиспользуемыеРеквизиты")
			.ДобавитьТест("ТестДолженУдалитьПоляСПрефиксомУдалить")
			.ДобавитьТест("ТестДолженУдалитьПоляИзПереданногоСписка");

КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура ТестДолженВернутьСсылкуПоВнутреннемуИдентификатору() Экспорт

	Идентификатор = Строка(Новый УникальныйИдентификатор);
	Менеджер = Справочники.пбп_ИнтегрируемыеСистемы;

	Ссылка = пбп_ИнтеграцииУниверсальныеФункции.НайтиПоИдентификатору(
		Менеджер, Идентификатор, Неопределено, Неопределено);

	ЮТест.ОжидаетЧто(ТипЗнч(Ссылка)).Равно(Тип("СправочникСсылка.пбп_ИнтегрируемыеСистемы"));
	ЮТест.ОжидаетЧто(Строка(Ссылка.УникальныйИдентификатор())).Равно(Идентификатор);

КонецПроцедуры

Процедура ТестДолженВернутьНеопределеноДляИдентификатораНеUUID() Экспорт

	Ссылка = пбп_ИнтеграцииУниверсальныеФункции.НайтиПоИдентификатору(
		Справочники.пбп_ИнтегрируемыеСистемы, "внешний-код", Неопределено, Неопределено);

	ЮТест.ОжидаетЧто(Ссылка).Равно(Неопределено);

КонецПроцедуры

Процедура ТестДолженНайтиОбъектПоРегиструСоответствийПБП() Экспорт

	ОписаниеРегистра = пбп_ИнтеграцииУниверсальныеФункцииПовтИсп.ОписаниеРегистраПубличныхИдентификаторов();

	Если Не ОписаниеРегистра.Использовать Или ОписаниеРегистра.ЭтоРегистрБСП Тогда

		ЮТест.Пропустить("Регистр соответствий ПБП не используется");
		Возврат;

	КонецЕсли;

	Система = ЮТест.Данные().КонструкторОбъекта(Справочники.пбп_ИнтегрируемыеСистемы)
		.Установить("Наименование", "Система поиска")
		.Записать(Ложь, Истина);
	СсылкаНаОбъект = "OBJ0000001";
	Идентификатор = "EXT-1";

	Набор = РегистрыСведений.пбп_СоответствиеОбъектовИнтегрируемыхСистем.СоздатьНаборЗаписей();
	Набор.Отбор.ИнтегрируемаяСистема.Установить(Система);
	Набор.Отбор.СсылкаНаОбъект.Установить(СсылкаНаОбъект);
	Набор.Отбор.ИдентификаторСистемы.Установить(Идентификатор);
	Запись = Набор.Добавить();
	Запись.ИнтегрируемаяСистема = Система;
	Запись.СсылкаНаОбъект = СсылкаНаОбъект;
	Запись.ИдентификаторСистемы = Идентификатор;
	Набор.Записать();

	ПоляПоиска = Новый Соответствие;
	ПоляПоиска.Вставить(
		пбп_ИнтеграцииУниверсальныеФункции.ИмяПоляПоискаПоПубличномуИдентификатору(), Идентификатор);

	Найдено = пбп_ИнтеграцииУниверсальныеФункции.НайтиПоИдентификатору(
		Справочники.пбп_ИнтегрируемыеСистемы, Идентификатор, Система, Неопределено, ПоляПоиска);

	ЮТест.ОжидаетЧто(Найдено).Равно(СсылкаНаОбъект);

КонецПроцедуры

Процедура ТестДолженУдалитьПоляСПрефиксомУдалить() Экспорт

	СоставПолей = НовыйСоставПолей(
		Имена("Наименование", "УдалитьСтарое", "УдалитьЕще"),
		Имена("Код", "УдалитьКод", "УдалитьЕщеПоле"),
		Имена("Товары", "УдалитьАрхив", "УдалитьСтараяТЧ"));

	пбп_ИнтеграцииУниверсальныеФункции.УдалитьНеиспользуемыеРеквизиты(СоставПолей);

	ЮТест.ОжидаетЧто(ИменаРеквизитов(СоставПолей.РеквизитыОбъекта.Реквизиты)).Равно(Имена("Наименование"));
	ЮТест.ОжидаетЧто(СоставПолей.РеквизитыОбъекта.ВложенныеПоля.Свойство("Код")).Равно(Истина);
	ЮТест.ОжидаетЧто(СоставПолей.РеквизитыОбъекта.ВложенныеПоля.Свойство("УдалитьКод")).Равно(Ложь);
	ЮТест.ОжидаетЧто(СоставПолей.РеквизитыОбъекта.ВложенныеПоля.Свойство("УдалитьЕщеПоле")).Равно(Ложь);
	ЮТест.ОжидаетЧто(СоставПолей.ТабличныеЧасти.Свойство("Товары")).Равно(Истина);
	ЮТест.ОжидаетЧто(СоставПолей.ТабличныеЧасти.Свойство("УдалитьАрхив")).Равно(Ложь);
	ЮТест.ОжидаетЧто(СоставПолей.ТабличныеЧасти.Свойство("УдалитьСтараяТЧ")).Равно(Ложь);
	ЮТест.ОжидаетЧто(СоставПолей.ПорядокТабличныхЧастей).Равно(Имена("Товары"));

КонецПроцедуры

Процедура ТестДолженУдалитьПоляИзПереданногоСписка() Экспорт

	СоставПолей = НовыйСоставПолей(
		Имена("Наименование", "Комментарий"),
		Имена("Код", "Лишний", "Лишний2"),
		Имена("Товары", "Архив"));
	УдаляемыеРеквизиты = Новый Структура;
	УдаляемыеРеквизиты.Вставить("МассивУдаляемыхРеквизитов", Имена("Комментарий", "Лишний", "Лишний2"));
	УдаляемыеРеквизиты.Вставить("МассивУдаляемыхТЧ", Имена("Архив"));

	пбп_ИнтеграцииУниверсальныеФункции.УдалитьНеиспользуемыеРеквизиты(СоставПолей, УдаляемыеРеквизиты);

	ЮТест.ОжидаетЧто(ИменаРеквизитов(СоставПолей.РеквизитыОбъекта.Реквизиты)).Равно(Имена("Наименование"));
	ЮТест.ОжидаетЧто(СоставПолей.РеквизитыОбъекта.ВложенныеПоля.Свойство("Код")).Равно(Истина);
	ЮТест.ОжидаетЧто(СоставПолей.РеквизитыОбъекта.ВложенныеПоля.Свойство("Лишний")).Равно(Ложь);
	ЮТест.ОжидаетЧто(СоставПолей.РеквизитыОбъекта.ВложенныеПоля.Свойство("Лишний2")).Равно(Ложь);
	ЮТест.ОжидаетЧто(СоставПолей.ТабличныеЧасти.Свойство("Архив")).Равно(Ложь);
	ЮТест.ОжидаетЧто(СоставПолей.ПорядокТабличныхЧастей).Равно(Имена("Товары"));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйСоставПолей(ИменаРеквизитов, ИменаВложенных, ИменаТабличныхЧастей)

	Реквизиты = Новый Массив;

	Для Каждого ИмяРеквизита Из ИменаРеквизитов Цикл

		Реквизиты.Добавить(Новый Структура("Имя, Синоним", ИмяРеквизита, ИмяРеквизита));

	КонецЦикла;

	ВложенныеПоля = Новый Структура;

	Для Каждого ИмяПоля Из ИменаВложенных Цикл

		ВложенныеПоля.Вставить(ИмяПоля, ВложенныеПоля.Количество());

	КонецЦикла;

	ТабличныеЧасти = Новый Структура;

	Для Каждого ИмяТабличнойЧасти Из ИменаТабличныхЧастей Цикл

		ПустойСостав = Новый Структура;
		ПустойСостав.Вставить("Реквизиты", Новый Массив);
		ПустойСостав.Вставить("ВложенныеПоля", Новый Структура);
		ТабличныеЧасти.Вставить(ИмяТабличнойЧасти, ПустойСостав);

	КонецЦикла;

	РеквизитыОбъекта = Новый Структура;
	РеквизитыОбъекта.Вставить("Реквизиты", Реквизиты);
	РеквизитыОбъекта.Вставить("ВложенныеПоля", ВложенныеПоля);

	СоставПолей = Новый Структура;
	СоставПолей.Вставить("РеквизитыОбъекта", РеквизитыОбъекта);
	СоставПолей.Вставить("ТабличныеЧасти", ТабличныеЧасти);
	СоставПолей.Вставить("ПорядокТабличныхЧастей", ИменаТабличныхЧастей);

	Возврат СоставПолей;

КонецФункции

Функция Имена(Имя1, Имя2 = Неопределено, Имя3 = Неопределено)

	ИменаПолей = Новый Массив;
	ИменаПолей.Добавить(Имя1);

	Если Имя2 <> Неопределено Тогда

		ИменаПолей.Добавить(Имя2);

	КонецЕсли;

	Если Имя3 <> Неопределено Тогда

		ИменаПолей.Добавить(Имя3);

	КонецЕсли;

	Возврат ИменаПолей;

КонецФункции

Функция ИменаРеквизитов(Реквизиты)

	ИменаПолей = Новый Массив;

	Для Каждого Реквизит Из Реквизиты Цикл

		ИменаПолей.Добавить(Реквизит.Имя);

	КонецЦикла;

	Возврат ИменаПолей;

КонецФункции

#КонецОбласти
