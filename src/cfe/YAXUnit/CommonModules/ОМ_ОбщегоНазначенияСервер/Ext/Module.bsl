КонецПроцедуры

Процедура ТестПолученияТаблицыДатЗаПериод() Экспорт 
	
	НачалоПериода = '20200101';
	ОкончаниеПериода = '20200110';
	Интервал = "День";

	Результат = пбп_ОбщегоНазначенияСервер.ПолучитьТаблицуДатЗаПериод(НачалоПериода, ОкончаниеПериода, Интервал);

	ОжидаемыйРезультат = Новый ТаблицаЗначений;
	ОжидаемыйРезультат.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата"));
	ДобавитьСтрокуВТаблицу(ОжидаемыйРезультат, '20200101');
	ДобавитьСтрокуВТаблицу(ОжидаемыйРезультат, '20200102');
	ДобавитьСтрокуВТаблицу(ОжидаемыйРезультат, '20200103');
	ДобавитьСтрокуВТаблицу(ОжидаемыйРезультат, '20200104');
	ДобавитьСтрокуВТаблицу(ОжидаемыйРезультат, '20200105');
	ДобавитьСтрокуВТаблицу(ОжидаемыйРезультат, '20200106');
	ДобавитьСтрокуВТаблицу(ОжидаемыйРезультат, '20200107');
	ДобавитьСтрокуВТаблицу(ОжидаемыйРезультат, '20200108');
	ДобавитьСтрокуВТаблицу(ОжидаемыйРезультат, '20200109');
	ДобавитьСтрокуВТаблицу(ОжидаемыйРезультат, '20200110');

	ЮТест.ОжидаетЧто(Результат.Количество()).Равно(ОжидаемыйРезультат.Количество());

	Для каждого Строка Из Результат Цикл
		ЮТест.ОжидаетЧто(Строка.Период).Равно(ОжидаемыйРезультат[Результат.Индекс(Строка)].Период);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьСтрокуВТаблицу(Таблица, Дата) Экспорт
	
	Строка = Таблица.Добавить();
	Строка.Период = Дата;
	
КонецПроцедуры

Процедура ТестДолженЗаписатьПолныйТекстОшибкиВЖурнал() Экспорт
	
	Идентификатор = СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
	ИмяСобытия = "пбп_ЮТ295_Полный_" + Идентификатор;
	ЗаголовокОшибки = "пбп_ЮТ295_Заголовок_" + Идентификатор;
	ТекстСообщения = "пбп_ЮТ295_Сообщение_" + Идентификатор;
	ТекстИсключения = "пбп_ЮТ295_Исключение_" + Идентификатор;
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщения;
	ДополнительныеСообщения = Новый Массив;
	ДополнительныеСообщения.Добавить(Сообщение);
	
	пбп_ОбщегоНазначенияСервер.ЗаписатьПолныйТекстОшибкиВЖурналРегистрации(
		ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, ЗаголовокОшибки, ТекстИсключения, ДополнительныеСообщения);
	
	ЗаписьЖурнала = ЗаписьЖурналаПоСобытию(ИмяСобытия);
	ЮТест.ОжидаетЧто(ЗаписьЖурнала.Уровень).Равно(УровеньЖурналаРегистрации.Ошибка);
	
	Комментарий = ЗаписьЖурнала.Комментарий;
	ПозицияЗаголовка = СтрНайти(Комментарий, ЗаголовокОшибки);
	ПозицияСообщения = СтрНайти(Комментарий, ТекстСообщения);
	ПозицияИсключения = СтрНайти(Комментарий, ТекстИсключения);
	
	ЮТест.ОжидаетЧто(ПозицияЗаголовка).Больше(0);
	ЮТест.ОжидаетЧто(ПозицияСообщения).Больше(ПозицияЗаголовка);
	ЮТест.ОжидаетЧто(ПозицияИсключения).Больше(ПозицияСообщения);
	
КонецПроцедуры

Процедура ТестДолженЗаписатьОшибкуБезДополнительныхСообщений() Экспорт
	
	Идентификатор = СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
	ИмяСобытия = "пбп_ЮТ295_БезСообщений_" + Идентификатор;
	ЗаголовокОшибки = "пбп_ЮТ295_Заголовок_" + Идентификатор;
	ТекстИсключения = "пбп_ЮТ295_Исключение_" + Идентификатор;
	
	пбп_ОбщегоНазначенияСервер.ЗаписатьПолныйТекстОшибкиВЖурналРегистрации(
		ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, ЗаголовокОшибки, ТекстИсключения);
	
	ЗаписьЖурнала = ЗаписьЖурналаПоСобытию(ИмяСобытия);
	Комментарий = ЗаписьЖурнала.Комментарий;
	ПозицияЗаголовка = СтрНайти(Комментарий, ЗаголовокОшибки);
	ПозицияИсключения = СтрНайти(Комментарий, ТекстИсключения);
	
	ЮТест.ОжидаетЧто(ПозицияЗаголовка).Больше(0);
	ЮТест.ОжидаетЧто(ПозицияИсключения).Больше(ПозицияЗаголовка);
	
КонецПроцедуры

Процедура ТестДолженЗаписатьДанныеИОбъектМетаданныхСУказаннымУровнем() Экспорт
	
	Идентификатор = СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
	ИмяСобытия = "пбп_ЮТ295_Поля_" + Идентификатор;
	ЗаголовокОшибки = "пбп_ЮТ295_Заголовок_" + Идентификатор;
	ТекстИсключения = "пбп_ЮТ295_Исключение_" + Идентификатор;
	ДанныеСобытия = "пбп_ЮТ295_Данные_" + Идентификатор;
	ОбъектМетаданных = Метаданные.Справочники.пбп_ИсторияИнтеграции;
	
	пбп_ОбщегоНазначенияСервер.ЗаписатьПолныйТекстОшибкиВЖурналРегистрации(
		ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, ЗаголовокОшибки, ТекстИсключения,
		Неопределено, ОбъектМетаданных, ДанныеСобытия);
	
	ЗаписьЖурнала = ЗаписьЖурналаПоСобытию(ИмяСобытия);
	ЮТест.ОжидаетЧто(ЗаписьЖурнала.Уровень).Равно(УровеньЖурналаРегистрации.Предупреждение);
	ЮТест.ОжидаетЧто(ЗаписьЖурнала.Данные).Равно(ДанныеСобытия);
	ЮТест.ОжидаетЧто(ЗаписьЖурнала.Метаданные).Равно(ОбъектМетаданных.ПолноеИмя());
	
	Комментарий = ЗаписьЖурнала.Комментарий;
	ПозицияЗаголовка = СтрНайти(Комментарий, ЗаголовокОшибки);
	ПозицияИсключения = СтрНайти(Комментарий, ТекстИсключения);
	
	ЮТест.ОжидаетЧто(ПозицияЗаголовка).Больше(0);
	ЮТест.ОжидаетЧто(ПозицияИсключения).Больше(ПозицияЗаголовка);
	
КонецПроцедуры

Функция ЗаписьЖурналаПоСобытию(ИмяСобытия)
	
	Отбор = Новый Структура("Событие", ИмяСобытия);
	ЗаписиЖурнала = Новый ТаблицаЗначений;
	ВыгрузитьЖурналРегистрации(ЗаписиЖурнала, Отбор, "Уровень, Событие, Комментарий, Данные, Метаданные");
	
	ЮТест.ОжидаетЧто(ЗаписиЖурнала.Количество()).Равно(1);
	
	Возврат ЗаписиЖурнала[0];
	
КонецФункции

#КонецОбласти
