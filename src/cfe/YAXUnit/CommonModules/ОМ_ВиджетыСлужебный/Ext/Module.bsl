#Область Тесты

Процедура МетодКонфигурации_ЗначениеЗаписываетсяВКэш() Экспорт
	
	Показатель = СоздатьПоказательМетода("ИсточникЧисло");
	
	ДоРасчета = пбп_Виджеты.ЗначенияПоказателей(МассивПоказателей(Показатель)).Получить(Показатель);
	ЮТест.ОжидаетЧто(ДоРасчета.Актуально).ЭтоЛожь();
	ЮТест.ОжидаетЧто(ДоРасчета.ДатаРасчета).НеЗаполнено();
	
	Значение = РассчитанноеЗначение(Показатель);
	ЮТест.ОжидаетЧто(Значение.Ошибка).Равно("");
	ЮТест.ОжидаетЧто(Значение.Значение).Равно(42);
	ЮТест.ОжидаетЧто(Значение.Актуально).ЭтоИстина();
	ЮТест.ОжидаетЧто(Значение.ДатаРасчета).Заполнено();
	
КонецПроцедуры

Процедура ПользовательскаяФункция_ВозвращаетРезультат() Экспорт
	
	ИспользоватьФункции = Константы.пбп_ИспользоватьПользовательскиеФункции.Получить();
	УстановитьИспользованиеПользовательскихФункций(Истина);
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("ВидИсточника", Перечисления.пбп_ВидыИсточниковПоказателейВиджетов.ПользовательскаяФункция);
	Реквизиты.Вставить("ПользовательскаяФункция", СоздатьПользовательскуюФункцию("Результат = 7;"));
	Реквизиты.Вставить("ПериодАктуальности", 3600);
	Значение = РассчитанноеЗначение(СоздатьПоказатель(Реквизиты));
	
	УстановитьИспользованиеПользовательскихФункций(ИспользоватьФункции);
	
	ЮТест.ОжидаетЧто(Значение.Ошибка).Равно("");
	ЮТест.ОжидаетЧто(Значение.Значение).Равно(7);
	
КонецПроцедуры

Процедура НастройкаОтбора_ВозвращаетКоличествоОбъектов() Экспорт
	
	Наименование = "Стол виджетов " + Строка(Новый УникальныйИдентификатор);
	Для Счетчик = 1 По 2 Цикл
		
		ЮТест.Данные().КонструкторОбъекта(Справочники.пбп_РабочиеСтолы)
			.Установить("Наименование", Наименование)
			.Записать();
		
	КонецЦикла;
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("ВидИсточника", Перечисления.пбп_ВидыИсточниковПоказателейВиджетов.НастройкаОтбора);
	Реквизиты.Вставить("НастройкаОтбора", СоздатьНастройкуОтбораПоНаименованию(Наименование));
	Реквизиты.Вставить("ПериодАктуальности", 3600);
	Значение = РассчитанноеЗначение(СоздатьПоказатель(Реквизиты));
	
	ЮТест.ОжидаетЧто(Значение.Ошибка).Равно("");
	ЮТест.ОжидаетЧто(Значение.Значение).Равно(2);
	
КонецПроцедуры

Процедура ГрупповойПоказатель_РассчитываетсяОдинРаз() Экспорт
	
	Групповой = СоздатьПоказательМетода("ИсточникГрупповой");
	Первый = СоздатьПоказательГруппового(Групповой, "Первое");
	Второй = СоздатьПоказательГруппового(Групповой, "Второе");
	
	Значения = пбп_Виджеты.ЗначенияПоказателей(МассивПоказателей(Первый, Второй), Истина);
	ЗначениеПервого = Значения.Получить(Первый).Значение;
	ЗначениеВторого = Значения.Получить(Второй).Значение;
	
	ЮТест.ОжидаетЧто(ЗначениеПервого).Заполнено();
	ЮТест.ОжидаетЧто(ЗначениеВторого).Равно(ЗначениеПервого);
	
КонецПроцедуры

Процедура ГрупповойБезСвойства_ЗаписываетОшибку() Экспорт
	
	Групповой = СоздатьПоказательМетода("ИсточникГрупповой");
	Значение = РассчитанноеЗначение(СоздатьПоказательГруппового(Групповой, "Третье"));
	
	ЮТест.ОжидаетЧто(Значение.Значение).Равно(Неопределено);
	ЮТест.ОжидаетЧто(Значение.Ошибка).Содержит("Третье");
	
КонецПроцедуры

Процедура АктуальноеЗначение_НеПересчитывается() Экспорт
	
	Показатель = СоздатьПоказательМетода("ИсточникУникальноеЗначение", 3600);
	
	Первое = РассчитанноеЗначение(Показатель);
	Второе = РассчитанноеЗначение(Показатель);
	
	ЮТест.ОжидаетЧто(Первое.Значение).Заполнено();
	ЮТест.ОжидаетЧто(Второе.Значение).Равно(Первое.Значение);
	
КонецПроцедуры

Процедура НулевойПериод_ПересчитываетсяКаждыйРаз() Экспорт
	
	Показатель = СоздатьПоказательМетода("ИсточникУникальноеЗначение", 0);
	
	Первое = РассчитанноеЗначение(Показатель);
	Второе = РассчитанноеЗначение(Показатель);
	
	ЮТест.ОжидаетЧто(Второе.Значение).Заполнено();
	ЮТест.ОжидаетЧто(Второе.Значение).НеРавно(Первое.Значение);
	ЮТест.ОжидаетЧто(Второе.Актуально).ЭтоЛожь();
	
КонецПроцедуры

Процедура ОшибкаИсточника_НеПрерываетРасчет() Экспорт
	
	СОшибкой = СоздатьПоказательМетода("ИсточникСОшибкой");
	БезОшибки = СоздатьПоказательМетода("ИсточникЧисло");
	
	Значения = пбп_Виджеты.ЗначенияПоказателей(МассивПоказателей(СОшибкой, БезОшибки), Истина);
	ЗначениеСОшибкой = Значения.Получить(СОшибкой);
	
	ЮТест.ОжидаетЧто(ЗначениеСОшибкой.Ошибка).Содержит("Ошибка тестового источника");
	ЮТест.ОжидаетЧто(ЗначениеСОшибкой.ДатаРасчета).Заполнено();
	ЮТест.ОжидаетЧто(Значения.Получить(БезОшибки).Значение).Равно(42);
	
КонецПроцедуры

Процедура ОбщийПоказатель_ЗаписываетсяБезПользователя() Экспорт
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("ВидИсточника", Перечисления.пбп_ВидыИсточниковПоказателейВиджетов.МетодКонфигурации);
	Реквизиты.Вставить("ИмяМетода", "ОМ_ВиджетыСлужебный.ИсточникЧисло");
	Реквизиты.Вставить("ПериодАктуальности", 3600);
	Реквизиты.Вставить("Общий", Истина);
	Показатель = СоздатьПоказатель(Реквизиты);
	
	Значение = РассчитанноеЗначение(Показатель);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Значения.Пользователь КАК Пользователь
	|ИЗ
	|	РегистрСведений.пбп_ЗначенияПоказателейВиджетов КАК Значения
	|ГДЕ
	|	Значения.Показатель = &Показатель";
	Запрос.УстановитьПараметр("Показатель", Показатель);
	Записи = Запрос.Выполнить().Выгрузить();
	ПустойПользователь = Метаданные.ОпределяемыеТипы.пбп_Пользователи.Тип.ПривестиЗначение(Неопределено);
	
	ЮТест.ОжидаетЧто(Значение.Значение).Равно(42);
	ЮТест.ОжидаетЧто(Записи.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Записи[0].Пользователь).Равно(ПустойПользователь);
	
КонецПроцедуры

Процедура СбросКэша_УдаляетЗначение() Экспорт
	
	Показатель = СоздатьПоказательМетода("ИсточникЧисло");
	Значение = РассчитанноеЗначение(Показатель);
	ЮТест.ОжидаетЧто(Значение.ДатаРасчета).Заполнено();
	
	пбп_Виджеты.СброситьКэшПоказателей(МассивПоказателей(Показатель));
	
	ПослеСброса = пбп_Виджеты.ЗначенияПоказателей(МассивПоказателей(Показатель)).Получить(Показатель);
	ЮТест.ОжидаетЧто(ПослеСброса.ДатаРасчета).НеЗаполнено();
	ЮТест.ОжидаетЧто(ПослеСброса.Актуально).ЭтоЛожь();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьПоказатель(Реквизиты)
	
	Конструктор = ЮТест.Данные().КонструкторОбъекта(Справочники.пбп_ПоказателиВиджетов)
		.Установить("Наименование", "Показатель " + Строка(Новый УникальныйИдентификатор));
	Для Каждого КлючИЗначение Из Реквизиты Цикл
		
		Конструктор.Установить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		
	КонецЦикла;
	
	Возврат Конструктор.Записать();
	
КонецФункции

Функция СоздатьПоказательМетода(ИмяМетода, ПериодАктуальности = 3600)
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("ВидИсточника", Перечисления.пбп_ВидыИсточниковПоказателейВиджетов.МетодКонфигурации);
	Реквизиты.Вставить("ИмяМетода", "ОМ_ВиджетыСлужебный." + ИмяМетода);
	Реквизиты.Вставить("ПериодАктуальности", ПериодАктуальности);
	
	Возврат СоздатьПоказатель(Реквизиты);
	
КонецФункции

Функция СоздатьПоказательГруппового(ГрупповойПоказатель, ИмяСвойства)
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("ГрупповойПоказатель", ГрупповойПоказатель);
	Реквизиты.Вставить("СвойствоГрупповогоПоказателя", ИмяСвойства);
	Реквизиты.Вставить("ПериодАктуальности", 3600);
	
	Возврат СоздатьПоказатель(Реквизиты);
	
КонецФункции

Функция РассчитанноеЗначение(Показатель)
	
	Значения = пбп_Виджеты.ЗначенияПоказателей(МассивПоказателей(Показатель), Истина);
	
	Возврат Значения.Получить(Показатель);
	
КонецФункции

Функция МассивПоказателей(Первый, Второй = Неопределено)
	
	Результат = Новый Массив;
	Результат.Добавить(Первый);
	Если Второй <> Неопределено Тогда
		
		Результат.Добавить(Второй);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СоздатьПользовательскуюФункцию(КодПодпрограммы)
	
	Код = "YAX" + Прав(СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", ""), 12);
	Контекст = Перечисления.пбп_КонтекстыВыполненияПользовательскихФункций.Произвольный;
	
	Возврат ЮТест.Данные().КонструкторОбъекта(Справочники.пбп_ПользовательскиеФункции)
		.Установить("Код", Код)
		.Установить("Наименование", "Функция виджета " + Код)
		.Установить("Контекст", Контекст)
		.Установить("КодПодпрограммы", КодПодпрограммы)
		.Записать(Ложь, Истина);
	
КонецФункции

Функция СоздатьНастройкуОтбораПоНаименованию(Наименование)
	
	Настройки = Новый НастройкиКомпоновкиДанных;
	ЭлементОтбора = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Наименование");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Наименование;
	ЭлементОтбора.Использование = Истина;
	
	Возврат ЮТест.Данные().КонструкторОбъекта(Справочники.пбп_НастройкиОтбораОбъектов)
		.Установить("Наименование", "Отбор " + Наименование)
		.Установить("ОбъектМетаданных", "Справочник.пбп_РабочиеСтолы")
		.Установить("Отбор", пбп_Переадресация.ЗначениеВСтрокуXML(Настройки.Отбор))
		.Записать(Ложь, Истина);
	
КонецФункции

Процедура УстановитьИспользованиеПользовательскихФункций(Использовать)
	
	Константы.пбп_ИспользоватьПользовательскиеФункции.Установить(Использовать);
	ОбновитьПовторноИспользуемыеЗначения();
	
КонецПроцедуры

#КонецОбласти
