// Источник тестового показателя: вызывается через пбп_Переадресация.ВызватьФункциюКонфигурации.
//
// Параметры:
//  ПараметрыРасчета - Структура - Показатель и Пользователь.
//
// Возвращаемое значение:
//  Число - постоянное значение 42.
//
Функция ИсточникЧисло(ПараметрыРасчета) Экспорт
	
	Возврат 42;
	
КонецФункции

// Источник тестового показателя: каждый вызов возвращает новое значение.
//
// Параметры:
//  ПараметрыРасчета - Структура - Показатель и Пользователь.
//
// Возвращаемое значение:
//  Строка - новый уникальный идентификатор.
//
Функция ИсточникУникальноеЗначение(ПараметрыРасчета) Экспорт
	
	Возврат Строка(Новый УникальныйИдентификатор);
	
КонецФункции

// Источник тестового группового показателя: оба свойства одного вызова равны.
//
// Параметры:
//  ПараметрыРасчета - Структура - Показатель и Пользователь.
//
// Возвращаемое значение:
//  Структура - свойства Первое и Второе с одним новым идентификатором.
//
Функция ИсточникГрупповой(ПараметрыРасчета) Экспорт
	
	Метка = Строка(Новый УникальныйИдентификатор);
	
	Возврат Новый Структура("Первое, Второе", Метка, Метка);
	
КонецФункции

