	Реквизиты.Вставить("СтрокаПодключения", "C:\ЮТ_Обмен");
	Реквизиты.Вставить("Порт", 8080);
	Реквизиты.Вставить("ТипАвторизации", Перечисления.пбп_ТипыАвторизации.Базовая);
