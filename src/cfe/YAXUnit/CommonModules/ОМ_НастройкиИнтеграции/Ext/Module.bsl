		.ДобавитьТест("СтруктураНастроек_БезопасноеХранилище_Дополняет").ВТранзакции()
		.ДобавитьТест("СтруктураНастроек_БезАвторизации_НеВозвращаетСекреты").ВТранзакции()
		// Форма элемента, тип «Брокер 1С:Шина»
