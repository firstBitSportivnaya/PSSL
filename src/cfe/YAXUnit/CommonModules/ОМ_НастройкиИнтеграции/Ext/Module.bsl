#Область ТестовыеДанные

Функция НоваяНастройкаИнтеграции(ТипИнтеграции, Реквизиты = Неопределено)
	
	Конструктор = ЮТест.Данные().КонструкторОбъекта("Справочник.пбп_НастройкиИнтеграции")
		.Установить("Наименование", "ЮТ_НастройкаИнтеграции")
		.Установить("ИнтегрируемаяСистема", НоваяИнтегрируемаяСистема())
		.Установить("ТипИнтеграции", ТипИнтеграции);
	
	Если Реквизиты <> Неопределено Тогда
		
		Для Каждого КлючИЗначение Из Реквизиты Цикл
			Конструктор.Установить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Конструктор.Записать();
	
КонецФункции

Функция НоваяИнтегрируемаяСистема()
	
	Возврат ЮТест.Данные().КонструкторОбъекта("Справочник.пбп_ИнтегрируемыеСистемы")
		.Установить("Наименование", "ЮТ_ИнтегрируемаяСистема")
		.Записать();
	
КонецФункции

// Безопасное хранилище недоступно вне привилегированного режима, как и в прикладном коде подсистемы.
Процедура ЗаписатьПараметрыАутентификации(НастройкаИнтеграции)
	
	ПараметрыАутентификации = Новый Структура("Токен", "ЮТ_ЗначениеТокена");
	
	УстановитьПривилегированныйРежим(Истина);
	пбп_Переадресация.ЗаписатьДанныеВБезопасноеХранилище(НастройкаИнтеграции, ПараметрыАутентификации);
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

// Хранилище не участвует в транзакции теста, поэтому данные удаляются явно.
Процедура УдалитьПараметрыАутентификации(НастройкаИнтеграции)
	
	УстановитьПривилегированныйРежим(Истина);
	пбп_Переадресация.УдалитьДанныеИзБезопасногоХранилища(НастройкаИнтеграции);
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

