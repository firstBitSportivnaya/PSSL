Процедура СтруктураНастроек_ДополнительныеНастройки_Дополняет() Экспорт
	
	НастройкаИнтеграции = ЮТест.Данные().КонструкторОбъекта("Справочник.пбп_НастройкиИнтеграции")
		.Установить("Наименование", "ЮТ_НастройкаИнтеграции")
		.Установить("ИнтегрируемаяСистема", НоваяИнтегрируемаяСистема())
		.Установить("ТипИнтеграции", Справочники.пбп_ТипыИнтеграций.RESTAPI)
		.ТабличнаяЧасть("ДополнительныеНастройки")
			.ДобавитьСтроку()
				.Установить("Идентификатор", "ЮТ_Параметр")
				.Установить("Значение", "ЮТ_ЗначениеПараметра")
		.Записать();
	
	СтруктураНастроек = пбп_ИнтеграцииСлужебный.ПолучитьСтруктуруНастроекИнтеграции(НастройкаИнтеграции, Истина);
	
	ЮТест.ОжидаетЧто(СтруктураНастроек.ЮТ_Параметр).Равно("ЮТ_ЗначениеПараметра");
	
КонецПроцедуры

Процедура СтруктураНастроек_БезопасноеХранилище_Дополняет() Экспорт
	
	Реквизиты = Новый Структура("ТипАвторизации", Перечисления.пбп_ТипыАвторизации.Токен);
	
	НастройкаИнтеграции = НоваяНастройкаИнтеграции(Справочники.пбп_ТипыИнтеграций.RESTAPI, Реквизиты);
	ЗаписатьПараметрыАутентификации(НастройкаИнтеграции);
	
	СтруктураНастроек = пбп_ИнтеграцииСлужебный.ПолучитьСтруктуруНастроекИнтеграции(НастройкаИнтеграции);
	
	УдалитьПараметрыАутентификации(НастройкаИнтеграции);
	
	ЮТест.ОжидаетЧто(СтруктураНастроек.Токен).Равно("ЮТ_ЗначениеТокена");
	
КонецПроцедуры

