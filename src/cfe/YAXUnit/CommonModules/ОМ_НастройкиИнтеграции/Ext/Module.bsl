		.ДобавитьТест("ФормаЭлемента_RESTAPI_БлокКнопокОбработкиСкрыт").ВТранзакции()
		.ДобавитьТест("ФормаЭлемента_ТехническаяНастройка_ГруппаВыполненияСкрыта").ВТранзакции()
		.ДобавитьТест("ФормаЭлемента_Kafka_КнопкаВнешнейКомпонентыСкрыта").ВТранзакции()
		.ДобавитьТест("ФормаЭлемента_ОтобратьНаСервере_ФильтрОчищаетСписокСообщений").ВТранзакции()
		.ДобавитьТест("УстановитьТекущиеЗначенияСтроки_ПустойСервис_ВозвращаетПустыеПоля")
		.ДобавитьТест("ПроверкаЗаполнения_Брокер1СШина_НеТребуетСтрокуПодключения").ВТранзакции();
	
КонецПроцедуры

