Процедура ТестДолженОбрабатыватьПустыеЗначения() Экспорт

	ПустаяДата = Дата(1, 1, 1, 0, 0, 0);

	Результат1 = пбп_СтроковыеФункцииКлиентСервер.ПреобразоватьДатуИзСтрокиПоФормату("", "0_0_0");
	Результат2 = пбп_СтроковыеФункцииКлиентСервер.ПреобразоватьДатуИзСтрокиПоФормату("2024-01-02T03:04:05", "");

	ЮТест.ОжидаетЧто(Результат1).Равно(ПустаяДата);
	ЮТест.ОжидаетЧто(Результат2).Равно(ПустаяДата);

