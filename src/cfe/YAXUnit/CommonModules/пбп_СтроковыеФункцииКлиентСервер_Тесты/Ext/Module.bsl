Процедура ТестВебКлиентДолженОбрабатыватьОшибки() Экспорт

	// Тест для веб-клиента: проверяем обработку некорректных данных
	ПустаяДата = Дата(1, 1, 1, 0, 0, 0);

	Результат1 = пбп_СтроковыеФункцииКлиентСервер.ПреобразоватьДатуИзСтрокиПоФормату("неправильная_строка", "0_0_0");
	Результат2 = пбп_СтроковыеФункцииКлиентСервер.ПреобразоватьДатуИзСтрокиПоФормату("2024-13-45T25:70:80", "0_0_0");

	ЮТест.ОжидаетЧто(Результат1).Равно(ПустаяДата);
	ЮТест.ОжидаетЧто(Результат2).Равно(ПустаяДата);

