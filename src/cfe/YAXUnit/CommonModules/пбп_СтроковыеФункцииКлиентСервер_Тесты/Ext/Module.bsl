	ОжидаемаяДата = Дата(2024, 1, 2, 15, 30, 45);

	Результат = пбп_СтроковыеФункцииКлиентСервер.ПреобразоватьДатуИзСтрокиПоФормату(ИсходнаяСтрока, "3_1_1");

	ЮТест.ОжидаетЧто(ТипЗнч(Результат)).Равно(Тип("Дата"));
	ЮТест.ОжидаетЧто(Результат).Равно(ОжидаемаяДата);

