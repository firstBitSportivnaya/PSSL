	пбп_ОтложенноеПроведениеДокументов.ОтложенноеПроведениеДокументов();
	Состояние = пбп_ОтложенноеПроведениеДокументов.СостояниеОтложенногоПроведения(Ссылка);

	ЮТест.ОжидаетЧто(ЮТКонтекстТеста.Значение("НомерПопыткиИзКонтекста")).Равно(1);
	ЮТест.ОжидаетЧто(ЮТКонтекстТеста.Значение("ЭтоПоследняяПопыткаИзКонтекста")).Равно(Истина);
	ЮТест.ОжидаетЧто(Состояние.КоличествоПопыток).Равно(1);
	ЮТест.ОжидаетЧто(Состояние.ОбработкаПрекращена).Равно(Истина);

