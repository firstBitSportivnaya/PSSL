Процедура ТекстОшибки_ПодменяетсяОбработчиком() Экспорт

	УстановитьОпцию(Истина);
	СброситьФлагиОбработчиков();
	Ссылка = СоздатьДокумент();
	Параметры = пбп_ОтложенноеПроведениеДокументов.ПараметрыОтложенногоПроведения(Ссылка);
	Параметры.ОбработчикПередПроведением = ИмяОбработчика("ОбработчикПередОшибкой");
	Параметры.ОбработчикОшибкиПроведения = ИмяОбработчика("ОбработчикОшибкиТекст");
	пбп_ОтложенноеПроведениеДокументов.ЗапланироватьПроведение(Параметры);
	пбп_ОтложенноеПроведениеДокументов.ОтложенноеПроведениеДокументов();
	Состояние = пбп_ОтложенноеПроведениеДокументов.СостояниеОтложенногоПроведения(Ссылка);

	ЮТест.ОжидаетЧто(ЮТКонтекстТеста.Значение("ВызванОшибка")).Равно(Истина);
	ЮТест.ОжидаетЧто(Состояние.ТекстОшибки).Равно("Заданная ошибка");
