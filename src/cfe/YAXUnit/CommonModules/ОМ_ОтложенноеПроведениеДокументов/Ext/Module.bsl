Процедура ПередЗаписью_ПользовательскаяЗаписьОтказывается() Экспорт

	УстановитьОпцию(Истина);
	Ссылка = СоздатьДокумент();
	Параметры = пбп_ОтложенноеПроведениеДокументов.ПараметрыОтложенногоПроведения(Ссылка);
	пбп_ОтложенноеПроведениеДокументов.ЗапланироватьПроведение(Параметры);
	ДокументОбъект = Ссылка.ПолучитьОбъект();
	ДокументОбъект.Комментарий = "Пользовательская правка";
	Отказ = Ложь;
	пбп_ДокументыОбработкаСобытий.ПередЗаписью(
		ДокументОбъект, Отказ, РежимЗаписиДокумента.Запись, РежимПроведенияДокумента.Неоперативный);

	ЮТест.ОжидаетЧто(Отказ).Равно(Истина);

	Попытка

		ДокументОбъект.Записать();

	Исключение

		Отказ = Истина;

	КонецПопытки;

	ЮТест.ОжидаетЧто(Ссылка.Комментарий).НеРавно("Пользовательская правка");

