	Запись = РегистрыСведений.пбп_НастройкиОтложенногоПроведения.СоздатьМенеджерЗаписи();
	Запись.ИмяДокумента = ИмяДокумента;
	Запись.ВремяОжидания = ВремяОжидания;
	Запись.ШагУвеличенияОжидания = Шаг;
	Запись.МаксимумПопыток = Максимум;
	Запись.ВремяОжиданияЗадано = Истина;
	Запись.ШагУвеличенияОжиданияЗадан = Истина;
	Запись.МаксимумПопытокЗадан = Истина;
	Запись.Записать();

