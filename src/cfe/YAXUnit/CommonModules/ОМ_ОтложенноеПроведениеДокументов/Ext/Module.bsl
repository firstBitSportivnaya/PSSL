	ДокументОбъект.Комментарий = "Запись задания";
	ДокументОбъект.ДополнительныеСвойства.Вставить("пбп_ОтложенноеПроведение", Истина);
	ДокументОбъект.Записать();

	ЮТест.ОжидаетЧто(Ссылка.Комментарий).Равно("Запись задания");

КонецПроцедуры

Процедура Отмена_СнимаетСтроку() Экспорт

	УстановитьОпцию(Истина);
	Ссылка = СоздатьДокумент();
	Параметры = пбп_ОтложенноеПроведениеДокументов.ПараметрыОтложенногоПроведения(Ссылка);
	пбп_ОтложенноеПроведениеДокументов.ЗапланироватьПроведение(Параметры);
	пбп_ОтложенноеПроведениеДокументов.ОтменитьОтложенноеПроведение(Ссылка);

	ЮТест.ОжидаетЧто(пбп_ОтложенноеПроведениеДокументов.СостояниеОтложенногоПроведения(Ссылка)).Равно(Неопределено);

КонецПроцедуры

Процедура ЗаданиеПриВыключеннойОпции_НеПроводит() Экспорт

	УстановитьОпцию(Истина);
	Ссылка = СоздатьДокумент();
	Параметры = пбп_ОтложенноеПроведениеДокументов.ПараметрыОтложенногоПроведения(Ссылка);
	пбп_ОтложенноеПроведениеДокументов.ЗапланироватьПроведение(Параметры);
	УстановитьОпцию(Ложь);
	пбп_ОтложенноеПроведениеДокументов.ОтложенноеПроведениеДокументов();
	Состояние = пбп_ОтложенноеПроведениеДокументов.СостояниеОтложенногоПроведения(Ссылка);

	ЮТест.ОжидаетЧто(Ссылка.Проведен).Равно(Ложь);
	ЮТест.ОжидаетЧто(Состояние).НеРавно(Неопределено);
	ЮТест.ОжидаетЧто(Состояние.Активна).Равно(Истина);

