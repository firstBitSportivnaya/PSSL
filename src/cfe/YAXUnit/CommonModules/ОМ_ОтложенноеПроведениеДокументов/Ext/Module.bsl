Процедура Параметры_СодержатПоляКонтракта() Экспорт

	Ссылка = Документы.ДемоРаботаСФормами.ПустаяСсылка();
	Параметры = пбп_ОтложенноеПроведениеДокументов.ПараметрыОтложенногоПроведения(Ссылка);

	ЮТест.ОжидаетЧто(Параметры.Объект).Равно(Ссылка);
	ЮТест.ОжидаетЧто(Параметры.Перепроведение).Равно(Ложь);
	ЮТест.ОжидаетЧто(Параметры.ДатаСледующейПопытки).Равно(Дата(1, 1, 1));
	ЮТест.ОжидаетЧто(Параметры.ВремяОжидания).Равно(Неопределено);
	ЮТест.ОжидаетЧто(Параметры.ШагУвеличенияОжидания).Равно(Неопределено);
	ЮТест.ОжидаетЧто(Параметры.МаксимумПопыток).Равно(Неопределено);
	ЮТест.ОжидаетЧто(Параметры.ОбработчикПередПроведением).Равно("");
	ЮТест.ОжидаетЧто(Параметры.ОбработчикПослеПроведения).Равно("");
	ЮТест.ОжидаетЧто(Параметры.ОбработчикОшибкиПроведения).Равно("");
	ЮТест.ОжидаетЧто(Параметры.СброситьПопытки).Равно(Ложь);
	ЮТест.ОжидаетЧто(Параметры.ДополнительныеПараметры).ИмеетТип("Структура");

КонецПроцедуры

Процедура ПостановкаПриВыключеннойОпции_ВыбрасываетИсключение() Экспорт

	УстановитьОпцию(Ложь);
	Ссылка = СоздатьДокумент();
	Параметры = пбп_ОтложенноеПроведениеДокументов.ПараметрыОтложенногоПроведения(Ссылка);
	ПараметрыВызова = Мокито.МассивПараметров(Параметры);

	ЮТест.ОжидаетЧто(пбп_ОтложенноеПроведениеДокументов)
		.Метод("ЗапланироватьПроведение", ПараметрыВызова)
		.ВыбрасываетИсключение("выключено");
