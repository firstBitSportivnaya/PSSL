Функция СоздатьДокумент()

	ДокументОбъект = Документы.ДемоРаботаСФормами.СоздатьДокумент();
	ДокументОбъект.Дата = ТекущаяДатаСеанса();
	ДокументОбъект.Записать();

	Возврат ДокументОбъект.Ссылка;

