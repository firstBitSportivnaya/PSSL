	пбп_ОтложенноеПроведениеДокументов.ОтложенноеПроведениеДокументов();

	ЮТест.ОжидаетЧто(ПолученныеПараметры.Код).Равно("ABC");
	ЮТест.ОжидаетЧто(ПолученныеПараметры.Количество).Равно(2);
