	"ВЫБРАТЬ
	|	Дополнительный.Номер КАК Номер
	|ИЗ
	|	(ВЫБРАТЬ
	|		1 КАК Номер) КАК Основной
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			1 КАК Номер) КАК Дополнительный
	|		ПО Основной.Номер = Дополнительный.Номер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Основной.Номер КАК Номер
	|ИЗ
	|	(ВЫБРАТЬ
	|		1 КАК Номер) КАК Основной";

КонецФункции

Функция ТекстЗапросаВложенногоСоединения()

	Возврат
	"ВЫБРАТЬ
	|	Основной.Номер КАК Номер
	|ИЗ
	|	(ВЫБРАТЬ
	|		1 КАК Номер) КАК Основной
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			1 КАК Номер) КАК Внешний
	|			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|				1 КАК Номер) КАК Внутренний
	|			ПО Внешний.Номер = Внутренний.Номер
	|		ПО Основной.Номер = Внешний.Номер";

КонецФункции

Функция ТекстЗапросаСИсточникомПодзапроса()

	Возврат
	"ВЫБРАТЬ
	|	Вложенный.Номер КАК Номер
	|ИЗ
	|	(ВЫБРАТЬ
	|		Основной.Номер КАК Номер
	|	ИЗ
	|		(ВЫБРАТЬ
	|			1 КАК Номер) КАК Основной
	|			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|				2 КАК Номер) КАК Лишний
	|			ПО Основной.Номер = Лишний.Номер) КАК Вложенный";

КонецФункции

Функция ЕстьПсевдонимВОператоре(ОператорЗапроса, Псевдоним)

	Если Не ОператорЗапроса.Источники.НайтиПоПсевдониму(Псевдоним) = Неопределено Тогда

		Возврат Истина;

	КонецЕсли;

	Для Каждого Источник Из ОператорЗапроса.Источники Цикл

		Если ЕстьПсевдонимВИсточнике(Источник, Псевдоним) Тогда

			Возврат Истина;

		КонецЕсли;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ЕстьПсевдонимВИсточнике(Источник, Псевдоним)

	Если Не Источник.Соединения.НайтиПоПсевдониму(Псевдоним) = Неопределено Тогда

		Возврат Истина;

	КонецЕсли;

	Для Каждого Соединение Из Источник.Соединения Цикл

		Если ЕстьПсевдонимВИсточнике(Соединение.Источник, Псевдоним) Тогда

			Возврат Истина;

		КонецЕсли;

	КонецЦикла;

	Если ТипЗнч(Источник.Источник) = Тип("ВложенныйЗапросСхемыЗапроса") Тогда

		Для Каждого ОператорПодзапроса Из Источник.Источник.Запрос.Операторы Цикл

			Если ЕстьПсевдонимВОператоре(ОператорПодзапроса, Псевдоним) Тогда

				Возврат Истина;

			КонецЕсли;

		КонецЦикла;

	КонецЕсли;

	Возврат Ложь;

КонецФункции
Функция ЕстьПсевдонимИсточника(ТекстЗапроса, Псевдоним, ИндексЗапроса = 0, ИндексОператора = 0)

	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);

	ЗапросПакета = СхемаЗапроса.ПакетЗапросов.Получить(ИндексЗапроса);

	Если ТипЗнч(ЗапросПакета) = Тип("ЗапросУничтоженияТаблицыСхемыЗапроса") Тогда

		Возврат Ложь;

	КонецЕсли;

	ОператорЗапроса = ЗапросПакета.Операторы.Получить(ИндексОператора);

	Возврат ЕстьПсевдонимВОператоре(ОператорЗапроса, Псевдоним);

КонецФункции

Функция ТекстЗапросаСПолемУдаляемогоИсточника()

	Возврат
	"ВЫБРАТЬ
	|	Дополнительный.Номер КАК Номер
	|ИЗ
	|	(ВЫБРАТЬ
	|		1 КАК Номер) КАК Основной
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			1 КАК Номер) КАК Дополнительный
	|		ПО Основной.Номер = Дополнительный.Номер";

КонецФункции

