	ЮТест.ОжидаетЧто(ЕстьПсевдонимИсточника(Результат, "Основной")).Равно(Истина);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТекстЗапросаСОднимСоединением()

	Возврат
	"ВЫБРАТЬ
	|	Основной.Номер КАК Номер
	|ИЗ
	|	(ВЫБРАТЬ
	|		1 КАК Номер) КАК Основной
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			1 КАК Номер) КАК Дополнительный
	|		ПО Основной.Номер = Дополнительный.Номер";

КонецФункции

Функция ТекстЗапросаСДвумяСоединениями()

	Возврат
	"ВЫБРАТЬ
	|	Основной.Номер КАК Номер
	|ИЗ
	|	(ВЫБРАТЬ
	|		1 КАК Номер) КАК Основной
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			1 КАК Номер) КАК Первый
	|		ПО Основной.Номер = Первый.Номер
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			2 КАК Номер) КАК Второй
	|		ПО Основной.Номер = Второй.Номер";

КонецФункции

Функция ТекстЗапросаПакета()

	Возврат
	"ВЫБРАТЬ
	|	Основной.Номер КАК Номер
	|ПОМЕСТИТЬ ВТНомера
	|ИЗ
	|	(ВЫБРАТЬ
	|		1 КАК Номер) КАК Основной
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			1 КАК Номер) КАК ЛишнийВПервом
	|		ПО Основной.Номер = ЛишнийВПервом.Номер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТНомера.Номер КАК Номер
	|ИЗ
	|	ВТНомера КАК ВТНомера
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			1 КАК Номер) КАК ЛишнийВоВтором
	|		ПО ВТНомера.Номер = ЛишнийВоВтором.Номер";

КонецФункции

Функция ТекстЗапросаОбъединения()

	Возврат
	"ВЫБРАТЬ
	|	Основной.Номер КАК Номер
	|ИЗ
	|	(ВЫБРАТЬ
	|		1 КАК Номер) КАК Основной
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			1 КАК Номер) КАК ЛишнийВПервом
	|		ПО Основной.Номер = ЛишнийВПервом.Номер
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Основной.Номер
	|ИЗ
	|	(ВЫБРАТЬ
	|		1 КАК Номер) КАК Основной
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			1 КАК Номер) КАК ЛишнийВоВтором
	|		ПО Основной.Номер = ЛишнийВоВтором.Номер";

КонецФункции

Функция ТекстЗапросаСУничтожением()

	Возврат
	"ВЫБРАТЬ
	|	Основной.Номер КАК Номер
	|ПОМЕСТИТЬ ВТНомера
	|ИЗ
	|	(ВЫБРАТЬ
	|		1 КАК Номер) КАК Основной
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			1 КАК Номер) КАК Лишний
	|		ПО Основной.Номер = Лишний.Номер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТНомера";

КонецФункции

Функция ЕстьПсевдонимИсточника(ТекстЗапроса, Псевдоним, ИндексЗапроса = 0, ИндексОператора = 0)

	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);

	ЗапросПакета = СхемаЗапроса.ПакетЗапросов.Получить(ИндексЗапроса);

	Если ТипЗнч(ЗапросПакета) = Тип("ЗапросУничтоженияТаблицыСхемыЗапроса") Тогда

		Возврат Ложь;

	КонецЕсли;

	ОператорЗапроса = ЗапросПакета.Операторы.Получить(ИндексОператора);

	Если Не ОператорЗапроса.Источники.НайтиПоПсевдониму(Псевдоним) = Неопределено Тогда

		Возврат Истина;

	КонецЕсли;

	Для Каждого Источник Из ОператорЗапроса.Источники Цикл

		Если Не Источник.Соединения.НайтиПоПсевдониму(Псевдоним) = Неопределено Тогда

			Возврат Истина;

		КонецЕсли;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

Процедура ТестДолженВернутьПустойТекстПриСсылкеВВыборке() Экспорт

	ТекстЗапроса = ТекстЗапросаСПолемУдаляемогоИсточника();

	Результат = пбп_СхемыЗапросов.УдалитьИсточникИзЗапроса(ТекстЗапроса, "Дополнительный");

	ЮТест.ОжидаетЧто(ТипЗнч(Результат)).Равно(Тип("Строка"));
	ЮТест.ОжидаетЧто(Результат).Равно("");

КонецПроцедуры

#КонецОбласти

Функция ТекстЗапросаСПолемУдаляемогоИсточника()

	Возврат
	"ВЫБРАТЬ
	|	Дополнительный.Номер КАК Номер
	|ИЗ
	|	(ВЫБРАТЬ
	|		1 КАК Номер) КАК Основной
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			1 КАК Номер) КАК Дополнительный
	|		ПО Основной.Номер = Дополнительный.Номер";

КонецФункции
