#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт
	ЮТТесты
		.ДобавитьТестовыйНабор("УдалитьИсточникИзЗапроса")
			.ДобавитьТест("ТестДолженУдалитьСоединениеПоСтрокеПсевдонимов")
			.ДобавитьТест("ТестДолженУдалитьИсточникБезЯвногоСоединения")
			.ДобавитьТест("ТестДолженУдалитьИсточникиПоМассивуПсевдонимов")
			.ДобавитьТест("ТестДолженУдалитьИсточникТолькоВЗапросеПакета")
			.ДобавитьТест("ТестДолженУдалитьИсточникТолькоВОператоре")
			.ДобавитьТест("ТестДолженПропуститьЗапросУничтожения")
			.ДобавитьТест("ТестДолженЗаписатьТекстВОбъектЗапрос")
			.ДобавитьТест("ТестДолженСохранитьИсточникиПриНеизвестномПсевдониме")
			.ДобавитьТест("ТестДолженУдалитьИсточникСПробеламиВСписке")
			.ДобавитьТест("ТестДолженВернутьПустойТекстПриСсылкеВВыборке");
КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура ТестДолженУдалитьСоединениеПоСтрокеПсевдонимов() Экспорт

	ТекстЗапроса = ТекстЗапросаСОднимСоединением();

	Результат = пбп_СхемыЗапросов.УдалитьИсточникИзЗапроса(ТекстЗапроса, "Дополнительный");

	ЮТест.ОжидаетЧто(ТипЗнч(Результат)).Равно(Тип("Строка"));
	ЮТест.ОжидаетЧто(ЕстьПсевдонимИсточника(Результат, "Дополнительный")).Равно(Ложь);
	ЮТест.ОжидаетЧто(ЕстьПсевдонимИсточника(Результат, "Основной")).Равно(Истина);

КонецПроцедуры

Процедура ТестДолженУдалитьИсточникБезЯвногоСоединения() Экспорт

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Основной.Номер КАК Номер
	|ИЗ
	|	(ВЫБРАТЬ
	|		1 КАК Номер) КАК Основной,
	|	(ВЫБРАТЬ
	|		2 КАК Номер) КАК Лишний";

	Результат = пбп_СхемыЗапросов.УдалитьИсточникИзЗапроса(ТекстЗапроса, "Лишний");

	ЮТест.ОжидаетЧто(ЕстьПсевдонимИсточника(Результат, "Лишний")).Равно(Ложь);
	ЮТест.ОжидаетЧто(ЕстьПсевдонимИсточника(Результат, "Основной")).Равно(Истина);

КонецПроцедуры

Процедура ТестДолженУдалитьИсточникиПоМассивуПсевдонимов() Экспорт

	Псевдонимы = Новый Массив;
	Псевдонимы.Добавить("Первый");
	Псевдонимы.Добавить("Второй");

	Результат = пбп_СхемыЗапросов.УдалитьИсточникИзЗапроса(ТекстЗапросаСДвумяСоединениями(), Псевдонимы);

	ЮТест.ОжидаетЧто(ЕстьПсевдонимИсточника(Результат, "Первый")).Равно(Ложь);
	ЮТест.ОжидаетЧто(ЕстьПсевдонимИсточника(Результат, "Второй")).Равно(Ложь);
	ЮТест.ОжидаетЧто(ЕстьПсевдонимИсточника(Результат, "Основной")).Равно(Истина);

КонецПроцедуры

Процедура ТестДолженУдалитьИсточникТолькоВЗапросеПакета() Экспорт

	Результат = пбп_СхемыЗапросов.УдалитьИсточникИзЗапроса(ТекстЗапросаПакета(), "ЛишнийВПервом", 0);

	ЮТест.ОжидаетЧто(ЕстьПсевдонимИсточника(Результат, "ЛишнийВПервом", 0)).Равно(Ложь);
	ЮТест.ОжидаетЧто(ЕстьПсевдонимИсточника(Результат, "Основной", 0)).Равно(Истина);
	ЮТест.ОжидаетЧто(ЕстьПсевдонимИсточника(Результат, "ЛишнийВоВтором", 1)).Равно(Истина);

КонецПроцедуры

Процедура ТестДолженУдалитьИсточникТолькоВОператоре() Экспорт

	Результат = пбп_СхемыЗапросов.УдалитьИсточникИзЗапроса(
		ТекстЗапросаОбъединения(), "ЛишнийВПервом", 0, 0);

	ЮТест.ОжидаетЧто(ЕстьПсевдонимИсточника(Результат, "ЛишнийВПервом", 0, 0)).Равно(Ложь);
	ЮТест.ОжидаетЧто(ЕстьПсевдонимИсточника(Результат, "Основной", 0, 0)).Равно(Истина);
	ЮТест.ОжидаетЧто(ЕстьПсевдонимИсточника(Результат, "ЛишнийВоВтором", 0, 1)).Равно(Истина);

КонецПроцедуры

Процедура ТестДолженПропуститьЗапросУничтожения() Экспорт

	Результат = пбп_СхемыЗапросов.УдалитьИсточникИзЗапроса(ТекстЗапросаСУничтожением(), "Лишний");

	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(Результат);

	ЮТест.ОжидаетЧто(СхемаЗапроса.ПакетЗапросов.Количество()).Равно(2);
	ЮТест.ОжидаетЧто(ТипЗнч(СхемаЗапроса.ПакетЗапросов.Получить(1)))
		.Равно(Тип("ЗапросУничтоженияТаблицыСхемыЗапроса"));
	ЮТест.ОжидаетЧто(ЕстьПсевдонимИсточника(Результат, "Лишний", 0)).Равно(Ложь);
	ЮТест.ОжидаетЧто(ЕстьПсевдонимИсточника(Результат, "Основной", 0)).Равно(Истина);

КонецПроцедуры

Процедура ТестДолженЗаписатьТекстВОбъектЗапрос() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаСОднимСоединением();

	Результат = пбп_СхемыЗапросов.УдалитьИсточникИзЗапроса(Запрос, "Дополнительный");

	ЮТест.ОжидаетЧто(ТипЗнч(Результат)).Равно(Тип("Запрос"));
	ЮТест.ОжидаетЧто(ЕстьПсевдонимИсточника(Запрос.Текст, "Дополнительный")).Равно(Ложь);
	ЮТест.ОжидаетЧто(ЕстьПсевдонимИсточника(Результат.Текст, "Основной")).Равно(Истина);

КонецПроцедуры

