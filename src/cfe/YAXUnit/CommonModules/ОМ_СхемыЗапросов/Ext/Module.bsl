	|			1 КАК Номер) КАК Лишний
	|		ПО Основной.Номер = Лишний.Номер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТНомера";

КонецФункции

Функция ТекстЗапросаПакетаСВисячейСсылкой()

