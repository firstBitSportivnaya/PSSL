#Область СлужебныйПрограммныйИнтерфейс

// Регистрирует тесты границы minimum и maximum.
Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Граница minimum и maximum")
			.ДобавитьТест("НольНаВключенномМинимумеПроходит")
			.ДобавитьТест("ЗначениеНижеМинимумаОтклоняется")
			.ДобавитьТест("НольНаИсключительномМинимумеОтклоняется")
			.ДобавитьТест("НольНаВключенномМаксимумеПроходит")
			.ДобавитьТест("НольНаИсключительномМаксимумеОтклоняется")
			.ДобавитьТест("ЗначениеВышеМаксимумаОтклоняется");

КонецПроцедуры

#КонецОбласти

#Область Тесты

// minimum = 0 без exclusiveMinimum, значение 0 проходит.
Процедура НольНаВключенномМинимумеПроходит() Экспорт

	Результат = ПроверитьЧисло(0, """minimum"":0");

	ЮТест.ОжидаетЧто(Результат.Результат).Равно(Истина);
	ЮТест.ОжидаетЧто(Результат.Ошибки).НеЗаполнено();

КонецПроцедуры

// minimum = 0 без exclusiveMinimum, значение -1 отклоняется.
Процедура ЗначениеНижеМинимумаОтклоняется() Экспорт

	Результат = ПроверитьЧисло(-1, """minimum"":0");

	ПроверитьТекстОшибки(Результат, "больше или равно");

КонецПроцедуры

// exclusiveMinimum = true, значение 0 отклоняется без фрагмента «или равно».
Процедура НольНаИсключительномМинимумеОтклоняется() Экспорт

	Результат = ПроверитьЧисло(0, """minimum"":0,""exclusiveMinimum"":true");

	ПроверитьТекстОшибки(Результат, "больше", "или равно");

КонецПроцедуры

// maximum = 0 без exclusiveMaximum, значение 0 проходит.
Процедура НольНаВключенномМаксимумеПроходит() Экспорт

	Результат = ПроверитьЧисло(0, """maximum"":0");

	ЮТест.ОжидаетЧто(Результат.Результат).Равно(Истина);
	ЮТест.ОжидаетЧто(Результат.Ошибки).НеЗаполнено();

КонецПроцедуры

// exclusiveMaximum = true, значение 0 отклоняется без фрагмента «или равно».
Процедура НольНаИсключительномМаксимумеОтклоняется() Экспорт

	Результат = ПроверитьЧисло(0, """maximum"":0,""exclusiveMaximum"":true");

	ПроверитьТекстОшибки(Результат, "меньше", "или равно");

КонецПроцедуры

// maximum = 0 без exclusiveMaximum, значение 1 отклоняется.
Процедура ЗначениеВышеМаксимумаОтклоняется() Экспорт

	Результат = ПроверитьЧисло(1, """maximum"":0");

	ПроверитьТекстОшибки(Результат, "меньше или равно");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПроверитьЧисло(Значение, ОграничениеСхемы)

	Спецификация = "{""openapi"": ""3.0.0"", ""info"": {""title"": ""t"", ""version"": ""1""},"
		+ """paths"": {}, ""components"": {""schemas"": {""Сумма"": {""type"": ""number"", "
		+ ОграничениеСхемы
		+ "}}}}";

	Возврат пбп_ВалидаторПакетовСлужебный.Валидировать(Значение, "Сумма", Спецификация);

КонецФункции

Процедура ПроверитьТекстОшибки(Результат, ОбязательныйФрагмент, ЗапрещенныйФрагмент = "")

	ТекстОшибок = СтрСоединить(Результат.Ошибки, Символы.ПС);

	ЮТест.ОжидаетЧто(ТекстОшибок).Содержит(ОбязательныйФрагмент);
	ЮТест.ОжидаетЧто(ТекстОшибок).Содержит("0");

	Если ЗначениеЗаполнено(ЗапрещенныйФрагмент) Тогда

		ЮТест.ОжидаетЧто(ТекстОшибок).НеСодержит(ЗапрещенныйФрагмент);

	КонецЕсли;

КонецПроцедуры

#КонецОбласти
