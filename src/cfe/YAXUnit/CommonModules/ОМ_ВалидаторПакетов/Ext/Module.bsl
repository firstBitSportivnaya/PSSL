#Область СлужебныйПрограммныйИнтерфейс

// Регистрирует тесты границы minimum и maximum.
Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Граница minimum и maximum")
			.ДобавитьТест("НольНаВключенномМинимумеПроходит")
			.ДобавитьТест("ЗначениеНижеМинимумаОтклоняется")
			.ДобавитьТест("НольНаИсключительномМинимумеОтклоняется")
			.ДобавитьТест("ЗначениеВнутриИсключительногоМинимумаПроходит")
			.ДобавитьТест("НольПриЛожномИсключительномМинимумеПроходит")
			.ДобавитьТест("НольНаВключенномМаксимумеПроходит")
			.ДобавитьТест("НольНаИсключительномМаксимумеОтклоняется")
			.ДобавитьТест("ЗначениеВышеМаксимумаОтклоняется")
			.ДобавитьТест("ЦелоеНаВключенномМинимумеПроходит")
			.ДобавитьТест("ЦелоеНаИсключительномМинимумеОтклоняется")
		.ДобавитьТестовыйНабор("Числовые exclusiveMinimum и exclusiveMaximum OpenAPI 3.1")
			.ДобавитьТест("ЧисловойИсключительныйМинимумОтклоняетГраницу")
			.ДобавитьТест("ЧисловойИсключительныйМинимумПропускаетБольшее")
			.ДобавитьТест("ЧисловойИсключительныйМаксимумОтклоняетГраницу")
			.ДобавитьТест("ЧисловойИсключительныйМаксимумПропускаетМеньшее")
			.ДобавитьТест("ОбеГраницыМинимумаДаютОднуОшибку")
			.ДобавитьТест("РавныеГраницыМинимумаСчитаютсяИсключающими")
			.ДобавитьТест("ВключеннаяГраницаМинимумаСтрожеЧисловой")
			.ДобавитьТест("ОбеГраницыМаксимумаДаютОднуОшибку")
			.ДобавитьТест("НечисловойИсключительныйМинимумВызываетИсключение")
		.ДобавитьТестовыйНабор("Ключевое слово not и публичный ВалидироватьОбъекты")
			.ДобавитьТест("ЗначениеПодходящееПодNotОтклоняется")
			.ДобавитьТест("ЗначениеНеПодходящееПодNotПроходит")
			.ДобавитьТест("ОшибкаNotСсылаетсяНаСвойствоАНеНаПодсхему")
			.ДобавитьТест("НеизвестныйТипВNotВызываетИсключение")
			.ДобавитьТест("ВалидироватьОбъектыВозвращаетНевалидныйОбъект");

КонецПроцедуры

#КонецОбласти

#Область Тесты

// minimum = 0 без exclusiveMinimum, значение 0 проходит.
Процедура НольНаВключенномМинимумеПроходит() Экспорт

	ПроверитьУспех(ПроверитьЧисло(0, """minimum"":0"));

КонецПроцедуры

// minimum = 0 без exclusiveMinimum, значение -1 отклоняется.
Процедура ЗначениеНижеМинимумаОтклоняется() Экспорт

	Результат = ПроверитьЧисло(-1, """minimum"":0");

	ПроверитьТекстОшибки(Результат, "Значение <-1> должно быть больше или равно <0>;");

КонецПроцедуры

// exclusiveMinimum = true, значение 0 отклоняется без фрагмента «или равно».
Процедура НольНаИсключительномМинимумеОтклоняется() Экспорт

	Результат = ПроверитьЧисло(0, """minimum"":0,""exclusiveMinimum"":true");

	ПроверитьТекстОшибки(Результат, "Значение <0> должно быть больше <0>;");

КонецПроцедуры

// maximum = 0 без exclusiveMaximum, значение 0 проходит.
Процедура НольНаВключенномМаксимумеПроходит() Экспорт

