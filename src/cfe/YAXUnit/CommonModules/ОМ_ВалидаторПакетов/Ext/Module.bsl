// exclusiveMinimum строкой - ошибка схемы, валидация прерывается исключением.
Процедура НечисловойИсключительныйМинимумВызываетИсключение() Экспорт

	ПроверитьИсключение(0, """minimum"":0,""exclusiveMinimum"":""true""",
		"Ошибка в схеме! Значение exclusiveMinimum должно быть Булево или Число;");

КонецПроцедуры

// not { minimum = 10 }, значение 15 подходит под отрицательную схему и отклоняется.
Процедура ЗначениеПодходящееПодNotОтклоняется() Экспорт

	Результат = ПроверитьЧисло(15, """not"":{""minimum"":10}");

	ПроверитьТекстОшибки(Результат, "<not> Объект не должен соответствовать схеме, а он соответствует;");

КонецПроцедуры

// not { minimum = 10 }, значение 5 не подходит под отрицательную схему и проходит.
Процедура ЗначениеНеПодходящееПодNotПроходит() Экспорт

	ПроверитьУспех(ПроверитьЧисло(5, """not"":{""minimum"":10}"));

КонецПроцедуры

// not { minimum = 10 } со своим description: ошибка not называет свойство без описания подсхемы.
Процедура ОшибкаNotСсылаетсяНаСвойствоАНеНаПодсхему() Экспорт

	Результат = ПроверитьЧисло(15, """not"":{""minimum"":10,""description"":""Подсхема""}");

	ПроверитьТекстОшибки(Результат, "<not> Объект не должен соответствовать схеме, а он соответствует;");

КонецПроцедуры

// Неизвестный type в подсхеме not - ошибка схемы, как и вне not.
Процедура НеизвестныйТипВNotВызываетИсключение() Экспорт

	ПроверитьИсключение(15, """not"":{""type"":""decimal""}",
		"Ошибка при разборе схемы! Задано некорректное значение типа в <Сумма>;");

КонецПроцедуры

// Публичный ВалидироватьОбъекты возвращает идентификатор невалидного объекта и статус с текстом ошибки.
Процедура ВалидироватьОбъектыВозвращаетНевалидныйОбъект() Экспорт

	Спецификация = "{""openapi"": ""3.0.0"", ""info"": {""title"": ""t"", ""version"": ""1""},"
		+ """paths"": {}, ""components"": {""schemas"": {""Платеж"": {""type"": ""object"", ""properties"": {"
		+ """Идентификатор"": {""type"": ""string""}, ""Сумма"": {""type"": ""number"", ""minimum"": 0}}}}}}";

	МассивОбъектов = Новый Массив;
	МассивОбъектов.Добавить(Новый Структура("Идентификатор, Сумма", "А", 1));
	МассивОбъектов.Добавить(Новый Структура("Идентификатор, Сумма", "Б", -1));
	СтруктураОтвета = Новый Структура("Идентификатор, Статус");
	ОтветДанные = Новый Массив;

	НевалидныеИдентификаторы = пбп_ВалидаторПакетов.ВалидироватьОбъекты(
		МассивОбъектов, Спецификация, СтруктураОтвета, ОтветДанные, "Платеж");

	ЮТест.ОжидаетЧто(НевалидныеИдентификаторы).ИмеетДлину(1);
	ЮТест.ОжидаетЧто(НевалидныеИдентификаторы[0]).Равно("Б");
	ЮТест.ОжидаетЧто(ОтветДанные).ИмеетДлину(1);
	ЮТест.ОжидаетЧто(ОтветДанные[0].Идентификатор).Равно("Б");
	ЮТест.ОжидаетЧто(ОтветДанные[0].Статус)
		.Равно("Ошибка валидации <Сумма>. Значение <-1> должно быть больше или равно <0>;");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПроверитьЧисло(Значение, ОграничениеСхемы, ТипСхемы = "number")

	Спецификация = СпецификацияЧисла(ОграничениеСхемы, ТипСхемы);

	Возврат пбп_ВалидаторПакетовСлужебный.Валидировать(Значение, "Сумма", Спецификация);

КонецФункции

Функция СпецификацияЧисла(ОграничениеСхемы, ТипСхемы = "number")

	Возврат "{""openapi"": ""3.0.0"", ""info"": {""title"": ""t"", ""version"": ""1""},"
		+ """paths"": {}, ""components"": {""schemas"": {""Сумма"": {""type"": """ + ТипСхемы + """, "
		+ ОграничениеСхемы
		+ "}}}}";

КонецФункции

Процедура ПроверитьИсключение(Значение, ОграничениеСхемы, ОжидаемыйТекст)

	ПараметрыВызова = Новый Массив;
	ПараметрыВызова.Добавить(Значение);
	ПараметрыВызова.Добавить("Сумма");
	ПараметрыВызова.Добавить(СпецификацияЧисла(ОграничениеСхемы));

	ЮТест.ОжидаетЧто(пбп_ВалидаторПакетовСлужебный)
		.Метод("Валидировать", ПараметрыВызова)
		.ВыбрасываетИсключение(ОжидаемыйТекст);

КонецПроцедуры

Процедура ПроверитьУспех(Результат)

	ЮТест.ОжидаетЧто(Результат.Результат).Равно(Истина);
	ЮТест.ОжидаетЧто(Результат.Ошибки).НеЗаполнено();

КонецПроцедуры

Процедура ПроверитьТекстОшибки(Результат, ОжидаемыйТекст)

	ЮТест.ОжидаетЧто(Результат.Результат).Равно(Ложь);
	ЮТест.ОжидаетЧто(Результат.Ошибки).ИмеетДлину(1);
	ЮТест.ОжидаетЧто(Результат.Ошибки[0]).Равно("Ошибка валидации <Сумма>. " + ОжидаемыйТекст);

КонецПроцедуры

#КонецОбласти
