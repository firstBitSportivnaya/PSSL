#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты
		.ДобавитьТестовыйНабор("СоздатьЭлементФормы")
			.ДобавитьСерверныйТест("ТестПовторноеСозданиеПоляВозвращаетТотЖеЭлемент")
			.ДобавитьСерверныйТест("ТестПовторноеСозданиеОчищаетИмяИНаходитЭлемент")
			.ДобавитьСерверныйТест("ТестПовторнаяВставкаПередЭлементомВозвращаетТотЖеЭлемент");
	
КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура ТестПовторноеСозданиеПоляВозвращаетТотЖеЭлемент() Экспорт
	
	Форма = ФормаСпискаНастроек();
	ИмяПоля = "ПолеИдемпотентности432";
	
	ПервыйЭлемент = пбп_РаботаСФормами.СоздатьПоле(Форма, ИмяПоля, Форма);
	ВторойЭлемент = пбп_РаботаСФормами.СоздатьПоле(Форма, ИмяПоля, Форма);
	
	ЮТест.ОжидаетЧто(ВторойЭлемент).Равно(ПервыйЭлемент);
	ЮТест.ОжидаетЧто(Форма.Элементы.Найти(ИмяПоля)).Равно(ПервыйЭлемент);
	
КонецПроцедуры

Процедура ТестПовторноеСозданиеОчищаетИмяИНаходитЭлемент() Экспорт
	
	Форма = ФормаСпискаНастроек();
	
	ПервыйЭлемент = пбп_РаботаСФормами.СоздатьПоле(Форма, "Поле 432", Форма);
	ВторойЭлемент = пбп_РаботаСФормами.СоздатьПоле(Форма, "Поле 432", Форма);
	
	ЮТест.ОжидаетЧто(ПервыйЭлемент.Имя).Равно("Поле432");
	ЮТест.ОжидаетЧто(ВторойЭлемент).Равно(ПервыйЭлемент);
	
КонецПроцедуры

Процедура ТестПовторнаяВставкаПередЭлементомВозвращаетТотЖеЭлемент() Экспорт
	
	Форма = ФормаСпискаНастроек();
	ЭлементПеред = пбп_РаботаСФормами.СоздатьПоле(Форма, "ПолеЭталон432", Форма);
	
	ПервыйЭлемент = пбп_РаботаСФормами.СоздатьПоле(Форма, "ПолеПеред432", Форма, , , , , , ЭлементПеред);
	ВторойЭлемент = пбп_РаботаСФормами.СоздатьПоле(Форма, "ПолеПеред432", Форма, , , , , , ЭлементПеред);
	
	ЮТест.ОжидаетЧто(ВторойЭлемент).Равно(ПервыйЭлемент);
	ЮТест.ОжидаетЧто(ПервыйЭлемент.Имя).Равно("ПолеПеред432");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ФормаСпискаНастроек()
	
	// BSLLS:GetFormMethod-off
	Возврат ПолучитьФорму("Справочник.пбп_НастройкиИнтеграции.Форма.ФормаСписка");
	// BSLLS:GetFormMethod-on
	
КонецФункции

#КонецОбласти
