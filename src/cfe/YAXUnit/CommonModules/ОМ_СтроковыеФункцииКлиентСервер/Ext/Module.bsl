Процедура ТестДолженИгнорироватьСмещениеЧасовогоПояса() Экспорт

	ОжидаемаяДата = Дата(2024, 1, 2, 3, 4, 5);

	РезультатПлюс = пбп_СтроковыеФункцииКлиентСервер.ПреобразоватьДатуИзСтрокиПоФормату(
		"2024-01-02T03:04:05.123+03:00", "0_0_0");
	РезультатМинус = пбп_СтроковыеФункцииКлиентСервер.ПреобразоватьДатуИзСтрокиПоФормату(
		"2024-01-02T03:04:05-03:00", "0_0_0");

	ЮТест.ОжидаетЧто(РезультатПлюс).Равно(ОжидаемаяДата);
	ЮТест.ОжидаетЧто(РезультатМинус).Равно(ОжидаемаяДата);

КонецПроцедуры

Процедура ТестДолженОбрабатыватьПустыеЗначения() Экспорт

	ПустаяДата = Дата(1, 1, 1, 0, 0, 0);

	Результат1 = пбп_СтроковыеФункцииКлиентСервер.ПреобразоватьДатуИзСтрокиПоФормату("", "0_0_0");
	Результат2 = пбп_СтроковыеФункцииКлиентСервер.ПреобразоватьДатуИзСтрокиПоФормату("2024-01-02T03:04:05", "");

	ЮТест.ОжидаетЧто(Результат1).Равно(ПустаяДата);
	ЮТест.ОжидаетЧто(Результат2).Равно(ПустаяДата);

КонецПроцедуры

Процедура ТестДолженВозвращатьПустуюДатуПриНекорректномISO() Экспорт

	// Покрывает ветку 0_0_0 на сервере/толстом клиенте (не веб-компиляцию).
	ПустаяДата = Дата(1, 1, 1, 0, 0, 0);

	Результат1 = пбп_СтроковыеФункцииКлиентСервер.ПреобразоватьДатуИзСтрокиПоФормату("неправильная_строка", "0_0_0");
	Результат2 = пбп_СтроковыеФункцииКлиентСервер.ПреобразоватьДатуИзСтрокиПоФормату("2024-13-45T25:70:80", "0_0_0");

	ЮТест.ОжидаетЧто(Результат1).Равно(ПустаяДата);
	ЮТест.ОжидаетЧто(Результат2).Равно(ПустаяДата);

КонецПроцедуры

