#Область СлужебныйПрограммныйИнтерфейс

// Регистрирует тесты генератора кода предопределенных значений.
//
Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты
		.ДобавитьТестовыйНабор("Код элемента предопределенного значения")
			.ДобавитьТест("ТестЭлементСтрока")
			.ДобавитьТест("ТестЧислоНеотрицательное")
			.ДобавитьТест("ТестДата")
			.ДобавитьТест("ТестГруппаСРодителем")
			.ДобавитьТест("ТестКавычкаВНаименовании")
			.ДобавитьТест("ТестДругойБезИмениТипа")
			.ДобавитьТест("ТестДругойТолькоТипыПлана");
	
КонецПроцедуры

#КонецОбласти

#Область Тесты

// Фрагмент элемента со строкой длины 150 содержит конструктор таблицы и квалификатор строки.
//
Процедура ТестЭлементСтрока() Экспорт
	
	Описание = ОписаниеЭлемента();
	Описание.ДлинаСтроки = 150;
	
	Код = пбп_ПредопределенныеЗначенияКлиентСервер.КодЭлементаПредопределенногоЗначения(Описание);
	
	ЮТест.ОжидаетЧто(Код).Содержит("Таблица.Добавить()");
	ЮТест.ОжидаетЧто(Код).Содержит("пбп_РаботаСФормами.ОписаниеТипаСтрока(150)");
	ЮТест.ОжидаетЧто(Код).НеСодержит("Результат.Добавить()");
	ЮТест.ОжидаетЧто(Код).НеСодержит(".Родитель =");
	
КонецПроцедуры

// Неотрицательное число передается вторым параметром ОписаниеТипов.
//
Процедура ТестЧислоНеотрицательное() Экспорт
	
	Описание = ОписаниеЭлемента();
	Описание.ВидТипа = "Число";
	Описание.Разрядность = 10;
	Описание.РазрядностьДробнойЧасти = 2;
	Описание.Неотрицательное = Истина;
	
	Код = пбп_ПредопределенныеЗначенияКлиентСервер.КодЭлементаПредопределенногоЗначения(Описание);
	
	ЮТест.ОжидаетЧто(Код).Содержит("пбп_РаботаСФормами.ОписаниеТипаЧисло(10, 2, ДопустимыйЗнак.Неотрицательный)");
	
КонецПроцедуры

// Дата передается четвертым параметром ОписаниеТипов.
//
Процедура ТестДата() Экспорт
	
	Описание = ОписаниеЭлемента();
	Описание.ВидТипа = "Дата";
	Описание.ЧастиДаты = "Дата";
	
	Код = пбп_ПредопределенныеЗначенияКлиентСервер.КодЭлементаПредопределенногоЗначения(Описание);
	
	ЮТест.ОжидаетЧто(Код).Содержит("пбп_РаботаСФормами.ОписаниеТипаДатаВремя(""Дата"")");
	
КонецПроцедуры

// Группа с родителем не получает тип значения.
//
Процедура ТестГруппаСРодителем() Экспорт
	
	Описание = ОписаниеЭлемента();
	Описание.ЭтоГруппа = Истина;
	Описание.ИдентификаторРодитель = "РодительГруппы";
	Описание.УровеньИерархии = 1;
	Описание.ВидТипа = "Строка";
	
	Код = пбп_ПредопределенныеЗначенияКлиентСервер.КодЭлементаПредопределенногоЗначения(Описание);
	
	ЮТест.ОжидаетЧто(Код).Содержит("ЭтоГруппа = Истина");
	ЮТест.ОжидаетЧто(Код).Содержит("ИдентификаторРодитель");
	ЮТест.ОжидаетЧто(Код).Содержит("УровеньИерархии");
	ЮТест.ОжидаетЧто(Код).НеСодержит("ТипЗначения");
	
КонецПроцедуры

// Кавычка в наименовании удваивается в строковом литерале.
//
Процедура ТестКавычкаВНаименовании() Экспорт
	
	Описание = ОписаниеЭлемента();
	Описание.Наименование = "Кавычка "" внутри";
	
	Код = пбп_ПредопределенныеЗначенияКлиентСервер.КодЭлементаПредопределенногоЗначения(Описание);
	
	ЮТест.ОжидаетЧто(Код).Содержит("Наименование = ""Кавычка """" внутри""");
	
КонецПроцедуры

// Пустое имя типа «Другой» не добавляет присваивание ТипЗначения.
//
Процедура ТестДругойБезИмениТипа() Экспорт
	
	Описание = ОписаниеЭлемента();
	Описание.ВидТипа = "Другой";
	Описание.ИмяТипа = "";
	
	Код = пбп_ПредопределенныеЗначенияКлиентСервер.КодЭлементаПредопределенногоЗначения(Описание);
	
	ЮТест.ОжидаетЧто(Код).НеСодержит("ТипЗначения");
	
КонецПроцедуры

// Тип из состава плана попадает в список и в ТипЗначения. Тип вне плана не пишется.
//
Процедура ТестДругойТолькоТипыПлана() Экспорт
	
	Модуль = пбп_ПредопределенныеЗначенияКлиентСервер;
	Имена = СтрСоединить(пбп_ПредопределенныеЗначения.ИменаТиповПлана(), ",");
	ЮТест.ОжидаетЧто(Имена).Содержит("СправочникСсылка.пбп_ПользовательскиеФункции");
	ЮТест.ОжидаетЧто(Имена).Содержит("Строка");
	
	Описание = ОписаниеЭлемента();
	Описание.ВидТипа = "Другой";
	Описание.ИмяТипа = "Булево";
	Код = Модуль.КодЭлементаПредопределенногоЗначения(Описание);
	ЮТест.ОжидаетЧто(Код).Содержит("ТипЗначения = пбп_РаботаСФормами.ОписаниеТипаБулево()");
	
	Описание.ВидТипа = "СправочникСсылка.пбп_ПользовательскиеФункции";
	Код = Модуль.КодЭлементаПредопределенногоЗначения(Описание);
	ОжидаемыйВызов = "пбп_РаботаСФормами.ОписаниеТипаСправочник(""пбп_ПользовательскиеФункции"")";
	ЮТест.ОжидаетЧто(Код).Содержит("ТипЗначения = " + ОжидаемыйВызов);
	
	Описание.ВидТипа = "Другой";
	Описание.ИмяТипа = "ПеречислениеСсылка.пбп_КонтекстыВыполненияПользовательскихФункций";
	Код = Модуль.КодЭлементаПредопределенногоЗначения(Описание);
	ЮТест.ОжидаетЧто(Код).НеСодержит("ТипЗначения");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОписаниеЭлемента()
	
	Описание = Новый Структура;
	Описание.Вставить("Наименование", "Элемент");
	Описание.Вставить("ИдентификаторНастройки", "Элемент");
	Описание.Вставить("ЭтоГруппа", Ложь);
	Описание.Вставить("ИдентификаторРодитель", "");
	Описание.Вставить("УровеньИерархии", 0);
	Описание.Вставить("Пароль", Ложь);
	Описание.Вставить("СписокЗначений", Ложь);
	Описание.Вставить("Кэшируется", Ложь);
	Описание.Вставить("ВидТипа", "Строка");
	Описание.Вставить("ДопустимыеИменаТипов", пбп_ПредопределенныеЗначения.ИменаТиповПлана());
	Описание.Вставить("ДлинаСтроки", 0);
	Описание.Вставить("ДопустимаяДлина", "Переменная");
	Описание.Вставить("Разрядность", 10);
	Описание.Вставить("РазрядностьДробнойЧасти", 0);
	Описание.Вставить("Неотрицательное", Ложь);
	Описание.Вставить("ЧастиДаты", "Дата");
	Описание.Вставить("ИмяТипа", "");
	
	Возврат Описание;
	
КонецФункции

#КонецОбласти
