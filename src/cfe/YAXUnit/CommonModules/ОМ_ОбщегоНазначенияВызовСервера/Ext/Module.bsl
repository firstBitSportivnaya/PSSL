#Область Тесты

Процедура ВыполнитьСервернуюФункцию_БезПараметров_СовпадаетСПрямымВызовом() Экспорт
	
	ИмяФункции = "пбп_ОбщегоНазначенияВызовСервера.СуществуетБиблиотекаСтандартныхПодсистем";
	
	Результат = пбп_ОбщегоНазначенияВызовСервера.ВыполнитьСервернуюФункцию(ИмяФункции);
	ОжидаемыйРезультат = пбп_ОбщегоНазначенияВызовСервера.СуществуетБиблиотекаСтандартныхПодсистем();
	
	ЮТест.ОжидаетЧто(Результат).Равно(ОжидаемыйРезультат);
	
КонецПроцедуры

Процедура ВыполнитьСервернуюФункцию_ПараметрНеопределено_ВозвращаетДату() Экспорт
	
	ПараметрыФункции = Новый Массив;
	ПараметрыФункции.Добавить(Неопределено);
	
	Результат = пбп_ОбщегоНазначенияВызовСервера.ВыполнитьСервернуюФункцию(
		"пбп_ОбщегоНазначенияВызовСервера.ТекущаяДатаПользователя",
		ПараметрыФункции);
	
	ЮТест.ОжидаетЧто(ТипЗнч(Результат)).Равно(Тип("Дата"));
	
КонецПроцедуры

Процедура ВыполнитьСервернуюФункцию_НетМодуля_ВыбрасываетИсключение() Экспорт
	
	ПараметрыВызова = Мокито.МассивПараметров("НетТакогоМодуля.Метод");
	
	ЮТест.ОжидаетЧто(пбп_ОбщегоНазначенияВызовСервера)
		.Метод("ВыполнитьСервернуюФункцию", ПараметрыВызова)
		.ВыбрасываетИсключение("НетТакогоМодуля");
	
КонецПроцедуры

Процедура ПолучитьПредопределенноеЗначение_НетИдентификатора_ВозвращаетНеопределено() Экспорт
	
	РезультатБезКэша = пбп_ОбщегоНазначенияВызовСервера.ПолучитьПредопределенноеЗначение(
		"НетТакогоИдентификатора406");
	РезультатСКэшем = пбп_ОбщегоНазначенияВызовСервера.ПолучитьПредопределенноеЗначение(
		"НетТакогоИдентификатора406", Истина);
	
	ЮТест.ОжидаетЧто(РезультатБезКэша).Равно(Неопределено);
	ЮТест.ОжидаетЧто(РезультатСКэшем).Равно(Неопределено);
	
КонецПроцедуры

Процедура ПолучениеПолногоТекстаОшибкиПриИсключении_СобираетТекст() Экспорт
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = "Дополнительно";
	Сообщения = Новый Массив;
	Сообщения.Добавить(Сообщение);
	
	Результат = пбп_ОбщегоНазначенияВызовСервера.ПолучениеПолногоТекстаОшибкиПриИсключении(
		"Заголовок",
		"ТекстИсключения",
		Сообщения);
	
	ОжидаемыйТекст = "Заголовок" + Символы.ПС + "Дополнительно" + Символы.ПС + "ТекстИсключения";
	
	ЮТест.ОжидаетЧто(Результат).Равно(ОжидаемыйТекст);
	
КонецПроцедуры

Процедура ИнтегрируемаяСистема_НетИдентификатора_ПустаяСсылка() Экспорт
	
