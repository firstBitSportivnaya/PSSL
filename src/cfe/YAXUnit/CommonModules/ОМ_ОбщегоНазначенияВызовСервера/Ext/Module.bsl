Функция СоздатьПарольноеПредопределенноеЗначение(Идентификатор, Секрет)
	
	Ссылка = ЮТест.Данные().КонструкторОбъекта(ПланыВидовХарактеристик.пбп_ПредопределенныеЗначения)
		.Установить("Наименование", Идентификатор)
		.Установить("ИдентификаторНастройки", Идентификатор)
		.Установить("ТипЗначения", Новый ОписаниеТипов("Строка"))
		.Установить("Пароль", Истина)
		.Установить("Значение", "")
		.Записать(Ложь, Истина);
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		
		пбп_Переадресация.ЗаписатьДанныеВБезопасноеХранилище(
			Строка(Ссылка.УникальныйИдентификатор()), Новый Структура("bit_password", Секрет));
		
	Исключение
		
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
		
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
	// BSLLS:SetPrivilegedMode-on
	
	Возврат Ссылка;
	
КонецФункции

Функция СоздатьЭлементПоИдентификатору(Менеджер, Идентификатор, Наименование)
	
	Возврат ЮТест.Данные().КонструкторОбъекта(Менеджер)
		.Установить("Наименование", Наименование)
		.Установить("ИдентификаторНастройки", Идентификатор)
		.Записать(Ложь, Истина);
	
КонецФункции

Процедура ПроверитьОтказПолученияПароля(Идентификатор, Секрет, ИспользоватьКэш)
	
	ТекстИсключения = "";
	ОжидаемыйТекст = "Получение пароля предопределённого значения с клиента запрещено";
	
	Попытка
		пбп_ОбщегоНазначенияВызовСервера.ПолучитьПредопределенноеЗначение(Идентификатор, ИспользоватьКэш);
	Исключение
		ТекстИсключения = ОписаниеОшибки();
		ЮТест.ОжидаетЧто(ТекстИсключения).Содержит(ОжидаемыйТекст);
		ЮТест.ОжидаетЧто(ТекстИсключения).НеСодержит(Секрет);
		
		Если СтрНайти(ТекстИсключения, ОжидаемыйТекст) = 0
			Или СтрНайти(ТекстИсключения, Секрет) > 0 Тогда
			
			ВызватьИсключение;
			
		КонецЕсли;
		
	КонецПопытки;
	
	ЮТест.ОжидаетЧто(ТекстИсключения).Содержит(ОжидаемыйТекст);
	
КонецПроцедуры

Процедура ПроверитьОтказСерверногоПолученияПароля(Идентификатор, Секрет)
	
	ОжидаемыйТекст = "Получение пароля предопределённого значения с клиента запрещено";
	ТекстИсключения = "";
	
	Попытка
		пбп_ОбщегоНазначенияСервер.ПолучитьПредопределенноеЗначение(Идентификатор);
	Исключение
		ТекстИсключения = ОписаниеОшибки();
		ЮТест.ОжидаетЧто(ТекстИсключения).Содержит(ОжидаемыйТекст);
		ЮТест.ОжидаетЧто(ТекстИсключения).НеСодержит(Секрет);
		Если СтрНайти(ТекстИсключения, ОжидаемыйТекст) = 0
			Или СтрНайти(ТекстИсключения, Секрет) > 0 Тогда
			
			ВызватьИсключение;
			
		КонецЕсли;
	КонецПопытки;
	
	ЮТест.ОжидаетЧто(ТекстИсключения).Содержит(ОжидаемыйТекст);
	
	ПараметрыФункции = Новый Массив;
	ПараметрыФункции.Добавить(Идентификатор);
	ТекстИсключения = "";
	
	Попытка
		пбп_ОбщегоНазначенияВызовСервера.ВыполнитьСервернуюФункцию(
			"пбп_ОбщегоНазначенияСервер.ПолучитьПредопределенноеЗначение", ПараметрыФункции);
	Исключение
		ТекстИсключения = ОписаниеОшибки();
		ЮТест.ОжидаетЧто(ТекстИсключения).Содержит(ОжидаемыйТекст);
		ЮТест.ОжидаетЧто(ТекстИсключения).НеСодержит(Секрет);
		Если СтрНайти(ТекстИсключения, ОжидаемыйТекст) = 0
			Или СтрНайти(ТекстИсключения, Секрет) > 0 Тогда
			
			ВызватьИсключение;
			
		КонецЕсли;
	КонецПопытки;
	
	ЮТест.ОжидаетЧто(ТекстИсключения).Содержит(ОжидаемыйТекст);
	
КонецПроцедуры

Процедура ПроверитьСовпадениеОбёртки(РезультатОбёртки, РезультатСервера, ПустаяСсылка)
	
	ЮТест.ОжидаетЧто(РезультатОбёртки).Равно(РезультатСервера);
	ЮТест.ОжидаетЧто(РезультатОбёртки).НеРавно(ПустаяСсылка);
	
КонецПроцедуры

Процедура ОчиститьПарольПредопределенногоЗначения(Ссылка)
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		
		пбп_Переадресация.ЗаписатьДанныеВБезопасноеХранилище(
			Строка(Ссылка.УникальныйИдентификатор()), Неопределено);
		
	Исключение
		
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
		
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
	// BSLLS:SetPrivilegedMode-on
	
	УдалитьТестовыйОбъект(Ссылка);
	
КонецПроцедуры

Процедура УдалитьТестовыйОбъект(Ссылка)
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Объект = Ссылка.ПолучитьОбъект();
	
	Если Объект = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Объект.Удалить();
	
КонецПроцедуры

#КонецОбласти
