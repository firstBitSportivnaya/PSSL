#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("ЗаполнитьОтборыРегистраВОбъектыИнтеграции")
			.ДобавитьТест("ТестДолженЗаполнитьКлючНепериодическогоРегистраСведенийБезПериода")
			.ДобавитьТест("ТестДолженЗаполнитьКлючНабораРегистраТолькоИзмерениями")
			.ДобавитьТест("ТестДолженЗаполнитьКлючНабораПериодическогоРегистраСПериодом");

	ЮТТесты
		.ДобавитьТестовыйНабор("URL исходящего запроса")
			.ДобавитьТест("ТестДолженСобратьURLИсходящегоЗапроса");

	ЮТТесты
		.ДобавитьТестовыйНабор("Параметры сообщения истории интеграции")
			.ДобавитьТест("ТестДолженЗаписатьДвеСтрокиПараметровСообщенияВИсторию").ВТранзакции()
			.ДобавитьТест("ТестДолженЗаписатьИсториюСПустойТаблицейПараметровСообщения").ВТранзакции()
			.ДобавитьТест("ТестДолженЗаписатьИсториюБезКлючаПараметрыСообщения").ВТранзакции();

КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура ТестДолженЗаполнитьКлючНепериодическогоРегистраСведенийБезПериода() Экспорт

	МенеджерЗаписи = РегистрыСведений.пбп_СостоянияПредопределенныхЭлементов.СоздатьМенеджерЗаписи();
	ОбъектыИнтеграции = пбп_ИнтеграцииСлужебный.ИнициализироватьТаблицуОбъектовИнтеграции();

	пбп_ИнтеграцииСлужебный.ЗаполнитьОтборыРегистраВОбъектыИнтеграции(
		МенеджерЗаписи, Перечисления.пбп_СозданОбновлен.Создан, ОбъектыИнтеграции);

	ОтборКлюча = ОтборКлючаИзРезультатаЗаполнения(ОбъектыИнтеграции);
	ЮТест.ОжидаетЧто(ОтборКлюча)
		.ИмеетСвойство("Объект")
		.НеИмеетСвойства("Период")
		.НеИмеетСвойства("Регистратор")
		.НеИмеетСвойства("ХешСумма");

КонецПроцедуры

Процедура ТестДолженЗаполнитьКлючНабораРегистраТолькоИзмерениями() Экспорт

	НаборЗаписей = РегистрыСведений.пбп_СостоянияПредопределенныхЭлементов.СоздатьНаборЗаписей();
	ЭлементАктивность = НаборЗаписей.Отбор.Найти("Активность");
	Если ЭлементАктивность <> Неопределено Тогда
		
		ЭлементАктивность.Значение = Истина;
		
	КонецЕсли;

	ОбъектыИнтеграции = пбп_ИнтеграцииСлужебный.ИнициализироватьТаблицуОбъектовИнтеграции();
	пбп_ИнтеграцииСлужебный.ЗаполнитьОтборыРегистраВОбъектыИнтеграции(
		НаборЗаписей, Перечисления.пбп_СозданОбновлен.Обновлен, ОбъектыИнтеграции);

	ОтборКлюча = ОтборКлючаИзРезультатаЗаполнения(ОбъектыИнтеграции);
	ЮТест.ОжидаетЧто(ОтборКлюча)
		.ИмеетСвойство("Объект")
		.НеИмеетСвойства("Активность")
		.НеИмеетСвойства("НомерСтроки")
		.НеИмеетСвойства("ХешСумма");

КонецПроцедуры

Процедура ТестДолженЗаполнитьКлючНабораПериодическогоРегистраСПериодом() Экспорт

	Период = ТекущаяДатаСеанса();
	ИмяФайла = "тест_период.txt";

	НаборЗаписей = РегистрыСведений.пбп_ИсторияЗагрузкиФайлов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Период.Установить(Период);
	НаборЗаписей.Отбор.ИмяФайла.Установить(ИмяФайла);

	ЭлементАктивность = НаборЗаписей.Отбор.Найти("Активность");
	Если ЭлементАктивность <> Неопределено Тогда
		
		ЭлементАктивность.Значение = Истина;
		
	КонецЕсли;

	ОбъектыИнтеграции = пбп_ИнтеграцииСлужебный.ИнициализироватьТаблицуОбъектовИнтеграции();
	пбп_ИнтеграцииСлужебный.ЗаполнитьОтборыРегистраВОбъектыИнтеграции(
		НаборЗаписей, Перечисления.пбп_СозданОбновлен.Создан, ОбъектыИнтеграции);

	ОтборКлюча = ОтборКлючаИзРезультатаЗаполнения(
		ОбъектыИнтеграции, "РегистрСведений.пбп_ИсторияЗагрузкиФайлов");
	ЮТест.ОжидаетЧто(ОтборКлюча)
		.ИмеетСвойство("Период")
		.ИмеетСвойство("ИнтеграционныйПоток")
		.ИмеетСвойство("ИмяФайла")
		.НеИмеетСвойства("Активность")
		.НеИмеетСвойства("Обработан")
		.НеИмеетСвойства("Регистратор");
	ЮТест.ОжидаетЧто(ОтборКлюча.Период).Равно(Период);
	ЮТест.ОжидаетЧто(ОтборКлюча.ИмяФайла).Равно(ИмяФайла);

КонецПроцедуры

// Проверяет сборку URL исходящего запроса: порт, порт по умолчанию, слэш сервера и базовый путь.
Процедура ТестДолженСобратьURLИсходящегоЗапроса() Экспорт

	Настройки = Новый Структура("СтрокаПодключения, Порт, ТочкаВхода");
	ПортЯвный = 443;
	ПортПоУмолчанию = 0;
	ПортСервиса = 8080;

	Настройки.СтрокаПодключения = "https://host";
	Настройки.Порт = ПортЯвный;
	Настройки.ТочкаВхода = "/api";
	ЮТест.ОжидаетЧто(пбп_ИнтеграцииСлужебный.URLИсходящегоЗапроса(Настройки))
		.Равно("https://host:443/api");

	Настройки.Порт = ПортПоУмолчанию;
	ЮТест.ОжидаетЧто(пбп_ИнтеграцииСлужебный.URLИсходящегоЗапроса(Настройки))
		.Равно("https://host/api");

	Настройки.СтрокаПодключения = "https://host/";
	Настройки.Порт = ПортСервиса;
	Настройки.ТочкаВхода = "api/v1";
	ЮТест.ОжидаетЧто(пбп_ИнтеграцииСлужебный.URLИсходящегоЗапроса(Настройки))
		.Равно("https://host:8080/api/v1");

	Настройки.СтрокаПодключения = "https://host/erp";
	Настройки.Порт = ПортСервиса;
	Настройки.ТочкаВхода = "/api";
	ЮТест.ОжидаетЧто(пбп_ИнтеграцииСлужебный.URLИсходящегоЗапроса(Настройки))
		.Равно("https://host:8080/erp/api");

КонецПроцедуры

Процедура ТестДолженЗаписатьДвеСтрокиПараметровСообщенияВИсторию() Экспорт

	Поток = ИнтеграционныйПотокДляТестаИстории();
	СтруктураИстории = СтруктураЗаписиИсторииДляТеста(Поток);

	СтрокаВходящая = СтруктураИстории.ПараметрыСообщения.Добавить();
	СтрокаВходящая.Имя = "paramIn";
	СтрокаВходящая.Значение = "valueIn";
	СтрокаВходящая.Исходящий = Ложь;

	СтрокаИсходящая = СтруктураИстории.ПараметрыСообщения.Добавить();
	СтрокаИсходящая.Имя = "paramOut";
	СтрокаИсходящая.Значение = "valueOut";
	СтрокаИсходящая.Исходящий = Истина;

	СсылкаИстории = пбп_ИнтеграцииСлужебный.СоздатьСообщениеИсторииИнтеграции(СтруктураИстории);
	ОбъектИстории = СсылкаИстории.ПолучитьОбъект();

	ЮТест.ОжидаетЧто(ОбъектИстории.ПараметрыСообщения.Количество()).Равно(2);
	ЮТест.ОжидаетЧто(ОбъектИстории.ПараметрыСообщения[0].Имя).Равно("paramIn");
	ЮТест.ОжидаетЧто(ОбъектИстории.ПараметрыСообщения[0].Значение).Равно("valueIn");
	ЮТест.ОжидаетЧто(ОбъектИстории.ПараметрыСообщения[0].Исходящий).Равно(Ложь);
	ЮТест.ОжидаетЧто(ОбъектИстории.ПараметрыСообщения[1].Имя).Равно("paramOut");
	ЮТест.ОжидаетЧто(ОбъектИстории.ПараметрыСообщения[1].Значение).Равно("valueOut");
	ЮТест.ОжидаетЧто(ОбъектИстории.ПараметрыСообщения[1].Исходящий).Равно(Истина);

КонецПроцедуры

Процедура ТестДолженЗаписатьИсториюСПустойТаблицейПараметровСообщения() Экспорт

	Поток = ИнтеграционныйПотокДляТестаИстории();
	СтруктураИстории = СтруктураЗаписиИсторииДляТеста(Поток);

	ЮТест.ОжидаетЧто(СтруктураИстории.ПараметрыСообщения.Количество()).Равно(0);

	СсылкаИстории = пбп_ИнтеграцииСлужебный.СоздатьСообщениеИсторииИнтеграции(СтруктураИстории);
	ОбъектИстории = СсылкаИстории.ПолучитьОбъект();

	ЮТест.ОжидаетЧто(ОбъектИстории.ПараметрыСообщения.Количество()).Равно(0);

КонецПроцедуры

Процедура ТестДолженЗаписатьИсториюБезКлючаПараметрыСообщения() Экспорт

	Поток = ИнтеграционныйПотокДляТестаИстории();
	СтруктураИстории = СтруктураЗаписиИсторииДляТеста(Поток);
	СтруктураИстории.Удалить("ПараметрыСообщения");

	СсылкаИстории = пбп_ИнтеграцииСлужебный.СоздатьСообщениеИсторииИнтеграции(СтруктураИстории);
	ОбъектИстории = СсылкаИстории.ПолучитьОбъект();

	ЮТест.ОжидаетЧто(СсылкаИстории).Заполнено();
	ЮТест.ОжидаетЧто(ОбъектИстории.ПараметрыСообщения.Количество()).Равно(0);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИнтеграционныйПотокДляТестаИстории()

	ИдентификаторПотока = "YAX_HIST_" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");

	Возврат ЮТест.Данные().КонструкторОбъекта(Справочники.пбп_ИнтеграционныеПотоки)
		.Установить("Наименование", "Поток истории YAX")
		.Установить("НаправлениеПотока", Перечисления.пбп_НаправленияИнтеграционныхПотоков.Входящий)
		.Установить("ИдентификаторНастройки", ИдентификаторПотока)
		.Записать(Ложь, Истина);

КонецФункции

Функция СтруктураЗаписиИсторииДляТеста(Поток)

	СтруктураИстории = пбп_ИнтеграцииСлужебный.ПолучитьСтруктуруЗаписиИстории();
	СтруктураИстории.ИнтеграционныйПоток = Поток;
	СтруктураИстории.ОбрабатыватьСообщение = Ложь;
	СтруктураИстории.ГенерироватьПротокол = Ложь;

	Возврат СтруктураИстории;

КонецФункции

Функция ОтборКлючаИзРезультатаЗаполнения(ОбъектыИнтеграции, ПолноеИмяРегистра = "")

	ОжидаемоеИмяРегистра = ПолноеИмяРегистра;
	Если ПустаяСтрока(ОжидаемоеИмяРегистра) Тогда
		
		ОжидаемоеИмяРегистра = "РегистрСведений.пбп_СостоянияПредопределенныхЭлементов";
		
	КонецЕсли;

	ЮТест.ОжидаетЧто(ОбъектыИнтеграции.Количество()).Равно(1);
	СтрокаОбъекта = ОбъектыИнтеграции[0];
	ЮТест.ОжидаетЧто(СтрокаОбъекта.ЭтоЗаписьРегистра).ЭтоИстина();

	ДанныеОтбора = СтрокаОбъекта.ОтборыРегистра.Получить();
	ЮТест.ОжидаетЧто(ТипЗнч(ДанныеОтбора)).Равно(Тип("Структура"));
	ЮТест.ОжидаетЧто(ДанныеОтбора.ИмяРегистра)
		.Равно(ОжидаемоеИмяРегистра);

	Возврат ДанныеОтбора.Отбор;

КонецФункции

#КонецОбласти
