Процедура ТестДолженВернутьИнтернетПроксиПриВключенномФлаге() Экспорт
	
	ПредыдущиеНастройки = пбп_Переадресация.ХранилищеОбщихНастроекЗагрузить("НастройкаПроксиСервера", "");
	
	НастройкиПрокси = Новый Соответствие;
	НастройкиПрокси.Вставить("ИспользоватьПрокси", Истина);
	НастройкиПрокси.Вставить("ИспользоватьСистемныеНастройки", Истина);
	пбп_Переадресация.ХранилищеОбщихНастроекСохранить("НастройкаПроксиСервера", "", НастройкиПрокси);
	
	Попытка
		
		НастройкаИнтеграции = СоздатьНастройкуИнтеграцииДляПрокси(Истина);
		ИнтеграционныйПоток = СоздатьПотокСПараметромВхода(
			"proxy_on", Перечисления.пбп_ТипыJSON.Строка, Истина, "1", "", НастройкаИнтеграции);
		
		Результат = пбп_ИнтеграцииСлужебный.ПараметрыHTTPЗапроса(ИнтеграционныйПоток);
		
		ЮТест.ОжидаетЧто(ТипЗнч(Результат.Прокси)).Равно(Тип("ИнтернетПрокси"));
		
	Исключение
		
		ВосстановитьНастройкиПроксиСервера(ПредыдущиеНастройки);
		ВызватьИсключение;
		
	КонецПопытки;
	
	ВосстановитьНастройкиПроксиСервера(ПредыдущиеНастройки);
	
КонецПроцедуры

