Процедура ТестПустаяТабличнаяЧастьДолжнаДатьПустойРезультат() Экспорт

	ИнтеграционныйПоток = ЮТест.Данные().КонструкторОбъекта(Справочники.пбп_ИнтеграционныеПотоки)
		.Установить("Наименование", "ЮТ_HTTP_ПустойПоток")
		.Записать(Ложь, Истина);

	Результат = пбп_ИнтеграцииСлужебный.ПараметрыHTTPЗапроса(ИнтеграционныйПоток);

	ЮТест.ОжидаетЧто(Результат.СтрокаПараметровURL).Равно("");
	ЮТест.ОжидаетЧто(ТипЗнч(Результат.Заголовки)).Равно(Тип("Соответствие"));
	ЮТест.ОжидаетЧто(Результат.Заголовки.Количество()).Равно(0);

КонецПроцедуры

Процедура ТестДолженСохранитьПорядокURLПараметровПоНомеруСтроки() Экспорт

	Конструктор = ЮТест.Данные().КонструкторОбъекта(Справочники.пбп_ИнтеграционныеПотоки)
		.Установить("Наименование", "ЮТ_HTTP_Порядок");
	Конструктор.ТабличнаяЧасть("ПараметрыВхода")
		.ДобавитьСтроку()
			.Установить("Имя", "b")
			.Установить("Тип", Перечисления.пбп_ТипыJSON.Число)
			.Установить("ПараметрURL", Истина)
			.Установить("ЗначениеПоУмолчанию", 2)
		.ДобавитьСтроку()
			.Установить("Имя", "a")
			.Установить("Тип", Перечисления.пбп_ТипыJSON.Число)
			.Установить("ПараметрURL", Истина)
			.Установить("ЗначениеПоУмолчанию", 1);
	ИнтеграционныйПоток = Конструктор.Записать(Ложь, Истина);

	Результат = пбп_ИнтеграцииСлужебный.ПараметрыHTTPЗапроса(ИнтеграционныйПоток);

	ЮТест.ОжидаетЧто(Результат.СтрокаПараметровURL).Равно("?b=2&a=1");

КонецПроцедуры

Процедура ТестДолженЗакодироватьЗначениеПараметраURL() Экспорт

	ИнтеграционныйПоток = СоздатьПотокСПараметромВхода(
