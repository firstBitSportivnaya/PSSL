Функция СтруктураЗаписиИсторииДляТеста(Поток)

	СтруктураИстории = пбп_ИнтеграцииСлужебный.ПолучитьСтруктуруЗаписиИстории();
	СтруктураИстории.ИнтеграционныйПоток = Поток;
	СтруктураИстории.ОбрабатыватьСообщение = Ложь;
	СтруктураИстории.ГенерироватьПротокол = Ложь;

	Возврат СтруктураИстории;

КонецФункции

Функция ОтборКлючаИзРезультатаЗаполнения(ОбъектыИнтеграции, ПолноеИмяРегистра = "")

	ОжидаемоеИмяРегистра = ПолноеИмяРегистра;
	Если ПустаяСтрока(ОжидаемоеИмяРегистра) Тогда
		
		ОжидаемоеИмяРегистра = "РегистрСведений.пбп_СостоянияПредопределенныхЭлементов";
		
	КонецЕсли;

	ЮТест.ОжидаетЧто(ОбъектыИнтеграции.Количество()).Равно(1);
	СтрокаОбъекта = ОбъектыИнтеграции[0];
	ЮТест.ОжидаетЧто(СтрокаОбъекта.ЭтоЗаписьРегистра).ЭтоИстина();

	ДанныеОтбора = СтрокаОбъекта.ОтборыРегистра.Получить();
	ЮТест.ОжидаетЧто(ТипЗнч(ДанныеОтбора)).Равно(Тип("Структура"));
	ЮТест.ОжидаетЧто(ДанныеОтбора.ИмяРегистра)
		.Равно(ОжидаемоеИмяРегистра);

	Возврат ДанныеОтбора.Отбор;

КонецФункции

Функция СоздатьПотокСПараметромВхода(Имя, Тип, ПараметрURL, ЗначениеПоУмолчанию, ПолеОбъекта,
	НастройкаИнтеграции = Неопределено)

	Конструктор = ЮТест.Данные().КонструкторОбъекта(Справочники.пбп_ИнтеграционныеПотоки)
		.Установить("Наименование", "ЮТ_HTTP_" + Имя);
	
	Если НастройкаИнтеграции <> Неопределено Тогда
		
		Конструктор.Установить("НастройкаИнтеграции", НастройкаИнтеграции);
		
	КонецЕсли;
	
	Конструктор.ТабличнаяЧасть("ПараметрыВхода")
		.ДобавитьСтроку()
			.Установить("Имя", Имя)
			.Установить("Тип", Тип)
			.Установить("ПараметрURL", ПараметрURL)
			.Установить("ЗначениеПоУмолчанию", ЗначениеПоУмолчанию)
			.Установить("ПолеОбъекта", ПолеОбъекта);

	Возврат Конструктор.Записать(Ложь, Истина);

КонецФункции

Функция СоздатьНастройкуИнтеграцииДляПрокси(ИспользоватьВстроенноеПрокси)
	
	Возврат ЮТест.Данные().КонструкторОбъекта("Справочник.пбп_НастройкиИнтеграции")
		.Установить("Наименование", "ЮТ_HTTP_Прокси_" + Строка(Новый УникальныйИдентификатор))
		.Установить("ИнтегрируемаяСистема", ЮТест.Данные().КонструкторОбъекта("Справочник.пбп_ИнтегрируемыеСистемы")
			.Установить("Наименование", "ЮТ_HTTP_Система")
			.Записать())
		.Установить("ТипИнтеграции", Справочники.пбп_ТипыИнтеграций.RESTAPI)
		.Установить("СтрокаПодключения", "https://example.com")
		.Установить("ИспользоватьВстроенноеПрокси", ИспользоватьВстроенноеПрокси)
		.Записать(Ложь, Истина);
	
КонецФункции

Процедура ВосстановитьНастройкиПроксиСервера(ПредыдущиеНастройки)
	
	Если ПредыдущиеНастройки = Неопределено Тогда
		
		пбп_Переадресация.ХранилищеОбщихНастроекУдалить("НастройкаПроксиСервера", "", Неопределено);
		
	Иначе
		
		пбп_Переадресация.ХранилищеОбщихНастроекСохранить("НастройкаПроксиСервера", "", ПредыдущиеНастройки);
		
	КонецЕсли;
	
КонецПроцедуры

