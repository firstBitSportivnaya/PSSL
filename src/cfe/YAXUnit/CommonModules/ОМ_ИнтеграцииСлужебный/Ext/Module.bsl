#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("ЗаполнитьОтборыРегистраВОбъектыИнтеграции")
			.ДобавитьТест("ТестДолженЗаполнитьКлючНепериодическогоРегистраСведенийБезПериода")
			.ДобавитьТест("ТестДолженЗаполнитьКлючНабораРегистраТолькоИзмерениями")
			.ДобавитьТест("ТестДолженЗаполнитьКлючНабораПериодическогоРегистраСПериодом");

КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура ТестДолженЗаполнитьКлючНепериодическогоРегистраСведенийБезПериода() Экспорт

	МенеджерЗаписи = РегистрыСведений.пбп_СостоянияПредопределенныхЭлементов.СоздатьМенеджерЗаписи();
	ОбъектыИнтеграции = пбп_ИнтеграцииСлужебный.ИнициализироватьТаблицуОбъектовИнтеграции();

	пбп_ИнтеграцииСлужебный.ЗаполнитьОтборыРегистраВОбъектыИнтеграции(
		МенеджерЗаписи, Перечисления.пбп_СозданОбновлен.Создан, ОбъектыИнтеграции);

	ОтборКлюча = ОтборКлючаИзРезультатаЗаполнения(ОбъектыИнтеграции);
	ЮТест.ОжидаетЧто(ОтборКлюча)
		.ИмеетСвойство("Объект")
		.НеИмеетСвойства("Период")
		.НеИмеетСвойства("Регистратор")
		.НеИмеетСвойства("ХешСумма");

КонецПроцедуры

Процедура ТестДолженЗаполнитьКлючНабораРегистраТолькоИзмерениями() Экспорт

	НаборЗаписей = РегистрыСведений.пбп_СостоянияПредопределенныхЭлементов.СоздатьНаборЗаписей();
	ЭлементАктивность = НаборЗаписей.Отбор.Найти("Активность");
	Если ЭлементАктивность <> Неопределено Тогда
		
		ЭлементАктивность.Значение = Истина;
		
	КонецЕсли;

	ОбъектыИнтеграции = пбп_ИнтеграцииСлужебный.ИнициализироватьТаблицуОбъектовИнтеграции();
	пбп_ИнтеграцииСлужебный.ЗаполнитьОтборыРегистраВОбъектыИнтеграции(
		НаборЗаписей, Перечисления.пбп_СозданОбновлен.Обновлен, ОбъектыИнтеграции);

	ОтборКлюча = ОтборКлючаИзРезультатаЗаполнения(ОбъектыИнтеграции);
	ЮТест.ОжидаетЧто(ОтборКлюча)
		.ИмеетСвойство("Объект")
		.НеИмеетСвойства("Активность")
		.НеИмеетСвойства("НомерСтроки")
		.НеИмеетСвойства("ХешСумма");

КонецПроцедуры

Процедура ТестДолженЗаполнитьКлючНабораПериодическогоРегистраСПериодом() Экспорт

	Период = ТекущаяДатаСеанса();
	ИмяФайла = "тест_период.txt";

	НаборЗаписей = РегистрыСведений.пбп_ИсторияЗагрузкиФайлов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Период.Установить(Период);
	НаборЗаписей.Отбор.ИмяФайла.Установить(ИмяФайла);

	ЭлементАктивность = НаборЗаписей.Отбор.Найти("Активность");
	Если ЭлементАктивность <> Неопределено Тогда
		
		ЭлементАктивность.Значение = Истина;
		
	КонецЕсли;

	ОбъектыИнтеграции = пбп_ИнтеграцииСлужебный.ИнициализироватьТаблицуОбъектовИнтеграции();
	пбп_ИнтеграцииСлужебный.ЗаполнитьОтборыРегистраВОбъектыИнтеграции(
		НаборЗаписей, Перечисления.пбп_СозданОбновлен.Создан, ОбъектыИнтеграции);

	ОтборКлюча = ОтборКлючаИзРезультатаЗаполнения(
		ОбъектыИнтеграции, "РегистрСведений.пбп_ИсторияЗагрузкиФайлов");
	ЮТест.ОжидаетЧто(ОтборКлюча)
		.ИмеетСвойство("Период")
		.ИмеетСвойство("ИнтеграционныйПоток")
		.ИмеетСвойство("ИмяФайла")
		.НеИмеетСвойства("Активность")
		.НеИмеетСвойства("Обработан")
		.НеИмеетСвойства("Регистратор");
	ЮТест.ОжидаетЧто(ОтборКлюча.Период).Равно(Период);
	ЮТест.ОжидаетЧто(ОтборКлюча.ИмяФайла).Равно(ИмяФайла);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОтборКлючаИзРезультатаЗаполнения(ОбъектыИнтеграции, ПолноеИмяРегистра = "")

	ОжидаемоеИмяРегистра = ПолноеИмяРегистра;
	Если ПустаяСтрока(ОжидаемоеИмяРегистра) Тогда
		
		ОжидаемоеИмяРегистра = "РегистрСведений.пбп_СостоянияПредопределенныхЭлементов";
		
	КонецЕсли;

	ЮТест.ОжидаетЧто(ОбъектыИнтеграции.Количество()).Равно(1);
	СтрокаОбъекта = ОбъектыИнтеграции[0];
	ЮТест.ОжидаетЧто(СтрокаОбъекта.ЭтоЗаписьРегистра).ЭтоИстина();

	ДанныеОтбора = СтрокаОбъекта.ОтборыРегистра.Получить();
	ЮТест.ОжидаетЧто(ТипЗнч(ДанныеОтбора)).Равно(Тип("Структура"));
	ЮТест.ОжидаетЧто(ДанныеОтбора.ИмяРегистра)
		.Равно(ОжидаемоеИмяРегистра);

	Возврат ДанныеОтбора.Отбор;

КонецФункции

#КонецОбласти
