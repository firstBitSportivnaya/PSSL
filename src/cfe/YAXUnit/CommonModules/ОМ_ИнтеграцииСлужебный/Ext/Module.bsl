	ЮТест.ОжидаетЧто(Результат.СтрокаПараметровURL).Равно("?q=a%20b%26c");

КонецПроцедуры

Процедура ТестДолженРазделитьПараметрыURLИЗаголовкиЗапроса() Экспорт

	Конструктор = ЮТест.Данные().КонструкторОбъекта(Справочники.пбп_ИнтеграционныеПотоки)
		.Установить("Наименование", "ЮТ_HTTP_URL_Заголовки");
	Конструктор.ТабличнаяЧасть("ПараметрыВхода")
		.ДобавитьСтроку()
			.Установить("Имя", "code")
			.Установить("Тип", Перечисления.пбп_ТипыJSON.Строка)
			.Установить("ПараметрURL", Истина)
			.Установить("ПолеОбъекта", "Код")
		.ДобавитьСтроку()
			.Установить("Имя", "X-Api-Key")
			.Установить("Тип", Перечисления.пбп_ТипыJSON.Строка)
			.Установить("ПараметрURL", Ложь)
			.Установить("ЗначениеПоУмолчанию", "abc")
			.Установить("ПолеОбъекта", "");
	ИнтеграционныйПоток = Конструктор.Записать(Ложь, Истина);
	ВыгружаемыйОбъект = Новый Структура("Код", "000000001");

	ЮТест.ОжидаетЧто(
		пбп_ИнтеграцииСлужебный.ПараметрыURLЗапроса(ИнтеграционныйПоток, ВыгружаемыйОбъект))
		.Равно("?code=000000001");

	Заголовки = пбп_ИнтеграцииСлужебный.ЗаголовкиЗапроса(ИнтеграционныйПоток, ВыгружаемыйОбъект);
	ЮТест.ОжидаетЧто(Заголовки.Получить("X-Api-Key")).Равно("abc");
