#Область Тесты

Процедура ТестДолженВывестиПоляПоискаСсылкиРодителяИНастройки() Экспорт

	ПоляПоиска = ПоляПоискаПотока();

	ПроверитьПоля(ПоляПоиска, "Ссылка", "ВнешнийИдентификатор", "ИдентификаторНастройки");
	ПроверитьПоля(ПоляПоиска, "Родитель", "ИдентификаторНастройки");
	ПроверитьПоля(ПоляПоиска, "НастройкаИнтеграции", "ВнешнийИдентификатор");
	ПроверитьГруппуПользовательскойФункции(ПоляПоиска);
	ЮТест.ОжидаетЧто(ПоляПоиска["Наименование"]).НеЗаполнено();

КонецПроцедуры

Процедура ТестДолженСохранитьПорядокЯвныхПолейБезДублей() Экспорт

	ПоляПоиска = Новый Соответствие;
	ЯвныеПоля = Новый Массив;
	ЯвныеПоля.Добавить("ВнешнийИдентификатор");
	ЯвныеПоля.Добавить("ИдентификаторНастройки");
	ПоляПоиска.Вставить("Ссылка", ЯвныеПоля);

	пбп_ИнтеграцииШина.ДополнитьПоляПоискаИзСоответствияПолей(
		ПоляПоиска, СоответствиеПолейПотока());

	ПроверитьПоля(ПоляПоиска, "Ссылка", "ВнешнийИдентификатор", "ИдентификаторНастройки");

КонецПроцедуры

Процедура ТестДолженНайтиРодителяИТуЖеСсылкуПриПовторнойЗагрузке() Экспорт

	ИдентификаторРодителя = "YAX_PAR_" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
	ИдентификаторЭлемента = "YAX_ITEM_" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
	ВнешняяСсылка = Строка(Новый УникальныйИдентификатор);

	Система = ЮТест.Данные().КонструкторОбъекта(Справочники.пбп_ИнтегрируемыеСистемы)
		.Установить("Наименование", "Система полей поиска")
		.Записать(Ложь, Истина);

	РодительОбъект = Справочники.пбп_ИнтеграционныеПотоки.СоздатьГруппу();
	РодительОбъект.Наименование = "Родитель потока";
	РодительОбъект.ИдентификаторНастройки = ИдентификаторРодителя;
	РодительОбъект.Записать();

	Данные = Новый Структура;
	Данные.Вставить("ref", ВнешняяСсылка);
	Данные.Вставить("name", "Поток поиска родителя");
	Данные.Вставить("isGroup", Ложь);
	Данные.Вставить("parent", ИдентификаторРодителя);
	Данные.Вставить("identifier", ИдентификаторЭлемента);
	Данные.Вставить("threadDirection", "Исходящий");

	Ссылка = ЗагрузитьПоток(Данные, Система);
	ПовторнаяСсылка = ЗагрузитьПоток(Данные, Система);
	Объект = Ссылка.ПолучитьОбъект();

	ЮТест.ОжидаетЧто(Ссылка).Заполнено();
	ЮТест.ОжидаетЧто(ПовторнаяСсылка).Равно(Ссылка);
	ЮТест.ОжидаетЧто(Объект.Родитель).Равно(РодительОбъект.Ссылка);
	ЮТест.ОжидаетЧто(Объект.ИдентификаторНастройки).Равно(ИдентификаторЭлемента);

КонецПроцедуры

Процедура ТестДолженСохранитьГруппуПолейПоискаБезДублей() Экспорт

	ПоляПоиска = Новый Соответствие;
	ЯвныеПоля = Новый Массив;
	ЯвныеПоля.Добавить(пбп_ИнтеграцииШина.ГруппаПолейПоиска("Дата, Комментарий"));
	ЯвныеПоля.Добавить("Код");
	ПоляПоиска.Вставить("Ссылка", ЯвныеПоля);

	СоответствиеПолей = пбп_ИнтеграцииШина.КонструкторСоответствияПолейИсточникаИПриемника();
	пбп_ИнтеграцииШина.ДополнитьСоответствиеПолейИсточникаИПриемника(
		СоответствиеПолей, "date", "Ссылка.Дата");
	пбп_ИнтеграцииШина.ДополнитьСоответствиеПолейИсточникаИПриемника(
		СоответствиеПолей, "number", "Ссылка.Номер");
	пбп_ИнтеграцииШина.ДополнитьПоляПоискаИзСоответствияПолей(ПоляПоиска, СоответствиеПолей);

	Поля = ПоляПоиска["Ссылка"];
	ЮТест.ОжидаетЧто(Поля.Количество()).Равно(3);
	ЮТест.ОжидаетЧто(Поля[0]).Равно("Номер");
	ЮТест.ОжидаетЧто(Поля[1].Тип).Равно("ГруппаПолейПоиска");
	ЮТест.ОжидаетЧто(Поля[1].Поля[0]).Равно("Дата");
	ЮТест.ОжидаетЧто(Поля[1].Поля[1]).Равно("Комментарий");
	ЮТест.ОжидаетЧто(Поля[2]).Равно("Код");

КонецПроцедуры

Процедура ТестДолженНайтиДокументПоГруппеДатаИНомер() Экспорт

	НомерПервого = НомерДокументаПоиска();
	НомерВторого = НомерДокументаПоиска();
	ДатаПервого = Дата(2024, 1, 15);
	ДатаВторого = Дата(2024, 3, 4);
	Первый = СоздатьДокументПоиска(ДатаПервого, НомерПервого);
	СоздатьДокументПоиска(ДатаВторого, НомерВторого);

	Найден = НайтиДокументПоГруппе(ДатаПервого, НомерПервого);
	НеНайден = НайтиДокументПоГруппе(ДатаВторого, НомерПервого);

	ПоляСПриоритетомГруппы = ПоляПоискаГруппыДокумента(ДатаПервого, НомерПервого);
	ПоляСПриоритетомГруппы.Вставить(
		пбп_ИнтеграцииШина.ИмяПоляПоискаПоВнешнемуИдентификатору(), "не-используется");
	НайденГруппойРаньшеИдентификатора = пбп_ИнтеграцииШина.НайтиПоИдентификаторуПолямПоиска(
		Документы.ДемоРаботаСФормами, "чужой-идентификатор", Неопределено, ПоляСПриоритетомГруппы);

	ЮТест.ОжидаетЧто(Найден).Равно(Первый);
	ЮТест.ОжидаетЧто(НеНайден).НеЗаполнено();
	ЮТест.ОжидаетЧто(НайденГруппойРаньшеИдентификатора).Равно(Первый);

КонецПроцедуры

Процедура ТестДолженНайтиПоВнешнемуИдентификаторуЕслиГруппаНеСовпала() Экспорт

	ОписаниеРегистра = пбп_ИнтеграцииШинаПовтИсп.ОписаниеРегистраПубличныхИдентификаторов();

	Если Не ОписаниеРегистра.Использовать Или ОписаниеРегистра.ЭтоРегистрБСП Тогда

		ЮТест.Пропустить("Регистр соответствий ПБП не используется");
		Возврат;

	КонецЕсли;

	Суффикс = УникальныйСуффикс();
	НомерДокумента = "Y" + Суффикс;
	СсылкаНаОбъект = СоздатьДокументПоиска(Дата(2024, 1, 15), НомерДокумента);
	Система = ЮТест.Данные().КонструкторОбъекта(Справочники.пбп_ИнтегрируемыеСистемы)
		.Установить("Наименование", "Система группы поиска")
		.Записать(Ложь, Истина);
	Идентификатор = "EXT-" + Суффикс;
	ЗаписатьПубличныйИдентификатор(Система, СсылкаНаОбъект, Идентификатор);

	ПоляПоиска = ПоляПоискаГруппыДокумента(Дата(2024, 6, 1), НомерДокумента);
	ПоляПоиска.Вставить(пбп_ИнтеграцииШина.ИмяПоляПоискаПоВнешнемуИдентификатору(), Идентификатор);
	Найдено = пбп_ИнтеграцииШина.НайтиПоИдентификаторуПолямПоиска(
		Документы.ДемоРаботаСФормами, Идентификатор, Система, ПоляПоиска);

	ЮТест.ОжидаетЧто(Найдено).Равно(СсылкаНаОбъект);

КонецПроцедуры

Процедура ТестДолженПропуститьГруппуСПолемВнеМетаданных() Экспорт

	Значения = Новый Соответствие;
	Значения.Вставить("НетТакогоРеквизита", "x");
	Значения.Вставить("Дата", Дата(2024, 1, 15));
	ПоляПоиска = Новый Соответствие;
	ПоляПоиска.Вставить("НетТакогоРеквизита+Дата", Значения);

	Найдено = пбп_ИнтеграцииШина.НайтиПоИдентификаторуПолямПоиска(
		Документы.ДемоРаботаСФормами, "", Неопределено, ПоляПоиска);

	ЮТест.ОжидаетЧто(Найдено).НеЗаполнено();

КонецПроцедуры

Процедура ТестДолженРазрешитьСсылкуПоГруппеПолейПоиска() Экспорт

	Суффикс = УникальныйСуффикс();
	НаименованиеФункции = "Общая " + Суффикс;
	КодПервой = "A" + Суффикс;
	КодВторой = "B" + Суффикс;
	Первая = СоздатьПользовательскуюФункцию(КодПервой, НаименованиеФункции);
	СоздатьПользовательскуюФункцию(КодВторой, НаименованиеФункции);

	Система = ЮТест.Данные().КонструкторОбъекта(Справочники.пбп_ИнтегрируемыеСистемы)
		.Установить("Наименование", "Система ссылки по группе")
		.Записать(Ложь, Истина);

	Данные = Новый Структура;
	Данные.Вставить("ref", Строка(Новый УникальныйИдентификатор));
	Данные.Вставить("name", "Поток группы " + Суффикс);
	Данные.Вставить("isGroup", Ложь);
	Данные.Вставить("identifier", "YAX_FN_" + Суффикс);
	Данные.Вставить("threadDirection", "Исходящий");
	Данные.Вставить("functionCode", КодПервой);
	Данные.Вставить("functionName", НаименованиеФункции);
	Данные.Вставить("userFunction", Строка(Новый УникальныйИдентификатор));

	Ссылка = ЗагрузитьПоток(Данные, Система);
	Объект = Ссылка.ПолучитьОбъект();

	ЮТест.ОжидаетЧто(Объект.ПользовательскаяФункция).Равно(Первая);

КонецПроцедуры

Процедура ТестДолженНайтиДокументПоВнешнемуИдентификаторуИначеПоДатеИКомментарию() Экспорт

	ЗаполнитьНастройкиДляИнтеграцииЧерезШину();
	
	Суффикс = УникальныйСуффикс();
	ДатаДокумента = Дата(2026, 10, 1);
	Комментарий = "#Загружено из системы N " + Суффикс;
	ПоГруппе = СоздатьДокументПоиска(ДатаДокумента, НомерДокументаПоиска(), Комментарий);

	ОписаниеПолей = ОписаниеПолейКейсаДокумента()["Ссылка"];
	НеизвестныйИдентификатор = "нет-" + Суффикс;
	НайденПоГруппе = пбп_ИнтеграцииШина.НайтиПоИдентификаторуПолямПоиска(
		Документы.ДемоРаботаСФормами,
		НеизвестныйИдентификатор,
		Неопределено,
		ПоляПоискаКейсаДокумента(ОписаниеПолей, НеизвестныйИдентификатор, ДатаДокумента, Комментарий));

	ЮТест.ОжидаетЧто(НайденПоГруппе).Равно(ПоГруппе);

	ОписаниеРегистра = пбп_ИнтеграцииШинаПовтИсп.ОписаниеРегистраПубличныхИдентификаторов();

	Если Не ОписаниеРегистра.Использовать Или ОписаниеРегистра.ЭтоРегистрБСП Тогда
		Возврат;
	КонецЕсли;

	ПоИдентификатору = СоздатьДокументПоиска(Дата(2026, 1, 2), НомерДокументаПоиска(), "чужой " + Суффикс);
	Система = ЮТест.Данные().КонструкторОбъекта(Справочники.пбп_ИнтегрируемыеСистемы)
		.Установить("Наименование", "Система кейса документа " + Суффикс)
		.Записать(Ложь, Истина);
	Идентификатор = "EXT-" + Суффикс;
	ЗаписатьПубличныйИдентификатор(Система, ПоИдентификатору, Идентификатор);

	НайденПоИдентификатору = пбп_ИнтеграцииШина.НайтиПоИдентификаторуПолямПоиска(
		Документы.ДемоРаботаСФормами,
		Идентификатор,
		Система,
		ПоляПоискаКейсаДокумента(ОписаниеПолей, Идентификатор, ДатаДокумента, Комментарий));

	ЮТест.ОжидаетЧто(НайденПоИдентификатору).Равно(ПоИдентификатору);

КонецПроцедуры

Процедура ТестДолженСобратьГруппуПолейПоискаИзСтрокиИМассива() Экспорт

	ГруппаИзСтроки = пбп_ИнтеграцииШина.ГруппаПолейПоиска("Дата, Номер");
	ГруппаБезПустыхИДублей = пбп_ИнтеграцииШина.ГруппаПолейПоиска("Дата, , Номер, Дата");
	ИменаПолей = Новый Массив;
	ИменаПолей.Добавить("Номер");
	ИменаПолей.Добавить("");
	ИменаПолей.Добавить(" ");
	ИменаПолей.Добавить("Дата");
	//BSLLS:DuplicatedInsertionIntoCollection-off
	ИменаПолей.Добавить("Номер");
	//BSLLS:DuplicatedInsertionIntoCollection-on
	ГруппаИзМассива = пбп_ИнтеграцииШина.ГруппаПолейПоиска(ИменаПолей);

	ПроверитьСоставГруппыПолейПоиска(ГруппаИзСтроки, "Дата", "Номер");
	ПроверитьСоставГруппыПолейПоиска(ГруппаБезПустыхИДублей, "Дата", "Номер");
	ПроверитьСоставГруппыПолейПоиска(ГруппаИзМассива, "Номер", "Дата");

КонецПроцедуры

Процедура ТестДолженЗаполнитьПроверкуСуществованияПоВнутреннемуИдентификатору() Экспорт

	Суффикс = УникальныйСуффикс();
	Ссылка = СоздатьДокументПоиска(Дата(2026, 2, 2), "Y" + Суффикс, "существует " + Суффикс);
	Идентификатор = Строка(Ссылка.УникальныйИдентификатор());
	ИмяПоля = пбп_ИнтеграцииШина.ИмяПоляПоискаПоВнутреннемуИдентификатору();

	ПоляСуществующего = Новый Соответствие;
	ПоляСуществующего.Вставить(ИмяПоля, Идентификатор);
	ПроверкаСуществующего = Новый Структура("Проверена, Существует, Ссылка", Ложь, Ложь, Неопределено);
	Найден = пбп_ИнтеграцииШина.НайтиПоИдентификаторуПолямПоиска(
		Документы.ДемоРаботаСФормами, "", Неопределено, ПоляСуществующего, ПроверкаСуществующего);

	ЮТест.ОжидаетЧто(Найден).Равно(Ссылка);
	ЮТест.ОжидаетЧто(ПроверкаСуществующего.Проверена).Равно(Истина);
	ЮТест.ОжидаетЧто(ПроверкаСуществующего.Существует).Равно(Истина);
	ЮТест.ОжидаетЧто(ПроверкаСуществующего.Ссылка).Равно(Ссылка);

	ОтсутствующийИдентификатор = Строка(Новый УникальныйИдентификатор);
	ПоляОтсутствующего = Новый Соответствие;
	ПоляОтсутствующего.Вставить(ИмяПоля, ОтсутствующийИдентификатор);
	ПроверкаОтсутствующего = Новый Структура("Проверена, Существует, Ссылка", Ложь, Ложь, Неопределено);
