Функция ЗаполнитьНастройкиДляИнтеграцииЧерезШину()
	
	Константы.пбп_ИспользоватьСоответствияОбъектовИнтегрируемыхСистем.Установить(Истина);
	Константы.пбп_ИспользоватьУправлениеШинойDatareonESB.Установить(Истина);
	
	СистемаN = пбп_ИнтеграцииСервер.ИнтегрируемаяСистема("СистемаN");
	Если Не ЗначениеЗаполнено(СистемаN) Тогда
		НоваяСистема = Справочники.пбп_ИнтегрируемыеСистемы.СоздатьЭлемент();
		НоваяСистема.Наименование = "Система N";
		НоваяСистема.ИдентификаторНастройки = "СистемаN";
		НоваяСистема.Записать();
		
		СистемаN = НоваяСистема.Ссылка;
	КонецЕсли;
	
	НастройкаN = "ИнтеграцияССистемойN";
	Если Не ЗначениеЗаполнено(пбп_ИнтеграцииСервер.НастройкаИнтеграции(НастройкаN)) Тогда
		НоваяНастройка = Справочники.пбп_НастройкиИнтеграции.СоздатьЭлемент();
		НоваяНастройка.Наименование = "Интеграция с системой N";
		НоваяНастройка.ИдентификаторНастройки = "ИнтеграцияССистемойN";
		НоваяНастройка.ИнтегрируемаяСистема = СистемаN;
		НоваяНастройка.ТипИнтеграции = Справочники.пбп_ТипыИнтеграций.БрокерDatareon;
		НоваяНастройка.ТипАвторизации = Перечисления.пбп_ТипыАвторизации.БезАвторизации;
		НоваяНастройка.Записать();
	КонецЕсли;
	
	ГруппаАсинхПотоки = "АсинхронныеПотоки";
	Если Не ЗначениеЗаполнено(пбп_ИнтеграцииСервер.ИнтеграционныйПоток(ГруппаАсинхПотоки)) Тогда
		НовыйПоток = Справочники.пбп_ИнтеграционныеПотоки.СоздатьЭлемент();
		НовыйПоток.Наименование = "Асинхронные потоки";
		НовыйПоток.ИдентификаторНастройки = "АсинхронныеПотоки";
		НовыйПоток.ЭтоГруппа = Истина;
		НовыйПоток.Записать();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(пбп_ИнтеграцииСервер.ИнтеграционныйПоток("ОтправкаНастройкиИнтеграции")) Тогда
		НовыйПоток = Справочники.пбп_ИнтеграционныеПотоки.СоздатьЭлемент();
		НовыйПоток.Наименование = "Отправка настройки интеграции";
		НовыйПоток.ИдентификаторНастройки = "ОтправкаНастройкиИнтеграции";
		НовыйПоток.НастройкаИнтеграции = пбп_ИнтеграцииСервер.НастройкаИнтеграции("ИнтеграцияССистемойN");
		НовыйПоток.НаправлениеПотока = Перечисления.пбп_НаправленияИнтеграционныхПотоков.Исходящий;
		НовыйПоток.ИдентификаторРодитель = ГруппаАсинхПотоки;
		НовыйПоток.Записать();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(пбп_ИнтеграцииСервер.ИнтеграционныйПоток("ОтправкаИнтеграционногоПотока")) Тогда
		НовыйПоток = Справочники.пбп_ИнтеграционныеПотоки.СоздатьЭлемент();
		НовыйПоток.Наименование = "Отправка интеграционного потока";
		НовыйПоток.ИдентификаторНастройки = "ОтправкаИнтеграционногоПотока";
		НовыйПоток.НастройкаИнтеграции = пбп_ИнтеграцииСервер.НастройкаИнтеграции("ИнтеграцияССистемойN");
		НовыйПоток.НаправлениеПотока = Перечисления.пбп_НаправленияИнтеграционныхПотоков.Исходящий;
		НовыйПоток.ИдентификаторРодитель = ГруппаАсинхПотоки;
		НовыйПоток.Записать();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(пбп_ИнтеграцииСервер.ИнтеграционныйПоток("ПолучениеИнтеграционногоПотока")) Тогда
		НовыйПоток = Справочники.пбп_ИнтеграционныеПотоки.СоздатьЭлемент();
		НовыйПоток.Наименование = "Получение интеграционного потока из системы N";
		НовыйПоток.ИдентификаторНастройки = "ПолучениеИнтеграционногоПотока";
		НовыйПоток.НастройкаИнтеграции = пбп_ИнтеграцииСервер.НастройкаИнтеграции("ИнтеграцияССистемойN");
		НовыйПоток.НаправлениеПотока = Перечисления.пбп_НаправленияИнтеграционныхПотоков.Входящий;
		НовыйПоток.ИдентификаторРодитель = ГруппаАсинхПотоки;
		НовыйПоток.Записать();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(пбп_ИнтеграцииСервер.ИнтеграционныйПоток("ПолучениеНастройкиИнтеграции")) Тогда
		НовыйПоток = Справочники.пбп_ИнтеграционныеПотоки.СоздатьЭлемент();
		НовыйПоток.Наименование = "Получение настроек интеграции из системы N";
		НовыйПоток.ИдентификаторНастройки = "ПолучениеНастройкиИнтеграции";
		НовыйПоток.НастройкаИнтеграции = пбп_ИнтеграцииСервер.НастройкаИнтеграции("ИнтеграцияССистемойN");
		НовыйПоток.НаправлениеПотока = Перечисления.пбп_НаправленияИнтеграционныхПотоков.Входящий;
		НовыйПоток.ИдентификаторРодитель = ГруппаАсинхПотоки;
		НовыйПоток.Записать();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(пбп_ИнтеграцииСервер.ИнтеграционныйПоток("ПолучениеДемоДокумента")) Тогда
		НовыйПоток = Справочники.пбп_ИнтеграционныеПотоки.СоздатьЭлемент();
		НовыйПоток.Наименование = "Получение демо-документа из системы N";
		НовыйПоток.ИдентификаторНастройки = "ПолучениеДемоДокумента";
		НовыйПоток.НастройкаИнтеграции = пбп_ИнтеграцииСервер.НастройкаИнтеграции("ИнтеграцияССистемойN");
		НовыйПоток.НаправлениеПотока = Перечисления.пбп_НаправленияИнтеграционныхПотоков.Входящий;
		НовыйПоток.ИдентификаторРодитель = ГруппаАсинхПотоки;
		НовыйПоток.Записать();
	КонецЕсли;
	
	НастройкаИнтеграции = пбп_ИнтеграцииСервер.НастройкаИнтеграции("ИнтеграцияССистемойN");
	
	Если ЗначениеЗаполнено(НастройкаИнтеграции) Тогда
		
		ЗаписатьПубличныйИдентификатор(
			СистемаN,
			НастройкаИнтеграции,
			Строка(НастройкаИнтеграции.УникальныйИдентификатор()));
		
	КонецЕсли;
	
	Возврат СистемаN;
	
КонецФункции

