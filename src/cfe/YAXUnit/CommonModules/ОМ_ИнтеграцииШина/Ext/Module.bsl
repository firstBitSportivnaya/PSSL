		+ """Проведен"":true,"
		+ """Комментарий"":""#Загружено из системы N"","
		+ """ДатаДокументаОснования"":""2026-10-01T00:00:00""}";
	
КонецФункции

Процедура ПроверитьСоставГруппыПолейПоиска(Группа, ИмяПоля1, ИмяПоля2)

	ЮТест.ОжидаетЧто(Группа.Тип).Равно("ГруппаПолейПоиска");
	ЮТест.ОжидаетЧто(Группа.Поля.Количество()).Равно(2);
	ЮТест.ОжидаетЧто(Группа.Поля[0]).Равно(ИмяПоля1);
	ЮТест.ОжидаетЧто(Группа.Поля[1]).Равно(ИмяПоля2);

КонецПроцедуры

Функция СообщениеДемоДокумента(Идентификатор, Номер, ДатаДокумента, Проведен, Комментарий, ДатаОснования = "")

	ТекстПроведен = ?(Проведен, "true", "false");
	Тело = "{""Ссылка"":""" + Идентификатор + ""","
		+ """Номер"":""" + Номер + ""","
		+ """Дата"":""" + ДатаДокумента + ""","
		+ """Проведен"":" + ТекстПроведен + ","
		+ """Комментарий"":""" + Комментарий + """";

	Если ЗначениеЗаполнено(ДатаОснования) Тогда

		Тело = Тело + ",""ДатаДокументаОснования"":""" + ДатаОснования + """";

	КонецЕсли;

	Возврат Тело + "}";

КонецФункции

Функция ЗагрузитьДемоДокумент(ТелоСообщения, Источник)

	ИдентификаторСообщения = Строка(Новый УникальныйИдентификатор);
	СостояниеСообщения = Неопределено;
	Задержка = 30;
	КоличествоПопыток = 0;
	Функции = Новый Массив;
	ТекстОшибки = "";

	пбп_ИнтеграцииВходящие.Документ_ДемоРаботаСФормами(
		ТелоСообщения,
		Источник,
		ИдентификаторСообщения,
		СостояниеСообщения,
		Задержка,
		КоличествоПопыток,
		Функции,
		ТекстОшибки);

	Возврат ТекстОшибки;

КонецФункции

Функция НайтиДокументПоКомментарию(Комментарий)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Комментарий", Комментарий);
	Запрос.Текст = "ВЫБРАТЬ Ссылка ИЗ Документ.ДемоРаботаСФормами ГДЕ Комментарий = &Комментарий";
	РезультатЗапроса = Запрос.Выполнить();

	Если РезультатЗапроса.Пустой() Тогда

		Возврат Документы.ДемоРаботаСФормами.ПустаяСсылка();

	КонецЕсли;

	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();

	Возврат Выборка.Ссылка;

КонецФункции

Процедура ДобавитьИнтеграционныеПотоки(ИдентификаторНастройки, Наименование, НастройкаИнтеграции, Родитель, Исходящий = Истина)
	
	СсылкаКСозданию = пбп_ИнтеграцииСервер.ИнтеграционныйПоток(ИдентификаторНастройки);
	Если Не ЗначениеЗаполнено(СсылкаКСозданию) Тогда
		НовыйПоток = Справочники.пбп_ИнтеграционныеПотоки.СоздатьЭлемент();
		НовыйПоток.Наименование = Наименование;
		НовыйПоток.ИдентификаторНастройки = ИдентификаторНастройки;
		НовыйПоток.НастройкаИнтеграции = НастройкаИнтеграции;
		Если Исходящий Тогда
			НовыйПоток.НаправлениеПотока = Перечисления.пбп_НаправленияИнтеграционныхПотоков.Исходящий;
		Иначе
			НовыйПоток.НаправлениеПотока = Перечисления.пбп_НаправленияИнтеграционныхПотоков.Входящий;
		КонецЕсли;
		НовыйПоток.Родитель = Родитель;
		НовыйПоток.Записать();
	КонецЕсли;
	
КонецПроцедуры

Процедура УдалитьИнтеграционныеПотоки(ИдентификаторНастройки)
	
	СсылкаКУдалению = пбп_ИнтеграцииСервер.ИнтеграционныйПоток(ИдентификаторНастройки);
	Если ЗначениеЗаполнено(СсылкаКУдалению) Тогда
		ОбъектКУдалению = СсылкаКУдалению.ПолучитьОбъект();
		ОбъектКУдалению.Удалить();
	КонецЕсли;
	
КонецПроцедуры

