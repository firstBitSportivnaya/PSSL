Функция ПоляПоискаКейсаДокумента(ОписаниеПолей, Идентификатор, ДатаДокумента, Комментарий)

	ИмяВнешнегоИдентификатора = пбп_ИнтеграцииШина.ИмяПоляПоискаПоВнешнемуИдентификатору();
	ПоляПоиска = Новый Соответствие;

	Для Каждого Поле Из ОписаниеПолей Цикл

		Если ТипЗнч(Поле) = Тип("Структура") И Поле.Свойство("Тип") И Поле.Тип = "ГруппаПолейПоиска" Тогда

			ЗначенияГруппы = Новый Соответствие;
			ЗначенияГруппы.Вставить("Дата", ДатаДокумента);
			ЗначенияГруппы.Вставить("Комментарий", Комментарий);
			ПоляПоиска.Вставить(СтрСоединить(Поле.Поля, "+"), ЗначенияГруппы);

		ИначеЕсли Поле = ИмяВнешнегоИдентификатора Тогда

			ПоляПоиска.Вставить(Поле, Идентификатор);

		КонецЕсли;

	КонецЦикла;

	Возврат ПоляПоиска;

КонецФункции

