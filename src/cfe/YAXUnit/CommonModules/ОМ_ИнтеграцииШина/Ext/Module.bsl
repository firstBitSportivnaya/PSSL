Процедура ТестДолженВыгрузитьНастройкуИнтеграции() Экспорт
	
	Источник = ПолучитьИсточник();
	
	ОбъектОбработки = пбп_ИнтеграцииСервер.НастройкаИнтеграции("ИнтеграцияССистемойN");
	ОбъектНастройки = ОбъектОбработки.ПолучитьОбъект();
	ОбъектНастройки.ТипИнтеграции = Справочники.пбп_ТипыИнтеграций.БрокерDatareon;
	ОбъектНастройки.ТипАвторизации = Перечисления.пбп_ТипыАвторизации.БезАвторизации;
	ОбъектНастройки.Записать();
	
	РезультатОбработки = "";
	СостояниеСообщения = Неопределено;
	МетодХранения = Неопределено;
	ТипОбъекта = "";
	Задержка = 30;
	ФорматСообщения = Неопределено;
	ТекстОшибки = "";
	ДатаРегистрации = ТекущаяДатаСеанса();
	СсылкаНаОбъект = ОбъектОбработки;
	Функции = Новый Массив;
	
	пбп_ИнтеграцииИсходящие.Справочник_пбп_НастройкиИнтеграции(
		ОбъектОбработки,
		РезультатОбработки,
		СостояниеСообщения,
		ТипОбъекта,
		МетодХранения,
		Задержка,
		ФорматСообщения,
		ТекстОшибки,
		ДатаРегистрации,
		СсылкаНаОбъект,
		Функции);
	
	ЮТест.ОжидаетЧто(ТекстОшибки).НеЗаполнено();
	ЮТест.ОжидаетЧто(РезультатОбработки).Заполнено();
	
	ОбъектXDTO = пбп_ИнтеграцииСлужебный.ПолучитьОбъектXDTOИзСообщенияОбменаJSON(РезультатОбработки);
	ЮТест.ОжидаетЧто(пбп_ИнтеграцииСлужебный.ЭтоУникальныйИдентификатор(ОбъектXDTO.Ссылка)).Равно(Истина);
