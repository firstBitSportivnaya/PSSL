Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты.Перед("ПередВсемиТестами");
	
	ЮТТесты
		.ДобавитьТестовыйНабор("НайтиПоИдентификатору")
			.ДобавитьТест("ТестДолженВернутьСсылкуПоВнутреннемуИдентификатору").ВТранзакции()
			.ДобавитьТест("ТестДолженВернутьНеопределеноДляИдентификатораНеUUID")
			.ДобавитьТест("ТестДолженВернутьНеопределеноДляНесуществующегоИдентификатора")
			.ДобавитьТест("ТестДолженНайтиОбъектПоРегиструСоответствийПБП").ВТранзакции()
			.ДобавитьТест("ТестДолженНайтиОбъектПоПубличномуИдентификаторуБезПолейПоиска").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("УдалитьНеиспользуемыеРеквизиты")
			.ДобавитьТест("ТестДолженУдалитьПоляСПрефиксомУдалить")
			.ДобавитьТест("ТестДолженУдалитьПоляИзПереданногоСписка");

	ЮТТесты
		.ДобавитьТестовыйНабор("ПреобразоватьДатуПоУниверсальномуВремени")
			.ДобавитьТест("ТестДолженВернутьДатуБезВремениБезПреобразования")
			.ДобавитьТест("ТестДолженСохранитьДатуПриПреобразованииТудаИОбратно")
			.ДобавитьТест("ТестДолженВернутьНеДатуБезИзменения");

	ЮТТесты
		.ДобавитьТестовыйНабор("ПолучитьОбъектXDTOИзСообщенияОбменаJSON")
			.ДобавитьТест("ТестДолженВернутьНеопределеноДляНекорректногоJSON")
			.ДобавитьТест("ТестДолженПрочитатьСтруктуруИзСообщенияJSON");

	ЮТТесты
		.ДобавитьТестовыйНабор("ПубличныйИдентификатор")
			.ДобавитьТест("ТестДолженЗаписатьНайтиИУдалитьПубличныйИдентификатор").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("УзелИнтеграцииПоИсточнику")
			.ДобавитьТест("ТестДолженНайтиСистемуПоИдентификаторуНастройки").ВТранзакции()
			.ДобавитьТест("ТестДолженВыброситьИсключениеЕслиИсточникНеНайден")
			.ДобавитьТест("ТестДолженВернутьПереданнуюСсылкуБезИзменений").ВТранзакции();

	ЮТТесты
		.ДобавитьТестовыйНабор("Загрузка объекта по XDTO")
			.ДобавитьТест("ТестДолженЗаполнитьШапкуИТабличнуюЧасть").ВТранзакции()
			.ДобавитьТест("ТестДолженЗаполнитьПеречислениеИдентификатор").ВТранзакции()
			.ДобавитьТест("ТестДолженОставитьПустымНеизвестноеИмяПеречисления").ВТранзакции();
	
	ЮТТесты
		.ДобавитьТестовыйНабор("Поля поиска из соответствия полей")
			.ДобавитьТест("ТестДолженВывестиПоляПоискаСсылкиРодителяИНастройки")
			.ДобавитьТест("ТестДолженСохранитьПорядокЯвныхПолейБезДублей")
			.ДобавитьТест("ТестДолженСохранитьГруппуПолейПоискаБезДублей")
			.ДобавитьТест("ТестДолженСобратьГруппуПолейПоискаИзСтрокиИМассива")
			.ДобавитьТест("ТестДолженНайтиРодителяИТуЖеСсылкуПриПовторнойЗагрузке").ВТранзакции()
			.ДобавитьТест("ТестДолженНайтиДокументПоГруппеДатаИНомер").ВТранзакции()
			.ДобавитьТест("ТестДолженНайтиПоВнешнемуИдентификаторуЕслиГруппаНеСовпала").ВТранзакции()
			.ДобавитьТест("ТестДолженПропуститьГруппуСПолемВнеМетаданных")
			.ДобавитьТест("ТестДолженРазрешитьСсылкуПоГруппеПолейПоиска").ВТранзакции()
			.ДобавитьТест("ТестДолженНайтиДокументПоВнешнемуИдентификаторуИначеПоДатеИКомментарию").ВТранзакции()
			.ДобавитьТест("ТестДолженЗаполнитьПроверкуСуществованияПоВнутреннемуИдентификатору").ВТранзакции()
			.ДобавитьТест("ТестДолженПолучитьНовыйОбъектЕслиСсылкаНеСуществует");
	
	ЮТТесты
		.ДобавитьТестовыйНабор("Тест обмена через обработчики")
			.ДобавитьТест("ТестДолженЗагрузитьИнтеграционныйПоток").ВТранзакции()
			.ДобавитьТест("ТестДолженЗагрузитьДемоРаботаСФормами").ВТранзакции()
			.ДобавитьТест("ТестДолженВыгрузитьНастройкуИнтеграции").ВТранзакции()
			.ДобавитьТест("ТестДолженВыгрузитьИнтеграционныйПоток").ВТранзакции()
			.ДобавитьТест("ТестДолженЗагрузитьНастройкуИнтеграции").ВТранзакции()
			.ДобавитьТест("ТестДолженОбновитьПубличныйИдентификаторПриПовторнойЗагрузке").ВТранзакции()
			.ДобавитьТест("ТестДолженПропуститьПустыеПоляИсточникаПриПоиске").ВТранзакции()
			.ДобавитьТест("ТестДолженЗагрузитьНастройкуИнтеграцииПоИмениПредопределенного").ВТранзакции()
			.ДобавитьТест("ТестДолженВернутьПустуюТаблицуДляПустогоСпискаXDTO");
	
	ЮТТесты.После("ПослеВсехТестов");

КонецПроцедуры

Процедура ПередВсемиТестами() Экспорт
	
	Константы.пбп_ИспользоватьСоответствияОбъектовИнтегрируемыхСистем.Установить(Истина);
	Константы.пбп_ИспользоватьУправлениеШинойDatareonESB.Установить(Истина);
	
	ИспользоватьПубличные = пбп_ОбщегоНазначенияСервер.ПолучитьПредопределенноеЗначение(
		"ИспользоватьПубличныеИдентификаторыСинхронизируемыхОбъектов");
	Если ИспользоватьПубличные = Неопределено Тогда
		НовоеПредопределенное = ПланыВидовХарактеристик.пбп_ПредопределенныеЗначения.СоздатьЭлемент();
		НовоеПредопределенное.Наименование = "Идентификаторы интегрируемых систем в публичные идентификаторы";
		НовоеПредопределенное.Значение = Ложь;
		НовоеПредопределенное.ИдентификаторНастройки = "ИспользоватьПубличныеИдентификаторыСинхронизируемыхОбъектов";
		НовоеПредопределенное.ТипЗначения = Новый ОписаниеТипов("Булево");
	КонецЕсли;
	
	СистемаN = пбп_ИнтеграцииСервер.ИнтегрируемаяСистема("СистемаN");
	Если Не ЗначениеЗаполнено(СистемаN) Тогда
		НоваяСистема = Справочники.пбп_ИнтегрируемыеСистемы.СоздатьЭлемент();
		НоваяСистема.Наименование = "Система N";
		НоваяСистема.ИдентификаторНастройки = "СистемаN";
		НоваяСистема.Записать();
		
		СистемаN = НоваяСистема.Ссылка;
	КонецЕсли;
	
	НастройкаN = "ИнтеграцияССистемойN";
	Если Не ЗначениеЗаполнено(пбп_ИнтеграцииСервер.НастройкаИнтеграции(НастройкаN)) Тогда
		НоваяНастройка = Справочники.пбп_НастройкиИнтеграции.СоздатьЭлемент();
		НоваяНастройка.Наименование = "Интеграция с системой N";
		НоваяНастройка.ИдентификаторНастройки = "ИнтеграцияССистемойN";
		НоваяНастройка.ИнтегрируемаяСистема = СистемаN;
		НоваяНастройка.ТипИнтеграции = Справочники.пбп_ТипыИнтеграций.БрокерDatareon;
		НоваяНастройка.ТипАвторизации = Перечисления.пбп_ТипыАвторизации.БезАвторизации;
		НоваяНастройка.Записать();
	КонецЕсли;
	
	ГруппаАсинхПотоки = "АсинхронныеПотоки";
	Если Не ЗначениеЗаполнено(пбп_ИнтеграцииСервер.ИнтеграционныйПоток(ГруппаАсинхПотоки)) Тогда
		НовыйПоток = Справочники.пбп_ИнтеграционныеПотоки.СоздатьГруппу();
		НовыйПоток.Наименование = "Асинхронные потоки";
		НовыйПоток.ИдентификаторНастройки = "АсинхронныеПотоки";
		НовыйПоток.Записать();
	КонецЕсли;
	
	ДобавитьИнтеграционныеПотоки("ОтправкаНастройкиИнтеграции",
		"Отправка настройки интеграции", НоваяНастройка, НовыйПоток, Истина);
	ДобавитьИнтеграционныеПотоки("ОтправкаИнтеграционногоПотока",
		"Отправка интеграционного поток", НоваяНастройка, НовыйПоток, Истина);
	ДобавитьИнтеграционныеПотоки("ПолучениеИнтеграционногоПотока",
		"Получение интеграционного потока из системы N", НоваяНастройка, НовыйПоток, Ложь);
	ДобавитьИнтеграционныеПотоки("ПолучениеНастройкиИнтеграции",
		"Получение настроек интеграции из системы N", НоваяНастройка, НовыйПоток, Ложь);
	ДобавитьИнтеграционныеПотоки("ПолучениеДемоДокумента",
		"Получение демо-документа из системы N", НоваяНастройка, НовыйПоток, Ложь);
	
	НастройкаИнтеграции = пбп_ИнтеграцииСервер.НастройкаИнтеграции("ИнтеграцияССистемойN");
	
	Если ЗначениеЗаполнено(НастройкаИнтеграции) Тогда
		
		ЗаписатьПубличныйИдентификатор(
			СистемаN,
			НастройкаИнтеграции,
			Строка(НастройкаИнтеграции.УникальныйИдентификатор()));
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПослеВсехТестов() Экспорт
	
	УдалитьИнтеграционныеПотоки("ПолучениеДемоДокумента");
	УдалитьИнтеграционныеПотоки("ПолучениеНастройкиИнтеграции");
	УдалитьИнтеграционныеПотоки("ПолучениеИнтеграционногоПотока");
	УдалитьИнтеграционныеПотоки("ОтправкаИнтеграционногоПотока");
	УдалитьИнтеграционныеПотоки("ОтправкаНастройкиИнтеграции");
	УдалитьИнтеграционныеПотоки("АсинхронныеПотоки");
	
	СистемаN = пбп_ИнтеграцииСервер.ИнтегрируемаяСистема("СистемаN");
	
	СсылкаКУдалению = пбп_ИнтеграцииСервер.НастройкаИнтеграции("ИнтеграцияССистемойN");
	Если ЗначениеЗаполнено(СсылкаКУдалению) Тогда
		пбп_ИнтеграцииСервер.УдалитьСоответствиеОбъектовИнтегрируемыхСистем(
			СистемаN, СсылкаКУдалению);
		
		ОбъектКУдалению = СсылкаКУдалению.ПолучитьОбъект();
		ОбъектКУдалению.Удалить();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СистемаN) Тогда
		ОбъектКУдалению = СистемаN.ПолучитьОбъект();
		ОбъектКУдалению.Удалить();
	КонецЕсли;
	
	СсылкаКУдалению = ПланыВидовХарактеристик.пбп_ПредопределенныеЗначения.НайтиПоРеквизиту(
		"ИдентификаторНастройки", "ИспользоватьПубличныеИдентификаторыСинхронизируемыхОбъектов");
	Если ЗначениеЗаполнено(СсылкаКУдалению) Тогда
		ОбъектКУдалению = СсылкаКУдалению.ПолучитьОбъект();
		ОбъектКУдалению.Удалить();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура ТестДолженВернутьСсылкуПоВнутреннемуИдентификатору() Экспорт

	СсылкаОбъекта = ЮТест.Данные().КонструкторОбъекта(Справочники.пбп_ИнтегрируемыеСистемы)
		.Установить("Наименование", "Поиск по UUID")
		.Записать(Ложь, Истина);
	Идентификатор = Строка(СсылкаОбъекта.УникальныйИдентификатор());

	Найдено = пбп_ИнтеграцииШина.НайтиПоИдентификаторуПолямПоиска(
		Справочники.пбп_ИнтегрируемыеСистемы, Идентификатор, Неопределено);

	ЮТест.ОжидаетЧто(Найдено).Равно(СсылкаОбъекта);

КонецПроцедуры

Процедура ТестДолженВернутьНеопределеноДляИдентификатораНеUUID() Экспорт

	Ссылка = пбп_ИнтеграцииШина.НайтиПоИдентификаторуПолямПоиска(
		Справочники.пбп_ИнтегрируемыеСистемы, "внешний-код", Неопределено);

	ЮТест.ОжидаетЧто(Ссылка).Равно(Неопределено);

КонецПроцедуры

Процедура ТестДолженВернутьНеопределеноДляНесуществующегоИдентификатора() Экспорт

	Идентификатор = Строка(Новый УникальныйИдентификатор);

	Ссылка = пбп_ИнтеграцииШина.НайтиПоИдентификаторуПолямПоиска(
		Справочники.пбп_ИнтегрируемыеСистемы, Идентификатор, Неопределено);

	ЮТест.ОжидаетЧто(Ссылка).Равно(Неопределено);

КонецПроцедуры

Процедура ТестДолженНайтиОбъектПоРегиструСоответствийПБП() Экспорт

	ОписаниеРегистра = пбп_ИнтеграцииШинаПовтИсп.ОписаниеРегистраПубличныхИдентификаторов();

	Если Не ОписаниеРегистра.Использовать Или ОписаниеРегистра.ЭтоРегистрБСП Тогда

		ЮТест.Пропустить("Регистр соответствий ПБП не используется");
		Возврат;

	КонецЕсли;

	Система = ЮТест.Данные().КонструкторОбъекта(Справочники.пбп_ИнтегрируемыеСистемы)
		.Установить("Наименование", "Система поиска")
		.Записать(Ложь, Истина);
	СсылкаНаОбъект = ЮТест.Данные().КонструкторОбъекта(Справочники.пбп_ИнтеграционныеПотоки)
		.Установить("Наименование", "OBJ0000001")
		.Записать(Ложь, Истина);
	Идентификатор = "EXT-1";

	Набор = РегистрыСведений.пбп_СоответствиеОбъектовИнтегрируемыхСистем.СоздатьНаборЗаписей();
	Набор.Отбор.ИнтегрируемаяСистема.Установить(Система);
	Набор.Отбор.СсылкаНаОбъект.Установить(СсылкаНаОбъект);
	Набор.Отбор.ИдентификаторСистемы.Установить(Идентификатор);
	Запись = Набор.Добавить();
	Запись.ИнтегрируемаяСистема = Система;
	Запись.СсылкаНаОбъект = СсылкаНаОбъект;
	Запись.ИдентификаторСистемы = Идентификатор;
	Набор.Записать();

	ПоляПоиска = Новый Соответствие;
	ПоляПоиска.Вставить(
		пбп_ИнтеграцииШина.ИмяПоляПоискаПоВнешнемуИдентификатору(), Идентификатор);

	Найдено = пбп_ИнтеграцииШина.НайтиПоИдентификаторуПолямПоиска(
		Справочники.пбп_ИнтеграционныеПотоки, Идентификатор, Система, ПоляПоиска);

	ЮТест.ОжидаетЧто(Найдено).Равно(СсылкаНаОбъект);

КонецПроцедуры

Процедура ТестДолженНайтиОбъектПоПубличномуИдентификаторуБезПолейПоиска() Экспорт

	ОписаниеРегистра = пбп_ИнтеграцииШинаПовтИсп.ОписаниеРегистраПубличныхИдентификаторов();

	Если Не ОписаниеРегистра.Использовать Или ОписаниеРегистра.ЭтоРегистрБСП Тогда

		ЮТест.Пропустить("Регистр соответствий ПБП не используется");
		Возврат;

	КонецЕсли;

	Система = ЮТест.Данные().КонструкторОбъекта(Справочники.пбп_ИнтегрируемыеСистемы)
		.Установить("Наименование", "Система поиска без полей")
		.Записать(Ложь, Истина);
	СсылкаНаОбъект = ЮТест.Данные().КонструкторОбъекта(Справочники.пбп_ИнтеграционныеПотоки)
		.Установить("Наименование", "OBJ0000002")
		.Записать(Ложь, Истина);
	Идентификатор = "EXT-EMPTY";

	Набор = РегистрыСведений.пбп_СоответствиеОбъектовИнтегрируемыхСистем.СоздатьНаборЗаписей();
	Набор.Отбор.ИнтегрируемаяСистема.Установить(Система);
	Набор.Отбор.СсылкаНаОбъект.Установить(СсылкаНаОбъект);
	Набор.Отбор.ИдентификаторСистемы.Установить(Идентификатор);
	Запись = Набор.Добавить();
	Запись.ИнтегрируемаяСистема = Система;
	Запись.СсылкаНаОбъект = СсылкаНаОбъект;
	Запись.ИдентификаторСистемы = Идентификатор;
	Набор.Записать();

	ПоляПоиска = Новый Соответствие;

	Найдено = пбп_ИнтеграцииШина.НайтиПоИдентификаторуПолямПоиска(
		Справочники.пбп_ИнтеграционныеПотоки, Идентификатор, Система, ПоляПоиска);

	ЮТест.ОжидаетЧто(Найдено).Равно(СсылкаНаОбъект);

КонецПроцедуры

Процедура ТестДолженУдалитьПоляСПрефиксомУдалить() Экспорт

	СоставПолей = НовыйСоставПолей(
		Имена("Наименование", "УдалитьСтарое", "УдалитьЕще"),
		Имена("Код", "УдалитьКод", "УдалитьЕщеПоле"),
		Имена("Товары", "УдалитьАрхив", "УдалитьСтараяТЧ"));

	пбп_ИнтеграцииШина.УдалитьНеиспользуемыеРеквизиты(СоставПолей);

