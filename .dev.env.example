# Local pins for Cursor / Unica. Copy to .dev.env and fill. Do not commit .dev.env.
# WORKSPACE_ROOT — абсолютный корень клона (для Unica cwd). Не коммитить реальный путь.
WORKSPACE_ROOT=
PLATFORM_VERSION=v8.3.23
PLATFORM_BUILD=8.3.23.XXXX
PLATFORM_PATH=C:\Program Files\1cv8\8.3.23.XXXX
CONFIG_NAME=PSSL
CONFIGURATION_NAME=ПроектнаяБиблиотекаПодсистем
CONFIGURATION_VERSION=1.0.10.7
COMPATIBILITY_MODE=Version8_3_18
SOURCE_SET=main
DUMP_PATH=src/cf
YAXUNIT_SOURCE_SET=YAXUNIT
YAXUNIT_PATH=src/cfe/YAXUnit
INFOBASE_KIND=file
INFOBASE_PATH=C:\path\to\InfoBase
IB_USER=Администратор
IB_PASSWORD=
LOG_PATH=C:\path\to\PSSL\build\designer.out.log
# Local Vanessa MCP (copy tools/*.local.json.example; files are gitignored)
VA_PARAMS_LOCAL=tools/VBParams.local.json
VRUNNER_LOCAL=tools/vrunner.local.json
VA_MCP_PORT=9876
